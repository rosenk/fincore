// SINCE: v0.3
// context: E3005 (Linear resource leak) at the binding of the leaked
// connection, with a hint.
package main

driver func main(net Net) error {
	ln, err := net.ListenTCP("127.0.0.1:0")
	if err != nil {
		return err
	}
	defer ln.Close()
	ctx, cancel := NewContext()
	defer cancel()
	conn, aerr := ln.Accept(ctx)
	if aerr != nil {
		return aerr
	}
	return nil
}
