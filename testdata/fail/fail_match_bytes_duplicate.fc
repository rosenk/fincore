// SINCE: v0.3
// fail_match_bytes_duplicate (v0.3): string patterns on a []byte
// scrutinee are compared by value; a constant equal to an earlier literal
// is an unreachable duplicate (E2012).
package main

const Get = "GET"

func method(b []byte) u32 {
	match b {
		"GET" -> return 1
		"PUT" -> return 2
		Get -> return 3 // ERROR E2012
	}
	return 0
}

driver func main(io Stdio) error {
	return nil
}
