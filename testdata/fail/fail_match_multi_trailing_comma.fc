// SINCE: v0.3
// fail_match_multi_trailing_comma (v0.3): a ',' after the last value of a
// multi-value arm is read as an arm separator when the rest up to the end
// of the arm is another arm (no automatic ';' follows a ','): the first
// ',' already ends the arm `0 -> 1`, and `2, _ -> 3, 4` is parsed as an
// arm whose pattern `2` must be followed by '->' (the error is at the
// second ',').
package main

func f(n u32) (u32, u32) {
	return match n {
		0 -> 1, 2, // ERROR E1001
		_ -> 3, 4
	}
}

driver func main(io Stdio) error {
	return nil
}
