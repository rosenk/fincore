// fail_pattern_tuple_non_exhaustive (v0.2): a match on a tuple must be
// exhaustive; the witnesses are `(Int(_, _), Bool(_)), (Bool(_), Int(_, _))`.
package main

type Val enum {
	Int(u32, u32)
	Bool(bool)
}

func same(a Val, b Val) bool {
	match (a, b) { // ERROR E2012
		(Int(x, _), Int(y, _)) -> return x == y
		(Bool(x), Bool(y)) -> return x == y
	}
	return false
}

driver func main(io Stdio) error {
	_ = same(Val.Bool(true), Val.Bool(true))
	return nil
}
