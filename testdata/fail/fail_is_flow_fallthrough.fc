// fail_is_flow_fallthrough (v0.2): a let-else binding may be used after
// the if statement only if its then block cannot complete normally (ends
// in return, panic, break, continue, an exhaustive terminating match...).
package main

type Option[T any] enum {
	Some(T)
	None
}

func f(o Option[u32]) u32 {
	var n u32 = 0
	if !(o is Some(x)) {
		n = 1
	}
	return n + x // ERROR E2002
}

driver func main(io Stdio) error {
	_ = f(Option[u32].None)
	return nil
}
