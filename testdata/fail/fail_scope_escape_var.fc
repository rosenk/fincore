// fail_scope_escape_var: `buf` handed to a conns.Go task (origin depth 3)
// is stored into a pointer variable owned by main (depth 1): 3 > 1.
package main

const (
	Slots   = 4
	BufSize = 16
)

driver func main(io Stdio) error {
	ctx, cancel := NewContext()
	defer cancel()

	var pool [Slots][BufSize]byte
	var outer [BufSize]byte
	saved := &outer

	scope conns := NewScope(Slots) {
		slot, err := conns.AcquireSlot(ctx, &pool)
		if err != nil {
			return err
		}
		conns.Go(slot, driver func(buf *[BufSize]byte) {
			saved = buf // ERROR E3002
		})
	}

	saved[0] = 1
	return nil
}
