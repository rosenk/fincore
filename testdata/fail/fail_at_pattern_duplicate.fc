// fail_at_pattern_duplicate (v0.2): `x @ P` binds x; P may not bind x
// again (names are unique within one pattern).
package main

type Option enum {
	Some(u32)
	None
}

func f(o Option) u32 {
	return match o {
		x @ Some(x) -> 1 // ERROR E2002
		None -> 0
	}
}

driver func main(io Stdio) error {
	_ = f(Option.None)
	return nil
}
