// fail_is_flow_duplicate (v0.2): one outcome set may not bind a name
// twice (here the true outcome of an && chain).
package main

type Option[T any] enum {
	Some(T)
	None
}

func f(a Option[u32], b Option[u32]) u32 {
	if a is Some(x) && b is Some(x) { // ERROR E2001
		return x
	}
	return 0
}

driver func main(io Stdio) error {
	_ = f(Option[u32].None, Option[u32].None)
	return nil
}
