// SINCE: v0.3
// fail_match_multi_linear (v0.3): a Linear variable named as a value of a
// multi-value match arm is moved into the result, like a single-value
// arm or the right-hand side of an assignment; using it afterwards is
// E3003.
package main

driver func main(net Net) error {
	ln, err := net.ListenTCP("127.0.0.1:0")
	if err != nil {
		return err
	}
	defer ln.Close()
	ctx, cancel := NewContext()
	defer cancel()
	conn, err := ln.Accept(ctx)
	if err != nil {
		return err
	}
	k := u32(1)
	c, n := match k {
		0 -> conn, u32(0)
		_ -> conn, k
	}
	_ = n
	_ = conn.Close() // ERROR E3003
	return c.Close()
}
