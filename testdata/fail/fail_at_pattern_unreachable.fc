// fail_at_pattern_unreachable (v0.2): `x @ _` matches every value, so the
// arms after it are unreachable (E2012).
package main

type Color enum {
	Red
	Green
}

func f(c Color) u32 {
	return match c {
		all @ _ -> 1
		Red -> 2 // ERROR E2012
	}
}

driver func main(io Stdio) error {
	_ = f(Color.Red)
	return nil
}
