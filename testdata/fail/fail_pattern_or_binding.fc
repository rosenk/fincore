// fail_pattern_or_binding (v0.2): every alternative of an or-pattern must
// bind the same variables with identical types; B binds n, A does not.
package main

type T enum {
	A(u32, u32)
	B(u32, u32)
}

func f(t T) u32 {
	return match t {
		A(r, _) | B(r, n) -> r + n // ERROR E2002
	}
}

driver func main(io Stdio) error {
	_ = f(T.A(1, 2))
	return nil
}
