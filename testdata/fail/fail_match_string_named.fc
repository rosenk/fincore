// SINCE: v0.3
// fail_match_string_named (v0.3 docs; v0.2 behaviour): a string constant
// pattern must be assignable to the position's type; a constant of a
// named string type does not match a plain string position (Go
// assignability), although it matches a []byte position.
package main

type Name string

const Del Name = "DELETE"

func method(s string) u32 {
	return match s {
		Del -> 1 // ERROR E2002
		_ -> 0
	}
}

driver func main(io Stdio) error {
	return nil
}
