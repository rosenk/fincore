// fail_is_flow_intersect_one_side (v0.2): a let-else over && binds only
// the names bound by both operands; y is bound on one path only.
package main

type Option[T any] enum {
	Some(T)
	None
}

func f(a Option[u32], b Option[u32], c Option[u32]) u32 {
	if !(a is Some(x) && c is Some(y)) && !(b is Some(x)) {
		return 0
	}
	return x + y // ERROR E2001
}

driver func main(io Stdio) error {
	_ = f(Option[u32].None, Option[u32].None, Option[u32].None)
	return nil
}
