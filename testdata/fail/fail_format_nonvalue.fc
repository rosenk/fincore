// fail_format_nonvalue: formatTo arguments must be Value types; a pointer
// is Scoped (v0.2).
package main

type Box struct {
	n int
}

func (b Box) Format(dst []byte) usize {
	return formatTo(dst, "box %d", b.n)
}

driver func main(io Stdio) error {
	var b [32]byte
	x := Box{n: 1}
	p := &x
	n := formatTo(b[:], "%v",
		p) // ERROR E2002
	return io.WriteStdout(b[:n])
}
