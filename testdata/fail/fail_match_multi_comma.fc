// SINCE: v0.3
// fail_match_multi_comma (v0.3): ',' after an arm value continues the
// value list unless the rest of the arm is another arm; so multi-value
// arms cannot be separated by ',' (use ';' or newlines). Here the second
// ',' separates arms and `2, B -> ...` is not an arm.
package main

type K enum {
	A
	B
}

func f(k K) (u32, u32) {
	return match k { A -> 1, 2, B -> 3, 4 } // ERROR E1001
}

driver func main(io Stdio) error {
	return nil
}
