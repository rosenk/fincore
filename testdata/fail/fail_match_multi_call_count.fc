// fail_match_multi_call_count (v0.3): as the only argument of a call a
// multi-value match supplies one argument per value (like a multi-result
// call, Go's f(g())); two values for one parameter are too many.
package main

func one(a u32) u32 {
	return a
}

func f(n u32) u32 {
	return one(match n { 0 -> n, 2; _ -> 3, n }) // ERROR E2003
}

driver func main(io Stdio) error {
	return nil
}
