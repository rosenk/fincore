// fail_const_pattern_unreachable (v0.2): a bare name that is neither a
// variant nor a constant binds the whole value and matches everything, so
// the arms after it are unreachable (here a misspelt constant).
package main

const Limit = 10

func f(n u32) u32 {
	return match n {
		0 -> 1
		Limt -> 2
		Limit -> 3 // ERROR E2012
	}
}

driver func main(io Stdio) error {
	_ = f(3)
	return nil
}
