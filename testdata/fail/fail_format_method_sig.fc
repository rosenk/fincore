// fail_format_method_sig: a type whose Format method has a pointer
// receiver cannot be formatted with %v (v0.2 formatTo requires a total
// value-receiver method `Format(dst []byte) usize`).
package main

type Meters u32

func (m *Meters) Format(dst []byte) usize {
	return formatTo(dst, "%dm", u32(*m))
}

driver func main(io Stdio) error {
	var b [32]byte
	var m Meters = 3
	n := formatTo(b[:], "%v",
		m) // ERROR E2002
	return io.WriteStdout(b[:n])
}
