// fail_pattern_is_binding (v0.2): an `is` expression may bind variables
// only in the condition of an if statement (or a conjunct of its
// top-level && chain).
package main

type Option[T any] enum {
	Some(T)
	None
}

func f(o Option[u32]) bool {
	ok := o is Some(x) // ERROR E2002
	return ok
}

driver func main(io Stdio) error {
	_ = f(Option[u32].None)
	return nil
}
