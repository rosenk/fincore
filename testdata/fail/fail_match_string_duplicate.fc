// SINCE: v0.3
// fail_match_string_duplicate (v0.3 docs; v0.2 behaviour): a repeated
// string constant in a match on a string is unreachable.
package main

const Yes = "yes"

func answer(s string) bool {
	return match s {
		Yes | "y" -> true
		"yes" -> true // ERROR E2012
		_ -> false
	}
}

driver func main(io Stdio) error {
	return nil
}
