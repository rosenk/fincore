// SINCE: v0.3
// pass_variant_multi_call (v0.3, decision 153): `Shape.Rect(pair())`, a
// variant constructor whose only argument is a multi-result call, in v0.2
// syntax. The v0.2 compilers (finc0 and the v0.2.0 seed) accept it in the
// checker but emit Go that does not compile; v0.3 lowers it like a call
// f(g()). Also a generic enum, a folded comptime call, a three-value
// payload of mixed types and a payload of enum type.
package main

type Shape enum {
	Circle(u32)
	Rect(u32, u32)
	Empty
}

type Two[T any] enum {
	None
	Both(T, T)
}

type Tagged enum {
	Plain(u8)
	Labeled(u8, bool, Shape)
}

func pair(n u32) (u32, u32) {
	return n, n + 1
}

func labeled(n u8) (u8, bool, Shape) {
	return n, n > 1, Shape.Rect(pair(u32(n)))
}

comptime func cpair() (u32, u32) {
	return 7, 8
}

func area(s Shape) u32 {
	match s {
		Shape.Rect(w, h) -> {
			return w * h
		}
		Shape.Circle(r) -> {
			return 3 * r * r
		}
		Shape.Empty -> {
			return 0
		}
	}
}

func sumTwo(t Two[u64]) u64 {
	match t {
		Both(a, b) -> {
			return a + b
		}
		_ -> {
			return 0
		}
	}
}

func dpair() (u64, u64) {
	return 100, 23
}

func tagged(t Tagged) u32 {
	match t {
		Tagged.Labeled(n, true, s) -> {
			return u32(n) + area(s)
		}
		Tagged.Labeled(n, false, _) -> {
			return u32(n)
		}
		Tagged.Plain(n) -> {
			return u32(n)
		}
	}
}

driver func main(io Stdio) error {
	a := Shape.Rect(pair(4))
	b := Two[u64].Both(dpair())
	c := Shape.Rect(cpair())
	d := Tagged.Labeled(labeled(3))
	e := Tagged.Labeled(labeled(1))
	var out [128]byte
	m := formatTo(out[:], "%d %d %d %d %d %d\n", area(a), sumTwo(b), area(c), tagged(d), tagged(e), area(Shape.Rect(pair(1))))
	return io.WriteStdout(out[:m])
}
