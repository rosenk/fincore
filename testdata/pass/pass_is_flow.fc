// pass_is_flow (v0.2): flow-scoped `is` bindings. && chains in any
// expression (return, assignment, call arguments, match-arm expressions,
// guards), || with false-outcome bindings, if/else outcomes, let-else
// (return, continue, break, panic, exhaustive match; with ||, over a
// negated && chain and inside loops), for conditions (three-clause and while form), ! and parentheses,
// shadowing, is in match expression arms, constant patterns (a let-else
// over a constant payload, a top-level binding, tuple-element bindings
// with && guards) and comptime.
package main

type Option[T any] enum {
	Some(T)
	None
}

type Val enum {
	Int(u32, u32)
	Bool(bool)
	Str(string)
	Pair(u32, u32)
}

type Ty enum {
	Slice(u32)
	Named(u32)
	Ptr
}

// && chain in a return statement.
func intIs(v Val, want u32) bool {
	return v is Int(_, x) && x == want
}

// && chain in an assignment and in call arguments.
func sumLow(a Val, b Val) u32 {
	ok := a is Int(h, l) && h == 0 && l > 0
	var r u32 = 0
	if ok {
		r = 1
	}
	return r + pick(b is Pair(x, y) && x < y, 10, 20)
}

func pick(c bool, a u32, b u32) u32 {
	if c {
		return a
	}
	return b
}

// || : the false outcome of the left operand is visible on the right.
func notBigInt(v Val) bool {
	return !(v is Int(_, l)) || l < 100
}

// if / else: the false outcome is visible in the else branch.
func elseUse(v Val) u32 {
	if !(v is Int(h, l)) {
		return 0
	} else {
		return h*1000 + l
	}
}

// let-else: the rest of the block sees the binding.
func sliceElem(t Ty) u32 {
	if !(t is Slice(e)) {
		return 0
	}
	return e + 1
}

// let-else over a negated && chain: the chain's true outcome.
func bigElem(t Ty) u32 {
	if !(t is Slice(e) && e > 3) {
		return 0
	}
	return e
}

// let-else with ||: both bindings after the if.
func addPairs(a Val, b Val) u32 {
	if !(a is Pair(p, q)) || !(b is Int(_, r)) {
		return 7
	}
	return p + q + r
}

// let-else with an exhaustive match and with panic as the exit.
func viaMatch(v Val) u32 {
	if !(v is Str(s)) {
		match v {
			Int(_, l) -> return l
			_ -> return 1
		}
	}
	return u32(len(s))
}

driver func mustInt(v Val) u32 {
	if !(v is Int(_, l)) {
		panic("not an int")
	}
	return l
}

// let-else inside loops (continue and break).
func sumInts(vs []Val) u32 {
	var n u32 = 0
	for i := usize(0); i < len(vs); i++ {
		if !(vs[i] is Int(_, l)) {
			continue
		}
		if !(l < 1000) {
			break
		}
		n += l
	}
	return n
}

func firstBools(vs []Val) u32 {
	var n u32 = 0
	for i := usize(0); i < len(vs); i++ {
		if !(vs[i] is Bool(b)) {
			break
		}
		if b {
			n++
		}
	}
	return n
}

// for condition (three-clause form): bindings in the body.
driver func prefixSum(vs []Val) u32 {
	var n u32 = 0
	driver for i := usize(0); i < len(vs) && vs[i] is Int(_, l) && l > 0; i++ {
		n += l
	}
	return n
}

// Shadowing: the binding x shadows the parameter in the then block only;
// an inner block may shadow it again.
func shadow(x u32, o Option[u32]) u32 {
	if o is Some(x) && x > 5 {
		if true {
			x := x * 2
			return x
		}
	}
	return x
}

// let-else rebinding of an outer variable's name in a nested block.
func rebind(o Option[u32]) u32 {
	v := u32(3)
	{
		if !(o is Some(v)) {
			return v
		}
		v += 100
		return v
	}
}

// Parentheses and double negation are transparent.
func paren(v Val) u32 {
	if !(!((v is Pair(a, b)))) && (a < b) {
		return b - a
	}
	return 0
}

// is in match-expression arms, with && chains, and in guards.
func arms(v Val, o Option[u32]) u32 {
	return match v {
		Int(h, _) if o is Some(k) && k > h -> k - h
		Int(..) -> pick(o is Some(k) && k == 0, 50, 60)
		Pair(a, _) -> match o {
			Some(k) if k > a -> k
			_ -> 70
		}
		_ -> 80
	}
}

func armIs(v Val) bool {
	return match v {
		Pair(a, b) -> a == b
		_ -> v is Int(h, l) && h == l
	}
}

// Nested let-else with a guard chain and a nested option.
func nested(o Option[Option[u32]]) u32 {
	if !(o is Some(inner)) {
		return 1
	}
	if !(inner is Some(v)) || v == 0 {
		return 2
	}
	return v
}

// A binding that is never used anywhere is fine.
func unused(v Val) bool {
	b := v is Int(h, l)
	return b
}

// An if without else whose then block falls through: its false-outcome
// bindings are simply not used.
func fallThrough(v Val) u32 {
	var n u32 = 1
	if !(v is Int(_, l)) {
		n = 2
	}
	return n
}

// Constant patterns combined with flow bindings: constants in an `is`
// pattern compare (let-else over a constant payload), a top-level binding
// in `is`, and tuple-element bindings whose guards use && chains.
const BPanic = 61
const Limit u32 = 5

type Call enum {
	Builtin(u32, u32)
	User(u32)
}

func panicArgs(c Call) u32 {
	if !(c is Builtin(BPanic, n)) {
		return 0
	}
	return n
}

func atLimit(o Option[u32]) bool {
	return o is Some(Limit) || o is None
}

func bigSum(a u32, b u32) bool {
	return a+b is s && s > 10
}

func tupleGuard(a u32, b u32, o Option[u32]) u32 {
	return match (a, b) {
		(x, 0) | (0, x) if o is Some(k) && k > x -> k - x
		(x, y) if !(o is Some(k)) || k == 0 -> x + y
		_ -> 1000
	}
}

// while-form for condition in a driver loop.
driver func countDown(start Option[u32]) u32 {
	cur := start
	var steps u32 = 0
	driver for cur is Some(n) {
		steps += n
		if n == 0 {
			cur = Option[u32].None
		} else {
			cur = Option[u32].Some(n - 1)
		}
	}
	return steps
}

// comptime evaluates flow bindings.
comptime func ctFlow(n u32) u32 {
	var o Option[u32] = Option[u32].None
	if n > 0 {
		o = Option[u32].Some(n)
	}
	if !(o is Some(x)) {
		return 99
	}
	r := x
	if o is Some(y) && y > 2 {
		r += 100
	}
	ok := o is Some(z) && z == 1
	if ok {
		r += 1000
	}
	return r
}

const CT1 = ctFlow(0)
const CT2 = ctFlow(1)
const CT3 = ctFlow(5)

driver func line(io Stdio, label string, v u64) error {
	var b [64]byte
	n := formatTo(b[:], "%s: %d\n", label, v)
	return io.WriteStdout(b[:n])
}

driver func flag(io Stdio, label string, v bool) error {
	var b [64]byte
	n := formatTo(b[:], "%s: %v\n", label, v)
	return io.WriteStdout(b[:n])
}

driver func main(io Stdio) error {
	if err := flag(io, "intIs", intIs(Val.Int(1, 5), 5)); err != nil {
		return err
	}
	if err := flag(io, "intIs no", intIs(Val.Bool(true), 5)); err != nil {
		return err
	}
	if err := line(io, "sumLow", u64(sumLow(Val.Int(0, 3), Val.Pair(1, 2))*100+sumLow(Val.Int(1, 3), Val.Pair(2, 1)))); err != nil {
		return err
	}
	if err := flag(io, "notBigInt", notBigInt(Val.Int(0, 500))); err != nil {
		return err
	}
	if err := flag(io, "notBigInt str", notBigInt(Val.Str("x"))); err != nil {
		return err
	}
	if err := line(io, "elseUse", u64(elseUse(Val.Int(4, 2))*10+elseUse(Val.Bool(false)))); err != nil {
		return err
	}
	if err := line(io, "sliceElem", u64(sliceElem(Ty.Slice(41))*1000+sliceElem(Ty.Ptr))); err != nil {
		return err
	}
	if err := line(io, "bigElem", u64(bigElem(Ty.Slice(9))*10+bigElem(Ty.Slice(2)))); err != nil {
		return err
	}
	if err := line(io, "addPairs", u64(addPairs(Val.Pair(1, 2), Val.Int(0, 3))*100+addPairs(Val.Pair(1, 2), Val.Bool(true)))); err != nil {
		return err
	}
	if err := line(io, "viaMatch", u64(viaMatch(Val.Str("abcd"))*1000+viaMatch(Val.Int(0, 9))*10+viaMatch(Val.Bool(true)))); err != nil {
		return err
	}
	if err := line(io, "mustInt", u64(mustInt(Val.Int(0, 12)))); err != nil {
		return err
	}
	var vs [6]Val
	vs[0] = Val.Int(0, 1)
	vs[1] = Val.Str("skip")
	vs[2] = Val.Int(0, 20)
	vs[3] = Val.Int(0, 2000)
	vs[4] = Val.Int(0, 300)
	vs[5] = Val.Bool(true)
	if err := line(io, "sumInts", u64(sumInts(vs[:]))); err != nil {
		return err
	}
	if err := line(io, "prefixSum", u64(prefixSum(vs[:]))); err != nil {
		return err
	}
	var bs [4]Val
	bs[0] = Val.Bool(true)
	bs[1] = Val.Bool(false)
	bs[2] = Val.Bool(true)
	bs[3] = Val.Int(0, 0)
	if err := line(io, "firstBools", u64(firstBools(bs[:]))); err != nil {
		return err
	}
	if err := line(io, "shadow", u64(shadow(1, Option[u32].Some(9))*1000+shadow(1, Option[u32].Some(2))*10+shadow(3, Option[u32].None))); err != nil {
		return err
	}
	if err := line(io, "rebind", u64(rebind(Option[u32].Some(5))*10+rebind(Option[u32].None))); err != nil {
		return err
	}
	if err := line(io, "paren", u64(paren(Val.Pair(3, 10))*10+paren(Val.Pair(10, 3)))); err != nil {
		return err
	}
	var as u64 = 0
	as = as*100 + u64(arms(Val.Int(2, 0), Option[u32].Some(9)))
	as = as*100 + u64(arms(Val.Int(2, 0), Option[u32].Some(0)))
	as = as*100 + u64(arms(Val.Int(2, 0), Option[u32].None))
	as = as*100 + u64(arms(Val.Pair(4, 0), Option[u32].Some(9)))
	as = as*100 + u64(arms(Val.Pair(4, 0), Option[u32].Some(1)))
	as = as*100 + u64(arms(Val.Bool(true), Option[u32].None))
	if err := line(io, "arms", as); err != nil {
		return err
	}
	if err := flag(io, "armIs", armIs(Val.Int(3, 3)) && armIs(Val.Pair(1, 1)) && !armIs(Val.Int(1, 2))); err != nil {
		return err
	}
	var n3 u64 = u64(nested(Option[Option[u32]].None))*100 + u64(nested(Option[Option[u32]].Some(Option[u32].None)))*10
	if err := line(io, "nested", n3+u64(nested(Option[Option[u32]].Some(Option[u32].Some(7))))); err != nil {
		return err
	}
	if err := flag(io, "unused", unused(Val.Int(1, 1))); err != nil {
		return err
	}
	if err := line(io, "fallThrough", u64(fallThrough(Val.Int(0, 1))*10+fallThrough(Val.Bool(true)))); err != nil {
		return err
	}
	if err := line(io, "panicArgs", u64(panicArgs(Call.Builtin(61, 2))*100+panicArgs(Call.Builtin(60, 2))*10+panicArgs(Call.User(61)))); err != nil {
		return err
	}
	if err := flag(io, "atLimit", atLimit(Option[u32].Some(5)) && atLimit(Option[u32].None) && !atLimit(Option[u32].Some(4))); err != nil {
		return err
	}
	if err := flag(io, "bigSum", bigSum(6, 5) && !bigSum(5, 5)); err != nil {
		return err
	}
	var tg u64 = u64(tupleGuard(3, 0, Option[u32].Some(10)))*1000000 + u64(tupleGuard(0, 3, Option[u32].Some(2)))*1000
	if err := line(io, "tupleGuard", tg+u64(tupleGuard(4, 5, Option[u32].None))); err != nil {
		return err
	}
	if err := line(io, "countDown", u64(countDown(Option[u32].Some(4)))); err != nil {
		return err
	}
	return line(io, "comptime", u64(CT1)*1000000+u64(CT2)*1000+u64(CT3))
}
