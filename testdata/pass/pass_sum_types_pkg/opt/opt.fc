// Imported local package for pass_sum_types_pkg: generic sum types and
// their methods, used from another package.
package opt

type Option[T any] enum {
	Some(T)
	None
}

type Result[T any] enum {
	Ok(T)
	Err(error)
}

type Pair[A any, B any] enum {
	Left(A)
	Right(B)
	Both(A, B)
}

func (o Option[T]) Or(d T) T {
	return match o {
		Some(x) -> x
		None -> d
	}
}

func (o *Option[T]) Take() Option[T] {
	old := *o
	*o = Option[T].None
	return old
}

func Lift[T any](r Result[T]) Option[T] {
	return match r {
		Ok(v) -> Option[T].Some(v)
		Err(_) -> Option[T].None
	}
}

func Count[A any, B any](p Pair[A, B]) u32 {
	return match p {
		Left(_) | Right(_) -> 1
		Both(_, _) -> 2
	}
}

func Half(n u32) Result[u32] {
	if n%2 != 0 {
		return Result[u32].Err(ErrParse)
	}
	return Result[u32].Ok(n / 2)
}
