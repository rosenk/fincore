Clean("") = "."
Clean("/") = "/"
Clean(".") = "."
Clean("..") = ".."
Clean("a/../..") = ".."
Clean("//a//b/./c/..") = "/a/b"
Clean("a/b/c") = "a/b/c"
Clean("a/b/c/") = "a/b/c"
Clean("/../a") = "/a"
Clean("../../a/b/../c") = "../../a/c"
Clean("a/./b/./") = "a/b"
Clean("abc/def/../../..") = ".."
Clean("/abc/def/../../..") = "/"
Clean("./a") = "a"
Clean("a//") = "a"
Clean("...") = "..."
Clean("a/.../b") = "a/.../b"
Clean("..a/b..") = "..a/b.."
Clean in place("x//y/../z/.") = "x/z"
Clean small dst: 0 3 0
Join("a", "b") = "a/b"
Join("a/", "/b") = "a/b"
Join("", "") = ""
Join("", "x/../y") = "y"
Join("a/b", "") = "a/b"
Join("a", "../../c") = "../c"
Join("/", "a") = "/a"
Join("std", "vec") = "std/vec"
Join small dst: 0
Base("") = "."
Base("/") = "/"
Base("///") = "/"
Base("a/b/c.fc") = "c.fc"
Base("a/b/") = "b"
Base("name") = "name"
Dir("") = "."
Dir("a") = "."
Dir("/a") = "/"
Dir("a/b/c") = "a/b"
Dir("a/b/") = "a/b"
Dir("//x//y") = "/x"
Ext("a/b.fc") = ".fc"
Ext("a.b/c") = ""
Ext("x.tar.gz") = ".gz"
Ext(".hidden") = ".hidden"
Ext("noext") = ""
Split("a/b/c") = "a/b/", "c"
Split("abc") = "", "abc"
Split("/") = "/", ""
IsAbs: ok
