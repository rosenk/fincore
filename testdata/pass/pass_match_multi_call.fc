// SINCE: v0.3
// pass_match_multi_call (v0.3, decision 149): a multi-value match as the
// only argument of a call supplies one argument per value (Go's f(g())),
// and the parameter types are the context of its value positions, as for
// assignment targets: a position that is an untyped constant in every arm
// takes the parameter's type, and arms may be multi-result calls or nested
// multi-value matches. This holds for functions, methods and builtins with
// a fixed signature (formatUint) with two or more parameters.
package main

func add(a u32, b u32) u32 {
	return a + b
}

func wide(a u64, b i8, c bool) u64 {
	if c && b < 0 {
		return a + 1
	}
	return a
}

type Acc struct {
	sum u64
}

func (a *Acc) add(x u64, y u16) {
	a.sum = a.sum + x + u64(y)
}

func two(n u32) (u32, u32) {
	return n, n + 1
}

// Arms that are multi-result calls or nested multi-value matches.
func viaCalls(n u32) u32 {
	return add(match n {
		0 -> two(10)
		1 -> match n {
			1 -> 5, 6
			_ -> 7, 8
		}
		_ -> 1, 1
	})
}

func f(n u32) u32 {
	return add(match n {
		0 -> 1, 2
		_ -> 3, 4
	})
}

func g(n u32) u64 {
	return wide(match n {
		0 -> 1, -1, true
		_ -> 2, 1, false
	})
}

driver func main(io Stdio) error {
	var acc Acc
	acc.add(match f(0) {
		3 -> 10, 20
		_ -> 30, 40
	})
	var b [32]byte
	k, err := formatUint(match acc.sum {
		30 -> 7, b[:]
		_ -> 9, b[:]
	})
	if err != nil {
		return err
	}
	var out [128]byte
	m := formatTo(out[:], "%d %d %d %d %d %s %d %d %d\n", f(0), f(1), g(0), g(1), acc.sum, b[:k], viaCalls(0), viaCalls(1), viaCalls(2))
	return io.WriteStdout(out[:m])
}
