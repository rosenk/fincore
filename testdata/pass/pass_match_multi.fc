// SINCE: v0.3
// pass_match_multi (v0.3): multi-value match expressions. In a context
// that expects N values (`return` in a function with N results, `:=` and
// `=` with N targets) every arm gives N values: a value list `-> a, b`
// (separated from the next arm by ';' or a newline), a call with N
// results, or a nested multi-value match. Values at one position agree
// like the arms of a single-value match: untyped constants take the type
// of the typed values, or, if untyped in every arm, the type of the
// target (result or existing variable) or their default type. Flat
// matches, if chains (guards, bindings), tuple scrutinees, string
// scrutinees, `return` inside a scope block, '_' targets, parenthesized
// matches, a ',' continuing a value list over a line break, a `:=` that
// redeclares a typed variable (an all-untyped position takes its type;
// untyped int and char mix to untyped int), a match as the only argument
// of a call (one argument per value, like a multi-result call), and
// comptime.
package main

type Val enum {
	Int(u32, u32)
	Str(string)
	Pair(Val2)
	None
}

type Val2 enum {
	A(u32)
	B
}

// Flat match lowered in place: every arm returns its values.
func split(v Val) (u32, u32, bool) {
	return match v {
		Int(h, l) -> h, l, true
		_ -> 0, 0, false
	}
}

// One-line form with ';', untyped constants typed by the results.
func flags(n u32) (u8, bool) {
	return match n { 0 -> 255, false; 1 -> 1, true; _ -> 2, n > 10 }
}

// Guards and bindings (if chain), a string value, a value list broken
// over two lines after a ','.
func describe(v Val) (u32, string) {
	return match v {
		Int(h, _) if h > 100 -> h, "big"
		Int(h, l) -> h + l,
			"int"
		Str(s) -> u32(len(s)), s
		Pair(A(x)) -> x, "pair"
		Pair(B) | None -> 0, ""
	}
}

func pairOf(n u32) (u32, bool) {
	return n * 2, n > 5
}

// Arms that are calls with N results or nested multi-value matches.
func nested(v Val, k u32) (u32, bool) {
	return match v {
		Int(h, _) -> match k {
			0 -> h, true
			_ -> pairOf(h)
		}
		Pair(p) -> match p { A(x) -> x, false; B -> 7, true }
		_ -> pairOf(k)
	}
}

// Tuple scrutinee and string scrutinee.
func both(a bool, s string) (u32, u32) {
	return match (a, s) {
		(true, "x") -> 1, 1
		(true, _) -> 1, 0
		(false, "x") -> 0, 1
		_ -> 0, 0
	}
}

// A parenthesized match and a match whose value lists mix typed and
// untyped values per position.
func paren(n u32) (u32, u64) {
	return (match n {
		0 -> n, 5
		_ -> 7, u64(n)
	})
}

func add3(a u32, b u32, c bool) u32 {
	if c {
		return a + b
	}
	return a
}

// The only argument of a call: one argument per value (Go's f(g())). The
// parameters give no types: typed values (or default types) are needed.
func callArg(n u32) u32 {
	return add3(match n { 0 -> n, u32(5), true; _ -> u32(1), n, false })
}

// `return match` inside a scope block (results evaluated before Wait).
driver func scoped(n u32) (u32, bool) {
	scope s := NewScope(2) {
		return match n {
			0 -> 10, true
			_ -> n, false
		}
	}
}

comptime func ctSplit(a u32, b u32) u32 {
	h, l, ok := match Val.Int(a, b) {
		Int(x, y) -> x, y, true
		_ -> 0, 0, false
	}
	if !ok {
		return 0
	}
	c, d := nested(Val.Pair(Val2.A(9)), 0)
	if d {
		return 0
	}
	return h*1000 + l*10 + c
}

const CS = ctSplit(3, 4)

driver func line(io Stdio, label string, v u64) error {
	var b [64]byte
	n := formatTo(b[:], "%s: %d\n", label, v)
	return io.WriteStdout(b[:n])
}

driver func sline(io Stdio, label string, s string) error {
	var b [64]byte
	n := formatTo(b[:], "%s: %s\n", label, s)
	return io.WriteStdout(b[:n])
}

func b2u(b bool) u64 {
	return match b { true -> 1, false -> 0 }
}

driver func main(io Stdio) error {
	h, l, ok := split(Val.Int(1, 2))
	h2, _, ok2 := split(Val.None)
	if err := line(io, "split", u64(h)*1000+u64(l)*100+b2u(ok)*10+u64(h2)+b2u(ok2)); err != nil {
		return err
	}
	f0, g0 := flags(0)
	f1, g1 := flags(1)
	f2, g2 := flags(11)
	if err := line(io, "flags", u64(f0)*100000+b2u(g0)*10000+u64(f1)*1000+b2u(g1)*100+u64(f2)*10+b2u(g2)); err != nil {
		return err
	}
	var vals [5]Val
	vals[0] = Val.Int(200, 1)
	vals[1] = Val.Int(3, 4)
	vals[2] = Val.Str("hey")
	vals[3] = Val.Pair(Val2.A(8))
	vals[4] = Val.None
	for i := usize(0); i < 5; i++ {
		n, s := describe(vals[i])
		var b [64]byte
		k := formatTo(b[:], "describe: %d %s\n", n, s)
		if err := io.WriteStdout(b[:k]); err != nil {
			return err
		}
	}
	a, b := nested(Val.Int(4, 0), 0)
	c, d := nested(Val.Int(4, 0), 1)
	e, f := nested(Val.Pair(Val2.B), 0)
	g, gg := nested(Val.None, 9)
	if err := line(io, "nested", u64(a)*10000000+b2u(b)*1000000+u64(c)*10000+b2u(d)*1000+u64(e)*100+b2u(f)*10+b2u(gg)); err != nil {
		return err
	}
	if err := line(io, "nested g", u64(g)); err != nil {
		return err
	}
	x1, y1 := both(true, "x")
	x2, y2 := both(false, "x")
	x3, y3 := both(true, "y")
	if err := line(io, "both", u64(x1)*100000+u64(y1)*10000+u64(x2)*1000+u64(y2)*100+u64(x3)*10+u64(y3)); err != nil {
		return err
	}
	p1, q1 := paren(0)
	p2, q2 := paren(3)
	if err := line(io, "paren", u64(p1)*1000+q1*100+u64(p2)*10+q2); err != nil {
		return err
	}
	// `=` to existing variables: untyped values take their types.
	var small u8 = 0
	var name string
	small, name = match h {
		1 -> 200, "one"
		_ -> 1, "other"
	}
	if err := sline(io, "assign", name); err != nil {
		return err
	}
	if err := line(io, "assign small", u64(small)); err != nil {
		return err
	}
	// `:=` with default types, a '_' target and a redeclared variable.
	small2, name, _ := match name { "one" -> 300, "1", true; _ -> 0, "?", false }
	if err := sline(io, "define", name); err != nil {
		return err
	}
	if err := line(io, "define int", u64(small2+1)); err != nil {
		return err
	}
	// `:=` redeclaring the u8 small: its all-untyped position takes u8;
	// 'a' and 3 mix to untyped int, so fresh is an int.
	small, fresh := match h { 1 -> 250, 'a'; _ -> 2, 3 }
	var wide int = fresh
	if err := line(io, "redeclare", u64(small)*1000+u64(wide)); err != nil {
		return err
	}
	if err := line(io, "callArg", u64(callArg(0))*10+u64(callArg(4))); err != nil {
		return err
	}
	s1, s2 := scoped(0)
	s3, s4 := scoped(6)
	if err := line(io, "scoped", u64(s1)*1000+b2u(s2)*100+u64(s3)*10+b2u(s4)); err != nil {
		return err
	}
	return line(io, "comptime", u64(CS))
}
