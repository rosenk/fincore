// pass_minmax_shadow: programs that declare their own min and max keep
// working when the language predeclares them (v0.3): package-level
// declarations shadow the universe like any predeclared name. Valid in
// every language version, so it has no SINCE (finc0 runs it too).
package main

// A package-level function min with its own signature and a package-level
// constant max: every use in the package refers to these.
func min(a u32, b u32, c u32) u32 {
	if a <= b && a <= c {
		return a
	}
	if b <= c {
		return b
	}
	return c
}

const max = 40

type Bounds struct {
	min u32
	max u32
}

func pick(b Bounds) u32 {
	return min(b.min, b.max, max)
}

driver func main(io Stdio) error {
	var buf [64]byte
	n := formatTo(buf[:], "%d %d %d\n", min(9, 4, 6), pick(Bounds{min: 50, max: 45}), max+1)
	return io.WriteStdout(buf[:n])
}
