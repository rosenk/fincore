// pass_is_flow2 (v0.2): `is` flow intersections. A name is bound in an
// outcome if it is bound on every path to it: T(A || B) = T(A) * T(B) and
// F(A && B) = F(A) * F(B) by name (identical types; one variable that
// either test assigns). Covers || on the true side, let-else over && on
// the false side, if/else, nested combinations, a three-way merge,
// different payload paths for the same name, names bound on one side only
// (not bound), uses inside the right operand, for conditions, guards,
// match-expression arms, a function literal capturing a merged name and
// comptime.
package main

type Option[T any] enum {
	Some(T)
	None
}

type Val enum {
	Int(u32, u32)
	Bool(bool)
	Pair(u32, u32)
	Wrap(Option[u32])
}

// || true side: either test binds x.
func either(a Option[u32], b Option[u32]) u32 {
	if a is Some(x) || b is Some(x) {
		return x
	}
	return 0
}

// && false side with let-else: h and l are bound after the if.
func letElse(v Val, w Val) u32 {
	if !(v is Int(h, l)) && !(w is Int(h, l)) {
		return 0
	}
	return h*100 + l
}

// De Morgan dual with a condition inside: the false outcome of
// !(A && c) is T(A && c).
func deMorgan(a Option[u32], b Option[u32]) u32 {
	if !(a is Some(x) && x > 0) && !(b is Some(x) && x > 0) {
		return 0
	}
	return x
}

// Different payload paths for one name: x is the first payload of Int,
// the second of Pair, and nested inside Wrap(Some(_)).
func paths(v Val) u32 {
	if v is Int(x, _) || v is Pair(_, x) || v is Wrap(Some(x)) {
		return x
	}
	return 7
}

// Nested combinations: (A || B) && C binds x from the disjunction and y
// from C; a name bound on one side only (z) is simply not bound.
func nested(a Option[u32], b Option[u32], c Option[u32]) u32 {
	if (a is Some(x) || (b is Some(x) && x > 1)) && c is Some(y) {
		return x*10 + y
	}
	if a is Some(z) || b is None {
		return 1
	}
	return 2
}

// Right-nested three-way merge and the else branch of an && false side.
func three(a Option[u32], b Option[u32], c Option[u32]) u32 {
	if a is Some(x) || (b is Some(x) || c is Some(x)) {
		return x
	}
	if !(a is None) && !(b is Some(_)) {
		return 5
	}
	if !(a is Some(k)) && !(b is Some(k)) {
		return 6
	} else {
		return k + 1000
	}
}

// The merged name is used only inside the right operand of one test and
// after the if; also in an && chain in a return statement.
func inside(a Option[u32], b Option[u32]) bool {
	return (a is Some(x) || b is Some(x)) && x == 3
}

// for condition: T(cond) in the body.
driver func loop(vs []Val) u32 {
	var n u32 = 0
	driver for i := usize(0); i < len(vs) && (vs[i] is Int(x, _) || vs[i] is Pair(x, _)); i++ {
		n += x
	}
	return n
}

// Guard bindings and match-expression arms.
func guard(v Val, o Option[u32]) u32 {
	return match v {
		Bool(_) if o is Some(x) || v is Int(x, _) -> x
		Int(a, _) -> match o {
			Some(_) if !(o is Some(k)) && !(v is Int(_, k)) -> 0
			_ -> a
		}
		_ -> 3
	}
}

// A function literal captures a merged binding.
func captured(a Option[u32], b Option[u32]) u32 {
	if !(a is Some(x)) && !(b is Some(x)) {
		return 0
	}
	f := func() u32 { return x + 1 }
	return f()
}

// comptime evaluates intersections.
comptime func ctMerge(n u32) u32 {
	var a Option[u32] = Option[u32].None
	var b Option[u32] = Option[u32].None
	if n > 10 {
		a = Option[u32].Some(n)
	} else if n > 0 {
		b = Option[u32].Some(n)
	}
	if !(a is Some(x)) && !(b is Some(x)) {
		return 99
	}
	r := x
	if a is Some(y) || b is Some(y) {
		r += y * 1000
	}
	return r
}

const CT1 = ctMerge(0)
const CT2 = ctMerge(5)
const CT3 = ctMerge(20)

driver func line(io Stdio, label string, v u64) error {
	var b [64]byte
	n := formatTo(b[:], "%s: %d\n", label, v)
	return io.WriteStdout(b[:n])
}

driver func flag(io Stdio, label string, v bool) error {
	var b [64]byte
	n := formatTo(b[:], "%s: %v\n", label, v)
	return io.WriteStdout(b[:n])
}

driver func main(io Stdio) error {
	s := Option[u32].Some(4)
	t := Option[u32].Some(9)
	z := Option[u32].Some(0)
	no := Option[u32].None
	if err := line(io, "either", u64(either(s, t))*10000+u64(either(no, t))*100+u64(either(no, no))); err != nil {
		return err
	}
	var le u64 = u64(letElse(Val.Int(1, 2), Val.Int(3, 4)))*1000000 + u64(letElse(Val.Bool(true), Val.Int(3, 4)))*1000
	if err := line(io, "letElse", le+u64(letElse(Val.Bool(true), Val.Pair(3, 4)))); err != nil {
		return err
	}
	if err := line(io, "deMorgan", u64(deMorgan(z, t))*10000+u64(deMorgan(s, t))*100+u64(deMorgan(z, z))); err != nil {
		return err
	}
	var pa u64 = u64(paths(Val.Int(1, 2)))*1000 + u64(paths(Val.Pair(3, 4)))*100 + u64(paths(Val.Wrap(t)))*10
	if err := line(io, "paths", pa+u64(paths(Val.Wrap(no)))); err != nil {
		return err
	}
	var ne u64 = u64(nested(s, no, t))*10000 + u64(nested(no, Option[u32].Some(2), t))*100 + u64(nested(no, z, t))
	if err := line(io, "nested", ne*10+u64(nested(no, s, no))); err != nil {
		return err
	}
	var th u64 = u64(three(s, t, t))*100000000 + u64(three(no, t, s))*1000000 + u64(three(no, no, s))*10000
	if err := line(io, "three", th+u64(three(no, no, no))*100); err != nil {
		return err
	}
	if err := line(io, "threeElse", u64(three(no, no, no))); err != nil {
		return err
	}
	if err := flag(io, "inside", inside(no, Option[u32].Some(3)) && inside(Option[u32].Some(3), no) && !inside(s, Option[u32].Some(3))); err != nil {
		return err
	}
	var vs [5]Val
	vs[0] = Val.Int(1, 0)
	vs[1] = Val.Pair(20, 0)
	vs[2] = Val.Int(300, 0)
	vs[3] = Val.Bool(true)
	vs[4] = Val.Int(4000, 0)
	if err := line(io, "loop", u64(loop(vs[:]))); err != nil {
		return err
	}
	var gu u64 = u64(guard(Val.Bool(true), t))*10000 + u64(guard(Val.Int(5, 6), s))*100 + u64(guard(Val.Bool(true), no))
	if err := line(io, "guard", gu); err != nil {
		return err
	}
	if err := line(io, "captured", u64(captured(no, t))*100+u64(captured(no, no))); err != nil {
		return err
	}
	return line(io, "comptime", u64(CT1)*100000000+u64(CT2)*10000+u64(CT3))
}
