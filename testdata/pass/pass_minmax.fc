// SINCE: v0.3
// pass_minmax (v0.3): the predeclared min and max. Two or more operands
// of one ordered type (integers of every width, named integer types,
// strings, named string types), typed like comparison operands: untyped
// constants take the type of the typed operands; all-constant calls are
// folded to constants (untyped if every operand is untyped, typed
// otherwise) and usable in const declarations and array lengths; untyped
// int and char operands mix to untyped char (default type u8). min and
// max are shadowable like len: locals,
// parameters and struct fields named min/max. Comptime evaluation.
package main

type Size u16

type Label string

const Lo = min(7, 3, 5)               // untyped 3
const Hi = max(7, 3, 5)               // untyped 7
const Small u8 = min(300, 2)          // untyped operands, typed result
const Width u32 = max(u32(4), 9, 2)   // typed constant 9
const Letter = max('a', 66)           // untyped char 'a' (97)
const First = min("pear", "apple")    // untyped string "apple"
const Neg = min(-3, 2, -10)           // -10
const Mixed = max(Size(3), 1000) + 1  // typed Size 1001

var table [max(2, Lo)]u32 // array length from a constant min/max

func clamp(x u32, lo u32, hi u32) u32 {
	return max(lo, min(x, hi))
}

func spread(a i8, b i8, c i8) i8 {
	return max(a, b, c) - min(a, b, c)
}

func longest(a string, b string) string {
	return max(a, b)
}

// Shadowing: a parameter, a local and a field named min/max.
type Range struct {
	min u32
	max u32
}

func width(r Range) u32 {
	return r.max - r.min
}

func useParam(max u32, x u32) u32 {
	min := x / 2
	return max + min
}

func inner(x u64) u64 {
	if x > 10 {
		min := u64(1)
		return min + x
	}
	return min(x, 5) // the builtin again outside the shadowing block
}

comptime func ctClamp(x i32, lo i32, hi i32) i32 {
	if lo > hi {
		return min(lo, hi, x)
	}
	return max(lo, min(x, hi))
}

const CtA = ctClamp(50, 0, 10)
const CtB = ctClamp(-5, 0, 10)
const CtC = ctClamp(4, 7, 2)

comptime func ctLast(a string, b string, c string) string {
	return max(a, b, c)
}

const CtS = ctLast("b", "c", "a")

driver func line(io Stdio, label string, v u64) error {
	var b [64]byte
	n := formatTo(b[:], "%s: %d\n", label, v)
	return io.WriteStdout(b[:n])
}

driver func sline(io Stdio, label string, s string) error {
	var b [64]byte
	n := formatTo(b[:], "%s: %s\n", label, s)
	return io.WriteStdout(b[:n])
}

driver func main(io Stdio) error {
	if err := line(io, "consts", u64(Lo)*1000+u64(Hi)*100+u64(Small)*10+u64(Width)); err != nil {
		return err
	}
	if err := line(io, "letter", u64(Letter)); err != nil {
		return err
	}
	if err := sline(io, "first", First); err != nil {
		return err
	}
	if err := line(io, "neg", u64(-Neg)); err != nil {
		return err
	}
	if err := line(io, "mixed", u64(Mixed)); err != nil {
		return err
	}
	if err := line(io, "table", u64(len(table))); err != nil {
		return err
	}
	var s u64 = 0
	for x := u32(0); x < 12; x += 3 {
		s = s*100 + u64(clamp(x, 2, 7))
	}
	if err := line(io, "clamp", s); err != nil {
		return err
	}
	if err := line(io, "spread", u64(spread(-5, 3, 1))); err != nil {
		return err
	}
	if err := sline(io, "longest", longest("abc", "abd")); err != nil {
		return err
	}
	if err := line(io, "width", u64(width(Range{min: 3, max: 10}))); err != nil {
		return err
	}
	if err := line(io, "param", u64(useParam(10, 8))); err != nil {
		return err
	}
	if err := line(io, "inner", inner(20)*100+inner(3)*10+inner(8)); err != nil {
		return err
	}
	a := u8(200)
	b := u8(100)
	var big u64 = 1 << 40
	sz := Size(70)
	if err := line(io, "runtime", u64(min(a, b, 150))*1000+u64(max(a, 250))); err != nil {
		return err
	}
	if err := line(io, "u64", max(big, 7, big+1)-min(big, 7)); err != nil {
		return err
	}
	if err := line(io, "named", u64(max(sz, 9))+u64(min(sz, Size(5)))); err != nil {
		return err
	}
	if err := line(io, "comptime", u64(CtA)*100+u64(CtB)*10+u64(CtC)); err != nil {
		return err
	}
	// A named string type; an untyped char result defaults to u8.
	lb := max(Label("b"), "a", Label("ab"))
	ch := max('a', 66)
	var cb u8 = ch
	if err := sline(io, "label", string(lb)); err != nil {
		return err
	}
	if err := line(io, "char", u64(cb)); err != nil {
		return err
	}
	return sline(io, "ctstring", CtS)
}
