// pass_const_patterns (v0.2): constant patterns and bindings in every
// pattern position. A bare identifier is a variant of the expected enum
// type, else a constant in scope (compared with ==), else a fresh
// binding: constants in payloads, at the top level and in tuple elements
// (local and package-level, typed and untyped, qualified pkg.C, enum
// valued), top-level and tuple-element bindings with guards, binding
// shadowing, or-patterns with tuple bindings, `is` and comptime.
package main

import "std/strconv"

type Color enum {
	Red
	Green
	Blue
}

type Val enum {
	Int(u32, u32)
	Builtin(u8, u32)
	Paint(Color)
	Name(string)
}

const SignBit = 1
const BFPanic u8 = 7
const BFCopy u8 = 9
const Hello = "hello"
const Def = Color.Red
const Yes = true

// Constants in payload positions (untyped, typed, string, enum valued).
func describe(v Val) u32 {
	return match v {
		Int(SignBit, 0) -> 1
		Int(SignBit, lo) -> 100 + lo
		Builtin(BFPanic, ..) -> 2
		Builtin(BFCopy, n) if n > 1 -> 3
		Builtin(strconv.MaxUintLen, _) -> 64
		Builtin(b, _) -> 10 + u32(b)
		Paint(Def) -> 4
		Paint(c) -> 4 + colorCode(c)
		Name(Hello) -> 6
		Name(_) -> 7
		Int(..) -> 8
	}
}

// Constants at the top level: local, package-level and qualified.
func width(n u32) u32 {
	const Small = 8
	return match n {
		Small -> 1
		strconv.MaxUintLen -> 2
		strconv.MaxIntLen | 66 -> 3
		_ -> 0
	}
}

// A top-level binding with a guard; a binding as the last (catch-all) arm.
func bucket(n u32) u32 {
	return match n {
		0 -> 0
		x if x > 10 -> x * 2
		x -> x + 1
	}
}

// Tuple-element bindings with guards and constants in tuple elements.
func order(a u32, b u32) u32 {
	return match (a, b) {
		(SignBit, SignBit) -> 11
		(x, y) if x > y -> x - y
		(x, y) -> y - x + 1000
	}
}

// Or-patterns whose alternatives bind the same tuple element variables.
func oneZero(a u32, b u32) u32 {
	match (a, b) {
		(x, 0) | (0, x) -> return x
		_ -> return 9999
	}
}

// Enum-valued constants count as their variant; together with the other
// variants they make the match exhaustive.
func colorCode(c Color) u32 {
	return match c {
		Def -> 1
		Green -> 2
		Blue -> 3
	}
}

// A constant of type bool and a binding cover bool.
func boolCode(b bool) u32 {
	return match b {
		Yes -> 1
		other -> if2(other)
	}
}

func if2(b bool) u32 {
	if b {
		return 3
	}
	return 2
}

// A binding shadows an outer variable of the same name.
func shadow(x u32, v Val) u32 {
	return match v {
		Int(x, _) -> x
		_ -> x
	}
}

// A bound top-level enum value; constants with `is`.
func colorOf(v Val) Color {
	match v {
		Paint(Red) -> return Color.Blue
		Paint(c) -> return c
		_ -> return Def
	}
}

func isPanic(v Val) bool {
	return v is Builtin(BFPanic, _)
}

// Variant names are not bindings that shadow anything: two tests of one
// && chain may name the same variant.
func bothRed(a Color, v Val) bool {
	if a is Red && v is Paint(Red) {
		return true
	}
	return false
}

// comptime evaluates constant patterns and top-level bindings.
comptime func ctPick(a u32, b u32) u32 {
	return match (a, b) {
		(SignBit, y) -> y
		(x, y) if x > y -> x
		(_, y) -> y * 10
	}
}

const CT1 = ctPick(1, 7)
const CT2 = ctPick(5, 2)
const CT3 = ctPick(2, 3)
const CT4 = match 65 { strconv.MaxUintLen -> 1, strconv.MaxIntLen -> 2, _ -> 3 }

driver func line(io Stdio, label string, v u64) error {
	var b [64]byte
	n := formatTo(b[:], "%s: %d\n", label, v)
	return io.WriteStdout(b[:n])
}

driver func main(io Stdio) error {
	var vals [10]Val
	vals[0] = Val.Int(1, 0)
	vals[1] = Val.Int(1, 5)
	vals[2] = Val.Int(2, 5)
	vals[3] = Val.Builtin(7, 0)
	vals[4] = Val.Builtin(9, 2)
	vals[5] = Val.Builtin(9, 1)
	vals[6] = Val.Paint(Color.Red)
	vals[7] = Val.Paint(Color.Green)
	vals[8] = Val.Name("hello")
	vals[9] = Val.Name("bye")
	for i := usize(0); i < 10; i++ {
		if err := line(io, "describe", u64(describe(vals[i]))); err != nil {
			return err
		}
	}
	if err := line(io, "qualified payload", u64(describe(Val.Builtin(64, 0)))); err != nil {
		return err
	}
	var sum u64 = 0
	for n := u32(63); n < 68; n++ {
		sum = sum*10 + u64(width(n))
	}
	if err := line(io, "width", sum*10+u64(width(8))); err != nil {
		return err
	}
	if err := line(io, "bucket", u64(bucket(0))*1000000+u64(bucket(20))*1000+u64(bucket(5))); err != nil {
		return err
	}
	if err := line(io, "order", u64(order(1, 1))*100000000+u64(order(9, 4))*100000+u64(order(4, 9))); err != nil {
		return err
	}
	if err := line(io, "oneZero", u64(oneZero(5, 0))*100000000+u64(oneZero(0, 6))*100000+u64(oneZero(3, 3))); err != nil {
		return err
	}
	if err := line(io, "colors", u64(colorCode(Color.Red)*100+colorCode(Color.Green)*10+colorCode(Color.Blue))); err != nil {
		return err
	}
	if err := line(io, "bools", u64(boolCode(true)*10+boolCode(false))); err != nil {
		return err
	}
	if err := line(io, "shadow", u64(shadow(3, Val.Int(4, 0))*10+shadow(3, Val.Name("x")))); err != nil {
		return err
	}
	if err := line(io, "colorOf", u64(colorCode(colorOf(Val.Paint(Color.Red)))*100+colorCode(colorOf(Val.Paint(Color.Green)))*10+colorCode(colorOf(Val.Int(0, 0))))); err != nil {
		return err
	}
	var p u64 = 0
	if isPanic(Val.Builtin(7, 3)) {
		p += 10
	}
	if isPanic(Val.Builtin(8, 3)) {
		p += 1
	}
	if bothRed(Color.Red, Val.Paint(Color.Red)) {
		p += 100
	}
	if bothRed(Color.Red, Val.Paint(Color.Blue)) {
		p += 1000
	}
	if err := line(io, "isPanic", p); err != nil {
		return err
	}
	return line(io, "comptime", u64(CT1)*1000000+u64(CT2)*10000+u64(CT3)*100+u64(CT4))
}
