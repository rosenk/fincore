// SINCE: v0.3
// pass_match_multi_syntax (v0.3): how a `,` after an arm value is read.
// v0.2 forms keep their meaning (`,` between arms, a trailing `,` on one
// line and before a newline, commas inside calls); value lists hold
// struct literals, function literals, guards with calls and nested match
// expressions with `,`-separated arms (brackets and braces nest); a value
// list continues on the next line after a `,`. A match in a multi-value
// context whose arms are all multi-result calls is multi-value too.
package main

type C enum {
	Red
	Green
}

type P struct {
	a u32
	b u32
}

func f(a u32, b u32) u32 {
	return a + b
}

func g() (u32, bool) {
	return 1, true
}

func h() (u32, bool) {
	return 2, false
}

// No value lists: the context makes the calls' results the values.
func sel(c C) (u32, bool) {
	return match c { Red -> g(); Green -> h() }
}

// v0.2 single-value forms.
func t1(c C) u32 {
	x := match c { Red -> f(1, 2), _ -> 3 }
	y := match c {
		Red -> u32(1),
		_ -> 2,
	}
	z := match c { Red -> u32(1), _ -> 0, }
	return x + y + z
}

func t2(c C, k u32) (P, bool, u32) {
	return match c {
		Red if f(k, 1) > 2 -> P{a: 1, b: 2}, true, match k { 0 -> 1, 1 -> 2, _ -> 3 }
		Red -> P{a: k, b: f(k, k)}, func() bool { return k > 1 }(), 0
		_ -> P{}, false,
			f(1, 2)
	}
}

func t3(c C) (u32, bool) {
	a, b := match c { Red -> g(); _ -> h() }
	return a, b
}

driver func main(io Stdio) error {
	p, ok, n := t2(C.Red, 5)
	p2, ok2, n2 := t2(C.Red, 0)
	p3, ok3, n3 := t2(C.Green, 0)
	a, b := t3(C.Green)
	x, y := sel(C.Green)
	var buf [128]byte
	m := formatTo(buf[:], "%d %d %d %v %d %d %v %d %v\n", t1(C.Red), p.a, p.b, ok, n, a, b, x, y)
	if err := io.WriteStdout(buf[:m]); err != nil {
		return err
	}
	m = formatTo(buf[:], "%d %d %v %d %d %d %v %d\n", p2.a, p2.b, ok2, n2, p3.a, p3.b, ok3, n3)
	return io.WriteStdout(buf[:m])
}
