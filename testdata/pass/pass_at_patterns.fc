// pass_at_patterns (v0.2): `name @ pattern` bindings. The name binds the
// value at its position (top level, tuple element, payload, or-pattern
// alternative), which must also match the pattern; the pattern may bind
// further names. `@` nests, works with constants and or-patterns, in
// match statements and expressions, guards, `is` (let-else, && chains)
// and comptime.
package main

type Color enum {
	Red
	Green
	Blue
}

type Option[T any] enum {
	Some(T)
	None
}

type Val enum {
	Int(u32, u32)
	Builtin(u8, u32)
	Paint(Color)
	Opt(Option[u32])
}

const BFCopy u8 = 9
const BFFormatUint u8 = 12
const BFPanic u8 = 7
const Small = 8

func colorCode(c Color) u32 {
	return match c {
		Red -> 1
		Green -> 2
		Blue -> 3
	}
}

// A payload binding with an or-pattern of constants: no guard needed.
func builtin(v Val) u32 {
	return match v {
		Builtin(b @ (BFCopy | BFFormatUint), n) -> u32(b) * 100 + n
		Builtin(p @ BFPanic, _) -> u32(p)
		Builtin(..) -> 1
		Int(hi @ 0, lo) | Int(lo, hi @ 0) -> 1000 + hi + lo
		Int(..) -> 2
		Paint(c @ (Red | Blue)) -> 10 * colorCode(c)
		Paint(c @ Green) -> 20 + colorCode(c)
		Opt(o @ Some(x)) -> optOr(o, 0) + x
		Opt(o @ None) -> optOr(o, 7)
	}
}

func optOr(o Option[u32], d u32) u32 {
	return match o {
		Some(x) -> x
		None -> d
	}
}

// Top-level `@` on an enum, a constant and a guard that reads the name.
func top(c Color) u32 {
	match c {
		warm @ Red -> return colorCode(warm) * 100
		cold @ (Green | Blue) if colorCode(cold) == 3 -> return 30
		other @ _ -> return colorCode(other)
	}
}

func size(n u32) u32 {
	return match n {
		s @ Small -> s * 2
		z @ 0 -> z + 1
		big @ m if m > 100 -> big + m
		rest @ _ -> rest
	}
}

// Tuple elements, nested `@` and `@` inside or-pattern alternatives.
func pair(a Option[u32], b Val) u32 {
	return match (a, b) {
		(whole @ Some(inner @ 5), w @ Int(h, _)) -> optOr(whole, 0) + inner + h + intHi(w)
		(Some(x), (w @ Int(x2 @ 1, _)) | (w @ Int(_, x2 @ 1))) -> x * 10 + x2 + intHi(w)
		(n @ None, k @ Paint(_)) -> optOr(n, 40) + builtin(k)
		(_, _) -> 0
	}
}

func intHi(v Val) u32 {
	return match v {
		Int(h, _) -> h
		_ -> 0
	}
}

// Nested: a chain of names on one position and `@` below `@`.
func chain(o Option[Option[u32]]) u32 {
	return match o {
		a @ b @ Some(c @ Some(d)) -> optOr(optOr2(a), 0) + optOr(optOr2(b), 0) + optOr(c, 0) + d
		outer @ Some(None) -> optOr(optOr2(outer), 50)
		None -> 3
	}
}

func optOr2(o Option[Option[u32]]) Option[u32] {
	return match o {
		Some(x) -> x
		None -> Option[u32].None
	}
}

// `is` with `@`: an && chain and a let-else.
func code(v Val) u32 {
	if v is w @ Builtin(b @ (BFCopy | BFPanic), _) && b > 7 {
		return builtin(w) + 1
	}
	if !(v is Paint(c @ (Red | Green))) {
		return 0
	}
	return colorCode(c) * 1000
}

// comptime evaluates `@` bindings at every position.
comptime func ctAt(a u32, b u32) u32 {
	return match (a, b) {
		(x @ 1, y @ _) -> x * 100 + y
		(x @ (2 | 3), _) -> x * 10
		(_, y) -> y
	}
}

comptime func ctOpt(o Option[u32]) u32 {
	return match o {
		w @ Some(v @ 4) -> optOr(w, 0) + v
		Some(v) -> v
		None -> 9
	}
}

const CT1 = ctAt(1, 7)
const CT2 = ctAt(3, 7)
const CT3 = ctAt(9, 8)
const CT4 = ctOpt(Option[u32].Some(4))
const CT5 = ctOpt(Option[u32].Some(6))

driver func line(io Stdio, label string, v u64) error {
	var b [64]byte
	n := formatTo(b[:], "%s: %d\n", label, v)
	return io.WriteStdout(b[:n])
}

driver func main(io Stdio) error {
	var vals [10]Val
	vals[0] = Val.Builtin(9, 3)
	vals[1] = Val.Builtin(12, 4)
	vals[2] = Val.Builtin(7, 0)
	vals[3] = Val.Builtin(1, 0)
	vals[4] = Val.Int(0, 5)
	vals[5] = Val.Int(6, 0)
	vals[6] = Val.Int(2, 2)
	vals[7] = Val.Paint(Color.Blue)
	vals[8] = Val.Paint(Color.Green)
	vals[9] = Val.Opt(Option[u32].Some(4))
	for i := 0; i < 10; i++ {
		if err := line(io, "builtin", u64(builtin(vals[i]))); err != nil {
			return err
		}
	}
	if err := line(io, "none", u64(builtin(Val.Opt(Option[u32].None)))); err != nil {
		return err
	}
	if err := line(io, "top", u64(top(Color.Red))*10000+u64(top(Color.Green))*100+u64(top(Color.Blue))); err != nil {
		return err
	}
	if err := line(io, "size", u64(size(8))*1000000000+u64(size(0))*1000000+u64(size(200))*1000+u64(size(9))); err != nil {
		return err
	}
	if err := line(io, "pair1", u64(pair(Option[u32].Some(5), Val.Int(3, 9)))); err != nil {
		return err
	}
	if err := line(io, "pair2", u64(pair(Option[u32].Some(4), Val.Int(8, 1)))); err != nil {
		return err
	}
	if err := line(io, "pair3", u64(pair(Option[u32].None, Val.Paint(Color.Red)))); err != nil {
		return err
	}
	if err := line(io, "pair4", u64(pair(Option[u32].None, Val.Int(1, 1)))); err != nil {
		return err
	}
	in := Option[u32].Some(6)
	if err := line(io, "chain", u64(chain(Option[Option[u32]].Some(in)))*10000+u64(chain(Option[Option[u32]].Some(Option[u32].None)))*100+u64(chain(Option[Option[u32]].None))); err != nil {
		return err
	}
	if err := line(io, "code", u64(code(vals[0]))*100000000+u64(code(vals[2]))*100000+u64(code(Val.Paint(Color.Green)))*10+u64(code(vals[7]))); err != nil {
		return err
	}
	return line(io, "comptime", u64(CT1)*1000000000+u64(CT2)*1000000+u64(CT3)*10000+u64(CT4)*100+u64(CT5))
}
