// SINCE: v0.7
package main

import (
	"std/retry"
	"std/sync"
)

func isTransient(err error) bool {
	return err == ErrIO || err == ErrTimeout
}

driver func main(io Stdio, clock Clock) error {
	// 1. ZIO-style pure Schedule math (Fixed, Exponential, Fibonacci, deterministic Jitter)
	exp := retry.Exponential(4, 10*Millisecond, 50*Millisecond)
	e0, ok0 := exp.DelayFor(0)
	e1, ok1 := exp.DelayFor(1)
	e2, ok2 := exp.DelayFor(2)
	e3, ok3 := exp.DelayFor(3)
	_, ok4 := exp.DelayFor(4)
	expOk := ok0 && e0 == 10*Millisecond &&
		ok1 && e1 == 20*Millisecond &&
		ok2 && e2 == 40*Millisecond &&
		ok3 && e3 == 50*Millisecond && // capped!
		!ok4

	fib := retry.Fibonacci(5, 10*Millisecond, 100*Millisecond)
	f0, _ := fib.DelayFor(0)
	f1, _ := fib.DelayFor(1)
	f2, _ := fib.DelayFor(2)
	f3, _ := fib.DelayFor(3)
	f4, _ := fib.DelayFor(4)
	fibOk := f0 == 10*Millisecond && f1 == 10*Millisecond && f2 == 20*Millisecond &&
		f3 == 30*Millisecond && f4 == 50*Millisecond

	jit := exp.WithJitter(12345)
	j1, jok := jit.DelayFor(1) // base 20ms -> jitter in [10ms, 20ms]
	jitOk := jok && j1 >= 10*Millisecond && j1 <= 20*Millisecond

	// 2. retry.Do & retry.DoIf over Clock + Context
	ctx, cancel := NewContext()
	defer cancel()

	var attempts u32 = 0
	rErr := retry.Do(ctx, clock, retry.Fixed(5, 1*Millisecond), driver func(a u32) error {
		attempts = a + 1
		if a < 2 {
			return ErrIO
		}
		return nil
	})
	var nonRetryCount u32 = 0
	nrErr := retry.DoIf(ctx, clock, retry.Fixed(5, 1*Millisecond), isTransient, driver func(a u32) error {
		nonRetryCount = a + 1
		return ErrParse // not transient -> stops immediately on attempt 0!
	})
	retryRunOk := rErr == nil && attempts == 3 && nrErr == ErrParse && nonRetryCount == 1

	// 3. sync.Semaphore (WithPermit guarantees max concurrency <= 2 & zero permit leaks!)
	sem := sync.NewSemaphore(2)
	semPtr := &sem
	var active Atomic[u64]
	var maxSeen Atomic[u64]
	var doneTasks Atomic[u64]

	scope fg := NewFiberScope(4, 16) {
		for t := u32(0); t < 8; t++ {
			_ = fg.Spawn(ctx, driver func() {
				_ = semPtr.WithPermit(ctx, driver func() error {
					cur := active.Add(1)
					// Track peak concurrent fibers inside critical section
					driver for {
						prev := maxSeen.Load()
						if cur <= prev || maxSeen.CompareAndSwap(prev, cur) {
							break
						}
					}
					FiberYield()
					FiberYield()
					_ = active.Add(^u64(0)) // decrement by 1
					_ = doneTasks.Add(1)
					return nil
				})
			})
		}
		fg.Wait()
	}
	semOk := doneTasks.Load() == 8 && maxSeen.Load() <= 2 && maxSeen.Load() >= 1 && sem.Available() == 2

	// 4. sync.CircuitBreaker (Closed -> Open after 2 failures -> fail-fast ErrClosed -> HalfOpen -> Closed!)
	cb := sync.NewCircuitBreaker(2, 15*Millisecond)
	_ = cb.Call(clock, driver func() error { return ErrIO })
	st1 := cb.State() // still Closed (1/2)
	_ = cb.Call(clock, driver func() error { return ErrIO })
	st2 := cb.State() // now Open (2/2)
	fastErr := cb.Call(clock, driver func() error { return nil }) // fail-fast ErrClosed!
	_ = clock.Sleep(ctx, 20*Millisecond)
	probeErr := cb.Call(clock, driver func() error { return nil }) // HalfOpen -> Closed!
	st3 := cb.State()
	cbOk := st1 == sync.CBClosed && st2 == sync.CBOpen && fastErr == ErrClosed && probeErr == nil && st3 == sync.CBClosed

	// 5. sync.TokenBucket rate limiter (deterministic AllowAt)
	tb := sync.NewTokenBucket(3, 10, 0) // burst 3, 10 tokens/sec (1 token per 100ms)
	a1 := tb.AllowAt(0)
	a2 := tb.AllowAt(0)
	a3 := tb.AllowAt(0)
	a4 := tb.AllowAt(0)           // bucket empty -> false
	a5 := tb.AllowAt(100_000_000) // +100ms -> +1 token -> true
	a6 := tb.AllowAt(100_000_000) // empty again -> false
	tbOk := a1 && a2 && a3 && !a4 && a5 && !a6

	var out [128]byte
	n := formatTo(out[:], "sched=%v,%v,%v retry=%v sem=%v cb=%v tb=%v\n",
		expOk, fibOk, jitOk, retryRunOk, semOk, cbOk, tbOk)
	return io.WriteStdout(out[:n])
}
