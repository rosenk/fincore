// cg_const_patterns (v0.2): lowering of constant patterns and top-level /
// tuple-element bindings: constants in switches and if chains (payloads,
// top level, tuple elements, qualified, enum valued), bindings assigned
// from the scrutinee temporaries, guards reading them, binding
// or-patterns over tuples, bound variant names, `is` and comptime.
package main

import "std/strconv"

type Color enum {
	Red
	Green
	Blue
}

type Op enum {
	Builtin(u8, u32)
	Call(u32)
	Paint(Color)
	Pair(Color, Color)
}

const BFPanic u8 = 7
const BFCopy u8 = 9
const SignBit = 1
const Def = Color.Red
const On = true

func kind(o Op) u32 {
	match o {
		Builtin(BFPanic, ..) -> return 1
		Builtin(BFCopy, n) -> return n
		Paint(Def) -> return 2
		Pair(Def, c) | Pair(c, Def) -> return colorNum(c)
		_ -> return 0
	}
}

func colorNum(c Color) u32 {
	return match c {
		Def -> 10
		Green -> 20
		Blue -> 30
	}
}

func top(n u32, m u32) u32 {
	match n {
		SignBit -> return 1
		strconv.MaxUintLen -> return 2
		x if x > m -> return x
		x -> return x + m
	}
}

func tuple(a u32, b bool) u32 {
	return match (a, b) {
		(SignBit, On) -> 1
		(x, On) if x > 3 -> x
		(x, false) | (x, true) -> x + 100
	}
}

func viaCall(n u32) u32 {
	return match next(n) {
		0 -> 0
		v -> v * 2
	}
}

func next(n u32) u32 {
	return n + 1
}

func bound(c Color) Color {
	match c {
		Green -> return Color.Blue
		other -> return other
	}
}

func isCopy(o Op) bool {
	return o is Builtin(BFCopy, _)
}

func isDef(o Op) bool {
	if o is Paint(Def) {
		return true
	}
	return false
}

func exprArm(o Op, n u32) u32 {
	r := match n {
		SignBit -> 5
		k if k > 100 -> 100
		k -> k
	}
	return r + match o {
		Call(SignBit) -> 1
		Call(k) -> k
		_ -> 0
	}
}

comptime func ctTop(n u32) u32 {
	return match n {
		SignBit -> 100
		x if x > 5 -> x
		x -> x + 1
	}
}

const CT = ctTop(1) + ctTop(9) + ctTop(2)

driver func main() error {
	_ = kind(Op.Builtin(7, 0)) + colorNum(Color.Blue) + top(3, 4) + tuple(1, true) + viaCall(2)
	_ = bound(Color.Red)
	_ = isCopy(Op.Call(1)) && isDef(Op.Call(2))
	_ = exprArm(Op.Call(3), 1) + CT
	return nil
}
