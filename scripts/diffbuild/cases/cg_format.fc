// cg_format: lowering of the v0.2 builtin formatTo in many positions
// (statement, defer, if/for headers, nested calls, struct fields, return
// through a scope), with constants of every kind, named types, Go name
// collisions and Format methods on enums, generic and monomorphized types.
package main

const Big u64 = 18446744073709551615
const Neg i8 = -128
const Name = "quote\"tab\t\x01"
const Ch = 'q'
const On = true

type Celsius i32

type Label string

type Raw []byte

type Point struct {
	x i32
	y i32
}

const Origin = Point{x: 1, y: -2}

func (p Point) Format(dst []byte) usize {
	return formatTo(dst, "(%d,%d)", p.x, p.y)
}

type Shape enum {
	Dot
	Box(u32, u32)
}

func (s Shape) Format(dst []byte) usize {
	n := usize(0)
	match s {
		Shape.Dot -> {
			n = formatTo(dst, "dot")
		}
		Shape.Box(w, h) -> {
			n = formatTo(dst, "box %dx%d", w, h)
		}
	}
	return n
}

type Vec[N usize, T any] struct {
	items [N]T
	n     usize
}

func (v Vec[N, T]) Format(dst []byte) usize {
	return formatTo(dst, "vec(%d/%d)", v.n, len(v.items))
}

type Box[T any] struct {
	v T
}

func (b Box[T]) Format(dst []byte) usize {
	return formatTo(dst, "box")
}

type Rec struct {
	n usize
	s string
}

func describe[T any](dst []byte, b Box[T]) usize {
	return formatTo(dst, "[%v]", b)
}

driver func main(io Stdio) error {
	var buf [256]byte
	b := buf[:]
	w := 3
	d := Label("lbl")
	fincrt := Celsius(-7)
	var raw Raw = strBytes("raw")
	n := formatTo(b, "%d %x %v %q %c %v %v", Big, Neg, Name, Name, Ch, On, Origin)
	n += formatTo(b[n:], "%d %s %v %s %q %-4v|", w, d, fincrt, raw, raw, Shape.Box(2, 3))
	var v4 Vec[4, u32]
	n += formatTo(b[n:], "%v %v %v", v4, Box[string]{v: "x"}, Shape.Dot)
	n += describe[bool](b[n:], Box[bool]{v: true})
	if formatTo(b[n:], "%08x", 255) == 8 {
		n += 8
	}
	lim := formatTo(b[n:], "%d", 12)
	for i := usize(0); i < lim; i++ {
		n++
	}
	r := Rec{n: formatTo(b[n:], "%5s", "r"), s: "s"}
	n += r.n
	n += formatTo(b[n:], "%d", formatTo(b[n:], "%v", Origin))
	formatTo(b[n:], "stmt")
	defer formatTo(b, "deferred %d", n)
	scope conns := NewScope(1) {
		k := formatTo(b[n:], "%v", On)
		n += k
	}
	return io.WriteStdout(b[:n])
}
