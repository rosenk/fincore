// cg_sum_types2 (v0.2): match expressions in statement headers (struct
// literals inside the function literal), as scrutinees of other matches,
// in package-level initializers (folded), in monomorphized generic
// functions over a const-parameter enum, with struct-literal arms, and
// in a deferred call's arguments.
package main

type Shape enum {
	Circle(u32)
	Rect(u32, u32)
	Empty
}

type Pt struct {
	x u32
	y u32
}

type Ring[N usize] enum {
	Full([N]u8)
	Part([N]u8, usize)
	Gone
}

var g Shape = match 3 { 1 -> Shape.Empty; _ -> Shape.Rect(1, 2) }

func sizeOf[N usize](r Ring[N]) usize {
	return match r {
		Full(_) -> N
		Part(_, k) -> k
		Gone -> 0
	}
}

func pick(s Shape) Pt {
	return match s {
		Circle(r) -> Pt{x: r, y: r}
		Rect(w, h) -> Pt{x: w, y: h}
		Empty -> Pt{}
	}
}

driver func note(io Stdio, n u64) {
	_ = io.WriteStdout(strBytes("n\n"))
	_ = n
}

driver func main(io Stdio) error {
	s := Shape.Circle(2)
	if match s { Circle(_) -> Shape.Empty; _ -> Shape.Circle(1) } == g {
		return ErrNotFound
	}
	lim := match s { Circle(r) -> r; _ -> u32(1) }
	for i := u32(0); i < lim; i++ {
		s = Shape.Rect(i, i)
	}
	match match s { Rect(w, _) -> Shape.Circle(w); _ -> s } {
		Circle(r) -> {
			if r == 99 {
				return ErrNotFound
			}
		}
		Rect(_, _) | Empty -> {
		}
	}
	var b8 [8]u8
	var b4 [4]u8
	n := sizeOf[8](Ring[8].Part(b8, 3)) + sizeOf[4](Ring[4].Full(b4))
	p := pick(Shape.Rect(3, 4))
	defer note(io, match p.x { 3 -> u64(n); _ -> 0 })
	if p.y != 4 || n != 7 {
		return ErrNotFound
	}
	return nil
}
