// cg_patterns: code generation edge cases of v0.2 patterns (if chains,
// temporaries, guards with and without bindings, or-patterns with
// bindings, `is` with and without bindings, else-if chains, tuple
// scrutinees of calls, unused temporaries, flat switches with `..`).
package main

type Opt[T any] enum {
	Some(T)
	None
}

type Tok enum {
	Ident(string, u32)
	Num(u64)
	Op(u8)
	Eof
}

type Pair struct {
	a Tok
	b Tok
}

var counter u32 = 0

func next() Tok {
	counter++
	if counter > 3 {
		return Tok.Eof
	}
	return Tok.Num(u64(counter))
}

func flat(t Tok) u32 {
	match t {
		Ident(_, n) -> return n
		Num(..) -> return 1
		Op(..) | Eof -> return 2
	}
}

func nestedExpr(o Opt[Tok]) u64 {
	v := match o {
		Some(Num(n)) if n > 10 -> n
		Some(Num(n)) -> n + 100
		Some(Ident("x", k)) -> u64(k)
		Some(Op('+' | '-')) -> 7
		Some(_) -> 8
		None -> 9
	}
	return v * 2
}

func calls() u32 {
	match (next(), next()) {
		(_, _) -> return 1
	}
}

func fields(p Pair) u32 {
	return match (p.a, p.b) {
		(Num(x), Num(y)) if x == y -> 1
		(Ident(s, _), Ident(t, _)) if s == t -> 2
		(Op(c), _) | (_, Op(c)) if c != 0 -> u32(c)
		_ -> 0
	}
}

func isChain(p *Pair) u32 {
	var r u32 = 0
	if p.a is Num(n) && n > 2 {
		r = u32(n)
	} else if p.b is Ident(s, k) && len(s) > 0 {
		r = k
	} else if p.a is Eof {
		r = 99
	} else {
		r = 5
	}
	for i := u32(0); i < 3; i++ {
		if p.b is Op(_) {
			r++
		}
	}
	ok := p.a is Num(1 | 2) || p.b is Eof
	if ok {
		r += 1000
	}
	return r
}

func orBind(t Tok) u64 {
	match t {
		Num(_) | Ident(_, _) if t is Num(_) -> {
			return 1
		}
		Op(c) if c == '*' -> return 2
		_ -> return 3
	}
}

func onlyGuardUse(o Opt[u32]) u32 {
	return match o {
		Some(x) if x > 3 -> 1
		Some(_) -> 2
		None -> 3
	}
}

func boolSwitch(a bool) u32 {
	match a {
		true -> return 1
		false -> return 0
	}
}

func neg(n i64) u32 {
	return match n {
		-1 -> 1
		-2 | 2 -> 2
		_ -> 3
	}
}

driver func main() error {
	var p Pair
	p.a = Tok.Num(3)
	p.b = Tok.Op('+')
	_ = flat(Tok.Op('x'))
	_ = nestedExpr(Opt[Tok].Some(Tok.Num(4)))
	_ = calls()
	_ = fields(p)
	_ = isChain(&p)
	_ = orBind(Tok.Eof)
	_ = onlyGuardUse(Opt[u32].None)
	_ = boolSwitch(true)
	_ = neg(-2)
	return nil
}
