// cg_is_flow_intersect: code generation of v0.2 `is` flow intersections.
// The bindings of an intersected name are one hoisted `var _fc_tN_x T`
// (declared at the first test) assigned by every test that binds it:
// || true side, && false side (let-else), three-way and nested merges,
// or-patterns inside a merged test, else-if conditions, for conditions,
// match statements with guards, a name read only inside the right
// operand, only by a function literal, or never (no declaration),
// generic functions, operands that are not plain variables and the
// same name merged again in a later statement.
package main

type Opt[T any] enum {
	Some(T)
	None
}

type Val enum {
	Int(u32, u32)
	Pair(u32, u32)
	Bool(bool)
	Wrap(Opt[u32])
}

func mk(n u32) Opt[u32] {
	if n == 0 {
		return Opt[u32].None
	}
	return Opt[u32].Some(n)
}

func orTrue(a Opt[u32], b Opt[u32]) u32 {
	if a is Some(x) || b is Some(x) {
		return x
	}
	return 0
}

func andFalse(v Val, w Val) u32 {
	if !(v is Int(h, l)) && !(w is Pair(l, h)) {
		return 0
	}
	return h - l
}

func threeWay(a Opt[u32], b Opt[u32], c Opt[u32]) u32 {
	if (a is Some(x) || b is Some(x)) || c is Some(x) {
		return x
	}
	if a is Some(y) || (b is Some(y) || c is Some(y)) {
		return y
	}
	return 0
}

func orPattern(v Val, o Opt[u32]) u32 {
	if v is Int(x, _) | Pair(_, x) || o is Some(x) {
		return x
	}
	return 0
}

func elseIf(v Val, a Opt[u32]) u32 {
	if v is Bool(_) {
		return 1
	} else if v is Wrap(Some(k)) || a is Some(k) {
		return k
	} else if !(v is Int(m, _)) && !(v is Pair(m, _)) {
		return 2
	} else {
		return m
	}
}

driver func loop(n u32) u32 {
	var s u32 = 0
	driver for i := u32(0); i < n && (mk(i) is Some(x) || mk(i+1) is Some(x)); i++ {
		s += x
	}
	return s
}

func guards(v Val, o Opt[u32]) u32 {
	match v {
		Bool(_) if o is Some(k) || v is Int(k, _) -> return k
		Int(a, _) if !(o is Some(_)) -> return a
		_ -> return 0
	}
}

func insideOnly(a Opt[u32], b Opt[u32]) bool {
	return a is Some(x) && x > 1 || b is Some(x) && x > 2
}

func captured(a Opt[u32], b Opt[u32]) u32 {
	if !(a is Some(x)) && !(b is Some(x)) {
		return 0
	}
	f := func() u32 { return x * 2 }
	return f()
}

func unused(a Opt[u32], b Opt[u32]) bool {
	return a is Some(x) || b is Some(x)
}

func generic[T any](a Opt[T], b Opt[T], d T) T {
	if !(a is Some(x)) && !(b is Some(x)) {
		return d
	}
	return x
}

func again(a Opt[u32], b Opt[u32]) u32 {
	var r u32 = 0
	if a is Some(x) || b is Some(x) {
		r += x
	}
	if !(b is Some(x)) && !(a is Some(x)) {
		return r
	}
	return r + x
}

driver func main(io Stdio) error {
	var t u32 = orTrue(mk(1), mk(2)) + andFalse(Val.Int(5, 1), Val.Bool(true))
	t += threeWay(mk(0), mk(0), mk(3)) + orPattern(Val.Pair(1, 2), mk(0))
	t += elseIf(Val.Int(4, 4), mk(0)) + loop(3) + guards(Val.Bool(true), mk(2))
	if insideOnly(mk(0), mk(3)) && unused(mk(1), mk(0)) {
		t += captured(mk(0), mk(5)) + generic[u32](mk(0), mk(0), 7) + again(mk(1), mk(2))
	}
	var b [32]byte
	n := formatTo(b[:], "%d\n", t)
	return io.WriteStdout(b[:n])
}
