// cg_at_patterns (v0.2): lowering of `name @ pattern` bindings: the name
// is assigned from the path of its position before the bindings of the
// pattern, at the top level (plain variable and temporary scrutinees),
// in tuple elements, payloads and or-pattern alternatives, nested '@',
// unused names, guards reading them, match expressions with `return`,
// `is` tests (single-read, hoisted, let-else, in a loop) and
// comptime.
package main

type Color enum {
	Red
	Green
	Blue
}

type Option[T any] enum {
	Some(T)
	None
}

type Op enum {
	Builtin(u8, u32)
	Call(u32)
	Paint(Color)
	Opt(Option[u32])
}

const BFCopy u8 = 9
const BFFormatUint u8 = 12

func use(o Op) u32 {
	return 1
}

func code(c Color) u32 {
	return 2
}

func kind(o Op) u32 {
	match o {
		Builtin(b @ (BFCopy | BFFormatUint), n) -> return u32(b) + n
		w @ Builtin(..) -> return use(w)
		(w @ Call(n)) | (w @ Opt(Some(n))) -> return use(w) + n
		Paint(c @ (Red | Green)) -> return code(c)
		Paint(unused @ Blue) -> return 3
		Opt(o2 @ None) -> return 4
	}
}

func viaCall(n u32) Op {
	return Op.Call(n)
}

func temp(n u32) u32 {
	return match viaCall(n) {
		w @ Call(k @ 1) if k > 0 -> use(w) + k
		w @ Call(_) -> use(w)
		x @ y @ _ -> use(x) + use(y)
	}
}

func tuple(a Option[u32], c Color) u32 {
	match (a, c) {
		(s @ Some(v @ 3), k @ Red) -> return v + code(k) + opt(s)
		(n @ None, k @ (Green | Blue)) -> return opt(n) + code(k)
		(_, _) -> return 0
	}
}

func opt(o Option[u32]) u32 {
	return 0
}

func top(n u32) u32 {
	return match n {
		z @ 0 -> z
		m @ (1 | 2) if m > 1 -> m * 2
		big @ m -> big + m
	}
}

func isTests(o Op, os []Op) u32 {
	if o is Paint(c0 @ _) {
		return 0
	}
	if o is w @ Call(_) {
		return 1
	}
	if o is w @ Builtin(b @ BFCopy, _) && b > 0 {
		return use(w)
	}
	if !(o is p @ Paint(c @ Green)) {
		return 2
	}
	for i := usize(0); i < len(os); i++ {
		if !(os[i] is q @ Call(k)) || k == 0 {
			break
		}
		_ = use(q)
	}
	return use(p) + code(c)
}

comptime func ctPick(o Option[u32]) u32 {
	return match o {
		w @ Some(v @ 4) -> opt(w) + v
		Some(v) -> v
		n @ None -> opt(n)
	}
}

const CT = ctPick(Option[u32].Some(4)) + ctPick(Option[u32].None)

driver func main() error {
	_ = kind(Op.Builtin(9, 0)) + temp(1) + tuple(Option[u32].None, Color.Red) + top(3)
	var os [2]Op
	_ = isTests(Op.Call(1), os[:]) + CT
	return nil
}
