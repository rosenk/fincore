// cg_stmts: statement lowering edge cases (scope barriers, labeled breaks
// out of matches, returns inside scopes, literals, defer, unused
// variables, dead code, enum matches with bindings, constant patterns).
package main

type Shape enum {
	Circle(u32)
	Rect(u32, u32)
	Empty
}

type Tok enum {
	A
	B
	C
}

const Unit = Shape.Circle(1)
const KindB = Tok.B
const Two = 2

var defaultShape Shape = Shape.Rect(3, 4)
var emptyShape Shape = Shape.Empty

comptime func pick() Shape {
	return Shape.Rect(5, 6)
}

func area(s Shape) u64 {
	match s {
		Shape.Circle(r) -> {
			return 3 * u64(r) * u64(r)
		}
		Shape.Rect(w, _) -> {
			return u64(w)
		}
		Shape.Empty -> {
			return 0
		}
	}
}

func get() Shape {
	return pick()
}

func areaOf() u64 {
	match get() {
		Shape.Circle(r) -> {
			return u64(r)
		}
		Shape.Rect(w, h) -> {
			return u64(w) * u64(h)
		}
		_ -> {
			return 1
		}
	}
}

func classify(t Tok) u32 {
	match t {
		Tok.A -> {
			return 1
		}
		Tok.A -> {
			return 9
		}
		_ -> {
		}
	}
	return 0
}

func ints(x u32) u32 {
	n := u32(0)
	match x {
		1 -> {
			n = 10
		}
		Two -> {
			n = 20
		}
		2 -> {
			n = 99
		}
		_ -> {
			n = 30
		}
		3 -> {
			n = 40
		}
	}
	return n
}

func loops(xs []u32) u32 {
	total := u32(0)
	for i := usize(0); i < len(xs); i++ {
		match xs[i] {
			0 -> {
				break
			}
			1 -> {
				continue
			}
			_ -> {
				total += xs[i]
			}
		}
		if total > 100 {
			break
		}
	}
	for j := usize(0); j < 3; j++ {
		for k := usize(0); k < 3; k++ {
			match k {
				2 -> {
					break
				}
				_ -> {
				}
			}
		}
	}
	return total
}

func dead(x u32) u32 {
	if x > 3 {
		return 1
	} else {
		return 2
	}
}

func unused() u32 {
	a := 1
	b, c := 2, 3
	var d u32
	var e u32 = 4
	if f := a + 1; b > 0 {
		c = 5
	}
	g := 0
	g = 7
	return e
}

func lits(n u32) u32 {
	add := func(a u32, b u32) u32 {
		return a + b
	}
	twice := func(x u32) u32 {
		inner := func(y u32) u32 {
			return y * 2
		}
		_ = inner
		return x * 2
	}
	return add(n, twice(n))
}

driver func scopes(io Stdio, n u64) (u64, error) {
	var pool [2]u64
	ctx, cancel := NewContext()
	defer cancel()
	total := u64(0)
	driver for i := usize(0); i < 3; i++ {
		scope s := NewScope(2) {
			slot, err := s.AcquireSlot(ctx, &pool)
			if err != nil {
				return 0, err
			}
			s.Go(slot, driver func(p *u64) {
				*p = 1
			})
			if i == 1 {
				continue
			}
			match i {
				2 -> {
					break
				}
				_ -> {
				}
			}
			scope _ := NewScope(1) {
				if n > 100 {
					return n, nil
				}
				if n > 50 {
					return pairOf(n)
				}
			}
			total += n
		}
	}
	scope t := NewScope(1) {
		return total, nil
	}
}

func pairOf(n u64) (u64, error) {
	return n + 1, nil
}

driver func defers(io Stdio) error {
	defer say(io, "a\n")
	x := u32(1)
	defer func(v u32) {
		_ = v
	}(x)
	return nil
}

driver func say(io Stdio, s string) error {
	return io.WriteStdout(strBytes(s))
}

driver func main(io Stdio) error {
	s := Shape.Rect(2, 3)
	if s == Shape.Empty || area(s) == 0 || s == Unit || defaultShape == emptyShape {
		return ErrIO
	}
	var xs [4]u32
	_ = loops(xs[:])
	_ = ints(2) + classify(KindB) + dead(1) + unused() + lits(3) + u32(areaOf())
	v, err := scopes(io, 3)
	if err != nil {
		return err
	}
	_ = v
	return defers(io)
}
