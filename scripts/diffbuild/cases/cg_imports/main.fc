// cg_imports (directory case): two imported packages with the same name
// (prefix counter), generic and monomorphized declarations across
// packages, instance discovery order.
package main

import (
	"scripts/diffbuild/cases/cg_imports/a/util"
	butil "scripts/diffbuild/cases/cg_imports/b/util"
)

type Box[T any] struct {
	v T
}

type Grid[W usize, H usize] struct {
	cells [W][H]u8
}

func (g *Grid[W, H]) Area() usize {
	return W * H
}

func wrap[T any](x T) Box[T] {
	return Box[T]{v: x}
}

driver func main(io Stdio) error {
	var v util.Vec[4, u32]
	vp := &v
	_ = vp.Push(util.Id[u32](3))
	var w util.Vec[2, Box[u64]]
	wp := &w
	_ = wp.Push(wrap[u64](1))
	var g Grid[3, 5]
	gp := &g
	var bb util.Vec[8, util.Vec[2, bool]]
	bp := &bb
	var inner util.Vec[2, bool]
	_ = bp.Push(inner)
	t := butil.Make(util.Square(util.Base) + butil.Base)
	p := util.Pt{X: 1, Y: util.Count}
	total := util.Sum[4](vp) + t.Get() + u64(gp.Area()) + u64(p.X) + u64(vp.Cap()) + u64(wp.Cap())
	if total == 0 || util.Name == "b" {
		return ErrIO
	}
	return nil
}
