// SINCE: v0.3
// cg_v03_variant_multi (v0.3, decision 149): lowering of a variant
// constructor whose only argument supplies all payload values. A
// multi-result call or multi-value match becomes a function literal with
// one parameter per payload value called with the argument (Go's f(g())),
// `func(_fc_v0 T0, _fc_v1 T1) E { return E{_tag: i, ...: _fc_v0, ...} }(g())`;
// a folded comptime call writes its values into the slots. Positions:
// `:=`, `=`, return, call argument, if/match headers, a match arm,
// a struct field, generic enums (also inside a generic function), payloads
// of struct and enum type, a variant with tag 0. A folded comptime call as
// a multi-value match arm returns its values.
package main

type Shape enum {
	Rect(u32, u32)
	Circle(u32)
	Empty
}

type Pt struct {
	x u32
	y u32
}

type Wrap enum {
	Nothing
	Pair(Pt, Shape)
}

type Two[T any] enum {
	Both(T, T)
	None
}

type Holder struct {
	s Shape
}

func pair() (u32, u32) {
	return 3, 4
}

func ptShape() (Pt, Shape) {
	return Pt{x: 1, y: 2}, Shape.Circle(9)
}

func twin[T any](x T) (T, T) {
	return x, x
}

func mkTwo[T any](x T) Two[T] {
	return Two[T].Both(twin[T](x))
}

comptime func cpair() (u32, u32) {
	return 5, 6
}

func area(s Shape) u32 {
	return match s {
		Shape.Rect(w, h) -> w * h
		Shape.Circle(r) -> r
		Shape.Empty -> 0
	}
}

func ret(k u32) Shape {
	if k == 0 {
		return Shape.Rect(pair())
	}
	return Shape.Rect(match k {
		1 -> 1, 2
		2 -> cpair()
		_ -> pair()
	})
}

func split(k u32) (u32, u32) {
	return match k {
		0 -> cpair()
		_ -> 1, 2
	}
}

func assign(k u32) (u32, u32) {
	a, b := match k {
		0 -> cpair()
		_ -> pair()
	}
	return a, b
}

driver func main() error {
	s := Shape.Rect(pair())
	s = Shape.Rect(cpair())
	c := Shape.Rect(cpair())
	h := Holder{s: Shape.Rect(pair())}
	w := Wrap.Pair(ptShape())
	t := Two[u32].Both(pair())
	g := mkTwo[u8](7)
	n := area(s) + area(c) + area(h.s) + area(ret(0)) + area(ret(1))
	if area(Shape.Rect(pair())) > 1 {
		n++
	}
	lim := area(Shape.Rect(pair()))
	for i := u32(0); i < lim; i++ {
		n++
	}
	match Shape.Rect(pair()) {
		Shape.Rect(a, b) -> {
			n = n + a + b
		}
		_ -> {
		}
	}
	match n {
		0 -> {
			s = Shape.Rect(pair())
		}
		_ -> {
			s = Shape.Rect(match n {
				1 -> pair()
				_ -> 8, 9
			})
		}
	}
	x, y := split(n)
	p, q := assign(n)
	_ = w
	_ = t
	_ = g
	_ = x + y + p + q
	return nil
}
