// SINCE: v0.3
// cg_v03_minmax (v0.3): lowering of min and max. Calls with a run-time
// operand become Go's min/max builtins (operands as written; untyped
// constants typed by the other operands); all-constant calls are folded
// to constants (typed or untyped const declarations, array lengths,
// literals in expressions); user names min/max are renamed (_fc_u_min),
// so the builtins are never shadowed in Go; calls in statement headers,
// nested calls, named and string types, comptime.
package main

type ID u32

const A = min(4, 2)
const B u16 = max(A, 3, 1)
const S = max("b", "a")

var arr [min(8, 4)]u8

func nestedCall(x u32, y u32, z u32) u32 {
	return max(min(x, y), min(y, z), 7)
}

func header(x u64, ids []ID) u64 {
	if min(x, 10) == 10 {
		return max(x, 1<<20)
	}
	for i := usize(0); i < min(len(ids), 4); i++ {
		x += u64(max(ids[i], ID(2)))
	}
	return x
}

func strs(a string, b string) string {
	return min(a, b, "zz")
}

func shadow(min u32) u32 {
	max := min + 1
	return max
}

func folded(x i64) i64 {
	return x + min(-5, 3) + max(i64(2), -1)
}

comptime func ctPick(a u8, b u8) u8 {
	return max(a, b) - min(a, b)
}

const CT = ctPick(9, 4)

driver func main() error {
	var ids [3]ID
	ids[1] = ID(9)
	_ = nestedCall(1, 2, 3) + u32(B) + shadow(2) + u32(len(arr)) + u32(CT)
	_ = header(3, ids[:])
	_ = strs("a", S)
	_ = folded(1)
	return nil
}
