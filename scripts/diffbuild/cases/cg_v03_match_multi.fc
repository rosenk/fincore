// SINCE: v0.3
// cg_v03_match_multi (v0.3): lowering of multi-value match expressions.
// `return match` with N results is emitted in place (a switch or if chain
// whose arms `return a, b`; nested matches and multi-result calls as
// arms recursively); `:=` and `=` use a function literal with N results
// `func() (T1, T2) { ... }()`; `return match` inside a scope block keeps
// its results in temporaries before Wait; arms with `is` tests (hoisted
// bindings), guards, tuple scrutinees, '_' targets, a parenthesized
// match, untyped values typed by the targets, comptime.
package main

type Option[T any] enum {
	Some(T)
	None
}

type Pair enum {
	Two(u32, u32)
	One(u32)
	Zero
}

func two(n u32) (u32, bool) {
	return n, n > 1
}

func flat(p Pair) (u32, u32, bool) {
	return match p {
		Two(a, b) -> a, b, true
		One(a) -> a, 0, true
		Zero -> 0, 0, false
	}
}

func chain(p Pair, o Option[u32]) (u32, bool) {
	return match (p, o) {
		(Two(a, _), Some(x)) if x > a -> x, true
		(One(a), _) -> match a { 0 -> 0, false; _ -> two(a) }
		(_, None) -> two(9)
		_ -> 1, o is Some(_)
	}
}

func viaIs(o Option[u32], k u32) (bool, u32) {
	return match k {
		0 -> o is Some(v) && v > 2, 1
		_ -> false, k
	}
}

func assign(p Pair) u32 {
	var a u8 = 0
	var ok bool
	a, ok = match p {
		Zero -> 255, false
		_ -> 1, true
	}
	b, _, c := match p { Two(x, y) -> x, y, true; _ -> 0, 0, false }
	d, e := (match b {
		0 -> u64(1), "zero"
		_ -> 2, "other"
	})
	if ok && c {
		return u32(a) + b + u32(d) + u32(len(e))
	}
	return 0
}

driver func scoped(p Pair) (u32, bool) {
	scope s := NewScope(1) {
		return match p {
			Two(a, _) -> a, true
			_ -> 0, false
		}
	}
}

comptime func ctFlat(a u32, b u32) u32 {
	x, y, ok := flat(Pair.Two(a, b))
	m, n := chain(Pair.One(x), Option[u32].None)
	if !ok || !n {
		return 0
	}
	return x + y + m
}

const CT = ctFlat(2, 3)

driver func main() error {
	a, _, _ := flat(Pair.One(1))
	b, _ := chain(Pair.Zero, Option[u32].Some(3))
	c, _ := viaIs(Option[u32].Some(5), 0)
	d, _ := scoped(Pair.Zero)
	_ = c
	_ = a + b + assign(Pair.Two(1, 2)) + d + CT
	return nil
}
