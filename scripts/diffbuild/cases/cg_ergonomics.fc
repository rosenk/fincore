// cg_ergonomics: v0.2 ergonomics lowering — auto-& receivers (emitted as
// x.M(), Go takes the address), constant strings used as []byte (emitted
// as []byte(<constant>)) and folded constant string concatenation.
package main

import (
	"std/bytes"
	"std/vec"
)

const (
	Pre          = "pre\t"
	Sig          = "main(<caps>) error"
	Msg          = Pre + "bad " + Sig
	Typed string = Pre + "typed"
)

type Name string

const Who Name = "who" + "m"

type Cell struct {
	n u32
}

func (c *Cell) Inc() u32 {
	c.n++
	return c.n
}

func (c Cell) Get() u32 {
	return c.n
}

type Grid struct {
	cells [4]Cell
	head  Cell
	name  []byte
}

type Bytes []u8

var g Grid
var gv vec.Vec[8, []byte]

func view(b Bytes) usize {
	return len(b)
}

func lit() []byte {
	return "lit"
}

func parens() []byte {
	return ("paren" + "s")
}

func use(gr *Grid, tail *Cell, s []Cell) u32 {
	var local Grid
	local.head.Inc()
	local.cells[2].Inc()
	gr.cells[1].Inc()
	gr.head.Inc()
	(*gr).head.Inc()
	tail.Inc()
	(*tail).Inc()
	s[0].Inc()
	g.cells[3].Inc()
	g.head.Inc()
	return local.head.Get() + gr.head.Get() + s[0].Get()
}

driver func main(io Stdio) error {
	var c Cell
	_ = c.Inc()
	var grid Grid
	grid.name = "grid"
	var cs [2]Cell
	_ = use(&grid, &c, cs[:])
	_ = gv.Push(Msg)
	_ = gv.Push("x")
	var bld bytes.Builder[64]
	bld.WriteBytes(Pre)
	bld.WriteString(Typed)
	bld.WriteString(Msg + "!")
	if bytes.HasPrefix(bld.Bytes(), "pre") && bytesEqual(lit(), "lit") {
		_ = view("bytes")
	}
	var d [8]byte
	k := copy(d[:], Pre+"x")
	var out [128]byte
	n := formatTo(out[:], "%d %s " + Sig + "\n", k, string(Who))
	if err := io.WriteStdout(out[:n]); err != nil {
		return err
	}
	if err := io.WriteStdout(parens()); err != nil {
		return err
	}
	return io.WriteStdout("\n")
}
