// cg_std: code generation for the std packages: every package imported
// (all non-generic functions emitted), generic instances nested across
// packages (a Vec of U64Maps, a StrMap of Vecs, a ListArena of Builders),
// instances that differ only in a const argument, function values passed
// to generic functions (named, literal, and through a variable), and
// method calls on fields of package-level instances.
package main

import (
	"std/bytes"
	"std/maps"
	"std/path"
	"std/sort"
	"std/strconv"
	"std/vec"
)

type Entry struct {
	id   u32
	name [8]byte
}

var tables vec.Vec[2, maps.U64Map[8, 4, Entry]]
var byName maps.StrMap[16, 64, 4, vec.Vec[3, u32]]
var bufs vec.ListArena[4, 4, bytes.Builder[16]]
var ids maps.Interner[16, 32, 8]

type Holder struct {
	small bytes.Builder[4]
	big   bytes.Builder[5]
	order vec.Vec[4, u64]
}

var holder Holder

func byID(a Entry, b Entry) bool {
	return a.id < b.id
}

func useAll() u64 {
	tp := &tables
	var m maps.U64Map[8, 4, Entry]
	mp := &m
	_ = mp.Put(3, Entry{id: 3})
	_ = tp.Push(m)
	first, _ := tp.At(0)
	fp := &first
	e, _ := fp.Get(3)

	np := &byName
	var v vec.Vec[3, u32]
	vp := &v
	_ = vp.Push(e.id)
	_ = np.PutStr("three", v)
	got, _ := np.GetStr("three")
	gp := &got

	bp := &bufs
	var b bytes.Builder[16]
	bb := &b
	bb.WriteString("x")
	bp.Push(b)
	s, n := bp.Commit(0)

	hp := &holder
	sp := &hp.small
	sp.WriteString("abcd")
	bg := &hp.big
	bg.WriteString("abcd")
	op := &hp.order
	_ = op.Push(9)

	ip := &ids
	id, _ := ip.InternStr("k")

	var es [3]Entry
	es[0].id = 2
	es[1].id = 1
	sort.Sort[Entry](es[:], byID)
	f := byID
	sort.Stable[Entry](es[:], f)
	sort.Stable[Entry](es[:], func(a Entry, b Entry) bool {
		return a.id > b.id
	})

	var pb [16]byte
	k := path.Clean(pb[:], strBytes("a/../b"))
	var nb [strconv.MaxUintLen]byte
	k += strconv.FormatUint(nb[:], u64(k), 16)
	return u64(gp.Len()) + u64(s) + u64(n) + u64(sp.Len()+bg.Len()) + u64(id) + u64(es[0].id) + u64(k) + maps.HashBytes(pb[:1]) % 2
}

driver func main(io Stdio) error {
	if useAll() == 0 {
		return ErrIO
	}
	return nil
}
