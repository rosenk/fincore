// SINCE: v0.3
// v03_flow (v0.3): the v0.3 features in the scope, linearity and
// totality passes (a valid program; diff-prev runs every pass on it and
// on its mutants). min/max results bound loops; multi-value matches move
// Linear values into their results (closed afterwards), join the origins
// of their values (returning globals is fine), and their arms are
// branches of the flow analyses; []byte patterns and `is` flow.
package main

var global u32
var other u32

func clampLoop(n u32) u32 {
	lim := min(n, 10)
	s := u32(0)
	for i := u32(0); i < lim; i++ {
		s += max(i, 2)
	}
	return s
}

func pick(n u32) (*u32, bool) {
	return match n {
		0 -> &global, true
		_ -> &other, false
	}
}

func head(b []byte) ([]byte, u32) {
	return match b {
		"" -> b, 0
		v if len(v) > 2 -> v[:2], 2
		_ -> b, u32(len(b))
	}
}

func verb(b []byte) u32 {
	if !(b is "GET" | "HEAD") {
		return 0
	}
	return 1
}

func count(n usize) u32 decreases(n) {
	if n == 0 {
		return 0
	}
	// the totality checker gets no facts from a multi-value match (like
	// multi-result calls): the recursive call passes n - 1 itself
	a, b := match n % 2 {
		0 -> n - 1, u32(1)
		_ -> n - 1, 0
	}
	_ = a
	return b + count(n-1)
}

driver func serve(net Net, k u32) error {
	ln, err := net.ListenTCP("127.0.0.1:0")
	if err != nil {
		return err
	}
	defer ln.Close()
	ctx, cancel := NewContext()
	defer cancel()
	conn, err := ln.Accept(ctx)
	if err != nil {
		return err
	}
	c, tag := match k {
		0 -> conn, "zero"
		_ -> conn, "other"
	}
	_ = tag
	return c.Close()
}

driver func main(io Stdio) error {
	p, _ := pick(1)
	h, n := head("hello")
	_ = h
	var b [64]byte
	m := formatTo(b[:], "%d %d %d %d %d\n", clampLoop(30), *p, n, verb("GET"), count(7))
	return io.WriteStdout(b[:m])
}
