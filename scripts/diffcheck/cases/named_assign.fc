package main

import "std/vec"

type Name u32

type Label string

type Buf []u8

type Names []Name

type Err error

type Fmt string

const F Fmt = "%s"

const K Name = 3

const U u32 = 4

type Pair struct {
	a Name
	b u32
}

type Opt enum {
	Some(u32)
	None
}

type Fn func(x u32) u32

func inc(x u32) u32 {
	return x + 1
}

func incN(x Name) Name {
	return x + 1
}

func id[T any](x T) T {
	return x
}

func two() (Name, u32) {
	return 1, 2
}

func pick(n Name, u u32) u32 {
	match n {
		K -> return 1
		U -> return 2
		_ -> {}
	}
	match u {
		K -> return 3
		U -> return 4
		_ -> {}
	}
	return 0
}

func errs(e error) Err {
	var x Err = e
	var y error = x
	return y
}

driver func main(io Stdio) error {
	n := Name(1)
	var u u32 = 2
	var l Label = "x"
	var s string = l
	l = s
	var ua [2]u32
	var na [2]Name
	var ns []Name = ua[:]
	var us []u32 = na[:]
	var arr [2]Name = ua
	var names Names = ns
	ns = names
	var b Buf = strBytes(l)
	var raw []u8 = b
	_ = copy(us, ns)
	_ = bytesEqual(b, raw)
	var f Fn = incN
	var g func(x u32) u32 = inc
	f = g
	var v vec.Vec[4, u32]
	_ = v.Push(n)
	_ = id[u32](n)
	_ = id[Name](u)
	var a Name
	var c Name
	a, c = two()
	p := Pair{a: u, b: n}
	o := Opt.Some(n)
	if o is Some(K) {
		u = 3
	}
	if n < u || u != n || n == U {
		u = 4
	}
	m := u + n
	var out [32]byte
	k := formatTo(out[:], F, s)
	k = formatTo(b, "%s", l)
	_ = len(l)
	_, _, _, _, _, _, _, _ = arr, a, c, p, m, k, f, pick(n, u)
	return io.WriteStdout(out[:k])
}
