// Scope/linearity edge cases for make diff-check-scope (many diagnostics
// in one file; passes the type checker).
package main

type Pair struct {
	a *u32
	b []u8
}

type Shape enum {
	Circle(u32)
	Rect(u32, u32)
	Empty
}

var gbuf [16]u8
var gval u32

func pick(p *Pair, q *Pair) *u32 {
	p.a = q.a
	return p.a
}

func nested() []u8 {
	var buf [8]u8
	s := buf[1:3]
	t := s
	for i := usize(0); i < 2; i++ {
		t = gbuf[:]
	}
	return t
}

func viaStruct() Pair {
	var x u32
	return Pair{a: &x, b: gbuf[:]}
}

func shapeArea(s Shape) u32 {
	match s {
		Shape.Circle(r) -> {
			return r * r
		}
		Shape.Rect(w, h) -> {
			return w * h
		}
		Shape.Empty -> {
			return 0
		}
	}
}

func lit() u32 {
	var x u32
	f := func() *u32 {
		return &x
	}
	return *f()
}

func storeGlobal(p *Pair) {
	var y u32
	p.a = &y
	q := &gval
	p.a = q
}

driver func loops(net Net, ctx Context, n u32) error {
	ln, err := net.ListenTCP("x")
	if err != nil {
		return err
	}
	for i := u32(0); i < n; i++ {
		c, err := ln.Accept(ctx)
		if err != nil {
			continue
		}
		if i == 3 {
			break
		}
		_ = c.Close()
	}
	_ = ln.Close()
	_ = ln.Close()
	return nil
}

driver func deferred(net Net) {
	ln, err := net.ListenTCP("x")
	if err == nil {
		defer ln.Close()
		_ = ln.Close()
		_ = ln.Addr()
	}
}

driver func moves(net Net) {
	ln, err := net.ListenTCP("x")
	if err != nil {
		return
	}
	other := ln
	_ = ln.Addr()
	_ = other.Close()
	l2, err2 := net.ListenTCP("y")
	err2 = nil
	if err2 != nil {
		return
	}
	_ = l2.Close()
}

driver func discards(net Net) {
	net.ListenTCP("x")
	_, _ = net.ListenTCP("y")
}

func borrowed(c Conn) {
	_ = c.Close()
}

driver func owned(c Conn) {
	borrowed(c)
}

driver func tasks(ctx Context) {
	var local u32
	p := &local
	scope s := NewScope(2) {
		var pool [2][4]byte
		slot, err := s.AcquireSlot(ctx, &pool)
		if err != nil {
			return
		}
		s.Go(slot, driver func(buf *[4]byte) {
			*p = 1
			buf[0] = 2
		})
	}
	scope s2 := NewScope(1) {
		var inner u32
		scope s3 := NewScope(1) {
			var pool2 [1][4]byte
			slot2, err := s3.AcquireSlot(ctx, &pool2)
			if err == nil {
				q := &inner
				s3.Go(slot2, driver func(buf *[4]byte) {
					*q = 2
				})
			}
		}
		_ = s2
	}
}

driver func inline(net Net, b bool) {
	ln, err := net.ListenTCP("x")
	if err != nil {
		return
	}
	driver func() {
		if b {
			_ = ln.Close()
			return
		}
		_ = ln.Close()
	}()
	_ = ln.Addr()
}

driver func outerTask(ctx Context) {
	scope s := NewScope(2) {
		var pool [2][4]byte
		scope s2 := NewScope(1) {
			var inner u32
			q := &inner
			slot, err := s.AcquireSlot(ctx, &pool)
			if err == nil {
				s.Go(slot, driver func(buf *[4]byte) {
					*q = 2
				})
			}
			f := driver func(buf *[4]byte) {
				*q = 3
			}
			slot2, err2 := s.AcquireSlot(ctx, &pool)
			if err2 == nil {
				s.Go(slot2, f)
			}
			_ = s2
		}
	}
}

driver func partial(net Net, b bool) {
	ln, err := net.ListenTCP("x")
	if err != nil {
		return
	}
	defer driver func() {
		if b {
			_ = ln.Close()
		}
	}()
}

driver func matchBind(s Shape, net Net) {
	match s {
		Shape.Circle(r) -> {
			_ = r
		}
		_ -> net.ListenTCP("z")
	}
}

driver func main(io Stdio) error {
	return nil
}
