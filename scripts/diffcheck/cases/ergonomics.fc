// ergonomics: v0.2 auto-&, implicit []byte and constant string
// concatenation — accepted forms and every diagnostic (types, scope,
// totality).
package main

type Cell struct {
	n u32
}

func (c *Cell) Inc() {
	c.n++
}

func (c *Cell) Self() *Cell {
	return c
}

func (c Cell) Get() u32 {
	return c.n
}

type Box struct {
	c  Cell
	cs [2]Cell
}

type Holder struct {
	p *Cell
}

type Name string

type Sig u8

const P = "p"
const Q string = P + "q"
const R Name = "r" + "s"
const Bad1 = P + 1
const Bad2 = Q + R
const Bad3 = P - "x"
const Long = P + P + P + P + "0123456789"

func mk() Cell {
	return Cell{n: 1}
}

func mkBox() Box {
	var b Box
	return b
}

func errs(h *Holder, s string) []Sig {
	mk().Inc()
	mkBox().c.Inc()
	mkBox().cs[1].Inc()
	f := mk().Self
	_ = f
	var c Cell
	g := c.Inc
	_ = g
	_ = s + "x"
	_ = "x" + s + "y"
	var b []byte = s
	_ = b
	var bs []byte = Q
	_ = bs
	_ = len(Long)
	if b == "x" {
		return nil
	}
	return "sig"
}

func ok(p *Cell, cs []Cell, box *Box) []byte {
	p.Inc()
	cs[0].Inc()
	box.c.Inc()
	box.cs[1].Inc()
	(*p).Inc()
	var arr [2]Cell
	arr[0].Inc()
	var w []byte
	w = "w" + P
	_ = w
	return "fresh"
}

comptime func Cat(a string, b string) string {
	return a + b
}

comptime func Count() u32 {
	var c Cell
	c.Inc()
	c.Inc()
	return c.Get()
}

const N = Count()

driver func main(io Stdio) error {
	var out [64]byte
	n := formatTo(out[:], "%d " + Q + "\n", N)
	return io.WriteStdout(out[:n])
}
