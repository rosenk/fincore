// is_flow_letelse_bindings (v0.2): let-else bindings of every kind are
// unbound after an if whose then block can complete normally: top-level
// and tuple-less bare names (CtorPattern), payload names, `@` names, and
// intersected names (F(A && B) / T(A || B) via `!`); terminating then
// blocks bind them.
package main

type Opt enum {
	Some(u32)
	None
}

var global u32

func top(v u32) u32 {
	if !(v is n) {
		global = 1
	}
	return n
}

func topOr(v u32, w u32) u32 {
	if !(v is n @ 1) && !(w is n) {
		global = 1
	}
	return n
}

func atName(o Opt) u32 {
	if !(o is w @ Some(_)) {
		global = 2
	}
	return size(w)
}

func intersected(a Opt, b Opt) u32 {
	if !(a is w @ Some(k) || b is w @ Some(k)) {
		global = 3
	}
	return size(w) + k
}

func intersectedAnd(a Opt, b Opt) u32 {
	if !(a is Some(k)) && !(b is Some(k)) {
		global = 4
	}
	return k
}

func fine(a Opt, b Opt, v u32) u32 {
	if !(v is n) {
		return 0
	}
	if !(a is w @ Some(k) || b is w @ Some(k)) {
		return n
	}
	return size(w) + k + n
}

func size(o Opt) u32 {
	return 1
}

driver func main(io Stdio) error {
	return nil
}
