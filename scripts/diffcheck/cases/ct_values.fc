package main

type P struct {
	a u32
	b [3]u8
}

type Sh enum {
	Empty
	Circle(u32)
	Rect(u32, u32)
}

comptime func Area(s Sh) u32 {
	match s {
		Sh.Circle(r) -> {
			return 3 * r * r
		}
		Sh.Rect(w, h) -> {
			return w * h
		}
		_ -> {
			return 0
		}
	}
}

comptime func Sum(xs ...u32) u32 {
	t := u32(0)
	for i := usize(0); i < len(xs); i++ {
		t += xs[i]
	}
	return t
}

comptime func Fill(n usize) P {
	var p P
	q := &p
	q.a = u32(n)
	for i := usize(0); i < len(p.b); i++ {
		p.b[i] = u8(i * n)
	}
	s := p.b[1:]
	s[0] = 77
	return p
}

comptime func Digits(v u64) usize {
	var buf [20]u8
	n, err := formatUint(v, buf[:])
	if err != nil {
		return 0
	}
	x, err2 := parseUint(buf[:n])
	if err2 != nil || x != v {
		return 999
	}
	return n
}

comptime func Str(s string) u8 {
	b := strBytes(s)
	c := bytesToStr(b[1:3])
	if bytesEqual(strBytes(c), strBytes("el")) {
		return s[4]
	}
	return 0
}

comptime func Swap(a u32, b u32) (u32, u32) {
	return b, a
}

comptime func UseSwap() u32 {
	x, y := Swap(1, 2)
	x, y = y, x
	return x*10 + y
}

comptime func Copy() usize {
	var a [4]u8
	var b [2]u8
	b[0] = 9
	b[1] = 8
	n := copy(a[1:], b[:])
	return n + usize(a[1]) + usize(a[2])
}

comptime func Wrap8() u8 {
	var x u8 = 250
	x += 10
	x -= 1
	x *= 3
	return x
}

const A1 = Area(Sh.Circle(2))
const A2 = Area(Sh.Rect(3, 4))
const A3 = Area(Sh.Empty)
const S1 = Sum(1, 2, 3)
const S0 = Sum()
const F1 = Fill(3)
const D1 = Digits(1234567)
const C1 = Str("hello")
const U1 = UseSwap()
const C2 = Copy()
const W1 = Wrap8()

var arr [S1]u8
var arr2 [D1 + usize(C1)]u8
var arr3 [U1 + u32(C2) + u32(W1)]u8

driver func main(io Stdio) error {
	_ = A1 + A2 + A3 + S0
	_ = F1.b[2]
	return nil
}
