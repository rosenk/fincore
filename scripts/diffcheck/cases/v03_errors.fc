// SINCE: v0.3
// v03_errors (v0.3): the type errors of min/max, []byte patterns and
// multi-value matches in one file (each also has a testdata/fail test);
// diff-prev runs the current compiler on it and on its mutants.
package main

type K enum {
	A
	B
}

func m1(x u32, y u64) u64 {
	return max(x, y)
}

func m2(b bool) bool {
	return min(b, true)
}

func m3() u32 {
	return min(1)
}

func b1(b []byte) u32 {
	return match b {
		nil -> 1
		_ -> 0
	}
}

func b2(b []byte) u32 {
	return match b {
		"a" -> 1
	}
}

func v1(k K) (u32, bool) {
	return match k {
		A -> 1, true
		B -> 2
	}
}

func v2(k K) (u32, bool) {
	return match k {
		A -> 1, true
		B -> true, 2
	}
}

func v3(k K) u32 {
	x := match k {
		A -> 1, 2
		B -> 3, 4
	}
	return x
}

driver func main(io Stdio) error {
	return nil
}
