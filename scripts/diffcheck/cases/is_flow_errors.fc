// is_flow_errors (v0.2): resolver errors of flow-scoped `is` bindings: a
// binding after || on the true side, in the else branch of a positive
// test, in the then block of a negative test, after a loop, outside its
// arm; duplicates in one outcome set; a let-else that redeclares a name
// of its block. Let-else type errors are in is_flow_letelse.fc.
package main

type Opt[T any] enum {
	Some(T)
	None
}

type Val enum {
	Int(u32, u32)
	Bool(bool)
	Str(string)
}

func orTrue(v Val, w Val) bool {
	return (v is Int(a, _) || w is Bool(_)) && a > 0
}

func elsePositive(v Val) u32 {
	if v is Int(a, _) {
		return a
	} else {
		return a
	}
}

func thenNegative(v Val) u32 {
	if !(v is Int(a, _)) {
		return a
	}
	return 0
}

func afterLoop(v Val) u32 {
	for v is Int(_, b) && b > 3 {
		return b
	}
	return b
}

func otherArm(v Val, o Opt[u32]) u32 {
	return match v {
		Int(..) if o is Some(k) -> k
		_ -> k
	}
}

func dups(v Val, w Val) u32 {
	if v is Int(a, _) && w is Int(_, a) {
		return a
	}
	if !(v is Bool(b)) || !(w is Bool(b)) {
		return 0
	}
	if b {
		return 1
	}
	return 2
}

func redeclare(v Val) u32 {
	a := u32(1)
	if !(v is Int(a, _)) {
		return 0
	}
	return a
}

driver func main(io Stdio) error {
	return nil
}
