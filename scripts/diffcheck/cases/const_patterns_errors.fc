// const_patterns_errors (v0.2): type errors and E2012 of constant patterns
// and top-level / tuple-element bindings: constants of the wrong type in
// every position, enum constants with payloads, constants with parens,
// bindings of tuples, or-pattern binding mismatches, arms unreachable
// after a catch-all binding, unreachable bindings, duplicate constants,
// constants that do not cover bool / enum columns.
package main

import "std/strconv"

type Color enum {
	Red
	Green
	Blue
}

type Val enum {
	Int(u32, u32)
	Flag(bool)
	Paint(Color)
	Name(string)
}

const K = 2
const Hello = "hello"
const Yes = true
const Def = Color.Red
const Big = Val.Int(1, 2)
const Neg = -1

func wrongTypes(v Val, n u32, c Color) u32 {
	match v {
		Int(Hello, _) -> return 1
		Int(_, Yes) -> return 2
		Int(Neg, _) -> return 3
		Flag(K) -> return 4
		Paint(K) -> return 5
		Paint(Big) -> return 6
		Name(K) -> return 7
		Int(strconv.MaxIntLen(x), _) -> return x
		Name(strconv.MaxIntLen) -> return 8
		_ -> return 0
	}
	match n {
		Hello -> return 1
		Def -> return 2
		strconv.MaxIntLen -> return 3
		_ -> return 0
	}
	match c {
		K -> return 1
		Big -> return 2
		Def(x) -> return x
		strconv.MaxIntLen -> return 3
		_ -> return 0
	}
}

func tuples(a u32, b bool) u32 {
	match (a, b) {
		t -> return 1
	}
	match (a, b) {
		(x, true) | (K, y) -> return 1
		(x, x) -> return 2
		(K, Yes) -> return 3
		_ -> return 0
	}
}

func unreachable(n u32, c Color, b bool) u32 {
	r := match n {
		K -> u32(1)
		other -> other
		0 -> 3
	}
	r += match c {
		Def -> u32(1)
		Red -> 2
		Green | Blue -> 3
		rest -> 4
	}
	r += match b {
		Yes -> u32(1)
		true -> 2
		false -> 3
	}
	r += match (n, b) {
		(x, _) -> x
		(K, true) -> 2
	}
	return r
}

func coverage(c Color, b bool, v Val) u32 {
	r := match c {
		Def -> u32(1)
		Blue -> 2
	}
	r += match (c, b) {
		(Def, Yes) -> u32(1)
		(Green, false) -> 2
		(Blue, _) -> 3
	}
	r += match v {
		Flag(Yes) -> u32(1)
		Paint(Def) | Paint(Green) -> 2
		Int(K, _) -> 3
		Name(Hello) -> 4
	}
	return r
}

driver func main(io Stdio) error {
	return nil
}
