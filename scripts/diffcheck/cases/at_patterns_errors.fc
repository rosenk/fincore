// at_patterns_errors (v0.2): type errors of `name @ pattern` bindings:
// duplicate names (also through nested '@'), or-pattern mismatches
// (missing name, different types), whole-tuple bindings, patterns that
// do not match the position's type, E2012 after a catch-all '@' binding,
// unreachable '@' alternatives and non-exhaustive matches whose '@'
// patterns do not cover the scrutinee.
package main

type Color enum {
	Red
	Green
	Blue
}

type Option[T any] enum {
	Some(T)
	None
}

type Val enum {
	Int(u32, u32)
	Paint(Color)
	Opt(Option[u32])
}

const K = 2

func dups(v Val, o Option[Option[u32]]) u32 {
	match v {
		x @ Int(x, _) -> return 1
		y @ Int(_, y @ 3) -> return 2
		z @ Paint(z @ Red) -> return 3
		_ -> return 0
	}
	return match o {
		a @ Some(b @ Some(a)) -> 1
		_ -> 0
	}
}

func orMismatch(v Val) u32 {
	match v {
		(w @ Int(n, _)) | Int(_, n) -> return n
		Int(h @ 0, _) | Int(_, h) -> return h
		(c @ Paint(_)) | Opt(c @ _) -> return 3
		Paint(p @ (Red | Green)) | Paint(p @ Blue) -> return colorCode(p)
		_ -> return 0
	}
}

func colorCode(c Color) u32 {
	return match c {
		Red -> 1
		Green -> 2
		Blue -> 3
	}
}

func tuples(a u32, b bool) u32 {
	match (a, b) {
		t @ (x, _) -> return x
	}
	match (a, b) {
		t @ _ -> return 1
	}
	return match (a, b) {
		(x @ 1, y @ true) -> x
		(x @ _, y @ "s") -> x
		_ -> 0
	}
}

func wrongInner(v Val) u32 {
	match v {
		x @ 3 -> return 1
		Paint(c @ Int(_, _)) -> return 2
		Opt(o @ Some(Red)) -> return 3
		_ -> return 0
	}
}

func unreachable(c Color, v Val, n u32) u32 {
	match c {
		all @ _ -> return 1
		Red -> return 2
		Green -> return 3
	}
	match v {
		Int(..) -> return 1
		x @ y @ Int(..) -> return 2
		Paint(c1 @ (Red | Green | Blue)) -> return 3
		Paint(c2 @ Red) -> return 4
		Opt(_) -> return 5
		rest @ _ -> return 6
	}
	match n {
		0 -> return 1
		z @ 0 -> return 2
		big @ m if m > 100 -> return 3
		k @ _ -> return 4
		k2 @ 9 -> return 5
	}
}

var global u32

func letElse(o Option[u32]) u32 {
	if !(o is w @ Some(k)) {
		global = 2
	}
	return k + intOf(w)
}

func intOf(o Option[u32]) u32 {
	return 0
}

func notExhaustive(c Color, o Option[Color]) u32 {
	match c {
		r @ Red -> return 1
		g @ Green -> return 2
	}
	return match o {
		s @ Some(c3 @ (Red | Blue)) -> 1
		n @ None -> 2
	}
}

driver func main(io Stdio) error {
	return nil
}
