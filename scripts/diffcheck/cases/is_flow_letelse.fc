// is_flow_letelse (v0.2): type errors of let-else. The then block of an
// if statement without else whose false outcome binds names must not
// complete normally where those names are used: a continue that targets
// a nested loop, an if without else and a non-exhaustive match do. The
// bindings of a falling-through if that are never used are fine.
package main

type Opt[T any] enum {
	Some(T)
	None
}

type Val enum {
	Int(u32, u32)
	Bool(bool)
	Str(string)
}

func fallThrough(vs []Val, o Opt[u32]) u32 {
	var n u32 = 0
	for i := usize(0); i < len(vs); i++ {
		if !(vs[i] is Int(_, l)) {
			for j := usize(0); j < 2; j++ {
				continue
			}
		}
		n += l
	}
	if !(o is Some(k)) {
		if n > 0 {
			return 0
		}
	}
	if !(vs[0] is Str(s)) {
		match n {
			0 -> return 1
		}
	}
	if !(vs[1] is Bool(unused)) {
		n++
	}
	return n + k + u32(len(s))
}

driver func main(io Stdio) error {
	return nil
}
