package main

var g u32

comptime func ReadG() u32 {
	return g
}

comptime func OOB(i usize) u8 {
	var a [2]u8
	s := a[:]
	return s[i]
}

comptime func SliceOOB(i usize) usize {
	var a [2]u8
	s := a[i:]
	return len(s)
}

comptime func StrOOB() u8 {
	s := "ab"
	return s[5]
}

comptime func Div(a u32, b u32) u32 {
	return a / b
}

comptime func Pan() u32 {
	panic("boom")
	return 1
}

driver func D() u32 {
	return 1
}

comptime func CallD() u32 {
	return D()
}

comptime func NilP() u32 {
	var p *u32
	return *p
}

comptime func Defer() u32 {
	defer Pan()
	return 1
}

comptime func Lit() u32 {
	f := func() u32 { return 1 }
	return f()
}

const E1 = ReadG()
const E2 = OOB(7)
const E3 = SliceOOB(9)
const E4 = StrOOB()
const E5 = Div(1, 0)
const E6 = Pan()
const E7 = CallD()
const E8 = NilP()
const E9 = Defer()
const E10 = Lit()
