package main

type Vec[N usize, T any] struct {
	data [N]T
	n    usize
}

func (v *Vec[N, T]) Push(x T) bool {
	if v.n >= N {
		return false
	}
	v.data[v.n] = x
	v.n++
	return true
}

func (v Vec[N, T]) Len() usize {
	return v.n
}

type Pair[A any, B any] struct {
	a A
	b B
}

func first[A any, B any](p Pair[A, B]) A {
	return p.a
}

func bad1[T any](x T) T {
	return x + x
}

func bad2[T any](x T) u32 {
	return u32(x)
}

type Box[T any] struct {
	v T
}

type Wrong = Box
type Wrong2 = Box[u32, u8]
type Wrong3 = Vec[u32, u8]
type Wrong4 = Vec[-1, u8]
type Wrong5 = Box[Conn]
type NotGen struct{ x u8 }
type Wrong6 = NotGen[u8]

func (b *Box[T, U]) M() {}

func use() u32 {
	var v Vec[4, u32]
	p := &v
	_ = p.Push(3)
	_ = v.Len() + p.Len()
	q := Pair[u32, bool]{a: 1, b: true}
	_ = first[u32, bool](q)
	_ = first(q)
	_ = first[u32](q)
	f := first[u32, bool]
	_ = f
	return v.data[0]
}
