// is_flow_intersect_errors (v0.2): resolver errors of `is` flow
// intersections: a name bound on one side only is not bound (E2001
// undefined), a redeclaration in a union over an intersection (E2001).
// Type errors are in is_flow_intersect_types.fc.
package main

type Opt[T any] enum {
	Some(T)
	None
}

type Val enum {
	Int(u32, u32)
	Bool(bool)
}

func oneSide(v Val, w Val) u32 {
	if !(v is Int(a, b)) && !(w is Int(a, _)) {
		return 0
	}
	return a + b
}

func redeclared(o Opt[u32], q Opt[u32], r Opt[u32]) u32 {
	if (o is Some(x) || q is Some(x)) && r is Some(x) {
		return x
	}
	return 0
}

driver func main(io Stdio) error {
	_ = oneSide(Val.Bool(true), Val.Bool(true))
	_ = redeclared(Opt[u32].None, Opt[u32].None, Opt[u32].None)
	return nil
}
