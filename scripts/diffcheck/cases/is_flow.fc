// is_flow (v0.2): flow-scoped `is` bindings in the scope and totality
// passes. Let-else bindings carry the scrutinee's origin and are borrowed
// for the rest of the block (also Linear payloads); && chains in returns
// and arguments; for conditions; guards whose bindings reach the arm
// body; totality facts after a let-else with || (n != 0) for a measured
// recursion; patterns give no facts. Expected: E3002 (a let-else binding
// whose origin is a local is returned) and E3003 (closing a borrowed
// Linear binding).
package main

type Opt[T any] enum {
	Some(T)
	None
}

type Res enum {
	Got(Conn, u32)
	Nothing
}

type PtrOpt enum {
	PSome(*u32)
	PNone
}

var global u32

func letElsePtr(o PtrOpt) *u32 {
	if !(o is PSome(p)) {
		return &global
	}
	return p
}

func letElseLocal() *u32 {
	var local u32
	o := PtrOpt.PSome(&local)
	if !(o is PSome(p)) {
		return &global
	}
	return p
}

func chainPtr(o PtrOpt, q PtrOpt) bool {
	return o is PSome(a) && q is PSome(b) && a == b
}

func closeLetElse(r Res) {
	if !(r is Got(c, n)) || n == 0 {
		return
	}
	_ = c.Close()
}

func guardBody(r Res, o Opt[u32]) u32 {
	return match r {
		Got(_, n) if o is Some(k) && k < n -> n - k
		_ -> 0
	}
}

func depthOf(n usize, o Opt[u32]) u32 decreases(n) {
	if !(o is Some(k)) || n == 0 {
		return 0
	}
	return k + depthOf(n-1, o)
}

func sumAll(xs []Opt[u32]) u32 {
	var s u32 = 0
	for i := usize(0); i < len(xs); i++ {
		if !(xs[i] is Some(x)) {
			continue
		}
		s += x
	}
	return s
}

driver func drain(o Opt[u32]) u32 {
	var n u32 = 0
	cur := o
	driver for cur is Some(x) && x > 0 {
		n += x
		cur = Opt[u32].Some(x - 1)
	}
	return n
}

driver func main(io Stdio) error {
	var x u32 = 1
	_ = letElsePtr(PtrOpt.PSome(&x))
	_ = letElseLocal()
	_ = chainPtr(PtrOpt.PNone, PtrOpt.PSome(&x))
	closeLetElse(Res.Nothing)
	_ = guardBody(Res.Nothing, Opt[u32].None)
	_ = depthOf(3, Opt[u32].Some(2))
	var xs [3]Opt[u32]
	_ = sumAll(xs[:])
	_ = drain(Opt[u32].Some(3))
	global = x
	return nil
}
