// Package pg implements a pure-FinCore, zero-GC, zero-libc PostgreSQL v3.0
// wire-protocol client (trust, cleartext, MD5, and SCRAM-SHA-256 auth;
// pipelined Extended Query Protocol; zero-copy streaming rows; scoped Open & WithTx).
package pg

import (
	"std/sql"
	"std/strings"
)

const (
	MaxWireBuf usize = 16384
	MaxMsgBuf  usize = 8192
)

// Config configures a PostgreSQL TCP connection.
type Config struct {
	Addr     string // e.g. "127.0.0.1:5432"
	User     string
	Password string
	Database string
}

// Client holds a PostgreSQL v3.0 session backed by a scoped TCP connection.
// Because conn is a scoped pointer, Client cannot escape pg.Open (verified at compile time).
type Client struct {
	conn       *Conn
	rbuf       [MaxWireBuf]byte
	rPos       usize
	rLen       usize
	wbuf       [MaxMsgBuf]byte
	txStatus   byte
	backendPID u32
	backendKey u32
	schema     sql.Schema
	lastErr    sql.DBError
}

// Tx represents an active PostgreSQL database transaction inside Client.WithTx.
type Tx struct {
	c *Client
}

// ---------------------------------------------------------------------------
// Big-endian wire helpers (Layer-2 total)

func putBE16(dst []byte, off usize, v u16) {
	dst[off] = byte((v >> 8) & 0xff)
	dst[off+1] = byte(v & 0xff)
}

func putBE32(dst []byte, off usize, v u32) {
	dst[off] = byte((v >> 24) & 0xff)
	dst[off+1] = byte((v >> 16) & 0xff)
	dst[off+2] = byte((v >> 8) & 0xff)
	dst[off+3] = byte(v & 0xff)
}

func getBE16(b const []byte, off usize) u16 {
	return (u16(b[off]) << 8) | u16(b[off+1])
}

func getBE32(b const []byte, off usize) u32 {
	return (u32(b[off]) << 24) | (u32(b[off+1]) << 16) | (u32(b[off+2]) << 8) | u32(b[off+3])
}

func writeAll(ctx Context, conn *Conn, data []byte) error {
	for rem := data; len(rem) > 0; {
		n, err := (*conn).Write(ctx, rem)
		if err != nil {
			return err
		}
		if n == 0 {
			return ErrZeroWrite
		}
		rem = rem[n:]
	}
	return nil
}

// ---------------------------------------------------------------------------
// Wire framing reader (buffered, zero heap)

driver func (c *Client) ensureBytes(ctx Context, need usize) error {
	if need > MaxWireBuf {
		return ErrArenaFull
	}
	if c.rLen-c.rPos >= need {
		return nil
	}
	// Compact remaining unread bytes to front of rbuf.
	rem := c.rLen - c.rPos
	if c.rPos > 0 {
		for i := usize(0); i < rem; i++ {
			c.rbuf[i] = c.rbuf[c.rPos+i]
		}
		c.rPos = 0
		c.rLen = rem
	}
	driver for {
		if c.rLen >= need {
			return nil
		}
		n, err := (*c.conn).Read(ctx, c.rbuf[c.rLen:])
		if err != nil {
			return err
		}
		if n == 0 {
			return ErrEOF
		}
		c.rLen += n
	}
}

// readMsg reads one PostgreSQL backend message and returns (msgType, payloadStart, payloadLen, err).
driver func (c *Client) readMsg(ctx Context) (byte, usize, usize, error) {
	if err := c.ensureBytes(ctx, 5); err != nil {
		return 0, 0, 0, err
	}
	mtype := c.rbuf[c.rPos]
	mlen := usize(getBE32(c.rbuf[:], c.rPos+1))
	if mlen < 4 {
		return 0, 0, 0, ErrParse
	}
	total := 1 + mlen
	if err := c.ensureBytes(ctx, total); err != nil {
		return 0, 0, 0, err
	}
	payStart := c.rPos + 5
	payLen := mlen - 4
	c.rPos += total
	return mtype, payStart, payLen, nil
}

// ---------------------------------------------------------------------------
// Backend message parsers (Layer-2 total)

func parseErrorResponse(payload const []byte, out *sql.DBError) {
	out.Clear()
	out.HasErr = true
	pos := usize(0)
	n := len(payload)
	for step := usize(0); step < 64; step++ {
		if pos >= n || payload[pos] == 0 {
			break
		}
		code := payload[pos]
		pos++
		end := pos
		for j := pos; j < n; j++ {
			if payload[j] == 0 {
				end = j
				break
			}
		}
		val := payload[pos:end]
		if code == 'S' {
			out.SevLen = appendConstBytes(out.Severity[:], 0, val)
		} else if code == 'C' {
			out.CodeLen = appendConstBytes(out.Code[:], 0, val)
		} else if code == 'M' {
			out.MsgLen = appendConstBytes(out.Message[:], 0, val)
		}
		pos = end + 1
	}
}

func parseRowDescription(payload const []byte, schema *sql.Schema) bool {
	schema.Reset()
	if len(payload) < 2 {
		return false
	}
	ncols := getBE16(payload, 0)
	pos := usize(2)
	n := len(payload)
	for i := u16(0); i < ncols; i++ {
		if pos >= n {
			return false
		}
		nul := pos
		foundNul := false
		for j := pos; j < n; j++ {
			if payload[j] == 0 {
				nul = j
				foundNul = true
				break
			}
		}
		if !foundNul || nul+1+18 > n {
			return false
		}
		name := payload[pos:nul]
		metaOff := nul + 1
		// tableOID(4) + colAttr(2) + typeOID(4) + typeSize(2) + typeMod(4) + formatCode(2)
		typeOID := getBE32(payload, metaOff+6)
		schema.AddCol(name, typeOID)
		pos = metaOff + 18
	}
	return true
}

func parseDataRowSpans(payload const []byte, spans *[sql.MaxCols]sql.ColSpan) (u16, bool) {
	if len(payload) < 2 {
		return 0, false
	}
	ncols := getBE16(payload, 0)
	if usize(ncols) > sql.MaxCols {
		return 0, false
	}
	pos := usize(2)
	n := len(payload)
	for i := u16(0); i < ncols; i++ {
		if pos+4 > n {
			return 0, false
		}
		clen := getBE32(payload, pos)
		pos += 4
		if clen == 0xffffffff {
			spans[i] = sql.ColSpan{Off: 0, Len: 0, IsNull: true}
		} else {
			if pos+usize(clen) > n {
				return 0, false
			}
			spans[i] = sql.ColSpan{Off: u32(pos), Len: clen, IsNull: false}
			pos += usize(clen)
		}
	}
	return ncols, true
}

func extractCString(payload const []byte) const []byte {
	for i := usize(0); i < len(payload); i++ {
		if payload[i] == 0 {
			return payload[:i]
		}
	}
	return payload
}

// ---------------------------------------------------------------------------
// Startup & Authentication (trust, cleartext, MD5, SCRAM-SHA-256)

func (c *Client) buildStartup(cfg Config) usize {
	// [4: len] [4: 0x00030000] "user\0...\0database\0...\0client_encoding\0UTF8\0\0"
	p := usize(8)
	putBE32(c.wbuf[:], 4, 196608) // Protocol 3.0
	p = appendStr(c.wbuf[:], p, "user")
	c.wbuf[p] = 0
	p++
	p = appendStr(c.wbuf[:], p, cfg.User)
	c.wbuf[p] = 0
	p++
	db := cfg.Database
	if len(db) == 0 {
		db = cfg.User
	}
	p = appendStr(c.wbuf[:], p, "database")
	c.wbuf[p] = 0
	p++
	p = appendStr(c.wbuf[:], p, db)
	c.wbuf[p] = 0
	p++
	p = appendStr(c.wbuf[:], p, "client_encoding")
	c.wbuf[p] = 0
	p++
	p = appendStr(c.wbuf[:], p, "UTF8")
	c.wbuf[p] = 0
	p++
	c.wbuf[p] = 0
	p++
	putBE32(c.wbuf[:], 0, u32(p))
	return p
}

func saslHasScramSHA256(payload const []byte) bool {
	pos := usize(4)
	n := len(payload)
	for step := usize(0); step < 16; step++ {
		if pos >= n || payload[pos] == 0 {
			break
		}
		end := pos
		for j := pos; j < n; j++ {
			if payload[j] == 0 {
				end = j
				break
			}
		}
		if strings.EqualStr(payload[pos:end], "SCRAM-SHA-256") {
			return true
		}
		pos = end + 1
	}
	return false
}

driver func (c *Client) sendPasswordMsg(ctx Context, body const []byte, nulTerm bool) error {
	extra := usize(0)
	if nulTerm {
		extra = 1
	}
	total := 5 + len(body) + extra
	if total > MaxMsgBuf {
		return ErrArenaFull
	}
	c.wbuf[0] = 'p'
	putBE32(c.wbuf[:], 1, u32(4+len(body)+extra))
	p := appendConstBytes(c.wbuf[:], 5, body)
	if nulTerm {
		c.wbuf[p] = 0
		p++
	}
	return writeAll(ctx, c.conn, c.wbuf[:p])
}

driver func (c *Client) sendSASLInitial(ctx Context, cFirst const []byte) error {
	// 'p' + len + "SCRAM-SHA-256\0" + BE32(len(cFirst)) + cFirst
	mech := "SCRAM-SHA-256"
	payLen := len(mech) + 1 + 4 + len(cFirst)
	if 5+payLen > MaxMsgBuf {
		return ErrArenaFull
	}
	c.wbuf[0] = 'p'
	putBE32(c.wbuf[:], 1, u32(4+payLen))
	p := appendStr(c.wbuf[:], 5, mech)
	c.wbuf[p] = 0
	p++
	putBE32(c.wbuf[:], p, u32(len(cFirst)))
	p += 4
	p = appendConstBytes(c.wbuf[:], p, cFirst)
	return writeAll(ctx, c.conn, c.wbuf[:p])
}

driver func (c *Client) handshake(ctx Context, cfg Config) error {
	sn := c.buildStartup(cfg)
	if err := writeAll(ctx, c.conn, c.wbuf[:sn]); err != nil {
		return err
	}

	var scram scramState
	var scramStarted bool = false
	var scramVerified bool = false
	var seed u64 = 0x517cc1b727220a95 ^ u64(len(cfg.User)*31+len(cfg.Database)*17)

	driver for {
		mtype, ps, pl, err := c.readMsg(ctx)
		if err != nil {
			return err
		}
		payload := c.rbuf[ps : ps+pl]
		if mtype == 'R' {
			if pl < 4 {
				return ErrParse
			}
			authType := getBE32(payload, 0)
			if authType == 0 {
				// AuthenticationOk
				if scramStarted && !scramVerified {
					return ErrParse
				}
			} else if authType == 3 {
				// AuthenticationCleartextPassword
				if err := c.sendPasswordMsg(ctx, strView(cfg.Password), true); err != nil {
					return err
				}
			} else if authType == 5 {
				// AuthenticationMD5Password
				if pl < 8 {
					return ErrParse
				}
				var salt [4]byte
				salt[0] = payload[4]
				salt[1] = payload[5]
				salt[2] = payload[6]
				salt[3] = payload[7]
				var md5Buf [40]byte
				mn := md5AuthPassword(strView(cfg.User), strView(cfg.Password), salt, md5Buf[:])
				if err := c.sendPasswordMsg(ctx, md5Buf[:mn], true); err != nil {
					return err
				}
			} else if authType == 10 {
				// AuthenticationSASL
				if !saslHasScramSHA256(payload) {
					return ErrParse
				}
				var cFirst [192]byte
				cfn := scram.buildClientFirst(strView(cfg.User), seed, cFirst[:])
				scramStarted = true
				if err := c.sendSASLInitial(ctx, cFirst[:cfn]); err != nil {
					return err
				}
			} else if authType == 11 {
				// AuthenticationSASLContinue
				if !scramStarted {
					return ErrParse
				}
				var cFinal [256]byte
				cfn, serr := scram.processServerFirst(strView(cfg.Password), payload[4:], cFinal[:])
				if serr != nil {
					return serr
				}
				if err := c.sendPasswordMsg(ctx, cFinal[:cfn], false); err != nil {
					return err
				}
			} else if authType == 12 {
				// AuthenticationSASLFinal
				if !scramStarted || !scram.verifyServerFinal(payload[4:]) {
					return ErrParse
				}
				scramVerified = true
			} else {
				return ErrParse
			}
		} else if mtype == 'K' {
			if pl >= 8 {
				c.backendPID = getBE32(payload, 0)
				c.backendKey = getBE32(payload, 4)
			}
		} else if mtype == 'Z' {
			if pl >= 1 {
				c.txStatus = payload[0]
			}
			return nil
		} else if mtype == 'E' {
			parseErrorResponse(payload, &c.lastErr)
			return ErrIO
		}
		// 'S' (ParameterStatus), 'N' (NoticeResponse) are safely ignored.
	}
}

driver func (c *Client) sendTerminate(ctx Context) {
	var term [5]byte
	term[0] = 'X'
	putBE32(term[:], 1, 4)
	_ = writeAll(ctx, c.conn, term[:])
}

// Open dials PostgreSQL, authenticates (trust/cleartext/MD5/SCRAM-SHA-256),
// executes fn with a scoped *Client, and ALWAYS sends Terminate + closes the
// TCP connection on exit (zero connection leaks by construction).
driver func Open(ctx Context, net Net, cfg Config, fn driver func(*Client) error) error {
	conn, err := net.DialTCP(ctx, cfg.Addr)
	if err != nil {
		return err
	}
	defer conn.Close()

	var client Client
	client.conn = &conn
	client.txStatus = 'I'
	if err := client.handshake(ctx, cfg); err != nil {
		return err
	}
	runErr := fn(&client)
	client.sendTerminate(ctx)
	return runErr
}

// ---------------------------------------------------------------------------
// Inspection accessors

func (c const *Client) TxStatus() byte {
	return c.txStatus
}

func (c const *Client) BackendPID() u32 {
	return c.backendPID
}

func (c const *Client) HasError() bool {
	return c.lastErr.HasErr
}

func (c const *Client) LastError() const *sql.DBError {
	return &c.lastErr
}

// ---------------------------------------------------------------------------
// Simple Query & Pipelined Extended Query Protocol

// ExecSimple runs a Simple Query ('Q') message (ideal for DDL or BEGIN/COMMIT/ROLLBACK).
driver func (c *Client) ExecSimple(ctx Context, query string) (sql.Result, error) {
	var res sql.Result
	c.lastErr.Clear()
	qlen := len(query)
	if 5+qlen+1 > MaxMsgBuf {
		return res, ErrArenaFull
	}
	c.wbuf[0] = 'Q'
	putBE32(c.wbuf[:], 1, u32(4+qlen+1))
	p := appendStr(c.wbuf[:], 5, query)
	c.wbuf[p] = 0
	p++
	if err := writeAll(ctx, c.conn, c.wbuf[:p]); err != nil {
		return res, err
	}

	var queryErr error = nil
	driver for {
		mtype, ps, pl, err := c.readMsg(ctx)
		if err != nil {
			return res, err
		}
		payload := c.rbuf[ps : ps+pl]
		if mtype == 'C' {
			res = sql.ParseCommandTag(extractCString(payload))
		} else if mtype == 'E' {
			parseErrorResponse(payload, &c.lastErr)
			queryErr = ErrIO
		} else if mtype == 'Z' {
			if pl >= 1 {
				c.txStatus = payload[0]
			}
			return res, queryErr
		}
	}
}

func (c *Client) buildExtendedPipeline(query string, params const []sql.Param, wantDescribe bool) (usize, error) {
	p := usize(0)

	// 1. Parse ('P'): unnamed stmt "", query, 0 param type OIDs (server infers)
	qlen := len(query)
	parseLen := 4 + 1 + qlen + 1 + 2
	if p+1+parseLen > MaxMsgBuf {
		return 0, ErrArenaFull
	}
	c.wbuf[p] = 'P'
	putBE32(c.wbuf[:], p+1, u32(parseLen))
	p += 5
	c.wbuf[p] = 0 // unnamed prepared statement
	p++
	p = appendStr(c.wbuf[:], p, query)
	c.wbuf[p] = 0
	p++
	putBE16(c.wbuf[:], p, 0) // 0 specified OIDs
	p += 2

	// 2. Bind ('B'): unnamed portal "", unnamed stmt "", 0 format codes (text), N params, 0 result formats (text)
	bindStart := p
	if p+9 > MaxMsgBuf {
		return 0, ErrArenaFull
	}
	c.wbuf[p] = 'B'
	p += 5 // reserve 4-byte length at bindStart+1
	c.wbuf[p] = 0
	p++
	c.wbuf[p] = 0
	p++
	putBE16(c.wbuf[:], p, 0) // 0 param format codes -> all text
	p += 2
	putBE16(c.wbuf[:], p, u16(len(params)))
	p += 2

	var numTmp [32]byte
	for i := usize(0); i < len(params); i++ {
		if p+4 > MaxMsgBuf {
			return 0, ErrArenaFull
		}
		match params[i] {
			sql.Param.Null() -> {
				putBE32(c.wbuf[:], p, 0xffffffff) // SQL NULL (-1)
				p += 4
			}
			sql.Param.Bool(b) -> {
				if p+5 > MaxMsgBuf {
					return 0, ErrArenaFull
				}
				putBE32(c.wbuf[:], p, 1)
				p += 4
				if b {
					c.wbuf[p] = 't'
				} else {
					c.wbuf[p] = 'f'
				}
				p++
			}
			sql.Param.Int(v) -> {
				nn := formatTo(numTmp[:], "%d", v)
				if p+4+nn > MaxMsgBuf {
					return 0, ErrArenaFull
				}
				putBE32(c.wbuf[:], p, u32(nn))
				p += 4
				p = appendConstBytes(c.wbuf[:], p, numTmp[:nn])
			}
			sql.Param.Uint(v) -> {
				nn := formatTo(numTmp[:], "%d", v)
				if p+4+nn > MaxMsgBuf {
					return 0, ErrArenaFull
				}
				putBE32(c.wbuf[:], p, u32(nn))
				p += 4
				p = appendConstBytes(c.wbuf[:], p, numTmp[:nn])
			}
			sql.Param.Text(s) -> {
				sl := len(s)
				if p+4+sl > MaxMsgBuf {
					return 0, ErrArenaFull
				}
				putBE32(c.wbuf[:], p, u32(sl))
				p += 4
				p = appendStr(c.wbuf[:], p, s)
			}
		}
	}
	if p+2 > MaxMsgBuf {
		return 0, ErrArenaFull
	}
	putBE16(c.wbuf[:], p, 0) // 0 result format codes -> all text
	p += 2
	putBE32(c.wbuf[:], bindStart+1, u32(p-bindStart-1))

	// 3. Optional Describe Portal ('D' 'P' "")
	if wantDescribe {
		if p+7 > MaxMsgBuf {
			return 0, ErrArenaFull
		}
		c.wbuf[p] = 'D'
		putBE32(c.wbuf[:], p+1, 6)
		c.wbuf[p+5] = 'P'
		c.wbuf[p+6] = 0
		p += 7
	}

	// 4. Execute ('E' "" 0)
	if p+10 > MaxMsgBuf {
		return 0, ErrArenaFull
	}
	c.wbuf[p] = 'E'
	putBE32(c.wbuf[:], p+1, 9)
	c.wbuf[p+5] = 0
	putBE32(c.wbuf[:], p+6, 0) // 0 = no row limit
	p += 10

	// 5. Sync ('S')
	if p+5 > MaxMsgBuf {
		return 0, ErrArenaFull
	}
	c.wbuf[p] = 'S'
	putBE32(c.wbuf[:], p+1, 4)
	p += 5

	return p, nil
}

// Exec runs a parameterized statement ($1, $2, ...) via the Extended Query Protocol.
driver func (c *Client) Exec(ctx Context, query string, params const []sql.Param) (sql.Result, error) {
	var res sql.Result
	c.lastErr.Clear()
	wn, err := c.buildExtendedPipeline(query, params, false)
	if err != nil {
		return res, err
	}
	if err := writeAll(ctx, c.conn, c.wbuf[:wn]); err != nil {
		return res, err
	}

	var queryErr error = nil
	driver for {
		mtype, ps, pl, rerr := c.readMsg(ctx)
		if rerr != nil {
			return res, rerr
		}
		payload := c.rbuf[ps : ps+pl]
		if mtype == 'C' {
			res = sql.ParseCommandTag(extractCString(payload))
		} else if mtype == 'E' {
			parseErrorResponse(payload, &c.lastErr)
			queryErr = ErrIO
		} else if mtype == 'Z' {
			if pl >= 1 {
				c.txStatus = payload[0]
			}
			return res, queryErr
		}
	}
}

// Query runs a parameterized SELECT and streams each row zero-copy into onRow.
// Return false from onRow to stop early; Client automatically drains until
// ReadyForQuery ('Z') so the connection always stays synchronized (no rows.Close needed!).
driver func (c *Client) Query(
	ctx Context,
	query string,
	params const []sql.Param,
	onRow func(const *sql.Row) bool,
) (sql.Result, error) {
	var res sql.Result
	c.lastErr.Clear()
	c.schema.Reset()
	wn, err := c.buildExtendedPipeline(query, params, true)
	if err != nil {
		return res, err
	}
	if err := writeAll(ctx, c.conn, c.wbuf[:wn]); err != nil {
		return res, err
	}

	var queryErr error = nil
	wantMore := true
	var spans [sql.MaxCols]sql.ColSpan

	driver for {
		mtype, ps, pl, rerr := c.readMsg(ctx)
		if rerr != nil {
			return res, rerr
		}
		payload := c.rbuf[ps : ps+pl]
		if mtype == 'T' {
			if !parseRowDescription(payload, &c.schema) {
				queryErr = ErrParse
			}
		} else if mtype == 'D' {
			if wantMore && queryErr == nil {
				ncols, ok := parseDataRowSpans(payload, &spans)
				if !ok {
					queryErr = ErrParse
				} else {
					row := sql.NewRow(&c.schema, payload, spans, ncols)
					if !onRow(&row) {
						wantMore = false
					}
				}
			}
		} else if mtype == 'C' {
			res = sql.ParseCommandTag(extractCString(payload))
		} else if mtype == 'E' {
			parseErrorResponse(payload, &c.lastErr)
			queryErr = ErrIO
		} else if mtype == 'Z' {
			if pl >= 1 {
				c.txStatus = payload[0]
			}
			return res, queryErr
		}
	}
}

// QueryRow runs a parameterized SELECT and copies the first row into out.
// Returns (true, nil) if a row was found, (false, nil) if 0 rows matched, or (false, err).
driver func (c *Client) QueryRow(
	ctx Context,
	query string,
	params const []sql.Param,
	out *sql.RowBuf,
) (bool, error) {
	out.Reset()
	c.lastErr.Clear()
	c.schema.Reset()
	wn, err := c.buildExtendedPipeline(query, params, true)
	if err != nil {
		return false, err
	}
	if err := writeAll(ctx, c.conn, c.wbuf[:wn]); err != nil {
		return false, err
	}

	var queryErr error = nil
	found := false

	driver for {
		mtype, ps, pl, rerr := c.readMsg(ctx)
		if rerr != nil {
			return false, rerr
		}
		payload := c.rbuf[ps : ps+pl]
		if mtype == 'T' {
			if !parseRowDescription(payload, &c.schema) {
				queryErr = ErrParse
			}
		} else if mtype == 'D' {
			if !found && queryErr == nil {
				if pl > sql.MaxRowBytes {
					queryErr = ErrArenaFull
				} else {
					ncols, ok := parseDataRowSpans(payload, &out.Spans)
					if !ok {
						queryErr = ErrParse
					} else {
						out.Schema = c.schema
						for i := usize(0); i < pl; i++ {
							out.Data[i] = payload[i]
						}
						out.DataLen = pl
						out.NumCols = ncols
						found = true
					}
				}
			}
		} else if mtype == 'E' {
			parseErrorResponse(payload, &c.lastErr)
			queryErr = ErrIO
		} else if mtype == 'Z' {
			if pl >= 1 {
				c.txStatus = payload[0]
			}
			return found, queryErr
		}
	}
}

// Ping verifies the PostgreSQL session is alive using an EmptyQuery ('Q' "").
driver func (c *Client) Ping(ctx Context) error {
	_, err := c.ExecSimple(ctx, "")
	return err
}

// ---------------------------------------------------------------------------
// Scoped Transactions (impossible to leak or forget Rollback!)

// WithTx executes fn inside a PostgreSQL transaction:
// - sends BEGIN
// - if fn returns nil -> sends COMMIT
// - if fn returns err != nil -> sends ROLLBACK and returns err
driver func (c *Client) WithTx(ctx Context, fn driver func(*Tx) error) error {
	if _, err := c.ExecSimple(ctx, "BEGIN"); err != nil {
		return err
	}
	tx := Tx{c: c}
	fnErr := fn(&tx)
	if fnErr != nil {
		_, _ = c.ExecSimple(ctx, "ROLLBACK")
		return fnErr
	}
	_, cerr := c.ExecSimple(ctx, "COMMIT")
	return cerr
}

driver func (tx *Tx) ExecSimple(ctx Context, query string) (sql.Result, error) {
	return tx.c.ExecSimple(ctx, query)
}

driver func (tx *Tx) Exec(ctx Context, query string, params const []sql.Param) (sql.Result, error) {
	return tx.c.Exec(ctx, query, params)
}

driver func (tx *Tx) Query(
	ctx Context,
	query string,
	params const []sql.Param,
	onRow func(const *sql.Row) bool,
) (sql.Result, error) {
	return tx.c.Query(ctx, query, params, onRow)
}

driver func (tx *Tx) QueryRow(
	ctx Context,
	query string,
	params const []sql.Param,
	out *sql.RowBuf,
) (bool, error) {
	return tx.c.QueryRow(ctx, query, params, out)
}
