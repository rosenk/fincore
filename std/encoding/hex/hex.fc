// Package hex implements hexadecimal encoding and decoding (zero allocation,
// Layer-2 provably total).
package hex

const digits = "0123456789abcdef"

// EncodedLen returns the length of an encoding of n source bytes.
func EncodedLen(n usize) usize {
	return n * 2
}

// DecodedLen returns the length of a decoding of n hex bytes.
func DecodedLen(n usize) usize {
	return n / 2
}

func fromHexChar(c byte) (u8, bool) {
	if c >= '0' && c <= '9' {
		return c - '0', true
	}
	if c >= 'a' && c <= 'f' {
		return c - 'a' + 10, true
	}
	if c >= 'A' && c <= 'F' {
		return c - 'A' + 10, true
	}
	return 0, false
}

// Encode encodes src into dst as lowercase hex bytes.
// Returns (len(src)*2, nil) or (0, ErrArenaFull) if dst is too small.
func Encode(dst []byte, src const []byte) (usize, error) {
	need := len(src) * 2
	if len(dst) < need {
		return 0, ErrArenaFull
	}
	dv := strView(digits)
	for i := usize(0); i < len(src); i++ {
		b := src[i]
		dst[i*2] = dv[usize(b>>4)]
		dst[i*2+1] = dv[usize(b&0x0f)]
	}
	return need, nil
}

// Decode decodes hex bytes from src into dst.
// Returns ErrParse on odd input length or invalid hex digit, ErrArenaFull if dst is too small.
func Decode(dst []byte, src const []byte) (usize, error) {
	if (len(src) & 1) != 0 {
		return 0, ErrParse
	}
	need := len(src) / 2
	if len(dst) < need {
		return 0, ErrArenaFull
	}
	for i := usize(0); i < need; i++ {
		hi, ok1 := fromHexChar(src[i*2])
		lo, ok2 := fromHexChar(src[i*2+1])
		if !ok1 || !ok2 {
			return 0, ErrParse
		}
		dst[i] = (hi << 4) | lo
	}
	return need, nil
}
