// Package rand provides a fast, zero-GC, Layer-2 total PRNG (Xorshift64*)
// with bounded integer generation and Fisher-Yates shuffle.
package rand

type RNG struct {
	state u64
}

// New creates a seeded RNG (zero seed is mapped to a non-zero constant).
func New(seed u64) RNG {
	s := seed
	if s == 0 {
		s = 0x9e3779b97f4a7c15
	}
	return RNG{state: s}
}

// NextU64 returns the next pseudo-random 64-bit unsigned integer.
func (r *RNG) NextU64() u64 {
	x := r.state
	if x == 0 {
		x = 0x9e3779b97f4a7c15
	}
	x ^= x >> 12
	x ^= x << 25
	x ^= x >> 27
	r.state = x
	return x * 0x2545f4914f6cdd1d
}

// Intn returns a pseudo-random index in [0, n), or 0 if n == 0.
func (r *RNG) Intn(n usize) usize {
	if n <= 1 {
		return 0
	}
	return usize(r.NextU64() % u64(n))
}

// Shuffle performs an in-place Fisher-Yates shuffle on s (Layer-2 total, zero heap).
func Shuffle[T any](r *RNG, s []T) {
	n := len(s)
	if n <= 1 {
		return
	}
	for i := usize(0); i < n-1; i++ {
		idx := n - 1 - i
		j := r.Intn(idx + 1)
		tmp := s[idx]
		s[idx] = s[j]
		s[j] = tmp
	}
}
