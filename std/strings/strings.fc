// Package strings provides zero-copy, allocation-free string and byte-view
// utilities for FinCore (Go-style ergonomics over `string` and `const []byte`).
// Every function is Layer-2 provably total and performs zero heap allocations.
package strings

effect YieldPart {
	yieldPart(part const []byte)
}

func toLowerASCII(c byte) byte {
	if c >= 'A' && c <= 'Z' {
		return c + 32
	}
	return c
}

func isSpaceASCII(c byte) bool {
	return c == ' ' || c == '\t' || c == '\r' || c == '\n'
}

// Equal reports whether two byte views have identical contents.
func Equal(a const []byte, b const []byte) bool {
	if len(a) != len(b) {
		return false
	}
	for i := usize(0); i < len(a); i++ {
		if a[i] != b[i] {
			return false
		}
	}
	return true
}

// EqualStr reports whether byte view a equals string literal/value s (zero-copy).
func EqualStr(a const []byte, s string) bool {
	return Equal(a, strView(s))
}

// EqualFold reports ASCII case-insensitive equality (ideal for HTTP headers).
func EqualFold(a const []byte, b const []byte) bool {
	if len(a) != len(b) {
		return false
	}
	for i := usize(0); i < len(a); i++ {
		if toLowerASCII(a[i]) != toLowerASCII(b[i]) {
			return false
		}
	}
	return true
}

// EqualFoldStr reports ASCII case-insensitive equality against string s.
func EqualFoldStr(a const []byte, s string) bool {
	return EqualFold(a, strView(s))
}

// HasPrefix reports whether s starts with prefix.
func HasPrefix(s const []byte, prefix const []byte) bool {
	if len(s) < len(prefix) {
		return false
	}
	for i := usize(0); i < len(prefix); i++ {
		if s[i] != prefix[i] {
			return false
		}
	}
	return true
}

func HasPrefixStr(s const []byte, prefix string) bool {
	return HasPrefix(s, strView(prefix))
}

// HasSuffix reports whether s ends with suffix.
func HasSuffix(s const []byte, suffix const []byte) bool {
	if len(s) < len(suffix) {
		return false
	}
	off := len(s) - len(suffix)
	for i := usize(0); i < len(suffix); i++ {
		if s[off+i] != suffix[i] {
			return false
		}
	}
	return true
}

func HasSuffixStr(s const []byte, suffix string) bool {
	return HasSuffix(s, strView(suffix))
}

// IndexByte returns the index of the first occurrence of c in s, or (0, false).
func IndexByte(s const []byte, c byte) (usize, bool) {
	for i := usize(0); i < len(s); i++ {
		if s[i] == c {
			return i, true
		}
	}
	return 0, false
}

// Index returns the index of the first occurrence of sub in s, or (0, false).
func Index(s const []byte, sub const []byte) (usize, bool) {
	if len(sub) == 0 {
		return 0, true
	}
	if len(sub) > len(s) {
		return 0, false
	}
	limit := len(s) - len(sub) + 1
	for i := usize(0); i < limit; i++ {
		if s[i] == sub[0] {
			ok := true
			for j := usize(1); j < len(sub); j++ {
				if s[i+j] != sub[j] {
					ok = false
					break
				}
			}
			if ok {
				return i, true
			}
		}
	}
	return 0, false
}

func Contains(s const []byte, sub const []byte) bool {
	_, ok := Index(s, sub)
	return ok
}

func ContainsStr(s const []byte, sub string) bool {
	return Contains(s, strView(sub))
}

// TrimSpace returns a zero-copy sub-view of s without leading/trailing ASCII whitespace.
func TrimSpace(s const []byte) const []byte {
	lo := usize(0)
	hi := len(s)
	for step := usize(0); step < len(s); step++ {
		if lo < hi && isSpaceASCII(s[lo]) {
			lo++
		} else {
			break
		}
	}
	for step := usize(0); step < len(s); step++ {
		if hi > lo && isSpaceASCII(s[hi-1]) {
			hi--
		} else {
			break
		}
	}
	return s[lo:hi]
}

// TrimPrefix returns s without the provided leading prefix if present.
func TrimPrefix(s const []byte, prefix const []byte) const []byte {
	if HasPrefix(s, prefix) {
		return s[len(prefix):]
	}
	return s
}

// TrimSuffix returns s without the provided trailing suffix if present.
func TrimSuffix(s const []byte, suffix const []byte) const []byte {
	if HasSuffix(s, suffix) {
		return s[:len(s)-len(suffix)]
	}
	return s
}

// Cut slices s around the first instance of sep, returning (before, after, found).
func Cut(s const []byte, sep const []byte) (const []byte, const []byte, bool) {
	idx, ok := Index(s, sep)
	if !ok {
		return s, s[len(s):], false
	}
	return s[:idx], s[idx+len(sep):], true
}

// CutByte slices s around the first byte sep, returning (before, after, found).
func CutByte(s const []byte, sep byte) (const []byte, const []byte, bool) {
	idx, ok := IndexByte(s, sep)
	if !ok {
		return s, s[len(s):], false
	}
	return s[:idx], s[idx+1:], true
}

// SplitByte streams parts of s separated by sep via Tier-1 YieldPart effect (0 allocations!).
func SplitByte(s const []byte, sep byte) with YieldPart {
	start := usize(0)
	for i := usize(0); i < len(s); i++ {
		if s[i] == sep {
			yieldPart(s[start:i])
			start = i + 1
		}
	}
	yieldPart(s[start:])
}

// ParseUint parses a base-10 unsigned integer from a const byte view.
func ParseUint(s const []byte) (u64, bool) {
	if len(s) == 0 {
		return 0, false
	}
	var acc u64 = 0
	for i := usize(0); i < len(s); i++ {
		c := s[i]
		if c < '0' || c > '9' {
			return 0, false
		}
		d := u64(c - '0')
		if acc > (18446744073709551615-d)/10 {
			return 0, false
		}
		acc = acc*10 + d
	}
	return acc, true
}

// ParseInt parses a signed base-10 integer from a const byte view.
func ParseInt(s const []byte) (i64, bool) {
	if len(s) == 0 {
		return 0, false
	}
	neg := false
	rem := s
	if rem[0] == '-' {
		neg = true
		rem = rem[1:]
	} else if rem[0] == '+' {
		rem = rem[1:]
	}
	v, ok := ParseUint(rem)
	if !ok {
		return 0, false
	}
	if neg {
		if v > 9223372036854775808 {
			return 0, false
		}
		return i64(0 - v), true
	}
	if v > 9223372036854775807 {
		return 0, false
	}
	return i64(v), true
}
