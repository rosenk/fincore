// Package datalog provides a finitist, stratified, allocation-free Datalog
// engine written in 100% Layer-2 total FinCore (v0.6):
//   - Bounded fixed-capacity deduplicated relations (Unary[N, T], Binary[N, A, B])
//   - Zero GC, zero malloc, zero libc, zero backtracking
//   - Stratified negation (AntiJoin) and least-fixed-point Horn rules
//     (Join, ProjectReach, TransitiveClosure, SelfLoops) with provable termination
//   - Zero-copy const []T views and Tier-1 algebraic effect streaming (Emit[T])
package datalog

effect Emit[T any] {
	emit(v T)
}

type Pair[A Equal, B Equal] struct {
	a A
	b B
}

// Unary[N, T] is a bounded deduplicated unary relation P(x) holding at most N facts.
type Unary[N usize, T Equal] struct {
	data [N]T
	n    usize
}

func (u *Unary[N, T]) Len() usize {
	return u.n
}

func (u *Unary[N, T]) Has(x T) bool {
	for i := usize(0); i < u.n; i++ {
		if u.data[i] == x {
			return true
		}
	}
	return false
}

// Insert adds fact x. Returns true iff x was not already present and fit within N.
func (u *Unary[N, T]) Insert(x T) bool {
	if u.Has(x) {
		return false
	}
	if u.n >= N {
		return false
	}
	u.data[u.n] = x
	u.n++
	return true
}

func (u *Unary[N, T]) Slice() const []T {
	return u.data[:u.n]
}

// Binary[N, A, B] is a bounded deduplicated binary relation R(a, b) holding at most N tuples.
type Binary[N usize, A Equal, B Equal] struct {
	data [N]Pair[A, B]
	n    usize
}

func (r *Binary[N, A, B]) Len() usize {
	return r.n
}

func (r *Binary[N, A, B]) Has(a A, b B) bool {
	for i := usize(0); i < r.n; i++ {
		if r.data[i].a == a && r.data[i].b == b {
			return true
		}
	}
	return false
}

// Insert adds tuple (a, b). Returns true iff it was newly added.
func (r *Binary[N, A, B]) Insert(a A, b B) bool {
	if r.Has(a, b) {
		return false
	}
	if r.n >= N {
		return false
	}
	r.data[r.n] = Pair[A, B]{a: a, b: b}
	r.n++
	return true
}

func (r *Binary[N, A, B]) Slice() const []Pair[A, B] {
	return r.data[:r.n]
}

// Join evaluates the Horn rule: out(a, c) :- r1(a, b), r2(b, c).
// Returns true iff at least one new tuple was derived.
func Join[N1 usize, N2 usize, NO usize, A Equal, B Equal, C Equal](
	r1 const *Binary[N1, A, B],
	r2 const *Binary[N2, B, C],
	out *Binary[NO, A, C],
) bool {
	changed := false
	for i := usize(0); i < r1.n; i++ {
		p1 := r1.data[i]
		for j := usize(0); j < r2.n; j++ {
			p2 := r2.data[j]
			if p1.b == p2.a {
				if out.Insert(p1.a, p2.b) {
					changed = true
				}
			}
		}
	}
	return changed
}

// TransitiveClosure computes the least fixed point of:
//   out(x, y) :- edges(x, y).
//   out(x, z) :- out(x, y), edges(y, z).
// Guaranteed to terminate in at most N rounds (Layer-2 total!).
func TransitiveClosure[N usize, T Equal](edges const *Binary[N, T, T], out *Binary[N, T, T]) u32 {
	for i := usize(0); i < edges.n; i++ {
		_ = out.Insert(edges.data[i].a, edges.data[i].b)
	}
	var rounds u32 = 1
	for step := usize(0); step < N; step++ {
		changed := false
		curN := out.n
		for i := usize(0); i < curN; i++ {
			p := out.data[i]
			for j := usize(0); j < edges.n; j++ {
				e := edges.data[j]
				if p.b == e.a {
					if out.Insert(p.a, e.b) {
						changed = true
					}
				}
			}
		}
		if !changed {
			break
		}
		rounds++
	}
	return rounds
}

// ProjectReach computes the least fixed point of:
//   out(x) :- roots(x).
//   out(y) :- out(x), edges(x, y).
func ProjectReach[NU usize, NB usize, T Equal](
	roots const *Unary[NU, T],
	edges const *Binary[NB, T, T],
	out *Unary[NU, T],
) u32 {
	for i := usize(0); i < roots.n; i++ {
		_ = out.Insert(roots.data[i])
	}
	var rounds u32 = 1
	for step := usize(0); step < NU; step++ {
		changed := false
		curN := out.n
		for i := usize(0); i < curN; i++ {
			x := out.data[i]
			for j := usize(0); j < edges.n; j++ {
				e := edges.data[j]
				if e.a == x {
					if out.Insert(e.b) {
						changed = true
					}
				}
			}
		}
		if !changed {
			break
		}
		rounds++
	}
	return rounds
}

// AntiJoin evaluates stratified negation: out(x) :- all(x), not exclude(x).
func AntiJoin[N usize, T Equal](
	all const *Unary[N, T],
	exclude const *Unary[N, T],
	out *Unary[N, T],
) {
	for i := usize(0); i < all.n; i++ {
		x := all.data[i]
		found := false
		for j := usize(0); j < exclude.n; j++ {
			if exclude.data[j] == x {
				found = true
				break
			}
		}
		if !found {
			_ = out.Insert(x)
		}
	}
}

// SelfLoops evaluates: out(x) :- rel(x, x). (Detects cycles on a transitive closure!)
func SelfLoops[NB usize, NU usize, T Equal](rel const *Binary[NB, T, T], out *Unary[NU, T]) {
	for i := usize(0); i < rel.n; i++ {
		if rel.data[i].a == rel.data[i].b {
			_ = out.Insert(rel.data[i].a)
		}
	}
}

// StreamUnary streams every fact in u via the Tier-1 Emit[T] effect (zero allocations!).
func StreamUnary[N usize, T Equal](u const *Unary[N, T]) with Emit[T] {
	for i := usize(0); i < u.n; i++ {
		emit(u.data[i])
	}
}

// ---------------------------------------------------------------------------
// Flix-Style Lattice Datalog (Monotone Finite Lattices — Layer-2 Total, Zero-GC)
//
// Each key maps to a value in a finite join-semilattice (L, lub).
// Updates only advance monotonically upward in the lattice, guaranteeing
// least-fixed-point convergence for shortest-path, max-capacity, taint,
// and RBAC permission-propagation analyses.

type LatticeEntry[K Equal, V any] struct {
	Key K
	Val V
}

// LatticeMap[N, K, V] stores at most N (Key -> LatticeValue) facts with zero heap allocation.
type LatticeMap[N usize, K Equal, V any] struct {
	data [N]LatticeEntry[K, V]
	n    usize
}

func (m const *LatticeMap[N, K, V]) Len() usize {
	return m.n
}

func (m const *LatticeMap[N, K, V]) Slice() const []LatticeEntry[K, V] {
	return m.data[:m.n]
}

func (m const *LatticeMap[N, K, V]) Get(k K) (V, bool) {
	var zero V
	for i := usize(0); i < m.n; i++ {
		if m.data[i].Key == k {
			return m.data[i].Val, true
		}
	}
	return zero, false
}

// JoinWith inserts (k, v) if absent, or merges existing value via least-upper-bound `lub(cur, v)`.
// Returns true iff the lattice entry strictly changed.
func (m *LatticeMap[N, K, V]) JoinWith(k K, v V, lub func(V, V) V, eq func(V, V) bool) bool {
	for i := usize(0); i < m.n; i++ {
		if m.data[i].Key == k {
			next := lub(m.data[i].Val, v)
			if eq(m.data[i].Val, next) {
				return false
			}
			m.data[i].Val = next
			return true
		}
	}
	if m.n >= N {
		return false
	}
	m.data[m.n] = LatticeEntry[K, V]{Key: k, Val: v}
	m.n++
	return true
}

// JoinMin updates key k with the Min lattice (smaller values are higher in the lattice).
func JoinMin[N usize, K Equal, V Ordered](m *LatticeMap[N, K, V], k K, v V) bool {
	for i := usize(0); i < m.n; i++ {
		if m.data[i].Key == k {
			if v < m.data[i].Val {
				m.data[i].Val = v
				return true
			}
			return false
		}
	}
	if m.n >= N {
		return false
	}
	m.data[m.n] = LatticeEntry[K, V]{Key: k, Val: v}
	m.n++
	return true
}

// JoinMax updates key k with the Max lattice (larger values are higher in the lattice).
func JoinMax[N usize, K Equal, V Ordered](m *LatticeMap[N, K, V], k K, v V) bool {
	for i := usize(0); i < m.n; i++ {
		if m.data[i].Key == k {
			if v > m.data[i].Val {
				m.data[i].Val = v
				return true
			}
			return false
		}
	}
	if m.n >= N {
		return false
	}
	m.data[m.n] = LatticeEntry[K, V]{Key: k, Val: v}
	m.n++
	return true
}

// JoinBitOr updates key k with the BitSet Union lattice (bitwise OR — ideal for taint & RBAC).
func JoinBitOr[N usize, K Equal](m *LatticeMap[N, K, u64], k K, mask u64) bool {
	for i := usize(0); i < m.n; i++ {
		if m.data[i].Key == k {
			next := m.data[i].Val | mask
			if next == m.data[i].Val {
				return false
			}
			m.data[i].Val = next
			return true
		}
	}
	if m.n >= N {
		return false
	}
	m.data[m.n] = LatticeEntry[K, u64]{Key: k, Val: mask}
	m.n++
	return true
}

type WeightedEdge[T Equal, W any] struct {
	From   T
	To     T
	Weight W
}

// WeightedGraph[N, T, W] stores up to N directed weighted edges.
type WeightedGraph[N usize, T Equal, W any] struct {
	data [N]WeightedEdge[T, W]
	n    usize
}

func (g *WeightedGraph[N, T, W]) Add(from T, to T, weight W) bool {
	if g.n >= N {
		return false
	}
	g.data[g.n] = WeightedEdge[T, W]{From: from, To: to, Weight: weight}
	g.n++
	return true
}

func (g const *WeightedGraph[N, T, W]) Len() usize {
	return g.n
}

// ShortestPaths computes the Flix Min-Lattice least fixed point:
//   Dist(src; zero).
//   Dist(v; d + w) :- Dist(u; d), Edge(u, v, w).
// Layer-2 provably total (terminates in at most NV relaxation rounds).
func ShortestPaths[NE usize, NV usize, T Equal, W Numeric](
	src T,
	zero W,
	g const *WeightedGraph[NE, T, W],
	dist *LatticeMap[NV, T, W],
) u32 {
	_ = JoinMin[NV, T, W](dist, src, zero)
	var rounds u32 = 1
	for step := usize(0); step < NV; step++ {
		changed := false
		for i := usize(0); i < g.n; i++ {
			e := g.data[i]
			if d, ok := dist.Get(e.From); ok {
				if JoinMin[NV, T, W](dist, e.To, d+e.Weight) {
					changed = true
				}
			}
		}
		if !changed {
			break
		}
		rounds++
	}
	return rounds
}

// PropagateBits computes the Flix BitOr-Lattice least fixed point:
//   Perm(y; p) :- Perm(x; p), Edge(x, y).
// Ideal for RBAC permission inheritance, taint tracking, and compiler dataflow.
func PropagateBits[NE usize, NV usize, T Equal](
	edges const *Binary[NE, T, T],
	perms *LatticeMap[NV, T, u64],
) u32 {
	var rounds u32 = 1
	for step := usize(0); step < NV; step++ {
		changed := false
		for i := usize(0); i < edges.n; i++ {
			e := edges.data[i]
			if mask, ok := perms.Get(e.a); ok {
				if JoinBitOr[NV, T](perms, e.b, mask) {
					changed = true
				}
			}
		}
		if !changed {
			break
		}
		rounds++
	}
	return rounds
}
