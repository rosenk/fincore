// calc: an integer calculator with variables. Each line is parsed into an
// AST, printed back fully parenthesized and evaluated with checked
// arithmetic.
//
//	finc0 run examples/calc.fc                   # the built-in script
//	finc0 run examples/calc.fc -- '(1 + 2) * 3'  # one expression
//
// Shows: sum types for the AST, errors and results; an arena where nodes
// refer to each other by u32 IDs (no pointers, no allocation); mutual
// recursion proven total with decreases(depth), so hostile input cannot
// overflow the stack; Format methods for %v.
package main

const (
	MaxNodes = 256 // per line
	MaxDepth = 80  // nesting limit of the parser and the evaluator
	MaxI64   = i64(9223372036854775807)
	MinI64   = -MaxI64 - 1
)

const Script = "1 + 2 * 3\n(1 + 2) * 3\nx = 6 * 7\n--x / 2 - -1\n" +
	"y = x % 5 - 3\nx / (y + 1)\nx * 1000000000 * 1000000000\nz + 1\n" +
	"1 + (2 * 3\n((((((((((((((((((((((((((((((((((1))))))))))))))))))))))))))))))))))\n"

type NodeID u32

type Op enum { Add; Sub; Mul; Div; Mod }

func (o Op) Format(dst []byte) usize {
	return formatTo(dst, "%c", match o {
		Add -> '+'
		Sub -> '-'
		Mul -> '*'
		Div -> '/'
		Mod -> '%'
	})
}

type Node enum {
	Num(i64)
	Var(u8) // 'a'..'z'
	Neg(NodeID)
	Bin(Op, NodeID, NodeID)
}

type CalcErr enum {
	Syntax(u32, u8) // offset, expected byte (0: anything else)
	DivZero(u32)    // offset of the operator
	Overflow(u32)
	Unbound(u8)
	TooDeep
	TooBig
}

func (e CalcErr) Format(dst []byte) usize {
	match e {
		Syntax(at, c) -> {
			if c == 0 {
				return formatTo(dst, "syntax error at column %d", at+1)
			}
			return formatTo(dst, "expected '%c' at column %d", c, at+1)
		}
		DivZero(at) -> return formatTo(dst, "division by zero at column %d", at+1)
		Overflow(at) -> return formatTo(dst, "overflow at column %d", at+1)
		Unbound(v) -> return formatTo(dst, "variable %c is not set", v)
		TooDeep -> return formatTo(dst, "nested deeper than %d", MaxDepth)
		TooBig -> return formatTo(dst, "more than %d nodes", MaxNodes)
	}
}

func isArithErr(e CalcErr) bool {
	return match e {
		DivZero(_) | Overflow(_) -> true
		_ -> false
	}
}

type Result enum { Ok(i64); Err(CalcErr) }

// The arena. Node 0 is never used, so NodeID 0 means "none".
var nodes [MaxNodes]Node
var nodeAt [MaxNodes]u32 // source offset of each node, for messages
var nnodes usize = 1
var vars [26]i64
var isSet [26]bool

func newNode(n Node, at u32) NodeID {
	if nnodes >= MaxNodes {
		return 0
	}
	nodes[nnodes] = n
	nodeAt[nnodes] = at
	nnodes++
	return NodeID(nnodes - 1)
}

// ---- parser: binary, unary and primary form one recursive SCC ----

type Parser struct {
	src    []byte
	pos    usize
	err    CalcErr
	failed bool
}

func (p *Parser) fail(e CalcErr) NodeID {
	if !p.failed {
		p.err, p.failed = e, true
	}
	return 0
}

func (p *Parser) node(n Node, at usize) NodeID {
	if id := newNode(n, u32(at)); id != 0 {
		return id
	}
	return p.fail(CalcErr.TooBig)
}

// peek skips blanks and returns the next byte (0 at the end).
func (p *Parser) peek() u8 {
	n := len(p.src)
	for i := p.pos; i < n; i++ { // T1: i counts up to a local bound
		if p.src[i] != ' ' {
			return p.src[i]
		}
		p.pos = i + 1
	}
	return 0
}

func opOf(level u8, c u8) (Op, bool) {
	if level == 0 {
		match c {
			'+' -> return Op.Add, true
			'-' -> return Op.Sub, true
		}
	} else if level == 1 {
		match c {
			'*' -> return Op.Mul, true
			'/' -> return Op.Div, true
			'%' -> return Op.Mod, true
		}
	}
	return Op.Add, false
}

// binary parses level 0 (+ -) and 1 (* / %), left-associative; level 2
// is a unary operand.
func (p *Parser) binary(level u8, depth usize) NodeID decreases(depth) {
	if depth == 0 {
		return p.fail(CalcErr.TooDeep)
	}
	if level == 2 {
		return p.unary(depth - 1)
	}
	l := p.binary(level+1, depth-1)
	lim := len(p.src)
	for k := usize(0); k < lim; k++ {
		op, ok := opOf(level, p.peek())
		if p.failed || !ok {
			break
		}
		at := p.pos
		p.pos++
		l = p.node(Node.Bin(op, l, p.binary(level+1, depth-1)), at)
	}
	return l
}

func (p *Parser) unary(depth usize) NodeID decreases(depth) {
	if depth == 0 {
		return p.fail(CalcErr.TooDeep)
	}
	at := p.pos
	c := p.peek()
	if c == '-' {
		p.pos++
		return p.node(Node.Neg(p.unary(depth-1)), at)
	}
	if c == '(' {
		p.pos++
		e := p.binary(0, depth-1)
		if p.peek() != ')' {
			return p.fail(CalcErr.Syntax(u32(p.pos), ')'))
		}
		p.pos++
		return e
	}
	if c >= 'a' && c <= 'z' {
		p.pos++
		return p.node(Node.Var(c), at)
	}
	v := i64(0)
	n := len(p.src)
	start := p.pos
	for i := start; i < n; i++ {
		if p.src[i] < '0' || p.src[i] > '9' {
			break
		}
		d := i64(p.src[i] - '0')
		if v > (MaxI64-d)/10 {
			return p.fail(CalcErr.Overflow(u32(start)))
		}
		v, p.pos = v*10+d, i+1
	}
	if p.pos == start {
		return p.fail(CalcErr.Syntax(u32(start), 0))
	}
	return p.node(Node.Num(v), at)
}

// ---- checked arithmetic ----

func apply(op Op, x i64, y i64, at u32) Result {
	match op {
		Add -> {
			if y > 0 && x > MaxI64-y || y < 0 && x < MinI64-y {
				return Result.Err(CalcErr.Overflow(at))
			}
			return Result.Ok(x + y)
		}
		Sub -> {
			if y < 0 && x > MaxI64+y || y > 0 && x < MinI64+y {
				return Result.Err(CalcErr.Overflow(at))
			}
			return Result.Ok(x - y)
		}
		Mul -> {
			if x != 0 && (x*y/x != y || x == -1 && y == MinI64) {
				return Result.Err(CalcErr.Overflow(at))
			}
			return Result.Ok(x * y)
		}
		Div -> {
			if y == 0 {
				return Result.Err(CalcErr.DivZero(at))
			}
			if x == MinI64 && y == -1 {
				return Result.Err(CalcErr.Overflow(at))
			}
			return Result.Ok(x / y)
		}
		Mod -> {
			if y == 0 {
				return Result.Err(CalcErr.DivZero(at))
			}
			if x == MinI64 && y == -1 {
				return Result.Err(CalcErr.Overflow(at))
			}
			return Result.Ok(x % y)
		}
	}
}

func eval(id NodeID, depth usize) Result decreases(depth) {
	if depth == 0 {
		return Result.Err(CalcErr.TooDeep)
	}
	match nodes[id] {
		Num(v) -> return Result.Ok(v)
		Var(c) -> {
			if isSet[c-'a'] {
				return Result.Ok(vars[c-'a'])
			}
			return Result.Err(CalcErr.Unbound(c))
		}
		Neg(x) -> {
			match eval(x, depth-1) {
				Ok(v) -> return apply(Op.Sub, 0, v, nodeAt[id])
				Err(e) -> return Result.Err(e)
			}
		}
		Bin(op, l, r) -> {
			match eval(l, depth-1) {
				Err(e) -> return Result.Err(e)
				Ok(x) -> {
					match eval(r, depth-1) {
						Err(e) -> return Result.Err(e)
						Ok(y) -> return apply(op, x, y, nodeAt[id])
					}
				}
			}
		}
	}
}

// show prints a tree fully parenthesized; formatTo truncates at len(dst).
func show(dst []byte, id NodeID, depth usize) usize decreases(depth) {
	if depth == 0 {
		return 0
	}
	match nodes[id] {
		Num(v) -> return formatTo(dst, "%d", v)
		Var(c) -> return formatTo(dst, "%c", c)
		Neg(x) -> {
			k := formatTo(dst, "-")
			return k + show(dst[k:], x, depth-1)
		}
		Bin(op, l, r) -> {
			k := formatTo(dst, "(")
			k += show(dst[k:], l, depth-1)
			k += formatTo(dst[k:], " %v ", op)
			k += show(dst[k:], r, depth-1)
			return k + formatTo(dst[k:], ")")
		}
	}
}

// run handles one line, "[letter =] expr", and formats the answer.
func run(line []byte, out []byte) usize {
	nnodes = 1
	p := Parser{src: line}
	target := u8(0)
	if len(line) > 2 && line[0] >= 'a' && line[0] <= 'z' && line[1] == ' ' && line[2] == '=' {
		target, p.pos = line[0], 3
	}
	root := p.binary(0, MaxDepth)
	if p.peek() != 0 {
		p.fail(CalcErr.Syntax(u32(p.pos), 0))
	}
	k := formatTo(out, "%-28s ", line)
	if p.failed {
		return k + formatTo(out[k:], "error: %v\n", p.err)
	}
	k += formatTo(out[k:], "=> ")
	k += show(out[k:], root, MaxDepth)
	match eval(root, MaxDepth) {
		Ok(v) -> {
			if target != 0 {
				vars[target-'a'], isSet[target-'a'] = v, true
			}
			k += formatTo(out[k:], " = %d\n", v)
		}
		Err(e) -> {
			if isArithErr(e) {
				k += formatTo(out[k:], " = arithmetic error: %v\n", e)
			} else {
				k += formatTo(out[k:], " = error: %v\n", e)
			}
		}
	}
	return k
}

driver func main(env Env, io Stdio) error {
	var out [512]byte
	if env.ArgsCount() > 1 {
		return io.WriteStdout(out[:run(strBytes(env.Arg(1)), out[:])])
	}
	script := strBytes(Script)
	start := usize(0)
	for i := usize(0); i < len(script); i++ {
		if script[i] == '\n' {
			if err := io.WriteStdout(out[:run(script[start:i], out[:])]); err != nil {
				return err
			}
			start = i + 1
		}
	}
	return nil
}
