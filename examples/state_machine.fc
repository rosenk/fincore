// state_machine: the server side of an SMTP session as an explicit state
// machine, replayed over a recorded transcript.
//
//	finc0 run examples/state_machine.fc
//
// Shows: enums with payloads as states, exhaustive match over states,
// bounded counters (MaxRcpt) instead of growing lists, and a Format method
// that makes a State printable with %v.
package main

import "std/bytes"

const MaxRcpt = 3

type State enum {
	Connected     // waiting for HELO
	Greeted       // HELO done, no transaction
	Mail          // MAIL FROM accepted
	Rcpt(u8)      // recipients accepted so far
	Data(u8, u32) // reading the body: recipients, body lines
	Closed
}

func (s State) Format(dst []byte) usize {
	return match s {
		Connected -> formatTo(dst, "Connected")
		Greeted -> formatTo(dst, "Greeted")
		Mail -> formatTo(dst, "Mail")
		Rcpt(n) -> formatTo(dst, "Rcpt(%d)", n)
		Data(n, l) -> formatTo(dst, "Data(%d, %d)", n, l)
		Closed -> formatTo(dst, "Closed")
	}
}

type Cmd enum {
	Helo
	MailFrom
	RcptTo
	DataCmd
	Rset
	Quit
	Line // a body line (only while in Data)
	Dot  // "." ends the body
	Bad
}

type Reply struct {
	code u16 // 0: no reply (body lines)
	text string
}

func inData(s State) bool {
	return match s {
		Data(_, _) -> true
		_ -> false
	}
}

// parse classifies a line. In the Data state every line except "." is
// body text, even one that reads "QUIT".
func parse(s State, line []byte) Cmd {
	if inData(s) {
		if bytesEqual(line, ".") {
			return Cmd.Dot
		}
		return Cmd.Line
	}
	if bytes.HasPrefix(line, "HELO ") || bytes.HasPrefix(line, "EHLO ") {
		return Cmd.Helo
	}
	if bytes.HasPrefix(line, "MAIL FROM:") {
		return Cmd.MailFrom
	}
	if bytes.HasPrefix(line, "RCPT TO:") {
		return Cmd.RcptTo
	}
	if bytesEqual(line, "DATA") {
		return Cmd.DataCmd
	}
	if bytesEqual(line, "RSET") {
		return Cmd.Rset
	}
	if bytesEqual(line, "QUIT") {
		return Cmd.Quit
	}
	return Cmd.Bad
}

// step is the protocol: exhaustive over every State.
func step(s State, c Cmd) (State, Reply) {
	match s {
		Closed -> return s, Reply{code: 421, text: "closing"}
		Data(n, l) -> {
			match c {
				Line -> return State.Data(n, l+1), Reply{}
				Dot -> return State.Greeted, Reply{code: 250, text: "message queued"}
				_ -> return s, Reply{code: 451, text: "internal error"}
			}
		}
		Connected -> {
			match c {
				Helo -> return State.Greeted, Reply{code: 250, text: "hello"}
				Quit -> return State.Closed, Reply{code: 221, text: "bye"}
				_ -> return s, Reply{code: 503, text: "say HELO first"}
			}
		}
		Greeted -> {
			match c {
				Helo -> return State.Greeted, Reply{code: 250, text: "hello"}
				MailFrom -> return State.Mail, Reply{code: 250, text: "sender ok"}
				Rset -> return State.Greeted, Reply{code: 250, text: "reset"}
				Quit -> return State.Closed, Reply{code: 221, text: "bye"}
				_ -> return s, Reply{code: 503, text: "need MAIL FROM"}
			}
		}
		Mail -> {
			match c {
				RcptTo -> return State.Rcpt(1), Reply{code: 250, text: "recipient ok"}
				Rset -> return State.Greeted, Reply{code: 250, text: "reset"}
				Quit -> return State.Closed, Reply{code: 221, text: "bye"}
				_ -> return s, Reply{code: 503, text: "need RCPT TO"}
			}
		}
		Rcpt(n) -> {
			match c {
				RcptTo -> {
					if n < MaxRcpt {
						return State.Rcpt(n + 1), Reply{code: 250, text: "recipient ok"}
					}
					return s, Reply{code: 452, text: "too many recipients"}
				}
				DataCmd -> return State.Data(n, 0), Reply{code: 354, text: "end data with ."}
				Rset -> return State.Greeted, Reply{code: 250, text: "reset"}
				Quit -> return State.Closed, Reply{code: 221, text: "bye"}
				_ -> return s, Reply{code: 503, text: "need DATA"}
			}
		}
	}
}

const Transcript = "MAIL FROM:<ann@example.org>\n" +
	"HELO client.example.org\n" +
	"MAIL FROM:<ann@example.org>\n" +
	"DATA\n" +
	"RCPT TO:<bob@example.org>\n" +
	"RCPT TO:<cy@example.org>\n" +
	"RCPT TO:<di@example.org>\n" +
	"RCPT TO:<ed@example.org>\n" +
	"DATA\n" +
	"Subject: lunch\n" +
	"\n" +
	"QUIT is not a command in here.\n" +
	".\n" +
	"MAIL FROM:<bob@example.org>\n" +
	"RSET\n" +
	"QUIT\n" +
	"NOOP\n"

driver func main(io Stdio) error {
	var line [160]byte
	s := State.Connected
	script := strBytes(Transcript)
	start := usize(0)
	for i := usize(0); i < len(script); i++ {
		if script[i] != '\n' {
			continue
		}
		text := script[start:i]
		start = i + 1
		next, r := step(s, parse(s, text))
		k := formatTo(line[:], "C: %-30s %-12v -> %v\n", text, s, next)
		if r.code != 0 {
			k = formatTo(line[:], "C: %-30s %-12v -> %-12v S: %d %s\n", text, s, next, r.code, r.text)
		}
		if err := io.WriteStdout(line[:k]); err != nil {
			return err
		}
		s = next
	}
	return nil
}
