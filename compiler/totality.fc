// SINCE: v0.3
// totality.fc — the Layer-2 effect and totality checker, part 1 (port of
// finc0's bootstrap/internal/totality: totality.go, invariant.go,
// loops.go; the accepted shapes are documented in totality/doc.go).
//
// totalityProgram runs after the type checker (and the scope pass) on a
// well-typed program and reports E5001 (effect containment), E4002
// (unproven termination of a loop or direct recursion) and E4004 (mutually
// recursive group without a decreasing measure). It only reads the typed
// model (README, "Semantic model").
//
// Data layout:
//   - tord/tpos/tend/tlit: a pre-order index of every package file, built
//     once. The subtree of node n is tord[tpos[n]:tend[n]], so finc0's
//     ast.Inspect walks become flat loops; tlit[n] is the innermost FuncLit
//     strictly enclosing n (inspectBody of a function = the nodes of its
//     body with tlit == its literal, 0 for declarations).
//   - rootFacts (addressed variables, variables written by function
//     literals) are per-symbol flags computed in one pass over the whole
//     program: a local symbol is only visible inside its own root function,
//     so the per-root maps of finc0 collapse into one table.
//   - Loop rules return a reason code (totWhy, with totWhySym for the
//     variable named in the message); the message is rendered when the
//     diagnostic is reported.
//
// The flow analysis (abstract states, T2/T3 walks, bounds) is in
// totality_flow.fc, the recursion check (call graph, iterative Tarjan,
// measures) in totality_rec.fc.
package main

const (
	TotMaxAtoms   = 65_536  // atoms of one loop-invariance query
	TotMaxScratch = 262_144 // path/type lists of those atoms
)

// ---------------------------------------------------------------------------
// Pre-order index of the program

var tord [MaxNodes]u32 // nodes in pre-order (ast.Inspect order)
var tpos [MaxNodes]u32 // position of a node in tord
var tend [MaxNodes]u32 // end (exclusive) of a node's subtree in tord
var tlit [MaxNodes]u32 // innermost FuncLit strictly enclosing a node
var ntord usize

// tindex appends the subtree of n to tord (lit: the enclosing literal).
func tindex(n u32, lit u32, dp usize) decreases(dp) {
	if dp == 0 {
		tooDeep()
		return
	}
	if n == 0 {
		return
	}
	if ntord >= MaxNodes {
		setFull("totality index")
		return
	}
	tpos[usize(n)] = u32(ntord)
	tord[ntord] = n
	tlit[usize(n)] = lit
	ntord++
	inner := lit
	k := nkind(n)
	if k == NkFuncLit {
		inner = n
	}
	for i := usize(0); i < MaxSlots; i++ {
		slot, _ := layout(k, i)
		if slot == SlotNone {
			break
		}
		if slot >= SlotL1 {
			st, cnt := slotList(nodes.items[usize(n)], slot)
			m := usize(cnt)
			for j := usize(0); j < m; j++ {
				tindex(listAt(st, j), inner, dp-1)
			}
		} else {
			tindex(slotChild(nodes.items[usize(n)], slot), inner, dp-1)
		}
	}
	tend[usize(n)] = u32(ntord)
}

func buildTotIndex() {
	ntord = 0
	np := pkgs.norder
	for i := usize(0); i < np; i++ {
		p := usize(pkgs.order[i])
		f0 := pkgs.items[p].f0
		f1 := pkgs.items[p].f1
		for f := f0; f < f1; f++ {
			if sources.files[f].ok && sources.files[f].root != 0 {
				tindex(sources.files[f].root, 0, WalkDepth)
			}
		}
	}
}

// ---------------------------------------------------------------------------
// Diagnostics state

// Reason codes of unproven loops (rendered by LoopWhy).
const (
	WhyNone         = 0
	WhyNoPost       = 1
	WhyPostForm     = 2
	WhyStep         = 3
	WhyPostCounter  = 4
	WhyCtrNotInt    = 5
	WhyInitDeclCtr  = 6
	WhyInitAsgCtr   = 7
	WhyInitCtr      = 8
	WhyCtrUnstable  = 9
	WhyCondCompare  = 10
	WhyCondCtr      = 11
	WhyUpCond       = 12
	WhyDownCond     = 13
	WhyWrap         = 14
	WhyCtrModified  = 15
	WhyBoundVariant = 16
	WhyNoCond       = 17

	WhyShrinkPost    = 20
	WhyInitDeclSlice = 21
	WhyInitAsgSlice  = 22
	WhyInitSlice     = 23
	WhySliceUnstable = 24
	WhySliceModified = 25
	WhyNotShortened  = 26
	WhyLenMeasure    = 30
	WhyMeasureForm   = 31
	WhyMeasureVar    = 32
	WhyMeasureNonNeg = 33
	WhyMeasureUnsign = 34
	WhyNoDecrease    = 35
)

var totWhySym u32

// LoopWhy renders the reason of an unproven loop; sym is the loop's
// counter, slice or measure variable.
type LoopWhy struct {
	why u32
	sym u32
}

func (w LoopWhy) Format(dst []byte) usize {
	why := w.why
	v := NameRef(symName(w.sym))
	return match why {
		WhyNoPost -> formatTo(dst, "not a counting loop (no post statement), slice-shrink loop, or loop with decreases clause")
		WhyPostForm -> formatTo(dst, "post statement must be i++, i--, i += c or i -= c")
		WhyStep -> formatTo(dst, "step of the counting loop must be a positive constant")
		WhyPostCounter -> formatTo(dst, "post statement must update a local counter variable")
		WhyCtrNotInt -> formatTo(dst, "loop counter %v is not an integer", v)
		WhyInitDeclCtr -> formatTo(dst, "init statement must declare only the counter")
		WhyInitAsgCtr -> formatTo(dst, "init statement must assign only the counter")
		WhyInitCtr -> formatTo(dst, "init statement must initialize the counter")
		WhyCtrUnstable -> formatTo(dst, "loop counter %v may be modified through a pointer or closure", v)
		WhyCondCompare -> formatTo(dst, "condition must compare the counter with a bound")
		WhyCondCtr -> formatTo(dst, "condition must compare the counter %v with a bound", v)
		WhyUpCond -> formatTo(dst, "a counter counting up needs a condition %v < bound", v)
		WhyDownCond -> formatTo(dst, "a counter counting down needs a condition %v > bound", v)
		WhyWrap -> formatTo(dst, "the counter may wrap around: use step 1 with a strict comparison, or a constant bound")
		WhyCtrModified -> formatTo(dst, "loop counter %v is modified in the loop body", v)
		WhyBoundVariant -> formatTo(dst, "loop bound is not invariant in the loop body")
		WhyNoCond -> formatTo(dst, "a loop without condition needs a decreases clause")
		WhyShrinkPost -> formatTo(dst, "a slice-shrink loop must not have a post statement")
		WhyInitDeclSlice -> formatTo(dst, "init statement must declare only the slice %v", v)
		WhyInitAsgSlice -> formatTo(dst, "init statement must assign only the slice %v", v)
		WhyInitSlice -> formatTo(dst, "init statement must initialize the slice %v", v)
		WhySliceUnstable -> formatTo(dst, "slice %v may be modified through a pointer or closure", v)
		WhySliceModified -> formatTo(dst, "slice %v is modified other than by %v = %v[k:]", v, v, v)
		WhyNotShortened -> formatTo(dst, "slice %v is not provably shortened on every path (need %v = %v[k:] with k > 0: a positive constant, or after `if k == 0 { return }`)", v, v, v)
		WhyLenMeasure -> formatTo(dst, "len(...) in the measure must be of an unmodified local slice")
		WhyMeasureForm -> formatTo(dst, "measure must be X or X - Y with X, Y local variables, constants or len(s)")
		WhyMeasureVar -> formatTo(dst, "measure variable %v may be modified through a pointer or closure", v)
		WhyMeasureNonNeg -> formatTo(dst, "the loop condition must imply that the measure is non-negative (e.g. lo < hi for hi - lo)")
		WhyMeasureUnsign -> formatTo(dst, "a single-variable measure must be unsigned")
		WhyNoDecrease -> formatTo(dst, "measure does not provably decrease on every path through the loop body")
		_ -> 0
	}
}

// ---------------------------------------------------------------------------
// Entry point (totality.Check)

func totalityProgram() {
	buildTotIndex()
	computeRootFacts()
	n := usize(funcs.orderN)
	for i := usize(0); i < n; i++ {
		fi := uat(funcs.orderS, i)
		checkEffects(fi)
		if funcs.items[usize(fi)].effect != EffComptime {
			checkLoops(fi)
		}
	}
	checkRecursion()
}

// fiNode returns FuncInfo.Node(): the FuncDecl or FuncLit node.
func fiNode(fi u32) u32 {
	if funcs.items[usize(fi)].decl != 0 {
		return funcs.items[usize(fi)].decl
	}
	return funcs.items[usize(fi)].lit
}

// ---------------------------------------------------------------------------
// E5001: effect containment (spec 6.1)

// modeName is "comptime" or "total" (the effect of a non-driver function).
func modeName(fi u32) string {
	if funcs.items[usize(fi)].effect == EffComptime {
		return "comptime"
	}
	return "total"
}

func checkEffects(fi u32) {
	f := funcs.items[usize(fi)]
	if f.effect == EffDriver || f.body == 0 {
		return
	}
	c := f.callH
	for g := usize(0); g < MaxCells; g++ {
		if c == 0 {
			break
		}
		call := cellVal(c)
		c = cellNext(c)
		ci := ncall[usize(call)]
		if ci == 0 || callTab.items[usize(ci)].effect != EffDriver {
			continue
		}
		errAt(E5001, call, formatTo(mbuf[:], "%s function %v calls driver %v", modeName(fi), FuncName(fi), CalleeName(call)))
	}
	b := f.body
	lit := f.lit
	s := usize(tpos[usize(b)])
	e := usize(tend[usize(b)])
	for p := s; p < e; p++ {
		n := tord[p]
		if tlit[usize(n)] != lit || nkind(n) != NkForStmt || !nflag(n) {
			continue
		}
		errAt(E5001, n, formatTo(mbuf[:], "driver for loop in %s function %v", modeName(fi), FuncName(fi)))
	}
}

// CalleeName renders the callee of a call in E5001 messages.
type CalleeName u32

func (call CalleeName) Format(dst []byte) usize {
	match callKind(u32(call)) {
		Func(s, ..) | Method(s, ..) if funcOfSym(s) != 0 -> return formatTo(dst, "function %v", FuncName(funcOfSym(s)))
		Builtin(BFPanic, ..) -> return formatTo(dst, "builtin panic")
		BuiltinMeth(m, ..) if m != 0 && meths.items[usize(m)].recv != 0 -> return formatTo(dst, "method %v.%v", NameRef(typeName(meths.items[usize(m)].recv)), NameRef(meths.items[usize(m)].name))
		Value -> return formatTo(dst, "function value")
		_ -> {}
	}
	fun := na(u32(call))
	if nkind(fun) == NkIdent {
		return formatTo(dst, "%s", ntext(fun))
	}
	return formatTo(dst, "function")
}

// ---------------------------------------------------------------------------
// Loops (T1, T2, T3 for loops, T4)

func checkLoops(fi u32) {
	f := funcs.items[usize(fi)]
	if f.body == 0 {
		return
	}
	lit := f.lit
	s := usize(tpos[usize(f.body)])
	e := usize(tend[usize(f.body)])
	for p := s; p < e; p++ {
		n := tord[p]
		if tlit[usize(n)] != lit || nkind(n) != NkForStmt || nflag(n) {
			// `driver for` is exempt (decision 8); in total functions it is
			// E5001 (checkEffects).
			continue
		}
		totWhySym = 0
		why := checkLoop(fi, n)
		if why != WhyNone {
			errAt(E4002, n, formatTo(mbuf[:], "cannot prove termination of for loop: %v", LoopWhy{why: why, sym: totWhySym}))
		}
	}
}

// checkLoop returns WhyNone if the loop is proven to terminate by T1, T2
// or T3, otherwise the reason of the most applicable rule.
func checkLoop(fi u32, f u32) u32 {
	totReset()
	if nd(f) != 0 {
		return loopT3(fi, f)
	}
	if nb(f) == 0 {
		return WhyNoCond
	}
	if isShrinkCond(nb(f)) != 0 {
		return loopT2(fi, f)
	}
	return loopT1(fi, f)
}

// ---------------------------------------------------------------------------
// Root facts: variables whose address is taken or that are written by
// function literals. Such variables may change behind the back of a
// syntactic analysis, so the loop and recursion rules never trust facts
// about them.

var symAddr [MaxSyms]bool
var symLitW [MaxSyms]bool

func computeRootFacts() {
	n := ntord
	for p := usize(0); p < n; p++ {
		x := tord[p]
		k := nkind(x)
		if k == NkUnaryExpr {
			if nop(x) == OpAddr {
				s := storageRoot(na(x))
				if s != 0 {
					symAddr[usize(s)] = true
				}
			}
		} else if k == NkSliceExpr {
			if isArrayT(underlying(ntype[usize(na(x))])) {
				s := storageRoot(na(x))
				if s != 0 {
					symAddr[usize(s)] = true
				}
			}
		} else if k == NkCallExpr {
			if callKind(x) is Method(_, _, r, true) | BuiltinMeth(_, r, true) {
				// x.M() with a pointer receiver takes &x (v0.2)
				s := storageRoot(r)
				if s != 0 {
					symAddr[usize(s)] = true
				}
			}
		} else if k == NkAssignStmt {
			lit := tlit[usize(x)]
			if lit != 0 {
				m := l1len(x)
				for i := usize(0); i < m; i++ {
					markLitWrite(l1at(x, i), lit)
				}
			}
		} else if k == NkIncDecStmt {
			lit := tlit[usize(x)]
			if lit != 0 {
				markLitWrite(na(x), lit)
			}
		}
	}
}

func markLitWrite(lhs u32, lit u32) {
	s := storageRoot(lhs)
	if s != 0 && syms.items[usize(s)].fn != lit {
		symLitW[usize(s)] = true
	}
}

// unstable reports whether facts about the variable s cannot be trusted.
func unstable(s u32) bool {
	return s == 0 || symAddr[usize(s)] || symLitW[usize(s)] || syms.items[usize(s)].varKind == VarGlobal
}

// storageRoot returns the variable whose own storage e denotes (a part
// of): x, x.f (no pointer indirection), x[i] for arrays, (x). It returns 0
// for expressions denoting heap storage (through pointers or slices).
func storageRoot(e u32) u32 {
	x := e
	for g := usize(0); g < MaxNodes; g++ {
		if x == 0 {
			return 0
		}
		k := nkind(x)
		if k == NkParenExpr {
			x = na(x)
			continue
		}
		if k == NkIdent {
			s := symbolOf(x)
			if s == 0 || symKind(s) != SymVar {
				return 0
			}
			return s
		}
		if k == NkSelectorExpr {
			si := nsel[usize(x)]
			if si == 0 || selTab.items[usize(si)].kind != SelField || selTab.items[usize(si)].indirect {
				return 0
			}
			x = na(x)
			continue
		}
		if k == NkIndexExpr {
			if !isArrayT(underlying(ntype[usize(na(x))])) || l1len(x) != 1 {
				return 0
			}
			x = na(x)
			continue
		}
		return 0
	}
	return 0
}

// ---------------------------------------------------------------------------
// Small helpers

// tkOf is tk of a possibly absent type.

func symTyp(s u32) u32 {
	return syms.items[usize(s)].typ
}

// constUint returns the value of a non-negative integer constant expression.
func constUint(e u32) (u64, bool) {
	if e == 0 {
		return 0, false
	}
	v := nval[usize(e)]
	if v == 0 {
		return 0, false
	}
	return valUint64(vals.items[usize(v)])
}

func isConstVal(e u32, v u64) bool {
	n, ok := constUint(e)
	return ok && n == v
}

func isZeroConst(e u32) bool {
	return isConstVal(e, 0)
}

// varOf returns the variable symbol of an identifier expression (after
// parentheses), or 0.
func varOf(e u32) u32 {
	id := unparen(e)
	if id == 0 || nkind(id) != NkIdent {
		return 0
	}
	s := symbolOf(id)
	if s == 0 || symKind(s) != SymVar {
		return 0
	}
	return s
}

// stripConv returns the operand of conversions T(x) that do not change
// the value (x already has type T), after parentheses.
func stripConv(e u32) u32 {
	x := e
	for g := usize(0); g < MaxNodes; g++ {
		x = unparen(x)
		if x == 0 || nkind(x) != NkCallExpr || l1len(x) != 1 {
			return x
		}
		if callKind(x) != CallKind.Conversion(ntype[usize(l1at(x, 0))]) {
			return x
		}
		x = l1at(x, 0)
	}
	return x
}

// lenArg returns x for len(x) (0 otherwise).
func lenArg(e u32) u32 {
	call := stripConv(e)
	if call == 0 || nkind(call) != NkCallExpr || l1len(call) != 1 || !(callKind(call) is Builtin(BFLen, ..)) {
		return 0
	}
	return l1at(call, 0)
}

func exprUnsigned(e u32) bool {
	return isUnsigned(ntype[usize(e)])
}

func negateOp(op u8) u8 {
	return match op {
		OpLt -> OpGe
		OpLe -> OpGt
		OpGt -> OpLe
		OpGe -> OpLt
		OpEq -> OpNe
		OpNe -> OpEq
		_ -> op
	}
}

func flipOp(op u8) u8 {
	return match op {
		OpLt -> OpGt
		OpLe -> OpGe
		OpGt -> OpLt
		OpGe -> OpLe
		_ -> op
	}
}

// ---------------------------------------------------------------------------
// Loop invariance of expressions (invariant.go): bounds of T1 loops, len(s)
// leaves of T3 measures. See finc0's invariant.go for the rules.

type TAtom struct {
	root  u32
	heap  bool
	pathS u32 // field names (NameIDs), outermost first, in atomPath
	pathN u32
	strS  u32 // struct types owning the fields on the path, in atomTypes
	strN  u32
	leafS u32 // field types on the path and the root's type, in atomTypes
	leafN u32
}

var atoms [TotMaxAtoms]TAtom
var natoms usize
var atomPath [TotMaxScratch]u32
var natomPath usize
var atomStr [TotMaxScratch]u32
var natomStr usize
var atomLeaf [TotMaxScratch]u32
var natomLeaf usize

func atomPush(buf u8, v u32) {
	if buf == 0 {
		if natomPath >= TotMaxScratch {
			setFull("totality atoms")
			return
		}
		atomPath[natomPath] = v
		natomPath++
	} else if buf == 1 {
		if natomStr >= TotMaxScratch {
			setFull("totality atoms")
			return
		}
		atomStr[natomStr] = v
		natomStr++
	} else {
		if natomLeaf >= TotMaxScratch {
			setFull("totality atoms")
			return
		}
		atomLeaf[natomLeaf] = v
		natomLeaf++
	}
}

// atomsOf decomposes an invariant-candidate expression into atoms. It
// returns false if e has a form that is never considered invariant.
func atomsOf(e u32, fnode u32, dp usize) bool decreases(dp) {
	if dp == 0 {
		tooDeep()
		return false
	}
	if e == 0 {
		return false
	}
	if nval[usize(e)] != 0 {
		return true
	}
	k := nkind(e)
	if k == NkParenExpr {
		return atomsOf(na(e), fnode, dp-1)
	}
	if k == NkBinaryExpr {
		op := nop(e)
		if op is OpAdd | OpSub | OpMul | OpDiv | OpRem | OpAnd | OpOr | OpXor | OpShl | OpShr {
			return atomsOf(na(e), fnode, dp-1) && atomsOf(nb(e), fnode, dp-1)
		}
		return false
	}
	if k == NkUnaryExpr {
		if nop(e) == OpNeg {
			return atomsOf(na(e), fnode, dp-1)
		}
		return false
	}
	if k == NkCallExpr {
		if l1len(e) == 1 && callKind(e) is Conversion(_) | Builtin(BFLen | BFCap, ..) {
			return atomsOf(l1at(e, 0), fnode, dp-1)
		}
		if callKind(e) is Builtin(BFMin | BFMax, ..) {
			// v0.3: min/max of invariant operands is invariant
			n := l1len(e)
			for i := usize(0); i < n; i++ {
				if !atomsOf(l1at(e, i), fnode, dp-1) {
					return false
				}
			}
			return true
		}
		return false
	}
	if k == NkIdent && symKind(symbolOf(e)) == SymTypeParam {
		// a const type parameter (`N` of `Vec[N usize, T any]`) is a
		// constant of every instance
		return true
	}
	if k is NkIdent | NkSelectorExpr {
		return pathAtom(e, fnode)
	}
	return false
}

// pathAtom appends the atom of an access path x.f.g (fields possibly
// through pointers) and reports whether e is one.
func pathAtom(e u32, fnode u32) bool {
	if natoms >= TotMaxAtoms {
		setFull("totality atoms")
		return false
	}
	var a TAtom
	a.pathS = u32(natomPath)
	a.strS = u32(natomStr)
	a.leafS = u32(natomLeaf)
	x := e
	ok := false
	for g := usize(0); g < MaxNodes; g++ {
		if x == 0 {
			break
		}
		k := nkind(x)
		if k == NkParenExpr {
			x = na(x)
			continue
		}
		if k == NkUnaryExpr {
			if nop(x) != OpDeref {
				break
			}
			a.heap = true
			x = na(x)
			continue
		}
		if k == NkSelectorExpr {
			ps := uses[usize(nb(x))]
			if ps != 0 {
				// pkg.Name: a package-level variable
				if symKind(ps) != SymVar {
					break
				}
				a.root = ps
				a.heap = true
				ok = true
				break
			}
			si := nsel[usize(x)]
			if si == 0 || selTab.items[usize(si)].kind != SelField {
				break
			}
			if selTab.items[usize(si)].indirect {
				a.heap = true
			}
			ct := selTab.items[usize(si)].ctype
			fx := usize(selTab.items[usize(si)].index)
			atomPush(0, fieldName(ct, fx))
			atomPush(2, fieldType(ct, fx))
			owner := ntype[usize(na(x))]
			if trec(underlying(owner)) is Pointer(pt) {
				owner = pt
			}
			atomPush(1, owner)
			x = na(x)
			continue
		}
		if k == NkIdent {
			s := symbolOf(x)
			if s == 0 || symKind(s) != SymVar {
				break
			}
			a.root = s
			atomPush(2, symTyp(s))
			if unstable(s) || syms.items[usize(s)].fn != fnode {
				a.heap = true
			}
			ok = true
		}
		break
	}
	if !ok {
		return false
	}
	a.pathN = u32(natomPath) - a.pathS
	a.strN = u32(natomStr) - a.strS
	a.leafN = u32(natomLeaf) - a.leafS
	// the path was collected leaf-side first
	ps := usize(a.pathS)
	pn := usize(a.pathN)
	for i := usize(0); i < pn/2; i++ {
		t := atomPath[ps+i]
		atomPath[ps+i] = atomPath[ps+pn-1-i]
		atomPath[ps+pn-1-i] = t
	}
	atoms[natoms] = a
	natoms++
	return true
}

// invariant reports whether e is unchanged by executing the subtrees n1
// and n2 (loop body and post statement; 0 = none).
func invariant(e u32, fnode u32, n1 u32, n2 u32) bool {
	natoms = 0
	natomPath = 0
	natomStr = 0
	natomLeaf = 0
	if !atomsOf(e, fnode, SemaDepth) {
		return false
	}
	cnt := natoms
	for ai := usize(0); ai < cnt; ai++ {
		if subtreeConflicts(n1, ai) || subtreeConflicts(n2, ai) {
			return false
		}
	}
	return true
}

// subtreeConflicts reports whether a write or (for heap atoms) a call in
// the subtree of n (function literals included) may change atom ai.
func subtreeConflicts(n u32, ai usize) bool {
	if n == 0 {
		return false
	}
	heap := atoms[ai].heap
	s := usize(tpos[usize(n)])
	e := usize(tend[usize(n)])
	for p := s; p < e; p++ {
		x := tord[p]
		k := nkind(x)
		if k == NkAssignStmt {
			m := l1len(x)
			for i := usize(0); i < m; i++ {
				if writeConflicts(l1at(x, i), ai) {
					return true
				}
			}
		} else if k == NkIncDecStmt {
			if writeConflicts(na(x), ai) {
				return true
			}
		} else if k == NkShortVarDecl {
			m := l1len(x)
			for i := usize(0); i < m; i++ {
				if writeConflicts(l1at(x, i), ai) {
					return true
				}
			}
		} else if k == NkCallExpr && heap {
			if callConflicts(x, ai) {
				return true
			}
		}
	}
	return false
}

// localPath scratch: the storage path of an assignment target.
var lpath [TotMaxScratch]u32
var nlpath usize

// localPath returns the root variable of an assignment target whose
// storage is part of a variable's own storage, with its field path in
// lpath[0:nlpath] (outermost first); 0 for heap writes.
func localPath(lhs u32) u32 {
	nlpath = 0
	x := lhs
	for g := usize(0); g < MaxNodes; g++ {
		if x == 0 {
			return 0
		}
		k := nkind(x)
		if k == NkParenExpr {
			x = na(x)
			continue
		}
		if k == NkIdent {
			s := symbolOf(x)
			if s == 0 || symKind(s) != SymVar {
				return 0
			}
			n := nlpath
			for i := usize(0); i < n/2; i++ {
				t := lpath[i]
				lpath[i] = lpath[n-1-i]
				lpath[n-1-i] = t
			}
			return s
		}
		if k == NkSelectorExpr {
			si := nsel[usize(x)]
			if si == 0 || selTab.items[usize(si)].kind != SelField || selTab.items[usize(si)].indirect {
				return 0
			}
			if nlpath >= TotMaxScratch {
				setFull("totality paths")
				return 0
			}
			lpath[nlpath] = fieldName(selTab.items[usize(si)].ctype, usize(selTab.items[usize(si)].index))
			nlpath++
			x = na(x)
			continue
		}
		if k == NkIndexExpr {
			if !isArrayT(underlying(ntype[usize(na(x))])) {
				return 0
			}
			nlpath = 0 // a write to an element is a (partial) write of the array
			x = na(x)
			continue
		}
		return 0
	}
	return 0
}

func writeConflicts(w u32, ai usize) bool {
	root := localPath(w)
	if root != 0 && root == atoms[ai].root {
		// prefixRelated(path, a.path)
		ps := usize(atoms[ai].pathS)
		pn := usize(atoms[ai].pathN)
		m := min(nlpath, pn)
		rel := true
		for i := usize(0); i < m; i++ {
			if lpath[i] != atomPath[ps+i] {
				rel = false
				break
			}
		}
		if rel {
			return true
		}
	}
	if !atoms[ai].heap {
		return false
	}
	return heapWriteConflicts(unparen(w), ai)
}

func atomPathHas(ai usize, name u32) bool {
	ps := usize(atoms[ai].pathS)
	pn := usize(atoms[ai].pathN)
	for i := usize(0); i < pn; i++ {
		if atomPath[ps+i] == name {
			return true
		}
	}
	return false
}

func heapWriteConflicts(w0 u32, ai usize) bool {
	w := w0
	for g := usize(0); g < MaxNodes; g++ {
		if w == 0 {
			return true
		}
		k := nkind(w)
		if k == NkIdent {
			s := symbolOf(w)
			if s == 0 {
				return false
			}
			return containsAnyStr(symTyp(s), ai)
		}
		if k == NkSelectorExpr {
			si := nsel[usize(w)]
			if si == 0 || selTab.items[usize(si)].kind != SelField {
				return true
			}
			ct := selTab.items[usize(si)].ctype
			fx := usize(selTab.items[usize(si)].index)
			return atomPathHas(ai, fieldName(ct, fx)) || containsAnyStr(fieldType(ct, fx), ai)
		}
		if k == NkIndexExpr {
			match trec(underlying(ntype[usize(na(w))])) {
				Slice(el) -> return containsAnyStr(el, ai)
				Array(el, ..) -> {
					if containsAnyStr(el, ai) {
						return true
					}
					w = unparen(na(w))
					continue
				}
				_ -> return true
			}
		}
		if k == NkUnaryExpr {
			if nop(w) == OpDeref && trec(underlying(ntype[usize(na(w))])) is Pointer(el) {
				return containsAnyStr(el, ai) || containsAnyLeaf(el, ai)
			}
			return true
		}
		return true
	}
	return true
}

func callConflicts(call u32, ai usize) bool {
	match callKind(call) {
		Conversion(_) | Variant(..) -> return false
		Builtin(BFFormatTo, ok, fs, fn) -> {
			// writes dst (argument 0); a %v Format method is a user call
			if !ok || l1len(call) == 0 {
				return true
			}
			for a := usize(0); a < usize(fn)/2; a++ {
				if fmtArgOp(fs, a) == FmtFormat {
					return true
				}
			}
			if trec(underlying(ntype[usize(l1at(call, 0))])) is Slice(el) {
				return containsAnyStr(el, ai)
			}
			return true
		}
		Builtin(b, ..) if b is BFCopy | BFFormatUint -> {
			n := l1len(call)
			if n == 0 {
				return true
			}
			dst := ntype[usize(l1at(call, n-1))]
			if b == BFCopy {
				dst = ntype[usize(l1at(call, 0))]
			}
			if trec(underlying(dst)) is Slice(el) {
				return containsAnyStr(el, ai)
			}
			return true
		}
		Builtin(..) -> return false
		Invalid | Func(..) | Method(..) | BuiltinMeth(..) | Value -> return true
	}
}

// containsAnyStr / containsAnyLeaf: containsAny(t, a.structs / a.leafs).
func containsAnyStr(t u32, ai usize) bool {
	s := usize(atoms[ai].strS)
	n := usize(atoms[ai].strN)
	for i := usize(0); i < n; i++ {
		if containsType(t, atomStr[s+i], 65) {
			return true
		}
	}
	return false
}

func containsAnyLeaf(t u32, ai usize) bool {
	s := usize(atoms[ai].leafS)
	n := usize(atoms[ai].leafN)
	for i := usize(0); i < n; i++ {
		if containsType(t, atomLeaf[s+i], 65) {
			return true
		}
	}
	return false
}

// containsType reports whether a value of type t may contain (by value) a
// value of type s. dp = 65 - finc0's depth (depth > 64 means "yes").
func containsType(t u32, s u32, dp usize) bool decreases(dp) {
	if dp == 0 || t == 0 || s == 0 {
		return true
	}
	if t == s {
		return true
	}
	u := underlying(t)
	match trec(u) {
		Struct(..) -> {
			n := nfields(u)
			for i := usize(0); i < n; i++ {
				if containsType(fieldType(u, i), s, dp-1) {
					return true
				}
			}
			return false
		}
		Array(e, ..) -> return containsType(e, s, dp-1)
		Enum(..) -> {
			nv := nvariants(u)
			for i := usize(0); i < nv; i++ {
				np := variantPayN(u, i)
				for j := usize(0); j < np; j++ {
					if containsType(variantPay(u, i, j), s, dp-1) {
						return true
					}
				}
			}
			return false
		}
		TypeParam(..) -> return true
		NoType | Basic(_) | Sig(..) | Named(_) | Slice(_) | Pointer(_) | Code(_) | ConstArg(_) | Tuple(..) | Opaque(..) -> return false
	}
}

// ---------------------------------------------------------------------------
// T1: counting loops

// Signed magnitude of an integer constant within [-2^64+1, 2^64-1].
func constSigned(e u32) (bool, u64, bool) {
	if e == 0 {
		return false, 0, false
	}
	v := nval[usize(e)]
	if v == 0 {
		return false, 0, false
	}
	match slotGet(v) {
		Int(0, lo) -> return false, lo, true
		Int(18446744073709551615, lo) if lo != 0 -> return true, 18446744073709551615 - lo + 1, true
		_ -> return false, 0, false
	}
}

func loopT1(fi u32, f u32) u32 {
	fnode := fiNode(fi)
	post := nc(f)
	if post == 0 {
		return WhyNoPost
	}
	// counter and step from the post statement
	ctr := u32(0)
	step := u64(0)
	up := false
	pk := nkind(post)
	if pk == NkIncDecStmt {
		ctr = varOf(na(post))
		step = 1
		up = nflag(post)
	} else if pk == NkAssignStmt {
		if l1len(post) != 1 || l2len(post) != 1 || !(nop(post) is AsgAdd | AsgSub) {
			return WhyPostForm
		}
		ctr = varOf(l1at(post, 0))
		up = nop(post) == AsgAdd
		k, ok := constUint(l2at(post, 0))
		if !ok || k == 0 {
			return WhyStep
		}
		step = k
	} else {
		return WhyPostForm
	}
	if ctr == 0 {
		return WhyPostCounter
	}
	totWhySym = ctr
	bits, signed, isInt := intInfo(symTyp(ctr))
	if !isInt {
		return WhyCtrNotInt
	}
	init := na(f)
	if init != 0 {
		ik := nkind(init)
		if ik == NkShortVarDecl {
			if l1len(init) != 1 || symbolOf(l1at(init, 0)) != ctr {
				return WhyInitDeclCtr
			}
		} else if ik == NkAssignStmt {
			if l1len(init) != 1 || varOf(l1at(init, 0)) != ctr || nop(init) != AsgAssign {
				return WhyInitAsgCtr
			}
		} else {
			return WhyInitCtr
		}
	}
	if unstable(ctr) || syms.items[usize(ctr)].fn != fnode {
		return WhyCtrUnstable
	}
	// condition: i < B / B > i / i <= B (counting up), mirrored down
	cmp := unparen(nb(f))
	if cmp == 0 || nkind(cmp) != NkBinaryExpr || !isCompareOp(nop(cmp)) {
		return WhyCondCompare
	}
	op := nop(cmp)
	bnd := nb(cmp)
	if varOf(na(cmp)) != ctr {
		if varOf(nb(cmp)) != ctr {
			return WhyCondCtr
		}
		op = flipOp(nop(cmp))
		bnd = na(cmp)
	}
	strictOp := u8(OpLt)
	nonStrictOp := u8(OpLe)
	if !up {
		strictOp = OpGt
		nonStrictOp = OpGe
	}
	if op != strictOp && op != nonStrictOp {
		if up {
			return WhyUpCond
		}
		return WhyDownCond
	}
	// overflow: the step must not wrap past the bound
	if op == nonStrictOp || step > 1 {
		safe := false
		neg, mag, isConst := constSigned(bnd)
		if isConst {
			lim := step
			if op == strictOp {
				lim = lim - 1
			}
			// half = 2^(bits-1); maxV = 2^bits - 1 (unsigned) or half - 1
			half := u64(1) << u64(bits-1)
			if up {
				if signed {
					// B + lim <= half - 1
					if neg {
						safe = mag > 18446744073709551615-(half-1) || lim <= half-1+mag
					} else {
						safe = mag <= half-1 && lim <= half-1-mag
					}
				} else {
					maxV := half - 1 + half
					if neg {
						safe = mag > 18446744073709551615-maxV || lim <= maxV+mag
					} else {
						safe = mag <= maxV && lim <= maxV-mag
					}
				}
			} else {
				if signed {
					// B - lim >= -half
					if neg {
						safe = mag <= half && lim <= half-mag
					} else {
						safe = mag > 18446744073709551615-half || lim <= mag+half
					}
				} else {
					safe = !neg && lim <= mag
				}
			}
		} else if up && op == strictOp && !signed && bits == 64 && lenArg(bnd) != 0 && step < u64(1)<<62 {
			// len(x) <= MaxInt64, so i + step cannot wrap a 64-bit unsigned counter
			safe = true
		}
		if !safe {
			return WhyWrap
		}
	}
	// the counter is not modified in the body
	if writesRoot(ctr, ne(f)) {
		return WhyCtrModified
	}
	if !invariant(bnd, fnode, ne(f), post) {
		return WhyBoundVariant
	}
	return WhyNone
}

// writesRoot reports whether any assignment in the subtree of n (function
// literals included) writes the storage of s.
func writesRoot(s u32, n u32) bool {
	if n == 0 {
		return false
	}
	st := usize(tpos[usize(n)])
	e := usize(tend[usize(n)])
	for p := st; p < e; p++ {
		x := tord[p]
		k := nkind(x)
		if k == NkAssignStmt {
			m := l1len(x)
			for i := usize(0); i < m; i++ {
				if storageRoot(l1at(x, i)) == s {
					return true
				}
			}
		} else if k == NkIncDecStmt {
			if storageRoot(na(x)) == s {
				return true
			}
		} else if k == NkShortVarDecl {
			m := l1len(x)
			for i := usize(0); i < m; i++ {
				if storageRoot(l1at(x, i)) == s {
					return true
				}
			}
		}
	}
	return false
}

// ---------------------------------------------------------------------------
// T2: slice shrink

// isShrinkCond recognizes len(rem) > 0, len(rem) != 0, 0 < len(rem),
// len(rem) >= 1 and returns rem.
func isShrinkCond(e u32) u32 {
	b := unparen(e)
	if b == 0 || nkind(b) != NkBinaryExpr {
		return 0
	}
	x := na(b)
	op := nop(b)
	y := nb(b)
	if lenArg(x) == 0 {
		x = nb(b)
		op = flipOp(nop(b))
		y = na(b)
	}
	a := lenArg(x)
	if a == 0 {
		return 0
	}
	k, ok := constUint(y)
	if !ok || !(op == OpGt && k == 0 || op == OpNe && k == 0 || op == OpGe && k == 1) {
		return 0
	}
	s := varOf(a)
	if s == 0 {
		return 0
	}
	if !isSliceT(underlying(symTyp(s))) {
		return 0
	}
	return s
}

func isLenOf(e u32, rem u32) bool {
	a := lenArg(e)
	return a != 0 && varOf(a) == rem
}

// shrinkStep recognizes rem[k:], rem[k:len(rem)] and rem[:len(rem)-k]
// (also rem[0:len(rem)-k]) and returns k.
func shrinkStep(rem u32, e u32) u32 {
	se := unparen(e)
	if se == 0 || nkind(se) != NkSliceExpr || varOf(na(se)) != rem {
		return 0
	}
	lo := nb(se)
	hi := nc(se)
	if lo != 0 && (hi == 0 || isLenOf(hi, rem)) {
		return lo
	}
	if hi != 0 && (lo == 0 || isZeroConst(lo)) {
		b := unparen(hi)
		if b != 0 && nkind(b) == NkBinaryExpr && nop(b) == OpSub && isLenOf(na(b), rem) {
			return nb(b)
		}
	}
	return 0
}

func loopT2(fi u32, f u32) u32 {
	fnode := fiNode(fi)
	rem := isShrinkCond(nb(f))
	totWhySym = rem
	if nc(f) != 0 {
		return WhyShrinkPost
	}
	init := na(f)
	if init != 0 {
		ik := nkind(init)
		if ik == NkShortVarDecl {
			if l1len(init) != 1 || symbolOf(l1at(init, 0)) != rem {
				return WhyInitDeclSlice
			}
		} else if ik == NkAssignStmt {
			if l1len(init) != 1 || varOf(l1at(init, 0)) != rem || nop(init) != AsgAssign {
				return WhyInitAsgSlice
			}
		} else {
			return WhyInitSlice
		}
	}
	if unstable(rem) || syms.items[usize(rem)].fn != fnode {
		return WhySliceUnstable
	}
	// every write of rem is a shrink step (never lengthened)
	body := ne(f)
	bad := false
	s := usize(tpos[usize(body)])
	e := usize(tend[usize(body)])
	for p := s; p < e; p++ {
		x := tord[p]
		k := nkind(x)
		if k == NkAssignStmt {
			m := l1len(x)
			for i := usize(0); i < m; i++ {
				if storageRoot(l1at(x, i)) != rem {
					continue
				}
				if nop(x) != AsgAssign || l2len(x) != m || shrinkStep(rem, l2at(x, i)) == 0 {
					bad = true
				}
			}
		} else if k == NkIncDecStmt {
			if storageRoot(na(x)) == rem {
				bad = true
			}
		}
	}
	if bad {
		return WhySliceModified
	}
	return walkT2(fi, f, rem)
}
