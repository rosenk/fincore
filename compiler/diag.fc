// SINCE: v0.3
// diag.fc — diagnostics in the spec section 11 format
//
//	file.fc:line:col: error[E####]: message
//
// identical to finc0 (bootstrap/internal/diag). Lines and columns are
// 1-based; columns count bytes. Diagnostics are written straight into an
// OutBuf; the parser stops at the first error of each file, so at most one
// diagnostic per file is produced and file order is the canonical order.
//
// This file also holds the byte-level text helpers shared by the lexer,
// the AST dump and the printer: UTF-8 decoding and Go-compatible quoting
// (strconv.Quote and the %q/%c verbs used by finc0's messages).
package main

// Diagnostic codes (spec section 11).
const (
	E1001 = 1001 // SYNTAX_ERROR
	E1002 = 1002 // UNTERMINATED_LITERAL
	E2001 = 2001 // UNDEFINED_SYMBOL
	E2002 = 2002 // TYPE_MISMATCH
	E2003 = 2003 // ARITY_MISMATCH
	E2004 = 2004 // INVALID_NIL
	E2005 = 2005 // UNINITIALIZED_SCOPED
	E2006 = 2006 // IMPORT_CYCLE
	E2010 = 2010 // UNIVERSE_LEVEL_MISMATCH
	E2011 = 2011 // NON_PARAMETRIC_OP
	E2012 = 2012 // NON_EXHAUSTIVE_MATCH (v0.2; also unreachable match arms)
	E3001 = 3001 // GLOBAL_SCOPED_VAR
	E3002 = 3002 // SCOPE_ESCAPE
	E3003 = 3003 // USE_AFTER_MOVE
	E3004 = 3004 // DISCARDED_LINEAR
	E3005 = 3005 // LINEAR_RESOURCE_LEAK
	E4001 = 4001 // COMPTIME_OUT_OF_FUEL
	E4002 = 4002 // UNPROVEN_TERMINATION
	E4003 = 4003 // ARRAY_BOUNDS_COMPTIME
	E4004 = 4004 // MUTUAL_RECURSION_NO_MEASURE
	E5001 = 5001 // DRIVER_CALL_IN_TOTAL
	E5002 = 5002 // INVALID_MAIN_SIGNATURE
)

// codeName returns the symbolic name of a diagnostic code ("" if unknown).
func codeName(code u32) string {
	return match code {
		E1001 -> "SYNTAX_ERROR"
		E1002 -> "UNTERMINATED_LITERAL"
		E2001 -> "UNDEFINED_SYMBOL"
		E2002 -> "TYPE_MISMATCH"
		E2003 -> "ARITY_MISMATCH"
		E2004 -> "INVALID_NIL"
		E2005 -> "UNINITIALIZED_SCOPED"
		E2006 -> "IMPORT_CYCLE"
		E2010 -> "UNIVERSE_LEVEL_MISMATCH"
		E2011 -> "NON_PARAMETRIC_OP"
		E2012 -> "NON_EXHAUSTIVE_MATCH"
		E3001 -> "GLOBAL_SCOPED_VAR"
		E3002 -> "SCOPE_ESCAPE"
		E3003 -> "USE_AFTER_MOVE"
		E3004 -> "DISCARDED_LINEAR"
		E3005 -> "LINEAR_RESOURCE_LEAK"
		E4001 -> "COMPTIME_OUT_OF_FUEL"
		E4002 -> "UNPROVEN_TERMINATION"
		E4003 -> "ARRAY_BOUNDS_COMPTIME"
		E4004 -> "MUTUAL_RECURSION_NO_MEASURE"
		E5001 -> "DRIVER_CALL_IN_TOTAL"
		E5002 -> "INVALID_MAIN_SIGNATURE"
		_ -> ""
	}
}

// diagHeader writes "path:line:col: error[E####]: ". The caller appends the
// message and finishes the line with diagEnd.
func diagHeader(o *OutBuf, path string, line u32, col u32, code u32) {
	o.WriteString(path)
	o.WriteByte(':')
	o.WriteUint(u64(line))
	o.WriteByte(':')
	o.WriteUint(u64(col))
	o.WriteString(": error[E")
	putDecMin(o, u64(code), 4)
	o.WriteString("]: ")
}

// diagEnd terminates a diagnostic line.
func diagEnd(o *OutBuf) {
	o.WriteByte('\n')
}

// putDecMin writes v in decimal, zero-padded to at least `width` digits.
func putDecMin(o *OutBuf, v u64, width usize) {
	digits := usize(1)
	t := v
	for i := usize(0); i < 20; i++ {
		if t < 10 {
			break
		}
		t = t / 10
		digits++
	}
	for i := digits; i < width; i++ {
		o.WriteByte('0')
	}
	o.WriteUint(v)
}

// putHexMin writes v in upper-case hex with at least `width` digits (%0*X).
func putHexMin(o *OutBuf, v u64, width usize) {
	digits := usize(1)
	t := v
	for i := usize(0); i < 16; i++ {
		if t < 16 {
			break
		}
		t = t >> 4
		digits++
	}
	o.WriteHex(v, max(digits, width), true)
}

// ---------------------------------------------------------------------------
// UTF-8

const RuneError = 0xFFFD

// decodeRune decodes the UTF-8 sequence starting at b[i] exactly like Go's
// utf8.DecodeRune: it returns (RuneError, 1) for an invalid encoding and
// (RuneError, 0) if i is past the end.
func decodeRune(b []byte, i usize) (u32, usize) {
	n := len(b)
	if i >= n {
		return RuneError, 0
	}
	p0 := b[i]
	if p0 < 0x80 {
		return u32(p0), 1
	}
	if p0 < 0xC2 || p0 > 0xF4 {
		return RuneError, 1
	}
	size := usize(2)
	lo := byte(0x80)
	hi := byte(0xBF)
	if p0 >= 0xE0 {
		size = 3
	}
	if p0 >= 0xF0 {
		size = 4
	}
	if p0 == 0xE0 {
		lo = 0xA0
	}
	if p0 == 0xED {
		hi = 0x9F
	}
	if p0 == 0xF0 {
		lo = 0x90
	}
	if p0 == 0xF4 {
		hi = 0x8F
	}
	if n-i < size {
		return RuneError, 1
	}
	b1 := b[i+1]
	if b1 < lo || b1 > hi {
		return RuneError, 1
	}
	if size == 2 {
		return (u32(p0&0x1F) << 6) | u32(b1&0x3F), 2
	}
	b2 := b[i+2]
	if b2 < 0x80 || b2 > 0xBF {
		return RuneError, 1
	}
	if size == 3 {
		return (u32(p0&0x0F) << 12) | (u32(b1&0x3F) << 6) | u32(b2&0x3F), 3
	}
	b3 := b[i+3]
	if b3 < 0x80 || b3 > 0xBF {
		return RuneError, 1
	}
	return (u32(p0&0x07) << 18) | (u32(b1&0x3F) << 12) | (u32(b2&0x3F) << 6) | u32(b3&0x3F), 4
}

// putRune writes the UTF-8 encoding of r.
func putRune(o *OutBuf, r u32) {
	if r < 0x80 {
		o.WriteByte(byte(r))
		return
	}
	if r < 0x800 {
		o.WriteByte(byte(0xC0 | (r >> 6)))
		o.WriteByte(byte(0x80 | (r & 0x3F)))
		return
	}
	if r < 0x10000 {
		o.WriteByte(byte(0xE0 | (r >> 12)))
		o.WriteByte(byte(0x80 | ((r >> 6) & 0x3F)))
		o.WriteByte(byte(0x80 | (r & 0x3F)))
		return
	}
	o.WriteByte(byte(0xF0 | (r >> 18)))
	o.WriteByte(byte(0x80 | ((r >> 12) & 0x3F)))
	o.WriteByte(byte(0x80 | ((r >> 6) & 0x3F)))
	o.WriteByte(byte(0x80 | (r & 0x3F)))
}

// isPrintRune approximates Go's strconv.IsPrint for non-ASCII runes: Go
// uses the full Unicode tables; we treat every assigned-looking rune as
// printable except the common control, format, separator and private-use
// ranges (see README, "known gaps").
func isPrintRune(r u32) bool {
	if r < 0x20 || r == 0x7F {
		return false
	}
	if r < 0x7F {
		return true
	}
	if r <= 0xA0 || r is 0xAD | 0x1680 | 0x180E | 0x3000 | 0xFEFF {
		return false
	}
	if r >= 0x2000 && r <= 0x200F {
		return false
	}
	if r >= 0x2028 && r <= 0x202F {
		return false
	}
	if r >= 0x205F && r <= 0x206F {
		return false
	}
	if r >= 0xD800 && r <= 0xF8FF {
		return false
	}
	if r >= 0xFFF0 && r <= 0xFFFB {
		return false
	}
	if r is 0xFFFE | 0xFFFF {
		return false
	}
	if r >= 0xE0000 {
		return false
	}
	return true
}

// putQuoted writes s quoted like Go's strconv.Quote.
func putQuoted(o *OutBuf, s []byte) {
	o.WriteByte('"')
	putQuotedBody(o, s)
	o.WriteByte('"')
}

// putQuotedBody writes the inside of strconv.Quote(s), without the
// delimiting quotes.
func putQuotedBody(o *OutBuf, s []byte) {
	n := len(s)
	i := usize(0)
	for g := usize(0); g < n; g++ {
		if i >= n {
			break
		}
		c := s[i]
		if c >= 0x80 {
			r, w := decodeRune(s, i)
			if w <= 1 {
				o.WriteString("\\x")
				o.WriteHex(u64(c), 2, false)
				i++
				continue
			}
			if isPrintRune(r) {
				o.WriteBytes(s[i : i+w])
			} else if r < 0x10000 {
				o.WriteString("\\u")
				o.WriteHex(u64(r), 4, false)
			} else {
				o.WriteString("\\U")
				o.WriteHex(u64(r), 8, false)
			}
			i += w
			continue
		}
		putEscapedASCII(o, c, '"')
		i++
	}
}

// putEscapedASCII writes one ASCII byte the way strconv quoting does inside
// a literal delimited by `quote`.
func putEscapedASCII(o *OutBuf, c byte, quote byte) {
	if c == quote || c == '\\' {
		o.WriteByte('\\')
		o.WriteByte(c)
		return
	}
	if c >= 0x20 && c < 0x7F {
		o.WriteByte(c)
		return
	}
	if c == 7 {
		o.WriteString("\\a")
		return
	}
	if c == 8 {
		o.WriteString("\\b")
		return
	}
	if c == 12 {
		o.WriteString("\\f")
		return
	}
	if c == '\n' {
		o.WriteString("\\n")
		return
	}
	if c == '\r' {
		o.WriteString("\\r")
		return
	}
	if c == '\t' {
		o.WriteString("\\t")
		return
	}
	if c == 11 {
		o.WriteString("\\v")
		return
	}
	o.WriteString("\\x")
	o.WriteHex(u64(c), 2, false)
}

// putQuotedByte writes c as Go's %q verb formats a byte value ('a').
func putQuotedByte(o *OutBuf, c byte) {
	o.WriteByte('\'')
	if c < 0x80 {
		putEscapedASCII(o, c, '\'')
	} else if isPrintRune(u32(c)) {
		putRune(o, u32(c))
	} else {
		o.WriteString("\\u00")
		o.WriteHex(u64(c), 2, false)
	}
	o.WriteByte('\'')
}

// putCharVerb writes c as Go's %c verb formats a byte (the rune U+00cc).
func putCharVerb(o *OutBuf, c byte) {
	putRune(o, u32(c))
}

// ---------------------------------------------------------------------------
// Source context (`--context` on check/build/run/test, or FINC_DIAG=context)
//
// Opt-in: without it the output is the spec 11 line only, byte-identical
// to finc0. With it every diagnostic line is followed by the source line
// and a caret span (the reported node's range when known, else one
// caret), tabs shown as four spaces, and for the most common codes a
// one-line help:
//
//	t.fc:12:9: error[E2002]: mismatched types u32 and u64
//	   12 |     x := a + b
//	      |          ^^^^^
//	      = help: ...

var diagContext bool

// diagVisual returns the display width of the first n bytes of a line
// (a tab counts 4, UTF-8 continuation bytes 0).
func diagVisual(text []byte, n usize) usize {
	m := min(n, len(text))
	w := usize(0)
	for i := usize(0); i < m; i++ {
		c := text[i]
		if c == '\t' {
			w += 4
		} else if c&0xC0 != 0x80 {
			w++
		}
	}
	return w
}

// diagGutter writes the line-number gutter: the number right-aligned in
// width (or blanks for line 0), then " | ".
func diagGutter(o *OutBuf, width usize, line u32) {
	digits := usize(1)
	t := line
	for i := usize(0); i < 10; i++ {
		if t < 10 {
			break
		}
		t = t / 10
		digits++
	}
	if line == 0 {
		o.WriteRepeat(' ', width)
	} else {
		if digits < width {
			o.WriteRepeat(' ', width-digits)
		}
		o.WriteUint(u64(line))
	}
	o.WriteString(" | ")
}

// diagHint returns the help text for a diagnostic ("" if none).
func diagHint(code u32, msg []byte) string {
	match code {
		E4002 -> {
			if bytesContains(msg, "is not provably shortened") {
				return "the start index k of `rem = rem[k:]` must be provably >= 1 without overflow: a positive constant, or a variable checked by `if k == 0 { return }`. An index like n+1 can wrap around to 0, so write `k := n + 1` and check k == 0 before `rem = rem[k:]`"
			}
			if bytesHasPrefix(msg, "cannot prove termination of for loop") {
				return "write a counting loop `for i := usize(0); i < n; i++` whose bound n the body does not assign, or give the loop a `decreases(m)` measure"
			}
			return "add `decreases(n)` with an unsigned parameter n and pass a smaller value (such as n-1) on every recursive call"
		}
		E4004 -> return "give every function of the cycle a `decreases(n)` measure and pass a smaller value on each call inside the cycle"
		E3002 -> {
			if bytesContains(msg, "each parameter is its own region") {
				return "store a copy of the data (for example in a fixed array field) instead of a reference to the other parameter's memory, or pass both values to the code that needs them"
			}
			return "the value refers to memory that dies first: copy the data into a longer-lived value, or declare the target inside the inner scope"
		}
		E3005 -> return "close, release or move the resource on every path (for example `defer r.Close()` right after acquiring it)"
		E2012 -> {
			if bytesHasPrefix(msg, "non-exhaustive") {
				return "add arms for the missing cases, or a final `_ -> ...` arm"
			}
			return "remove the arm, or move it before the arm that already covers its values"
		}
		_ -> return ""
	}
}

// diagCodeEnd returns the length of a line without its trailing `//`
// comment (string and char literals are skipped).
func diagCodeEnd(text []byte) usize {
	n := len(text)
	quote := byte(0)
	esc := false
	for k := usize(0); k < n; k++ {
		c := text[k]
		if quote != 0 {
			if esc {
				esc = false
			} else if c == '\\' {
				esc = true
			} else if c == quote {
				quote = 0
			}
		} else if c is '"' | '\'' {
			quote = c
		} else if c == '/' && k+1 < n && text[k+1] == '/' {
			return k
		}
	}
	return n
}

func bytesHasPrefix(b []byte, p string) bool {
	pb := strBytes(p)
	return len(b) >= len(pb) && bytesEqual(b[:len(pb)], pb)
}

// bytesContains reports whether p occurs in b.
func bytesContains(b []byte, p string) bool {
	pb := strBytes(p)
	n := len(b)
	m := len(pb)
	if m > n {
		return false
	}
	for i := usize(0); i < n-m+1; i++ {
		if bytesEqual(b[i:i+m], pb) {
			return true
		}
	}
	return false
}

// putDiagContext writes the source context of diagnostic i (see above).
func putDiagContext(o *OutBuf, i usize) {
	f := usize(diags.file[i])
	line := diags.line[i]
	col := diags.col[i]
	width := usize(5)
	if line >= 100_000 {
		width = 10
	}
	if f < sources.nfiles && line > 0 {
		st := sources.files[f].start
		size := sources.files[f].size
		src := sources.bytes[st : st+size]
		ls := usize(0)
		cur := u32(1)
		for k := usize(0); k < size; k++ {
			if cur == line {
				break
			}
			if src[k] == '\n' {
				cur++
				ls = k + 1
			}
		}
		if cur == line {
			le := ls
			for k := ls; k < size; k++ {
				if src[k] == '\n' {
					break
				}
				le = k + 1
			}
			text := src[ls:le]
			if len(text) > 0 && text[len(text)-1] == '\r' {
				text = text[:len(text)-1]
			}
			diagGutter(o, width, line)
			nt := len(text)
			for k := usize(0); k < nt; k++ {
				if text[k] == '\t' {
					o.WriteString("    ")
				} else {
					o.WriteByte(text[k])
				}
			}
			o.WriteByte('\n')
			// the span: to the node's end on this line, else to the end
			// of the line's text
			c0 := usize(0)
			if col > 0 {
				c0 = usize(col - 1)
			}
			c1 := c0 + 1
			el := diags.eline[i]
			ec := diags.ecol[i]
			if el == line && ec > col {
				c1 = usize(ec - 1)
			} else if el > line {
				te := diagCodeEnd(text)
				for g := usize(0); g < nt; g++ {
					if te == 0 || !(text[te-1] is ' ' | '\t') {
						break
					}
					te--
				}
				c1 = max(c1, te)
			}
			v0 := diagVisual(text, c0)
			v1 := max(diagVisual(text, c1), v0+1)
			diagGutter(o, width, 0)
			o.WriteRepeat(' ', v0)
			o.WriteRepeat('^', v1-v0)
			o.WriteByte('\n')
		}
	}
	h := diagHint(diags.code[i], diagMsg(i))
	if len(h) > 0 {
		o.WriteRepeat(' ', width)
		o.WriteString(" = help: ")
		o.WriteString(h)
		o.WriteByte('\n')
	}
}
