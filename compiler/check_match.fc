// check_match.fc — the type checker, part 4 (v0.2 sum types and
// patterns): match statements and expressions, tuple scrutinees, nested,
// or-, tuple and rest patterns with bindings, guards, `is` expressions,
// reachability and exhaustiveness (E2012) by pattern usefulness. Port of
// finc0's types/match.go and types/usefulness.go. Functions taking `dp`
// are members of the checker SCC (see checker.fc).
package main

// ---------------------------------------------------------------------------
// Matches

func matchStmt(s u32, dp usize) decreases(dp) {
	if dp == 0 {
		tooDeep()
		return
	}
	x := scrutinee(na(s), dp-1)
	_ = matchPatterns(s, &x, false, dp-1)
	n := l1len(s)
	for i := usize(0); i < n; i++ {
		arm := l1at(s, i)
		if nb(arm) != 0 {
			exprStmt(nb(arm), "match arm", dp-1)
		}
		if nc(arm) != 0 {
			stmtList(nc(arm), dp-1)
		}
	}
}

// scrutinee checks the scrutinee of a match: an expression (untyped
// constants get their default type) or a tuple of expressions (a tuple
// type, v0.2).
func scrutinee(e u32, dp usize) Operand decreases(dp) {
	if dp == 0 {
		tooDeep()
		return invalidOp(e)
	}
	if nkind(e) != NkTupleExpr {
		x := exprValue(e, dp-1)
		if !isInvalidOp(&x) && isUntyped(x.typ) {
			_ = defaultTypeOp(&x, Ctx.Match)
		}
		return x
	}
	n := l1len(e)
	bad := false
	m := tmark()
	for i := usize(0); i < n; i++ {
		x := exprValue(l1at(e, i), dp-1)
		if !isInvalidOp(&x) && isUntyped(x.typ) {
			_ = defaultTypeOp(&x, Ctx.Match)
		}
		if isInvalidOp(&x) {
			bad = true
		}
		tpush(x.typ)
	}
	t := mkTupleStack(m)
	if bad {
		return invalidOp(e)
	}
	x := opMode(KValue, t)
	x.expr = e
	ntype[usize(e)] = t
	nmode[usize(e)] = KValue
	return x
}

// armOperand rebuilds the operand of a checked arm expression from the
// recorded tables.
func armOperand(a u32) Operand {
	var x Operand
	x.expr = a
	x.mode = nmode[usize(a)]
	x.typ = ntype[usize(a)]
	if x.mode == KConst && nval[usize(a)] != 0 {
		x.val = slotGet(nval[usize(a)])
	}
	return x
}

func isUntypedNumeric(t u32) bool {
	k := basicKind(t)
	return k is BkUntypedInt | BkUntypedChar
}

func mArmType(a u32, have u32, want u32) {
	errAt(E2002, a, formatTo(mbuf[:], "match arm has type %v, want %v", TypeRef(have), TypeRef(want)))
}

// mwWant is the context of the match expression about to be checked
// (v0.3 multi-value matches): a Tuple type of the N values its context
// expects (TyInvalid elements: no type, i.e. the default type), or 0 in a
// single-value context. It is set right before rawExpr of an expression
// whose unparenthesized form is a match expression (setMatchWant), and
// matchExpr reads and clears it on entry.
var mwWant u32

// setMatchWant sets mwWant to want if e is (a parenthesized) match
// expression, else clears it.
func setMatchWant(e u32, want u32) {
	mwWant = 0
	if nkind(unparen(e)) == NkMatchExpr {
		mwWant = want
	}
}

// matchExpr checks a match expression. The arms' types must agree;
// untyped constant arms take the type of the typed arms. If every arm is
// untyped the result is untyped and is converted by its context (see
// updateType). The result is constant if the scrutinee is constant and the
// selected arm is a constant expression. v0.3: if an arm yields several
// values (a value list, or a multi-value call or match), the match is a
// multi-value match (matchExprMulti).
func matchExpr(e u32, dp usize) Operand decreases(dp) {
	if dp == 0 {
		tooDeep()
		return invalidOp(e)
	}
	want := mwWant
	mwWant = 0
	x := scrutinee(na(e), dp-1)
	valid := matchPatterns(e, &x, true, dp-1)
	n := l1len(e)
	multi := false
	for i := usize(0); i < n; i++ {
		if nkind(nb(l1at(e, i))) == NkTupleExpr {
			multi = true
		}
	}
	rt := u32(0)
	bad := false
	for i := usize(0); i < n; i++ {
		a := nb(l1at(e, i))
		var o Operand
		if nkind(a) == NkTupleExpr {
			o = tupleArm(a, dp-1)
		} else if want != 0 || multi {
			// a multi-value call or match may give all values
			setMatchWant(a, want)
			o = rawExpr(a, dp-1)
			mwWant = 0
			if !isInvalidOp(&o) && o.mode is KValue | KVar | KConst && isTupleT(o.typ) {
				multi = true
			}
		} else {
			o = exprValue(a, dp-1)
		}
		if isInvalidOp(&o) {
			bad = true
			continue
		}
		if rt == 0 && !isUntyped(o.typ) {
			rt = o.typ
		}
	}
	if multi {
		if bad {
			return invalidOp(e)
		}
		return matchExprMulti(e, want, dp-1)
	}
	if want != 0 {
		// No arm gives several values: the arms are single values (v0.2).
		for i := usize(0); i < n; i++ {
			o := armOperand(nb(l1at(e, i)))
			singleValue(&o)
			if isInvalidOp(&o) {
				bad = true
			}
		}
	}
	if bad {
		return invalidOp(e)
	}
	if rt != 0 {
		for i := usize(0); i < n; i++ {
			a := nb(l1at(e, i))
			o := armOperand(a)
			if isUntyped(o.typ) {
				if !convertUntyped(&o, rt) {
					bad = true
				}
			} else if o.typ != rt {
				mArmType(a, o.typ, rt)
				bad = true
			}
		}
	} else {
		rt = ntype[usize(nb(l1at(e, 0)))]
		for i := usize(1); i < n; i++ {
			a := nb(l1at(e, i))
			t := ntype[usize(a)]
			if t == rt {
			} else if isUntypedNumeric(t) && isUntypedNumeric(rt) {
				rt = TyUntypedInt
			} else {
				mArmType(a, t, rt)
				bad = true
			}
		}
	}
	if bad {
		return invalidOp(e)
	}
	r := opMode(KValue, rt)
	if valid && x.mode == KConst {
		sel := selectArm(x.val, e)
		if sel < n {
			a := nb(l1at(e, sel))
			if nmode[usize(a)] == KConst {
				r.mode = KConst
				r.val = slotGet(nval[usize(a)])
			}
		}
	}
	return r
}

// tupleArm checks the value list of a multi-value arm (v0.3): every value
// is a single value. The list's type is recorded later (matchExprMulti).
func tupleArm(a u32, dp usize) Operand decreases(dp) {
	if dp == 0 {
		tooDeep()
		return invalidOp(a)
	}
	c := l1len(a)
	ok := true
	for j := usize(0); j < c; j++ {
		v := exprValue(l1at(a, j), dp-1)
		if isInvalidOp(&v) {
			ok = false
		}
	}
	if !ok {
		return invalidOp(a)
	}
	x := opMode(KValue, TyInvalid)
	x.expr = a
	return x
}

// armCount returns the number of values of a checked arm of a multi-value
// match: the length of a value list, of a tuple type, or 1.
func armCount(a u32) usize {
	if nkind(a) == NkTupleExpr {
		return l1len(a)
	}
	if trec(ntype[usize(a)]) is Tuple(_, tn) {
		return usize(tn)
	}
	return 1
}

// armValueType returns the type of value j of a checked arm of a
// multi-value match.
func armValueType(a u32, j usize) u32 {
	if nkind(a) == NkTupleExpr {
		return ntype[usize(l1at(a, j))]
	}
	if trec(ntype[usize(a)]) is Tuple(ts, _) {
		return tlist(ts, j)
	}
	return ntype[usize(a)]
}

// matchExprMulti finishes the check of a multi-value match expression
// (v0.3) whose arms have been checked: every arm must give the same
// number N of values (that of the first arm with several), and the values
// at each position i must agree like the arms of a single-value match:
// untyped constants take the type of the typed values at i; if all are
// untyped they take the type the context expects at i (want, a Tuple of
// N types; TyInvalid elements and other contexts: the default type of
// their kind). The result is a value (never a constant) of type
// (T1, ..., TN); value lists record that type too.
func matchExprMulti(e u32, want u32, dp usize) Operand decreases(dp) {
	if dp == 0 {
		tooDeep()
		return invalidOp(e)
	}
	n := l1len(e)
	nv := usize(0)
	for i := usize(0); i < n; i++ {
		c := armCount(nb(l1at(e, i)))
		if c > 1 {
			nv = c
			break
		}
	}
	bad := false
	for i := usize(0); i < n; i++ {
		a := nb(l1at(e, i))
		c := armCount(a)
		if c != nv {
			if c == 1 {
				errAt(E2003, a, formatTo(mbuf[:], "match arm has 1 value, want %d", nv))
			} else {
				errAt(E2003, a, formatTo(mbuf[:], "match arm has %d values, want %d", c, nv))
			}
			bad = true
		}
	}
	if bad {
		return invalidOp(e)
	}
	wts := u32(0)
	if trec(want) is Tuple(ws, wn) && usize(wn) == nv {
		wts = ws
	}
	m := tmark()
	for j := usize(0); j < nv; j++ {
		rt := u32(0)
		for i := usize(0); i < n; i++ {
			t := armValueType(nb(l1at(e, i)), j)
			if !isUntyped(t) {
				rt = t
				break
			}
		}
		if rt == 0 {
			// every value at j is an untyped constant (in value lists)
			k := armValueType(nb(l1at(e, 0)), j)
			for i := usize(1); i < n; i++ {
				v := l1at(nb(l1at(e, i)), j)
				t := ntype[usize(v)]
				if t == k {
				} else if isUntypedNumeric(t) && isUntypedNumeric(k) {
					k = TyUntypedInt
				} else {
					errAt(E2002, v, formatTo(mbuf[:], "match arm value %d has type %v, want %v", j+1, TypeRef(t), TypeRef(k)))
					bad = true
				}
			}
			if bad {
				break
			}
			rt = defaultOf(k)
			if wts != 0 && !isInvalid(tlist(wts, j)) {
				rt = tlist(wts, j)
			} else if basicKind(k) == BkUntypedNil {
				errAt(E2004, l1at(nb(l1at(e, 0)), j), formatTo(mbuf[:], "use of untyped nil in %v", Ctx.Match))
				bad = true
				break
			}
		}
		for i := usize(0); i < n; i++ {
			a := nb(l1at(e, i))
			if nkind(a) != NkTupleExpr {
				t := armValueType(a, j)
				if t != rt {
					errAt(E2002, a, formatTo(mbuf[:], "match arm value %d has type %v, want %v", j+1, TypeRef(t), TypeRef(rt)))
					bad = true
				}
				continue
			}
			v := l1at(a, j)
			o := armOperand(v)
			if isUntyped(o.typ) {
				if !convertUntyped(&o, rt) {
					bad = true
				}
			} else if o.typ != rt {
				errAt(E2002, v, formatTo(mbuf[:], "match arm value %d has type %v, want %v", j+1, TypeRef(o.typ), TypeRef(rt)))
				bad = true
			}
		}
		tpush(rt)
	}
	t := mkTupleStack(m)
	if bad {
		return invalidOp(e)
	}
	for i := usize(0); i < n; i++ {
		a := nb(l1at(e, i))
		if nkind(a) == NkTupleExpr {
			ntype[usize(a)] = t
			nmode[usize(a)] = KValue
		}
	}
	return opMode(KValue, t)
}

// convertMatchArms converts the untyped arms of a match expression whose
// result was given type t by its context.
func convertMatchArms(e u32, t u32, dp usize) decreases(dp) {
	if dp == 0 {
		tooDeep()
		return
	}
	n := l1len(e)
	for i := usize(0); i < n; i++ {
		a := nb(l1at(e, i))
		old := ntype[usize(a)]
		if old == 0 || !isUntyped(old) {
			continue
		}
		x := armOperand(a)
		_ = convertUntypedDp(&x, t, dp-1)
	}
}

// patAltN / patAlt: the alternatives of a pattern (itself unless it is an
// or-pattern).
func patAltN(p u32) usize {
	if nkind(p) == NkOrPattern {
		return l1len(p)
	}
	return 1
}

func patAlt(p u32, i usize) u32 {
	if nkind(p) == NkOrPattern {
		return l1at(p, i)
	}
	return p
}

func valsEqual(a Val, b Val) bool {
	if isSliceVal(a) && b is Str(off, n) {
		// v0.3: a []byte value against a string pattern, by bytes.
		ref, m := sliceElems(a)
		if m != n {
			return false
		}
		s := strSpan(off, n)
		for i := u32(0); i < m; i++ {
			if intLo(slotGet(ref+i)) != u64(s[usize(i)]) {
				return false
			}
		}
		return true
	}
	eq, ok := equalVals(a, b, SemaDepth)
	return ok && eq
}

// selectArm returns the index of the arm of match m selected by the
// constant scrutinee value v (the arm count if none, or if a guard on the
// way is not a constant).
func selectArm(v Val, m u32) usize {
	n := l1len(m)
	for i := usize(0); i < n; i++ {
		arm := l1at(m, i)
		if !matchVal(na(arm), v, SemaDepth) {
			continue
		}
		g := nd(arm)
		if g == 0 {
			return i
		}
		match slotGet(nval[usize(g)]) {
			Bool(true) -> return i
			Bool(false) -> {}
			_ -> return n // not a constant
		}
	}
	return n
}

// payloadIndex returns the payload position matched by argument i of a
// variant pattern p with n payloads (v0.2: arguments after a `..` count
// from the end). Argument i must not be the RestPattern itself.
func payloadIndex(p u32, i usize, n usize) usize {
	c := l1len(p)
	for r := usize(0); r < i; r++ {
		if nkind(l1at(p, r)) == NkRestPattern {
			return n - (c - i)
		}
	}
	return i
}

// matchVal reports whether the constant value v matches the checked
// pattern p (finc0's types.MatchValue without bindings).
func matchVal(p u32, v Val, depth usize) bool decreases(depth) {
	if depth == 0 || p == 0 {
		return false
	}
	k := nkind(p)
	if k is NkWildcardPattern | NkRestPattern {
		return true
	}
	if k == NkIdent {
		if nvarEnum[usize(p)] != 0 {
			return v is Enum(vi, ..) && vi == nvarIdx[usize(p)]
		}
		cs := patConst(p)
		return cs == 0 || valsEqual(v, slotGet(cs))
	}
	if k == NkCtorPattern {
		if nvarEnum[usize(p)] == 0 {
			cs := patConst(p)
			return cs == 0 || valsEqual(v, slotGet(cs))
		}
		if !(v is Enum(vi, ps, _)) || vi != nvarIdx[usize(p)] {
			return false
		}
		np := variantPayN(nvarEnum[usize(p)], usize(nvarIdx[usize(p)]))
		c := l1len(p)
		for i := usize(0); i < c; i++ {
			a := l1at(p, i)
			if nkind(a) == NkRestPattern {
				continue
			}
			if !matchVal(a, slotGet(ps+u32(payloadIndex(p, i, np))), depth-1) {
				return false
			}
		}
		return true
	}
	if k == NkLiteralPattern {
		s := nval[usize(na(p))]
		return s != 0 && valsEqual(v, slotGet(s))
	}
	if k == NkAtPattern {
		return matchVal(nb(p), v, depth-1)
	}
	if k == NkOrPattern {
		c := l1len(p)
		for i := usize(0); i < c; i++ {
			if matchVal(l1at(p, i), v, depth-1) {
				return true
			}
		}
		return false
	}
	if k != NkTuplePattern || !(v is Tuple(ref, tn)) || usize(tn) != l1len(p) {
		return false
	}
	for i := u32(0); i < tn; i++ {
		if !matchVal(l1at(p, usize(i)), slotGet(ref+i), depth-1) {
			return false
		}
	}
	return true
}

// isExpr checks `X is Pattern` (v0.2). Bindings are declared by the
// resolver for every `is` (flow-scoped, decisions 118-125).
func isExpr(e u32, dp usize) Operand decreases(dp) {
	if dp == 0 {
		tooDeep()
		return invalidOp(e)
	}
	x := exprValue(na(e), dp-1)
	if !isInvalidOp(&x) && isUntyped(x.typ) {
		_ = defaultTypeOp(&x, Ctx.Match)
	}
	if isInvalidOp(&x) {
		invalidBindings(nb(e), SemaDepth)
		return invalidOp(e)
	}
	if !topPattern(nb(e), x.typ, dp-1) {
		return invalidOp(e)
	}
	if x.mode == KConst && !hasBindings(nb(e), SemaDepth) {
		return opConst(TyUntypedBool, Val.Bool(matchVal(nb(e), x.val, SemaDepth)))
	}
	return opMode(KValue, TyBool)
}

// hasBindings reports whether a checked pattern binds a variable.
func hasBindings(p u32, depth usize) bool decreases(depth) {
	if depth == 0 || p == 0 {
		return false
	}
	if isBindingPat(p) {
		return true
	}
	k := nkind(p)
	if k == NkAtPattern {
		return hasBindings(na(p), depth-1) || hasBindings(nb(p), depth-1)
	}
	if k is NkCtorPattern | NkOrPattern | NkTuplePattern {
		c := l1len(p)
		for i := usize(0); i < c; i++ {
			if hasBindings(l1at(p, i), depth-1) {
				return true
			}
		}
	}
	return false
}

// invalidBindings gives every binding of p without a type the type Invalid
// (after an error).
func invalidBindings(p u32, depth usize) decreases(depth) {
	if depth == 0 || p == 0 {
		return
	}
	s := patBindSym(p)
	if s != 0 && syms.items[usize(s)].typ == 0 {
		setSymType(s, TyInvalid)
	}
	k := nkind(p)
	if k == NkAtPattern {
		invalidBindings(na(p), depth-1)
		invalidBindings(nb(p), depth-1)
	} else if k is NkCtorPattern | NkOrPattern | NkTuplePattern {
		c := l1len(p)
		for i := usize(0); i < c; i++ {
			invalidBindings(l1at(p, i), depth-1)
		}
	}
}

// matchPatterns checks the patterns and guards of match m (statement or
// expression) on x and reports E2012 for unreachable arms and
// non-exhaustive matches. It records whether the match counts as
// exhaustive (nexh) and reports whether every pattern is valid.
func matchPatterns(m u32, x *Operand, isExpr bool, dp usize) bool decreases(dp) {
	if dp == 0 {
		tooDeep()
		return false
	}
	valid := !isInvalidOp(x)
	n := l1len(m)
	for i := usize(0); i < n; i++ {
		arm := l1at(m, i)
		pat := na(arm)
		if isInvalidOp(x) {
			invalidBindings(pat, SemaDepth)
		} else if !topPattern(pat, x.typ, dp-1) {
			valid = false
		}
		g := nd(arm)
		if g != 0 {
			gx := exprValue(g, dp-1)
			if !isInvalidOp(&gx) {
				if !isBoolean(gx.typ) {
					errAt(E2002, g, formatTo(mbuf[:], "non-boolean guard %v in match arm (type %v)", Expr(g), TypeRef(gx.typ)))
				} else if isUntyped(gx.typ) {
					_ = convertUntyped(&gx, TyBool)
				}
			}
		}
	}
	required := false
	if !isInvalidOp(x) {
		u := underlying(x.typ)
		required = trec(u) is Enum(..) | Tuple(..)
	}
	if !valid {
		exh := required
		for i := usize(0); i < n; i++ {
			arm := l1at(m, i)
			if catchAll(na(arm)) && nd(arm) == 0 {
				exh = true
			}
		}
		nexh[usize(m)] = exh
		return false
	}
	exhaustive := checkCoverage(m, x.typ, isExpr)
	nexh[usize(m)] = exhaustive || required
	return true
}

// ---------------------------------------------------------------------------
// Pattern checking

// Bindings of the pattern being checked (a LIFO stack: or-pattern
// alternatives push their lists above the enclosing pattern's).
const MaxPatBinds = 4096

var pbSym [MaxPatBinds]u32
var pbId [MaxPatBinds]u32
var pbTyp [MaxPatBinds]u32
var pbN usize

func pbPush(sym u32, id u32, t u32) {
	if pbN >= MaxPatBinds {
		setFull("pattern bindings")
		return
	}
	pbSym[pbN] = sym
	pbId[pbN] = id
	pbTyp[pbN] = t
	pbN++
}

// pbFind returns the index of sym in [lo, hi) (hi if absent).
func pbFind(sym u32, lo usize, hi usize) usize {
	for i := lo; i < hi; i++ {
		if pbSym[i] == sym {
			return i
		}
	}
	return hi
}

// uniqBindings reports variables bound twice in [mark, pbN) (E2002) and
// removes the duplicates.
func uniqBindings(mark usize) {
	w := mark
	top := pbN
	for r := mark; r < top; r++ {
		if pbFind(pbSym[r], mark, w) < w {
			errAt(E2002, pbId[r], formatTo(mbuf[:], "variable %v is bound more than once in a pattern", NameRef(idName(pbId[r]))))
			continue
		}
		pbSym[w] = pbSym[r]
		pbId[w] = pbId[r]
		pbTyp[w] = pbTyp[r]
		w++
	}
	pbN = w
}

// topPattern checks the pattern of an arm or `is` expression against the
// scrutinee type t, then gives the bindings their types. It reports
// whether the pattern is valid.
func topPattern(p u32, t u32, dp usize) bool decreases(dp) {
	if dp == 0 {
		tooDeep()
		return false
	}
	mark := pbN
	ok := pat(p, t, false, dp-1)
	uniqBindings(mark)
	top := pbN
	for i := mark; i < top; i++ {
		st := syms.items[usize(pbSym[i])].typ
		if st == 0 {
			setSymType(pbSym[i], pbTyp[i])
		} else if pbId[i] != syms.items[usize(pbSym[i])].ident && !isInvalid(st) && !isInvalid(pbTyp[i]) && pbTyp[i] != st {
			// v0.2: an `is` binding intersected with an earlier one of
			// the same name (one symbol, see bFlowIntersect).
			errAt(E2002, pbId[i], formatTo(mbuf[:], "variable %v has type %v here but %v in the first is test that binds it", NameRef(idName(pbId[i])), TypeRef(pbTyp[i]), TypeRef(st)))
			ok = false
		}
	}
	pbN = mark
	invalidBindings(p, SemaDepth)
	return ok
}

// pat checks pattern p against type t and pushes its bindings. payload is
// set for payload positions of a variant pattern, where a bare identifier
// is a binding or a variant of t's enum.
func pat(p u32, t u32, payload bool, dp usize) bool decreases(dp) {
	if dp == 0 {
		tooDeep()
		return false
	}
	k := nkind(p)
	if k == NkWildcardPattern {
		return true
	}
	if k == NkRestPattern {
		errAt(E2002, p, formatTo(mbuf[:], "'..' is only allowed in the payload list of a variant pattern"))
		return false
	}
	if k == NkIdent {
		ntype[usize(p)] = t
		if isBlank(p) {
			return true
		}
		en := underlying(t)
		if isEnumT(en) {
			v, found := variantByName(en, idName(p))
			if found {
				np := variantPayN(en, v)
				if np != 0 {
					errAt(E2003, p, formatTo(mbuf[:], "variant %v has %d payload values, pattern binds 0", NameRef(idName(p)), np))
					return false
				}
				nvarEnum[usize(p)] = en
				nvarIdx[usize(p)] = u32(v)
				// A name declared by the resolver for it is bound to the
				// payload (which is that variant).
				s := defs[usize(p)]
				if s != 0 && syms.items[usize(s)].typ == 0 {
					setSymType(s, t)
				}
				return true
			}
		}
		csym := uses[usize(p)]
		if csym != 0 && symKind(csym) == SymConst {
			return constPat(p, p, csym, t, false, dp-1)
		}
		return bindPat(p, t)
	}
	if k == NkLiteralPattern {
		x := exprValue(na(p), dp-1)
		if isInvalidOp(&x) {
			return false
		}
		if isTupleT(t) {
			errAt(E2002, p, formatTo(mbuf[:], "pattern %v does not match a tuple scrutinee of type %v", Expr(na(p)), TypeRef(t)))
			return false
		}
		if bytesPattern(&x, t) {
			return true
		}
		if !assignment(&x, t, Ctx.Pattern) {
			return false
		}
		if !comparable(t, SemaDepth) {
			errAt(E2002, p, formatTo(mbuf[:], "cannot match values of type %v against literals", TypeRef(t)))
			return false
		}
		return true
	}
	if k == NkCtorPattern {
		return ctorPat(p, t, dp-1)
	}
	if k == NkOrPattern {
		return orPat(p, t, payload, dp-1)
	}
	if k == NkAtPattern {
		// v0.2: the name binds the value at this position (declared by
		// the resolver unless it was rejected there).
		ntype[usize(na(p))] = t
		valid := bindPat(na(p), t)
		if !pat(nb(p), t, payload, dp-1) {
			valid = false
		}
		return valid
	}
	if k == NkTuplePattern {
		if !(trec(t) is Tuple(ts, tn)) {
			errAt(E2002, p, formatTo(mbuf[:], "tuple pattern %v does not match type %v", PatRef(p), TypeRef(t)))
			return false
		}
		c := l1len(p)
		if usize(tn) != c {
			errAt(E2003, p, formatTo(mbuf[:], "tuple pattern has %d elements, scrutinee has %d", c, tn))
			return false
		}
		valid := true
		for i := usize(0); i < c; i++ {
			if !pat(l1at(p, i), tlist(ts, i), false, dp-1) {
				valid = false
			}
		}
		return valid
	}
	return true
}

// orPat checks an or-pattern: every alternative must bind the same
// variables with identical types (v0.2).
func orPat(p u32, t u32, payload bool, dp usize) bool decreases(dp) {
	if dp == 0 {
		tooDeep()
		return false
	}
	valid := true
	haveFirst := false
	f0 := pbN
	f1 := pbN
	c := l1len(p)
	for i := usize(0); i < c; i++ {
		alt := l1at(p, i)
		ak := nkind(alt)
		if ak == NkWildcardPattern || (ak == NkIdent && isBlank(alt)) {
			errAt(E2002, alt, formatTo(mbuf[:], "'_' cannot be an alternative of an or-pattern"))
			valid = false
			continue
		}
		mark := pbN
		if !pat(alt, t, payload, dp-1) {
			valid = false
			pbN = mark
			continue
		}
		uniqBindings(mark)
		if i == 0 {
			haveFirst = true
			f0 = mark
			f1 = pbN
			continue
		}
		if haveFirst {
			for j := f0; j < f1; j++ {
				top := pbN
				if pbFind(pbSym[j], mark, top) == top {
					errAt(E2002, alt, formatTo(mbuf[:], "or-pattern alternatives must bind the same variables (%v is not bound here)", NameRef(idName(pbId[j]))))
					valid = false
				}
			}
			top := pbN
			for j := mark; j < top; j++ {
				q := pbFind(pbSym[j], f0, f1)
				if q == f1 {
					errAt(E2002, pbId[j], formatTo(mbuf[:], "or-pattern alternatives must bind the same variables (%v is not bound in the first alternative)", NameRef(idName(pbId[j]))))
					valid = false
				} else if pbTyp[j] != pbTyp[q] {
					errAt(E2002, pbId[j], formatTo(mbuf[:], "variable %v has type %v here but %v in the first alternative", NameRef(idName(pbId[j])), TypeRef(pbTyp[j]), TypeRef(pbTyp[q])))
					valid = false
				}
			}
		}
		pbN = mark
	}
	if !haveFirst {
		pbN = f0
	}
	return valid
}

// bindPat checks a binding (the bare identifier id) of type t.
func bindPat(id u32, t u32) bool {
	s := defs[usize(id)]
	if s == 0 {
		return false // not declared (only when the symbol table is full; decision 118)
	}
	if isTupleT(t) {
		errAt(E2002, id, formatTo(mbuf[:], "cannot bind %v to a tuple of type %v (use '_' or a tuple pattern)", NameRef(idName(id)), TypeRef(t)))
		return false
	}
	pbPush(s, id, t)
	return true
}

// constPat checks the constant pattern p (the constant sym, named by name)
// against type t: the constant must be assignable to t. A constant of an
// enum type must hold a variant without payload; p then counts as that
// variant (nvarEnum/nvarIdx).
func constPat(p u32, name u32, sym u32, t u32, parens bool, dp usize) bool decreases(dp) {
	if dp == 0 {
		tooDeep()
		return false
	}
	if parens {
		errAt(E2002, p, formatTo(mbuf[:], "constant %v cannot have bindings", NameRef(symName(sym))))
		return false
	}
	if isTupleT(t) {
		errAt(E2002, p, formatTo(mbuf[:], "pattern %v does not match a tuple scrutinee of type %v", NameRef(symName(sym)), TypeRef(t)))
		return false
	}
	x := symOperand(sym, name, dp-1)
	x.expr = name
	record(&x)
	if !isInvalidOp(&x) && bytesPattern(&x, t) {
		return true
	}
	if isInvalidOp(&x) || !assignment(&x, t, Ctx.Pattern) {
		return false
	}
	en := underlying(t)
	if !isEnumT(en) {
		return true
	}
	if !(x.val is Enum(vi, ..)) || usize(vi) >= nvariants(en) {
		return false
	}
	if variantPayN(en, usize(vi)) != 0 {
		errAt(E2002, p, formatTo(mbuf[:], "constant %v cannot be a pattern: its variant %v has a payload (match the variant instead)", NameRef(symName(sym)), NameRef(variantName(en, usize(vi)))))
		return false
	}
	nvarEnum[usize(p)] = en
	nvarIdx[usize(p)] = vi
	ntype[usize(p)] = t
	return true
}

// bytesPattern accepts a string constant (a literal or a constant of any
// string type) as a pattern against a []byte position t (v0.3): it matches
// a byte slice with the same bytes. An untyped constant gets type string.
// It reports false (nothing checked) for every other pattern and type.
func bytesPattern(x *Operand, t u32) bool {
	if !isByteSliceT(t) || x.mode != KConst || !isString(x.typ) {
		return false
	}
	if isUntyped(x.typ) {
		_ = convertUntyped(x, TyString)
	}
	return true
}

// bareName returns the identifier of a bare pattern name: a payload Ident
// or an unqualified CtorPattern without parentheses (a variant, constant
// or binding; v0.2), else 0.
func bareName(p u32) u32 {
	if p == 0 {
		return 0
	}
	k := nkind(p)
	if k == NkIdent {
		return p
	}
	if k == NkCtorPattern && na(p) == 0 && !nflag(p) {
		return nb(p)
	}
	return 0
}

// patBindSym returns the symbol bound by a bare pattern name (see
// bareName), or 0. A bare variant name may be bound too (to the value,
// which is that variant); constants never are.
func patBindSym(p u32) u32 {
	id := bareName(p)
	if id == 0 || isBlank(id) {
		return 0
	}
	return defs[usize(id)]
}

// isBindingPat reports whether p is a binding that matches every value: a
// bare name that is neither a variant nor a constant (checked patterns).
func isBindingPat(p u32) bool {
	return patBindSym(p) != 0 && nvarEnum[usize(p)] == 0
}

// patConst returns the value slot of a checked constant pattern that is
// not an enum variant (a bare or qualified constant name), else 0.
// Constants of enum type count as their variant (nvarEnum).
func patConst(p u32) u32 {
	if p == 0 || nvarEnum[usize(p)] != 0 {
		return 0
	}
	k := nkind(p)
	if k == NkIdent {
		return nval[usize(p)]
	}
	if k == NkCtorPattern {
		return nval[usize(nb(p))]
	}
	return 0
}

// catchAll reports whether a (checked) top-level pattern is '_' or a
// binding (v0.2), which match every value; `x @ P` is P.
func catchAll(p u32) bool {
	q := stripAt(p)
	return nkind(q) == NkWildcardPattern || isBindingPat(q)
}

// stripAt returns the pattern under the `x @` prefixes of p (v0.2): for
// usefulness and catch-all tests `x @ P` is exactly P.
func stripAt(p u32) u32 {
	q := p
	for g := usize(0); g < MaxNodes; g++ {
		if q == 0 || nkind(q) != NkAtPattern {
			break
		}
		q = nb(q)
	}
	return q
}

// catchAllName returns the name of a catch-all binding pattern: `x`, or
// the outermost name of `x @ P`.
func catchAllName(p u32) u32 {
	if nkind(p) == NkAtPattern {
		return na(p)
	}
	return bareName(p)
}

// ctorPat checks a variant, constant or binding pattern
// `[Qual.]Name[(args)]` (a bare Name is a variant of t's enum, else a
// constant, else a binding).
func ctorPat(p u32, t u32, dp usize) bool decreases(dp) {
	if dp == 0 {
		tooDeep()
		return false
	}
	en := underlying(t)
	isEnum := isEnumT(en)
	name := nb(p)
	sym := uses[usize(name)]
	// A constant pattern (pkg.Const or Const). An unqualified name that is
	// a variant of the scrutinee's enum is that variant (v0.2).
	isVar := false
	if na(p) == 0 && isEnum {
		_, isVar = variantByName(en, idName(name))
	}
	if sym != 0 && symKind(sym) == SymConst && !isVar {
		return constPat(p, name, sym, t, nflag(p), dp-1)
	}
	if na(p) == 0 && !nflag(p) && !isVar {
		ntype[usize(p)] = t
		return bindPat(name, t)
	}
	nm := idName(name)
	venum := u32(0)
	vi := usize(0)
	q := na(p)
	if q != 0 {
		qs := uses[usize(q)]
		if qs == 0 {
			return false
		}
		if symKind(qs) != SymType {
			errAt(E2002, q, formatTo(mbuf[:], "%v is not an enum type", NameRef(idName(q))))
			return false
		}
		qt := typeSym(qs, q, dp-1)
		ntype[usize(q)] = qt
		nmode[usize(q)] = KType
		if isInvalid(qt) {
			return false
		}
		qe := underlying(qt)
		if !isEnumT(qe) {
			errAt(E2002, q, formatTo(mbuf[:], "%v is not an enum type", TypeRef(qt)))
			return false
		}
		// v0.2: a generic enum qualifies patterns on its instances
		// (Option.Some(x) on an Option[u32]); the variant comes from the
		// instance.
		if namedOrigin(t) == qt && isEnum { // qt != 0
			qe = en
		} else if qt != t {
			errAt(E2002, p, formatTo(mbuf[:], "pattern of type %v does not match scrutinee of type %v", TypeRef(qt), TypeRef(t)))
			return false
		}
		v, found := variantByName(qe, nm)
		if !found {
			errAt(E2001, name, formatTo(mbuf[:], "enum %v has no variant %v", TypeRef(qt), NameRef(nm)))
			return false
		}
		venum = qe
		vi = v
	} else if isEnum {
		v, found := variantByName(en, nm)
		if !found {
			errAt(E2001, name, formatTo(mbuf[:], "undefined: %v (no constant or variant of %v)", NameRef(nm), TypeRef(t)))
			return false
		}
		venum = en
		vi = v
	} else {
		errAt(E2001, name, formatTo(mbuf[:], "undefined: %v", NameRef(nm)))
		return false
	}
	nvarEnum[usize(p)] = venum
	nvarIdx[usize(p)] = u32(vi)
	ntype[usize(p)] = t
	if q == 0 && !nflag(p) {
		// A name declared by the resolver for a bare variant is bound to
		// the value (which is that variant).
		bs := defs[usize(name)]
		if bs != 0 && syms.items[usize(bs)].typ == 0 {
			setSymType(bs, t)
		}
	}
	c := l1len(p)
	nargs := c
	rest := false
	for i := usize(0); i < c; i++ {
		a := l1at(p, i)
		if nkind(a) == NkRestPattern {
			if rest {
				errAt(E2002, a, formatTo(mbuf[:], "at most one '..' is allowed in a payload list"))
				return false
			}
			nargs--
			rest = true
		}
	}
	npay := variantPayN(venum, vi)
	if (!rest && nargs != npay) || (rest && nargs > npay) || (nflag(p) && npay == 0 && !rest) {
		errAt(E2003, p, formatTo(mbuf[:], "variant %v has %d payload values, pattern binds %d", NameRef(nm), npay, nargs))
		return false
	}
	valid := true
	for i := usize(0); i < c; i++ {
		a := l1at(p, i)
		if nkind(a) == NkRestPattern {
			continue
		}
		if !pat(a, variantPay(venum, vi, payloadIndex(p, i, npay)), true, dp-1) {
			valid = false
		}
	}
	return valid
}

// PatRef renders a pattern (ast.Format of a pattern).
type PatRef u32

func (p PatRef) Format(dst []byte) usize {
	o := &fmtBuf
	o.Reset()
	writePattern(o, u32(p), SemaDepth)
	return fmtOut(dst)
}

// writePattern writes the canonical source of a pattern.
func writePattern(o *OutBuf, p u32, dp usize) decreases(dp) {
	if dp == 0 || p == 0 {
		return
	}
	k := nkind(p)
	if k == NkWildcardPattern {
		o.WriteString("_")
	} else if k == NkRestPattern {
		o.WriteString("..")
	} else if k == NkIdent {
		o.WriteBytes(ntext(p))
	} else if k == NkLiteralPattern {
		writeExpr(o, na(p), dp-1)
	} else if k == NkCtorPattern {
		if na(p) != 0 {
			o.WriteBytes(ntext(na(p)))
			o.WriteString(".")
		}
		o.WriteBytes(ntext(nb(p)))
		if nflag(p) {
			o.WriteString("(")
			c := l1len(p)
			for i := usize(0); i < c; i++ {
				if i > 0 {
					o.WriteString(", ")
				}
				writePattern(o, l1at(p, i), dp-1)
			}
			o.WriteString(")")
		}
	} else if k == NkOrPattern {
		c := l1len(p)
		for i := usize(0); i < c; i++ {
			if i > 0 {
				o.WriteString(" | ")
			}
			a := l1at(p, i)
			if nkind(a) == NkAtPattern {
				o.WriteString("(")
				writePattern(o, a, dp-1)
				o.WriteString(")")
			} else {
				writePattern(o, a, dp-1)
			}
		}
	} else if k == NkAtPattern {
		o.WriteBytes(ntext(na(p)))
		o.WriteString(" @ ")
		if nkind(nb(p)) == NkOrPattern {
			o.WriteString("(")
			writePattern(o, nb(p), dp-1)
			o.WriteString(")")
		} else {
			writePattern(o, nb(p), dp-1)
		}
	} else if k == NkTuplePattern {
		o.WriteString("(")
		c := l1len(p)
		for i := usize(0); i < c; i++ {
			if i > 0 {
				o.WriteString(", ")
			}
			writePattern(o, l1at(p, i), dp-1)
		}
		o.WriteString(")")
	}
}

// ---------------------------------------------------------------------------
// Reachability and exhaustiveness: pattern usefulness (Maranget, "Warnings
// for pattern matching"), see finc0's types/usefulness.go for the
// algorithm. A matrix is a block of rows on uStk (row-major, ncols node
// IDs per row, 0 = wildcard); column types are a run on uCol. Matrices and
// column runs are built LIFO above their sources and popped after use.

const (
	MaxUStack       = 65_536
	MaxUCols        = 65536
	MaxUSeen        = 262_144
	MaxWCells       = 32_768
	MaxWRows        = 65536
	MaxPatternDepth = 1000 // fuel: useful/witnesses give up (useful, exhaustive)
	MaxWitnesses    = 32   // listed missing patterns (more: ", ...")
)

// head kinds
const (
	HWild = 0
	HCtor = 1
	HLit  = 2
	HOr   = 3
)

var uStk [MaxUStack]u32
var uTop usize
var uCol [MaxUCols]u32
var uColTop usize
var uSeen [MaxUSeen]bool
var uSeenTop usize

// Witnesses: cons cells (token, next) and a stack of row heads.
// wKind: 0 wildcard, 1 constructor, 2 constructor missing from its column.
var wKind [MaxWCells]u8
var wTy [MaxWCells]u32
var wC [MaxWCells]u32
var wNext [MaxWCells]u32
var wTop usize
var wRows [MaxWRows]u32
var wRowTop usize

func uPush(x u32) {
	if uTop >= MaxUStack {
		setFull("pattern matrix")
		return
	}
	uStk[uTop] = x
	uTop++
}

func uColPush(t u32) {
	if uColTop >= MaxUCols {
		setFull("pattern columns")
		return
	}
	uCol[uColTop] = t
	uColTop++
}

// uCtorCount returns the number of constructors of a finite column type (0
// for infinite domains).
func uCtorCount(t u32) usize {
	if isBoolean(t) {
		return 2
	}
	return nvariants(underlying(t)) // 0 for other types
}

// uArity returns the number of payloads of constructor c of t.
func uArity(t u32, c usize) usize {
	return variantPayN(underlying(t), c) // 0 for other types
}

func uArgType(t u32, c usize, j usize) u32 {
	return variantPay(underlying(t), c, j)
}

// uHead classifies the pattern p of a column of type t: kind, constructor
// and literal value slot.
func uHead(p u32, t u32) (u8, usize, u32) {
	if p == 0 {
		return HWild, 0, 0
	}
	k := nkind(p)
	if k is NkIdent | NkCtorPattern {
		// A variant (or a constant of enum type), a constant, or a
		// binding (a wildcard).
		if nvarEnum[usize(p)] != 0 {
			return HCtor, usize(nvarIdx[usize(p)]), 0
		}
		cs := patConst(p)
		if cs != 0 {
			return uLitHead(cs, t)
		}
		return HWild, 0, 0
	}
	if k == NkLiteralPattern {
		return uLitHead(nval[usize(na(p))], t)
	}
	if k == NkOrPattern {
		return HOr, 0, 0
	}
	return HWild, 0, 0
}

func uLitHead(s u32, t u32) (u8, usize, u32) {
	if slotGet(s) is Bool(b) && isBoolean(t) {
		if b {
			return HCtor, 0, 0
		}
		return HCtor, 1, 0
	}
	return HLit, 0, s
}

// uPushArgs pushes the a sub-patterns of head p for specialization.
func uPushArgs(p u32, a usize) {
	base := uTop
	for j := usize(0); j < a; j++ {
		uPush(0)
	}
	if p == 0 || nkind(p) != NkCtorPattern || nvarEnum[usize(p)] == 0 || uTop != base+a {
		return
	}
	c := l1len(p)
	for i := usize(0); i < c; i++ {
		x := l1at(p, i)
		if nkind(x) == NkRestPattern {
			continue
		}
		uStk[base+payloadIndex(p, i, a)] = stripAt(x)
	}
}

// uSpecRow pushes the rows of S(c, P) (kind HCtor, arity a) or S(v, P)
// (kind HLit, value slot v) produced by the row at offset row of width w
// whose head is h (or-pattern heads are expanded). It returns the number
// of rows pushed.
func uSpecRow(row usize, w usize, h u32, t u32, kind u8, c usize, v u32, a usize, depth usize) usize decreases(depth) {
	if depth == 0 {
		return 0
	}
	k, rc, rv := uHead(h, t)
	if k == HOr {
		n := usize(0)
		m := l1len(h)
		for i := usize(0); i < m; i++ {
			n += uSpecRow(row, w, stripAt(l1at(h, i)), t, kind, c, v, a, depth-1)
		}
		return n
	}
	if k == HWild {
		for j := usize(0); j < a; j++ {
			uPush(0)
		}
	} else if k == HCtor && kind == HCtor && rc == c {
		uPushArgs(h, a)
	} else if k == HLit && kind == HLit && valsEqual(slotGet(rv), slotGet(v)) {
	} else {
		return 0
	}
	for j := usize(1); j < w; j++ {
		uPush(uStk[row+j])
	}
	return 1
}

// uSpecialize pushes S(c, P) / S(v, P) of the matrix at offset at (rows,
// width w, first column type t) and returns its row count.
func uSpecialize(at usize, rows usize, w usize, t u32, kind u8, c usize, v u32) usize {
	a := usize(0)
	if kind == HCtor {
		a = uArity(t, c)
	}
	n := usize(0)
	for r := usize(0); r < rows; r++ {
		row := at + r*w
		n += uSpecRow(row, w, uStk[row], t, kind, c, v, a, MaxPatternDepth)
	}
	return n
}

// uDefRow pushes the rows of D(P) produced by one row (head h).
func uDefRow(row usize, w usize, h u32, t u32, depth usize) usize decreases(depth) {
	if depth == 0 {
		return 0
	}
	k, _, _ := uHead(h, t)
	if k == HOr {
		n := usize(0)
		m := l1len(h)
		for i := usize(0); i < m; i++ {
			n += uDefRow(row, w, stripAt(l1at(h, i)), t, depth-1)
		}
		return n
	}
	if k != HWild {
		return 0
	}
	for j := usize(1); j < w; j++ {
		uPush(uStk[row+j])
	}
	return 1
}

// uDefaults pushes the default matrix D(P) and returns its row count.
func uDefaults(at usize, rows usize, w usize, t u32) usize {
	n := usize(0)
	for r := usize(0); r < rows; r++ {
		row := at + r*w
		n += uDefRow(row, w, uStk[row], t, MaxPatternDepth)
	}
	return n
}

// uMarkHead marks the constructors of head h in uSeen[base:] and returns
// how many were new.
func uMarkHead(h u32, t u32, base usize, depth usize) usize decreases(depth) {
	if depth == 0 {
		return 0
	}
	k, c, _ := uHead(h, t)
	if k == HOr {
		n := usize(0)
		m := l1len(h)
		for i := usize(0); i < m; i++ {
			n += uMarkHead(stripAt(l1at(h, i)), t, base, depth-1)
		}
		return n
	}
	if k == HCtor && !uSeen[base+c] {
		uSeen[base+c] = true
		return 1
	}
	return 0
}

// uPresent allocates n flags on uSeen marking the constructors heading a
// row of the matrix and returns the base offset and the count of distinct
// constructors (the caller pops uSeenTop).
func uPresent(at usize, rows usize, w usize, t u32, n usize) (usize, usize) {
	base := uSeenTop
	if uSeenTop+n > MaxUSeen {
		setFull("pattern constructors")
		return base, 0
	}
	for i := usize(0); i < n; i++ {
		uSeen[base+i] = false
	}
	uSeenTop += n
	cnt := usize(0)
	for r := usize(0); r < rows; r++ {
		cnt += uMarkHead(uStk[at+r*w], t, base, MaxPatternDepth)
	}
	return base, cnt
}

// uPushCols pushes the column run [args of c of t, cols[cs+1:cs+cn]].
func uPushCols(t u32, c usize, a usize, cs usize, cn usize) {
	for j := usize(0); j < a; j++ {
		uColPush(uArgType(t, c, j))
	}
	for j := usize(1); j < cn; j++ {
		uColPush(uCol[cs+j])
	}
}

// useful reports whether the row q (offset qa on uStk, width w) is useful
// with respect to the matrix at (at, rows) with column types cs..cs+w.
func useful(at usize, rows usize, qa usize, w usize, cs usize, depth usize) bool decreases(depth) {
	if depth == 0 {
		return true
	}
	if w == 0 {
		return rows == 0
	}
	t := uCol[cs]
	q0 := uStk[qa]
	k, c, v := uHead(q0, t)
	um := uTop
	cm := uColTop
	r := false
	if k == HOr {
		m := l1len(q0)
		for i := usize(0); i < m; i++ {
			na2 := uTop
			uPush(stripAt(l1at(q0, i)))
			for j := usize(1); j < w; j++ {
				uPush(uStk[qa+j])
			}
			if useful(at, rows, na2, w, cs, depth-1) {
				r = true
				break
			}
			uTop = na2
		}
	} else if k == HCtor {
		a := uArity(t, c)
		sa := uTop
		sn := uSpecialize(at, rows, w, t, HCtor, c, 0)
		nq := uTop
		uPushArgs(q0, a)
		for j := usize(1); j < w; j++ {
			uPush(uStk[qa+j])
		}
		ncs := uColTop
		uPushCols(t, c, a, cs, w)
		r = useful(sa, sn, nq, a+w-1, ncs, depth-1)
	} else if k == HLit {
		sa := uTop
		sn := uSpecialize(at, rows, w, t, HLit, 0, v)
		nq := uTop
		for j := usize(1); j < w; j++ {
			uPush(uStk[qa+j])
		}
		r = useful(sa, sn, nq, w-1, cs+1, depth-1)
	} else {
		n := uCtorCount(t)
		complete := false
		if n > 0 {
			sb := uSeenTop
			_, cnt := uPresent(at, rows, w, t, n)
			uSeenTop = sb
			complete = cnt == n
		}
		if complete {
			for ci := usize(0); ci < n; ci++ {
				a := uArity(t, ci)
				sa := uTop
				sn := uSpecialize(at, rows, w, t, HCtor, ci, 0)
				nq := uTop
				for j := usize(0); j < a; j++ {
					uPush(0)
				}
				for j := usize(1); j < w; j++ {
					uPush(uStk[qa+j])
				}
				ncs := uColTop
				uPushCols(t, ci, a, cs, w)
				ok := useful(sa, sn, nq, a+w-1, ncs, depth-1)
				uTop = sa
				uColTop = ncs
				if ok {
					r = true
					break
				}
			}
		} else {
			da := uTop
			dn := uDefaults(at, rows, w, t)
			nq := uTop
			for j := usize(1); j < w; j++ {
				uPush(uStk[qa+j])
			}
			r = useful(da, dn, nq, w-1, cs+1, depth-1)
		}
	}
	uTop = um
	uColTop = cm
	return r
}

// wCell allocates a witness cell.
func wCell(kind u8, t u32, c u32, next u32) u32 {
	if wTop >= MaxWCells {
		setFull("pattern witnesses")
		return 0
	}
	wKind[wTop] = kind
	wTy[wTop] = t
	wC[wTop] = c
	wNext[wTop] = next
	wTop++
	return u32(wTop - 1)
}

func wPushRow(h u32) {
	if wRowTop >= MaxWRows {
		setFull("pattern witnesses")
		return
	}
	wRows[wRowTop] = h
	wRowTop++
}

// witnesses pushes up to limit witness rows (cons lists in preorder)
// matched by no row of the matrix and returns their count. top is set for
// the single column of a non-tuple scrutinee. Rows produced by recursive
// calls are moved down so the result is the topmost count rows.
func witnesses(at usize, rows usize, w usize, cs usize, top bool, limit usize, depth usize) usize decreases(depth) {
	if depth == 0 || limit == 0 {
		return 0
	}
	if w == 0 {
		if rows == 0 {
			wPushRow(0)
			return 1
		}
		return 0
	}
	t := uCol[cs]
	n := uCtorCount(t)
	um := uTop
	cm := uColTop
	sb := uSeenTop
	out := wRowTop
	base, cnt := uPresent(at, rows, w, t, n)
	if n == 0 || (cnt == 0 && !top) {
		da := uTop
		dn := uDefaults(at, rows, w, t)
		k := witnesses(da, dn, w-1, cs+1, false, limit, depth-1)
		for i := usize(0); i < k; i++ {
			wRows[out+i] = wCell(0, 0, 0, wRows[out+i])
		}
		uTop = um
		uColTop = cm
		uSeenTop = sb
		return k
	}
	// Witnesses of the default matrix (for missing constructors).
	dk := usize(0)
	dpos := wRowTop
	if cnt < n {
		da := uTop
		dn := uDefaults(at, rows, w, t)
		dk = witnesses(da, dn, w-1, cs+1, false, limit, depth-1)
		uTop = da
	}
	res := wRowTop // result rows are built from here, then moved to out
	for c := usize(0); c < n; c++ {
		if wRowTop-res >= limit {
			break
		}
		a := uArity(t, c)
		if uSeen[base+c] {
			sa := uTop
			sn := uSpecialize(at, rows, w, t, HCtor, c, 0)
			ncs := uColTop
			uPushCols(t, c, a, cs, w)
			cpos := wRowTop
			k := witnesses(sa, sn, a+w-1, ncs, false, limit-(wRowTop-res), depth-1)
			for i := usize(0); i < k; i++ {
				wRows[cpos+i] = wCell(1, t, u32(c), wRows[cpos+i])
			}
			uTop = sa
			uColTop = ncs
			continue
		}
		for i := usize(0); i < dk; i++ {
			if wRowTop-res >= limit {
				break
			}
			h := wRows[dpos+i]
			for j := usize(0); j < a; j++ {
				h = wCell(0, 0, 0, h)
			}
			wPushRow(wCell(2, t, u32(c), h))
		}
	}
	k := wRowTop - res
	for i := usize(0); i < k; i++ {
		wRows[out+i] = wRows[res+i]
	}
	wRowTop = out + k
	uTop = um
	uColTop = cm
	uSeenTop = sb
	return k
}

// renderTok writes the witness subtree at cell h and returns the cell
// after it. At the top of a non-tuple scrutinee a missing variant whose
// payloads are all wildcards is written by name.
func renderTok(o *OutBuf, h u32, top bool, depth usize) u32 decreases(depth) {
	if depth == 0 || h == 0 {
		return 0
	}
	kind := wKind[usize(h)]
	next := wNext[usize(h)]
	if kind == 0 {
		o.WriteString("_")
		return next
	}
	t := wTy[usize(h)]
	c := usize(wC[usize(h)])
	u := underlying(t)
	if !isEnumT(u) {
		o.WriteString(match c {
			0 -> "true"
			_ -> "false"
		})
		return next
	}
	a := variantPayN(u, c)
	nm := variantName(u, c)
	if a == 0 {
		o.WriteBytes(nameBytes(nm))
		return next
	}
	if top && kind == 2 {
		allWild := true
		x := next
		for j := usize(0); j < a; j++ {
			if x == 0 || wKind[usize(x)] != 0 {
				allWild = false
				break
			}
			x = wNext[usize(x)]
		}
		if allWild {
			o.WriteBytes(nameBytes(nm))
			return x
		}
	}
	o.WriteBytes(nameBytes(nm))
	o.WriteString("(")
	x := next
	for j := usize(0); j < a; j++ {
		if j > 0 {
			o.WriteString(", ")
		}
		x = renderTok(o, x, false, depth-1)
	}
	o.WriteString(")")
	return x
}

// checkCoverage reports unreachable arms and patterns and non-exhaustive
// matches (E2012) of match m on type t. It reports whether the unguarded
// arms cover every value.
func checkCoverage(m u32, t u32, isExpr bool) bool {
	uTop = 0
	uColTop = 0
	uSeenTop = 0
	wTop = 1 // cell 0 is the empty list
	wRowTop = 0
	isTuple := false
	w := usize(1)
	if trec(t) is Tuple(ts, tn) {
		isTuple = true
		w = usize(tn)
		for i := usize(0); i < w; i++ {
			uColPush(tlist(ts, i))
		}
	} else {
		uColPush(t)
	}
	rows := usize(0) // rows of the earlier unguarded arms, at offset 0
	wild := u32(0)   // the unguarded catch-all arm's pattern ('_' or a binding)
	n := l1len(m)
	for i := usize(0); i < n; i++ {
		arm := l1at(m, i)
		pat := na(arm)
		if wild != 0 {
			if nkind(wild) == NkWildcardPattern {
				errAt(E2012, pat, formatTo(mbuf[:], "unreachable match arm: it follows the '_' arm"))
			} else {
				errAt(E2012, pat, formatTo(mbuf[:], "unreachable match arm: it follows the catch-all binding %v", NameRef(idName(catchAllName(wild)))))
			}
			continue
		}
		armRows := usize(0)
		na2 := patAltN(pat)
		for j := usize(0); j < na2; j++ {
			alt := patAlt(pat, j)
			qa := uTop
			uPushRow(alt, w, isTuple)
			// The matrix is rows + armRows rows at offset 0; the
			// alternative's row is above it.
			if !useful(0, rows+armRows, qa, w, 0, MaxPatternDepth) {
				reportUnreachable(alt, t)
			}
			armRows++
		}
		if nd(arm) == 0 {
			rows += armRows
			if catchAll(pat) {
				wild = pat
			}
		} else {
			uTop = rows * w
		}
	}
	k := witnesses(0, rows, w, 0, !isTuple, MaxWitnesses+1, MaxPatternDepth)
	if k == 0 {
		return true
	}
	u := underlying(t)
	if isEnumT(u) || isTuple {
		ml := formatTo(mbuf[:], "non-exhaustive match on %v: missing ", TypeRef(t))
		o := &fmtBuf
		o.Reset()
		lim := k
		if lim > MaxWitnesses {
			lim = MaxWitnesses
		}
		for i := usize(0); i < lim; i++ {
			if i > 0 {
				o.WriteString(", ")
			}
			h := wRows[i]
			if isTuple {
				o.WriteString("(")
				for j := usize(0); j < w; j++ {
					if j > 0 {
						o.WriteString(", ")
					}
					h = renderTok(o, h, false, MaxPatternDepth)
				}
				o.WriteString(")")
			} else {
				_ = renderTok(o, h, true, MaxPatternDepth)
			}
		}
		if k > MaxWitnesses {
			o.WriteString(", ...")
		}
		ml += copy(mbuf[ml:], o.Bytes())
		errAt(E2012, m, ml)
	} else if isExpr {
		errAt(E2012, m, formatTo(mbuf[:], "non-exhaustive match expression on %v: missing '_' arm", TypeRef(t)))
	}
	return false
}

// uPushRow pushes the matrix row of an arm alternative.
func uPushRow(alt0 u32, w usize, isTuple bool) {
	alt := stripAt(alt0)
	if !isTuple {
		uPush(alt)
		return
	}
	if nkind(alt) == NkTuplePattern && l1len(alt) == w {
		for i := usize(0); i < w; i++ {
			uPush(stripAt(l1at(alt, i)))
		}
		return
	}
	for i := usize(0); i < w; i++ {
		uPush(0)
	}
}

// reportUnreachable reports an alternative that matches no value left by
// the earlier arms.
func reportUnreachable(alt0 u32, t u32) {
	if nkind(alt0) == NkAtPattern && catchAll(alt0) {
		// v0.2: `x @ P` is reported as the binding x if P matches every
		// value, else as P.
		if isEnumT(underlying(t)) {
			errAt(E2012, alt0, formatTo(mbuf[:], "unreachable binding %v: all variants of %v are covered", NameRef(idName(na(alt0))), TypeRef(t)))
		} else {
			errAt(E2012, alt0, formatTo(mbuf[:], "unreachable binding %v: all values of %v are covered", NameRef(idName(na(alt0))), TypeRef(t)))
		}
		return
	}
	alt := stripAt(alt0)
	k := nkind(alt)
	if k == NkWildcardPattern {
		if isEnumT(underlying(t)) {
			errAt(E2012, alt, formatTo(mbuf[:], "unreachable '_' arm: all variants of %v are covered", TypeRef(t)))
		} else {
			errAt(E2012, alt, formatTo(mbuf[:], "unreachable '_' arm: all values of %v are covered", TypeRef(t)))
		}
		return
	}
	if k == NkCtorPattern {
		if nvarEnum[usize(alt)] != 0 {
			if flatArgs(alt) {
				errAt(E2012, alt, formatTo(mbuf[:], "unreachable pattern: variant %v is already covered", NameRef(variantName(nvarEnum[usize(alt)], usize(nvarIdx[usize(alt)])))))
				return
			}
		} else if isBindingPat(alt) {
			if isEnumT(underlying(t)) {
				errAt(E2012, alt, formatTo(mbuf[:], "unreachable binding %v: all variants of %v are covered", NameRef(idName(nb(alt))), TypeRef(t)))
			} else {
				errAt(E2012, alt, formatTo(mbuf[:], "unreachable binding %v: all values of %v are covered", NameRef(idName(nb(alt))), TypeRef(t)))
			}
			return
		} else {
			errAt(E2012, alt, formatTo(mbuf[:], "unreachable pattern: duplicate case %v", Expr(nb(alt))))
			return
		}
	} else if k == NkLiteralPattern {
		errAt(E2012, alt, formatTo(mbuf[:], "unreachable pattern: duplicate case %v", Expr(na(alt))))
		return
	}
	errAt(E2012, alt, formatTo(mbuf[:], "unreachable pattern: it is covered by earlier patterns"))
}

// flatArgs reports whether the payload patterns of p are all bindings, '_'
// or '..'.
func flatArgs(p u32) bool {
	c := l1len(p)
	for i := usize(0); i < c; i++ {
		a := l1at(p, i)
		k := nkind(a)
		if k == NkIdent {
			if nvarEnum[usize(a)] != 0 || patConst(a) != 0 {
				return false
			}
		} else if k != NkRestPattern {
			return false
		}
	}
	return true
}
