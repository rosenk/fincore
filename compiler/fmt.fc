// fmt.fc — `finc fmt`, the canonical FinCore source formatter.
//
//	finc fmt [-w] [-l] [-d] [--check] <file.fc | dir>...
//
// Without flags the formatted source is written to stdout. -w rewrites
// files whose formatting differs, -l lists them, -d prints a unified diff
// (diff -u through /bin/sh), and --check lists them and fails if there are
// any. A directory is formatted recursively (its .fc files, then its
// subdirectories in name order; hidden directories are skipped).
//
// The formatter works on the token stream, not on a re-printed AST: every
// token is kept with its spelling, and line breaks are taken from the
// source. What it decides is the layout of each line. The rules
// (docs/fmt.md has the full list):
//
//   - indentation is one tab per open bracket line (a bracket opened on a
//     line indents the lines up to its closing bracket by one; several
//     brackets opened on the same line count once), plus one for the
//     continuation lines of a statement that ends a line with an operator
//     or a comma;
//   - spacing inside a line is canonical: one space around binary
//     operators, `:=`, `=`, `->`, `@`, `|` and after `,`, `;` and keywords;
//     no space after `(`, `[`, unary operators and type prefixes (`[]`,
//     `*`), before `)`, `]`, `,`, `;`, `:`, around `.`, in `T{a: 1}`;
//   - blank lines are kept, but at most one in a row; none at the start
//     and the end of the file;
//   - explicit statement `;` become line breaks; `match` arms go one per
//     line (a single-line match is split, `,` separators are dropped);
//   - columns are aligned with gofmt's elastic tabstops: field types in
//     struct types, `=` in const groups, values in multi-line struct
//     literals and trailing `//` comments of consecutive lines (a line
//     without the cell, a blank line, a comment-only line or a change of
//     indentation ends the block);
//   - comments come from the lexer's side table (lexer.fc, `comments`) and
//     stay where they are: trailing comments stay on their line, others on
//     their own line, indented like the code that follows.
//
// Every formatted file is parsed again and its AST dump compared with the
// original's, positions ignored; a difference is an internal error and the
// file is left unchanged.
package main

const (
	MaxFmtLines = 131_072
	MaxFmtCells = 4
	MaxFmtStack = 4096
	MaxFmtFiles = 8192
)

// Token classes (fmTcls), derived from the AST by fmClassify.
const (
	TcBinary   = 1    // a binary operator ('-', '*', '&' are unary otherwise)
	TcTypePre  = 2    // '[' or '*' that starts an array, slice or pointer type
	TcLitBrace = 4    // '{' of a struct literal
	TcMatch    = 8    // '{' of a match body
	TcSig      = 16   // '(' of a parameter list
	TcRecv     = 32   // '(' of a method receiver
	TcHdr      = 64   // first token of an if or for statement
	TcHdrEnd   = 128  // '{' of the body of an if or for statement
	TcMatchX   = 256  // '{' of a match expression body (with TcMatch)
	TcTight    = 512  // binary operator printed without blanks (fmBinSpacing)
	TcBlanks   = 1024 // ':' of a slice expression printed with blanks
)

// Open bracket kinds (FmtOpen.cls).
const (
	FoParen     = 1
	FoBrack     = 2
	FoTypeBrack = 3
	FoSig       = 4
	FoConst     = 5 // const ( ... )
	FoImport    = 6 // import ( ... )
	FoBlock     = 7
	FoLit       = 8
	FoMatch     = 9
	FoStruct    = 10
	FoEnum      = 11
	FoMatchX    = 12 // match expression: arms separated by ',' or ';'
)

// Alignment rows (lines whose first token starts a row at the row's
// bracket level).
const (
	RowNone  = 0
	RowField = 1 // struct field: names | type
	RowSpec  = 2 // const spec: names | type | = values
	RowKey   = 3 // struct literal field: key: | value
)

const TkComment = 200 // pseudo token kind: the previous item is a block comment

// FmtLine is one output line: indentation, text span in fmText and the ends
// of its terminated alignment cells.
type FmtLine struct {
	start  u32
	n      u32
	indent u32
	nc     u32
	cell   [MaxFmtCells]u32
	width  [MaxFmtCells]u32
	raw    bool // contains a multi-line block comment: not aligned
}

type FmtOpen struct {
	kind u8
	cls  u8
	base u32 // indentation of the opener's line
}

var fmLines [MaxFmtLines]FmtLine
var fmNLines usize
var fmText OutBuf
var fmOut OutBuf
var fmDump OutBuf
var fmTcls [MaxTokens]u16
var fmStack [MaxFmtStack]FmtOpen
var fmSP usize
var fmHdr [MaxFmtStack]u32
var fmNHdr usize
var fmFull bool

// State of the token walk.
var fmBase usize    // offset of the file in sources.bytes
var fmStarted bool  // an item has been emitted
var fmPrevKind u8   // kind of the previous item (TkComment for a block comment)
var fmPrevCls u16   // its token classes
var fmPrevClose u8  // cls of the bracket the previous token closed (0: none)
var fmPrevEnd u32   // source line on which the previous item ended
var fmCont bool     // the previous code token continues its statement
var fmForceNL bool  // the next token starts a new line
var fmCurBase u32   // indentation of the current line without continuation
var fmCurInd u32    // indentation of the current line
var fmLineCode bool // the current line has a code token
var fmRow u8        // alignment row of the current line
var fmRowSP usize   // bracket depth of the row
var fmRowState u8
var fmNoSpace bool // a cell break replaces the next space

var fmDebug bool // $FINC_FMT_DEBUG: print the output of a failed verification

var fmFiles [MaxFmtFiles]string
var fmNFiles usize

// ---------------------------------------------------------------------------
// classification

// fmFind returns the index of the first non-virtual token at or after
// (line, col), or len(toks).
func fmFind(toks []Token, line u32, col u32) usize {
	lo := usize(0)
	hi := len(toks)
	for g := usize(0); g < 64; g++ {
		if lo >= hi {
			break
		}
		mid := lo + (hi-lo)/2
		t := toks[mid]
		if t.line < line || t.line == line && t.col < col {
			lo = mid + 1
		} else {
			hi = mid
		}
	}
	n := len(toks)
	for i := lo; i < n; i++ {
		t := toks[i]
		if t.kind != TkSemicolon || t.semi == SemiExplicit {
			return i
		}
	}
	return n
}

// fmMark sets class bit on the token found at (line, col) if it has one of
// the kinds k1, k2, k3 (exact: it must start there).
func fmMark(toks []Token, line u32, col u32, bit u16, exact bool, k1 u8, k2 u8, k3 u8) {
	i := fmFind(toks, line, col)
	if i >= len(toks) {
		return
	}
	t := toks[i]
	if exact && (t.line != line || t.col != col) {
		return
	}
	if t.kind == k1 || t.kind == k2 || t.kind == k3 {
		fmTcls[i] = fmTcls[i] | bit
	}
}

// fmClassify computes fmTcls for the tokens of the file whose nodes are
// nodes.items[n0:].
func fmClassify(toks []Token, n0 usize) {
	nt := len(toks)
	for i := usize(0); i < nt; i++ {
		fmTcls[i] = 0
	}
	cnt := nodes.count
	for i := n0; i < cnt; i++ {
		n := nodes.items[i]
		match n.kind {
			NkBinaryExpr -> fmMark(toks, u32(n.ival>>32), u32(n.ival&0xFFFFFFFF), TcBinary, true, TkSub, TkMul, TkAnd)
			NkArrayType | NkSliceType | NkPointerType -> fmMark(toks, n.sLine, n.sCol, TcTypePre, true, TkLBrack, TkMul, TkLBrack)
			NkStructLit -> {
				a := nodes.items[usize(n.a)]
				fmMark(toks, a.eLine, a.eCol, TcLitBrace, false, TkLBrace, TkLBrace, TkLBrace)
			}
			NkMatchStmt -> {
				a := nodes.items[usize(n.a)]
				fmMark(toks, a.eLine, a.eCol, TcMatch, false, TkLBrace, TkLBrace, TkLBrace)
			}
			NkMatchExpr -> {
				a := nodes.items[usize(n.a)]
				fmMark(toks, a.eLine, a.eCol, TcMatch|TcMatchX, false, TkLBrace, TkLBrace, TkLBrace)
			}
			NkSignature -> fmMark(toks, n.sLine, n.sCol, TcSig, true, TkLParen, TkLParen, TkLParen)
			NkReceiver -> fmMark(toks, n.sLine, n.sCol, TcRecv, true, TkLParen, TkLParen, TkLParen)
			NkIfStmt -> {
				fmMark(toks, n.sLine, n.sCol, TcHdr, true, TkIf, TkIf, TkIf)
				b := nodes.items[usize(n.c)]
				fmMark(toks, b.sLine, b.sCol, TcHdrEnd, true, TkLBrace, TkLBrace, TkLBrace)
			}
			NkForStmt -> {
				fmMark(toks, n.sLine, n.sCol, TcHdr, true, TkFor, TkDriver, TkFor)
				b := nodes.items[usize(n.e)]
				fmMark(toks, b.sLine, b.sCol, TcHdrEnd, true, TkLBrace, TkLBrace, TkLBrace)
			}
			_ -> {}
		}
	}
}

// fmMarkAny sets class bit on the token that starts exactly at (line, col).
func fmMarkAny(toks []Token, line u32, col u32, bit u16) {
	i := fmFind(toks, line, col)
	if i < len(toks) && toks[i].line == line && toks[i].col == col {
		fmTcls[i] = fmTcls[i] | bit
	}
}

// ---------------------------------------------------------------------------
// binary operator spacing: gofmt's precedence rule (go/printer: binaryExpr,
// cutoff, walkBinary), with FinCore's precedence levels mapped onto Go's.

// fmGoPrec maps binOpPrec (1 ||, 2 &&, 3 == !=, 4 < <= > >=, 5 + - | ^,
// 6 * / % & << >>) to Go's levels (3 for every comparison).
func fmGoPrec(op u8) u8 {
	p := binOpPrec(op)
	if p >= 4 {
		return p - 1
	}
	return p
}

// fmWalkBin is go/printer's walkBinary: whether e mixes additive (4) and
// multiplicative (5) operators, and the precedence an operator needs to
// keep its blanks so that no two tokens fuse (`a / *p`, `a - -b`).
func fmWalkBin(e u32, dp usize) (bool, bool, u8) decreases(dp) {
	if dp == 0 {
		return false, false, 0
	}
	n := nodes.items[usize(e)]
	pr := fmGoPrec(n.op)
	has4 := pr == 4
	has5 := pr == 5
	mp := u8(0)
	l := nodes.items[usize(n.a)]
	if l.kind == NkBinaryExpr && fmGoPrec(l.op) >= pr {
		h4, h5, m := fmWalkBin(n.a, dp-1)
		has4 = has4 || h4
		has5 = has5 || h5
		if m > mp {
			mp = m
		}
	}
	r := nodes.items[usize(n.b)]
	if r.kind == NkBinaryExpr && fmGoPrec(r.op) > pr {
		h4, h5, m := fmWalkBin(n.b, dp-1)
		has4 = has4 || h4
		has5 = has5 || h5
		if m > mp {
			mp = m
		}
	} else if r.kind == NkUnaryExpr {
		if n.op == OpDiv && r.op == OpDeref || n.op == OpAnd && r.op == OpAddr {
			mp = 5
		} else if n.op == OpSub && r.op == OpNeg && mp < 4 {
			mp = 4
		}
	}
	return has4, has5, mp
}

func fmCutoff(e u32, depth u32) u8 {
	has4, has5, mp := fmWalkBin(e, WalkDepth)
	if mp > 0 {
		return mp + 1
	}
	if has4 && has5 {
		if depth == 1 {
			return 5
		}
		return 4
	}
	if depth == 1 {
		return 6
	}
	return 4
}

func fmIsExpr(k u8) bool {
	return k is NkIdent | NkBasicLit | NkBoolLit | NkNilLit | NkBinaryExpr | NkUnaryExpr | NkParenExpr | NkCallExpr | NkIndexExpr | NkSliceExpr | NkSelectorExpr | NkFuncLit | NkStructLit | NkTypeExpr | NkMatchExpr | NkTupleExpr | NkIsExpr
}

// fmExprList walks the expressions of a list at depth.
func fmExprList(toks []Token, s u32, cnt u32, depth u32, dp usize) decreases(dp) {
	if dp == 0 {
		return
	}
	m := usize(cnt)
	for i := usize(0); i < m; i++ {
		fmExpr(toks, nodes.listItem(s, i), depth, dp-1)
	}
}

// fmExpr walks expression e printed at depth (go/printer's expr1).
func fmExpr(toks []Token, e u32, depth u32, dp usize) decreases(dp) {
	if dp == 0 || e == 0 {
		return
	}
	n := nodes.items[usize(e)]
	match n.kind {
		NkBinaryExpr -> {
			d := depth
			if d < 1 {
				d = 1
			}
			pr := fmGoPrec(n.op)
			if pr >= fmCutoff(e, d) {
				fmMarkAny(toks, u32(n.ival>>32), u32(n.ival&0xFFFFFFFF), TcTight)
			}
			l := nodes.items[usize(n.a)]
			dx := d + 1
			if l.kind == NkBinaryExpr && fmGoPrec(l.op) == pr {
				dx = d
			}
			fmExpr(toks, n.a, dx, dp-1)
			fmExpr(toks, n.b, d+1, dp-1)
		}
		NkUnaryExpr | NkSelectorExpr -> fmExpr(toks, n.a, depth, dp-1)
		NkParenExpr -> {
			d := u32(1)
			if depth > 1 {
				d = depth - 1
			}
			fmExpr(toks, n.a, d, dp-1)
		}
		NkCallExpr | NkTupleExpr -> {
			d := depth
			if n.l1n > 1 {
				d++
			}
			fmExpr(toks, n.a, d, dp-1)
			fmExprList(toks, n.l1s, n.l1n, d, dp-1)
		}
		NkIndexExpr -> {
			fmExpr(toks, n.a, 1, dp-1)
			fmExprList(toks, n.l1s, n.l1n, depth+1, dp-1)
		}
		NkSliceExpr -> {
			fmExpr(toks, n.a, 1, dp-1)
			if depth <= 1 && n.b != 0 && n.c != 0 && (nkind(n.b) == NkBinaryExpr || nkind(n.c) == NkBinaryExpr) {
				lo := nodes.items[usize(n.b)]
				i := fmFind(toks, lo.eLine, lo.eCol)
				if i < len(toks) && toks[i].kind == TkColon {
					fmTcls[i] = fmTcls[i] | TcBlanks
				}
			}
			fmExpr(toks, n.b, depth+1, dp-1)
			fmExpr(toks, n.c, depth+1, dp-1)
		}
		NkIsExpr -> {
			fmExpr(toks, n.a, depth, dp-1)
			fmNode(toks, n.b, dp-1)
		}
		NkStructLit -> {
			fmNode(toks, n.a, dp-1)
			m := usize(n.l1n)
			for i := usize(0); i < m; i++ {
				fi := nodes.listItem(n.l1s, i)
				fmExpr(toks, nodes.items[usize(fi)].b, 1, dp-1)
			}
		}
		NkMatchExpr -> {
			fmExpr(toks, n.a, 1, dp-1)
			m := usize(n.l1n)
			for i := usize(0); i < m; i++ {
				fmNode(toks, nodes.listItem(n.l1s, i), dp-1)
			}
		}
		NkFuncLit | NkTypeExpr -> {
			fmNode(toks, n.a, dp-1)
			fmNode(toks, n.b, dp-1)
		}
		_ -> {}
	}
}

// fmNode walks a non-expression node: its expressions start at depth 1
// (2 for the operands of a multi-value assignment and of ++/--, and for
// generic type arguments).
func fmNode(toks []Token, id u32, dp usize) decreases(dp) {
	if dp == 0 || id == 0 {
		return
	}
	n := nodes.items[usize(id)]
	if fmIsExpr(n.kind) {
		fmExpr(toks, id, 1, dp-1)
		return
	}
	if n.kind is NkAssignStmt | NkShortVarDecl {
		d := u32(1)
		if n.l1n > 1 && n.l2n > 1 {
			d = 2
		}
		fmExprList(toks, n.l1s, n.l1n, d, dp-1)
		fmExprList(toks, n.l2s, n.l2n, d, dp-1)
		return
	}
	if n.kind == NkIncDecStmt {
		fmExpr(toks, n.a, 2, dp-1)
		return
	}
	for i := usize(0); i < MaxSlots; i++ {
		slot, _ := layout(n.kind, i)
		if slot == SlotNone {
			break
		}
		if slot >= SlotL1 {
			s, cnt := slotList(n, slot)
			if n.kind == NkNamedType {
				fmExprList(toks, s, cnt, 2, dp-1)
			} else {
				m := usize(cnt)
				for j := usize(0); j < m; j++ {
					fmNode(toks, nodes.listItem(s, j), dp-1)
				}
			}
		} else {
			fmNode(toks, slotChild(n, slot), dp-1)
		}
	}
}

// ---------------------------------------------------------------------------
// output lines

func fmCloseLine() {
	if fmNLines > 0 {
		i := fmNLines - 1
		fmLines[i].n = u32(fmText.Len()) - fmLines[i].start
	}
}

func fmAddLine(indent u32) {
	fmCloseLine()
	if fmNLines >= MaxFmtLines {
		fmFull = true
		return
	}
	var ln FmtLine
	ln.start = u32(fmText.Len())
	ln.indent = indent
	fmLines[fmNLines] = ln
	fmNLines++
}

// fmCurLen is the length of the current line so far.
func fmCurLen() u32 {
	if fmNLines == 0 {
		return 0
	}
	return u32(fmText.Len()) - fmLines[fmNLines-1].start
}

// fmCell terminates an alignment cell at the end of the current line; it
// returns false if the line cannot take another one.
func fmCell() bool {
	if fmNLines == 0 {
		return false
	}
	i := fmNLines - 1
	k := usize(fmLines[i].nc)
	if k >= MaxFmtCells || fmLines[i].raw {
		return false
	}
	fmLines[i].cell[k] = fmCurLen()
	fmLines[i].nc++
	return true
}

func fmTop() u8 {
	if fmSP == 0 {
		return 0
	}
	return fmStack[fmSP-1].cls
}

// fmStmtCtx reports whether the innermost bracket holds statements or
// declarations (where an unfinished line continues a statement).
func fmStmtCtx() bool {
	return fmTop() is 0 | FoBlock | FoMatch | FoMatchX | FoConst | FoImport | FoStruct | FoEnum
}

// fmBreak starts a new line before an item that is nl >= 1 lines below
// the previous one; closer is set for a closing bracket.
func fmBreak(nl u32, closer bool) {
	if nl > 1 {
		fmAddLine(0)
	}
	base := u32(0)
	if fmSP > 0 {
		base = fmStack[fmSP-1].base
		if !closer {
			base++
		}
	}
	ind := base
	if !closer && fmCont && fmStmtCtx() {
		ind++
	}
	fmAddLine(ind)
	fmCurBase = base
	fmCurInd = ind
	fmLineCode = false
	fmRow = RowNone
}

func fmFirstLine() {
	fmAddLine(0)
	fmCurBase = 0
	fmCurInd = 0
	fmLineCode = false
	fmRow = RowNone
	fmStarted = true
}

// ---------------------------------------------------------------------------
// spacing

func fmOperandEnd(k u8) bool {
	return k is TkIdent | TkInt | TkString | TkChar | TkRParen | TkRBrack | TkRBrace | TkTrue | TkFalse | TkNil
}

func fmPrefixOp(k u8, cls u16) bool {
	if k is TkNot | TkEllipsis {
		return true
	}
	if k is TkSub | TkMul | TkAnd {
		return cls&TcBinary == 0
	}
	return false
}

// fmSpace decides whether a space separates the previous item from token
// k (classes cls) on the same line; closing is the cls of the bracket k
// closes.
func fmSpace(k u8, cls u16, closing u8) bool {
	pk := fmPrevKind
	if pk is TkLParen | TkLBrack {
		return false
	}
	if pk == TkLBrace {
		return fmTop() != FoLit && k != TkRBrace
	}
	if k is TkRParen | TkRBrack {
		return false
	}
	if k == TkRBrace {
		return closing != FoLit
	}
	if k == TkColon {
		return cls&TcBlanks != 0
	}
	if k is TkComma | TkSemicolon {
		return false
	}
	if pk is TkComment | TkComma | TkSemicolon {
		return true
	}
	if pk == TkColon {
		return fmTop() != FoBrack || fmPrevCls&TcBlanks != 0
	}
	if cls&TcTight != 0 || fmPrevCls&TcTight != 0 {
		return false
	}
	if k == TkPeriod || pk == TkPeriod || k is TkInc | TkDec {
		return false
	}
	if pk == k && k is TkSub | TkAnd {
		return true // never `--` or `&&` from two unary operators
	}
	if fmPrefixOp(pk, fmPrevCls) {
		return false
	}
	if k == TkEllipsis {
		return pk == TkIdent
	}
	if pk == TkRBrack && fmPrevClose == FoTypeBrack {
		return false
	}
	if k == TkLParen {
		if cls&TcRecv != 0 || pk == TkRParen && fmPrevClose == FoSig {
			return true
		}
		if pk is TkFunc | TkDecreases {
			return false
		}
		return isKeyword(pk) || !fmOperandEnd(pk)
	}
	if k == TkLBrack {
		return cls&TcTypePre != 0 || !fmOperandEnd(pk)
	}
	if k == TkLBrace {
		return cls&TcLitBrace == 0
	}
	return true
}

// fmContTok reports whether a line ending with token k continues the
// statement on the next line.
func fmContTok(k u8) bool {
	if k < TkAdd || k > TkAt {
		return false
	}
	return !(k is TkRParen | TkRBrack | TkRBrace | TkInc | TkDec | TkSemicolon | TkLParen | TkLBrack | TkLBrace | TkDotDot)
}

// fmNext returns the kind and line of the first real token after ti.
func fmNext(toks []Token, ti usize) (u8, u32) {
	n := len(toks)
	for i := ti + 1; i < n; i++ {
		t := toks[i]
		if t.kind != TkSemicolon || t.semi == SemiExplicit {
			return t.kind, t.line
		}
	}
	return TkEOF, 0
}

// ---------------------------------------------------------------------------
// alignment rows

// fmStartRow is called for the first code token of a line.
func fmStartRow(toks []Token, ti usize, k u8) {
	fmRow = RowNone
	if k != TkIdent {
		return
	}
	top := fmTop()
	if top == FoStruct {
		fmRow = RowField
	} else if top == FoConst {
		fmRow = RowSpec
	} else if top == FoLit {
		nk, nl := fmNext(toks, ti)
		if nk == TkColon && nl == toks[ti].line {
			fmRow = RowKey
		}
	}
	fmRowSP = fmSP
	fmRowState = 1
}

// fmAlign is called before a token k that continues the current line; it
// returns true if it terminated a cell (which replaces the space).
func fmAlign(k u8) bool {
	if fmRow == RowNone || fmSP != fmRowSP || fmRowState == 3 {
		return false
	}
	if fmRow == RowKey {
		if fmRowState == 1 {
			if k == TkColon {
				fmRowState = 2
			} else {
				fmRowState = 3
			}
			return false
		}
		fmRowState = 3
		return fmCell()
	}
	// names: IDENT { "," IDENT }
	if fmRowState == 0 {
		if k == TkIdent {
			fmRowState = 1
		} else {
			fmRowState = 3
		}
		return false
	}
	if fmRowState == 1 {
		if k == TkComma {
			fmRowState = 0
			return false
		}
		if fmRow == RowSpec && k == TkAssign {
			fmRowState = 3
			_ = fmCell()
			return fmCell() // empty type cell
		}
		if fmRow == RowField {
			fmRowState = 3
		} else {
			fmRowState = 2
		}
		return fmCell()
	}
	// RowSpec, in the type
	if k == TkAssign {
		fmRowState = 3
		return fmCell()
	}
	return false
}

// ---------------------------------------------------------------------------
// the token walk

func fmText1(off u32, end u32) []byte {
	return sources.bytes[fmBase+usize(off) : fmBase+usize(end)]
}

// fmComment emits comment c.
func fmComment(c Comment) {
	text := fmText1(c.off, c.end)
	if !fmStarted {
		fmFirstLine()
	} else if c.line > fmPrevEnd {
		fmBreak(c.line-fmPrevEnd, false)
	} else if !c.block {
		// trailing line comment: aligned
		if !fmLineCode || !fmCell() {
			if fmCurLen() > 0 {
				fmText.WriteByte(' ')
			}
		}
	} else if fmCurLen() > 0 && !(fmPrevKind is TkLParen | TkLBrack) {
		fmText.WriteByte(' ')
	}
	fmText.WriteBytes(text)
	if c.eline > c.line && fmNLines > 0 {
		fmLines[fmNLines-1].raw = true
	}
	fmPrevEnd = c.eline
	fmNoSpace = false
	if c.block {
		fmPrevKind = TkComment
		fmPrevCls = 0
	}
}

// fmToken emits token ti (not a virtual semicolon, not EOF).
func fmToken(toks []Token, ti usize) {
	t := toks[ti]
	k := t.kind
	cls := fmTcls[ti]
	top := fmTop()
	if k == TkSemicolon {
		nk, nline := fmNext(toks, ti)
		sameLine := nline == t.line
		closerNext := nk is TkRBrace | TkRParen | TkEOF
		hdr := fmNHdr > 0 && usize(fmHdr[fmNHdr-1]) == fmSP
		if !hdr {
			if top is FoStruct | FoEnum {
				if !sameLine || closerNext {
					return
				}
			} else {
				if sameLine && !closerNext {
					fmForceNL = true
				}
				return
			}
		}
	}
	if k == TkComma && top == FoMatchX {
		nk, nline := fmNext(toks, ti)
		if nline == t.line && nk != TkRBrace {
			fmForceNL = true
		}
		return
	}
	isCloser := k is TkRParen | TkRBrack | TkRBrace
	closing := u8(0)
	if isCloser {
		closing = top
	}
	nl := u32(0)
	if fmStarted && t.line > fmPrevEnd {
		nl = t.line - fmPrevEnd
	}
	if fmForceNL && nl == 0 {
		nl = 1
	}
	fmForceNL = false
	if k == TkRBrace && closing is FoMatch | FoMatchX && nl == 0 && fmPrevKind != TkLBrace {
		nl = 1
	}
	if !fmStarted {
		fmFirstLine()
	} else if nl > 0 {
		fmBreak(nl, isCloser)
	} else if fmLineCode && fmAlign(k) {
		fmNoSpace = true
	}
	if fmCurLen() > 0 && !fmNoSpace && fmSpace(k, cls, closing) {
		fmText.WriteByte(' ')
	}
	fmNoSpace = false
	fmText.WriteBytes(fmText1(t.off, t.end))

	fmPrevClose = 0
	if isCloser && fmSP > 0 {
		fmSP--
		fmPrevClose = closing
	}
	if !fmLineCode {
		fmLineCode = true
		fmStartRow(toks, ti, k)
	}
	if k is TkLParen | TkLBrack | TkLBrace {
		oc := u8(FoParen)
		base := fmCurInd
		if k == TkLParen {
			if cls&TcSig != 0 {
				oc = FoSig
			} else if fmPrevKind == TkConst {
				oc = FoConst
			} else if fmPrevKind == TkImport {
				oc = FoImport
			}
		} else if k == TkLBrack {
			oc = FoBrack
			if cls&TcTypePre != 0 {
				oc = FoTypeBrack
			}
		} else {
			oc = FoBlock
			if cls&TcLitBrace != 0 {
				oc = FoLit
			} else if cls&TcMatchX != 0 {
				oc = FoMatchX
			} else if cls&TcMatch != 0 {
				oc = FoMatch
			} else if fmPrevKind == TkStruct {
				oc = FoStruct
			} else if fmPrevKind == TkEnum {
				oc = FoEnum
			}
			if cls&TcHdrEnd != 0 {
				base = fmCurBase
				if fmNHdr > 0 {
					fmNHdr--
				}
			}
		}
		if fmSP >= MaxFmtStack {
			fmFull = true
		} else {
			fmStack[fmSP] = FmtOpen{kind: k, cls: oc, base: base}
			fmSP++
		}
		if oc is FoMatch | FoMatchX {
			nk, _ := fmNext(toks, ti)
			if nk != TkRBrace {
				fmForceNL = true
			}
		}
	}
	if cls&TcHdr != 0 {
		if fmNHdr >= MaxFmtStack {
			fmFull = true
		} else {
			fmHdr[fmNHdr] = u32(fmSP)
			fmNHdr++
		}
	}
	fmPrevKind = k
	fmPrevCls = cls
	fmPrevEnd = t.eline
	fmCont = fmContTok(k)
}

// fmWalk formats the tokens and comments of the current file into fmText
// and fmLines.
func fmWalk(toks []Token, cms []Comment) {
	fmText.Reset()
	fmNLines = 0
	fmSP = 0
	fmNHdr = 0
	fmFull = false
	fmStarted = false
	fmPrevKind = 0
	fmPrevCls = 0
	fmPrevClose = 0
	fmPrevEnd = 0
	fmCont = false
	fmForceNL = false
	fmLineCode = false
	fmRow = RowNone
	fmNoSpace = false
	nt := len(toks)
	nc := len(cms)
	ci := usize(0)
	for ti := usize(0); ti < nt; ti++ {
		t := toks[ti]
		for g := usize(0); g < nc; g++ {
			if ci >= nc || cms[ci].off >= t.off {
				break
			}
			fmComment(cms[ci])
			ci++
		}
		if t.kind == TkEOF {
			break
		}
		if t.kind == TkSemicolon && t.semi != SemiExplicit {
			continue
		}
		fmToken(toks, ti)
	}
	for g := usize(0); g < nc; g++ {
		if ci >= nc {
			break
		}
		fmComment(cms[ci])
		ci++
	}
	fmCloseLine()
}

// ---------------------------------------------------------------------------
// assembly: elastic tabstops

func fmRunes(b []byte) u32 {
	n := len(b)
	w := u32(0)
	for i := usize(0); i < n; i++ {
		if b[i]&0xC0 != 0x80 {
			w++
		}
	}
	return w
}

func fmHasCell(i usize, k usize) bool {
	return !fmLines[i].raw && usize(fmLines[i].nc) > k
}

// fmCellText returns cell k of line i.
func fmCellText(i usize, k usize) []byte {
	ln := fmLines[i]
	s := u32(0)
	if k > 0 {
		s = ln.cell[k-1]
	}
	b := fmText.Bytes()
	return b[usize(ln.start+s):usize(ln.start+ln.cell[k])]
}

// fmWidths computes the column widths: a column block is a maximal run of
// consecutive lines with the same indentation that all have cell k.
func fmWidths(n usize) {
	for k := usize(0); k < MaxFmtCells; k++ {
		i := usize(0)
		for g := usize(0); g < n; g++ {
			if i >= n {
				break
			}
			if !fmHasCell(i, k) {
				i++
				continue
			}
			ind := fmLines[i].indent
			j := i
			w := u32(0)
			for h := i; h < n; h++ {
				if !fmHasCell(h, k) || fmLines[h].indent != ind {
					break
				}
				cw := fmRunes(fmCellText(h, k))
				if cw > w {
					w = cw
				}
				j = h + 1
			}
			for h := i; h < j; h++ {
				fmLines[h].width[k] = w
			}
			i = j
		}
	}
}

// fmAssemble writes the formatted file to fmOut.
func fmAssemble() {
	fmOut.Reset()
	n0 := fmNLines
	n := n0
	for g := usize(0); g < n0; g++ {
		if n == 0 || fmLines[n-1].n > 0 {
			break
		}
		n--
	}
	fmWidths(n)
	b := fmText.Bytes()
	for i := usize(0); i < n; i++ {
		ln := fmLines[i]
		if ln.n == 0 {
			fmOut.WriteByte('\n')
			continue
		}
		fmOut.WriteRepeat('\t', usize(ln.indent))
		pos := u32(0)
		if !ln.raw {
			nc := usize(ln.nc)
			for k := usize(0); k < nc; k++ {
				e := ln.cell[k]
				seg := b[usize(ln.start+pos):usize(ln.start+e)]
				fmOut.WriteBytes(seg)
				if e < ln.n && ln.width[k] > 0 {
					fmOut.WriteRepeat(' ', usize(ln.width[k]-fmRunes(seg)+1))
				}
				pos = e
			}
		}
		fmOut.WriteBytes(b[usize(ln.start+pos):usize(ln.start+ln.n)])
		fmOut.WriteByte('\n')
	}
}

// ---------------------------------------------------------------------------
// AST comparison

func fmDigit(c byte) bool {
	return c >= '0' && c <= '9'
}

// fmSkipPos skips a " #id" or " @l:c-l:c" field at a[i] (a[i] is '#' or
// '@' followed by a digit) and returns the index after it.
func fmSkipPos(a []byte, i usize) usize {
	n := len(a)
	for j := i + 1; j < n; j++ {
		if a[j] == ' ' || a[j] == '\n' {
			return j
		}
	}
	return n
}

func fmPosAt(a []byte, i usize) bool {
	return i > 0 && a[i-1] == ' ' && a[i] is '#' | '@' && i+1 < len(a) && fmDigit(a[i+1])
}

// fmSameDump compares two AST dumps ignoring node IDs and positions.
func fmSameDump(a []byte, b []byte) bool {
	na := len(a)
	nb := len(b)
	i := usize(0)
	j := usize(0)
	lim := na + nb + 1
	for g := usize(0); g < lim; g++ {
		if i >= na || j >= nb {
			break
		}
		pa := fmPosAt(a, i)
		pb := fmPosAt(b, j)
		if pa != pb {
			return false
		}
		if pa {
			i = fmSkipPos(a, i)
			j = fmSkipPos(b, j)
			continue
		}
		if a[i] != b[j] {
			return false
		}
		i++
		j++
	}
	return i >= na && j >= nb
}

// ---------------------------------------------------------------------------
// driver

driver func fmtUsage(io Stdio) error {
	if err := say(io, true, "usage: finc1 fmt [-w] [-l] [-d] [--check] <file.fc | dir>...\n  -check\n    \tlist files whose formatting differs and fail if there are any\n  -d\tdisplay diffs instead of rewriting files\n  -l\tlist files whose formatting differs\n  -w\twrite result to (source) file instead of stdout\n"); err != nil {
		return err
	}
	return ErrParse
}

// fmParse lexes and parses sources.files[i] (comments recorded when keep
// is set). It returns the File node (0 after a syntax error, reported in
// errBuf) and false if an arena overflowed.
driver func fmParse(i usize, keep bool) (u32, bool) {
	st := sources.files[i].start
	n := sources.files[i].size
	lx := newLexer(sources.bytes[st : st+n])
	lx.keepComments = keep
	if keep {
		comments.Reset()
		commentsFull = false
	}
	lp := &lx
	tp := &tokens
	if !tokenize(lp, tp) || commentsFull {
		return 0, false
	}
	eb := &errBuf
	np := &nodes
	lsp := &nodes.lists
	p := Parser{
		toks: tp.Slice(),
		na:   np,
		ls:   lsp,
		diag: eb,
		src:  sources.bytes[:],
		fsrc: sources.bytes[st : st+n],
		base: u32(st),
		file: u16(i),
		path: sources.files[i].path,
		ntok: tp.Len(),
	}
	root := p.run()
	if nodes.full || lsp.Full() || eb.Truncated() {
		return 0, false
	}
	return root, true
}

// fmDumpTo writes the AST dump of root into o.
driver func fmDumpTo(o *OutBuf, root u32) {
	o.Reset()
	d := Dumper{na: &nodes, sa: &sources, src: sources.bytes[:], out: o, tmp: &tmpBuf}
	d.dumpNode(root, 0, WalkDepth)
}

// fmtFile formats one file into fmOut; it returns whether the file
// changes, and an error (already reported) if it could not be formatted.
driver func fmtFile(fs FS, io Stdio, path string) (bool, error) {
	sources.used = 0
	sources.nfiles = 1
	nodes.count = 1
	nodes.lists.Reset()
	nodes.full = false
	errBuf.Reset()
	n, err := fs.ReadFileInto(path, sources.bytes[:MaxSourceBytes/2])
	if err != nil {
		return false, ioFail(io, "open ", path, err)
	}
	sources.files[0].path = path
	sources.files[0].start = 0
	sources.files[0].size = n
	sources.used = n
	root, ok := fmParse(0, true)
	if !ok {
		return false, capacityFail(io, path, "tokens, comments or AST nodes")
	}
	if root == 0 {
		if e := flushErr(io); e != nil {
			return false, e
		}
		return false, ErrParse
	}
	toks := tokens.Slice()
	fmClassify(toks, 1)
	fmNode(toks, root, WalkDepth)
	fmBase = 0
	fmWalk(toks, comments.Slice())
	if fmFull || fmText.Truncated() {
		return false, capacityFail(io, path, "fmt lines")
	}
	fmAssemble()
	if fmOut.Truncated() {
		return false, capacityFail(io, path, "output buffer")
	}
	// The formatted file must parse to the same AST.
	fmDumpTo(&fmDump, root)
	m := fmOut.Len()
	if n+m > MaxSourceBytes {
		return false, capacityFail(io, path, "source bytes")
	}
	_ = copy(sources.bytes[n:n+m], fmOut.Bytes())
	sources.files[1].path = path
	sources.files[1].start = n
	sources.files[1].size = m
	sources.used = n + m
	sources.nfiles = 2
	root2, ok2 := fmParse(1, false)
	if !ok2 {
		return false, capacityFail(io, path, "tokens or AST nodes")
	}
	if root2 == 0 {
		if fmDebug {
			_ = flushErr(io)
			_ = io.WriteStdout(fmOut.Bytes())
		}
		errBuf.Reset()
		if e := sayf(io, formatTo(mbuf[:], "finc1 fmt: internal error: the formatted %s does not parse; file left unchanged\n", path)); e != nil {
			return false, e
		}
		return false, ErrParse
	}
	fmDumpTo(&outBuf, root2)
	if fmDump.Truncated() || outBuf.Truncated() {
		return false, capacityFail(io, path, "output buffer")
	}
	if !fmSameDump(fmDump.Bytes(), outBuf.Bytes()) {
		if fmDebug {
			_ = io.WriteStdout(fmOut.Bytes())
		}
		if e := sayf(io, formatTo(mbuf[:], "finc1 fmt: internal error: formatting %s changes its AST; file left unchanged\n", path)); e != nil {
			return false, e
		}
		return false, ErrParse
	}
	return !bytesEqual(sources.bytes[:n], fmOut.Bytes()), nil
}

// fmAddFile appends a file to the work list.
driver func fmAddFile(p string) {
	if fmNFiles < MaxFmtFiles {
		fmFiles[fmNFiles] = p
		fmNFiles++
	}
}

// fmCollect adds the .fc files of dir and, recursively, of its
// subdirectories (name order, hidden directories skipped).
driver func fmCollect(fs FS, exec Exec, io Stdio, dir string) error {
	var stack [MaxFmtFiles]string
	sp := usize(1)
	stack[0] = dir
	for g := usize(0); g < MaxFmtFiles; g++ {
		if sp == 0 {
			break
		}
		sp--
		d := stack[sp]
		nf, err := fs.ListSourceFiles(d, fileNames[:])
		if err != nil {
			return ioFail(io, "open ", d, err)
		}
		for i := usize(0); i < nf; i++ {
			fmAddFile(joinPath(d, fileNames[i]))
		}
		nd := listSubdirs(exec, d)
		for q := usize(0); q < nd; q++ {
			// push in reverse so that the first subdirectory is visited first
			s := subNames[nd-1-q]
			if sp < MaxFmtFiles && strBytes(s)[0] != '.' {
				stack[sp] = joinPath(d, s)
				sp++
			}
		}
	}
	return nil
}

// fmDiff prints `diff -u` of path against the formatted text.
driver func fmDiff(fs FS, io Stdio, exec Exec, path string) error {
	dir, err := fs.MkdirTemp("finc1-fmt-")
	if err != nil {
		return ioFail(io, "mkdir ", "temp", err)
	}
	tmp := joinPath(dir, "formatted.fc")
	if err := fs.WriteFile(tmp, fmOut.Bytes()); err != nil {
		_ = fs.RemoveAll(dir)
		return ioFail(io, "write ", tmp, err)
	}
	var argv [6]string
	argv[0] = "-c"
	argv[1] = "diff -u --label \"$1.orig\" --label \"$1\" \"$1\" \"$2\""
	argv[2] = "sh"
	argv[3] = path
	argv[4] = tmp
	var envs [1]string
	ctx, cancel := NewContext()
	defer cancel()
	st, n, rerr := exec.Run(ctx, "/bin/sh", argv[:5], envs[:0], "", execErr[:])
	_ = fs.RemoveAll(dir)
	if rerr != nil || st.Code > 1 {
		if e := sayf(io, formatTo(mbuf[:], "finc1 fmt: diff %s: %s\n", path, execErr[:n])); e != nil {
			return e
		}
		return ErrExec
	}
	return nil
}

// runFmt implements `fmt [-w] [-l] [-d] [--check] <file.fc | dir>...`.
driver func runFmt(fs FS, env Env, io Stdio, exec Exec) error {
	argc := env.ArgsCount()
	write := false
	list := false
	diff := false
	check := false
	fmNFiles = 0
	_, fmDebug = env.GetEnv("FINC_FMT_DEBUG")
	nops := usize(0)
	flagsDone := false
	for i := usize(2); i < argc; i++ {
		a := env.Arg(i)
		ab := strBytes(a)
		if !flagsDone && nops == 0 && len(ab) > 1 && ab[0] == '-' {
			if strEq(a, "--") {
				flagsDone = true
			} else if strEq(a, "-w") || strEq(a, "--w") {
				write = true
			} else if strEq(a, "-l") || strEq(a, "--l") {
				list = true
			} else if strEq(a, "-d") || strEq(a, "--d") {
				diff = true
			} else if strEq(a, "-check") || strEq(a, "--check") {
				check = true
			} else {
				if err := sayf(io, formatTo(mbuf[:], "flag provided but not defined: %s\n", a)); err != nil {
					return err
				}
				return fmtUsage(io)
			}
			continue
		}
		nops++
		if fs.IsDir(a) {
			if err := fmCollect(fs, exec, io, a); err != nil {
				return err
			}
		} else {
			fmAddFile(a)
		}
	}
	if nops == 0 {
		return fmtUsage(io)
	}
	if fmNFiles >= MaxFmtFiles {
		return capacityFail(io, "fmt", "files")
	}
	failed := false
	differ := false
	nf := fmNFiles
	for i := usize(0); i < nf; i++ {
		p := fmFiles[i]
		changed, err := fmtFile(fs, io, p)
		if err != nil {
			if err == ErrParse || err == ErrArenaFull {
				failed = true
				continue
			}
			return err
		}
		if changed {
			differ = true
		}
		if list || check {
			if changed {
				if err := say(io, false, catStr(p, "\n")); err != nil {
					return err
				}
			}
		}
		if write && changed {
			if err := fs.WriteFile(p, fmOut.Bytes()); err != nil {
				return ioFail(io, "write ", p, err)
			}
		}
		if diff && changed {
			if err := fmDiff(fs, io, exec, p); err != nil {
				return err
			}
		}
		if !write && !list && !diff && !check {
			if err := io.WriteStdout(fmOut.Bytes()); err != nil {
				return err
			}
		}
	}
	if failed {
		return ErrParse
	}
	if check && differ {
		return ErrExec
	}
	return nil
}
