// resolve.fc — name resolution (port of finc0's bootstrap/internal/resolve:
// universe.go, resolve.go). The loader that reads imported packages lives
// in main.fc (it needs FS); this file builds the universe, declares the
// package-level symbols of every package and binds every identifier use
// (defs/uses side tables, function-literal captures).
//
// The binder is one recursive SCC (bindExpr, bindType, stmt, ...): every
// member carries decreases(depth) and is entered with SemaDepth.
package main

// Predeclared entities (resolve.Builtin), in universe insertion order.
const (
	BNone        = 0
	BTBool       = 1
	BTU8         = 2
	BTU16        = 3
	BTU32        = 4
	BTU64        = 5
	BTI8         = 6
	BTI16        = 7
	BTI32        = 8
	BTI64        = 9
	BTInt        = 10
	BTUsize      = 11
	BTByte       = 12
	BTString     = 13
	BTError      = 14
	BTDuration   = 15
	BTSignal     = 16
	BTExitStatus = 17
	BTNet        = 18
	BTSignals    = 19
	BTClock      = 20
	BTListener   = 21
	BTConn       = 22
	BTContext    = 23
	BTCancelFunc = 24
	BTScope      = 25
	BTSlot       = 26
	BTFS         = 27
	BTEnv        = 28
	BTStdio      = 29
	BTExec       = 30
	BTCode       = 31
	BTEl         = 32
	BTFieldCode  = 33

	BCNanosecond   = 34
	BCMicrosecond  = 35
	BCMillisecond  = 36
	BCSecond       = 37
	BCSIGINT       = 38
	BCSIGTERM      = 39
	BCErrEOF       = 40
	BCErrTimeout   = 41
	BCErrCancelled = 42
	BCErrZeroWrite = 43
	BCErrClosed    = 44
	BCErrIO        = 45
	BCErrNotFound  = 46
	BCErrMaxDepth  = 47
	BCErrArenaFull = 48
	BCErrExec      = 49
	BCErrParse     = 50

	BFLen        = 51
	BFCap        = 52
	BFCopy       = 53
	BFBytesEqual = 54
	BFStrBytes   = 55
	BFBytesToStr = 56
	BFFormatUint = 57
	BFParseUint  = 58
	BFNewContext = 59
	BFNewScope   = 60
	BFPanic      = 61
	BFFormatTo   = 62 // v0.2
	BFCodeEmpty  = 63
	BFCodeUnit   = 64
	BFCodeBool   = 65
	BFCodeU8     = 66
	BFCodeU16    = 67
	BFCodeU32    = 68
	BFCodeU64    = 69
	BFCodeI8     = 70
	BFCodeI16    = 71
	BFCodeI32    = 72
	BFCodeI64    = 73
	BFCodeArray  = 74
	BFCodeSlice  = 75
	BFCodeStruct = 76
	BFCodeField  = 77
	BFCodeUniv   = 78

	NumBuiltins = 79
)

func builtinName(b u8) string {
	if b <= BTFieldCode {
		return builtinTypeName(b)
	}
	if b <= BCErrParse {
		return builtinConstName(b)
	}
	return builtinFuncName(b)
}

func builtinTypeName(b u8) string {
	return match b {
		BTBool -> "bool"
		BTU8 -> "u8"
		BTU16 -> "u16"
		BTU32 -> "u32"
		BTU64 -> "u64"
		BTI8 -> "i8"
		BTI16 -> "i16"
		BTI32 -> "i32"
		BTI64 -> "i64"
		BTInt -> "int"
		BTUsize -> "usize"
		BTByte -> "byte"
		BTString -> "string"
		BTError -> "error"
		BTDuration -> "Duration"
		BTSignal -> "Signal"
		BTExitStatus -> "ExitStatus"
		BTNet -> "Net"
		BTSignals -> "Signals"
		BTClock -> "Clock"
		BTListener -> "Listener"
		BTConn -> "Conn"
		BTContext -> "Context"
		BTCancelFunc -> "CancelFunc"
		BTScope -> "Scope"
		BTSlot -> "Slot"
		BTFS -> "FS"
		BTEnv -> "Env"
		BTStdio -> "Stdio"
		BTExec -> "Exec"
		BTCode -> "Code"
		BTEl -> "El"
		BTFieldCode -> "FieldCode"
		_ -> "?"
	}
}

func builtinConstName(b u8) string {
	return match b {
		BCNanosecond -> "Nanosecond"
		BCMicrosecond -> "Microsecond"
		BCMillisecond -> "Millisecond"
		BCSecond -> "Second"
		BCSIGINT -> "SIGINT"
		BCSIGTERM -> "SIGTERM"
		BCErrEOF -> "ErrEOF"
		BCErrTimeout -> "ErrTimeout"
		BCErrCancelled -> "ErrCancelled"
		BCErrZeroWrite -> "ErrZeroWrite"
		BCErrClosed -> "ErrClosed"
		BCErrIO -> "ErrIO"
		BCErrNotFound -> "ErrNotFound"
		BCErrMaxDepth -> "ErrMaxDepth"
		BCErrArenaFull -> "ErrArenaFull"
		BCErrExec -> "ErrExec"
		BCErrParse -> "ErrParse"
		_ -> "?"
	}
}

func builtinFuncName(b u8) string {
	return match b {
		BFLen -> "len"
		BFCap -> "cap"
		BFCopy -> "copy"
		BFBytesEqual -> "bytesEqual"
		BFStrBytes -> "strBytes"
		BFBytesToStr -> "bytesToStr"
		BFFormatUint -> "formatUint"
		BFParseUint -> "parseUint"
		BFNewContext -> "NewContext"
		BFNewScope -> "NewScope"
		BFPanic -> "panic"
		BFFormatTo -> "formatTo"
		BFCodeEmpty -> "CodeEmpty"
		BFCodeUnit -> "CodeUnit"
		BFCodeBool -> "CodeBool"
		BFCodeU8 -> "CodeU8"
		BFCodeU16 -> "CodeU16"
		BFCodeU32 -> "CodeU32"
		BFCodeU64 -> "CodeU64"
		BFCodeI8 -> "CodeI8"
		BFCodeI16 -> "CodeI16"
		BFCodeI32 -> "CodeI32"
		BFCodeI64 -> "CodeI64"
		BFCodeArray -> "CodeArray"
		BFCodeSlice -> "CodeSlice"
		BFCodeStruct -> "CodeStruct"
		BFCodeField -> "CodeField"
		BFCodeUniv -> "CodeUniv"
		_ -> "?"
	}
}

func builtinIsType(b u8) bool {
	return b >= BTBool && b <= BTFieldCode
}

func builtinIsConst(b u8) bool {
	return b >= BCNanosecond && b <= BCErrParse
}

func builtinIsErrorSentinel(b u8) bool {
	return b >= BCErrEOF && b <= BCErrParse
}

func builtinIsFunc(b u8) bool {
	return b >= BFLen && b <= BFCodeUniv
}

func builtinIsCodeCtor(b u8) bool {
	return b >= BFCodeEmpty && b <= BFCodeUniv
}

func builtinKind(b u8) u8 {
	if builtinIsType(b) {
		return SymType
	}
	if builtinIsConst(b) {
		return SymConst
	}
	if builtinIsFunc(b) {
		return SymBuiltin
	}
	return SymBad
}

// ---------------------------------------------------------------------------
// Universe

var universe u32
var builtinSym [NumBuiltins]u32

func newUniverse() {
	universe = newScope(0, ScopeUniverse, 0)
	for b := u8(1); b < NumBuiltins; b++ {
		s := newSym(builtinKind(b), internStr(builtinName(b)), 0, 0, 0)
		if s == 0 {
			return
		}
		syms.items[usize(s)].builtin = b
		_ = scopeInsert(universe, s)
		builtinSym[usize(b)] = s
	}
}

// ---------------------------------------------------------------------------
// Binder state

var bPkg u32
var bScope u32
var bFuncs [MaxFuncNest]u32
var bNFuncs usize

func bPushFunc(n u32) {
	if bNFuncs >= MaxFuncNest {
		setFull("function nesting")
		return
	}
	bFuncs[bNFuncs] = n
	bNFuncs++
}

func bPopFunc() {
	if bNFuncs > 0 {
		bNFuncs--
	}
}

// resolveProgram builds the universe and binds all loaded packages (in
// dependency order). Diagnostics go to `diags`.
func resolveProgram() {
	newUniverse()
	nn := nodes.count
	for i := usize(1); i < nn; i++ {
		if nodes.items[i].kind == NkVariant {
			nm := idName(na(u32(i)))
			if usize(nm) < MaxNames {
				bVariantName[usize(nm)] = true
			}
		}
	}
	n := pkgs.norder
	for i := usize(0); i < n; i++ {
		declarePackage(pkgs.order[i])
	}
	for i := usize(0); i < n; i++ {
		bindPackage(pkgs.order[i], SemaDepth)
	}
}

// pkgAddDecl declares one package-level symbol (resolve's `add`).
func pkgAddDecl(pkg u32, kind u8, id u32, decl u32) {
	sym := newSym(kind, idName(id), id, decl, pkg)
	if sym == 0 {
		return
	}
	if kind == SymVar {
		syms.items[usize(sym)].varKind = VarGlobal
	}
	upush(sym)
	defs[usize(id)] = sym
	if isBlank(id) {
		return
	}
	old := scopeInsert(pkgs.items[usize(pkg)].scp, sym)
	if old != 0 {
		errAt(E2001, id, formatTo(mbuf[:], "%v redeclared in this package (previous declaration at %v)", NameRef(idName(id)), PosRef(syms.items[usize(old)].ident)))
	}
}

func declarePackage(pkg u32) {
	sc := newScope(universe, ScopePackage, 0)
	pkgs.items[usize(pkg)].scp = sc
	f0 := pkgs.items[usize(pkg)].f0
	f1 := pkgs.items[usize(pkg)].f1
	mark := umark()
	for fi := f0; fi < f1; fi++ {
		if !sources.files[fi].ok {
			continue
		}
		root := sources.files[fi].root
		nd := l2len(root)
		for i := usize(0); i < nd; i++ {
			d := l2at(root, i)
			k := nkind(d)
			if k == NkConstDecl {
				ns := l1len(d)
				for j := usize(0); j < ns; j++ {
					s := l1at(d, j)
					pkgAddDecl(pkg, SymConst, na(s), s)
				}
			} else if k == NkTypeDecl {
				pkgAddDecl(pkg, SymType, na(d), d)
			} else if k == NkVarDecl {
				pkgAddDecl(pkg, SymVar, na(d), d)
			} else if k == NkFuncDecl {
				if na(d) != 0 {
					name := nb(d)
					sym := newSym(SymFunc, idName(name), name, d, pkg)
					if sym == 0 {
						return
					}
					syms.items[usize(sym)].recvType = idName(nb(na(d)))
					upush(sym)
					defs[usize(name)] = sym
				} else {
					pkgAddDecl(pkg, SymFunc, nb(d), d)
				}
			}
		}
	}
	ds, dn := ucommit(mark)
	pkgs.items[usize(pkg)].declS = ds
	pkgs.items[usize(pkg)].declN = dn
	// Methods (redeclared ones are reported and left out).
	mark2 := umark()
	for i := usize(0); i < usize(dn); i++ {
		s := uat(ds, i)
		if syms.items[usize(s)].recvType == 0 {
			continue
		}
		old := u32(0)
		prev := ulists.Pending(mark2)
		for j := usize(0); j < len(prev); j++ {
			m := prev[j]
			if syms.items[usize(m)].recvType == syms.items[usize(s)].recvType && syms.items[usize(m)].name == syms.items[usize(s)].name {
				old = m
				break
			}
		}
		if old != 0 {
			errAt(E2001, syms.items[usize(s)].ident, formatTo(mbuf[:], "method %v.%v redeclared (previous declaration at %v)", NameRef(syms.items[usize(s)].recvType), NameRef(syms.items[usize(s)].name), PosRef(syms.items[usize(old)].ident)))
		} else {
			upush(s)
		}
	}
	ms2, mn2 := ucommit(mark2)
	pkgs.items[usize(pkg)].methS = ms2
	pkgs.items[usize(pkg)].methN = mn2
	for fi := f0; fi < f1; fi++ {
		if !sources.files[fi].ok {
			continue
		}
		fileScope[fi] = newScope(sc, ScopeFile, sources.files[fi].root)
		filePkg[fi] = pkg
	}
}

// importPathOf decodes the path literal of an import spec into tmpBuf and
// returns it.
func importPathOf(spec u32) []byte {
	t := &tmpBuf
	t.Reset()
	decodeStringLit(t, ntext(nb(spec)))
	return t.Bytes()
}

func bindPackage(pkg u32, depth usize) decreases(depth) {
	if depth == 0 {
		return
	}
	bPkg = pkg
	f0 := pkgs.items[usize(pkg)].f0
	f1 := pkgs.items[usize(pkg)].f1
	for fi := f0; fi < f1; fi++ {
		if !sources.files[fi].ok {
			continue
		}
		fs := fileScope[fi]
		root := sources.files[fi].root
		ni := l1len(root)
		for i := usize(0); i < ni; i++ {
			imp := l1at(root, i)
			nsp := l1len(imp)
			for j := usize(0); j < nsp; j++ {
				spec := l1at(imp, j)
				ip := importPathOf(spec)
				dep := u32(0)
				nimp := usize(pkgs.items[usize(pkg)].impN)
				for k := usize(0); k < nimp; k++ {
					q := uat(pkgs.items[usize(pkg)].impS, k)
					if bytesEqual(strBytes(pkgs.items[usize(q)].path), ip) {
						dep = q
						break
					}
				}
				if dep == 0 {
					continue
				}
				name := pkgs.items[usize(dep)].name
				id := na(spec)
				if id != 0 {
					name = idName(id)
				}
				if name == nameBlank {
					continue
				}
				sym := newSym(SymPackage, name, id, spec, pkg)
				if sym == 0 {
					return
				}
				syms.items[usize(sym)].imported = dep
				if id != 0 {
					defs[usize(id)] = sym
				}
				if scopeInsert(fs, sym) != 0 {
					errAt(E2001, spec, formatTo(mbuf[:], "%v redeclared in this file", NameRef(name)))
				} else if lookupLocal(pkgs.items[usize(pkg)].scp, name) != 0 {
					errAt(E2001, spec, formatTo(mbuf[:], "import name %v conflicts with a package-level declaration", NameRef(name)))
				}
			}
		}
	}
	for fi := f0; fi < f1; fi++ {
		if !sources.files[fi].ok {
			continue
		}
		bScope = fileScope[fi]
		root := sources.files[fi].root
		nd := l2len(root)
		for i := usize(0); i < nd; i++ {
			bTopDecl(l2at(root, i), depth-1)
		}
	}
	bScope = 0
}

func bTopDecl(d u32, depth usize) decreases(depth) {
	if depth == 0 {
		return
	}
	k := nkind(d)
	if k == NkConstDecl {
		ns := l1len(d)
		for j := usize(0); j < ns; j++ {
			s := l1at(d, j)
			bindType(nb(s), depth-1)
			bindExpr(nc(s), depth-1)
		}
	} else if k == NkVarDecl {
		bindType(nb(d), depth-1)
		bindExpr(nc(d), depth-1)
	} else if k == NkTypeDecl {
		outer := bScope
		if nb(d) != 0 {
			bScope = newScope(outer, ScopeTypeDecl, d)
			bTypeParams(nb(d), depth-1)
		}
		bindType(nc(d), depth-1)
		bScope = outer
	} else if k == NkFuncDecl {
		bFuncDecl(d, depth-1)
	}
}

func bTypeParams(l u32, depth usize) decreases(depth) {
	if depth == 0 {
		return
	}
	n := l1len(l)
	for i := usize(0); i < n; i++ {
		bindType(na(l1at(l, i)), depth-1)
	}
	for i := usize(0); i < n; i++ {
		tp := l1at(l, i)
		m := l1len(tp)
		for j := usize(0); j < m; j++ {
			_ = bDeclare(SymTypeParam, VarNone, l1at(tp, j), tp)
		}
	}
}

// bDeclare defines a new local symbol in the current scp.
func bDeclare(kind u8, vk u8, id u32, decl u32) u32 {
	sym := newSym(kind, idName(id), id, decl, bPkg)
	if sym == 0 {
		return 0
	}
	syms.items[usize(sym)].varKind = vk
	if bNFuncs > 0 {
		syms.items[usize(sym)].fn = bFuncs[bNFuncs-1]
	}
	if isBlank(id) {
		return sym
	}
	defs[usize(id)] = sym
	if scopeInsert(bScope, sym) != 0 {
		errAt(E2001, id, formatTo(mbuf[:], "%v redeclared in this block", NameRef(idName(id))))
	}
	return sym
}

func bFuncDecl(d u32, depth usize) decreases(depth) {
	if depth == 0 {
		return
	}
	outer := bScope
	bScope = newScope(outer, ScopeFunc, d)
	bPushFunc(d)
	r := na(d)
	if r != 0 {
		tn := nb(r)
		tsym := lookupLocal(pkgs.items[usize(bPkg)].scp, idName(tn))
		if tsym == 0 || symKind(tsym) != SymType {
			errAt(E2001, tn, formatTo(mbuf[:], "undefined receiver type %v (must be a type declared in package %v)", NameRef(idName(tn)), NameRef(pkgs.items[usize(bPkg)].name)))
		} else {
			uses[usize(tn)] = tsym
		}
		n := l1len(r)
		for i := usize(0); i < n; i++ {
			_ = bDeclare(SymTypeParam, VarNone, l1at(r, i), r)
		}
	}
	if nc(d) != 0 {
		bTypeParams(nc(d), depth-1)
	}
	bSignatureTypes(nd(d), depth-1)
	if r != 0 {
		_ = bDeclare(SymVar, VarRecv, na(r), r)
	}
	bParams(nd(d))
	if ne(d) != 0 {
		bindExpr(na(ne(d)), depth-1)
	}
	if nf(d) != 0 {
		bStmts(nf(d), depth-1)
	}
	bPopFunc()
	bScope = outer
}

func bSignatureTypes(s u32, depth usize) decreases(depth) {
	if depth == 0 {
		return
	}
	n := l1len(s)
	for i := usize(0); i < n; i++ {
		bindType(na(l1at(s, i)), depth-1)
	}
	m := l2len(s)
	for i := usize(0); i < m; i++ {
		bindType(l2at(s, i), depth-1)
	}
}

func bParams(s u32) {
	n := l1len(s)
	for i := usize(0); i < n; i++ {
		p := l1at(s, i)
		m := l1len(p)
		for j := usize(0); j < m; j++ {
			_ = bDeclare(SymVar, VarParam, l1at(p, j), p)
		}
	}
}

func bindType(t u32, depth usize) decreases(depth) {
	if depth == 0 || t == 0 {
		return
	}
	k := nkind(t)
	if k == NkNamedType {
		bNamedType(t, depth-1)
	} else if k == NkArrayType {
		bindExpr(na(t), depth-1)
		bindType(nb(t), depth-1)
	} else if k == NkSliceType || k == NkPointerType {
		bindType(na(t), depth-1)
	} else if k == NkStructType {
		n := l1len(t)
		for i := usize(0); i < n; i++ {
			bindType(na(l1at(t, i)), depth-1)
		}
	} else if k == NkEnumType {
		n := l1len(t)
		for i := usize(0); i < n; i++ {
			v := l1at(t, i)
			m := l1len(v)
			for j := usize(0); j < m; j++ {
				bindType(l1at(v, j), depth-1)
			}
		}
	} else if k == NkFuncType {
		bSignatureTypes(na(t), depth-1)
	} else if k == NkCodeType || k == NkElType {
		bindExpr(na(t), depth-1)
	}
}

func bNamedType(t u32, depth usize) decreases(depth) {
	if depth == 0 {
		return
	}
	if na(t) != 0 {
		_ = bQualified(na(t), nb(t))
	} else {
		_ = bLookup(nb(t))
	}
	n := l1len(t)
	for i := usize(0); i < n; i++ {
		bindExpr(l1at(t, i), depth-1)
	}
}

// bQualified resolves pkg.Name; it returns false if pkg is not a package.
func bQualified(pkg u32, name u32) bool {
	ps := bLookup(pkg)
	if ps == 0 {
		return true
	}
	if symKind(ps) != SymPackage {
		return false
	}
	nm := idName(name)
	imp := syms.items[usize(ps)].imported
	member := lookupLocal(pkgs.items[usize(imp)].scp, nm)
	if member == 0 {
		errAt(E2001, name, formatTo(mbuf[:], "undefined: %v.%v", NameRef(idName(pkg)), NameRef(nm)))
	} else if !isExportedName(nm) {
		errAt(E2001, name, formatTo(mbuf[:], "%v.%v is not exported", NameRef(idName(pkg)), NameRef(nm)))
	} else {
		uses[usize(name)] = member
	}
	return true
}

// bLookup resolves an identifier use, reporting E2001 if undefined.
func bLookup(id u32) u32 {
	if isBlank(id) {
		errAt(E2001, id, formatTo(mbuf[:], "cannot use _ as value"))
		return 0
	}
	sym := lookupChain(bScope, idName(id))
	if sym == 0 {
		errAt(E2001, id, formatTo(mbuf[:], "undefined: %v", NameRef(idName(id))))
		return 0
	}
	uses[usize(id)] = sym
	bNoteCapture(sym)
	return sym
}

// bNoteCapture records sym as captured by every function literal between
// the current function and the function declaring sym.
func bNoteCapture(sym u32) {
	sf := syms.items[usize(sym)].fn
	if sf == 0 || bNFuncs == 0 || symKind(sym) == SymTypeParam {
		return
	}
	n := bNFuncs
	for k := usize(0); k < n; k++ {
		fn := bFuncs[n-1-k]
		if fn == sf {
			return
		}
		if nkind(fn) != NkFuncLit {
			return
		}
		dup := false
		c := litCapHead[usize(fn)]
		for g := usize(0); g < MaxCells; g++ {
			if c == 0 {
				break
			}
			if cellVal(c) == sym {
				dup = true
				break
			}
			c = cellNext(c)
		}
		if !dup {
			h, t := cellAppend(litCapHead[usize(fn)], litCapTail[usize(fn)], sym)
			litCapHead[usize(fn)] = h
			litCapTail[usize(fn)] = t
		}
	}
}

func bindExpr(e u32, depth usize) decreases(depth) {
	if depth == 0 || e == 0 {
		return
	}
	k := nkind(e)
	if k == NkIdent {
		_ = bLookup(e)
	} else if k == NkBinaryExpr && (nop(e) == OpLAnd || nop(e) == OpLOr) || k == NkIsExpr {
		// v0.2: `is` bindings flow into the right operand of && / ||.
		mark := bFlowTop
		_, _ = bFlow(e, depth-1)
		bFlowTop = mark
	} else if k == NkBinaryExpr {
		bindExpr(na(e), depth-1)
		bindExpr(nb(e), depth-1)
	} else if k == NkUnaryExpr || k == NkParenExpr {
		bindExpr(na(e), depth-1)
	} else if k == NkCallExpr || k == NkIndexExpr {
		bindExpr(na(e), depth-1)
		n := l1len(e)
		for i := usize(0); i < n; i++ {
			bindExpr(l1at(e, i), depth-1)
		}
	} else if k == NkSliceExpr {
		bindExpr(na(e), depth-1)
		bindExpr(nb(e), depth-1)
		bindExpr(nc(e), depth-1)
	} else if k == NkSelectorExpr {
		x := na(e)
		if nkind(x) == NkIdent && !isBlank(x) {
			_ = bQualified(x, nb(e))
			return
		}
		bindExpr(x, depth-1)
	} else if k == NkFuncLit {
		outer := bScope
		bScope = newScope(outer, ScopeFunc, e)
		bSignatureTypes(na(e), depth-1)
		bPushFunc(e)
		bParams(na(e))
		bStmts(nb(e), depth-1)
		bPopFunc()
		bScope = outer
	} else if k == NkStructLit {
		bNamedType(na(e), depth-1)
		n := l1len(e)
		for i := usize(0); i < n; i++ {
			bindExpr(nb(l1at(e, i)), depth-1)
		}
	} else if k == NkTypeExpr {
		bindType(na(e), depth-1)
	} else if k == NkMatchExpr {
		bindExpr(na(e), depth-1)
		n := l1len(e)
		for i := usize(0); i < n; i++ {
			bMatchArm(l1at(e, i), depth-1)
		}
	} else if k == NkTupleExpr {
		n := l1len(e)
		for i := usize(0); i < n; i++ {
			bindExpr(l1at(e, i), depth-1)
		}
	}
}

// bStmts binds the statements of a block without opening a scp.
func bStmts(bl u32, depth usize) decreases(depth) {
	if depth == 0 || bl == 0 {
		return
	}
	n := l1len(bl)
	for i := usize(0); i < n; i++ {
		s := l1at(bl, i)
		if nkind(s) == NkIfStmt {
			bIfStmt(s, true, depth-1)
		} else {
			bStmt(s, depth-1)
		}
	}
}

func bBlock(bl u32, depth usize) decreases(depth) {
	if depth == 0 || bl == 0 {
		return
	}
	outer := bScope
	bScope = newScope(outer, ScopeBlock, bl)
	bStmts(bl, depth-1)
	bScope = outer
}

func bStmt(s u32, depth usize) decreases(depth) {
	if depth == 0 || s == 0 {
		return
	}
	k := nkind(s)
	if k == NkBlockStmt {
		bBlock(s, depth-1)
	} else if k == NkDeclStmt {
		d := na(s)
		if nkind(d) == NkConstDecl {
			n := l1len(d)
			for i := usize(0); i < n; i++ {
				sp := l1at(d, i)
				bindType(nb(sp), depth-1)
				bindExpr(nc(sp), depth-1)
				_ = bDeclare(SymConst, VarNone, na(sp), sp)
			}
		} else if nkind(d) == NkVarDecl {
			bindType(nb(d), depth-1)
			bindExpr(nc(d), depth-1)
			_ = bDeclare(SymVar, VarLocal, na(d), d)
		}
	} else if k == NkShortVarDecl {
		nv := l2len(s)
		for i := usize(0); i < nv; i++ {
			bindExpr(l2at(s, i), depth-1)
		}
		fresh := 0
		nn := l1len(s)
		for i := usize(0); i < nn; i++ {
			id := l1at(s, i)
			if isBlank(id) {
				continue
			}
			old := lookupLocal(bScope, idName(id))
			if old != 0 {
				uses[usize(id)] = old
				continue
			}
			fresh++
			_ = bDeclare(SymVar, VarLocal, id, s)
		}
		if fresh == 0 {
			errAt(E2002, s, formatTo(mbuf[:], "no new variables on left side of :="))
		}
	} else if k == NkAssignStmt {
		nl := l1len(s)
		for i := usize(0); i < nl; i++ {
			l := l1at(s, i)
			if nkind(l) == NkIdent && isBlank(l) && nop(s) == AsgAssign {
				continue
			}
			bindExpr(l, depth-1)
		}
		nr := l2len(s)
		for i := usize(0); i < nr; i++ {
			bindExpr(l2at(s, i), depth-1)
		}
	} else if k is NkIncDecStmt | NkExprStmt | NkDeferStmt {
		bindExpr(na(s), depth-1)
	} else if k == NkReturnStmt {
		n := l1len(s)
		for i := usize(0); i < n; i++ {
			bindExpr(l1at(s, i), depth-1)
		}
	} else if k == NkIfStmt {
		bIfStmt(s, false, depth-1)
	} else if k == NkForStmt {
		outer := bScope
		bScope = newScope(outer, ScopeBlock, s)
		bStmt(na(s), depth-1)
		mark := bFlowTop
		nt, _ := bFlow(nb(s), depth-1)
		bStmt(nc(s), depth-1)
		if nd(s) != 0 {
			bindExpr(na(nd(s)), depth-1)
		}
		// v0.2: the condition's true-outcome bindings are visible in the body.
		bVisible(mark, mark+nt)
		bBlock(ne(s), depth-1)
		bScope = outer
		bFlowTop = mark
	} else if k == NkMatchStmt {
		bindExpr(na(s), depth-1)
		n := l1len(s)
		for i := usize(0); i < n; i++ {
			bMatchArm(l1at(s, i), depth-1)
		}
	} else if k == NkScopeStmt {
		bindExpr(nb(s), depth-1)
		outer := bScope
		bScope = newScope(outer, ScopeBlock, s)
		_ = bDeclare(SymVar, VarScope, na(s), s)
		bBlock(nc(s), depth-1)
		bScope = outer
	}
}

// bCtorPattern resolves the qualifier of a qualified constructor pattern:
// Qual.Name is a package member (an imported constant), or Type.Variant
// (the variant is resolved by the type checker).
func bCtorPattern(cp u32) {
	if na(cp) != 0 {
		_ = bQualified(na(cp), nb(cp))
	}
}

func bMatchArm(arm u32, depth usize) decreases(depth) {
	if depth == 0 {
		return
	}
	outer := bScope
	bScope = newScope(outer, ScopeBlock, arm)
	bPatternNames(na(arm), true, depth-1)
	// v0.2: the guard's true-outcome bindings are visible in the body.
	mark := bFlowTop
	nt, _ := bFlow(nd(arm), depth-1)
	bVisible(mark, mark+nt)
	if nb(arm) != 0 {
		bindExpr(nb(arm), depth-1)
	}
	if nc(arm) != 0 {
		bStmts(nc(arm), depth-1)
	}
	bScope = outer
	bFlowTop = mark
}

// MaxPatternBindings bounds the distinct names one pattern binds (more are
// declared without unifying repeated names).
const MaxPatternBindings = 256

// bVariantName marks the names (interned name IDs) of the variants of every
// enum type of the program: such a bare pattern name is declared hidden
// (see bPatternNames).
var bVariantName [MaxNames]bool

// bPatSeen holds the symbols declared by the pattern being bound.
var bPatSeen [MaxPatternBindings]u32
var bPatN usize

// bPatternNames resolves the names of a pattern and, if declare is set,
// declares its bindings in the current scope (v0.2). A bare identifier in
// any pattern position (top level, tuple element or payload: an Ident in
// payloads, an unqualified CtorPattern without parentheses elsewhere) that
// resolves to a constant is a constant pattern (a use of the constant);
// any other bare identifier is declared as a binding. The type checker
// later classifies a bare name that is a variant of the expected enum type
// as that variant (the binding, if declared, is then bound to the value,
// which is that variant). A name bound in several places of one pattern
// (or-pattern alternatives) is one symbol; the type checker checks that
// the alternatives agree and that no alternative binds a name twice. A
// name that is the name of a variant of some enum type of the program is
// declared hidden: it gets a symbol (a binding if the type checker finds
// no such variant in the expected type) but is not inserted into the
// scope, so variant names shadow nothing and cannot be referenced.
// Bindings of an undeclared pattern keep no symbol (E2002 in the type
// checker unless the name is a variant).
func bPatternNames(p u32, declare bool, depth usize) decreases(depth) {
	bPatN = 0
	bPatWalk(p, declare, depth-1)
}

func bPatWalk(p u32, declare bool, depth usize) decreases(depth) {
	if depth == 0 || p == 0 {
		return
	}
	k := nkind(p)
	if k == NkIdent {
		bPatBare(p, declare)
	} else if k == NkCtorPattern {
		if na(p) == 0 && !nflag(p) {
			bPatBare(nb(p), declare)
			return
		}
		bCtorPattern(p)
		n := l1len(p)
		for i := usize(0); i < n; i++ {
			bPatWalk(l1at(p, i), declare, depth-1)
		}
	} else if k == NkOrPattern || k == NkTuplePattern {
		n := l1len(p)
		for i := usize(0); i < n; i++ {
			bPatWalk(l1at(p, i), declare, depth-1)
		}
	}
}

// bPatBare resolves the bare pattern name id: a constant in scope (a use),
// else, if declare is set, a binding (one symbol per name per pattern).
func bPatBare(id u32, declare bool) {
	if isBlank(id) {
		return
	}
	csym := lookupChain(bScope, idName(id))
	if csym != 0 && symKind(csym) == SymConst {
		uses[usize(id)] = csym
		return
	}
	if !declare {
		return
	}
	nseen := bPatN
	for i := usize(0); i < nseen; i++ {
		if symName(bPatSeen[i]) == idName(id) {
			defs[usize(id)] = bPatSeen[i]
			return
		}
	}
	sym := u32(0)
	if usize(idName(id)) < MaxNames && bVariantName[usize(idName(id))] {
		// Probably a variant of the expected enum type: declared but not
		// visible, so it shadows nothing (and two `is` tests of one &&
		// chain may name the same variant).
		sym = newSym(SymVar, idName(id), id, id, bPkg)
		if sym != 0 {
			syms.items[usize(sym)].varKind = VarBinding
			if bNFuncs > 0 {
				syms.items[usize(sym)].fn = bFuncs[bNFuncs-1]
			}
			defs[usize(id)] = sym
		}
	} else {
		sym = bDeclare(SymVar, VarBinding, id, id)
	}
	if bPatN < MaxPatternBindings && sym != 0 {
		bPatSeen[bPatN] = sym
		bPatN++
	}
}

// ---------------------------------------------------------------------------
// v0.2 flow-scoped `is` bindings (finc0's binder.flow, ifStmt, visible,
// union).

// MaxFlowSyms bounds the symbols of the outcome sets under construction.
const MaxFlowSyms = 4096

// bFlowSyms is a LIFO stack of outcome sets: bFlow leaves the true set
// followed by the false set on top of it.
var bFlowSyms [MaxFlowSyms]u32
var bFlowTop usize
var bFlowTmp [MaxFlowSyms]u32

func bFlowPush(sym u32) {
	if bFlowTop >= MaxFlowSyms {
		setFull("flow bindings")
		return
	}
	bFlowSyms[bFlowTop] = sym
	bFlowTop++
}

// bIfStmt binds an if statement: the bindings of the condition's true
// outcome are visible in the then block, those of its false outcome in
// the else branch. If the if statement is directly in a statement list
// (inList) and has no else branch, the false-outcome bindings are
// declared in the enclosing block after it, like a `:=` at the if
// statement (let-else; the type checker requires the then block to
// terminate where they are used).
func bIfStmt(s u32, inList bool, depth usize) decreases(depth) {
	if depth == 0 {
		return
	}
	outer := bScope
	bScope = newScope(outer, ScopeBlock, s)
	bStmt(na(s), depth-1)
	mark := bFlowTop
	nt, nf := bFlow(nb(s), depth-1)
	ifScope := bScope
	bVisible(mark, mark+nt)
	bBlock(nc(s), depth-1)
	bScope = ifScope
	bVisible(mark+nt, mark+nt+nf)
	bStmt(nd(s), depth-1)
	bScope = outer
	if inList && nd(s) == 0 {
		for i := mark + nt; i < mark+nt+nf; i++ {
			sym := bFlowSyms[i]
			if scopeInsert(bScope, sym) != 0 {
				errAt(E2001, syms.items[usize(sym)].ident, formatTo(mbuf[:], "%v redeclared in this block", NameRef(symName(sym))))
			}
		}
	}
	bFlowTop = mark
}

// bFlow binds a boolean expression and pushes its outcome sets: the
// variables bound by `is` tests that are definitely matched when e is
// true (the first nt symbols) and when e is false (the next nf), in
// source order.
//
//	e is P      t = bindings of P, f = {}
//	!A          t = f(A), f = t(A)
//	A && B      t = t(A) + t(B), f = {}; t(A) is visible in B
//	A || B      t = {}, f = f(A) + f(B); f(A) is visible in B
//	(A)         those of A
//	otherwise   {}, {}
//
// The symbols of an `is` pattern are declared in a scope of their own and
// become visible only where flow makes them visible. A name in both
// operand sets of a union is E2001.
func bFlow(e u32, depth usize) (usize, usize) decreases(depth) {
	if depth == 0 || e == 0 {
		return 0, 0
	}
	k := nkind(e)
	if k == NkParenExpr {
		return bFlow(na(e), depth-1)
	}
	if k == NkUnaryExpr && nop(e) == OpNot {
		base := bFlowTop
		t, f := bFlow(na(e), depth-1)
		n := t + f
		for i := usize(0); i < n; i++ {
			bFlowTmp[i] = bFlowSyms[base+i]
		}
		for i := usize(0); i < f; i++ {
			bFlowSyms[base+i] = bFlowTmp[t+i]
		}
		for i := usize(0); i < t; i++ {
			bFlowSyms[base+f+i] = bFlowTmp[i]
		}
		return f, t
	}
	if k == NkIsExpr {
		bindExpr(na(e), depth-1)
		outer := bScope
		ps := newScope(outer, ScopeBlock, e)
		bScope = ps
		bPatternNames(nb(e), true, depth-1)
		bScope = outer
		// hidden variant-name symbols (never inserted) take no part
		np := bPatN
		n := usize(0)
		for i := usize(0); i < np; i++ {
			if syms.items[usize(bPatSeen[i])].scp == ps {
				bFlowPush(bPatSeen[i])
				n++
			}
		}
		return n, 0
	}
	if k == NkBinaryExpr && (nop(e) == OpLAnd || nop(e) == OpLOr) {
		and := nop(e) == OpLAnd
		base := bFlowTop
		ta, fa := bFlow(na(e), depth-1)
		outer := bScope
		if and {
			bVisible(base, base+ta)
		} else {
			bVisible(base+ta, base+ta+fa)
		}
		tb, fb := bFlow(nb(e), depth-1)
		bScope = outer
		// the union keeps the left set x and appends the right set y
		xs := base
		xn := ta
		ys := base + ta + fa
		yn := tb
		if !and {
			xs = base + ta
			xn = fa
			ys = base + ta + fa + tb
			yn = fb
		}
		for i := usize(0); i < xn; i++ {
			bFlowTmp[i] = bFlowSyms[xs+i]
		}
		for i := usize(0); i < yn; i++ {
			bFlowTmp[xn+i] = bFlowSyms[ys+i]
		}
		bFlowTop = base
		for i := usize(0); i < xn; i++ {
			bFlowPush(bFlowTmp[i])
		}
		n := xn
		for i := usize(0); i < yn; i++ {
			sym := bFlowTmp[xn+i]
			dup := false
			for j := usize(0); j < xn; j++ {
				if symName(bFlowTmp[j]) == symName(sym) {
					dup = true
					break
				}
			}
			if dup {
				errAt(E2001, syms.items[usize(sym)].ident, formatTo(mbuf[:], "%v redeclared in this condition", NameRef(symName(sym))))
				continue
			}
			bFlowPush(sym)
			n++
		}
		if and {
			return n, 0
		}
		return 0, n
	}
	bindExpr(e, depth-1)
	return 0, 0
}

// bVisible opens a scope holding bFlowSyms[from:to] (none if empty); the
// caller restores bScope.
func bVisible(from usize, to usize) {
	if to <= from {
		return
	}
	bScope = newScope(bScope, ScopeBlock, 0)
	for i := from; i < to; i++ {
		_ = scopeInsert(bScope, bFlowSyms[i])
	}
}
