	}
	if b == BCSIGTERM {
		return "SIGTERM"
	}
	if b == BCErrEOF {
		return "ErrEOF"
	}
	if b == BCErrTimeout {
		return "ErrTimeout"
	}
	if b == BCErrCancelled {
		return "ErrCancelled"
	}
	if b == BCErrZeroWrite {
		return "ErrZeroWrite"
	}
	if b == BCErrClosed {
		return "ErrClosed"
	}
	if b == BCErrIO {
		return "ErrIO"
	}
	if b == BCErrNotFound {
		return "ErrNotFound"
	}
	if b == BCErrMaxDepth {
