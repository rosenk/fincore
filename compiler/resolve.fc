package main

// Multi-package loader, Universe table, package-level declaration resolver,
// and type-expression resolver.

const (
	MaxUniSyms = 128
	MaxFileImps = 512
)

type FileImport struct {
	fileID   u32
	aliasStr u32 // local package name in this file
	pkgID    u32
}

var uniSyms [MaxUniSyms]u32
var uniSymCount u32
var fileImports [MaxFileImps]FileImport
var fileImportCount u32

var fincRootBuf [512]byte
var fincRootLen usize

func resolveInit(env Env) {
	uniSymCount = 0
	fileImportCount = 0
	fincRootLen = 0
	fr, ok := env.GetEnv("FINCROOT")
	if !ok || len(fr) == 0 {
		fr, ok = env.GetEnv("FINCORE_ROOT")
	}
	if ok && len(fr) > 0 && len(fr) <= len(fincRootBuf) {
		for i := usize(0); i < len(fr); i++ {
			fincRootBuf[i] = fr[i]
		}
		fincRootLen = len(fr)
	}
	initUniverse()
}

func addSym(s Sym) u32 {
	if symCount >= MaxSyms {
		return 0
	}
	id := symCount
	symCount++
	syms[id] = s
	return id
}

func addUniType(name string, ty u32) {
	s := addSym(Sym{kind: SymType, nameStr: internStr(name), typeID: ty})
	if uniSymCount < MaxUniSyms {
		uniSyms[uniSymCount] = s
		uniSymCount++
	}
}

func addUniConst(name string, ty u32, valID u32, untyped bool) {
	var fl u8 = 0
	if untyped {
		fl = 1
	}
	s := addSym(Sym{kind: SymConst, flags: fl, nameStr: internStr(name), typeID: ty, valID: valID})
	if uniSymCount < MaxUniSyms {
		uniSyms[uniSymCount] = s
		uniSymCount++
	}
}

func addUniBuiltin(name string, bid u16) {
	s := addSym(Sym{kind: SymBuiltin, builtin: bid, nameStr: internStr(name)})
	if uniSymCount < MaxUniSyms {
		uniSyms[uniSymCount] = s
		uniSymCount++
	}
}

func initUniverse() {
	// Basic types
	addUniType("bool", TYBool)
	addUniType("u8", TYU8)
	addUniType("byte", TYU8)
	addUniType("u16", TYU16)
	addUniType("u32", TYU32)
	addUniType("u64", TYU64)
	addUniType("usize", TYUsize)
	addUniType("i8", TYI8)
	addUniType("i16", TYI16)
	addUniType("i32", TYI32)
	addUniType("i64", TYI64)
	addUniType("int", TYInt)
	addUniType("f32", TYF32)
	addUniType("f64", TYF64)
	addUniType("string", TYString)
	addUniType("error", TYError)
	addUniType("any", TYAny)

	// Builtin resource & capability types
	addUniType("Net", TYNet)
	addUniType("Listener", TYListener)
	addUniType("Conn", TYConn)
	addUniType("Signals", TYSignals)
	addUniType("Clock", TYClock)
	addUniType("Context", TYContext)
	addUniType("CancelFunc", TYCancelFunc)
	addUniType("Scope", TYScope)
	addUniType("Slot", TYSlotOrigin)
	addUniType("FS", TYFS)
	addUniType("Env", TYEnv)
	addUniType("Stdio", TYStdio)
	addUniType("Exec", TYExec)
	addUniType("FieldCode", TYFieldCode)
	addUniType("ExitStatus", TYExitStatus)
	addUniType("Arena", TYArena)
	addUniType("Atomic", TYAtomicOrigin)

	// Predeclared error sentinels
	addUniConst("ErrEOF", TYError, makeErrVal(ErrIDEOF), false)
	addUniConst("ErrTimeout", TYError, makeErrVal(ErrIDTimeout), false)
	addUniConst("ErrCancelled", TYError, makeErrVal(ErrIDCancelled), false)
	addUniConst("ErrZeroWrite", TYError, makeErrVal(ErrIDZeroWrite), false)
	addUniConst("ErrClosed", TYError, makeErrVal(ErrIDClosed), false)
	addUniConst("ErrIO", TYError, makeErrVal(ErrIDIO), false)
	addUniConst("ErrNotFound", TYError, makeErrVal(ErrIDNotFound), false)
	addUniConst("ErrMaxDepth", TYError, makeErrVal(ErrIDMaxDepth), false)
	addUniConst("ErrArenaFull", TYError, makeErrVal(ErrIDArenaFull), false)
	addUniConst("ErrExec", TYError, makeErrVal(ErrIDExec), false)
	addUniConst("ErrParse", TYError, makeErrVal(ErrIDParse), false)

	// Predeclared durations (untyped int nanoseconds) & signals
	addUniConst("Nanosecond", TYUntypedInt, makeIntVal(1, false, TYUntypedInt), true)
	addUniConst("Microsecond", TYUntypedInt, makeIntVal(1000, false, TYUntypedInt), true)
	addUniConst("Millisecond", TYUntypedInt, makeIntVal(1_000_000, false, TYUntypedInt), true)
	addUniConst("Second", TYUntypedInt, makeIntVal(1_000_000_000, false, TYUntypedInt), true)
	addUniConst("Minute", TYUntypedInt, makeIntVal(60_000_000_000, false, TYUntypedInt), true)
	addUniConst("Hour", TYUntypedInt, makeIntVal(3600_000_000_000, false, TYUntypedInt), true)
	addUniConst("SIGINT", TYU32, makeIntVal(2, false, TYU32), false)
	addUniConst("SIGTERM", TYU32, makeIntVal(15, false, TYU32), false)

	// Builtin functions
	addUniBuiltin("len", BFLen)
	addUniBuiltin("cap", BFCap)
	addUniBuiltin("copy", BFCopy)
	addUniBuiltin("bytesEqual", BFBytesEqual)
	addUniBuiltin("strBytes", BFStrBytes)
	addUniBuiltin("bytesToStr", BFBytesToStr)
	addUniBuiltin("formatUint", BFFormatUint)
	addUniBuiltin("parseUint", BFParseUint)
	addUniBuiltin("NewContext", BFNewContext)
	addUniBuiltin("NewScope", BFNewScope)
	addUniBuiltin("NewFiberScope", BFNewFiberScope)
	addUniBuiltin("FiberYield", BFFiberYield)
	addUniBuiltin("NewArena", BFNewArena)
	addUniBuiltin("strView", BFStrView)
	addUniBuiltin("embed", BFEmbed)
	addUniBuiltin("embedBytes", BFEmbedBytes)
	addUniBuiltin("cstr", BFCstr)
	addUniBuiltin("ptrAddr", BFPtrAddr)
	addUniBuiltin("slicePtr", BFSlicePtr)
	addUniBuiltin("panic", BFPanic)
	addUniBuiltin("formatTo", BFFormatTo)
	addUniBuiltin("CodeBool", BFCodeBool)
	addUniBuiltin("CodeU8", BFCodeU8)
	addUniBuiltin("CodeU16", BFCodeU16)
	addUniBuiltin("CodeU32", BFCodeU32)
	addUniBuiltin("CodeU64", BFCodeU64)
	addUniBuiltin("CodeUsize", BFCodeUsize)
	addUniBuiltin("CodeI8", BFCodeI8)
	addUniBuiltin("CodeI16", BFCodeI16)
	addUniBuiltin("CodeI32", BFCodeI32)
	addUniBuiltin("CodeI64", BFCodeI64)
	addUniBuiltin("CodeInt", BFCodeInt)
	addUniBuiltin("CodeString", BFCodeString)
	addUniBuiltin("CodeArray", BFCodeArray)
	addUniBuiltin("CodeStruct", BFCodeStruct)
	addUniBuiltin("CodeField", BFCodeField)
	addUniBuiltin("CodeUniv", BFCodeUniv)
}

func lookupUniverse(nameStr u32) u32 {
	for i := u32(0); i < uniSymCount; i++ {
		if syms[uniSyms[i]].nameStr == nameStr {
			return uniSyms[i]
		}
	}
	return 0
}

func lookupPkgSym(pkgID u32, nameStr u32) u32 {
	if pkgID >= pkgCount {
		return 0
	}
	p := pkgs[pkgID]
	for i := u32(0); i < p.symCount; i++ {
		s := pkgSyms[p.symStart+i]
		if syms[s].nameStr == nameStr {
			return s
		}
	}
	return 0
}

func lookupPkgOrUniverse(pkgID u32, nameStr u32) u32 {
	if s := lookupPkgSym(pkgID, nameStr); s != 0 {
		return s
	}
	return lookupUniverse(nameStr)
}

func lookupFileImport(fileID u32, aliasStr u32) (u32, bool) {
	for i := u32(0); i < fileImportCount; i++ {
		if fileImports[i].fileID == fileID && fileImports[i].aliasStr == aliasStr {
			return fileImports[i].pkgID, true
		}
	}
	return 0, false
}

// ---------------------------------------------------------------------------
// Multi-package loader (loads root + transitive imports in topological order)

driver func loadProgram(fs FS, target []byte) error {
	loadModuleForTarget(fs, target)
	pid, err := loadPkg(fs, target, true, 0, 0)
	if err != nil {
		return err
	}
	rootPkgID = pid
	assignPkgPrefixes()
	// Register declarations of all packages in topological order
	poc := pkgOrderCount
	for i := u32(0); i < poc; i++ {
		registerPkgDecls(pkgOrder[i])
	}
	// Load compile-time embedded files (`embed` / `embedBytes`) before const eval
	loadEmbeds(fs)
	// Resolve all type declarations & function signatures in topological order
	for i := u32(0); i < poc; i++ {
		resolvePkgSignatures(pkgOrder[i])
	}
	return nil
}

driver func loadPkg(fs FS, path []byte, isRoot bool, impFileID u32, impOff u32) (u32, error) {
	pathStr := internBytes(path)
	// Check if already loaded or currently loading (cycle!)
	if !isRoot {
		pc := pkgCount
		for i := u32(0); i < pc; i++ {
			if pkgs[i].importPathStr == pathStr {
				if pkgs[i].state == 1 {
					addDiagStr(E2006, impFileID, impOff, "import cycle detected")
					return i, nil
				}
				return i, nil
			}
		}
	}
	if pkgCount >= MaxPkgs {
		return 0, ErrArenaFull
	}
	pid := pkgCount
	pkgCount++
	pkgs[pid] = Pkg{importPathStr: pathStr, state: 1}

	// Resolve filesystem directory for imported package
	var dirBuf [512]byte
	var dirLen usize = 0
	if isRoot {
		dirLen = copy(dirBuf[:], path)
	} else {
		if fincRootLen > 0 && isStdImport(path) {
			dirLen = bufAppend(dirBuf[:], 0, fincRootBuf[:fincRootLen])
			dirLen = bufAppendByte(dirBuf[:], dirLen, '/')
			dirLen = bufAppend(dirBuf[:], dirLen, path)
		} else if ml, okMod := resolveModuleImport(dirBuf[:], path); okMod {
			dirLen = ml
		} else {
			dirLen = copy(dirBuf[:], path)
		}
		if !fs.IsDir(bytesToStr(dirBuf[:dirLen])) {
			addDiagStr(E2001, impFileID, impOff, "imported package directory not found")
			pkgs[pid].state = 2
			return pid, nil
		}
	}

	// Load and parse source file(s) of this package
	var localFids [64]u32
	nf := usize(0)
	if fs.IsDir(bytesToStr(dirBuf[:dirLen])) {
		var names [64]string
		n, err := fs.ListSourceFiles(bytesToStr(dirBuf[:dirLen]), names[:])
		if err != nil {
			return pid, err
		}
		var fpBuf [512]byte
		for i := usize(0); i < n; i++ {
			p := bufAppend(fpBuf[:], 0, dirBuf[:dirLen])
			if p > 0 && fpBuf[p-1] != '/' {
				p = bufAppendByte(fpBuf[:], p, '/')
			}
			p = bufAppendStr(fpBuf[:], p, names[i])
			fid, lerr := loadAndParseFile(fs, fpBuf[:p])
			if lerr != nil {
				return pid, lerr
			}
			if nf < len(localFids) {
				localFids[nf] = fid
				nf++
			}
		}
	} else {
		fid, lerr := loadAndParseFile(fs, dirBuf[:dirLen])
		if lerr != nil {
			return pid, lerr
		}
		localFids[0] = fid
		nf = 1
	}

	// Record files for this package (contiguously in pkgFiles)
	fsStart := pkgFileCount
	for i := usize(0); i < nf; i++ {
		if pkgFileCount < MaxFiles {
			pkgFiles[pkgFileCount] = localFids[i]
			pkgFileCount++
		}
	}
	pkgs[pid].fileStart = fsStart
	pkgs[pid].fileCount = u32(nf)
	if nf > 0 {
		pkgs[pid].nameStr = nodes[files[localFids[0]].astNode].a
	}

	// Load imported packages of each file
	for i := usize(0); i < nf; i++ {
		fid := localFids[i]
		fn := nodes[files[fid].astNode]
		for j := u32(0); j < fn.c; j++ {
			impNode := nodes[listPool[fn.b+j]]
			impPath := strSlice(impNode.b)
			depID, derr := loadPkg(fs, impPath, false, fid, impNode.off)
			if derr != nil {
				return pid, derr
			}
			alias := impNode.a
			if alias == 0 {
				alias = pkgs[depID].nameStr
			}
			if fileImportCount < MaxFileImps {
				fileImports[fileImportCount] = FileImport{fileID: fid, aliasStr: alias, pkgID: depID}
				fileImportCount++
			}
		}
	}

	pkgs[pid].state = 2
	if pkgOrderCount < MaxPkgs {
		pkgOrder[pkgOrderCount] = pid
		pkgOrderCount++
	}
	return pid, nil
}

func isStdImport(path []byte) bool {
	if len(path) == 3 && path[0] == 's' && path[1] == 't' && path[2] == 'd' {
		return true
	}
	return len(path) >= 4 && path[0] == 's' && path[1] == 't' && path[2] == 'd' && path[3] == '/'
}

driver func loadAndParseFile(fs FS, path []byte) (u32, error) {
	off := srcUsed
	if usize(off) >= MaxSrcBytes {
		return 0, ErrArenaFull
	}
	n, err := fs.ReadFileInto(bytesToStr(path), srcBuf[usize(off):])
	if err != nil {
		return 0, err
	}
	srcUsed += u32(n)
	fid := addSourceFile(path, off, u32(n))
	lexFile(fid)
	_ = parseFile(fid)
	return fid, nil
}

func assignPkgPrefixes() {
	var buf [128]byte
	poc := pkgOrderCount
	for i := u32(0); i < poc; i++ {
		pid := pkgOrder[i]
		if pid == rootPkgID {
			pkgs[pid].prefixStr = 0
			continue
		}
		p := bufAppendStr(buf[:], 0, "_pkg_")
		p = bufAppend(buf[:], p, strSlice(pkgs[pid].nameStr))
		p = bufAppendByte(buf[:], p, '_')
		if i > 0 {
			// Ensure uniqueness across same-named packages
			dup := false
			for j := u32(0); j < i; j++ {
				if pkgs[pkgOrder[j]].nameStr == pkgs[pid].nameStr && pkgOrder[j] != rootPkgID {
					dup = true
				}
			}
			if dup {
				p += formatTo(buf[p:], "%d_", i)
			}
		}
		pkgs[pid].prefixStr = internBytes(buf[:p])
	}
}

// ---------------------------------------------------------------------------
// Package declaration registration & type/signature resolution

func registerPkgDecls(pkgID u32) {
	p := pkgs[pkgID]
	symStart := pkgSymCount
	for fi := u32(0); fi < p.fileCount; fi++ {
		fid := pkgFiles[p.fileStart+fi]
		fn := nodes[files[fid].astNode]
		for di := u32(0); di < fn.e; di++ {
			dn := listPool[fn.d+di]
			d := nodes[dn]
			if d.kind == NKTypeDecl {
				s := addSym(Sym{
					kind:     SymType,
					nameStr:  d.a,
					pkgID:    pkgID,
					fileID:   fid,
					off:      d.off,
					declNode: dn,
				})
				if d.flags == 0 {
					// Pre-allocate Named type so self/mutual references resolve cleanly!
					ty := newType(Type{kind: TKindNamed, a: s})
					syms[s].typeID = ty
				}
				nodeSym[dn] = s
				if pkgSymCount < MaxSyms {
					pkgSyms[pkgSymCount] = s
					pkgSymCount++
				}
			} else if d.kind == NKConstDecl {
				s := addSym(Sym{
					kind:     SymConst,
					nameStr:  d.a,
					pkgID:    pkgID,
					fileID:   fid,
					off:      d.off,
					declNode: dn,
				})
				nodeSym[dn] = s
				if pkgSymCount < MaxSyms {
					pkgSyms[pkgSymCount] = s
					pkgSymCount++
				}
			} else if d.kind == NKVarDecl {
				s := addSym(Sym{
					kind:     SymVar,
					nameStr:  d.a,
					pkgID:    pkgID,
					fileID:   fid,
					off:      d.off,
					declNode: dn,
				})
				nodeSym[dn] = s
				if pkgSymCount < MaxSyms {
					pkgSyms[pkgSymCount] = s
					pkgSymCount++
				}
			} else if d.kind == NKFuncDecl {
				if d.b == 0 {
					// Plain function
					s := addSym(Sym{
						kind:     SymFunc,
						nameStr:  d.a,
						pkgID:    pkgID,
						fileID:   fid,
						off:      d.off,
						declNode: dn,
					})
					nodeSym[dn] = s
					if pkgSymCount < MaxSyms {
						pkgSyms[pkgSymCount] = s
						pkgSymCount++
					}
					if pkgID == rootPkgID && d.a == kwMain {
						mainFuncSym = s
					}
				} else {
					// Method (not in package namespace; registered in methods table later)
					rn := nodes[d.b]
					var fl u8 = 0
					if (rn.flags & 1) != 0 {
						fl = 8 // ptrRecv
					}
					if (rn.flags & 2) != 0 {
						fl |= 16 // constPtrRecv
					}
					s := addSym(Sym{
						kind:     SymMethod,
						flags:    fl,
						nameStr:  d.a,
						pkgID:    pkgID,
						fileID:   fid,
						off:      d.off,
						declNode: dn,
					})
					nodeSym[dn] = s
				}
			} else if d.kind == NKEffectDecl {
				s := addSym(Sym{
					kind:     SymEffect,
					nameStr:  d.a,
					pkgID:    pkgID,
					fileID:   fid,
					off:      d.off,
					declNode: dn,
				})
				ty := newType(Type{kind: TKindEffect, a: s})
				types[ty].origin = ty
				syms[s].typeID = ty
				nodeSym[dn] = s
				nodeType[dn] = ty
				if pkgSymCount < MaxSyms {
					pkgSyms[pkgSymCount] = s
					pkgSymCount++
				}
			}
		}
	}
	pkgs[pkgID].symStart = symStart
	pkgs[pkgID].symCount = pkgSymCount - symStart
}

// Active type-parameter scope during signature/body checking.
var activeTPSyms [32]u32
var activeTPCount u32

driver func pushTypeParam(tpNode u32, pkgID u32) u32 {
	tn := nodes[tpNode]
	var cty u32 = TYAny
	if (tn.flags&1) != 0 && tn.b != 0 {
		cty = resolveTypeNode(pkgID, tn.b)
	}
	s := addSym(Sym{
		kind:     SymTypeParam,
		flags:    u8(tn.flags),
		nameStr:  tn.a,
		pkgID:    pkgID,
		fileID:   tn.fileID,
		off:      tn.off,
		declNode: tpNode,
	})
	ty := newType(Type{kind: TKindTypeParam, flags: tn.flags, a: s, b: cty})
	syms[s].typeID = ty
	nodeSym[tpNode] = s
	nodeType[tpNode] = ty
	if activeTPCount < 32 {
		activeTPSyms[activeTPCount] = s
		activeTPCount++
	}
	return s
}

func lookupActiveTP(nameStr u32) u32 {
	if activeTPCount == 0 {
		return 0
	}
	i := activeTPCount
	for step := u32(0); step < 32; step++ {
		if i == 0 {
			break
		}
		i--
		if syms[activeTPSyms[i]].nameStr == nameStr {
			return activeTPSyms[i]
		}
	}
	return 0
}

driver func resolvePkgSignatures(pkgID u32) {
	p := pkgs[pkgID]
	// 1. Register type parameters on generic type & effect declarations first
	for i := u32(0); i < p.symCount; i++ {
		s := pkgSyms[p.symStart+i]
		if syms[s].kind == SymType || syms[s].kind == SymEffect {
			dn := syms[s].declNode
			d := nodes[dn]
			if d.c > 0 {
				saved := activeTPCount
				var tps [16]u32
				for j := u32(0); j < d.c; j++ {
					tps[j] = pushTypeParam(listPool[d.b+j], pkgID)
				}
				ts, tc := pushTypeList(tps[:usize(d.c)])
				syms[s].extra = ts
				syms[s].extra2 = tc
				activeTPCount = saved
			}
		}
	}
	// 2. Evaluate constants
	for i := u32(0); i < p.symCount; i++ {
		s := pkgSyms[p.symStart+i]
		if syms[s].kind == SymConst {
			evalConstSym(s)
		}
	}
	// 3. Resolve underlying types of all type declarations & effect operations
	for i := u32(0); i < p.symCount; i++ {
		s := pkgSyms[p.symStart+i]
		if syms[s].kind == SymType {
			resolveTypeDeclSym(s)
		}
	}
	for i := u32(0); i < p.symCount; i++ {
		s := pkgSyms[p.symStart+i]
		if syms[s].kind == SymEffect {
			resolveEffectDeclSym(s)
		}
	}
	// 4. Resolve package-level var types & check E3001 (no global scoped/linear)
	for i := u32(0); i < p.symCount; i++ {
		s := pkgSyms[p.symStart+i]
		if syms[s].kind == SymVar {
			dn := syms[s].declNode
			d := nodes[dn]
			var ty u32 = 0
			if d.b != 0 {
				ty = resolveTypeNode(pkgID, d.b)
			} else if d.c != 0 {
				v, ok := evalConstExpr(pkgID, d.c, 0)
				if ok && v != 0 {
					ty = defaultType(vals[v].typeID)
					syms[s].valID = v
				}
			}
			if d.c != 0 && syms[s].valID == 0 {
				v, ok := evalConstExpr(pkgID, d.c, 0)
				if ok && v != 0 {
					syms[s].valID = v
				}
			}
			syms[s].typeID = ty
			nodeType[dn] = ty
			if ty != 0 && classOf(ty) != ClsValue {
				addDiagStr(E3001, d.fileID, d.off, "package-level variable cannot have Scoped or Linear type")
			}
		}
	}
	// 5. Resolve all function and method signatures & register methods
	for fi := u32(0); fi < p.fileCount; fi++ {
		fid := pkgFiles[p.fileStart+fi]
		fn := nodes[files[fid].astNode]
		for di := u32(0); di < fn.e; di++ {
			dn := listPool[fn.d+di]
			if nodes[dn].kind == NKFuncDecl {
				resolveFuncDeclSig(pkgID, dn)
			}
		}
	}
	// 6. Retry any constants that depended on types/methods resolved in steps 3-5
	for i := u32(0); i < p.symCount; i++ {
		s := pkgSyms[p.symStart+i]
		if syms[s].kind == SymConst && syms[s].valID == 0 {
			syms[s].flags = syms[s].flags & ^u8(4)
			evalConstSym(s)
		}
	}
}

driver func evalConstSym(sym u32) {
	if (syms[sym].flags & 4) != 0 {
		return
	}
	if (syms[sym].flags & 2) != 0 {
		addDiagStr(E2001, syms[sym].fileID, syms[sym].off, "cyclic constant definition")
		return
	}
	syms[sym].flags |= 2 // checking
	dn := syms[sym].declNode
	d := nodes[dn]
	pkgID := syms[sym].pkgID
	var declTy u32 = 0
	if d.b != 0 {
		declTy = resolveTypeNode(pkgID, d.b)
	}
	v, ok := evalConstExpr(pkgID, d.c, d.d)
	if ok && v != 0 {
		if declTy != 0 {
			syms[sym].typeID = declTy
			if vals[v].kind == VKInt {
				v = makeIntVal(valMaskInt(vals[v].u64Val, declTy), isSignedInt(declTy), declTy)
			}
			syms[sym].valID = v
		} else {
			vt := vals[v].typeID
			if isUntyped(vt) {
				syms[sym].flags |= 1 // untypedConst
				syms[sym].typeID = defaultType(vt)
			} else {
				syms[sym].typeID = vt
			}
			syms[sym].valID = v
		}
		nodeVal[d.c] = syms[sym].valID
		nodeType[dn] = syms[sym].typeID
	} else {
		if declTy != 0 {
			syms[sym].typeID = declTy
		}
	}
	syms[sym].flags = (syms[sym].flags & ^u8(2)) | 4 // checked
}

driver func resolveTypeDeclSym(sym u32) {
	if (syms[sym].flags & 4) != 0 {
		return
	}
	if (syms[sym].flags & 2) != 0 {
		return
	}
	syms[sym].flags |= 2
	dn := syms[sym].declNode
	d := nodes[dn]
	pkgID := syms[sym].pkgID

	saved := activeTPCount
	tpCnt := syms[sym].extra2
	for i := u32(0); i < tpCnt; i++ {
		if activeTPCount < 32 {
			activeTPSyms[activeTPCount] = typeList[syms[sym].extra+i]
			activeTPCount++
		}
	}
	rhs := resolveTypeNode(pkgID, d.d)
	activeTPCount = saved

	if d.flags != 0 {
		// Type alias `type A = T`
		syms[sym].typeID = rhs
	} else {
		// Defined named type `type T ...`
		ty := syms[sym].typeID
		types[ty].b = rhs
		types[ty].origin = ty
	}
	nodeType[dn] = syms[sym].typeID
	syms[sym].flags = (syms[sym].flags & ^u8(2)) | 4
}

driver func resolveEffectDeclSym(sym u32) {
	if (syms[sym].flags & 4) != 0 {
		return
	}
	syms[sym].flags |= 4
	dn := syms[sym].declNode
	d := nodes[dn]
	pkgID := syms[sym].pkgID

	saved := activeTPCount
	tpCnt := syms[sym].extra2
	for i := u32(0); i < tpCnt; i++ {
		if activeTPCount < 32 {
			activeTPSyms[activeTPCount] = typeList[syms[sym].extra+i]
			activeTPCount++
		}
	}
	opStart := effOpCount
	for i := u32(0); i < d.e; i++ {
		opn := listPool[d.d+i]
		op := nodes[opn]
		sn := nodes[op.b]
		var ptypes [32]u32
		for j := u32(0); j < sn.d; j++ {
			pn := listPool[sn.c+j]
			pt := resolveTypeNode(pkgID, nodes[pn].b)
			nodeType[pn] = pt
			ptypes[j] = pt
		}
		var rtypes [16]u32
		nr := u32(0)
		if sn.e != 0 {
			rl := nodes[sn.e]
			nr = rl.b
			for j := u32(0); j < nr; j++ {
				rtypes[j] = resolveTypeNode(pkgID, listPool[rl.a+j])
			}
		}
		ps, pc := pushTypeList(ptypes[:usize(sn.d)])
		rs, rc := pushTypeList(rtypes[:usize(nr)])
		opSig := newType(Type{kind: TKindSig, op: EffTotal, a: ps, b: pc, c: rs, d: rc})
		nodeType[opn] = opSig
		if effOpCount < MaxEffOps {
			effOps[effOpCount] = EffectOp{effSym: sym, nameStr: op.a, sigType: opSig, opIdx: i}
			effOpCount++
		}
	}
	symEffOpStart[sym] = opStart
	symEffOpCount[sym] = effOpCount - opStart
	activeTPCount = saved
}

driver func resolveFuncDeclSig(pkgID u32, dn u32) {
	d := nodes[dn]
	sym := nodeSym[dn]
	saved := activeTPCount

	var allTPs [16]u32
	nTP := usize(0)

	// Method receiver?
	if d.b != 0 {
		rn := nodes[d.b]
		recvTypeSym := lookupPkgSym(pkgID, rn.b)
		if recvTypeSym == 0 || syms[recvTypeSym].kind != SymType {
			addDiagStr(E2001, rn.fileID, rn.off, "undefined receiver type")
		} else {
			syms[sym].extra = recvTypeSym
			// Register receiver type parameters aligned with recvTypeSym's type params!
			for i := u32(0); i < rn.d; i++ {
				tpn := listPool[rn.c+i]
				// Inherit isConst & constType from recvTypeSym's corresponding type param
				if i < syms[recvTypeSym].extra2 {
					origTP := syms[typeList[syms[recvTypeSym].extra+i]]
					nodes[tpn].flags = u16(origTP.flags)
					tpSym := addSym(Sym{
						kind:     SymTypeParam,
						flags:    origTP.flags,
						nameStr:  nodes[tpn].a,
						pkgID:    pkgID,
						fileID:   nodes[tpn].fileID,
						off:      nodes[tpn].off,
						declNode: tpn,
					})
					tpTy := newType(Type{kind: TKindTypeParam, flags: u16(origTP.flags), a: tpSym, b: types[origTP.typeID].b})
					syms[tpSym].typeID = tpTy
					nodeSym[tpn] = tpSym
					nodeType[tpn] = tpTy
					if activeTPCount < 32 {
						activeTPSyms[activeTPCount] = tpSym
						activeTPCount++
					}
					if nTP < len(allTPs) {
						allTPs[nTP] = tpSym
						nTP++
					}
				}
			}
			// Build instantiated receiver type
			rty := syms[recvTypeSym].typeID
			if nTP > 0 {
				var rargs [16]u32
				for i := usize(0); i < nTP; i++ {
					rargs[i] = syms[allTPs[i]].typeID
				}
				rty = instantiateNamed(rty, rargs[:nTP])
			}
			if (rn.flags & 2) != 0 {
				rty = makeConstPtrType(rty)
			} else if (rn.flags & 1) != 0 {
				rty = makePtrType(rty)
			}
			nodeType[d.b] = rty
			if methodCount < MaxMethods {
				methods[methodCount] = MethodEntry{
					recvTypeSym: recvTypeSym,
					nameStr:     d.a,
					funcSym:     sym,
					ptrRecv:     rn.flags != 0,
				}
				methodCount++
			}
		}
	}

	// Function's own type parameters
	sn := nodes[d.c]
	for i := u32(0); i < sn.b; i++ {
		tps := pushTypeParam(listPool[sn.a+i], pkgID)
		if nTP < len(allTPs) {
			allTPs[nTP] = tps
			nTP++
		}
	}
	if nTP > 0 {
		ts, tc := pushTypeList(allTPs[:nTP])
		// Store func type params on nodeInstStart/Count of func decl (so extra stays recvTypeSym for methods!)
		nodeInstStart[dn] = ts
		nodeInstCount[dn] = tc
	}

	// Parameters
	var ptypes [32]u32
	var variadic u16 = 0
	for i := u32(0); i < sn.d; i++ {
		pn := listPool[sn.c+i]
		pt := resolveTypeNode(pkgID, nodes[pn].b)
		if nodes[pn].flags != 0 {
			variadic = 1
			pt = makeSliceType(pt)
		}
		nodeType[pn] = pt
		ptypes[i] = pt
	}
	// Results
	var rtypes [16]u32
	nr := u32(0)
	if sn.e != 0 {
		rl := nodes[sn.e]
		nr = rl.b
		for i := u32(0); i < nr; i++ {
			rt := resolveTypeNode(pkgID, listPool[rl.a+i])
			rtypes[i] = rt
		}
	}
	ps, pc := pushTypeList(ptypes[:usize(sn.d)])
	rs, rc := pushTypeList(rtypes[:usize(nr)])
	sigTy := newType(Type{kind: TKindSig, op: d.op, flags: variadic, a: ps, b: pc, c: rs, d: rc})
	// Resolve `with E1, E2, ...` effect capabilities on signature
	ec := sigEffCount[d.c]
	if ec > 0 {
		var effs [16]u32
		ne := usize(0)
		driver for i := u32(0); i < ec && i < 16; i++ {
			et := resolveTypeNode(pkgID, listPool[sigEffStart[d.c]+i])
			if et != 0 && types[et].kind != TKindEffect {
				addDiagStr(E2002, nodes[listPool[sigEffStart[d.c]+i]].fileID, nodes[listPool[sigEffStart[d.c]+i]].off, "with clause requires an effect type")
			}
			effs[ne] = et
			ne++
		}
		es, ec2 := pushTypeList(effs[:ne])
		sigTypeEffStart[sigTy] = es
		sigTypeEffCount[sigTy] = ec2
	}
	syms[sym].typeID = sigTy
	nodeType[dn] = sigTy
	activeTPCount = saved
}

driver func resolveTypeNode(pkgID u32, tn u32) u32 {
	if tn == 0 {
		return TYInvalid
	}
	if nodeType[tn] != 0 {
		return nodeType[tn]
	}
	n := nodes[tn]
	var res u32 = TYInvalid
	if n.kind == NKTypePtr {
		res = newType(Type{kind: TKindPtr, flags: n.flags, a: resolveTypeNode(pkgID, n.a)})
	} else if n.kind == NKTypeSlice {
		res = newType(Type{kind: TKindSlice, flags: n.flags, a: resolveTypeNode(pkgID, n.a)})
	} else if n.kind == NKTypeArray {
		elem := resolveTypeNode(pkgID, n.b)
		// Resolve symbolic QTT 0-multiplicity dimension expression (`[N]T`, `[m + n]T`, `[n * 2]T`)!
		dimID, dimVal, dimOk := resolveDimExpr(pkgID, n.a)
		if dimOk {
			res = newType(Type{kind: TKindArray, a: elem, b: dimID, lenVal: dimVal})
		} else {
			addDiagStr(E2002, n.fileID, n.off, "array length must be a constant or indexed dimension expression")
			res = makeArrayType(elem, 0)
		}
	} else if n.kind == NKTypeStruct {
		var fbuf [128]Field
		for i := u32(0); i < n.b; i++ {
			fn := nodes[listPool[n.a+i]]
			ft := resolveTypeNode(pkgID, fn.b)
			fbuf[i] = Field{nameStr: fn.a, typeID: ft}
		}
		fs := fieldCount
		for i := u32(0); i < n.b; i++ {
			if fieldCount < MaxFields {
				fields[fieldCount] = fbuf[i]
				fieldCount++
			}
		}
		res = newType(Type{kind: TKindStruct, a: fs, b: n.b})
	} else if n.kind == NKTypeEnum {
		var vbuf [64]Variant
		for i := u32(0); i < n.b; i++ {
			vn := nodes[listPool[n.a+i]]
			var pbuf [16]u32
			for j := u32(0); j < vn.c; j++ {
				pbuf[j] = resolveTypeNode(pkgID, listPool[vn.b+j])
			}
			ps, pc := pushTypeList(pbuf[:usize(vn.c)])
			vbuf[i] = Variant{nameStr: vn.a, payStart: ps, payCount: pc}
		}
		vs := variantCount
		for i := u32(0); i < n.b; i++ {
			if variantCount < MaxVariants {
				variants[variantCount] = vbuf[i]
				variantCount++
			}
		}
		res = newType(Type{kind: TKindEnum, a: vs, b: n.b})
	} else if n.kind == NKTypeFunc {
		var ptypes [32]u32
		for i := u32(0); i < n.b; i++ {
			pn := nodes[listPool[n.a+i]]
			ptypes[i] = resolveTypeNode(pkgID, pn.b)
		}
		var rtypes [16]u32
		for i := u32(0); i < n.d; i++ {
			rtypes[i] = resolveTypeNode(pkgID, listPool[n.c+i])
		}
		ps, pc := pushTypeList(ptypes[:usize(n.b)])
		rs, rc := pushTypeList(rtypes[:usize(n.d)])
		res = newType(Type{kind: TKindSig, op: n.op, a: ps, b: pc, c: rs, d: rc})
	} else if n.kind == NKTypeCode {
		res = newType(Type{kind: TKindCode, a: n.a})
	} else if n.kind == NKTypeEl {
		v, ok := evalConstExpr(pkgID, n.a, 0)
		if !ok || v == 0 || vals[v].kind != VKCode {
			addDiagStr(E2010, n.fileID, n.off, "El argument must evaluate to a compile-time Code value")
			res = TYInvalid
		} else {
			res = decodeCodeType(v)
		}
	} else if n.kind == NKTypeName {
		var sym u32 = 0
		if n.a != 0 {
			// Package-qualified type `pkg.T`
			if targetPkg, ok := lookupFileImport(n.fileID, n.a); ok {
				sym = lookupPkgSym(targetPkg, n.b)
			}
		} else {
			sym = lookupActiveTP(n.b)
			if sym == 0 {
				sym = lookupPkgOrUniverse(pkgID, n.b)
			}
		}
		if sym == 0 || (syms[sym].kind != SymType && syms[sym].kind != SymTypeParam && syms[sym].kind != SymEffect) {
			addDiagStr(E2001, n.fileID, n.off, "undefined type")
			return TYInvalid
		}
		if syms[sym].kind == SymType && syms[sym].declNode != 0 && syms[sym].typeID == 0 {
			resolveTypeDeclSym(sym)
		}
		res = syms[sym].typeID
		if n.d > 0 {
			// Generic instantiation `T[arg0, arg1, ...]` or `Eff[arg0, ...]`
			if syms[sym].kind == SymType && syms[sym].declNode != 0 {
				resolveTypeDeclSym(sym)
			}
			var args [16]u32
			for i := u32(0); i < n.d; i++ {
				an := listPool[n.c+i]
				args[i] = resolveGenericArg(pkgID, an, sym, i)
			}
			if syms[sym].kind == SymEffect {
				res = instantiateEffect(res, args[:usize(n.d)])
			} else {
				res = instantiateNamed(res, args[:usize(n.d)])
			}
		}
	} else if n.kind == NKTypeExpr {
		res = resolveTypeNode(pkgID, n.a)
	}
	nodeType[tn] = res
	return res
}

// resolveGenericArg resolves a type or const argument inside `[...]` for generic sym's argIdx-th param.
driver func resolveGenericArg(pkgID u32, argNode u32, targetSym u32, argIdx u32) u32 {
	var tpSym u32 = 0
	isConstParam := false
	if targetSym != 0 && syms[targetSym].kind == SymType && argIdx < syms[targetSym].extra2 {
		tpSym = typeList[syms[targetSym].extra+argIdx]
		isConstParam = (syms[tpSym].flags & 1) != 0
	} else if targetSym != 0 && syms[targetSym].kind == SymFunc {
		dn := syms[targetSym].declNode
		if argIdx < nodeInstCount[dn] {
			tpSym = typeList[nodeInstStart[dn]+argIdx]
			isConstParam = (syms[tpSym].flags & 1) != 0
		}
	}
	if nodes[argNode].kind == NKTypeExpr {
		rty := resolveTypeNode(pkgID, nodes[argNode].a)
		if tpSym != 0 && !isConstParam {
			needC := u16(syms[tpSym].flags >> 1)
			if needC != 0 && !satisfiesConstraint(rty, needC) {
				addDiagStr(E2011, nodes[argNode].fileID, nodes[argNode].off, "type argument does not satisfy generic constraint")
			}
		}
		return rty
	}
	if isConstParam {
		if nodes[argNode].kind == NKIdent {
			if tps := lookupActiveTP(nodes[argNode].a); tps != 0 {
				return syms[tps].typeID
			}
		}
		dimID, dimVal, dimOk := resolveDimExpr(pkgID, argNode)
		if dimOk {
			if dimID == 0 {
				return makeConstArgType(dimVal)
			}
			// Symbolic const arg (e.g. f[m + n, T])
			return newType(Type{kind: TKindConstArg, a: dimID})
		}
		addDiagStr(E2002, nodes[argNode].fileID, nodes[argNode].off, "const type argument must be a compile-time integer or dimension expression")
		return makeConstArgType(0)
	}
	// Type argument parsed as expr (NKIdent / NKSelector / NKIndex)
	rty := resolveExprAsType(pkgID, argNode)
	if tpSym != 0 {
		needC := u16(syms[tpSym].flags >> 1)
		if needC != 0 && !satisfiesConstraint(rty, needC) {
			addDiagStr(E2011, nodes[argNode].fileID, nodes[argNode].off, "type argument does not satisfy generic constraint")
		}
	}
	return rty
}

driver func resolveExprAsType(pkgID u32, en u32) u32 {
	if en == 0 {
		return TYInvalid
	}
	n := nodes[en]
	if n.kind == NKTypeExpr {
		return resolveTypeNode(pkgID, n.a)
	}
	if n.kind == NKIdent {
		sym := lookupActiveTP(n.a)
		if sym == 0 {
			sym = lookupPkgOrUniverse(pkgID, n.a)
		}
		if sym != 0 && (syms[sym].kind == SymType || syms[sym].kind == SymTypeParam) {
			if syms[sym].kind == SymType && syms[sym].declNode != 0 && syms[sym].typeID == 0 {
				resolveTypeDeclSym(sym)
			}
			return syms[sym].typeID
		}
		return TYInvalid
	}
	if n.kind == NKSelector && nodes[n.a].kind == NKIdent {
		if targetPkg, ok := lookupFileImport(n.fileID, nodes[n.a].a); ok {
			sym := lookupPkgSym(targetPkg, n.b)
			if sym != 0 && syms[sym].kind == SymType {
				if syms[sym].declNode != 0 && syms[sym].typeID == 0 {
					resolveTypeDeclSym(sym)
				}
				return syms[sym].typeID
			}
		}
		return TYInvalid
	}
	if n.kind == NKUnary && n.op == TKMul {
		return makePtrType(resolveExprAsType(pkgID, n.a))
	}
	if n.kind == NKIndex {
		baseTy := resolveExprAsType(pkgID, n.a)
		if baseTy == 0 {
			return TYInvalid
		}
		origSym := typeOriginSym(baseTy)
		var args [16]u32
		for i := u32(0); i < n.c; i++ {
			args[i] = resolveGenericArg(pkgID, listPool[n.b+i], origSym, i)
		}
		return instantiateNamed(baseTy, args[:usize(n.c)])
	}
	return TYInvalid
}

// resolveDimExpr resolves a QTT 0-multiplicity array dimension expression (`N`, `m + n`, `n * 2`, `n - 1`, or const expr).
// Returns (dimID, constVal, ok); dimID == 0 means pure constant `constVal`.
driver func resolveDimExpr(pkgID u32, en u32) (u32, u64, bool) {
	if en == 0 {
		return 0, 0, false
	}
	n := nodes[en]
	if n.kind == NKIdent {
		if tps := lookupActiveTP(n.a); tps != 0 && syms[tps].flags != 0 {
			return makeDimParam(tps), 0, true
		}
	}
	if n.kind == NKBinary && (n.op == TKAdd || n.op == TKSub || n.op == TKMul) {
		ld, lv, lok := resolveDimExpr(pkgID, n.a)
		rd, rv, rok := resolveDimExpr(pkgID, n.b)
		if lok && rok {
			if ld == 0 && rd == 0 {
				if n.op == TKAdd {
					return 0, lv + rv, true
				}
				if n.op == TKSub {
					if lv >= rv {
						return 0, lv - rv, true
					}
					return 0, 0, true
				}
				return 0, lv * rv, true
			}
			var la u32 = ld
			if la == 0 {
				la = makeDimConst(lv)
			}
			var rb u32 = rd
			if rb == 0 {
				rb = makeDimConst(rv)
			}
			var d u32 = 0
			if n.op == TKAdd {
				d = makeDimAdd(la, rb)
			} else if n.op == TKSub {
				d = makeDimSub(la, rb)
			} else {
				d = makeDimMul(la, rb)
			}
			if dimExprs[d].kind == DimConst {
				return 0, dimExprs[d].val, true
			}
			return d, 0, true
		}
	}
	v, ok := evalConstExpr(pkgID, en, 0)
	if ok && v != 0 && vals[v].kind == VKInt {
		return 0, vals[v].u64Val, true
	}
	return 0, 0, false
}
