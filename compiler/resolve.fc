// resolve.fc — name resolution (port of finc0's bootstrap/internal/resolve:
// universe.go, resolve.go). The loader that reads imported packages lives
// in main.fc (it needs FS); this file builds the universe, declares the
// package-level symbols of every package and binds every identifier use
// (defs/uses side tables, function-literal captures).
//
// The binder is one recursive SCC (bindExpr, bindType, stmt, ...): every
// member carries decreases(depth) and is entered with SemaDepth.
package main

// Predeclared entities (resolve.Builtin), in universe insertion order.
const (
	BNone        = 0
	BTBool       = 1
	BTU8         = 2
	BTU16        = 3
	BTU32        = 4
	BTU64        = 5
	BTI8         = 6
	BTI16        = 7
	BTI32        = 8
	BTI64        = 9
	BTInt        = 10
	BTUsize      = 11
	BTByte       = 12
	BTString     = 13
	BTError      = 14
	BTDuration   = 15
	BTSignal     = 16
	BTExitStatus = 17
	BTNet        = 18
	BTSignals    = 19
	BTClock      = 20
	BTListener   = 21
	BTConn       = 22
	BTContext    = 23
	BTCancelFunc = 24
	BTScope      = 25
	BTSlot       = 26
	BTFS         = 27
	BTEnv        = 28
	BTStdio      = 29
	BTExec       = 30
	BTCode       = 31
	BTEl         = 32
	BTFieldCode  = 33

	BCNanosecond   = 34
	BCMicrosecond  = 35
	BCMillisecond  = 36
	BCSecond       = 37
	BCSIGINT       = 38
	BCSIGTERM      = 39
	BCErrEOF       = 40
	BCErrTimeout   = 41
	BCErrCancelled = 42
	BCErrZeroWrite = 43
	BCErrClosed    = 44
	BCErrIO        = 45
	BCErrNotFound  = 46
	BCErrMaxDepth  = 47
	BCErrArenaFull = 48
	BCErrExec      = 49
	BCErrParse     = 50

	BFLen        = 51
	BFCap        = 52
	BFCopy       = 53
	BFBytesEqual = 54
	BFStrBytes   = 55
	BFBytesToStr = 56
	BFFormatUint = 57
	BFParseUint  = 58
	BFNewContext = 59
	BFNewScope   = 60
	BFPanic      = 61
	BFFormatTo   = 62 // v0.2
	BFCodeEmpty  = 63
	BFCodeUnit   = 64
	BFCodeBool   = 65
	BFCodeU8     = 66
	BFCodeU16    = 67
	BFCodeU32    = 68
	BFCodeU64    = 69
	BFCodeI8     = 70
	BFCodeI16    = 71
	BFCodeI32    = 72
	BFCodeI64    = 73
	BFCodeArray  = 74
	BFCodeSlice  = 75
	BFCodeStruct = 76
	BFCodeField  = 77
	BFCodeUniv   = 78

	NumBuiltins = 79
)

func builtinName(b u8) string {
	if b <= BTFieldCode {
		return builtinTypeName(b)
	}
	if b <= BCErrParse {
		return builtinConstName(b)
	}
	return builtinFuncName(b)
}

func builtinTypeName(b u8) string {
	if b == BTBool {
		return "bool"
	}
	if b == BTU8 {
		return "u8"
	}
	if b == BTU16 {
		return "u16"
	}
	if b == BTU32 {
		return "u32"
	}
	if b == BTU64 {
		return "u64"
	}
	if b == BTI8 {
		return "i8"
	}
	if b == BTI16 {
		return "i16"
	}
	if b == BTI32 {
		return "i32"
	}
	if b == BTI64 {
		return "i64"
	}
	if b == BTInt {
		return "int"
	}
	if b == BTUsize {
		return "usize"
	}
	if b == BTByte {
		return "byte"
	}
	if b == BTString {
		return "string"
	}
	if b == BTError {
		return "error"
	}
	if b == BTDuration {
		return "Duration"
	}
	if b == BTSignal {
		return "Signal"
	}
	if b == BTExitStatus {
		return "ExitStatus"
	}
	if b == BTNet {
		return "Net"
	}
	if b == BTSignals {
		return "Signals"
	}
	if b == BTClock {
		return "Clock"
	}
	if b == BTListener {
		return "Listener"
	}
	if b == BTConn {
		return "Conn"
	}
	if b == BTContext {
		return "Context"
	}
	if b == BTCancelFunc {
		return "CancelFunc"
	}
	if b == BTScope {
		return "Scope"
	}
	if b == BTSlot {
		return "Slot"
	}
	if b == BTFS {
		return "FS"
	}
	if b == BTEnv {
		return "Env"
	}
	if b == BTStdio {
		return "Stdio"
	}
	if b == BTExec {
		return "Exec"
	}
	if b == BTCode {
		return "Code"
	}
	if b == BTEl {
		return "El"
	}
	if b == BTFieldCode {
		return "FieldCode"
	}
	return "?"
}

