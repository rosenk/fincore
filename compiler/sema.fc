// sema.fc — the semantic data model of the self-hosted compiler (M7):
// interned names, symbols and scopes, packages, per-node and per-symbol side
// tables, linked-list cells, the sorted diagnostic list and small AST
// accessors. It mirrors finc0's resolve.Program and types.Info (see the
// README, section "Semantic model"), but everything is a fixed-capacity
// array indexed by u32 IDs (0 = none). Capacity exhaustion sets `semaFull`
// (with a reason) and the driver reports ErrArenaFull.
//
// Per-node side tables are indexed by the NodeArena index of the node (not
// by finc0's post-order NodeID, which is also available as Node.id).
package main

import (
	"std/bytes"
	"std/maps"
	"std/sort"
	"std/vec"
)

const (
	MaxNames     = 65_536
	MaxNameBytes = 1 << 20
	NameBuckets  = 131_072

	MaxSyms     = 131_072
	SymBuckets  = 524_288 // key (scp, name)
	MaxScopes   = 524_288
	MaxPkgs     = 64
	MaxULists   = 1 << 20
	MaxCells    = 524_288
	MaxFuncNest = 4096

	MaxDiags     = 8192
	MaxDiagBytes = 1 << 21

	SemaDepth = 1_000_000 // decreases budget of the recursive semantic passes
)

// ---------------------------------------------------------------------------
// Capacity failures

var semaFull bool
var semaFullWhat string

func setFull(what string) {
	if !semaFull {
		semaFull = true
		semaFullWhat = what
	}
}

// ---------------------------------------------------------------------------
// AST accessors (NodeArena index -> fields)

func nkind(n u32) u8 {
	return nodes.items[usize(n)].kind
}

func na(n u32) u32 {
	return nodes.items[usize(n)].a
}

func nb(n u32) u32 {
	return nodes.items[usize(n)].b
}

func nc(n u32) u32 {
	return nodes.items[usize(n)].c
}

func nd(n u32) u32 {
	return nodes.items[usize(n)].d
}

func ne(n u32) u32 {
	return nodes.items[usize(n)].e
}

func nf(n u32) u32 {
	return nodes.items[usize(n)].f
}

func nop(n u32) u8 {
	return nodes.items[usize(n)].op
}

func nflag(n u32) bool {
	return nodes.items[usize(n)].flags&Flag1 != 0
}

func nflag2(n u32) bool {
	return nodes.items[usize(n)].flags&Flag2 != 0
}

func nival(n u32) u64 {
	return nodes.items[usize(n)].ival
}

// l1len / l1at: the first child list.
func l1len(n u32) usize {
	return usize(nodes.items[usize(n)].l1n)
}

func l1at(n u32, i usize) u32 {
	return listAt(nodes.items[usize(n)].l1s, i)
}

func l2len(n u32) usize {
	return usize(nodes.items[usize(n)].l2n)
}

func l2at(n u32, i usize) u32 {
	return listAt(nodes.items[usize(n)].l2s, i)
}

// listAt returns element i of the node list starting at start.
func listAt(start u32, i usize) u32 {
	return nodes.listItem(start, i)
}

func ntext(n u32) []byte {
	s := usize(nodes.items[usize(n)].tOff)
	return sources.bytes[s : s+usize(nodes.items[usize(n)].tLen)]
}

func nfile(n u32) usize {
	return usize(nodes.items[usize(n)].file)
}

// ---------------------------------------------------------------------------
// Interned names. Every identifier spelling has a NameID (1-based); names
// compare by ID.

var names maps.Interner[NameBuckets, MaxNameBytes, MaxNames]

func nameBytes(id u32) []byte {
	return names.Bytes(id)
}

// intern returns the NameID of b (allocating it if new; 0 if full).
func intern(b []byte) u32 {
	id, ok := names.Intern(b)
	if !ok {
		setFull("names")
	}
	return id
}

func internStr(s string) u32 {
	return intern(strBytes(s))
}

// identNames caches the NameID of Ident nodes (by node index).
var identNames [MaxNodes]u32

// idName returns the NameID of an Ident node.
func idName(n u32) u32 {
	if n == 0 {
		return 0
	}
	v := identNames[usize(n)]
	if v != 0 {
		return v
	}
	v = intern(ntext(n))
	identNames[usize(n)] = v
	return v
}

// Frequently used names.
var nameBlank u32
var nameMain u32

func isBlank(n u32) bool {
	return idName(n) == nameBlank
}

func nameIs(id u32, s string) bool {
	return bytesEqual(nameBytes(id), strBytes(s))
}

// ---------------------------------------------------------------------------
// Symbols (resolve.Symbol)

// Symbol kinds.
const (
	SymBad       = 0
	SymPackage   = 1
	SymConst     = 2
	SymType      = 3
	SymVar       = 4
	SymFunc      = 5
	SymBuiltin   = 6
	SymTypeParam = 7
)

// Variable kinds.
const (
	VarNone    = 0
	VarGlobal  = 1
	VarLocal   = 2
	VarParam   = 3
	VarRecv    = 4
	VarBinding = 5
	VarScope   = 6
)

type Sym struct {
	kind     u8
	varKind  u8
	builtin  u8   // predeclared entity (Builtin), 0 otherwise
	objState u8   // checker: 0 unchecked, 1 in progress, 2 done
	body     u8   // checker (functions): 0 unchecked, 1 in progress, 2 ok, 3 errors
	untyped  bool // checker: untyped constant (UntypedConsts)
	name     u32  // NameID
	ident    u32  // defining Ident node (0 for predeclared symbols)
	decl     u32  // declaring node (see resolve.Symbol.Decl)
	pkg      u32  // declaring package (0 for predeclared symbols)
	fn       u32  // enclosing FuncDecl/FuncLit node of locals (0 = package level)
	imported u32  // SymPackage: the imported package
	recvType u32  // methods: NameID of the receiver type name (0 for funcs)
	scp      u32  // scope the symbol was inserted into (0 if none)
	typ      u32  // checker: SymTypes
	val      u32  // checker: SymValues (value slot, 0 = none)
	method   u32  // checker: MethodOf (method symbols)
}

type SymTable struct {
	items [MaxSyms]Sym
	count usize // including the reserved slot 0
}

var syms SymTable

// symTab maps (scope, name) to the symbol bound there.
var symTab maps.Table[SymBuckets]

func newSym(kind u8, name u32, ident u32, decl u32, pkg u32) u32 {
	if syms.count == 0 {
		syms.count = 1
	}
	if syms.count >= MaxSyms {
		setFull("symbols")
		return 0
	}
	id := syms.count
	syms.count++
	var s Sym
	s.kind = kind
	s.name = name
	s.ident = ident
	s.decl = decl
	s.pkg = pkg
	syms.items[id] = s
	return u32(id)
}

func symKind(s u32) u8 {
	return syms.items[usize(s)].kind
}

func symName(s u32) u32 {
	return syms.items[usize(s)].name
}

func symIsGlobal(s u32) bool {
	return syms.items[usize(s)].fn == 0
}

func isExportedName(id u32) bool {
	b := nameBytes(id)
	return len(b) > 0 && b[0] >= 'A' && b[0] <= 'Z'
}

// ---------------------------------------------------------------------------
// Scopes. All (scp, name) -> symbol bindings live in one open-addressing
// table; lookups walk the parent chain.

const (
	ScopeUniverse = 0
	ScopePackage  = 1
	ScopeFile     = 2
	ScopeTypeDecl = 3
	ScopeFunc     = 4
	ScopeBlock    = 5
)

type ScopeRec struct {
	parent u32
	kind   u8
	node   u32
}

var scopes vec.Vec[MaxScopes, ScopeRec] // ScopeID -> record (slot 0 reserved)

func newScope(parent u32, kind u8, node u32) u32 {
	if scopes.Len() == 0 {
		_ = scopes.Push(ScopeRec{})
	}
	id := u32(scopes.Len())
	if !scopes.Push(ScopeRec{parent: parent, kind: kind, node: node}) {
		setFull("scopes")
		return 0
	}
	return id
}

// symSlot returns the slot of (scp, name) in symTab: the one holding its
// symbol or the empty one where it goes; false if every slot is taken.
func symSlot(scp u32, name u32) (usize, bool) {
	s := symTab.Start(maps.Mix(maps.HashU64(u64(scp)), u64(name)))
	for g := usize(0); g < SymBuckets; g++ {
		id := usize(symTab.At(s))
		if id == 0 || syms.items[id].scp == scp && syms.items[id].name == name {
			return s, true
		}
		s = symTab.Next(s)
	}
	return 0, false
}

// lookupLocal finds name in scope only (0 if absent).
func lookupLocal(scp u32, name u32) u32 {
	s, ok := symSlot(scp, name) // no symbol is bound in scope 0
	if !ok {
		return 0
	}
	return symTab.At(s)
}

// lookupChain finds name in scope or its parents.
func lookupChain(scp u32, name u32) u32 {
	sc := scp
	for g := usize(0); g < MaxScopes; g++ {
		if sc == 0 {
			return 0
		}
		s := lookupLocal(sc, name)
		if s != 0 {
			return s
		}
		r, _ := scopes.At(usize(sc))
		sc = r.parent
	}
	return 0
}

// scopeInsert adds sym to scope unless the name is already declared there;
// it returns the existing symbol (0 if sym was inserted).
func scopeInsert(scp u32, sym u32) u32 {
	if scp == 0 || sym == 0 {
		return 0
	}
	s, ok := symSlot(scp, syms.items[usize(sym)].name)
	if !ok {
		setFull("symbol table")
		return 0
	}
	if old := symTab.At(s); old != 0 {
		return old
	}
	symTab.Set(s, sym)
	syms.items[usize(sym)].scp = scp
	return 0
}

// ---------------------------------------------------------------------------
// u32 lists (package decls, parameter lists, ...) and linked-list cells
// (lists that grow interleaved: calls, literals and captures of functions).

// ulists stores the u32 lists, built on its scratch stack in LIFO order.
var ulists vec.ListArena[MaxULists, MaxULists, u32]

func upush(v u32) {
	ulists.Push(v)
	if ulists.Full() {
		setFull("lists")
	}
}

// umark returns the scratch stack height (the start of a new list).
func umark() usize {
	return ulists.Mark()
}

// ucommit moves the scratch stack above mark into ulists and returns
// (start, len).
func ucommit(mark usize) (u32, u32) {
	st, n := ulists.Commit(mark)
	if ulists.Full() {
		setFull("lists")
	}
	return st, n
}

func uat(start u32, i usize) u32 {
	return ulists.At(usize(start) + i)
}

type Cell struct {
	v    u32
	next u32
}

var cells vec.Vec[MaxCells, Cell] // slot 0 reserved

// cellAppend appends v to the list (head, tail) and returns the new pair.
func cellAppend(head u32, tail u32, v u32) (u32, u32) {
	if cells.Len() == 0 {
		_ = cells.Push(Cell{})
	}
	c := u32(cells.Len())
	if !cells.Push(Cell{v: v, next: 0}) {
		setFull("cells")
		return head, tail
	}
	if head == 0 {
		return c, c
	}
	t, _ := cells.At(usize(tail))
	t.next = c
	_ = cells.Set(usize(tail), t)
	return head, c
}

func cellVal(c u32) u32 {
	x, _ := cells.At(usize(c))
	return x.v
}

func cellNext(c u32) u32 {
	x, _ := cells.At(usize(c))
	return x.next
}

// ---------------------------------------------------------------------------
// Packages (resolve.Package) and per-file data

type Pkg struct {
	name  u32    // NameID of the package clause
	path  string // import path ("" for the root package)
	key   string // cleaned path (cycle detection)
	state u8     // loader: 1 visiting, 2 done
	scp   u32    // package scope
	f0    usize  // source files [f0, f1) (only files with ok == true belong to it)
	f1    usize
	impS  u32 // imported packages (ulists), first-import order
	impN  u32
	declS u32 // package-level symbols in source order
	declN u32
	methS u32 // method symbols in source order
	methN u32
}

type PkgTable struct {
	items  [MaxPkgs]Pkg
	count  usize        // including the reserved slot 0
	order  [MaxPkgs]u32 // dependency order; root last
	norder usize
	root   u32
}

var pkgs PkgTable

var fileScope [MaxFiles]u32
var filePkg [MaxFiles]u32

// lookupMethodSym returns the method symbol typeName.name declared in pkg.
func lookupMethodSym(pkg u32, typeName u32, name u32) u32 {
	p := pkgs.items[usize(pkg)]
	n := usize(p.methN)
	for i := usize(0); i < n; i++ {
		m := uat(p.methS, i)
		if syms.items[usize(m)].recvType == typeName && syms.items[usize(m)].name == name {
			return m
		}
	}
	return 0
}

// ---------------------------------------------------------------------------
// Per-node side tables (by NodeArena index)

var defs [MaxNodes]u32       // defining Ident -> symbol (Prog.Defs)
var uses [MaxNodes]u32       // used Ident -> symbol (Prog.Uses)
var litCapHead [MaxNodes]u32 // FuncLit -> captured symbols (cells; Prog.Captures)
var litCapTail [MaxNodes]u32

func symbolOf(id u32) u32 {
	if defs[usize(id)] != 0 {
		return defs[usize(id)]
	}
	return uses[usize(id)]
}

// ---------------------------------------------------------------------------
// Diagnostics: collected, then sorted canonically (file, position, code,
// message) with exact duplicates removed, like finc0's diag.List.Sort.

type DiagList struct {
	text  bytes.Builder[MaxDiagBytes]
	off   [MaxDiags]u32 // start of the full line in text
	ln    [MaxDiags]u32 // length of the full line (without newline)
	moff  [MaxDiags]u32 // start of the message
	file  [MaxDiags]u32 // source file index
	line  [MaxDiags]u32
	col   [MaxDiags]u32
	code  [MaxDiags]u32
	eline [MaxDiags]u32 // end of the reported node (0: unknown), for --context
	ecol  [MaxDiags]u32
	order [MaxDiags]u32
	count usize
}

var diags DiagList

// mbuf holds the message of the diagnostic being built: callers format it
// with formatTo(mbuf[:], ...) and pass the length to errAt (msg.fc).
var mbuf [MaxOutputBytes]byte

// addDiag records "file:line:col: error[E####]: <msg>".
func addDiag(file usize, line u32, col u32, code u32, msg []byte) {
	room := diags.text.Spare()
	n := formatTo(room, "%s:%d:%d: error[E%04d]: %s", sources.files[file].path, line, col, code, msg)
	if diags.count >= MaxDiags || n >= len(room) {
		setFull("diagnostics")
		return
	}
	i := diags.count
	diags.count++
	diags.off[i] = u32(diags.text.Len())
	diags.ln[i] = u32(n)
	diags.moff[i] = u32(diags.text.Len() + n - len(msg))
	diags.file[i] = u32(file)
	diags.line[i] = line
	diags.col[i] = col
	diags.code[i] = code
	diags.eline[i] = 0
	diags.ecol[i] = 0
	diags.text.Extend(n)
}

// errAt records the diagnostic mbuf[:k] at the start of node n.
func errAt(code u32, n u32, k usize) {
	i := diags.count
	addDiag(nfile(n), nodes.items[usize(n)].sLine, nodes.items[usize(n)].sCol, code, mbuf[:k])
	if diags.count > i {
		diags.eline[i] = nodes.items[usize(n)].eLine
		diags.ecol[i] = nodes.items[usize(n)].eCol
	}
}

// addParseDiag records a finished parser diagnostic line (with or without
// the trailing newline) for source file `file`.
func addParseDiag(file usize, b []byte) {
	line := bytes.TrimSuffix(b, "\n")
	n := len(line)
	ln, i := parseDigits(line, len(sources.files[file].path)+1, n) // after "path:"
	col, j := parseDigits(line, i+1, n)
	code, k := parseDigits(line, j+9, 4) // after ": error[E"
	k += 3                               // "]: "
	if k > n {
		k = n
	}
	addDiag(file, u32(ln), u32(col), u32(code), line[k:])
}

// diagLess is the canonical order: file path, position, code, message.
func diagLess(a u32, b u32) bool {
	if diags.file[a] != diags.file[b] {
		pa := strBytes(sources.files[usize(diags.file[a])].path)
		pb := strBytes(sources.files[usize(diags.file[b])].path)
		c := bytes.Compare(pa, pb)
		if c != 0 {
			return c < 0
		}
	}
	if diags.line[a] != diags.line[b] {
		return diags.line[a] < diags.line[b]
	}
	if diags.col[a] != diags.col[b] {
		return diags.col[a] < diags.col[b]
	}
	if diags.code[a] != diags.code[b] {
		return diags.code[a] < diags.code[b]
	}
	return bytes.Compare(diagMsg(usize(a)), diagMsg(usize(b))) < 0
}

func diagMsg(i usize) []byte {
	e := usize(diags.off[i]) + usize(diags.ln[i])
	return diags.text.Bytes()[usize(diags.moff[i]):e]
}

func diagLine(i usize) []byte {
	s := usize(diags.off[i])
	return diags.text.Bytes()[s : s+usize(diags.ln[i])]
}

// sortDiags sorts diags.order (stable) and removes exact
// duplicates; it returns the number of diagnostics to print.
func sortDiags() usize {
	n := diags.count
	for i := usize(0); i < n; i++ {
		diags.order[i] = u32(i)
	}
	sort.Stable[u32](diags.order[:n], diagLess)
	w := usize(0)
	for i := usize(0); i < n; i++ {
		cur := usize(diags.order[i])
		if w > 0 {
			prev := usize(diags.order[w-1])
			if diags.file[prev] == diags.file[cur] && diags.line[prev] == diags.line[cur] &&
				diags.col[prev] == diags.col[cur] && diags.code[prev] == diags.code[cur] &&
				bytesEqual(diagMsg(prev), diagMsg(cur)) {
				continue
			}
		}
		diags.order[w] = u32(cur)
		w++
	}
	return w
}
