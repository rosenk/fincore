package main

// FinCore v0.1 Native Lexer with Go-style automatic semicolon insertion.

const (
	MaxTokens = 262144
)

// Token kinds.
const (
	TKIllegal u8 = 0
	TKEof     u8 = 1

	TKIdent  u8 = 2
	TKInt    u8 = 3
	TKString u8 = 4
	TKChar   u8 = 5
	TKFloat  u8 = 6

	// Keywords
	TKPackage   u8 = 10
	TKImport    u8 = 11
	TKConst     u8 = 12
	TKType      u8 = 13
	TKVar       u8 = 14
	TKFunc      u8 = 15
	TKDriver    u8 = 16
	TKComptime  u8 = 17
	TKScope     u8 = 18
	TKFor       u8 = 19
	TKIf        u8 = 20
	TKElse      u8 = 21
	TKReturn    u8 = 22
	TKBreak     u8 = 23
	TKContinue  u8 = 24
	TKDefer     u8 = 25
	TKStruct    u8 = 26
	TKEnum      u8 = 27
	TKMatch     u8 = 28
	TKTrue      u8 = 29
	TKFalse     u8 = 30
	TKNil       u8 = 31
	TKAny       u8 = 32
	TKDecreases u8 = 33
	TKEffect    u8 = 34
	TKWith      u8 = 35
	TKHandle    u8 = 36
	TKWhere     u8 = 37

	// Operators & punctuation
	TKAdd       u8 = 40 // +
	TKSub       u8 = 41 // -
	TKMul       u8 = 42 // *
	TKQuo       u8 = 43 // /
	TKRem       u8 = 44 // %
	TKAnd       u8 = 45 // &
	TKOr        u8 = 46 // |
	TKXor       u8 = 47 // ^
	TKShl       u8 = 48 // <<
	TKShr       u8 = 49 // >>
	TKEql       u8 = 50 // ==
	TKNeq       u8 = 51 // !=
	TKLss       u8 = 52 // <
	TKLeq       u8 = 53 // <=
	TKGtr       u8 = 54 // >
	TKGeq       u8 = 55 // >=
	TKLAnd      u8 = 56 // &&
	TKLOr       u8 = 57 // ||
	TKNot       u8 = 58 // !
	TKAssign    u8 = 59 // =
	TKDefine    u8 = 60 // :=
	TKAddAssign u8 = 61 // +=
	TKSubAssign u8 = 62 // -=
	TKMulAssign u8 = 63 // *=
	TKQuoAssign u8 = 64 // /=
	TKRemAssign u8 = 65 // %=
	TKAndAssign u8 = 66 // &=
	TKOrAssign  u8 = 67 // |=
	TKXorAssign u8 = 68 // ^=
	TKShlAssign u8 = 69 // <<=
	TKShrAssign u8 = 70 // >>=
	TKInc       u8 = 71 // ++
	TKDec       u8 = 72 // --
	TKLParen    u8 = 73 // (
	TKRParen    u8 = 74 // )
	TKLBrack    u8 = 75 // [
	TKRBrack    u8 = 76 // ]
	TKLBrace    u8 = 77 // {
	TKRBrace    u8 = 78 // }
	TKComma     u8 = 79 // ,
	TKPeriod    u8 = 80 // .
	TKColon     u8 = 81 // :
	TKSemi      u8 = 82 // ;
	TKArrow     u8 = 83 // ->
	TKEllipsis  u8 = 84 // ...
)

const (
	TokFlagAutoSemi u8 = 1
)

type Token struct {
	kind  u8
	flags u8
	pad   u16
	off   u32 // byte offset in file
	end   u32 // end byte offset in file
	strID u32 // interned spelling (for IDENT/INT) or decoded value (for STRING/CHAR)
}

var toks [MaxTokens]Token
var tokCount u32

// Pre-interned keyword StrIDs for O(1) keyword recognition.
var kwPackage u32
var kwImport u32
var kwConst u32
var kwType u32
var kwVar u32
var kwFunc u32
var kwDriver u32
var kwComptime u32
var kwScope u32
var kwFor u32
var kwIf u32
var kwElse u32
var kwReturn u32
var kwBreak u32
var kwContinue u32
var kwDefer u32
var kwStruct u32
var kwEnum u32
var kwMatch u32
var kwTrue u32
var kwFalse u32
var kwNil u32
var kwAny u32
var kwDecreases u32
var kwEffect u32
var kwWith u32
var kwHandle u32
var kwResume u32
var kwWhere u32
var kwBlank u32
var kwMain u32
var kwCode u32
var kwEl u32
var kwIota u32

func lexerInit() {
	tokCount = 0
	kwPackage = internStr("package")
	kwImport = internStr("import")
	kwConst = internStr("const")
	kwType = internStr("type")
	kwVar = internStr("var")
	kwFunc = internStr("func")
	kwDriver = internStr("driver")
	kwComptime = internStr("comptime")
	kwScope = internStr("scope")
	kwFor = internStr("for")
	kwIf = internStr("if")
	kwElse = internStr("else")
	kwReturn = internStr("return")
	kwBreak = internStr("break")
	kwContinue = internStr("continue")
	kwDefer = internStr("defer")
	kwStruct = internStr("struct")
	kwEnum = internStr("enum")
	kwMatch = internStr("match")
	kwTrue = internStr("true")
	kwFalse = internStr("false")
	kwNil = internStr("nil")
	kwAny = internStr("any")
	kwDecreases = internStr("decreases")
	kwEffect = internStr("effect")
	kwWith = internStr("with")
	kwHandle = internStr("handle")
	kwResume = internStr("resume")
	kwWhere = internStr("where")
	kwBlank = internStr("_")
	kwMain = internStr("main")
	kwCode = internStr("Code")
	kwEl = internStr("El")
	kwIota = internStr("iota")
}

func lookupKeyword(id u32) u8 {
	if id == kwPackage {
		return TKPackage
	}
	if id == kwImport {
		return TKImport
	}
	if id == kwConst {
		return TKConst
	}
	if id == kwType {
		return TKType
	}
	if id == kwVar {
		return TKVar
	}
	if id == kwFunc {
		return TKFunc
	}
	if id == kwDriver {
		return TKDriver
	}
	if id == kwComptime {
		return TKComptime
	}
	if id == kwScope {
		return TKScope
	}
	if id == kwFor {
		return TKFor
	}
	if id == kwIf {
		return TKIf
	}
	if id == kwElse {
		return TKElse
	}
	if id == kwReturn {
		return TKReturn
	}
	if id == kwBreak {
		return TKBreak
	}
	if id == kwContinue {
		return TKContinue
	}
	if id == kwDefer {
		return TKDefer
	}
	if id == kwStruct {
		return TKStruct
	}
	if id == kwEnum {
		return TKEnum
	}
	if id == kwMatch {
		return TKMatch
	}
	if id == kwTrue {
		return TKTrue
	}
	if id == kwFalse {
		return TKFalse
	}
	if id == kwNil {
		return TKNil
	}
	if id == kwAny {
		return TKAny
	}
	if id == kwDecreases {
		return TKDecreases
	}
	if id == kwEffect {
		return TKEffect
	}
	if id == kwWith {
		return TKWith
	}
	if id == kwHandle {
		return TKHandle
	}
	if id == kwWhere {
		return TKWhere
	}
	return TKIdent
}

func triggersSemi(k u8) bool {
	return k == TKIdent || k == TKInt || k == TKFloat || k == TKString || k == TKChar ||
		k == TKTrue || k == TKFalse || k == TKNil || k == TKAny ||
		k == TKReturn || k == TKBreak || k == TKContinue ||
		k == TKInc || k == TKDec ||
		k == TKRParen || k == TKRBrack || k == TKRBrace
}

func isIdentStart(c byte) bool {
	return (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || c == '_'
}

func isIdentCont(c byte) bool {
	return isIdentStart(c) || (c >= '0' && c <= '9')
}

func isDigit(c byte) bool {
	return c >= '0' && c <= '9'
}

func hexVal(c byte) (u8, bool) {
	if c >= '0' && c <= '9' {
		return c - '0', true
	}
	if c >= 'a' && c <= 'f' {
		return c - 'a' + 10, true
	}
	if c >= 'A' && c <= 'F' {
		return c - 'A' + 10, true
	}
	return 0, false
}

func emitTok(kind u8, flags u8, off u32, end u32, strID u32) {
	if tokCount < MaxTokens {
		toks[tokCount] = Token{kind: kind, flags: flags, off: off, end: end, strID: strID}
		tokCount++
	}
}

// lexFile tokenizes files[fileID] into toks[tokStart : tokStart+tokCount].
func lexFile(fileID u32) {
	f := files[fileID]
	base := usize(f.srcOff)
	n := usize(f.srcLen)
	startTok := tokCount
	insertSemi := false

	i := usize(0)
	for step := usize(0); step < n+2; step++ {
		// Skip spaces, tabs, CR, comments; handle newlines for ASI.
		for ws := usize(0); ws < n+1; ws++ {
			if i >= n {
				break
			}
			c := srcBuf[base+i]
			if c == ' ' || c == '\t' || c == '\r' {
				i++
				continue
			}
			if c == '\n' {
				if insertSemi {
					emitTok(TKSemi, TokFlagAutoSemi, u32(i), u32(i+1), 0)
					insertSemi = false
				}
				i++
				continue
			}
			if c == '/' && i+1 < n && srcBuf[base+i+1] == '/' {
				i += 2
				for lc := usize(0); lc < n; lc++ {
					if i >= n || srcBuf[base+i] == '\n' {
						break
					}
					i++
				}
				continue
			}
			if c == '/' && i+1 < n && srcBuf[base+i+1] == '*' {
				cstart := u32(i)
				i += 2
				sawNL := false
				closed := false
				for bc := usize(0); bc < n; bc++ {
					if i >= n {
						break
					}
					if srcBuf[base+i] == '\n' {
						sawNL = true
					}
					if srcBuf[base+i] == '*' && i+1 < n && srcBuf[base+i+1] == '/' {
						i += 2
						closed = true
						break
					}
					i++
				}
				if !closed {
					addDiagStr(E1002, fileID, cstart, "unterminated block comment")
				}
				if sawNL && insertSemi {
					emitTok(TKSemi, TokFlagAutoSemi, u32(i), u32(i), 0)
					insertSemi = false
				}
				continue
			}
			break
		}

		if i >= n {
			if insertSemi {
				emitTok(TKSemi, TokFlagAutoSemi, u32(n), u32(n), 0)
			}
			emitTok(TKEof, 0, u32(n), u32(n), 0)
			break
		}

		start := i
		c := srcBuf[base+i]

		// Identifier or keyword
		if isIdentStart(c) {
			i++
			for id := usize(0); id < n; id++ {
				if i >= n || !isIdentCont(srcBuf[base+i]) {
					break
				}
				i++
			}
			sid := internBytes(srcBuf[base+start : base+i])
			k := lookupKeyword(sid)
			emitTok(k, 0, u32(start), u32(i), sid)
			insertSemi = triggersSemi(k)
			continue
		}

		// Integer or Float literal
		if isDigit(c) {
			isHex := c == '0' && i+1 < n && (srcBuf[base+i+1] == 'x' || srcBuf[base+i+1] == 'X')
			isBin := c == '0' && i+1 < n && (srcBuf[base+i+1] == 'b' || srcBuf[base+i+1] == 'B')
			isOct := c == '0' && i+1 < n && (srcBuf[base+i+1] == 'o' || srcBuf[base+i+1] == 'O')
			isFloat := false
			i++
			for dg := usize(0); dg < n; dg++ {
				if i >= n {
					break
				}
				ch := srcBuf[base+i]
				if !isHex && !isBin && !isOct && !isFloat && ch == '.' && i+1 < n && isDigit(srcBuf[base+i+1]) {
					isFloat = true
					i++
					continue
				}
				if !isHex && !isBin && !isOct && (ch == 'e' || ch == 'E') {
					isFloat = true
					i++
					if i < n && (srcBuf[base+i] == '+' || srcBuf[base+i] == '-') {
						i++
					}
					continue
				}
				if isIdentCont(ch) {
					i++
				} else {
					break
				}
			}
			sid := internBytes(srcBuf[base+start : base+i])
			if isFloat {
				emitTok(TKFloat, 0, u32(start), u32(i), sid)
			} else {
				emitTok(TKInt, 0, u32(start), u32(i), sid)
			}
			insertSemi = true
			continue
		}

		// String literal
		if c == '"' {
			i++
			var decoded [4096]byte
			dlen := usize(0)
			closed := false
			for sc := usize(0); sc < n; sc++ {
				if i >= n {
					break
				}
				ch := srcBuf[base+i]
				if ch == '\n' {
					break
				}
				if ch == '"' {
					i++
					closed = true
					break
				}
				if ch == '\\' {
					i++
					if i >= n {
						break
					}
					ec := srcBuf[base+i]
					i++
					var b byte
					if ec == 'n' {
						b = '\n'
					} else if ec == 'r' {
						b = '\r'
					} else if ec == 't' {
						b = '\t'
					} else if ec == '\\' {
						b = '\\'
					} else if ec == '"' {
						b = '"'
					} else if ec == '\'' {
						b = '\''
					} else if ec == '0' {
						b = 0
					} else if ec == 'x' && i+1 < n {
						hi, ok1 := hexVal(srcBuf[base+i])
						lo, ok2 := hexVal(srcBuf[base+i+1])
						if ok1 && ok2 {
							b = (hi << 4) | lo
							i += 2
						} else {
							addDiagStr(E1001, fileID, u32(i-2), "invalid hex escape in string literal")
						}
					} else {
						addDiagStr(E1001, fileID, u32(i-2), "unknown escape sequence in string literal")
						b = ec
					}
					if dlen < len(decoded) {
						decoded[dlen] = b
						dlen++
					}
					continue
				}
				if dlen < len(decoded) {
					decoded[dlen] = ch
					dlen++
				}
				i++
			}
			if !closed {
				addDiagStr(E1002, fileID, u32(start), "unterminated string literal")
			}
			sid := internBytes(decoded[:dlen])
			emitTok(TKString, 0, u32(start), u32(i), sid)
			insertSemi = true
			continue
		}

		// Character literal
		if c == '\'' {
			i++
			var cb [1]byte
			clen := usize(0)
			closed := false
			for cc := usize(0); cc < 16; cc++ {
				if i >= n {
					break
				}
				ch := srcBuf[base+i]
				if ch == '\n' {
					break
				}
				if ch == '\'' {
					i++
					closed = true
					break
				}
				var b byte
				if ch == '\\' {
					i++
					if i >= n {
						break
					}
					ec := srcBuf[base+i]
					i++
					if ec == 'n' {
						b = '\n'
					} else if ec == 'r' {
						b = '\r'
					} else if ec == 't' {
						b = '\t'
					} else if ec == '\\' {
						b = '\\'
					} else if ec == '\'' {
						b = '\''
					} else if ec == '"' {
						b = '"'
					} else if ec == '0' {
						b = 0
					} else if ec == 'x' && i+1 < n {
						hi, ok1 := hexVal(srcBuf[base+i])
						lo, ok2 := hexVal(srcBuf[base+i+1])
						if ok1 && ok2 {
							b = (hi << 4) | lo
							i += 2
						}
					} else {
						b = ec
					}
				} else {
					b = ch
					i++
				}
				if clen == 0 {
					cb[0] = b
				}
				clen++
			}
			if !closed || clen != 1 {
				addDiagStr(E1002, fileID, u32(start), "invalid or unterminated character literal")
			}
			sid := internBytes(cb[:1])
			emitTok(TKChar, 0, u32(start), u32(i), sid)
			insertSemi = true
			continue
		}

		// Operators & punctuation
		var next byte
		if i+1 < n {
			next = srcBuf[base+i+1]
		}
		var next2 byte
		if i+2 < n {
			next2 = srcBuf[base+i+2]
		}
		i++
		var kind u8 = TKIllegal
		if c == '+' {
			if next == '+' {
				i++
				kind = TKInc
			} else if next == '=' {
				i++
				kind = TKAddAssign
			} else {
				kind = TKAdd
			}
		} else if c == '-' {
			if next == '-' {
				i++
				kind = TKDec
			} else if next == '=' {
				i++
				kind = TKSubAssign
			} else if next == '>' {
				i++
				kind = TKArrow
			} else {
				kind = TKSub
			}
		} else if c == '*' {
			if next == '=' {
				i++
				kind = TKMulAssign
			} else {
				kind = TKMul
			}
		} else if c == '/' {
			if next == '=' {
				i++
				kind = TKQuoAssign
			} else {
				kind = TKQuo
			}
		} else if c == '%' {
			if next == '=' {
				i++
				kind = TKRemAssign
			} else {
				kind = TKRem
			}
		} else if c == '&' {
			if next == '&' {
				i++
				kind = TKLAnd
			} else if next == '=' {
				i++
				kind = TKAndAssign
			} else {
				kind = TKAnd
			}
		} else if c == '|' {
			if next == '|' {
				i++
				kind = TKLOr
			} else if next == '=' {
				i++
				kind = TKOrAssign
			} else {
				kind = TKOr
			}
		} else if c == '^' {
			if next == '=' {
				i++
				kind = TKXorAssign
			} else {
				kind = TKXor
			}
		} else if c == '<' {
			if next == '<' {
				i++
				if next2 == '=' {
					i++
					kind = TKShlAssign
				} else {
					kind = TKShl
				}
			} else if next == '=' {
				i++
				kind = TKLeq
			} else {
				kind = TKLss
			}
		} else if c == '>' {
			if next == '>' {
				i++
				if next2 == '=' {
					i++
					kind = TKShrAssign
				} else {
					kind = TKShr
				}
			} else if next == '=' {
				i++
				kind = TKGeq
			} else {
				kind = TKGtr
			}
		} else if c == '=' {
			if next == '=' {
				i++
				kind = TKEql
			} else {
				kind = TKAssign
			}
		} else if c == '!' {
			if next == '=' {
				i++
				kind = TKNeq
			} else {
				kind = TKNot
			}
		} else if c == ':' {
			if next == '=' {
				i++
				kind = TKDefine
			} else {
				kind = TKColon
			}
		} else if c == '(' {
			kind = TKLParen
		} else if c == ')' {
			kind = TKRParen
		} else if c == '[' {
			kind = TKLBrack
		} else if c == ']' {
			kind = TKRBrack
		} else if c == '{' {
			kind = TKLBrace
		} else if c == '}' {
			kind = TKRBrace
		} else if c == ',' {
			kind = TKComma
		} else if c == '.' {
			if next == '.' && next2 == '.' {
				i += 2
				kind = TKEllipsis
			} else {
				kind = TKPeriod
			}
		} else if c == ';' {
			kind = TKSemi
		} else {
			addDiagStr(E1001, fileID, u32(start), "unexpected character")
		}
		emitTok(kind, 0, u32(start), u32(i), 0)
		insertSemi = triggersSemi(kind)
	}
	files[fileID].tokStart = startTok
	files[fileID].tokCount = tokCount - startTok
}
