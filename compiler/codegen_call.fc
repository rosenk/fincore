	if bm == BMStdioTermSize {
		em("    call _fc_rt_term_size\n")
		if dst0 != 0 {
			em("    movl %eax, ")
			emI(dst0)
			em("(%rbp)\n")
		}
		if dst1 != 0 {
			em("    movl %edx, ")
			emI(dst1)
			em("(%rbp)\n")
		}
		if len(dsts) > 2 && dsts[2] != 0 {
			em("    movb %cl, ")
			emI(dsts[2])
			em("(%rbp)\n")
		}
		return
	}
	if bm == BMStdioReadStdinTimeout {
		em("    movq ")
		emI(argOffs[0])
		em("(%rbp), %rdi\n    movq ")
		emI(argOffs[0] + 8)
		em("(%rbp), %rsi\n    movl ")
		emI(argOffs[1])
		em("(%rbp), %edx\n    call _fc_rt_read_stdin_timeout\n")
		if dst0 != 0 {
			em("    movq %rax, ")
			emI(dst0)
			em("(%rbp)\n")
		}
		if dst1 != 0 {
			em("    movq %rdx, ")
			emI(dst1)
			em("(%rbp)\n")
		}
		return
	}
	if bm == BMArenaAllocBytes {
		em("    movq ")
		emI(recvOff)
		em("(%rbp), %rdi\n    movq ")
		emI(argOffs[0])
		em("(%rbp), %rsi\n    call _fc_rt_arena_alloc_bytes\n")
		if dst0 != 0 {
			em("    movq %rax, ")
			emI(dst0)
			em("(%rbp)\n    movq %rdx, ")
			emI(dst0 + 8)
			em("(%rbp)\n    movq %rdx, ")
			emI(dst0 + 16)
			em("(%rbp)\n")
		}
		if dst1 != 0 {
			em("    movq %rcx, ")
			emI(dst1)
			em("(%rbp)\n")
		}
		return
	}
	if bm == BMArenaUsed {
		em("    movq ")
		emI(recvOff)
		em("(%rbp), %rdi\n    call _fc_rt_arena_used\n")
		if dst0 != 0 {
			em("    movq %rax, ")
			emI(dst0)
			em("(%rbp)\n")
		}
		return
	}
	if bm == BMArenaCap {
		em("    movq ")
		emI(recvOff)
		em("(%rbp), %rdi\n    call _fc_rt_arena_cap\n")
		if dst0 != 0 {
			em("    movq %rax, ")
			emI(dst0)
			em("(%rbp)\n")
		}
		return
	}
	if bm == BMArenaReset {
		em("    movq ")
		emI(recvOff)
		em("(%rbp), %rdi\n    call _fc_rt_arena_reset\n")
		return
	}
	if bm == BMScopeReady {
		em("    movq ")
		emI(recvOff)
		em("(%rbp), %rdi\n    movq ")
		emI(argOffs[0])
		em("(%rbp), %rsi\n    movq ")
		emI(argOffs[0] + 8)
		em("(%rbp), %rdx\n    call _fc_rt_scope_ready\n")
		if dst0 != 0 {
			em("    movq %rax, ")
			emI(dst0)
			em("(%rbp)\n")
		}
		return
	}
	if bm == BMExecRun {
		// Pack 96-byte struct on frame: ctx(16), bin(16), args(16), env(16), workdir(16), stderr(16)
		stOff := f.allocLocal(96, 8)
		em("    movq ")
		emI(argOffs[0])
		em("(%rbp), %rax\n    movq %rax, ")
		emI(stOff)
		em("(%rbp)\n    movq ")
		emI(argOffs[0] + 8)
		em("(%rbp), %rax\n    movq %rax, ")
		emI(stOff + 8)
		em("(%rbp)\n    movq ")
		emI(argOffs[1])
		em("(%rbp), %rax\n    movq %rax, ")
		emI(stOff + 16)
		em("(%rbp)\n    movq ")
		emI(argOffs[1] + 8)
		em("(%rbp), %rax\n    movq %rax, ")
		emI(stOff + 24)
		em("(%rbp)\n    movq ")
		emI(argOffs[2])
		em("(%rbp), %rax\n    movq %rax, ")
		emI(stOff + 32)
		em("(%rbp)\n    movq ")
		emI(argOffs[2] + 8)
		em("(%rbp), %rax\n    movq %rax, ")
		emI(stOff + 40)
		em("(%rbp)\n    movq ")
		emI(argOffs[3])
		em("(%rbp), %rax\n    movq %rax, ")
		emI(stOff + 48)
		em("(%rbp)\n    movq ")
		emI(argOffs[3] + 8)
		em("(%rbp), %rax\n    movq %rax, ")
		emI(stOff + 56)
		em("(%rbp)\n    movq ")
		emI(argOffs[4])
		em("(%rbp), %rax\n    movq %rax, ")
		emI(stOff + 64)
		em("(%rbp)\n    movq ")
		emI(argOffs[4] + 8)
		em("(%rbp), %rax\n    movq %rax, ")
		emI(stOff + 72)
		em("(%rbp)\n    movq ")
		emI(argOffs[5])
		em("(%rbp), %rax\n    movq %rax, ")
		emI(stOff + 80)
		em("(%rbp)\n    movq ")
		emI(argOffs[5] + 8)
		em("(%rbp), %rax\n    movq %rax, ")
		emI(stOff + 88)
		em("(%rbp)\n    leaq ")
		emI(stOff)
		em("(%rbp), %rdi\n    call _fc_rt_exec_run\n")
		if dst0 != 0 {
			em("    movq %rax, ")
			emI(dst0)
			em("(%rbp)\n")
		}
		if dst1 != 0 {
			em("    movq %rdx, ")
			emI(dst1)
			em("(%rbp)\n")
		}
		if dst2 != 0 {
			em("    movq %rcx, ")
			emI(dst2)
			em("(%rbp)\n")
		}
		return
	}
}
