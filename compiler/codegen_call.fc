			em("    movq %rax, ")
			emI(dst0)
			em("(%rbp)\n")
		}
		if dst1 != 0 {
			em("    movq %rdx, ")
			emI(dst1)
			em("(%rbp)\n")
		}
		return
	}
	if bm == BMListenerClose || bm == BMConnClose {
		em("    movq ")
		emI(recvOff)
		em("(%rbp), %rdi\n    call _fc_rt_close_fd\n")
		if dst0 != 0 {
			em("    movq %rax, ")
			emI(dst0)
			em("(%rbp)\n")
		}
		return
	}
	if bm == BMConnCloseWrite {
		em("    movq ")
		emI(recvOff)
		em("(%rbp), %rdi\n    call _fc_rt_conn_close_write\n")
		if dst0 != 0 {
			em("    movq %rax, ")
			emI(dst0)
			em("(%rbp)\n")
		}
		return
	}
	if bm == BMConnRead || bm == BMConnWrite {
		em("    movq ")
		emI(recvOff)
		em("(%rbp), %rdi\n    movq ")
		emI(argOffs[0])
		em("(%rbp), %rsi\n    movq ")
		emI(argOffs[0] + 8)
		em("(%rbp), %rdx\n    movq ")
		emI(argOffs[1])
		em("(%rbp), %rcx\n    movq ")
		emI(argOffs[1] + 8)
		em("(%rbp), %r8\n")
		if bm == BMConnRead {
			em("    call _fc_rt_conn_read\n")
		} else {
			em("    call _fc_rt_conn_write\n")
		}
		if dst0 != 0 {
			em("    movq %rax, ")
			emI(dst0)
			em("(%rbp)\n")
		}
		if dst1 != 0 {
			em("    movq %rdx, ")
			emI(dst1)
			em("(%rbp)\n")
		}
		return
	}
	if bm == BMClockNow || bm == BMClockUnixNs {
		if bm == BMClockUnixNs {
			em("    call _fc_rt_clock_unix_ns\n")
		} else {
			em("    call _fc_rt_clock_now\n")
		}
		if dst0 != 0 {
			em("    movq %rax, ")
			emI(dst0)
			em("(%rbp)\n")
		}
		return
	}
	if bm == BMClockSleep {
		em("    movq ")
		emI(argOffs[0])
		em("(%rbp), %rdi\n    movq ")
		emI(argOffs[0] + 8)
		em("(%rbp), %rsi\n    movq ")
		emI(argOffs[1])
		em("(%rbp), %rdx\n    call _fc_rt_clock_sleep\n")
		if dst0 != 0 {
			em("    movq %rax, ")
			emI(dst0)
			em("(%rbp)\n")
		}
		return
	}
	if bm == BMCtxDone {
		em("    movq ")
		emI(recvOff)
		em("(%rbp), %rdi\n    movq ")
		emI(recvOff + 8)
		em("(%rbp), %rsi\n    call _fc_rt_ctx_done\n")
		if dst0 != 0 {
			em("    movb %al, ")
			emI(dst0)
			em("(%rbp)\n")
		}
		return
	}
	if bm == BMCtxErr {
		em("    movq ")
		emI(recvOff)
		em("(%rbp), %rdi\n    movq ")
		emI(recvOff + 8)
		em("(%rbp), %rsi\n    call _fc_rt_ctx_err\n")
		if dst0 != 0 {
			em("    movq %rax, ")
			emI(dst0)
			em("(%rbp)\n")
		}
		return
	}
	if bm == BMCtxWithTimeout {
		em("    movq ")
		emI(recvOff + 8)
		em("(%rbp), %rdi\n    movq ")
		emI(argOffs[0])
		em("(%rbp), %rsi\n    call _fc_rt_ctx_with_timeout\n")
		if dst0 != 0 {
			em("    movq ")
			emI(recvOff)
			em("(%rbp), %rcx\n    movq %rcx, ")
			emI(dst0)
			em("(%rbp)\n    movq %rax, ")
			emI(dst0 + 8)
			em("(%rbp)\n    movq $0, ")
			emI(dst0 + 16)
			em("(%rbp)\n")
		}
		return
	}
	if bm == BMScopeReleaseSlot {
		em("    movq ")
		emI(recvOff)
		em("(%rbp), %rdi\n    movq ")
		emI(argOffs[0])
		em("(%rbp), %rsi\n    call _fc_rt_scope_release\n")
		return
	}
	if bm == BMScopeWait {
		em("    movq ")
		emI(recvOff)
		em("(%rbp), %rdi\n    call _fc_rt_scope_wait\n")
		return
	}
	if bm == BMScopeWaitTimeout {
		em("    movq ")
		emI(recvOff)
		em("(%rbp), %rdi\n    movq ")
		emI(argOffs[0])
		em("(%rbp), %rsi\n    call _fc_rt_scope_wait_timeout\n")
		if dst0 != 0 {
			em("    movb %al, ")
			emI(dst0)
			em("(%rbp)\n")
		}
		return
	}
	if bm == BMFSReadFileInto {
		em("    movq ")
		emI(argOffs[0])
		em("(%rbp), %rdi\n    movq ")
		emI(argOffs[0] + 8)
		em("(%rbp), %rsi\n    movq ")
		emI(argOffs[1])
		em("(%rbp), %rdx\n    movq ")
		emI(argOffs[1] + 8)
		em("(%rbp), %rcx\n    call _fc_rt_fs_read_file_into\n")
		if dst0 != 0 {
			em("    movq %rax, ")
			emI(dst0)
			em("(%rbp)\n")
		}
		if dst1 != 0 {
			em("    movq %rdx, ")
			emI(dst1)
			em("(%rbp)\n")
		}
		return
	}
	if bm == BMFSWriteFile {
		em("    movq ")
		emI(argOffs[0])
		em("(%rbp), %rdi\n    movq ")
		emI(argOffs[0] + 8)
		em("(%rbp), %rsi\n    movq ")
		emI(argOffs[1])
		em("(%rbp), %rdx\n    movq ")
		emI(argOffs[1] + 8)
		em("(%rbp), %rcx\n    call _fc_rt_fs_write_file\n")
		if dst0 != 0 {
			em("    movq %rax, ")
			emI(dst0)
			em("(%rbp)\n")
		}
		return
	}
	if bm == BMFSIsDir {
		em("    movq ")
		emI(argOffs[0])
		em("(%rbp), %rdi\n    movq ")
		emI(argOffs[0] + 8)
		em("(%rbp), %rsi\n    call _fc_rt_fs_is_dir\n")
		if dst0 != 0 {
			em("    movb %al, ")
			emI(dst0)
			em("(%rbp)\n")
		}
		return
	}
	if bm == BMFSListSourceFiles {
		em("    movq ")
		emI(argOffs[0])
		em("(%rbp), %rdi\n    movq ")
		emI(argOffs[0] + 8)
		em("(%rbp), %rsi\n    movq ")
		emI(argOffs[1])
		em("(%rbp), %rdx\n    movq ")
		emI(argOffs[1] + 8)
		em("(%rbp), %rcx\n    call _fc_rt_fs_list_fc\n")
		if dst0 != 0 {
			em("    movq %rax, ")
			emI(dst0)
			em("(%rbp)\n")
		}
		if dst1 != 0 {
			em("    movq %rdx, ")
			emI(dst1)
			em("(%rbp)\n")
		}
		return
	}
	if bm == BMFSMkdirTemp {
		em("    movq ")
		emI(argOffs[0])
		em("(%rbp), %rdi\n    movq ")
		emI(argOffs[0] + 8)
		em("(%rbp), %rsi\n    call _fc_rt_fs_mkdir_temp\n")
		if dst0 != 0 {
			em("    movq %rax, ")
			emI(dst0)
			em("(%rbp)\n    movq %rdx, ")
			emI(dst0 + 8)
			em("(%rbp)\n")
		}
		if dst1 != 0 {
			em("    movq %rcx, ")
			emI(dst1)
			em("(%rbp)\n")
		}
		return
	}
	if bm == BMFSRemoveAll {
		em("    movq ")
		emI(argOffs[0])
		em("(%rbp), %rdi\n    movq ")
		emI(argOffs[0] + 8)
		em("(%rbp), %rsi\n    call _fc_rt_fs_remove_all\n")
		if dst0 != 0 {
			em("    movq %rax, ")
			emI(dst0)
			em("(%rbp)\n")
		}
		return
	}
	if bm == BMEnvArgsCount {
		em("    call _fc_rt_args_count\n")
		if dst0 != 0 {
			em("    movq %rax, ")
			emI(dst0)
			em("(%rbp)\n")
		}
		return
	}
	if bm == BMEnvArg {
		em("    movq ")
		emI(argOffs[0])
		em("(%rbp), %rdi\n    call _fc_rt_arg\n")
		if dst0 != 0 {
			em("    movq %rax, ")
			emI(dst0)
			em("(%rbp)\n    movq %rdx, ")
			emI(dst0 + 8)
			em("(%rbp)\n")
		}
		return
	}
	if bm == BMEnvGetenv {
		em("    movq ")
		emI(argOffs[0])
		em("(%rbp), %rdi\n    movq ")
		emI(argOffs[0] + 8)
		em("(%rbp), %rsi\n    call _fc_rt_getenv\n")
		if dst0 != 0 {
			em("    movq %rax, ")
			emI(dst0)
			em("(%rbp)\n    movq %rdx, ")
			emI(dst0 + 8)
			em("(%rbp)\n")
		}
		if dst1 != 0 {
			em("    movb %cl, ")
			emI(dst1)
			em("(%rbp)\n")
		}
		return
	}
	if bm == BMStdioWriteStdout || bm == BMStdioWriteStderr {
		em("    movq ")
		emI(argOffs[0])
		em("(%rbp), %rdi\n    movq ")
		emI(argOffs[0] + 8)
		em("(%rbp), %rsi\n")
		if bm == BMStdioWriteStdout {
			em("    call _fc_rt_write_stdout\n")
		} else {
			em("    call _fc_rt_write_stderr\n")
		}
		if dst0 != 0 {
			em("    movq %rax, ")
			emI(dst0)
			em("(%rbp)\n")
		}
		return
	}
	if bm == BMStdioReadStdin {
		em("    movq ")
		emI(argOffs[0])
		em("(%rbp), %rdi\n    movq ")
		emI(argOffs[0] + 8)
		em("(%rbp), %rsi\n    call _fc_rt_read_stdin\n")
		if dst0 != 0 {
			em("    movq %rax, ")
			emI(dst0)
			em("(%rbp)\n")
		}
		if dst1 != 0 {
			em("    movq %rdx, ")
			emI(dst1)
			em("(%rbp)\n")
		}
		return
	}
	if bm == BMStdioEnableRawMode || bm == BMStdioRestoreMode {
		if bm == BMStdioEnableRawMode {
			em("    call _fc_rt_term_raw\n")
		} else {
			em("    call _fc_rt_term_restore\n")
		}
		if dst0 != 0 {
			em("    movq %rax, ")
			emI(dst0)
			em("(%rbp)\n")
		}
		return
