package main

// Recursive-descent + Pratt parser for FinCore v0.1 Native.
// Clean driver recursion bounded by MaxParseDepth (no manual decreases(dp) boilerplate).

const MaxParseDepth = 256

type Parser struct {
	fileID  u32
	pos     u32
	end     u32
	noLit   bool // disallow T{...} in if/for/match/scope header expressions
	depth   u32
	errSync bool
}

func (p *Parser) cur() Token {
	if p.pos < p.end {
		return toks[p.pos]
	}
	return Token{kind: TKEof, off: files[p.fileID].srcLen}
}

func (p *Parser) peek(delta u32) Token {
	idx := p.pos + delta
	if idx < p.end {
		return toks[idx]
	}
	return Token{kind: TKEof, off: files[p.fileID].srcLen}
}

func (p *Parser) next() Token {
	t := p.cur()
	if p.pos < p.end {
		p.pos++
	}
	return t
}

func (p *Parser) at(k u8) bool {
	return p.cur().kind == k
}

func (p *Parser) eat(k u8) bool {
	if p.cur().kind == k {
		p.pos++
		return true
	}
	return false
}

func (p *Parser) syntaxErr(msg string) {
	t := p.cur()
	addDiagStr(E1001, p.fileID, t.off, msg)
}

func (p *Parser) expect(k u8, msg string) Token {
	t := p.cur()
	if t.kind == k {
		p.pos++
		return t
	}
	p.syntaxErr(msg)
	return t
}

func (p *Parser) expectSemi() {
	if p.at(TKSemi) {
		p.pos++
		return
	}
	if p.at(TKRBrace) || p.at(TKRParen) || p.at(TKEof) {
		return
	}
	p.syntaxErr("expected ';' or newline")
}

func (p *Parser) skipSemis() {
	for step := u32(0); step < 4096; step++ {
		if !p.eat(TKSemi) {
			break
		}
	}
}

// parseFile parses files[fileID] and returns its NKFile node ID.
driver func parseFile(fileID u32) u32 {
	f := files[fileID]
	var p Parser
	p.fileID = fileID
	p.pos = f.tokStart
	p.end = f.tokStart + f.tokCount

	fn := newNode(NKFile, fileID, 0)
	p.skipSemis()
	p.expect(TKPackage, "expected 'package'")
	pkgTok := p.expect(TKIdent, "expected package name")
	nodes[fn].a = pkgTok.strID
	p.expectSemi()

	var imps [128]u32
	nImp := usize(0)
	driver for {
		p.skipSemis()
		if !p.at(TKImport) {
			break
		}
		p.next()
		if p.eat(TKLParen) {
			driver for {
				p.skipSemis()
				if p.at(TKRParen) || p.at(TKEof) {
					break
				}
				imp := p.parseImportSpec()
				if nImp < len(imps) {
					imps[nImp] = imp
					nImp++
				}
				p.expectSemi()
			}
			p.expect(TKRParen, "expected ')' after import block")
			p.expectSemi()
		} else {
			imp := p.parseImportSpec()
			if nImp < len(imps) {
				imps[nImp] = imp
				nImp++
			}
			p.expectSemi()
		}
	}
	impStart, impCnt := pushList(imps[:nImp])
	nodes[fn].b = impStart
	nodes[fn].c = impCnt

	var decls [1024]u32
	nDecl := usize(0)
	driver for {
		p.skipSemis()
		if p.at(TKEof) {
			break
		}
		before := p.pos
		k := p.cur().kind
		if k == TKConst {
			nDecl = p.parseConstDecls(decls[:], nDecl)
		} else if k == TKVar {
			nDecl = p.parseVarDecls(decls[:], nDecl)
		} else if k == TKType {
			nDecl = p.parseTypeDecls(decls[:], nDecl)
		} else if k == TKFunc || k == TKDriver || k == TKComptime {
			d := p.parseFuncDecl()
			if nDecl < len(decls) {
				decls[nDecl] = d
				nDecl++
			}
		} else if k == TKEffect {
			d := p.parseEffectDecl()
			if nDecl < len(decls) {
				decls[nDecl] = d
				nDecl++
			}
		} else {
			p.syntaxErr("expected top-level declaration")
			p.next()
		}
		if p.pos == before {
			p.next()
		}
	}
	declStart, declCnt := pushList(decls[:nDecl])
	nodes[fn].d = declStart
	nodes[fn].e = declCnt
	files[fileID].astNode = fn
	return fn
}

driver func (p *Parser) parseImportSpec() u32 {
	t := p.cur()
	n := newNode(NKImport, p.fileID, t.off)
	if p.at(TKIdent) {
		nodes[n].a = p.next().strID
	}
	pt := p.expect(TKString, "expected import path string")
	nodes[n].b = pt.strID
	return n
}

driver func (p *Parser) parseConstDecls(out []u32, count usize) usize {
	p.expect(TKConst, "expected 'const'")
	if p.eat(TKLParen) {
		var iotaVal u32 = 0
		var lastType u32 = 0
		var lastExpr u32 = 0
		driver for {
			p.skipSemis()
			if p.at(TKRParen) || p.at(TKEof) {
				break
			}
			d, ty, ex := p.parseConstSpec(iotaVal, lastType, lastExpr)
			lastType = ty
			lastExpr = ex
			iotaVal++
			if count < len(out) {
				out[count] = d
				count++
			}
			p.expectSemi()
		}
		p.expect(TKRParen, "expected ')'")
		p.expectSemi()
		return count
	}
	d, _, _ := p.parseConstSpec(0, 0, 0)
	if count < len(out) {
		out[count] = d
		count++
	}
	p.expectSemi()
	return count
}

driver func (p *Parser) parseConstSpec(iotaVal u32, prevType u32, prevExpr u32) (u32, u32, u32) {
	nt := p.expect(TKIdent, "expected constant name")
	n := newNode(NKConstDecl, p.fileID, nt.off)
	nodes[n].a = nt.strID
	nodes[n].d = iotaVal
	var ty u32 = 0
	var ex u32 = 0
	if !p.at(TKAssign) && !p.at(TKSemi) && !p.at(TKRParen) && !p.at(TKEof) {
		ty = p.parseType()
	}
	if p.eat(TKAssign) {
		ex = p.parseExpr(1)
	} else {
		ty = prevType
		ex = prevExpr
	}
	nodes[n].b = ty
	nodes[n].c = ex
	return n, ty, ex
}

driver func (p *Parser) parseVarDecls(out []u32, count usize) usize {
	p.expect(TKVar, "expected 'var'")
	if p.eat(TKLParen) {
		driver for {
			p.skipSemis()
			if p.at(TKRParen) || p.at(TKEof) {
				break
			}
			count = p.parseVarSpec(out, count)
			p.expectSemi()
		}
		p.expect(TKRParen, "expected ')'")
		p.expectSemi()
		return count
	}
	count = p.parseVarSpec(out, count)
	p.expectSemi()
	return count
}

driver func (p *Parser) parseVarSpec(out []u32, count usize) usize {
	var names [16]Token
	nn := usize(0)
	names[nn] = p.expect(TKIdent, "expected variable name")
	nn++
	driver for p.eat(TKComma) {
		if nn < len(names) {
			names[nn] = p.expect(TKIdent, "expected variable name")
			nn++
		}
	}
	var ty u32 = 0
	if !p.at(TKAssign) && !p.at(TKSemi) && !p.at(TKRParen) && !p.at(TKRBrace) && !p.at(TKEof) {
		ty = p.parseType()
	}
	var vals [16]u32
	nv := usize(0)
	if p.eat(TKAssign) {
		vals[nv] = p.parseExpr(1)
		nv++
		driver for p.eat(TKComma) {
			if nv < len(vals) {
				vals[nv] = p.parseExpr(1)
				nv++
			}
		}
	}
	for i := usize(0); i < nn; i++ {
		n := newNode(NKVarDecl, p.fileID, names[i].off)
		nodes[n].a = names[i].strID
		nodes[n].b = ty
		if i < nv {
			nodes[n].c = vals[i]
		}
		if count < len(out) {
			out[count] = n
			count++
		}
	}
	return count
}

driver func (p *Parser) parseTypeDecls(out []u32, count usize) usize {
	p.expect(TKType, "expected 'type'")
	if p.eat(TKLParen) {
		driver for {
			p.skipSemis()
			if p.at(TKRParen) || p.at(TKEof) {
				break
			}
			d := p.parseTypeSpec()
			if count < len(out) {
				out[count] = d
				count++
			}
			p.expectSemi()
		}
		p.expect(TKRParen, "expected ')'")
		p.expectSemi()
		return count
	}
	d := p.parseTypeSpec()
	if count < len(out) {
		out[count] = d
		count++
	}
	p.expectSemi()
	return count
}

func (p *Parser) isTypeParamListStart() bool {
	if !p.at(TKLBrack) {
		return false
	}
	t1 := p.peek(1).kind
	t2 := p.peek(2).kind
	if t1 != TKIdent {
		return false
	}
	return t2 == TKAny || t2 == TKComma || t2 == TKIdent
}

driver func (p *Parser) parseTypeSpec() u32 {
	nt := p.expect(TKIdent, "expected type name")
	n := newNode(NKTypeDecl, p.fileID, nt.off)
	nodes[n].a = nt.strID
	if p.isTypeParamListStart() {
		ts, tc := p.parseTypeParamList()
		nodes[n].b = ts
		nodes[n].c = tc
	}
	if p.eat(TKAssign) {
		nodes[n].flags = 1 // alias
	}
	nodes[n].d = p.parseType()
	return n
}

driver func (p *Parser) parseTypeParamList() (u32, u32) {
	p.expect(TKLBrack, "expected '['")
	var tps [16]u32
	n := usize(0)
	driver for {
		if p.at(TKRBrack) || p.at(TKEof) {
			break
		}
		// Group of names sharing constraint: `A, B any` or `N usize`
		var gnames [16]Token
		gn := usize(0)
		gnames[gn] = p.expect(TKIdent, "expected type parameter name")
		gn++
		driver for p.eat(TKComma) {
			if p.at(TKRBrack) {
				break
			}
			// Check if next is `ident any` or `ident type` vs another name
			if p.peek(1).kind == TKComma || p.peek(1).kind == TKAny || p.peek(1).kind == TKIdent {
				if gn < len(gnames) {
					gnames[gn] = p.expect(TKIdent, "expected type parameter name")
					gn++
				}
			} else {
				break
			}
		}
		var isConst u16 = 0
		var ctype u32 = 0
		if p.eat(TKAny) {
			isConst = 0
		} else if p.at(TKIdent) && constraintFlagsForStr(p.cur().strID) != 0 {
			isConst = constraintFlagsForStr(p.cur().strID)
			p.next()
		} else {
			isConst = 1
			ctype = p.parseType()
		}
		for i := usize(0); i < gn; i++ {
			tp := newNode(NKTypeParam, p.fileID, gnames[i].off)
			nodes[tp].flags = isConst
			nodes[tp].a = gnames[i].strID
			nodes[tp].b = ctype
			if n < len(tps) {
				tps[n] = tp
				n++
			}
		}
		if !p.eat(TKComma) {
			break
		}
	}
	p.expect(TKRBrack, "expected ']'")
	return pushList(tps[:n])
}

driver func (p *Parser) parseFuncDecl() u32 {
	startOff := p.cur().off
	var eff u8 = EffTotal
	if p.eat(TKDriver) {
		eff = EffDriver
	} else if p.eat(TKComptime) {
		eff = EffComptime
	}
	p.expect(TKFunc, "expected 'func'")
	fn := newNode(NKFuncDecl, p.fileID, startOff)
	nodes[fn].op = eff

	// Optional receiver `(r *T[N, U])`
	if p.at(TKLParen) {
		nodes[fn].b = p.parseReceiver()
	}
	nt := p.expect(TKIdent, "expected function name")
	nodes[fn].a = nt.strID
	nodes[fn].c = p.parseFuncSig(true, false)

	// Optional `decreases(expr)`
	if p.eat(TKDecreases) {
		p.expect(TKLParen, "expected '(' after decreases")
		nodes[fn].e = p.parseExpr(1)
		p.expect(TKRParen, "expected ')' after decreases")
	}

	if p.at(TKLBrace) {
		nodes[fn].d = p.parseBlock()
	}
	p.expectSemi()
	return fn
}

driver func (p *Parser) parseReceiver() u32 {
	lt := p.expect(TKLParen, "expected '('")
	rn := newNode(NKRecv, p.fileID, lt.off)
	nameTok := p.expect(TKIdent, "expected receiver name")
	nodes[rn].a = nameTok.strID
	if p.eat(TKMul) {
		nodes[rn].flags = 1 // pointer receiver
	}
	tname := p.expect(TKIdent, "expected receiver type name")
	nodes[rn].b = tname.strID
	if p.eat(TKLBrack) {
		var rps [16]u32
		nr := usize(0)
		driver for {
			if p.at(TKRBrack) || p.at(TKEof) {
				break
			}
			pt := p.expect(TKIdent, "expected receiver type parameter name")
			tp := newNode(NKTypeParam, p.fileID, pt.off)
			nodes[tp].a = pt.strID
			if nr < len(rps) {
				rps[nr] = tp
				nr++
			}
			if !p.eat(TKComma) {
				break
			}
		}
		p.expect(TKRBrack, "expected ']'")
		rs, rc := pushList(rps[:nr])
		nodes[rn].c = rs
		nodes[rn].d = rc
	}
	p.expect(TKRParen, "expected ')'")
	return rn
}

driver func (p *Parser) parseFuncSig(allowTypeParams bool, allowUnnamed bool) u32 {
	sn := newNode(NKFuncSig, p.fileID, p.cur().off)
	if allowTypeParams && p.at(TKLBrack) {
		ts, tc := p.parseTypeParamList()
		nodes[sn].a = ts
		nodes[sn].b = tc
	}
	ps, pc := p.parseParamList(allowUnnamed)
	nodes[sn].c = ps
	nodes[sn].d = pc
	// Results: none, single type, or parenthesized list of types/params
	if !p.at(TKLBrace) && !p.at(TKSemi) && !p.at(TKDecreases) && !p.at(TKWith) && !p.at(TKRParen) && !p.at(TKComma) && !p.at(TKRBrack) && !p.at(TKRBrace) && !p.at(TKEof) {
		var rets [16]u32
		nr := usize(0)
		if p.eat(TKLParen) {
			driver for {
				if p.at(TKRParen) || p.at(TKEof) {
					break
				}
				rt := p.parseType()
				if nr < len(rets) {
					rets[nr] = rt
					nr++
				}
				if !p.eat(TKComma) {
					break
				}
			}
			p.expect(TKRParen, "expected ')'")
		} else {
			rets[0] = p.parseType()
			nr = 1
		}
		rs, rc := pushList(rets[:nr])
		rl := newNode(NKList, p.fileID, p.cur().off)
		nodes[rl].a = rs
		nodes[rl].b = rc
		nodes[sn].e = rl
	}
	// Optional `with E1, E2[T], ...` effect capability clause
	if p.eat(TKWith) {
		var effs [16]u32
		ne := usize(0)
		driver for {
			if ne < len(effs) {
				effs[ne] = p.parseType()
				ne++
			}
			if !p.eat(TKComma) {
				break
			}
		}
		es, ec := pushList(effs[:ne])
		sigEffStart[sn] = es
		sigEffCount[sn] = ec
	}
	return sn
}

driver func (p *Parser) parseEffectDecl() u32 {
	et := p.expect(TKEffect, "expected 'effect'")
	ed := newNode(NKEffectDecl, p.fileID, et.off)
	nt := p.expect(TKIdent, "expected effect name")
	nodes[ed].a = nt.strID
	if p.at(TKLBrack) {
		ts, tc := p.parseTypeParamList()
		nodes[ed].b = ts
		nodes[ed].c = tc
	}
	p.expect(TKLBrace, "expected '{' in effect declaration")
	var ops [32]u32
	no := usize(0)
	driver for {
		p.skipSemis()
		if p.at(TKRBrace) || p.at(TKEof) {
			break
		}
		opTok := p.expect(TKIdent, "expected effect operation name")
		opn := newNode(NKEffectOp, p.fileID, opTok.off)
		nodes[opn].a = opTok.strID
		nodes[opn].b = p.parseFuncSig(false, true)
		if no < len(ops) {
			ops[no] = opn
			no++
		}
		p.expectSemi()
	}
	p.expect(TKRBrace, "expected '}' after effect declaration")
	p.expectSemi()
	os, oc := pushList(ops[:no])
	nodes[ed].d = os
	nodes[ed].e = oc
	return ed
}

driver func (p *Parser) parseParamList(allowUnnamed bool) (u32, u32) {
	p.expect(TKLParen, "expected '('")
	var params [32]u32
	np := usize(0)
	driver for {
		if p.at(TKRParen) || p.at(TKEof) {
			break
		}
		named := !allowUnnamed
		if allowUnnamed && p.at(TKIdent) {
			k1 := p.peek(1).kind
			if k1 != TKRParen && k1 != TKComma && k1 != TKPeriod {
				if k1 != TKLBrack || p.peek(2).kind == TKRBrack {
					named = true
				}
			}
		}
		if named {
			var gnames [16]Token
			gn := usize(0)
			gnames[gn] = p.expect(TKIdent, "expected parameter name")
			gn++
			driver for p.eat(TKComma) {
				if gn < len(gnames) {
					gnames[gn] = p.expect(TKIdent, "expected parameter name")
					gn++
				}
			}
			var variadic u16 = 0
			if p.eat(TKEllipsis) {
				variadic = 1
			}
			ty := p.parseType()
			var wh u32 = 0
			if p.eat(TKWhere) {
				wh = p.parseExpr(1)
			}
			for i := usize(0); i < gn; i++ {
				pn := newNode(NKParam, p.fileID, gnames[i].off)
				nodes[pn].flags = variadic
				nodes[pn].a = gnames[i].strID
				nodes[pn].b = ty
				paramWhere[pn] = wh
				if np < len(params) {
					params[np] = pn
					np++
				}
			}
		} else {
			off := p.cur().off
			var variadic u16 = 0
			if p.eat(TKEllipsis) {
				variadic = 1
			}
			ty := p.parseType()
			var wh u32 = 0
			if p.eat(TKWhere) {
				wh = p.parseExpr(1)
			}
			pn := newNode(NKParam, p.fileID, off)
			nodes[pn].flags = variadic
			nodes[pn].b = ty
			paramWhere[pn] = wh
			if np < len(params) {
				params[np] = pn
				np++
			}
		}
		if !p.eat(TKComma) {
			break
		}
	}
	p.expect(TKRParen, "expected ')'")
	return pushList(params[:np])
}

// ---------------------------------------------------------------------------
// Types

driver func (p *Parser) parseType() u32 {
	t := p.cur()
	if p.depth >= MaxParseDepth {
		p.syntaxErr("maximum nesting depth exceeded")
		return 0
	}
	p.depth++
	res := p.parseTypeInner(t)
	p.depth--
	return res
}

driver func (p *Parser) parseTypeInner(t Token) u32 {
	if t.kind == TKConst {
		p.next()
		if p.at(TKMul) {
			p.next()
			n := newNode(NKTypePtr, p.fileID, t.off)
			nodes[n].flags = 1 // const *T (read-only view)
			nodes[n].a = p.parseType()
			return n
		}
		if p.at(TKLBrack) && p.peek(1).kind == TKRBrack {
			p.next()
			p.next()
			n := newNode(NKTypeSlice, p.fileID, t.off)
			nodes[n].flags = 1 // const []T (read-only view)
			nodes[n].a = p.parseType()
			return n
		}
		p.syntaxErr("expected '[]T' or '*T' after 'const' in type")
		return p.parseType()
	}
	if t.kind == TKMul {
		p.next()
		n := newNode(NKTypePtr, p.fileID, t.off)
		nodes[n].a = p.parseType()
		return n
	}
	if t.kind == TKLBrack {
		p.next()
		if p.eat(TKRBrack) {
			n := newNode(NKTypeSlice, p.fileID, t.off)
			nodes[n].a = p.parseType()
			return n
		}
		lenExpr := p.parseExpr(1)
		p.expect(TKRBrack, "expected ']' in array type")
		n := newNode(NKTypeArray, p.fileID, t.off)
		nodes[n].a = lenExpr
		nodes[n].b = p.parseType()
		return n
	}
	if t.kind == TKStruct {
		p.next()
		p.expect(TKLBrace, "expected '{' after struct")
		var fields [128]u32
		nf := usize(0)
		driver for {
			p.skipSemis()
			if p.at(TKRBrace) || p.at(TKEof) {
				break
			}
			var fnames [16]Token
			fn := usize(0)
			fnames[fn] = p.expect(TKIdent, "expected field name")
			fn++
			driver for p.eat(TKComma) {
				if fn < len(fnames) {
					fnames[fn] = p.expect(TKIdent, "expected field name")
					fn++
				}
			}
			ft := p.parseType()
			for i := usize(0); i < fn; i++ {
				fld := newNode(NKField, p.fileID, fnames[i].off)
				nodes[fld].a = fnames[i].strID
				nodes[fld].b = ft
				if nf < len(fields) {
					fields[nf] = fld
					nf++
				}
			}
			p.expectSemi()
		}
		p.expect(TKRBrace, "expected '}' after struct")
		fs, fc := pushList(fields[:nf])
		n := newNode(NKTypeStruct, p.fileID, t.off)
		nodes[n].a = fs
		nodes[n].b = fc
		return n
	}
	if t.kind == TKEnum {
		p.next()
		p.expect(TKLBrace, "expected '{' after enum")
		var vars [128]u32
		nv := usize(0)
		driver for {
			p.skipSemis()
			if p.at(TKRBrace) || p.at(TKEof) {
				break
			}
			vt := p.expect(TKIdent, "expected variant name")
			vn := newNode(NKVariant, p.fileID, vt.off)
			nodes[vn].a = vt.strID
			if p.eat(TKLParen) {
				var pays [16]u32
				np := usize(0)
				driver for {
					if p.at(TKRParen) || p.at(TKEof) {
						break
					}
					if np < len(pays) {
						pays[np] = p.parseType()
						np++
					}
					if !p.eat(TKComma) {
						break
					}
				}
				p.expect(TKRParen, "expected ')' after variant payload")
				ps, pc := pushList(pays[:np])
				nodes[vn].b = ps
				nodes[vn].c = pc
			}
			if nv < len(vars) {
				vars[nv] = vn
				nv++
			}
			p.expectSemi()
		}
		p.expect(TKRBrace, "expected '}' after enum")
		vs, vc := pushList(vars[:nv])
		n := newNode(NKTypeEnum, p.fileID, t.off)
		nodes[n].a = vs
		nodes[n].b = vc
		return n
	}
	if t.kind == TKDriver || t.kind == TKFunc {
		var eff u8 = EffTotal
		if p.eat(TKDriver) {
			eff = EffDriver
		}
		p.expect(TKFunc, "expected 'func'")
		sig := p.parseFuncSig(false, true)
		n := newNode(NKTypeFunc, p.fileID, t.off)
		nodes[n].op = eff
		nodes[n].a = nodes[sig].c
		nodes[n].b = nodes[sig].d
		if nodes[sig].e != 0 {
			nodes[n].c = nodes[nodes[sig].e].a
			nodes[n].d = nodes[nodes[sig].e].b
		}
		return n
	}
	if t.kind == TKIdent {
		p.next()
		// `Code N`
		if t.strID == kwCode && p.at(TKInt) {
			lt := p.next()
			v, _ := parseIntLit(strSlice(lt.strID))
			n := newNode(NKTypeCode, p.fileID, t.off)
			nodes[n].a = u32(v)
			return n
		}
		// `El(expr)`
		if t.strID == kwEl && p.eat(TKLParen) {
			ex := p.parseExpr(1)
			p.expect(TKRParen, "expected ')' after El")
			n := newNode(NKTypeEl, p.fileID, t.off)
			nodes[n].a = ex
			return n
		}
		n := newNode(NKTypeName, p.fileID, t.off)
		if p.eat(TKPeriod) {
			sel := p.expect(TKIdent, "expected type name after '.'")
			nodes[n].a = t.strID
			nodes[n].b = sel.strID
		} else {
			nodes[n].b = t.strID
		}
		if p.eat(TKLBrack) {
			var targs [16]u32
			nt := usize(0)
			driver for {
				if p.at(TKRBrack) || p.at(TKEof) {
					break
				}
				if nt < len(targs) {
					targs[nt] = p.parseTypeOrExprArg()
					nt++
				}
				if !p.eat(TKComma) {
					break
				}
			}
			p.expect(TKRBrack, "expected ']' after type arguments")
			ts, tc := pushList(targs[:nt])
			nodes[n].c = ts
			nodes[n].d = tc
		}
		return n
	}
	if t.kind == TKAny {
		p.next()
		n := newNode(NKTypeName, p.fileID, t.off)
		nodes[n].b = kwAny
		return n
	}
	p.syntaxErr("expected type")
	return 0
}

// parseTypeOrExprArg parses a generic argument (either a type like `u32`/`[4]u8`/`*T` or a const expr like `MaxConns`/`N+1`).
driver func (p *Parser) parseTypeOrExprArg() u32 {
	k := p.cur().kind
	if k == TKMul || k == TKLBrack || k == TKStruct || k == TKEnum || k == TKFunc || k == TKDriver || k == TKAny || k == TKConst {
		tn := newNode(NKTypeExpr, p.fileID, p.cur().off)
		nodes[tn].a = p.parseType()
		return tn
	}
	if k == TKIdent && p.cur().strID == kwCode && p.peek(1).kind == TKInt {
		tn := newNode(NKTypeExpr, p.fileID, p.cur().off)
		nodes[tn].a = p.parseType()
		return tn
	}
	if k == TKIdent && p.cur().strID == kwEl && p.peek(1).kind == TKLParen {
		tn := newNode(NKTypeExpr, p.fileID, p.cur().off)
		nodes[tn].a = p.parseType()
		return tn
	}
	return p.parseExpr(1)
}

// ---------------------------------------------------------------------------
// Statements

driver func (p *Parser) parseBlock() u32 {
	lt := p.expect(TKLBrace, "expected '{'")
	bn := newNode(NKBlock, p.fileID, lt.off)
	var stmts [512]u32
	ns := usize(0)
	driver for {
		p.skipSemis()
		if p.at(TKRBrace) || p.at(TKEof) {
			break
		}
		before := p.pos
		if p.at(TKVar) {
			var vds [16]u32
			nv := p.parseVarDecls(vds[:], 0)
			for i := usize(0); i < nv; i++ {
				ds := newNode(NKDeclStmt, p.fileID, nodes[vds[i]].off)
				nodes[ds].a = vds[i]
				if ns < len(stmts) {
					stmts[ns] = ds
					ns++
				}
			}
		} else if p.at(TKConst) {
			var cds [16]u32
			nc := p.parseConstDecls(cds[:], 0)
			for i := usize(0); i < nc; i++ {
				ds := newNode(NKDeclStmt, p.fileID, nodes[cds[i]].off)
				nodes[ds].a = cds[i]
				if ns < len(stmts) {
					stmts[ns] = ds
					ns++
				}
			}
		} else if p.at(TKType) {
			var tds [16]u32
			nt := p.parseTypeDecls(tds[:], 0)
			for i := usize(0); i < nt; i++ {
				ds := newNode(NKDeclStmt, p.fileID, nodes[tds[i]].off)
				nodes[ds].a = tds[i]
				if ns < len(stmts) {
					stmts[ns] = ds
					ns++
				}
			}
		} else {
			s := p.parseStmt()
			if s != 0 && ns < len(stmts) {
				stmts[ns] = s
				ns++
			}
		}
		if p.pos == before {
			p.next()
		}
	}
	p.expect(TKRBrace, "expected '}'")
	ss, sc := pushList(stmts[:ns])
	nodes[bn].a = ss
	nodes[bn].b = sc
	return bn
}

driver func (p *Parser) parseStmt() u32 {
	if p.depth >= MaxParseDepth {
		p.syntaxErr("maximum nesting depth exceeded")
		return 0
	}
	p.depth++
	s := p.parseStmtInner()
	p.depth--
	return s
}

driver func (p *Parser) parseStmtInner() u32 {
	t := p.cur()
	if t.kind == TKLBrace {
		b := p.parseBlock()
		p.expectSemi()
		return b
	}
	if t.kind == TKIf {
		return p.parseIfStmt()
	}
	if t.kind == TKFor || (t.kind == TKDriver && p.peek(1).kind == TKFor) {
		return p.parseForStmt()
	}
	if t.kind == TKMatch {
		s := p.parseMatchStmt()
		p.expectSemi()
		return s
	}
	if t.kind == TKHandle {
		s := p.parseHandle(false)
		p.expectSemi()
		return s
	}
	if t.kind == TKScope {
		return p.parseScopeStmt()
	}
	if t.kind == TKDefer {
		p.next()
		n := newNode(NKDefer, p.fileID, t.off)
		nodes[n].a = p.parseExpr(1)
		p.expectSemi()
		return n
	}
	if t.kind == TKReturn {
		p.next()
		n := newNode(NKReturn, p.fileID, t.off)
		if !p.at(TKSemi) && !p.at(TKRBrace) && !p.at(TKEof) {
			var res [16]u32
			nr := usize(0)
			res[nr] = p.parseExpr(1)
			nr++
			driver for p.eat(TKComma) {
				if nr < len(res) {
					res[nr] = p.parseExpr(1)
					nr++
				}
			}
			rs, rc := pushList(res[:nr])
			nodes[n].a = rs
			nodes[n].b = rc
		}
		p.expectSemi()
		return n
	}
	if t.kind == TKBreak {
		p.next()
		p.expectSemi()
		return newNode(NKBreak, p.fileID, t.off)
	}
	if t.kind == TKContinue {
		p.next()
		p.expectSemi()
		return newNode(NKContinue, p.fileID, t.off)
	}
	s := p.parseSimpleStmt(false)
	p.expectSemi()
	return s
}

driver func (p *Parser) parseSimpleStmt(inHeader bool) u32 {
	saved := p.noLit
	if inHeader {
		p.noLit = true
	}
	var lhs [16]u32
	nl := usize(0)
	lhs[nl] = p.parseExpr(1)
	nl++
	driver for p.eat(TKComma) {
		if nl < len(lhs) {
			lhs[nl] = p.parseExpr(1)
			nl++
		}
	}
	k := p.cur().kind
	if k == TKInc || k == TKDec {
		op := p.next().kind
		p.noLit = saved
		n := newNode(NKIncDec, p.fileID, nodes[lhs[0]].off)
		nodes[n].op = op
		nodes[n].a = lhs[0]
		return n
	}
	if k == TKDefine || isAssignOp(k) {
		opTok := p.next()
		var rhs [16]u32
		nr := usize(0)
		rhs[nr] = p.parseExpr(1)
		nr++
		driver for p.eat(TKComma) {
			if nr < len(rhs) {
				rhs[nr] = p.parseExpr(1)
				nr++
			}
		}
		p.noLit = saved
		var nk u8 = NKAssign
		if opTok.kind == TKDefine {
			nk = NKShortDecl
		}
		n := newNode(nk, p.fileID, opTok.off)
		nodes[n].op = opTok.kind
		ls, lc := pushList(lhs[:nl])
		rs, rc := pushList(rhs[:nr])
		nodes[n].a = ls
		nodes[n].b = lc
		nodes[n].c = rs
		nodes[n].d = rc
		return n
	}
	p.noLit = saved
	n := newNode(NKExprStmt, p.fileID, nodes[lhs[0]].off)
	nodes[n].a = lhs[0]
	return n
}

func isAssignOp(k u8) bool {
	return k == TKAssign || (k >= TKAddAssign && k <= TKShrAssign)
}

driver func (p *Parser) parseIfStmt() u32 {
	it := p.expect(TKIf, "expected 'if'")
	n := newNode(NKIf, p.fileID, it.off)
	first := p.parseSimpleStmt(true)
	if p.eat(TKSemi) {
		nodes[n].a = first
		saved := p.noLit
		p.noLit = true
		nodes[n].b = p.parseExpr(1)
		p.noLit = saved
	} else {
		if nodes[first].kind == NKExprStmt {
			nodes[n].b = nodes[first].a
		} else {
			p.syntaxErr("expected boolean condition in if")
		}
	}
	nodes[n].c = p.parseBlock()
	if p.eat(TKElse) {
		if p.at(TKIf) {
			nodes[n].d = p.parseIfStmt()
		} else {
			nodes[n].d = p.parseBlock()
			p.expectSemi()
		}
	} else {
		p.expectSemi()
	}
	return n
}

driver func (p *Parser) parseForStmt() u32 {
	startOff := p.cur().off
	var flags u16 = 0
	if p.eat(TKDriver) {
		flags = 1
	}
	p.expect(TKFor, "expected 'for'")
	n := newNode(NKFor, p.fileID, startOff)
	nodes[n].flags = flags
	if !p.at(TKLBrace) && !p.at(TKDecreases) {
		if p.eat(TKSemi) {
			// `for ; cond; post {}`
			if !p.at(TKSemi) {
				saved := p.noLit
				p.noLit = true
				nodes[n].b = p.parseExpr(1)
				p.noLit = saved
			}
			p.expect(TKSemi, "expected ';' in for clause")
			if !p.at(TKLBrace) && !p.at(TKDecreases) {
				nodes[n].c = p.parseSimpleStmt(true)
			}
		} else {
			s1 := p.parseSimpleStmt(true)
			if p.eat(TKSemi) {
				nodes[n].a = s1
				if !p.at(TKSemi) {
					saved := p.noLit
					p.noLit = true
					nodes[n].b = p.parseExpr(1)
					p.noLit = saved
				}
				p.expect(TKSemi, "expected ';' in for clause")
				if !p.at(TKLBrace) && !p.at(TKDecreases) {
					nodes[n].c = p.parseSimpleStmt(true)
				}
			} else if nodes[s1].kind == NKExprStmt {
				nodes[n].b = nodes[s1].a
			} else {
				p.syntaxErr("expected condition or ';' in for")
			}
		}
	}
	if p.eat(TKDecreases) {
		p.expect(TKLParen, "expected '(' after decreases")
		nodes[n].e = p.parseExpr(1)
		p.expect(TKRParen, "expected ')' after decreases")
	}
	nodes[n].d = p.parseBlock()
	p.expectSemi()
	return n
}

driver func (p *Parser) parseScopeStmt() u32 {
	st := p.expect(TKScope, "expected 'scope'")
	n := newNode(NKScope, p.fileID, st.off)
	nt := p.expect(TKIdent, "expected scope variable name")
	nodes[n].a = nt.strID
	p.expect(TKDefine, "expected ':=' in scope statement")
	saved := p.noLit
	p.noLit = true
	nodes[n].b = p.parseExpr(1)
	p.noLit = saved
	nodes[n].c = p.parseBlock()
	p.expectSemi()
	return n
}

driver func (p *Parser) parseMatchStmt() u32 {
	mt := p.expect(TKMatch, "expected 'match'")
	n := newNode(NKMatchStmt, p.fileID, mt.off)
	saved := p.noLit
	p.noLit = true
	nodes[n].a = p.parseExpr(1)
	p.noLit = saved
	as, ac := p.parseMatchArms(false)
	nodes[n].b = as
	nodes[n].c = ac
	return n
}

driver func (p *Parser) parseHandle(isExpr bool) u32 {
	ht := p.expect(TKHandle, "expected 'handle'")
	var kind u8 = NKHandleStmt
	if isExpr {
		kind = NKHandleExpr
	}
	n := newNode(kind, p.fileID, ht.off)
	if p.at(TKLBrace) {
		nodes[n].flags = 1 // block body
		nodes[n].a = p.parseBlock()
	} else {
		saved := p.noLit
		p.noLit = true
		nodes[n].a = p.parseExpr(1)
		p.noLit = saved
	}
	if p.eat(TKWith) {
		nodes[n].d = p.parseType()
	}
	p.expect(TKLBrace, "expected '{' for handle arms")
	var arms [32]u32
	na := usize(0)
	driver for {
		p.skipSemis()
		if p.at(TKRBrace) || p.at(TKEof) {
			break
		}
		opTok := p.expect(TKIdent, "expected effect operation name in handle arm")
		an := newNode(NKHandleArm, p.fileID, opTok.off)
		nodes[an].a = opTok.strID
		if p.eat(TKLParen) {
			var binds [16]u32
			nb := usize(0)
			driver for {
				if p.at(TKRParen) || p.at(TKEof) {
					break
				}
				bt := p.expect(TKIdent, "expected parameter binding in handle arm")
				var bn u32
				if bt.strID == kwBlank {
					bn = newNode(NKPatWild, p.fileID, bt.off)
				} else {
					bn = newNode(NKIdent, p.fileID, bt.off)
					nodes[bn].a = bt.strID
				}
				if nb < len(binds) {
					binds[nb] = bn
					nb++
				}
				if !p.eat(TKComma) {
					break
				}
			}
			p.expect(TKRParen, "expected ')' after handle arm parameters")
			bs, bc := pushList(binds[:nb])
			nodes[an].b = bs
			nodes[an].c = bc
		}
		p.expect(TKArrow, "expected '->' in handle arm")
		var body u32
		if p.at(TKLBrace) {
			body = p.parseBlock()
			if !p.eat(TKComma) {
				p.expectSemi()
			}
		} else if isExpr {
			body = p.parseExpr(1)
			if !p.eat(TKComma) {
				p.expectSemi()
			}
		} else {
			body = p.parseStmt()
			_ = p.eat(TKComma)
		}
		nodes[an].d = body
		if na < len(arms) {
			arms[na] = an
			na++
		}
	}
	p.expect(TKRBrace, "expected '}' after handle")
	as, ac := pushList(arms[:na])
	nodes[n].b = as
	nodes[n].c = ac
	return n
}

driver func (p *Parser) parseMatchArms(isExpr bool) (u32, u32) {
	p.expect(TKLBrace, "expected '{' in match")
	var arms [128]u32
	na := usize(0)
	driver for {
		p.skipSemis()
		if p.at(TKRBrace) || p.at(TKEof) {
			break
		}
		armOff := p.cur().off
		pat := p.parsePattern()
		p.expect(TKArrow, "expected '->' in match arm")
		var body u32
		if isExpr {
			body = p.parseExpr(1)
			if !p.eat(TKComma) {
				p.expectSemi()
			}
		} else if p.at(TKLBrace) {
			body = p.parseBlock()
			if !p.eat(TKComma) {
				p.expectSemi()
			}
		} else {
			body = p.parseStmt()
			_ = p.eat(TKComma)
		}
		an := newNode(NKMatchArm, p.fileID, armOff)
		nodes[an].a = pat
		nodes[an].b = body
		if na < len(arms) {
			arms[na] = an
			na++
		}
	}
	p.expect(TKRBrace, "expected '}' after match")
	return pushList(arms[:na])
}

driver func (p *Parser) parsePattern() u32 {
	first := p.parseSinglePattern()
	if !p.at(TKOr) {
		return first
	}
	var pats [32]u32
	pats[0] = first
	np := usize(1)
	driver for p.eat(TKOr) {
		if np < len(pats) {
			pats[np] = p.parseSinglePattern()
			np++
		}
	}
	n := newNode(NKPatOr, p.fileID, nodes[first].off)
	ps, pc := pushList(pats[:np])
	nodes[n].a = ps
	nodes[n].b = pc
	return n
}

driver func (p *Parser) parseSinglePattern() u32 {
	t := p.cur()
	if t.kind == TKIdent && t.strID == kwBlank {
		p.next()
		return newNode(NKPatWild, p.fileID, t.off)
	}
	if t.kind == TKInt || t.kind == TKString || t.kind == TKChar || t.kind == TKTrue || t.kind == TKFalse || t.kind == TKSub {
		lit := p.parsePrimaryExpr()
		if t.kind == TKSub {
			lit = p.parseUnaryExpr()
		}
		n := newNode(NKPatLit, p.fileID, t.off)
		nodes[n].a = lit
		return n
	}
	if t.kind == TKIdent {
		p.next()
		nameNode := newNode(NKIdent, p.fileID, t.off)
		nodes[nameNode].a = t.strID
		driver for p.eat(TKPeriod) {
			sel := p.expect(TKIdent, "expected identifier after '.' in pattern")
			sn := newNode(NKSelector, p.fileID, sel.off)
			nodes[sn].a = nameNode
			nodes[sn].b = sel.strID
			nameNode = sn
		}
		pn := newNode(NKPatCtor, p.fileID, t.off)
		nodes[pn].a = nameNode
		if p.eat(TKLParen) {
			var binds [16]u32
			nb := usize(0)
			driver for {
				if p.at(TKRParen) || p.at(TKEof) {
					break
				}
				bt := p.expect(TKIdent, "expected pattern binding name")
				var bn u32
				if bt.strID == kwBlank {
					bn = newNode(NKPatWild, p.fileID, bt.off)
				} else {
					bn = newNode(NKIdent, p.fileID, bt.off)
					nodes[bn].a = bt.strID
				}
				if nb < len(binds) {
					binds[nb] = bn
					nb++
				}
				if !p.eat(TKComma) {
					break
				}
			}
			p.expect(TKRParen, "expected ')' after constructor pattern")
			bs, bc := pushList(binds[:nb])
			nodes[pn].b = bs
			nodes[pn].c = bc
		}
		return pn
	}
	p.syntaxErr("expected pattern")
	return newNode(NKPatWild, p.fileID, t.off)
}

// ---------------------------------------------------------------------------
// Expressions (Pratt precedence climbing)

func binPrec(k u8) u8 {
	if k == TKLOr {
		return 1
	}
	if k == TKLAnd {
		return 2
	}
	if k == TKEql || k == TKNeq || k == TKLss || k == TKLeq || k == TKGtr || k == TKGeq {
		return 3
	}
	if k == TKAdd || k == TKSub || k == TKOr || k == TKXor {
		return 4
	}
	if k == TKMul || k == TKQuo || k == TKRem || k == TKShl || k == TKShr || k == TKAnd {
		return 5
	}
	return 0
}

driver func (p *Parser) parseExpr(minPrec u8) u32 {
	if p.depth >= MaxParseDepth {
		p.syntaxErr("maximum expression nesting depth exceeded")
		return 0
	}
	p.depth++
	lhs := p.parseUnaryExpr()
	driver for {
		k := p.cur().kind
		prec := binPrec(k)
		if prec < minPrec {
			break
		}
		opTok := p.next()
		rhs := p.parseExpr(prec + 1)
		bn := newNode(NKBinary, p.fileID, opTok.off)
		nodes[bn].op = opTok.kind
		nodes[bn].a = lhs
		nodes[bn].b = rhs
		lhs = bn
	}
	p.depth--
	return lhs
}

driver func (p *Parser) parseUnaryExpr() u32 {
	t := p.cur()
	if t.kind == TKAdd || t.kind == TKSub || t.kind == TKNot || t.kind == TKXor || t.kind == TKMul || t.kind == TKAnd {
		p.next()
		un := newNode(NKUnary, p.fileID, t.off)
		nodes[un].op = t.kind
		nodes[un].a = p.parseUnaryExpr()
		return un
	}
	return p.parsePostfixExpr()
}

driver func (p *Parser) parsePostfixExpr() u32 {
	x := p.parsePrimaryExpr()
	driver for {
		t := p.cur()
		if t.kind == TKPeriod {
			p.next()
			sel := p.expect(TKIdent, "expected identifier after '.'")
			sn := newNode(NKSelector, p.fileID, sel.off)
			nodes[sn].a = x
			nodes[sn].b = sel.strID
			x = sn
			continue
		}
		if t.kind == TKLParen {
			p.next()
			savedNL := p.noLit
			p.noLit = false
			var args [32]u32
			na := usize(0)
			driver for {
				if p.at(TKRParen) || p.at(TKEof) {
					break
				}
				if na < len(args) {
					args[na] = p.parseExpr(1)
					na++
				}
				if !p.eat(TKComma) {
					break
				}
			}
			p.noLit = savedNL
			p.expect(TKRParen, "expected ')' after arguments")
			cn := newNode(NKCall, p.fileID, t.off)
			nodes[cn].a = x
			as, ac := pushList(args[:na])
			nodes[cn].b = as
			nodes[cn].c = ac
			x = cn
			continue
		}
		if t.kind == TKLBrack {
			p.next()
			savedNL := p.noLit
			p.noLit = false
			// Slice `x[:hi]`
			if p.eat(TKColon) {
				sn := newNode(NKSlice, p.fileID, t.off)
				nodes[sn].a = x
				if !p.at(TKRBrack) && !p.at(TKColon) {
					nodes[sn].c = p.parseExpr(1)
				}
				if p.eat(TKColon) {
					nodes[sn].flags = 1
					nodes[sn].d = p.parseExpr(1)
				}
				p.noLit = savedNL
				p.expect(TKRBrack, "expected ']'")
				x = sn
				continue
			}
			first := p.parseTypeOrExprArg()
			// Slice `x[lo:hi]` or `x[lo:hi:max]`
			if p.eat(TKColon) {
				sn := newNode(NKSlice, p.fileID, t.off)
				nodes[sn].a = x
				nodes[sn].b = first
				if !p.at(TKRBrack) && !p.at(TKColon) {
					nodes[sn].c = p.parseExpr(1)
				}
				if p.eat(TKColon) {
					nodes[sn].flags = 1
					nodes[sn].d = p.parseExpr(1)
				}
				p.noLit = savedNL
				p.expect(TKRBrack, "expected ']'")
				x = sn
				continue
			}
			// Index or generic instantiation `x[i]` / `x[A, B]`
			var idxs [16]u32
			idxs[0] = first
			ni := usize(1)
			driver for p.eat(TKComma) {
				if p.at(TKRBrack) {
					break
				}
				if ni < len(idxs) {
					idxs[ni] = p.parseTypeOrExprArg()
					ni++
				}
			}
			p.noLit = savedNL
			p.expect(TKRBrack, "expected ']'")
			ix := newNode(NKIndex, p.fileID, t.off)
			nodes[ix].a = x
			is, ic := pushList(idxs[:ni])
			nodes[ix].b = is
			nodes[ix].c = ic
			x = ix
			continue
		}
		if t.kind == TKLBrace && !p.noLit && canBeStructLitHead(x) {
			x = p.parseStructLit(x)
			continue
		}
		break
	}
	return x
}

func canBeStructLitHead(n u32) bool {
	k := nodes[n].kind
	return k == NKIdent || k == NKSelector || k == NKIndex || k == NKTypeExpr
}

driver func (p *Parser) parseStructLit(head u32) u32 {
	lt := p.expect(TKLBrace, "expected '{'")
	sn := newNode(NKStructLit, p.fileID, lt.off)
	nodes[sn].a = head
	var inits [64]u32
	ni := usize(0)
	driver for {
		p.skipSemis()
		if p.at(TKRBrace) || p.at(TKEof) {
			break
		}
		ft := p.expect(TKIdent, "expected field name in struct literal")
		p.expect(TKColon, "expected ':' after field name")
		val := p.parseExpr(1)
		fi := newNode(NKFieldInit, p.fileID, ft.off)
		nodes[fi].a = ft.strID
		nodes[fi].b = val
		if ni < len(inits) {
			inits[ni] = fi
			ni++
		}
		if !p.eat(TKComma) {
			p.skipSemis()
			break
		}
	}
	p.expect(TKRBrace, "expected '}' after struct literal")
	is, ic := pushList(inits[:ni])
	nodes[sn].b = is
	nodes[sn].c = ic
	return sn
}

driver func (p *Parser) parsePrimaryExpr() u32 {
	t := p.cur()
	if t.kind == TKIdent {
		p.next()
		n := newNode(NKIdent, p.fileID, t.off)
		nodes[n].a = t.strID
		return n
	}
	if t.kind == TKInt {
		p.next()
		v, ok := parseIntLit(strSlice(t.strID))
		if !ok {
			addDiagStr(E1001, p.fileID, t.off, "invalid integer literal")
		}
		n := newNode(NKIntLit, p.fileID, t.off)
		nodes[n].a = t.strID
		nodes[n].b = newU64(v)
		return n
	}
	if t.kind == TKFloat {
		p.next()
		bits, ok := parseFloatLit(strSlice(t.strID))
		if !ok {
			addDiagStr(E1001, p.fileID, t.off, "invalid float literal")
		}
		n := newNode(NKFloatLit, p.fileID, t.off)
		nodes[n].a = t.strID
		nodes[n].b = newU64(bits)
		return n
	}
	if t.kind == TKString {
		p.next()
		n := newNode(NKStrLit, p.fileID, t.off)
		nodes[n].a = t.strID
		return n
	}
	if t.kind == TKChar {
		p.next()
		n := newNode(NKCharLit, p.fileID, t.off)
		sb := strSlice(t.strID)
		if len(sb) > 0 {
			nodes[n].a = u32(sb[0])
		}
		return n
	}
	if t.kind == TKTrue || t.kind == TKFalse {
		p.next()
		n := newNode(NKBoolLit, p.fileID, t.off)
		if t.kind == TKTrue {
			nodes[n].a = 1
		}
		return n
	}
	if t.kind == TKNil {
		p.next()
		return newNode(NKNilLit, p.fileID, t.off)
	}
	if t.kind == TKLParen {
		p.next()
		saved := p.noLit
		p.noLit = false
		inner := p.parseExpr(1)
		p.noLit = saved
		p.expect(TKRParen, "expected ')'")
		return inner
	}
	if t.kind == TKMatch {
		p.next()
		n := newNode(NKMatchExpr, p.fileID, t.off)
		saved := p.noLit
		p.noLit = true
		nodes[n].a = p.parseExpr(1)
		p.noLit = saved
		as, ac := p.parseMatchArms(true)
		nodes[n].b = as
		nodes[n].c = ac
		return n
	}
	if t.kind == TKHandle {
		return p.parseHandle(true)
	}
	if t.kind == TKFunc || (t.kind == TKDriver && p.peek(1).kind == TKFunc) {
		var eff u8 = EffTotal
		if p.eat(TKDriver) {
			eff = EffDriver
		}
		p.expect(TKFunc, "expected 'func'")
		sig := p.parseFuncSig(false, false)
		body := p.parseBlock()
		n := newNode(NKFuncLit, p.fileID, t.off)
		nodes[n].op = eff
		nodes[n].a = sig
		nodes[n].b = body
		return n
	}
	// Fixed array literal `[N]T{e0, e1, ...}` or slice/array type expression
	if t.kind == TKLBrack {
		ty := p.parseType()
		if nodes[ty].kind == NKTypeArray && p.at(TKLBrace) {
			p.next()
			var elems [256]u32
			ne := usize(0)
			driver for {
				p.skipSemis()
				if p.at(TKRBrace) || p.at(TKEof) {
					break
				}
				if ne < len(elems) {
					elems[ne] = p.parseExpr(1)
					ne++
				}
				if !p.eat(TKComma) {
					p.skipSemis()
					break
				}
			}
			p.expect(TKRBrace, "expected '}' after array literal")
			al := newNode(NKArrayLit, p.fileID, t.off)
			nodes[al].a = ty
			es, ec := pushList(elems[:ne])
			nodes[al].b = es
			nodes[al].c = ec
			return al
		}
		te := newNode(NKTypeExpr, p.fileID, t.off)
		nodes[te].a = ty
		return te
	}
	p.syntaxErr("expected expression")
	p.next()
	return 0
}
