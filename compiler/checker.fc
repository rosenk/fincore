// checker.fc — the type checker, part 1 (port of finc0's types/checker.go,
// typexpr.go and the assignability half of expr.go): operands, package-
// level declarations, type expressions, assignability and untyped
// constants, and the whole-program checks (recursive types, main, finish).
//
// The checker, the expression/statement checkers (check_expr.fc,
// check_stmt.fc) and the comptime interpreter (comptime.fc) form one
// recursive SCC: every member takes `dp usize` with decreases(dp), returns
// early when dp == 0 (setting semaFull) and passes dp-1 inside the SCC.
// The entry point checkProgram starts at SemaDepth.
package main

const (
	MaxOpStack = 65_536
	MaxNamed   = 32_768
)

// Checker state (types.Checker): the current function and its context.
var chkFn u32       // current FuncInfo (0 outside functions)
var chkLoops u32    // enclosing for loops
var chkConstCtx u32 // > 0 while checking an expression that must be constant

// Operand is the result of checking an expression (types.operand).
type Operand struct {
	val      Val
	mode     u8 // ExprKind; KNone = invalid
	indirect bool
	typ      u32
	expr     u32
	sym      u32 // KFunc, KBuiltin, KPackage
	method   u32 // method selections (mode KFunc)
	recv     u32
	recvType u32
	// addressable: the receiver operand is addressable (KVar), so a
	// pointer-receiver method may be called on it (auto-&, v0.2)
	addressable bool
	vEnum       u32 // KVariantCtor: underlying Enum TypeID
	vIndex   u32 //   and variant index
}

// opStack holds operand lists (call arguments, assignment sides) in LIFO
// order.
type OpStack struct {
	items [MaxOpStack]Operand
	top   usize
}

var opStack OpStack

func opPush(x Operand) {
	if opStack.top >= MaxOpStack {
		setFull("operand stack")
		return
	}
	opStack.items[opStack.top] = x
	opStack.top++
}

// Value stack for comptime call arguments.
var vstack [MaxOpStack]Val
var vtop usize

func vpush(v Val) {
	if vtop >= MaxOpStack {
		setFull("value stack")
		return
	}
	vstack[vtop] = v
	vtop++
}

// Info.Named: declared named types in source order.
var namedTypes [MaxNamed]u32
var nNamed usize

func invalidOp(e u32) Operand {
	var x Operand
	x.typ = TyInvalid
	x.expr = e
	return x
}

func opMode(mode u8, t u32) Operand {
	var x Operand
	x.mode = mode
	x.typ = t
	return x
}

func opConst(t u32, v Val) Operand {
	var x Operand
	x.mode = KConst
	x.typ = t
	x.val = v
	return x
}

func isInvalidOp(x *Operand) bool {
	return x.mode == KNone
}

func tooDeep() {
	setFull("recursion depth")
}

// record stores the operand's type, kind and value for its expression.
func record(x *Operand) {
	e := x.expr
	if e == 0 {
		return
	}
	ntype[usize(e)] = x.typ
	if x.mode is KBuiltin | KPackage {
		ntype[usize(e)] = 0
	}
	nmode[usize(e)] = x.mode
	if x.mode == KConst && x.val != Val.None {
		nval[usize(e)] = valStore(x.val)
	}
}

func setSymType(s u32, t u32) {
	if s == 0 {
		return
	}
	syms.items[usize(s)].typ = t
	id := syms.items[usize(s)].ident
	if id != 0 {
		ntype[usize(id)] = t
	}
}

// ---------------------------------------------------------------------------
// Expression strings (types.exprString; rendered by Expr in msg.fc).

func writeExprList(o *OutBuf, n u32, dp usize) decreases(dp) {
	if dp == 0 {
		return
	}
	c := l1len(n)
	for i := usize(0); i < c; i++ {
		if i > 0 {
			o.WriteString(", ")
		}
		writeExpr(o, l1at(n, i), dp-1)
	}
}

func writeExpr(o *OutBuf, e u32, dp usize) decreases(dp) {
	if dp == 0 || e == 0 {
		return
	}
	k := nkind(e)
	if k is NkIdent | NkBasicLit {
		o.WriteBytes(ntext(e))
	} else if k == NkBoolLit {
		if nflag(e) {
			o.WriteString("true")
		} else {
			o.WriteString("false")
		}
	} else if k == NkNilLit {
		o.WriteString("nil")
	} else if k == NkBinaryExpr {
		writeExpr(o, na(e), dp-1)
		o.WriteByte(' ')
		o.WriteString(binOpString(nop(e)))
		o.WriteByte(' ')
		writeExpr(o, nb(e), dp-1)
	} else if k == NkUnaryExpr {
		o.WriteString(unaryOpString(nop(e)))
		writeExpr(o, na(e), dp-1)
	} else if k == NkParenExpr {
		o.WriteByte('(')
		writeExpr(o, na(e), dp-1)
		o.WriteByte(')')
	} else if k == NkCallExpr {
		writeExpr(o, na(e), dp-1)
		o.WriteByte('(')
		writeExprList(o, e, dp-1)
		o.WriteByte(')')
	} else if k == NkIndexExpr {
		writeExpr(o, na(e), dp-1)
		o.WriteByte('[')
		writeExprList(o, e, dp-1)
		o.WriteByte(']')
	} else if k == NkSliceExpr {
		writeExpr(o, na(e), dp-1)
		o.WriteByte('[')
		writeExpr(o, nb(e), dp-1)
		o.WriteByte(':')
		writeExpr(o, nc(e), dp-1)
		o.WriteByte(']')
	} else if k == NkSelectorExpr {
		writeExpr(o, na(e), dp-1)
		o.WriteByte('.')
		o.WriteBytes(ntext(nb(e)))
	} else if k == NkFuncLit {
		o.WriteString("func literal")
	} else if k == NkStructLit {
		t := na(e)
		if na(t) != 0 {
			o.WriteBytes(ntext(na(t)))
			o.WriteByte('.')
		}
		o.WriteBytes(ntext(nb(t)))
		o.WriteString("{...}")
	} else if k == NkTypeExpr {
		o.WriteString("type expression")
	} else if k == NkMatchExpr {
		o.WriteString("match expression")
	} else if k == NkTupleExpr {
		o.WriteString("(")
		writeExprList(o, e, dp-1)
		o.WriteString(")")
	} else if k == NkIsExpr {
		writeExpr(o, na(e), dp-1)
		o.WriteString(" is ")
		writePattern(o, nb(e), dp-1)
	} else {
		o.WriteString("expression")
	}
}

// errAtOp reports at the operator of a BinaryExpr (OpPos).
func errAtOp(code u32, e u32, k usize) {
	p := nival(e)
	addDiag(nfile(e), u32(p>>32), u32(p&0xFFFFFFFF), code, mbuf[:k])
}

// errAtEnd reports at the last byte of a node (missing return).
func errAtEnd(code u32, n u32, k usize) {
	line := nodes.items[usize(n)].eLine
	col := nodes.items[usize(n)].eCol
	if col > 1 {
		col--
	}
	addDiag(nfile(n), line, col, code, mbuf[:k])
}

func unparen(e u32) u32 {
	x := e
	for g := usize(0); g < MaxNodes; g++ {
		if x == 0 || nkind(x) != NkParenExpr {
			return x
		}
		x = na(x)
	}
	return x
}

// synthNode allocates a synthetic node (ast.ExprAsType's NamedType /
// PointerType) at the position of `from`.
func synthNode(kind u8, from u32) u32 {
	n := nodes.alloc(kind, nodes.items[usize(from)].file, nodes.items[usize(from)].sLine, nodes.items[usize(from)].sCol)
	if n == 0 {
		setFull("AST nodes")
		return 0
	}
	nodes.items[usize(n)].eLine = nodes.items[usize(from)].eLine
	nodes.items[usize(n)].eCol = nodes.items[usize(from)].eCol
	return n
}

// exprAsNamedType converts Ident, Ident.Ident and X[...] to a NamedType.
func exprAsNamedType(e u32, dp usize) u32 decreases(dp) {
	if dp == 0 {
		return 0
	}
	k := nkind(e)
	if k == NkIdent {
		n := synthNode(NkNamedType, e)
		nodes.items[usize(n)].b = e
		return n
	}
	if k == NkSelectorExpr {
		if nkind(na(e)) == NkIdent {
			n := synthNode(NkNamedType, e)
			nodes.items[usize(n)].a = na(e)
			nodes.items[usize(n)].b = nb(e)
			return n
		}
		return 0
	}
	if k == NkIndexExpr {
		x := na(e)
		xk := nkind(x)
		if xk is NkIdent | NkSelectorExpr {
			nt := exprAsNamedType(x, dp-1)
			if nt == 0 {
				return 0
			}
			n := synthNode(NkNamedType, e)
			nodes.items[usize(n)].a = na(nt)
			nodes.items[usize(n)].b = nb(nt)
			nodes.items[usize(n)].l1s = nodes.items[usize(e)].l1s
			nodes.items[usize(n)].l1n = nodes.items[usize(e)].l1n
			return n
		}
	}
	return 0
}

// exprAsType converts an expression to a type node (0 if impossible).
func exprAsType(e u32, dp usize) u32 decreases(dp) {
	if dp == 0 {
		return 0
	}
	k := nkind(e)
	if k == NkTypeExpr {
		return na(e)
	}
	if k == NkParenExpr {
		return exprAsType(na(e), dp-1)
	}
	if k == NkUnaryExpr {
		if nop(e) != OpDeref {
			return 0
		}
		elem := exprAsType(na(e), dp-1)
		if elem == 0 {
			return 0
		}
		n := synthNode(NkPointerType, e)
		nodes.items[usize(n)].a = elem
		return n
	}
	return exprAsNamedType(e, dp-1)
}

// ---------------------------------------------------------------------------
// Assignment contexts ("argument to f", "struct literal", ...)

// Ctx is an assignment context: where a value is assigned to a type.
type Ctx enum {
	ConstDecl
	VarDecl
	Assign
	Decreases
	StructLit
	Return
	Pattern
	TypeArg
	Match
	ArgExpr(u32)         // argument to a call of the function expression (node)
	ArgMethod(u32)       // argument to a method (MethodID): "Recv.name"
	ArgBuiltin(u8)       // argument to a builtin
	ArgVariant(u32, u32) // argument to a variant constructor: enum type, variant name
}

// CallName renders the callee name of an argument context.
type CallName Ctx

func (c CallName) Format(dst []byte) usize {
	return match Ctx(c) {
		ArgExpr(e) -> formatTo(dst, "%v", Expr(e))
		ArgMethod(m) -> formatTo(dst, "%v.%v", NameRef(typeName(meths.items[usize(m)].recv)), NameRef(meths.items[usize(m)].name))
		ArgBuiltin(b) -> formatTo(dst, "%s", builtinName(b))
		ArgVariant(t, name) -> formatTo(dst, "%v.%v", TypeRef(t), NameRef(name))
		_ -> 0
	}
}

func (c Ctx) Format(dst []byte) usize {
	return match c {
		ConstDecl -> formatTo(dst, "constant declaration")
		VarDecl -> formatTo(dst, "variable declaration")
		Assign -> formatTo(dst, "assignment")
		Decreases -> formatTo(dst, "decreases clause")
		StructLit -> formatTo(dst, "struct literal")
		Return -> formatTo(dst, "return statement")
		Pattern -> formatTo(dst, "match pattern")
		TypeArg -> formatTo(dst, "type argument")
		Match -> formatTo(dst, "match")
		ArgExpr(_) | ArgMethod(_) | ArgBuiltin(_) | ArgVariant(..) -> formatTo(dst, "argument to %v", CallName(c))
	}
}

// ---------------------------------------------------------------------------
// Assignability (expr.go)

// assignment checks that x can be assigned to type t, converting untyped
// constants and level-polymorphic codes (E2004 nil, E2010 levels, E2002).
func assignment(x *Operand, t u32, c Ctx) bool {
	if isInvalidOp(x) || isInvalid(t) {
		return true
	}
	if isUntyped(x.typ) {
		return convertUntyped(x, t)
	}
	// Code levels are stored + 1 (0 = level-polymorphic).
	if trec(x.typ) is Code(xl) && trec(underlying(t)) is Code(tl) {
		if xl == 0 {
			x.typ = t
			updateType(x.expr, t, SemaDepth)
			return true
		}
		if tl != 0 && tl != xl {
			errAt(E2010, x.expr, formatTo(mbuf[:], "universe level mismatch: cannot use %v (Code %d) as Code %d in %v", Expr(x.expr), xl-1, tl-1, c))
			return false
		}
	}
	if assignable(x.typ, t) {
		return true
	}
	errAt(E2002, x.expr, formatTo(mbuf[:], "cannot use %v (type %v) as type %v in %v", Expr(x.expr), TypeRef(x.typ), TypeRef(t), c))
	return false
}

// assignable reports whether a value of type v may be assigned to t: v and
// t are identical, or they have identical underlying types and at least
// one of them is not named (decision 126). As in Go, the predeclared basic
// types count as named (hasTypeName). error is an interface in Go, so
// values of error types (`type E error`) stay mutually assignable.
func assignable(v u32, t u32) bool {
	if v == t {
		return true
	}
	if basicKind(v) == BkError && basicKind(t) == BkError {
		return true
	}
	if !hasTypeName(v) || !hasTypeName(t) {
		vu := underlying(v)
		tu := underlying(t)
		if vu == tu && !(trec(vu) is TypeParam(..) | Opaque(..)) {
			return true
		}
		if isSigT(vu) && isSigT(tu) && sigEffect(vu) <= sigEffect(tu) && sigVariadic(vu) == sigVariadic(tu) &&
			u32sEqual(sigParamsSlice(vu), sigParamsSlice(tu)) && u32sEqual(sigResultsSlice(vu), sigResultsSlice(tu)) {
			return true
		}
	}
	return false
}

// hasTypeName reports whether t is a named type in the sense of Go's
// assignability rule: a Named type or a typed predeclared basic type.
func hasTypeName(t u32) bool {
	return match trec(t) { Named(_) -> true, Basic(_) -> !isUntyped(t), _ -> false }
}

// convertUntyped converts an untyped operand to type t.
func convertUntyped(x *Operand, t u32) bool {
	return convertUntypedDp(x, t, SemaDepth)
}

// convertUntypedDp is convertUntyped inside the updateType SCC (untyped
// match expressions convert their arms, v0.2).
func convertUntypedDp(x *Operand, t u32, dp usize) bool decreases(dp) {
	if dp == 0 {
		tooDeep()
		return false
	}
	if !isUntyped(x.typ) || isInvalid(t) {
		return true
	}
	k := basicKind(x.typ)
	ok := false
	if k == BkUntypedNil {
		u := underlying(t)
		if isSliceT(u) || basicKind(t) == BkError {
			ok = true
		} else {
			if isPointerT(u) || isScoped(t) {
				errAt(E2004, x.expr, formatTo(mbuf[:], "cannot use nil as %v value: nil is only valid for error and slices", TypeRef(t)))
			} else {
				errAt(E2002, x.expr, formatTo(mbuf[:], "cannot use nil as %v value", TypeRef(t)))
			}
			return false
		}
	} else if k is BkUntypedInt | BkUntypedChar {
		if isInteger(t) && !isUntyped(t) {
			if x.val != Val.None && !representable(x.val, t) {
				errAt(E2002, x.expr, formatTo(mbuf[:], "constant %v overflows %v", ValRef(x.val), TypeRef(t)))
				return false
			}
			ok = true
		} else if isUntyped(t) && isInteger(t) {
			ok = true
		}
	} else if k == BkUntypedBool {
		ok = isBoolean(t)
	} else if k == BkUntypedString {
		ok = isString(t)
		if !ok && isByteSliceT(t) && x.expr != 0 {
			// v0.2 ergonomics: a constant string used as a []byte is an
			// implicit strBytes (a fresh copy). The constant itself is
			// typed string; the node is marked in nbytes.
			if !convertUntypedDp(x, TyString, dp-1) {
				return false
			}
			nbytes[usize(x.expr)] = true
			x.mode = KValue
			x.typ = t
			x.val = Val.None
			return true
		}
	}
	if isTypeParamT(t) {
		ok = false
	}
	if !ok {
		errAt(E2002, x.expr, formatTo(mbuf[:], "cannot use %v (%v constant) as type %v", Expr(x.expr), TypeRef(x.typ), TypeRef(t)))
		return false
	}
	x.typ = t
	updateType(x.expr, t, dp-1)
	return true
}

// defaultTypeOp gives an untyped operand its default type (`:=`, var
// declarations without type) and returns it.
func defaultTypeOp(x *Operand, c Ctx) u32 {
	if isInvalidOp(x) {
		return TyInvalid
	}
	if basicKind(x.typ) == BkUntypedNil {
		errAt(E2004, x.expr, formatTo(mbuf[:], "use of untyped nil in %v", c))
		return TyInvalid
	}
	if isUntyped(x.typ) || isPolyCode(x.typ) {
		d := defaultOf(x.typ)
		if isUntyped(x.typ) {
			_ = convertUntyped(x, d)
		} else {
			x.typ = d
			updateType(x.expr, d, SemaDepth)
		}
		return d
	}
	return x.typ
}

// updateType records the final type of an untyped expression tree.
func updateType(e u32, t u32, dp usize) decreases(dp) {
	if dp == 0 || e == 0 {
		return
	}
	old := ntype[usize(e)]
	if old != 0 && !isUntyped(old) && !isPolyCode(old) {
		return
	}
	ntype[usize(e)] = t
	k := nkind(e)
	if k == NkParenExpr {
		updateType(na(e), t, dp-1)
	} else if k == NkMatchExpr {
		convertMatchArms(e, t, dp-1)
	} else if k == NkUnaryExpr {
		if nop(e) is OpNeg | OpNot {
			updateType(na(e), t, dp-1)
		}
	} else if k == NkBinaryExpr {
		op := nop(e)
		if isCompareOp(op) {
			return
		}
		updateType(na(e), t, dp-1)
		if !(op is OpShl | OpShr) {
			updateType(nb(e), t, dp-1)
		}
	}
}

// singleValue checks that x denotes a single value.
func singleValue(x *Operand) {
	m := x.mode
	if m == KNone {
		return
	}
	if m is KValue | KVar | KConst {
		if trec(x.typ) is Tuple(_, n) {
			errAt(E2003, x.expr, formatTo(mbuf[:], "multiple-value %v (%d values) in single-value context", Expr(x.expr), n))
			x.mode = KNone
		}
		return
	}
	if m == KNoValue {
		errAt(E2002, x.expr, formatTo(mbuf[:], "%v (no value) used as value", Expr(x.expr)))
	} else if m == KType {
		errAt(E2002, x.expr, formatTo(mbuf[:], "type %v is not an expression", TypeRef(x.typ)))
	} else if m == KBuiltin {
		errAt(E2002, x.expr, formatTo(mbuf[:], "builtin %v must be called", Expr(x.expr)))
	} else if m == KFunc {
		isSig := isSigT(x.typ)
		if x.method != 0 {
			errAt(E2002, x.expr, formatTo(mbuf[:], "method value %v is not supported; call the method", Expr(x.expr)))
		} else if isSig && sigNTParams(x.typ) > 0 {
			errAt(E2002, x.expr, formatTo(mbuf[:], "generic function %v must be instantiated with explicit type arguments", Expr(x.expr)))
		} else if isSig && sigEffect(x.typ) == EffComptime {
			errAt(E2002, x.expr, formatTo(mbuf[:], "comptime function %v can only be called", Expr(x.expr)))
		} else {
			x.mode = KValue
			return
		}
	} else if m == KPackage {
		errAt(E2002, x.expr, formatTo(mbuf[:], "package %v is not an expression", Expr(x.expr)))
	} else if m == KVariantCtor {
		errAt(E2003, x.expr, formatTo(mbuf[:], "variant %v requires %d payload values", Expr(x.expr), variantPayN(x.vEnum, usize(x.vIndex))))
	}
	x.mode = KNone
	x.typ = TyInvalid
}

// ---------------------------------------------------------------------------
// Program entry (types.Check)

// checkProgram type-checks all loaded packages. Diagnostics go to diags.
func checkProgram() {
	initBasicTypes()
	initUnivTypes()
	n := pkgs.norder
	for i := usize(0); i < n; i++ {
		p := pkgs.order[i]
		nd := usize(pkgs.items[usize(p)].declN)
		for j := usize(0); j < nd; j++ {
			objDecl(uat(pkgs.items[usize(p)].declS, j), SemaDepth)
		}
	}
	for i := usize(0); i < n; i++ {
		p := pkgs.order[i]
		nd := usize(pkgs.items[usize(p)].declN)
		for j := usize(0); j < nd; j++ {
			s := uat(pkgs.items[usize(p)].declS, j)
			if symKind(s) == SymFunc {
				_ = ensureBody(s, SemaDepth)
			}
		}
	}
	checkRecursiveTypes()
	checkMain()
	finishInfo()
}

// symType returns the type of a symbol, checking its declaration first.
func symType(s u32, dp usize) u32 decreases(dp) {
	if dp == 0 {
		tooDeep()
		return TyInvalid
	}
	objDecl(s, dp-1)
	return syms.items[usize(s)].typ
}

// hostEnsureBody implements types.Host.EnsureBody for the interpreter.
func hostEnsureBody(fn u32, dp usize) bool decreases(dp) {
	if dp == 0 {
		tooDeep()
		return false
	}
	objDecl(fn, dp-1)
	if fn != 0 && syms.items[usize(fn)].body == 1 {
		errAt(E4001, syms.items[usize(fn)].ident, formatTo(mbuf[:], "comptime evaluation cycle: %v is evaluated while its own body is being checked", NameRef(symName(fn))))
		syms.items[usize(fn)].body = 3
		return false
	}
	return ensureBody(fn, dp-1)
}

// hostConstValue implements types.Host.ConstValue (0 slot if erroneous).
func hostConstValue(s u32, dp usize) u32 decreases(dp) {
	if dp == 0 {
		tooDeep()
		return 0
	}
	objDecl(s, dp-1)
	return syms.items[usize(s)].val
}

func objDecl(s u32, dp usize) decreases(dp) {
	if dp == 0 {
		tooDeep()
		return
	}
	if s == 0 {
		return
	}
	st := syms.items[usize(s)].objState
	if st == 2 {
		return
	}
	k := symKind(s)
	if st == 1 {
		id := syms.items[usize(s)].ident
		name := NameRef(symName(s))
		if k == SymType {
			t := syms.items[usize(s)].typ
			if isNamedT(t) {
				return
			}
			errAt(E2002, id, formatTo(mbuf[:], "invalid recursive type alias %v", name))
		} else if k == SymConst {
			errAt(E2002, id, formatTo(mbuf[:], "initialization cycle: constant %v refers to itself", name))
		} else if k == SymVar {
			errAt(E2002, id, formatTo(mbuf[:], "initialization cycle: variable %v refers to itself", name))
		} else {
			return
		}
		syms.items[usize(s)].typ = TyInvalid
		return
	}
	b := syms.items[usize(s)].builtin
	if b != 0 {
		syms.items[usize(s)].objState = 2
		if builtinIsType(b) {
			t := predeclaredType(b)
			if t != 0 {
				syms.items[usize(s)].typ = t
			}
		} else if builtinIsConst(b) {
			t, v := predeclaredConst(b)
			syms.items[usize(s)].typ = t
			syms.items[usize(s)].val = valStore(v)
		}
		return
	}
	syms.items[usize(s)].objState = 1
	d := syms.items[usize(s)].decl
	dk := u8(0)
	if d != 0 {
		dk = nkind(d)
	}
	match dk {
		NkConstSpec -> constSpec(s, d, dp-1)
		NkTypeDecl -> typeDecl(s, d, dp-1)
		NkVarDecl -> varDecl(s, d, d, dp-1)
		NkFuncDecl -> funcDecl(s, d, dp-1)
		_ -> {}
	}
	syms.items[usize(s)].objState = 2
}

func predeclaredConst(b u8) (u32, Val) {
	match b {
		BCNanosecond -> return univNamed[BTDuration], vIntU(1)
		BCMicrosecond -> return univNamed[BTDuration], vIntU(1_000)
		BCMillisecond -> return univNamed[BTDuration], vIntU(1_000_000)
		BCSecond -> return univNamed[BTDuration], vIntU(1_000_000_000)
		BCSIGINT -> return univNamed[BTSignal], vIntU(2)
		BCSIGTERM -> return univNamed[BTSignal], vIntU(15)
		_ if builtinIsErrorSentinel(b) -> return TyError, vErr(b)
		_ -> return TyInvalid, Val.None
	}
}

// Function context save/restore (withoutFunc).
type FnCtx struct {
	fn    u32
	loops u32
	cc    u32
}

func saveFn() FnCtx {
	return FnCtx{fn: chkFn, loops: chkLoops, cc: chkConstCtx}
}

func restoreFn(c FnCtx) {
	chkFn = c.fn
	chkLoops = c.loops
	chkConstCtx = c.cc
}

func enterFn(fn u32) FnCtx {
	c := saveFn()
	chkFn = fn
	chkLoops = 0
	chkConstCtx = 0
	return c
}

func constSpec(s u32, d u32, dp usize) decreases(dp) {
	if dp == 0 {
		tooDeep()
		return
	}
	if symIsGlobal(s) {
		c := enterFn(0)
		chkConstCtx++
		constSpecIn(s, d, dp-1)
		restoreFn(c)
		return
	}
	chkConstCtx++
	constSpecIn(s, d, dp-1)
	chkConstCtx--
}

func constSpecIn(s u32, d u32, dp usize) decreases(dp) {
	if dp == 0 {
		tooDeep()
		return
	}
	t := u32(0)
	if nb(d) != 0 {
		t = typExpr(nb(d), dp-1)
	}
	x := exprValue(nc(d), dp-1)
	if isInvalidOp(&x) || (isInvalid(t) && nb(d) != 0) {
		setSymType(s, TyInvalid)
		return
	}
	if x.mode != KConst {
		errAt(E2002, nc(d), formatTo(mbuf[:], "%v is not constant", Expr(nc(d))))
		setSymType(s, TyInvalid)
		return
	}
	if t != 0 {
		if !assignment(&x, t, Ctx.ConstDecl) {
			setSymType(s, TyInvalid)
			return
		}
	}
	if isScoped(x.typ) {
		errAt(E2002, nc(d), formatTo(mbuf[:], "constant %v cannot have Scoped type %v", NameRef(symName(s)), TypeRef(x.typ)))
		setSymType(s, TyInvalid)
		return
	}
	setSymType(s, x.typ)
	slot := valStore(x.val)
	syms.items[usize(s)].val = slot
	nmode[usize(na(d))] = KConst
	nval[usize(na(d))] = slot
}

func typeDecl(s u32, d u32, dp usize) decreases(dp) {
	if dp == 0 {
		tooDeep()
		return
	}
	c := enterFn(0)
	typeDeclIn(s, d, dp-1)
	restoreFn(c)
}

func typeDeclIn(s u32, d u32, dp usize) decreases(dp) {
	if dp == 0 {
		tooDeep()
		return
	}
	if nflag(d) {
		if nb(d) != 0 {
			errAt(E2002, na(d), formatTo(mbuf[:], "generic type alias %v is not supported", NameRef(symName(s))))
		}
		t := typExpr(nc(d), dp-1)
		setSymType(s, t)
		return
	}
	n := newNamed(symName(s), s, syms.items[usize(s)].pkg, 0)
	setSymType(s, n)
	if nNamed < MaxNamed {
		namedTypes[nNamed] = n
		nNamed++
	} else {
		setFull("named types")
	}
	if nb(d) != 0 {
		ts, tn := typeParams(nb(d), dp-1)
		setNamedTParams(n, ts, tn)
	}
	under := typExpr(nc(d), dp-1)
	match trec(under) {
		Named(id) -> {
			r := typs.named[usize(id)]
			if r.under == 0 {
				errAt(E2002, na(d), formatTo(mbuf[:], "invalid recursive type %v", NameRef(symName(s))))
				setNamedUnder(n, TyInvalid)
			} else {
				setNamedUnder(n, r.under)
				if r.builtin != 0 && r.clsOK {
					setNamedClass(n, r.cls)
				}
			}
		}
		TypeParam(..) -> {
			errAt(E2002, nc(d), formatTo(mbuf[:], "cannot use a type parameter as the underlying type of %v", NameRef(symName(s))))
			setNamedUnder(n, TyInvalid)
		}
		_ -> setNamedUnder(n, under)
	}
	completePending(n)
}

// varDecl checks a variable declaration; s may be 0 for a local `var _`
// (ident is then the blank identifier).
func varDecl(s u32, d u32, ident u32, dp usize) decreases(dp) {
	if dp == 0 {
		tooDeep()
		return
	}
	if s != 0 && symIsGlobal(s) {
		c := enterFn(0)
		varDeclIn(s, d, dp-1)
		restoreFn(c)
		return
	}
	varDeclIn(s, d, dp-1)
}

func setVarType(s u32, d u32, t u32) {
	if s != 0 {
		setSymType(s, t)
	} else {
		ntype[usize(na(d))] = t
	}
}

// VarName renders a variable name; 0 is the blank `var _`.
type VarName u32

func (s VarName) Format(dst []byte) usize {
	if s == 0 {
		return formatTo(dst, "_")
	}
	return formatTo(dst, "%v", NameRef(symName(u32(s))))
}

func varDeclIn(s u32, d u32, dp usize) decreases(dp) {
	if dp == 0 {
		tooDeep()
		return
	}
	global := s != 0 && symIsGlobal(s)
	t := u32(0)
	if nb(d) != 0 {
		t = typExpr(nb(d), dp-1)
		if isInvalid(t) {
			setVarType(s, d, TyInvalid)
			if nc(d) != 0 {
				_ = exprValue(nc(d), dp-1)
			}
			return
		}
		if global && isScoped(t) {
			errAt(E3001, na(d), formatTo(mbuf[:], "package-level variable %v cannot have Scoped type %v", VarName(s), TypeRef(t)))
			setVarType(s, d, t)
			return
		}
	}
	if nc(d) == 0 {
		if t != 0 && isScoped(t) {
			errAt(E2005, na(d), formatTo(mbuf[:], "variable %v of Scoped type %v must be initialized", VarName(s), TypeRef(t)))
		}
		setVarType(s, d, t)
		return
	}
	if global {
		chkConstCtx++
	}
	x := exprValue(nc(d), dp-1)
	if global {
		chkConstCtx--
	}
	if isInvalidOp(&x) {
		if t == 0 {
			t = TyInvalid
		}
		setVarType(s, d, t)
		return
	}
	if t != 0 {
		_ = assignment(&x, t, Ctx.VarDecl)
	} else {
		t = defaultTypeOp(&x, Ctx.VarDecl)
		if global && isScoped(t) {
			errAt(E3001, na(d), formatTo(mbuf[:], "package-level variable %v cannot have Scoped type %v", VarName(s), TypeRef(t)))
		}
	}
	if global && x.mode != KConst && !isInvalidOp(&x) {
		errAt(E2002, nc(d), formatTo(mbuf[:], "package-level variable initializer must be a constant expression"))
	}
	setVarType(s, d, t)
}

// typeParams creates the type/const parameters of a TypeParamList and
// returns them as a type list.
func typeParams(l u32, dp usize) (u32, u32) decreases(dp) {
	if dp == 0 {
		tooDeep()
		return 0, 0
	}
	mark := tmark()
	np := l1len(l)
	for i := usize(0); i < np; i++ {
		p := l1at(l, i)
		constT := u32(0)
		if nkind(na(p)) != NkAnyType {
			ct := typExpr(na(p), dp-1)
			_, _, ok := intInfo(ct)
			if ok {
				constT = ct
			} else if !isInvalid(ct) {
				errAt(E2002, na(p), formatTo(mbuf[:], "unsupported constraint %v (want any or an integer type such as usize)", TypeRef(ct)))
			}
		}
		nn := l1len(p)
		for j := usize(0); j < nn; j++ {
			id := l1at(p, j)
			sym := defs[usize(id)]
			tp := newTypeParam(idName(id), sym, u32(tmark()-mark), constT)
			tpush(tp)
			setSymType(sym, tp)
		}
	}
	return tcommitStack(mark)
}

func funcDecl(s u32, d u32, dp usize) decreases(dp) {
	if dp == 0 {
		tooDeep()
		return
	}
	c := enterFn(0)
	funcDeclIn(s, d, dp-1)
	restoreFn(c)
}

func funcDeclIn(s u32, d u32, dp usize) decreases(dp) {
	if dp == 0 {
		tooDeep()
		return
	}
	eff := u8(EffTotal)
	if nop(d) == ModDriver {
		eff = EffDriver
	} else if nop(d) == ModComptime {
		eff = EffComptime
	}
	var fi FuncInfo
	fi.sym = s
	fi.decl = d
	fi.effect = eff
	fi.body = nf(d)
	if ne(d) != 0 {
		fi.measure = na(ne(d))
	}
	fid := newFuncInfo(fi)
	if fid == 0 {
		return
	}
	nfunc[usize(d)] = fid
	if na(d) != 0 {
		receiver(fid, d, dp-1)
	}
	if nc(d) != 0 {
		ts, tn := typeParams(nc(d), dp-1)
		if na(d) != 0 {
			errAt(E2002, nc(d), formatTo(mbuf[:], "methods cannot have their own type parameters"))
		} else {
			funcs.items[usize(fid)].tpS = ts
			funcs.items[usize(fid)].tpN = tn
		}
	}
	tpS := u32(0)
	tpN := u32(0)
	if na(d) == 0 {
		tpS = funcs.items[usize(fid)].tpS
		tpN = funcs.items[usize(fid)].tpN
	}
	sig := signature(nd(d), eff, tpS, tpN, dp-1)
	funcs.items[usize(fid)].sig = sig
	m := funcs.items[usize(fid)].method
	if m != 0 {
		meths.items[usize(m)].sig = sig
	}
	setSymType(s, sig)
	ps, pn := paramSyms(nd(d), sig)
	funcs.items[usize(fid)].parS = ps
	funcs.items[usize(fid)].parN = pn
}

// paramSyms records the parameter types and returns the parameter Ident
// nodes (FuncInfo.Params; blank `_` params have no symbol).
func paramSyms(as u32, sig u32) (u32, u32) {
	mark := umark()
	i := usize(0)
	np := sigNParams(sig)
	n := l1len(as)
	for k := usize(0); k < n; k++ {
		p := l1at(as, k)
		m := l1len(p)
		for j := usize(0); j < m; j++ {
			id := l1at(p, j)
			sym := defs[usize(id)]
			t := u32(TyInvalid)
			if i < np {
				t = sigParam(sig, i)
				if sigVariadic(sig) && i == np-1 {
					t = mkSlice(t)
				}
			}
			if sym != 0 {
				setSymType(sym, t)
			} else {
				ntype[usize(id)] = t
			}
			upush(id)
			i++
		}
	}
	return ucommit(mark)
}

func receiver(fid u32, d u32, dp usize) decreases(dp) {
	if dp == 0 {
		tooDeep()
		return
	}
	r := na(d)
	tn := nb(r)
	tsym := uses[usize(tn)]
	var m Method
	m.name = idName(nb(d))
	m.ptrRecv = nflag(r)
	m.sym = funcs.items[usize(fid)].sym
	m.decl = d
	mid := newMethod(m)
	if mid == 0 {
		return
	}
	funcs.items[usize(fid)].method = mid
	syms.items[usize(m.sym)].method = mid
	rs := defs[usize(na(r))]
	funcs.items[usize(fid)].recvSym = rs
	if tsym == 0 {
		setSymType(rs, TyInvalid)
		return
	}
	named := symType(tsym, dp-1)
	if namedSym(named) != tsym { // 0 for other types
		errAt(E2002, tn, formatTo(mbuf[:], "invalid receiver type %v (must be a named type declared in this package)", NameRef(idName(tn))))
		setSymType(rs, TyInvalid)
		return
	}
	meths.items[usize(mid)].recv = named
	ntype[usize(tn)] = named
	recvT := named
	nr := l1len(r)
	ntp := namedNTParams(named)
	if nr != ntp {
		errAt(E2003, r, formatTo(mbuf[:], "receiver %v needs %d type parameters, got %d", NameRef(typeName(named)), ntp, nr))
	} else if ntp > 0 {
		mark := tmark()
		for i := usize(0); i < nr; i++ {
			id := l1at(r, i)
			sym := defs[usize(id)]
			tp := newTypeParam(idName(id), sym, u32(i), tpConstType(namedTParam(named, i)))
			setSymType(sym, tp)
			tpush(tp)
		}
		ts, tc := tcommitStack(mark)
		meths.items[usize(mid)].rtpS = ts
		meths.items[usize(mid)].rtpN = tc
		funcs.items[usize(fid)].tpS = ts
		funcs.items[usize(fid)].tpN = tc
		recvT = instantiate(named, tlistSlice(ts, tc), 0, SemaDepth)
	}
	if nflag(r) {
		recvT = mkPointer(recvT)
	}
	setSymType(rs, recvT)
}

// methodsOf returns the methods (ulists range) of an origin named type.
func methodsOf(n0 u32, dp usize) (u32, u32) decreases(dp) {
	if dp == 0 {
		tooDeep()
		return 0, 0
	}
	n := n0
	if namedOrigin(n) != 0 {
		n = namedOrigin(n)
	}
	ms0, mn0, cached := namedMethodCache(n)
	if cached || namedBuiltin(n) != 0 {
		return ms0, mn0
	}
	mark := umark()
	ns := namedSym(n)
	if ns != 0 && syms.items[usize(ns)].pkg != 0 {
		p := syms.items[usize(ns)].pkg
		cnt := usize(pkgs.items[usize(p)].methN)
		tname := typeName(n)
		for i := usize(0); i < cnt; i++ {
			msym := uat(pkgs.items[usize(p)].methS, i)
			if syms.items[usize(msym)].recvType != tname {
				continue
			}
			objDecl(msym, dp-1)
			m := syms.items[usize(msym)].method
			if m != 0 && meths.items[usize(m)].recv == n {
				upush(m)
			}
		}
	}
	s, c := ucommit(mark)
	setNamedMethods(n, s, c)
	return s, c
}

func lookupMethod(n u32, name u32, dp usize) u32 decreases(dp) {
	if dp == 0 {
		tooDeep()
		return 0
	}
	s, c := methodsOf(n, dp-1)
	cnt := usize(c)
	for i := usize(0); i < cnt; i++ {
		m := uat(s, i)
		if meths.items[usize(m)].name == name {
			return m
		}
	}
	return 0
}

// ---------------------------------------------------------------------------
// Function bodies

func ensureBody(s u32, dp usize) bool decreases(dp) {
	if dp == 0 {
		tooDeep()
		return false
	}
	if s == 0 || symKind(s) != SymFunc {
		return false
	}
	objDecl(s, dp-1)
	st := syms.items[usize(s)].body
	if st is 1 | 3 {
		return false
	}
	if st == 2 {
		return true
	}
	d := syms.items[usize(s)].decl
	if d == 0 || nkind(d) != NkFuncDecl || nf(d) == 0 {
		return false
	}
	fi := nfunc[usize(d)]
	if fi == 0 {
		return false
	}
	syms.items[usize(s)].body = 1
	before := diags.count
	c := enterFn(fi)
	funcBody(fi, dp-1)
	restoreFn(c)
	if diags.count > before {
		syms.items[usize(s)].body = 3
		return false
	}
	syms.items[usize(s)].body = 2
	return true
}

func funcBody(fi u32, dp usize) decreases(dp) {
	if dp == 0 {
		tooDeep()
		return
	}
	if funcs.items[usize(fi)].measure != 0 {
		measure(funcs.items[usize(fi)].measure, dp-1)
	}
	body := funcs.items[usize(fi)].body
	stmtList(body, dp-1)
	if sigNResults(funcs.items[usize(fi)].sig) > 0 && !isTerminatingList(body, SemaDepth) {
		errAtEnd(E2003, body, formatTo(mbuf[:], "missing return at end of %v", FuncName(fi)))
	}
}

// measure checks a decreases(M) expression: M must be a usize value.
func measure(e u32, dp usize) decreases(dp) {
	if dp == 0 {
		tooDeep()
		return
	}
	x := exprValue(e, dp-1)
	if isInvalidOp(&x) {
		return
	}
	_ = assignment(&x, TyUsize, Ctx.Decreases)
}

// ---------------------------------------------------------------------------
// Type expressions (typexpr.go)

func typExpr(t u32, dp usize) u32 decreases(dp) {
	if dp == 0 {
		tooDeep()
		return TyInvalid
	}
	r := typExpr0(t, dp-1)
	if r == 0 {
		r = TyInvalid
	}
	ntype[usize(t)] = r
	nmode[usize(t)] = KType
	return r
}

func typExpr0(t u32, dp usize) u32 decreases(dp) {
	if dp == 0 {
		tooDeep()
		return TyInvalid
	}
	k := nkind(t)
	if k == NkNamedType {
		return namedTypeExpr(t, dp-1)
	}
	if k == NkArrayType {
		elem := typExpr(nb(t), dp-1)
		n, lp, ok := arrayLen(na(t), dp-1)
		if !ok || isInvalid(elem) {
			return TyInvalid
		}
		return mkArray(n, lp, elem)
	}
	if k is NkSliceType | NkPointerType {
		elem := typExpr(na(t), dp-1)
		if isInvalid(elem) {
			return TyInvalid
		}
		if k == NkSliceType {
			return mkSlice(elem)
		}
		return mkPointer(elem)
	}
	if k == NkStructType {
		mark := tmark()
		nf := l1len(t)
		for i := usize(0); i < nf; i++ {
			f := l1at(t, i)
			ft := typExpr(na(f), dp-1)
			nn := l1len(f)
			for j := usize(0); j < nn; j++ {
				id := l1at(f, j)
				nm := idName(id)
				if nm != nameBlank {
					fs := tslice(mark)
					cnt := len(fs) / 2
					for q := usize(0); q < cnt; q++ {
						if fs[2*q] == nm {
							errAt(E2002, id, formatTo(mbuf[:], "duplicate field %v", NameRef(nm)))
							break
						}
					}
				}
				tpush(nm)
				tpush(ft)
				ntype[usize(id)] = ft
			}
		}
		return mkStruct(mark)
	}
	if k == NkEnumType {
		mark := tmark()
		nv := l1len(t)
		for i := usize(0); i < nv; i++ {
			v := l1at(t, i)
			nm := idName(na(v))
			vs := tslice(mark)
			cnt := len(vs) / 3
			for q := usize(0); q < cnt; q++ {
				if vs[3*q] == nm {
					errAt(E2002, na(v), formatTo(mbuf[:], "duplicate variant %v", NameRef(nm)))
					break
				}
			}
			pm := tmark()
			np := l1len(v)
			for j := usize(0); j < np; j++ {
				tpush(typExpr(l1at(v, j), dp-1))
			}
			ps, pn := tcommitStack(pm)
			tpush(nm)
			tpush(ps)
			tpush(pn)
		}
		return mkEnum(mark)
	}
	if k == NkFuncType {
		eff := u8(EffTotal)
		if nflag(t) {
			eff = EffDriver
		}
		return signature(na(t), eff, 0, 0, dp-1)
	}
	if k == NkCodeType {
		chkConstCtx++
		r := codeTypeLevel(na(t), dp-1)
		chkConstCtx--
		return r
	}
	if k == NkElType {
		chkConstCtx++
		r := elType(na(t), dp-1)
		chkConstCtx--
		return r
	}
	if k == NkAnyType {
		errAt(E2002, t, formatTo(mbuf[:], "any is only allowed as a type parameter constraint"))
		return TyInvalid
	}
	return TyInvalid
}

func codeTypeLevel(e u32, dp usize) u32 decreases(dp) {
	if dp == 0 {
		tooDeep()
		return TyInvalid
	}
	x := exprValue(e, dp-1)
	if isInvalidOp(&x) {
		return TyInvalid
	}
	if x.mode != KConst || !isInteger(x.typ) {
		errAt(E2010, e, formatTo(mbuf[:], "Code level must be a constant natural number, not %v", Expr(e)))
		return TyInvalid
	}
	_ = convertUntyped(&x, TyUsize)
	if !(x.val is Int(0, lvl)) || lvl > 1<<20 {
		errAt(E2010, e, formatTo(mbuf[:], "invalid Code level %v", ValRef(x.val)))
		return TyInvalid
	}
	return mkCode(int(lvl))
}

// elType evaluates El(e): e must be a constant Code.
func elType(e u32, dp usize) u32 decreases(dp) {
	if dp == 0 {
		tooDeep()
		return TyInvalid
	}
	x := exprValue(e, dp-1)
	if isInvalidOp(&x) {
		return TyInvalid
	}
	if !(trec(x.typ) is Code(_)) {
		errAt(E2002, e, formatTo(mbuf[:], "El expects a Code value, got %v (type %v)", Expr(e), TypeRef(x.typ)))
		return TyInvalid
	}
	if x.mode != KConst || !isCodeVal(x.val) {
		errAt(E2002, e, formatTo(mbuf[:], "El argument %v is not a compile-time constant", Expr(e)))
		return TyInvalid
	}
	return foldCode(x.val, SemaDepth)
}

// arrayLen evaluates an array length: a constant or a const type parameter.
func arrayLen(e u32, dp usize) (u64, u32, bool) decreases(dp) {
	if dp == 0 {
		tooDeep()
		return 0, 0, false
	}
	if nkind(e) == NkIdent {
		sym := uses[usize(e)]
		if sym != 0 && symKind(sym) == SymTypeParam {
			tp := syms.items[usize(sym)].typ
			if ct := tpConstType(tp); ct != 0 {
				ntype[usize(e)] = ct
				nmode[usize(e)] = KValue
				return 0, tp, true
			}
		}
	}
	chkConstCtx++
	x := exprValue(e, dp-1)
	chkConstCtx--
	if isInvalidOp(&x) {
		return 0, 0, false
	}
	if x.mode != KConst {
		errAt(E4003, e, formatTo(mbuf[:], "array length %v is not a compile-time constant", Expr(e)))
		return 0, 0, false
	}
	if !isInteger(x.typ) {
		errAt(E4003, e, formatTo(mbuf[:], "array length %v must be an integer (have %v)", Expr(e), TypeRef(x.typ)))
		return 0, 0, false
	}
	if !(x.val is Int(0, n)) || n > 1<<48 {
		errAt(E4003, e, formatTo(mbuf[:], "invalid array length %v", ValRef(x.val)))
		return 0, 0, false
	}
	if isUntyped(x.typ) {
		_ = convertUntyped(&x, TyUsize)
	}
	return n, 0, true
}

// signature builds a function type; tps are the type parameters of a
// generic function (type list range).
func signature(s u32, eff u8, tpS u32, tpN u32, dp usize) u32 decreases(dp) {
	if dp == 0 {
		tooDeep()
		return TyInvalid
	}
	m1 := tmark()
	variadic := false
	np := l1len(s)
	for i := usize(0); i < np; i++ {
		p := l1at(s, i)
		t := typExpr(na(p), dp-1)
		nn := l1len(p)
		for j := usize(0); j < nn; j++ {
			tpush(t)
		}
		if nflag(p) {
			variadic = true
		}
	}
	m2 := tmark()
	nr := l2len(s)
	for i := usize(0); i < nr; i++ {
		tpush(typExpr(l2at(s, i), dp-1))
	}
	m3 := tmark()
	for i := usize(0); i < usize(tpN); i++ {
		tpush(tlist(tpS, i))
	}
	return mkSig(eff, variadic, m1, m2, m3)
}

// namedTypeExpr resolves [pkg.]Name[Args].
func namedTypeExpr(t u32, dp usize) u32 decreases(dp) {
	if dp == 0 {
		tooDeep()
		return TyInvalid
	}
	name := nb(t)
	sym := uses[usize(name)]
	if sym == 0 {
		return TyInvalid
	}
	if na(t) != 0 {
		nmode[usize(na(t))] = KPackage
	}
	r := typeSym(sym, name, dp-1)
	if isInvalid(r) {
		return r
	}
	ntype[usize(name)] = r
	nmode[usize(name)] = KType
	if isNamedT(r) && namedNTParams(r) > 0 {
		if l1len(t) == 0 {
			errAt(E2002, t, formatTo(mbuf[:], "generic type %v used without type arguments", NameRef(typeName(r))))
			return TyInvalid
		}
		return instantiateArgs(r, t, t, t, dp-1)
	}
	if l1len(t) > 0 {
		errAt(E2002, t, formatTo(mbuf[:], "%v is not a generic type", TypeRef(r)))
		return TyInvalid
	}
	return r
}

// typeSym returns the type denoted by a symbol in type position.
func typeSym(sym u32, id u32, dp usize) u32 decreases(dp) {
	if dp == 0 {
		tooDeep()
		return TyInvalid
	}
	k := symKind(sym)
	if k == SymType {
		b := syms.items[usize(sym)].builtin
		if b == BTCode {
			errAt(E2010, id, formatTo(mbuf[:], "Code requires a level (Code n)"))
			return TyInvalid
		}
		if b == BTEl {
			errAt(E2002, id, formatTo(mbuf[:], "El requires an argument (El(code))"))
			return TyInvalid
		}
		t := symType(sym, dp-1)
		if t == 0 {
			return TyInvalid
		}
		return t
	}
	if k == SymTypeParam {
		tp := syms.items[usize(sym)].typ
		if trec(tp) is TypeParam(.., ct) {
			if ct == 0 {
				return tp
			}
			errAt(E2002, id, formatTo(mbuf[:], "%v is a const parameter, not a type", NameRef(symName(sym))))
		}
		return TyInvalid
	}
	errAt(E2002, id, formatTo(mbuf[:], "%v is not a type", NameRef(symName(sym))))
	return TyInvalid
}

// instantiateArgs instantiates generic named type n with the type
// arguments in list l1 of `args` (a NamedType or IndexExpr); node records
// the instance, sp is the error position.
func instantiateArgs(n u32, args u32, node u32, sp u32, dp usize) u32 decreases(dp) {
	if dp == 0 {
		tooDeep()
		return TyInvalid
	}
	na1 := l1len(args)
	ntp := namedNTParams(n)
	if na1 != ntp {
		errAt(E2003, sp, formatTo(mbuf[:], "wrong number of type arguments for %v: have %d, want %d", NameRef(typeName(n)), na1, ntp))
		return TyInvalid
	}
	mark := tmark()
	for i := usize(0); i < na1; i++ {
		ta := typeArg(l1at(args, i), namedTParam(n, i), dp-1)
		if isInvalid(ta) {
			tdiscard(mark)
			return TyInvalid
		}
		tpush(ta)
	}
	s, c := tcommitStack(mark)
	return instantiate(n, tlistSlice(s, c), node, SemaDepth)
}

// typeArg checks one type argument against its parameter.
func typeArg(e u32, tp u32, dp usize) u32 decreases(dp) {
	if dp == 0 {
		tooDeep()
		return TyInvalid
	}
	if tpIsConst(tp) {
		u := unparen(e)
		if nkind(u) == NkIdent {
			sym := uses[usize(u)]
			if sym != 0 && symKind(sym) == SymTypeParam {
				p := syms.items[usize(sym)].typ
				if ct := tpConstType(p); ct != 0 {
					ntype[usize(u)] = ct
					nmode[usize(u)] = KValue
					return p
				}
			}
		}
		chkConstCtx++
		x := exprValue(e, dp-1)
		chkConstCtx--
		if isInvalidOp(&x) {
			return TyInvalid
		}
		if x.mode != KConst || !isInteger(x.typ) {
			errAt(E2002, e, formatTo(mbuf[:], "type argument %v for const parameter %v must be an integer constant", Expr(e), NameRef(typeName(tp))))
			return TyInvalid
		}
		if !assignment(&x, tpConstType(tp), Ctx.TypeArg) {
			return TyInvalid
		}
		if !(x.val is Int(0, v)) {
			errAt(E2002, e, formatTo(mbuf[:], "invalid const argument %v", ValRef(x.val)))
			return TyInvalid
		}
		return mkConstArg(v)
	}
	at := exprAsType(e, SemaDepth)
	if at == 0 {
		errAt(E2002, e, formatTo(mbuf[:], "%v is not a type", Expr(e)))
		return TyInvalid
	}
	t := typExpr(at, dp-1)
	if isInvalid(t) {
		return t
	}
	if classOfT(t) != ClassValue {
		errAt(E2002, e, formatTo(mbuf[:], "type argument %v must be a Value type (type parameters range over Value types)", TypeRef(t)))
		return TyInvalid
	}
	return t
}

// ---------------------------------------------------------------------------
// Whole-program checks

var recState [MaxTypes]u8

func recVisit(t u32, dp usize) bool decreases(dp) {
	if dp == 0 || t == 0 {
		return false
	}
	match trec(t) {
		Named(_) -> return recVisitNamed(t, dp-1)
		Array(e, ..) -> return recVisit(e, dp-1)
		Struct(..) -> {
			n := nfields(t)
			for i := usize(0); i < n; i++ {
				if recVisit(fieldType(t, i), dp-1) {
					return true
				}
			}
			return false
		}
		Enum(..) -> {
			n := nvariants(t)
			for i := usize(0); i < n; i++ {
				m := variantPayN(t, i)
				for j := usize(0); j < m; j++ {
					if recVisit(variantPay(t, i, j), dp-1) {
						return true
					}
				}
			}
			return false
		}
		NoType | Basic(_) | Sig(..) | Slice(_) | Pointer(_) | Code(_) | TypeParam(..) | ConstArg(_) | Tuple(..) | Opaque(..) -> return false
	}
}

func recVisitNamed(t u32, dp usize) bool decreases(dp) {
	if dp == 0 {
		return false
	}
	n := t
	if o := namedOrigin(t); o != 0 {
		n = o
	}
	st := recState[usize(n)]
	if st == 1 {
		return true
	}
	if st == 2 {
		return false
	}
	recState[usize(n)] = 1
	bad := recVisit(namedUnder(n), dp-1)
	recState[usize(n)] = 2
	return bad
}

// checkRecursiveTypes reports named types that contain themselves by value.
func checkRecursiveTypes() {
	n := nNamed
	for i := usize(0); i < n; i++ {
		t := namedTypes[i]
		if recState[usize(t)] == 0 && recVisitNamed(t, SemaDepth) {
			s := namedSym(t)
			if s != 0 && syms.items[usize(s)].ident != 0 {
				errAt(E2002, syms.items[usize(s)].ident, formatTo(mbuf[:], "invalid recursive type %v (contains itself by value)", NameRef(typeName(t))))
			}
		}
	}
}


// The parts shared by the "invalid main signature" messages.
const (
	badMain  = "invalid main signature: "
	wantMain = " (want driver func main(<capabilities>) error)"
)

// checkMain validates the entry point of the root package.
func checkMain() {
	root := pkgs.root
	if root == 0 || !nameIs(pkgs.items[usize(root)].name, "main") || pkgs.items[usize(root)].scp == 0 {
		return
	}
	sym := lookupLocal(pkgs.items[usize(root)].scp, nameMain)
	if sym == 0 {
		return
	}
	d := syms.items[usize(sym)].decl
	if symKind(sym) != SymFunc || d == 0 || nkind(d) != NkFuncDecl {
		errAt(E5002, syms.items[usize(sym)].ident, formatTo(mbuf[:], "main must be a function"))
		return
	}
	fi := nfunc[usize(d)]
	funcs.main = fi
	if nop(d) != ModDriver {
		errAt(E5002, nb(d), formatTo(mbuf[:], badMain+"main must be a driver func"+wantMain))
		return
	}
	if nc(d) != 0 {
		errAt(E5002, nb(d), formatTo(mbuf[:], badMain+"main cannot have type parameters"+wantMain))
		return
	}
	if fi == 0 || funcs.items[usize(fi)].sig == 0 {
		return
	}
	sig := funcs.items[usize(fi)].sig
	var seen [NumBuiltins]bool
	np := sigNParams(sig)
	for i := usize(0); i < np; i++ {
		p := sigParam(sig, i)
		if isInvalid(p) {
			return
		}
		if !isCapability(p) || (sigVariadic(sig) && i == np-1) {
			errAt(E5002, nb(d), formatTo(mbuf[:], badMain+"parameter of type %v is not a capability (Net, Signals, Clock, FS, Env, Stdio, Exec)"+wantMain, TypeRef(p)))
			return
		}
		b := builtinOf(p)
		if seen[usize(b)] {
			errAt(E5002, nb(d), formatTo(mbuf[:], badMain+"duplicate capability %v"+wantMain, TypeRef(p)))
			return
		}
		seen[usize(b)] = true
	}
	if sigNResults(sig) != 1 || basicKind(sigResult(sig, 0)) != BkError {
		errAt(E5002, nb(d), formatTo(mbuf[:], badMain+"main must return exactly error"+wantMain))
	}
}

func addFuncOrder(fi u32, dp usize) decreases(dp) {
	if dp == 0 {
		return
	}
	upush(fi)
	c := funcs.items[usize(fi)].litH
	for g := usize(0); g < MaxCells; g++ {
		if c == 0 {
			break
		}
		addFuncOrder(cellVal(c), dp-1)
		c = cellNext(c)
	}
}

// finishInfo orders Info.Funcs and gives remaining untyped expressions
// their default types.
func finishInfo() {
	mark := umark()
	n := pkgs.norder
	for i := usize(0); i < n; i++ {
		p := pkgs.order[i]
		nd := usize(pkgs.items[usize(p)].declN)
		for j := usize(0); j < nd; j++ {
			s := uat(pkgs.items[usize(p)].declS, j)
			d := syms.items[usize(s)].decl
			if symKind(s) == SymFunc && d != 0 && nkind(d) == NkFuncDecl {
				fi := nfunc[usize(d)]
				if fi != 0 {
					addFuncOrder(fi, SemaDepth)
				}
			}
		}
	}
	s, c := ucommit(mark)
	funcs.orderS = s
	funcs.orderN = c
	nn := nodes.count
	for i := usize(0); i < nn; i++ {
		t := ntype[i]
		if t == 0 {
			continue
		}
		if (isUntyped(t) && basicKind(t) != BkUntypedNil) || isPolyCode(t) {
			ntype[i] = defaultOf(t)
		}
	}
	ns := syms.count
	for i := usize(1); i < ns; i++ {
		t := syms.items[i].typ
		if t != 0 && isUntyped(t) {
			if syms.items[i].kind == SymConst {
				syms.items[i].untyped = true
			}
			syms.items[i].typ = defaultOf(t)
		}
	}
}
