// totality_flow.fc — the totality checker, part 2 (port of finc0's
// totality/flow.go and the T2/T3 halves of loops.go): a structured,
// path-sensitive walk over a function or loop body.
//
// The abstract state (finc0's *state) holds
//   - lb: proven lower bounds (>= 1) of stable integer variables, learned
//     from branch conditions and killed by assignments;
//   - shrunk: the T2 slice was strictly shortened on the current path;
//   - dec: T3: the measure is proven smaller than at iteration start;
//   - bnd: T3: bounds of local variables relative to the iteration-start
//     values (terms) of the measure variables.
//
// States are handles into `tst`; their lb and bnd entries are regions of
// the pools lbSym/lbVal and bents, grown by relocation. A bnd fact for a
// variable is a presence entry (side 0) plus its lower (side 1) and upper
// (side 2) bounds, so that a variable can be known with empty bound lists
// (finc0's map entry with empty slices). All pools are reset before each
// analysis root (one loop, or one function body of a recursive group).
//
// A bounds value (finc0's bnds) is a region of the scratch stack bstk:
// `lo` lower bounds followed by `hi` upper bounds. Functions returning
// bounds leave the result at the stack top where they were entered.
//
// The walker's callbacks (onCall, onAssign, onExit) dispatch on wMode.
package main

const (
	TotMaxStates = 262_144
	TotMaxLB     = 524_288
	TotMaxBE     = 524_288
	TotMaxBS     = 262_144
	TotMaxAsg    = 65_536

	TermVar   = 1 // value of a variable at iteration start
	TermLen   = 2 // len of an invariant slice
	TermConst = 3 // a constant

	SideAny = 0 // presence entry
	SideLo  = 1
	SideHi  = 2

	U64Max = 18446744073709551615
)

// WalkMode selects the callbacks of the flow walker.
type WalkMode enum {
	T2  // T2: the loop's slice is strictly shortened
	T3  // T3: the measure decreases
	Rec // recursion: collect the calls of a body
}

type TSt struct {
	dead   bool
	shrunk bool
	dec    bool
	lbS    u32
	lbN    u32
	lbC    u32
	bS     u32
	bN     u32
	bC     u32
}

type TBE struct {
	sym    u32
	side   u8
	tk     u8
	strict bool
	tv     u64
}

type TBound struct {
	tk     u8
	strict bool
	tv     u64
}

type Bnds struct {
	s  u32
	lo u32
	hi u32
}

var tst [TotMaxStates]TSt
var ntst usize
var lbSym [TotMaxLB]u32
var lbVal [TotMaxLB]u64
var nlbp usize
var bents [TotMaxBE]TBE
var nbep usize
var bstk [TotMaxBS]TBound
var nbstk usize

// assignment scratch: lhs and rhs nodes of the assignment being walked,
// and the new bounds of each target
var asg [TotMaxAsg]u32
var nasg usize
var asgB [TotMaxAsg]Bnds
var asgHave [TotMaxAsg]bool

// walker configuration
var wMode WalkMode
var wTrack bool
var twDepth usize
var wWhy u32
var wRem u32  // T2: the shrinking slice
var t3X u32   // T3: measure leaves (Y may be 0) and post statement
var t3Y u32
var t3Post u32
var t3Trk [MaxSyms]bool   // T3: tracked variables
var t3LenOK [MaxSyms]bool // T3: len(s) is an invariant term
var t3Marked [MaxSyms]u32
var nt3Marked usize

func totReset() {
	ntst = 1
	nlbp = 0
	nbep = 0
	nbstk = 0
	nasg = 0
	twDepth = 0
}

// ---------------------------------------------------------------------------
// States

func newState() u32 {
	if ntst >= TotMaxStates {
		setFull("totality states")
		return 0
	}
	h := ntst
	ntst++
	var z TSt
	tst[h] = z
	return u32(h)
}

func cloneState(h u32) u32 {
	n := newState()
	if n == 0 {
		return h
	}
	src := tst[usize(h)]
	tst[usize(n)].dead = src.dead
	tst[usize(n)].shrunk = src.shrunk
	tst[usize(n)].dec = src.dec
	ln := usize(src.lbN)
	lcap := ln + 4
	if nlbp+lcap > TotMaxLB {
		setFull("totality states")
		return h
	}
	ls := nlbp
	nlbp += lcap
	for i := usize(0); i < ln; i++ {
		lbSym[ls+i] = lbSym[usize(src.lbS)+i]
		lbVal[ls+i] = lbVal[usize(src.lbS)+i]
	}
	tst[usize(n)].lbS = u32(ls)
	tst[usize(n)].lbN = u32(ln)
	tst[usize(n)].lbC = u32(lcap)
	bn := usize(src.bN)
	bcap := bn + 4
	if nbep+bcap > TotMaxBE {
		setFull("totality states")
		return h
	}
	bs := nbep
	nbep += bcap
	for i := usize(0); i < bn; i++ {
		bents[bs+i] = bents[usize(src.bS)+i]
	}
	tst[usize(n)].bS = u32(bs)
	tst[usize(n)].bN = u32(bn)
	tst[usize(n)].bC = u32(bcap)
	return n
}

func isDead(h u32) bool {
	return tst[usize(h)].dead
}

// lbRoom makes room for one more lb entry of state h.
func lbRoom(h u32) bool {
	n := usize(tst[usize(h)].lbN)
	if n < usize(tst[usize(h)].lbC) {
		return true
	}
	ncap := n*2 + 4
	if nlbp+ncap > TotMaxLB {
		setFull("totality states")
		return false
	}
	s := usize(tst[usize(h)].lbS)
	ns := nlbp
	nlbp += ncap
	for i := usize(0); i < n; i++ {
		lbSym[ns+i] = lbSym[s+i]
		lbVal[ns+i] = lbVal[s+i]
	}
	tst[usize(h)].lbS = u32(ns)
	tst[usize(h)].lbC = u32(ncap)
	return true
}

func lbFind(h u32, s u32) (usize, bool) {
	st := usize(tst[usize(h)].lbS)
	n := usize(tst[usize(h)].lbN)
	for i := usize(0); i < n; i++ {
		if lbSym[st+i] == s {
			return st + i, true
		}
	}
	return 0, false
}

func lbGet(h u32, s u32) u64 {
	i, ok := lbFind(h, s)
	if !ok {
		return 0
	}
	return lbVal[i]
}

func lbPut(h u32, s u32, v u64) {
	i, ok := lbFind(h, s)
	if ok {
		lbVal[i] = v
		return
	}
	if !lbRoom(h) {
		return
	}
	j := usize(tst[usize(h)].lbS) + usize(tst[usize(h)].lbN)
	lbSym[j] = s
	lbVal[j] = v
	tst[usize(h)].lbN++
}

func lbDel(h u32, s u32) {
	i, ok := lbFind(h, s)
	if !ok {
		return
	}
	last := usize(tst[usize(h)].lbS) + usize(tst[usize(h)].lbN) - 1
	lbSym[i] = lbSym[last]
	lbVal[i] = lbVal[last]
	tst[usize(h)].lbN--
}

func bRoom(h u32, extra usize) bool {
	n := usize(tst[usize(h)].bN)
	if n+extra <= usize(tst[usize(h)].bC) {
		return true
	}
	ncap := (n+extra)*2 + 4
	if nbep+ncap > TotMaxBE {
		setFull("totality states")
		return false
	}
	s := usize(tst[usize(h)].bS)
	ns := nbep
	nbep += ncap
	for i := usize(0); i < n; i++ {
		bents[ns+i] = bents[s+i]
	}
	tst[usize(h)].bS = u32(ns)
	tst[usize(h)].bC = u32(ncap)
	return true
}

func bAppend(h u32, e TBE) {
	if !bRoom(h, 1) {
		return
	}
	j := usize(tst[usize(h)].bS) + usize(tst[usize(h)].bN)
	bents[j] = e
	tst[usize(h)].bN++
}

func bHas(h u32, s u32) bool {
	st := usize(tst[usize(h)].bS)
	n := usize(tst[usize(h)].bN)
	for i := usize(0); i < n; i++ {
		if bents[st+i].sym == s && bents[st+i].side == SideAny {
			return true
		}
	}
	return false
}

func bDel(h u32, s u32) {
	st := usize(tst[usize(h)].bS)
	n := usize(tst[usize(h)].bN)
	w := st
	for i := usize(0); i < n; i++ {
		if bents[st+i].sym != s {
			bents[w] = bents[st+i]
			w++
		}
	}
	tst[usize(h)].bN = u32(w - st)
}

// bGet pushes the bounds of s in state h (empty if unknown).
func bGet(h u32, s u32) Bnds {
	r := Bnds{s: u32(nbstk), lo: 0, hi: 0}
	st := usize(tst[usize(h)].bS)
	n := usize(tst[usize(h)].bN)
	for i := usize(0); i < n; i++ {
		e := bents[st+i]
		if e.sym == s && e.side == SideLo {
			bpush(e.tk, e.tv, e.strict)
			r.lo++
		}
	}
	for i := usize(0); i < n; i++ {
		e := bents[st+i]
		if e.sym == s && e.side == SideHi {
			bpush(e.tk, e.tv, e.strict)
			r.hi++
		}
	}
	return r
}

// bSet replaces the bounds of s in state h by b.
func bSet(h u32, s u32, b Bnds) {
	bDel(h, s)
	if !bRoom(h, 1+usize(b.lo)+usize(b.hi)) {
		return
	}
	bAppend(h, TBE{sym: s, side: SideAny, tk: 0, strict: false, tv: 0})
	n := usize(b.lo) + usize(b.hi)
	for i := usize(0); i < n; i++ {
		x := bstk[usize(b.s)+i]
		side := u8(SideLo)
		if i >= usize(b.lo) {
			side = SideHi
		}
		bAppend(h, TBE{sym: s, side: side, tk: x.tk, strict: x.strict, tv: x.tv})
	}
}

// bAdd adds a bound to a known variable (addBound: an existing term only
// becomes strict).
func bAdd(h u32, s u32, side u8, k u8, v u64, strict bool) {
	st := usize(tst[usize(h)].bS)
	n := usize(tst[usize(h)].bN)
	for i := usize(0); i < n; i++ {
		e := bents[st+i]
		if e.sym == s && e.side == side && e.tk == k && e.tv == v {
			if strict && !e.strict {
				bents[st+i].strict = true
			}
			return
		}
	}
	bAppend(h, TBE{sym: s, side: side, tk: k, strict: strict, tv: v})
}

func kill(s u32, h u32) {
	if s == 0 {
		return
	}
	lbDel(h, s)
	bDel(h, s)
}

// join intersects the facts of two states (a dead side yields the other).
func join(a u32, b u32) u32 {
	if tst[usize(a)].dead {
		return b
	}
	if tst[usize(b)].dead {
		return a
	}
	n := newState()
	if n == 0 {
		return a
	}
	tst[usize(n)].shrunk = tst[usize(a)].shrunk && tst[usize(b)].shrunk
	tst[usize(n)].dec = tst[usize(a)].dec && tst[usize(b)].dec
	as := usize(tst[usize(a)].lbS)
	an := usize(tst[usize(a)].lbN)
	for i := usize(0); i < an; i++ {
		j, ok := lbFind(b, lbSym[as+i])
		if ok {
			v := lbVal[as+i]
			if lbVal[j] < v {
				v = lbVal[j]
			}
			lbPut(n, lbSym[as+i], v)
		}
	}
	abs := usize(tst[usize(a)].bS)
	abn := usize(tst[usize(a)].bN)
	bbs := usize(tst[usize(b)].bS)
	bbn := usize(tst[usize(b)].bN)
	for i := usize(0); i < abn; i++ {
		e := bents[abs+i]
		if e.side != SideAny || !bHas(b, e.sym) {
			continue
		}
		bAppend(n, e)
		for x := usize(0); x < abn; x++ {
			ex := bents[abs+x]
			if ex.sym != e.sym || ex.side == SideAny {
				continue
			}
			for y := usize(0); y < bbn; y++ {
				ey := bents[bbs+y]
				if ey.sym == e.sym && ey.side == ex.side && ey.tk == ex.tk && ey.tv == ex.tv {
					bAppend(n, TBE{sym: e.sym, side: ex.side, tk: ex.tk, strict: ex.strict && ey.strict, tv: ex.tv})
				}
			}
		}
	}
	return n
}

// ---------------------------------------------------------------------------
// Bounds values on bstk

func bpush(k u8, v u64, strict bool) {
	if nbstk >= TotMaxBS {
		setFull("totality bounds")
		return
	}
	bstk[nbstk] = TBound{tk: k, strict: strict, tv: v}
	nbstk++
}

func emptyBnds() Bnds {
	return Bnds{s: u32(nbstk), lo: 0, hi: 0}
}

func exactBnds(k u8, v u64) Bnds {
	r := Bnds{s: u32(nbstk), lo: 1, hi: 1}
	bpush(k, v, false)
	bpush(k, v, false)
	return r
}

// settle moves b down to the stack position mark and drops everything
// above it.
func settle(mark usize, b Bnds) Bnds {
	n := usize(b.lo) + usize(b.hi)
	s := usize(b.s)
	if s != mark {
		for i := usize(0); i < n; i++ {
			bstk[mark+i] = bstk[s+i]
		}
	}
	nbstk = mark + n
	return Bnds{s: u32(mark), lo: b.lo, hi: b.hi}
}

// plus1: if x < t then x+1 <= t (no overflow); lower bounds become strict.
func plus1(b Bnds) Bnds {
	s := usize(b.s)
	nl := usize(b.lo)
	nh := usize(b.hi)
	cnt := u32(0)
	for i := usize(0); i < nh; i++ {
		if bstk[s+nl+i].strict {
			cnt++
		}
	}
	if cnt == 0 {
		return emptyBnds()
	}
	r := Bnds{s: u32(nbstk), lo: b.lo, hi: cnt}
	for i := usize(0); i < nl; i++ {
		x := bstk[s+i]
		bpush(x.tk, x.tv, true)
	}
	for i := usize(0); i < nh; i++ {
		x := bstk[s+nl+i]
		if x.strict {
			bpush(x.tk, x.tv, false)
		}
	}
	return r
}

// minus1: if x > t then x-1 >= t (no underflow); upper bounds become strict.
func minus1(b Bnds) Bnds {
	s := usize(b.s)
	nl := usize(b.lo)
	nh := usize(b.hi)
	cnt := u32(0)
	for i := usize(0); i < nl; i++ {
		if bstk[s+i].strict {
			cnt++
		}
	}
	if cnt == 0 {
		return emptyBnds()
	}
	r := Bnds{s: u32(nbstk), lo: cnt, hi: b.hi}
	for i := usize(0); i < nl; i++ {
		x := bstk[s+i]
		if x.strict {
			bpush(x.tk, x.tv, false)
		}
	}
	for i := usize(0); i < nh; i++ {
		x := bstk[s+nl+i]
		bpush(x.tk, x.tv, true)
	}
	return r
}

// less reports whether x < y (strict) or x <= y is implied by the bounds.
func less(x Bnds, y Bnds, strict bool) bool {
	xh := usize(x.s) + usize(x.lo)
	nh := usize(x.hi)
	ys := usize(y.s)
	nl := usize(y.lo)
	for i := usize(0); i < nh; i++ {
		a := bstk[xh+i]
		for j := usize(0); j < nl; j++ {
			b := bstk[ys+j]
			if a.tk == b.tk && a.tv == b.tv && (!strict || a.strict || b.strict) {
				return true
			}
		}
	}
	return false
}

// eb computes bounds of e relative to the iteration-start terms.
func eb(e0 u32, st u32, dp usize) Bnds decreases(dp) {
	if dp == 0 {
		tooDeep()
		return emptyBnds()
	}
	mark := nbstk
	e := stripConv(e0)
	if e == 0 {
		return emptyBnds()
	}
	n, isC := constUint(e)
	if isC {
		return exactBnds(TermConst, n)
	}
	a := lenArg(e)
	if a != 0 {
		s := varOf(a)
		if s != 0 && wMode == WalkMode.T3 && t3LenOK[usize(s)] {
			return exactBnds(TermLen, u64(s))
		}
		return emptyBnds()
	}
	k := nkind(e)
	if k == NkIdent {
		s := varOf(e)
		if s != 0 {
			return bGet(st, s)
		}
	} else if k == NkBinaryExpr {
		op := nop(e)
		if op == OpAdd {
			if isConstVal(nb(e), 1) {
				return settle(mark, plus1(eb(na(e), st, dp-1)))
			}
			if isConstVal(na(e), 1) {
				return settle(mark, plus1(eb(nb(e), st, dp-1)))
			}
			r, ok := midpoint(na(e), nb(e), st, dp-1)
			if ok {
				return r
			}
			r2, ok2 := midpoint(nb(e), na(e), st, dp-1)
			if ok2 {
				return r2
			}
		} else if op == OpSub {
			if isConstVal(nb(e), 1) {
				return settle(mark, minus1(eb(na(e), st, dp-1)))
			}
		}
	}
	return emptyBnds()
}

// midpoint recognizes a + (b - a) / k (k >= 2) and a + ((b - a) >> k)
// (k >= 1): given a < b, the result r satisfies a <= r < b.
func midpoint(a u32, q u32, st u32, dp usize) (Bnds, bool) decreases(dp) {
	if dp == 0 {
		tooDeep()
		return emptyBnds(), false
	}
	qb := unparen(q)
	if qb == 0 || nkind(qb) != NkBinaryExpr {
		return emptyBnds(), false
	}
	k, ok := constUint(nb(qb))
	if !ok || !(nop(qb) == OpDiv && k >= 2 || nop(qb) == OpShr && k >= 1) {
		return emptyBnds(), false
	}
	d := unparen(na(qb))
	if d == 0 || nkind(d) != NkBinaryExpr || nop(d) != OpSub {
		return emptyBnds(), false
	}
	sa := varOf(stripConv(a))
	sa2 := varOf(stripConv(nb(d)))
	if sa == 0 || sa != sa2 {
		return emptyBnds(), false
	}
	mark := nbstk
	ba := eb(a, st, dp-1)
	bb := eb(na(d), st, dp-1)
	if !less(ba, bb, true) {
		nbstk = mark
		return emptyBnds(), false
	}
	r := Bnds{s: u32(nbstk), lo: ba.lo, hi: bb.hi}
	nl := usize(ba.lo)
	for i := usize(0); i < nl; i++ {
		x := bstk[usize(ba.s)+i]
		bpush(x.tk, x.tv, x.strict)
	}
	nh := usize(bb.hi)
	for i := usize(0); i < nh; i++ {
		x := bstk[usize(bb.s)+usize(bb.lo)+i]
		bpush(x.tk, x.tv, true)
	}
	return settle(mark, r), true
}

// ---------------------------------------------------------------------------
// Conditions

// wCond adds the facts implied by e evaluating to truth.
func wCond(e u32, truth bool, st u32, dp usize) decreases(dp) {
	if dp == 0 {
		tooDeep()
		return
	}
	x := unparen(e)
	if x == 0 {
		return
	}
	k := nkind(x)
	if k == NkUnaryExpr {
		if nop(x) == OpNot {
			wCond(na(x), !truth, st, dp-1)
		}
	} else if k == NkBinaryExpr {
		op := nop(x)
		if op == OpLAnd && truth || op == OpLOr && !truth {
			wCond(na(x), truth, st, dp-1)
			wCond(nb(x), truth, st, dp-1)
		} else if isCompareOp(op) {
			o := op
			if !truth {
				o = negateOp(op)
			}
			lbFact(na(x), o, nb(x), st)
			lbFact(nb(x), flipOp(o), na(x), st)
			if wTrack {
				bndFact(na(x), o, nb(x), st, dp-1)
			}
		}
	}
}

// lbFact records `v op c` for a stable integer variable v and constant c.
func lbFact(v u32, op u8, c u32, st u32) {
	s := varOf(v)
	if s == 0 || unstable(s) || !isInteger(symTyp(s)) {
		return
	}
	k, ok := constUint(c)
	if !ok {
		return
	}
	lb := u64(0)
	if op == OpGt {
		if k == U64Max {
			return
		}
		lb = k + 1
	} else if op == OpGe || op == OpEq {
		lb = k
	} else if op == OpNe {
		if k == 0 && isUnsigned(symTyp(s)) {
			lb = 1
		}
	}
	if lb > lbGet(st, s) {
		lbPut(st, s, lb)
	}
}

func bndFact(x u32, op u8, y u32, st u32, dp usize) decreases(dp) {
	if dp == 0 {
		tooDeep()
		return
	}
	if op == OpLt {
		addLess(x, y, true, st, dp-1)
	} else if op == OpLe {
		addLess(x, y, false, st, dp-1)
	} else if op == OpGt {
		addLess(y, x, true, st, dp-1)
	} else if op == OpGe {
		addLess(y, x, false, st, dp-1)
	} else if op == OpEq {
		addLess(x, y, false, st, dp-1)
		addLess(y, x, false, st, dp-1)
	} else if op == OpNe {
		if isZeroConst(y) && exprUnsigned(x) {
			addLess(y, x, true, st, dp-1)
		} else if isZeroConst(x) && exprUnsigned(y) {
			addLess(x, y, true, st, dp-1)
		}
	}
}

// addLess records x < y (strict) or x <= y.
func addLess(x u32, y u32, strict bool, st u32, dp usize) decreases(dp) {
	if dp == 0 {
		tooDeep()
		return
	}
	mark := nbstk
	bx := eb(x, st, dp-1)
	by := eb(y, st, dp-1)
	s := varOf(x)
	if s != 0 && bHas(st, s) {
		n := usize(by.hi)
		b0 := usize(by.s) + usize(by.lo)
		for i := usize(0); i < n; i++ {
			t := bstk[b0+i]
			bAdd(st, s, SideHi, t.tk, t.tv, strict || t.strict)
		}
	}
	s2 := varOf(y)
	if s2 != 0 && bHas(st, s2) {
		n := usize(bx.lo)
		b0 := usize(bx.s)
		for i := usize(0); i < n; i++ {
			t := bstk[b0+i]
			bAdd(st, s2, SideLo, t.tk, t.tv, strict || t.strict)
		}
	}
	nbstk = mark
}

// ---------------------------------------------------------------------------
// The walker

func isExprKind(k u8) bool {
	return k >= NkIdent && k <= NkStructLit || k == NkTypeExpr || k == NkMatchExpr || k == NkTupleExpr || k == NkIsExpr
}

func asgPush(n u32) {
	if nasg >= TotMaxAsg {
		setFull("totality assignments")
		return
	}
	asg[nasg] = n
	asgHave[nasg] = false
	nasg++
}

func twStmt(s u32, st0 u32, dp usize) u32 decreases(dp) {
	if dp == 0 {
		tooDeep()
		return st0
	}
	st := st0
	if s == 0 || tst[usize(st)].dead {
		return st
	}
	k := nkind(s)
	if k == NkBlockStmt {
		n := l1len(s)
		for i := usize(0); i < n; i++ {
			st = twStmt(l1at(s, i), st, dp-1)
		}
		return st
	}
	if k == NkExprStmt {
		twExpr(na(s), st, dp-1)
		if isPanicCall(na(s)) {
			tst[usize(st)].dead = true
		}
		return st
	}
	if k == NkShortVarDecl {
		nv := l2len(s)
		for i := usize(0); i < nv; i++ {
			twExpr(l2at(s, i), st, dp-1)
		}
		mark := nasg
		nl := l1len(s)
		for i := usize(0); i < nl; i++ {
			asgPush(l1at(s, i))
		}
		for i := usize(0); i < nv; i++ {
			asgPush(l2at(s, i))
		}
		r := twAssign(mark, nl, nv, AsgAssign, st, dp-1)
		nasg = mark
		return r
	}
	if k == NkDeclStmt {
		d := na(s)
		if d != 0 && nkind(d) == NkVarDecl {
			mark := nasg
			asgPush(na(d))
			nv := usize(0)
			if nc(d) != 0 {
				twExpr(nc(d), st, dp-1)
				asgPush(nc(d))
				nv = 1
			}
			r := twAssign(mark, 1, nv, AsgAssign, st, dp-1)
			nasg = mark
			return r
		}
		return st
	}
	if k == NkAssignStmt {
		nr := l2len(s)
		for i := usize(0); i < nr; i++ {
			twExpr(l2at(s, i), st, dp-1)
		}
		nl := l1len(s)
		for i := usize(0); i < nl; i++ {
			wLhsExpr(l1at(s, i), st, dp-1)
		}
		mark := nasg
		for i := usize(0); i < nl; i++ {
			asgPush(l1at(s, i))
		}
		for i := usize(0); i < nr; i++ {
			asgPush(l2at(s, i))
		}
		r := twAssign(mark, nl, nr, nop(s), st, dp-1)
		nasg = mark
		return r
	}
	if k == NkIncDecStmt {
		wLhsExpr(na(s), st, dp-1)
		op := u8(AsgAdd)
		if !nflag(s) {
			op = AsgSub
		}
		mark := nasg
		asgPush(na(s))
		asgPush(0)
		r := twAssign(mark, 1, 1, op, st, dp-1)
		nasg = mark
		return r
	}
	if k == NkIfStmt {
		st = twStmt(na(s), st, dp-1)
		if tst[usize(st)].dead {
			return st
		}
		c := nb(s)
		twExpr(c, st, dp-1)
		th := cloneState(st)
		wCond(c, true, th, dp-1)
		th = twStmt(nc(s), th, dp-1)
		el := cloneState(st)
		wCond(c, false, el, dp-1)
		if nd(s) != 0 {
			el = twStmt(nd(s), el, dp-1)
		}
		return join(th, el)
	}
	if k == NkForStmt {
		return wNestedLoop(s, st, dp-1)
	}
	if k == NkMatchStmt {
		twExpr(na(s), st, dp-1)
		out := u32(0)
		n := l1len(s)
		for i := usize(0); i < n; i++ {
			arm := l1at(s, i)
			a := cloneState(st)
			killPattern(na(arm), a, SemaDepth)
			twExpr(nd(arm), a, dp-1)
			if nb(arm) != 0 {
				twExpr(nb(arm), a, dp-1)
				if isPanicCall(nb(arm)) {
					tst[usize(a)].dead = true
				}
			}
			if nc(arm) != 0 {
				a = twStmt(nc(arm), a, dp-1)
			}
			if out == 0 {
				out = a
			} else {
				out = join(out, a)
			}
		}
		if out == 0 {
			return st
		}
		if !matchExhaustive(s) {
			out = join(out, st)
		}
		return out
	}
	if k == NkScopeStmt {
		twExpr(nb(s), st, dp-1)
		kill(symbolOf(na(s)), st)
		return twStmt(nc(s), st, dp-1)
	}
	if k == NkDeferStmt {
		twExpr(na(s), st, dp-1)
		return st
	}
	if k == NkReturnStmt {
		n := l1len(s)
		for i := usize(0); i < n; i++ {
			twExpr(l1at(s, i), st, dp-1)
		}
		tst[usize(st)].dead = true
		return st
	}
	if k == NkBreakStmt {
		tst[usize(st)].dead = true
		return st
	}
	if k == NkContinueStmt {
		if twDepth == 0 {
			onExit(st, dp-1)
		}
		tst[usize(st)].dead = true
		return st
	}
	return st
}

// killPattern forgets the facts about the bindings of a pattern (v0.2:
// nested, or- and tuple patterns; `is` expressions).
func killPattern(p u32, st u32, depth usize) decreases(depth) {
	if depth == 0 || p == 0 {
		return
	}
	k := nkind(p)
	if k == NkIdent {
		kill(symbolOf(p), st)
	} else if k == NkCtorPattern || k == NkOrPattern || k == NkTuplePattern {
		n := l1len(p)
		for i := usize(0); i < n; i++ {
			killPattern(l1at(p, i), st, depth-1)
		}
	}
}

// matchExhaustive reports whether a match statement covers all cases
// (v0.2: recorded by the type checker, nexh).
func matchExhaustive(m u32) bool {
	return nexh[usize(m)]
}

// wNestedLoop analyses a loop inside the analysed body: facts about the
// variables it writes are removed, and its exit state is its entry state
// (the body may run zero times).
func wNestedLoop(f u32, st0 u32, dp usize) u32 decreases(dp) {
	if dp == 0 {
		tooDeep()
		return st0
	}
	st := twStmt(na(f), st0, dp-1)
	if tst[usize(st)].dead {
		return st
	}
	killWrites(ne(f), st)
	killWrites(nc(f), st)
	if wMode == WalkMode.T3 {
		decWrites(ne(f), st, dp-1)
		decWrites(nc(f), st, dp-1)
	}
	c := nb(f)
	if c != 0 {
		twExpr(c, st, dp-1)
	}
	body := cloneState(st)
	if c != 0 {
		wCond(c, true, body, dp-1)
	}
	twDepth++
	_ = twStmt(ne(f), body, dp-1)
	_ = twStmt(nc(f), cloneState(st), dp-1)
	twDepth--
	return st
}

// killWrites kills the facts of every storage written in the subtree of n
// (function literals included).
func killWrites(n u32, st u32) {
	if n == 0 {
		return
	}
	s := usize(tpos[usize(n)])
	e := usize(tend[usize(n)])
	for p := s; p < e; p++ {
		x := tord[p]
		k := nkind(x)
		if k == NkAssignStmt || k == NkShortVarDecl {
			m := l1len(x)
			for i := usize(0); i < m; i++ {
				kill(storageRoot(l1at(x, i)), st)
			}
		} else if k == NkIncDecStmt {
			kill(storageRoot(na(x)), st)
		}
	}
}

// decWrites is the T3 onAssign(l, nil, st, st) of every write in the
// subtree of n.
func decWrites(n u32, st u32, dp usize) decreases(dp) {
	if dp == 0 {
		tooDeep()
		return
	}
	if n == 0 {
		return
	}
	s := usize(tpos[usize(n)])
	e := usize(tend[usize(n)])
	for p := s; p < e; p++ {
		x := tord[p]
		k := nkind(x)
		if k == NkAssignStmt || k == NkShortVarDecl {
			m := l1len(x)
			for i := usize(0); i < m; i++ {
				onAssign(l1at(x, i), 0, st, st, dp-1)
			}
		} else if k == NkIncDecStmt {
			onAssign(na(x), 0, st, st, dp-1)
		}
	}
}

// twExpr reports the calls in e (not inside function literals), refining
// the state across && and ||.
func twExpr(e u32, st u32, dp usize) decreases(dp) {
	if dp == 0 {
		tooDeep()
		return
	}
	if e == 0 {
		return
	}
	k := nkind(e)
	if k == NkFuncLit {
		return
	}
	if k == NkMatchExpr {
		// v0.2: the arms are branches; the payload bindings are fresh.
		twExpr(na(e), st, dp-1)
		n := l1len(e)
		for i := usize(0); i < n; i++ {
			arm := l1at(e, i)
			a := cloneState(st)
			killPattern(na(arm), a, SemaDepth)
			twExpr(nd(arm), a, dp-1)
			twExpr(nb(arm), a, dp-1)
		}
		return
	}
	if k == NkIsExpr {
		twExpr(na(e), st, dp-1)
		killPattern(nb(e), st, SemaDepth)
		return
	}
	if k == NkBinaryExpr && (nop(e) == OpLAnd || nop(e) == OpLOr) {
		twExpr(na(e), st, dp-1)
		r := cloneState(st)
		wCond(na(e), nop(e) == OpLAnd, r, dp-1)
		twExpr(nb(e), r, dp-1)
		return
	}
	for i := usize(0); i < MaxSlots; i++ {
		slot, _ := layout(k, i)
		if slot == SlotNone {
			break
		}
		if slot >= SlotL1 {
			ls, cnt := slotList(nodes.items[usize(e)], slot)
			m := usize(cnt)
			for j := usize(0); j < m; j++ {
				wExprChild(listAt(ls, j), st, dp-1)
			}
		} else {
			wExprChild(slotChild(nodes.items[usize(e)], slot), st, dp-1)
		}
	}
	if k == NkCallExpr && wMode == WalkMode.Rec {
		recOnCall(e, st)
	}
}

func wExprChild(c u32, st u32, dp usize) decreases(dp) {
	if dp == 0 {
		tooDeep()
		return
	}
	if c == 0 {
		return
	}
	k := nkind(c)
	if isExprKind(k) {
		twExpr(c, st, dp-1)
	} else if k == NkFieldInit {
		twExpr(nb(c), st, dp-1)
	}
}

// wLhsExpr reports calls inside an assignment target (index expressions).
func wLhsExpr(e u32, st u32, dp usize) decreases(dp) {
	if dp == 0 {
		tooDeep()
		return
	}
	u := unparen(e)
	if u != 0 && nkind(u) == NkIdent {
		return
	}
	twExpr(e, st, dp-1)
}

// twAssign applies `lhs op= rhs` with lhs = asg[mark:mark+nl] and
// rhs = asg[mark+nl:mark+nl+nr] (an rhs node is 0 for ++/--; nr < nl for
// multi-value calls).
func twAssign(mark usize, nl usize, nr usize, op u8, st u32, dp usize) u32 decreases(dp) {
	if dp == 0 {
		tooDeep()
		return st
	}
	pre := st
	if wMode != WalkMode.Rec {
		pre = cloneState(st)
	}
	bmark := nbstk
	for i := usize(0); i < nl; i++ {
		l := asg[mark+i]
		s := varOf(l)
		if s == 0 || !wTrack || unstable(s) {
			continue
		}
		r := u32(0)
		if nr == nl {
			r = asg[mark+nl+i]
		}
		if op == AsgAssign && r != 0 {
			asgB[mark+i] = eb(r, pre, dp-1)
			asgHave[mark+i] = true
		} else if op == AsgAdd && (r == 0 || isConstVal(r, 1)) {
			m := nbstk
			asgB[mark+i] = settle(m, plus1(eb(l, pre, dp-1)))
			asgHave[mark+i] = true
		} else if op == AsgSub && (r == 0 || isConstVal(r, 1)) {
			m := nbstk
			asgB[mark+i] = settle(m, minus1(eb(l, pre, dp-1)))
			asgHave[mark+i] = true
		}
	}
	for i := usize(0); i < nl; i++ {
		l := asg[mark+i]
		kill(storageRoot(l), st)
		if asgHave[mark+i] && (asgB[mark+i].lo > 0 || asgB[mark+i].hi > 0) {
			bSet(st, varOf(l), asgB[mark+i])
		}
	}
	if wMode != WalkMode.Rec {
		for i := usize(0); i < nl; i++ {
			r := u32(0)
			if op == AsgAssign && nr == nl {
				r = asg[mark+nl+i]
			}
			onAssign(asg[mark+i], r, pre, st, dp-1)
		}
	}
	nbstk = bmark
	return st
}

// ---------------------------------------------------------------------------
// Callbacks

func onAssign(lhs u32, rhs u32, pre u32, post u32, dp usize) decreases(dp) {
	if dp == 0 {
		tooDeep()
		return
	}
	match wMode {
		T2 -> {
			if rhs == 0 || varOf(lhs) != wRem {
				return
			}
			k := shrinkStep(wRem, rhs)
			if k != 0 && positive(k, pre) {
				tst[usize(post)].shrunk = true
			}
		}
		T3 -> {
			s := storageRoot(lhs)
			if s != 0 && t3Trk[usize(s)] {
				tst[usize(post)].dec = proves(post, dp-1)
			}
		}
		Rec -> {}
	}
}

func onExit(st u32, dp usize) decreases(dp) {
	if dp == 0 {
		tooDeep()
		return
	}
	match wMode {
		T2 -> {
			if !tst[usize(st)].shrunk && wWhy == WhyNone {
				wWhy = WhyNotShortened
			}
		}
		T3 -> {
			st2 := twStmt(t3Post, cloneState(st), dp-1)
			if !tst[usize(st2)].dead && !tst[usize(st2)].dec && wWhy == WhyNone {
				wWhy = WhyNoDecrease
			}
		}
		Rec -> {}
	}
}

// positive reports whether k > 0 is proven in st.
func positive(k u32, st u32) bool {
	n, ok := constUint(k)
	if ok {
		return n > 0
	}
	s := varOf(stripConv(k))
	return s != 0 && !unstable(s) && lbGet(st, s) >= 1
}

// ---------------------------------------------------------------------------
// T2 and T3 walks

func walkT2(fi u32, f u32, rem u32) u32 {
	wMode = WalkMode.T2
	wTrack = false
	twDepth = 0
	wWhy = WhyNone
	wRem = rem
	st := newState()
	end := twStmt(ne(f), st, SemaDepth)
	if !tst[usize(end)].dead {
		onExit(end, SemaDepth)
	}
	return wWhy
}

func t3Mark(s u32, lenOK bool) {
	if !t3Trk[usize(s)] && !t3LenOK[usize(s)] {
		if nt3Marked >= MaxSyms {
			setFull("totality marks")
			return
		}
		t3Marked[nt3Marked] = s
		nt3Marked++
	}
	if lenOK {
		t3LenOK[usize(s)] = true
	} else {
		t3Trk[usize(s)] = true
	}
}

func t3Clear() {
	n := nt3Marked
	for i := usize(0); i < n; i++ {
		t3Trk[usize(t3Marked[i])] = false
		t3LenOK[usize(t3Marked[i])] = false
	}
	nt3Marked = 0
}

var t3LeafErr u32
var t3LeafSym u32

func t3Leaf(e u32, fnode u32, f u32) {
	if e == 0 {
		return
	}
	_, isC := constUint(e)
	if isC {
		return
	}
	a := lenArg(e)
	if a != 0 {
		s := varOf(a)
		if s == 0 || !invariant(e, fnode, ne(f), nc(f)) {
			t3LeafErr = WhyLenMeasure
			return
		}
		t3Mark(s, true)
		return
	}
	s := varOf(e)
	if s == 0 {
		t3LeafErr = WhyMeasureForm
		return
	}
	if unstable(s) || syms.items[usize(s)].fn != fnode {
		t3LeafErr = WhyMeasureVar
		t3LeafSym = s
		return
	}
	t3Mark(s, false)
}

// loopT3 accepts `for [init;] C [; post] decreases(M)` where M is X or
// X - Y (see finc0's loops.go t3).
func loopT3(fi u32, f u32) u32 {
	r := loopT3Run(fi, f)
	t3Clear()
	return r
}

func loopT3Run(fi u32, f u32) u32 {
	fnode := fiNode(fi)
	m := stripConv(na(nd(f)))
	xs := m
	ys := u32(0)
	if m != 0 && nkind(m) == NkBinaryExpr && nop(m) == OpSub {
		xs = stripConv(na(m))
		ys = stripConv(nb(m))
	}
	t3LeafErr = WhyNone
	t3LeafSym = 0
	t3Leaf(xs, fnode, f)
	t3Leaf(ys, fnode, f)
	if t3LeafErr != WhyNone {
		totWhySym = t3LeafSym
		return t3LeafErr
	}
	c := nb(f)
	if c != 0 {
		s := usize(tpos[usize(c)])
		e := usize(tend[usize(c)])
		for p := s; p < e; p++ {
			id := tord[p]
			if nkind(id) != NkIdent {
				continue
			}
			v := varOf(id)
			if v != 0 && !unstable(v) && syms.items[usize(v)].fn == fnode && isInteger(symTyp(v)) {
				t3Mark(v, false)
			}
		}
	}
	wMode = WalkMode.T3
	wTrack = true
	twDepth = 0
	wWhy = WhyNone
	t3X = xs
	t3Y = ys
	t3Post = nc(f)
	start := newState()
	nm := nt3Marked
	for i := usize(0); i < nm; i++ {
		s := t3Marked[i]
		if !t3Trk[usize(s)] {
			continue
		}
		mark := nbstk
		unsigned := isUnsigned(symTyp(s))
		b := Bnds{s: u32(nbstk), lo: 1, hi: 1}
		bpush(TermVar, u64(s), false)
		if unsigned {
			bpush(TermConst, 0, false)
			b.lo = 2
		}
		bpush(TermVar, u64(s), false)
		bSet(start, s, b)
		nbstk = mark
	}
	if c != 0 {
		wCond(c, true, start, SemaDepth)
	}
	// lower bound: C implies Y <= X (M = X - Y), or X is unsigned
	if ys != 0 {
		mark := nbstk
		by := eb(ys, start, SemaDepth)
		bx := eb(xs, start, SemaDepth)
		ok := less(by, bx, false)
		nbstk = mark
		if !ok {
			return WhyMeasureNonNeg
		}
	} else if !exprUnsigned(xs) {
		return WhyMeasureUnsign
	}
	end := twStmt(ne(f), cloneState(start), SemaDepth)
	if !tst[usize(end)].dead {
		onExit(end, SemaDepth)
	}
	return wWhy
}

// leafTerm returns the term of a measure leaf.
func leafTerm(e u32) (u8, u64) {
	n, ok := constUint(e)
	if ok {
		return TermConst, n
	}
	a := lenArg(e)
	if a != 0 {
		return TermLen, u64(varOf(a))
	}
	return TermVar, u64(varOf(e))
}

// proves reports whether st shows X' <= X and Y' >= Y with one of them
// strict.
func proves(st u32, dp usize) bool decreases(dp) {
	if dp == 0 {
		tooDeep()
		return false
	}
	strict := false
	if t3X != 0 {
		found, s := leafBound(t3X, true, st, dp-1)
		if !found {
			return false
		}
		strict = strict || s
	}
	if t3Y != 0 {
		found, s := leafBound(t3Y, false, st, dp-1)
		if !found {
			return false
		}
		strict = strict || s
	}
	return strict
}

// leafBound looks for the leaf's own term among its upper (or lower)
// bounds in st and returns whether it was found and its strictness.
func leafBound(e u32, upper bool, st u32, dp usize) (bool, bool) decreases(dp) {
	if dp == 0 {
		tooDeep()
		return false, false
	}
	tk0, tv0 := leafTerm(e)
	mark := nbstk
	b := eb(e, st, dp-1)
	s := usize(b.s)
	n := usize(b.lo)
	if upper {
		s = usize(b.s) + usize(b.lo)
		n = usize(b.hi)
	}
	for i := usize(0); i < n; i++ {
		x := bstk[s+i]
		if x.tk == tk0 && x.tv == tv0 {
			nbstk = mark
			return true, x.strict
		}
	}
	nbstk = mark
	return false, false
}
