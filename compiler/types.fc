package main

// Unified Type System, Symbol Table, Universe Builtins, Call Classifications,
// and x86_64 Memory Layout Calculator.

const (
	MaxPkgs      = 32
	MaxSyms      = 32768
	MaxTypes     = 32768
	MaxFields    = 16384
	MaxVariants  = 8192
	MaxTypeList  = 65536
	MaxMethods   = 4096
	MaxCalls     = 65536
	MaxFmtSpecs  = 4096
	MaxFmtItems  = 16384
	MaxCaptures  = 8192
	MaxEffOps    = 1024
	MaxHandles   = 1024
	MaxDimExprs  = 8192
)

// Fixed pre-allocated Type IDs for basics and builtin resources.
const (
	TYInvalid    u32 = 0
	TYBool       u32 = 1
	TYU8         u32 = 2
	TYU16        u32 = 3
	TYU32        u32 = 4
	TYU64        u32 = 5
	TYUsize      u32 = 6
	TYI8         u32 = 7
	TYI16        u32 = 8
	TYI32        u32 = 9
	TYI64        u32 = 10
	TYInt        u32 = 11
	TYString     u32 = 12
	TYError      u32 = 13
	TYUntypedInt u32 = 14
	TYUntypedBool u32 = 15
	TYUntypedStr   u32 = 16
	TYUntypedNil   u32 = 17
	TYF32          u32 = 18
	TYF64          u32 = 19

	TYNet          u32 = 20
	TYListener     u32 = 21
	TYConn         u32 = 22
	TYSignals      u32 = 23
	TYClock        u32 = 24
	TYContext      u32 = 25
	TYCancelFunc   u32 = 26
	TYScope        u32 = 27
	TYFS           u32 = 28
	TYEnv          u32 = 29
	TYStdio        u32 = 30
	TYExec         u32 = 31
	TYFieldCode    u32 = 32
	TYAny          u32 = 33
	TYSlotOrigin   u32 = 34
	TYExitStatus   u32 = 35
	TYArena        u32 = 36
	TYUntypedFloat u32 = 37
	TYAtomicOrigin u32 = 38
	TYFirstDyn     u32 = 40
)

// Type kinds.
const (
	TKindInvalid   u8 = 0
	TKindBasic     u8 = 1
	TKindBuiltin   u8 = 2
	TKindArray     u8 = 3  // a=elemType, lenVal=arrayLen
	TKindSlice     u8 = 4  // a=elemType
	TKindPtr       u8 = 5  // a=elemType
	TKindStruct    u8 = 6  // a=fieldStart, b=fieldCount
	TKindEnum      u8 = 7  // a=varStart, b=varCount
	TKindSig       u8 = 8  // op=effect, flags: bit0=variadic; a=paramStart, b=paramCount, c=retStart, d=retCount
	TKindNamed     u8 = 9  // flags: bit0=isSlot; a=symID, b=underType, c=targStart, d=targCount, origin=originType
	TKindTypeParam u8 = 10 // flags: bit0=isConst; a=symID, b=constType
	TKindConstArg  u8 = 11 // lenVal=constVal
	TKindCode      u8 = 12 // a=level
	TKindTuple     u8 = 13 // a=typeListStart, b=count
	TKindEffect    u8 = 14 // a=effSym, c=targStart, d=targCount, origin=originEffType
	TKindResume    u8 = 15 // a=opRetType(0=void), b=handleResType(0=void)
)

// Resource classes.
const (
	ClsValue  u8 = 0
	ClsScoped u8 = 1
	ClsLinear u8 = 2
)

