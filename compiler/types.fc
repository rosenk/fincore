type Pkg struct {
	importPathStr u32
	nameStr       u32
	fileStart     u32
	fileCount     u32
	symStart      u32
	symCount      u32
	prefixStr     u32 // "" for root, "_pkg_<name>_" for imported
	state         u8  // 0=unloaded, 1=loading, 2=loaded
}

type Sym struct {
	kind     u8
	flags    u8 // bit0=untypedConst, bit1=checking, bit2=checked, bit3=ptrRecv
	builtin  u16
	nameStr  u32
	pkgID    u32
	fileID   u32
	off      u32
	declNode u32
	typeID   u32
	valID    u32
	extra    u32 // recvTypeSym for SymMethod; tparamStart in typeList for SymFunc/SymType; funcIdx for funcs
	extra2   u32 // tparamCount for SymFunc/SymType; variantIdx etc.
}

type Type struct {
	kind   u8
	op     u8 // effect for TKindSig
	flags  u16
	a      u32
	b      u32
	c      u32
	d      u32
	origin u32
	lenVal u64
}

type Field struct {
	nameStr u32
	typeID  u32
}

type Variant struct {
	nameStr   u32
	payStart  u32 // index in typeList
	payCount  u32
}

type MethodEntry struct {
	recvTypeSym u32 // SymID of origin named type
	nameStr     u32
	funcSym     u32 // SymID of SymMethod
	ptrRecv     bool
}

type CallInfo struct {
	kind       u8
	autoAddr   u8
	builtinID  u16
	calleeSym  u32 // SymFunc / SymMethod
	recvExpr   u32
	recvType   u32
	sigType    u32
	convType   u32
	varType    u32
	varIdx     u32
	targStart  u32 // index in typeList
	targCount  u32
	fmtSpecID  u32 // index in fmtSpecs (for formatTo)
}

// FormatTo parsed directive items.
const (
	FmtLit    u8 = 0
	FmtInt    u8 = 1 // %d signed
	FmtUint   u8 = 2 // %d unsigned
	FmtHex    u8 = 3 // %x unsigned
	FmtHexInt u8 = 4 // %x signed
	FmtStr    u8 = 5 // %s string
	FmtBytes  u8 = 6 // %s []byte
	FmtQuote  u8 = 7 // %q string/[]byte
	FmtChar   u8 = 8 // %c u8
	FmtBool   u8 = 9 // %v bool
	FmtMethod u8 = 10 // %v with Format([]byte) usize method
	FmtFloat  u8 = 11 // %f or %v float (f32/f64)
)

type FmtItem struct {
	kind      u8
	zeroPad   u8
	leftAlign u8
	isBytes   u8 // for FmtQuote
	width     u16
	pad       u16
	argIdx    u32 // index into call args (0..k-1 after dst, fmt)
	litStrID  u32 // for FmtLit
	methSym   u32 // for FmtMethod
	argType   u32 // for FmtMethod
}

type FmtSpec struct {
	itemStart u32
	itemCount u32
}

type EffectOp struct {
	effSym  u32 // SymEffect
	nameStr u32
	sigType u32 // TKindSig (parameterized by effSym's type params)
	opIdx   u32 // 0-based index within effect
}

type HandleInfo struct {
	effType      u32  // instantiated TKindEffect
	evLocalSym   u32  // SymLocal holding evidence pointer inside handled body
	resType      u32  // result type of handle expr (0 = void)
	isTailResump bool // true => Tier 1 direct call fast path; false => Tier 2/3 effect.s
	isExpr       bool
}

// Global semantic arenas.
var pkgs [MaxPkgs]Pkg
var pkgCount u32
var pkgFiles [MaxFiles]u32 // fileIDs grouped by package
var pkgFileCount u32
var pkgOrder [MaxPkgs]u32 // topological order (root last)
var pkgOrderCount u32
var rootPkgID u32

var syms [MaxSyms]Sym
var symCount u32
var pkgSyms [MaxSyms]u32
var pkgSymCount u32

var types [MaxTypes]Type
var typeCount u32
var fields [MaxFields]Field
var fieldCount u32
var variants [MaxVariants]Variant
var variantCount u32
var typeList [MaxTypeList]u32
var typeListUsed u32

var methods [MaxMethods]MethodEntry
var methodCount u32

var calls [MaxCalls]CallInfo
var callCount u32
var fmtSpecs [MaxFmtSpecs]FmtSpec
var fmtSpecCount u32
var fmtItems [MaxFmtItems]FmtItem
var fmtItemCount u32

// Per-AST-node side tables.
var nodeSym [MaxNodes]u32
var nodeType [MaxNodes]u32
var nodeVal [MaxNodes]u32
var nodeCall [MaxNodes]u32
var nodeFlags [MaxNodes]u16
var nodeSelIdx [MaxNodes]u32 // field index or variant index for NKSelector / NKPatCtor
var nodeInstStart [MaxNodes]u32 // typeList start for generic func/type inst
var nodeInstCount [MaxNodes]u32

// Per-function-literal capture list (indexed via litCapStart[litNode], litCapCount[litNode]).
var litCapStart [MaxNodes]u32
var litCapCount [MaxNodes]u32
var capPool [MaxCaptures]u32
var capPoolUsed u32

// Algebraic effects & delimited continuation side tables (v0.3).
var effOps [MaxEffOps]EffectOp
var effOpCount u32
var symEffOpStart [MaxSyms]u32
var symEffOpCount [MaxSyms]u32
var sigTypeEffStart [MaxTypes]u32 // typeList start of `with E1, E2` on TKindSig
var sigTypeEffCount [MaxTypes]u32
var fnEvStart [MaxNodes]u32 // capPool/callEvSyms start of hidden evidence SymParams on NKFuncDecl
var fnEvCount [MaxNodes]u32
var callEvStart [MaxCalls]u32 // callEvSyms start of lexical evidence local syms passed at CKFunc/CKMethod
var callEvCount [MaxCalls]u32
var callEvSyms [MaxCaptures]u32
var callEvSymUsed u32
var handles [MaxHandles]HandleInfo
var handleCount u32
var nodeHandle [MaxNodes]u32    // index into handles (1-based)
var handleArmOpIdx [MaxNodes]u32 // resolved 0-based opIdx for NKHandleArm
var handleArmResumeSym [MaxNodes]u32 // SymLocal of `resume` inside NKHandleArm

// Symbolic array dimension expressions (QTT 0-multiplicity, FinCore v0.4).
const (
	DimConst u8 = 0
	DimParam u8 = 1 // a = TypeParam symID
	DimAdd   u8 = 2 // a = lhs DimID, b = rhs DimID (canonicalized)
	DimSub   u8 = 3 // a = lhs DimID, b = rhs DimID
	DimMul   u8 = 4 // a = lhs DimID, b = rhs DimID (canonicalized)
)

type DimExpr struct {
	kind u8
	pad  u8
	pad2 u16
	a    u32
	b    u32
	val  u64
}

var dimExprs [MaxDimExprs]DimExpr
var dimExprCount u32

// Main function symbol (set by checker).
var mainFuncSym u32

// Universe pre-interned method/builtin StrIDs.
var strFormat u32

func typesInit() {
	pkgCount = 0
	pkgFileCount = 0
	pkgOrderCount = 0
	rootPkgID = 0
	symCount = 1 // 0 = none
	pkgSymCount = 0
	typeCount = TYFirstDyn
	fieldCount = 0
	variantCount = 0
	typeListUsed = 0
	methodCount = 0
	callCount = 1 // 0 = none
	fmtSpecCount = 1
	fmtItemCount = 0
	capPoolUsed = 0
	effOpCount = 0
	callEvSymUsed = 0
	handleCount = 1 // 0 = none
	dimExprCount = 1 // 0 = constant (uses Type.lenVal)
	mainFuncSym = 0

	for i := u32(0); i < TYFirstDyn; i++ {
		types[i] = Type{}
	}
	for i := u32(1); i <= TYF64; i++ {
		types[i] = Type{kind: TKindBasic, a: i}
	}
	for i := TYNet; i <= TYSlotOrigin; i++ {
		types[i] = Type{kind: TKindBuiltin, a: i}
	}
	types[TYArena] = Type{kind: TKindBuiltin, a: TYArena}
	types[TYUntypedFloat] = Type{kind: TKindBasic, a: TYUntypedFloat}
	types[TYAtomicOrigin] = Type{kind: TKindBuiltin, a: TYAtomicOrigin}
	// CancelFunc is a linear func()
	types[TYCancelFunc] = Type{kind: TKindBuiltin, a: TYCancelFunc}
	// ExitStatus is struct { Code int }
	fs := fieldCount
	fields[fs] = Field{nameStr: internStr("Code"), typeID: TYInt}
	fieldCount++
	types[TYExitStatus] = Type{kind: TKindStruct, a: fs, b: 1}
	strFormat = internStr("Format")
}

func newType(t Type) u32 {
	if typeCount >= MaxTypes {
		return TYInvalid
	}
	id := typeCount
	typeCount++
	types[id] = t
	sigTypeEffStart[id] = 0
	sigTypeEffCount[id] = 0
	return id
}

func pushEvSyms(items []u32) (u32, u32) {
	n := len(items)
	if n == 0 {
		return 0, 0
	}
	if usize(callEvSymUsed)+n > MaxCaptures {
		return 0, 0
	}
	start := callEvSymUsed
	for i := usize(0); i < n; i++ {
		callEvSyms[usize(start)+i] = items[i]
	}
	callEvSymUsed += u32(n)
	return start, u32(n)
}

func pushTypeList(items []u32) (u32, u32) {
	n := len(items)
	if n == 0 {
		return 0, 0
	}
	if usize(typeListUsed)+n > MaxTypeList {
		return 0, 0
	}
	start := typeListUsed
	for i := usize(0); i < n; i++ {
		typeList[usize(start)+i] = items[i]
	}
	typeListUsed += u32(n)
	return start, u32(n)
}

func makeSliceType(elem u32) u32 {
	return newType(Type{kind: TKindSlice, a: elem})
}

func makeConstSliceType(elem u32) u32 {
	return newType(Type{kind: TKindSlice, flags: 1, a: elem})
}

func makePtrType(elem u32) u32 {
	return newType(Type{kind: TKindPtr, a: elem})
}

func makeConstPtrType(elem u32) u32 {
	return newType(Type{kind: TKindPtr, flags: 1, a: elem})
}

func isConstView(ty u32) bool {
	u := under(ty)
	return (types[u].kind == TKindSlice || types[u].kind == TKindPtr) && types[u].flags != 0
}

func newDimExpr(d DimExpr) u32 {
	if dimExprCount >= MaxDimExprs {
		return 0
	}
	id := dimExprCount
	dimExprCount++
	dimExprs[id] = d
	return id
}

func makeDimConst(v u64) u32 {
	return newDimExpr(DimExpr{kind: DimConst, val: v})
}

func makeDimParam(symID u32) u32 {
	return newDimExpr(DimExpr{kind: DimParam, a: symID})
}

driver func dimCmp(a u32, b u32) i32 {
	if a == b {
		return 0
	}
	da := dimExprs[a]
	db := dimExprs[b]
	if da.kind != db.kind {
		if da.kind < db.kind {
			return -1
		}
		return 1
	}
	if da.kind == DimConst {
		if da.val < db.val {
			return -1
		}
		if da.val > db.val {
			return 1
		}
		return 0
	}
	if da.kind == DimParam {
		if da.a < db.a {
			return -1
		}
		if da.a > db.a {
			return 1
		}
		return 0
	}
	c := dimCmp(da.a, db.a)
	if c != 0 {
		return c
	}
	return dimCmp(da.b, db.b)
}

driver func makeDimAdd(l u32, r u32) u32 {
	dl := dimExprs[l]
	dr := dimExprs[r]
	if dl.kind == DimConst && dr.kind == DimConst {
		return makeDimConst(dl.val + dr.val)
	}
	if dl.kind == DimConst && dl.val == 0 {
		return r
	}
	if dr.kind == DimConst && dr.val == 0 {
		return l
	}
	// Flatten (x + c1) + c2 -> x + (c1 + c2)
	if dl.kind == DimAdd && dimExprs[dl.b].kind == DimConst && dr.kind == DimConst {
		return makeDimAdd(dl.a, makeDimConst(dimExprs[dl.b].val+dr.val))
	}
	if dr.kind == DimAdd && dimExprs[dr.b].kind == DimConst && dl.kind == DimConst {
		return makeDimAdd(dr.a, makeDimConst(dimExprs[dr.b].val+dl.val))
	}
	// Canonicalize commutative order so m + n == n + m!
	if dimCmp(l, r) > 0 {
		tmp := l
		l = r
		r = tmp
	}
	return newDimExpr(DimExpr{kind: DimAdd, a: l, b: r})
}

driver func makeDimSub(l u32, r u32) u32 {
	dl := dimExprs[l]
	dr := dimExprs[r]
	if dl.kind == DimConst && dr.kind == DimConst {
		if dl.val >= dr.val {
			return makeDimConst(dl.val - dr.val)
		}
		return makeDimConst(0)
	}
	if dr.kind == DimConst && dr.val == 0 {
		return l
	}
	if dimCmp(l, r) == 0 {
		return makeDimConst(0)
	}
	return newDimExpr(DimExpr{kind: DimSub, a: l, b: r})
}

driver func makeDimMul(l u32, r u32) u32 {
	dl := dimExprs[l]
	dr := dimExprs[r]
	if dl.kind == DimConst && dr.kind == DimConst {
		return makeDimConst(dl.val * dr.val)
	}
	if (dl.kind == DimConst && dl.val == 0) || (dr.kind == DimConst && dr.val == 0) {
		return makeDimConst(0)
	}
	if dl.kind == DimConst && dl.val == 1 {
		return r
	}
	if dr.kind == DimConst && dr.val == 1 {
		return l
	}
	if dimCmp(l, r) > 0 {
		tmp := l
		l = r
		r = tmp
	}
	return newDimExpr(DimExpr{kind: DimMul, a: l, b: r})
}

driver func dimEqual(d1 u32, len1 u64, d2 u32, len2 u64) bool {
	if d1 == 0 && d2 == 0 {
		return len1 == len2
	}
	if d1 == 0 {
		return dimExprs[d2].kind == DimConst && dimExprs[d2].val == len1
	}
	if d2 == 0 {
		return dimExprs[d1].kind == DimConst && dimExprs[d1].val == len2
	}
	return dimCmp(d1, d2) == 0
}

driver func substDim(d u32, tpSyms []u32, targs []u32) (u32, u64) {
	if d == 0 {
		return 0, 0
	}
	de := dimExprs[d]
	if de.kind == DimConst {
		return 0, de.val
	}
	if de.kind == DimParam {
		for i := usize(0); i < len(tpSyms); i++ {
			if de.a == tpSyms[i] {
				if types[targs[i]].kind == TKindConstArg {
					if types[targs[i]].a != 0 {
						return types[targs[i]].a, 0
					}
					return 0, types[targs[i]].lenVal
				}
				if types[targs[i]].kind == TKindTypeParam {
					return makeDimParam(types[targs[i]].a), 0
				}
				return 0, 0
			}
		}
		return d, 0
	}
	ld, lv := substDim(de.a, tpSyms, targs)
	rd, rv := substDim(de.b, tpSyms, targs)
	if ld == 0 && rd == 0 {
		if de.kind == DimAdd {
			return 0, lv + rv
		}
		if de.kind == DimSub {
			if lv >= rv {
				return 0, lv - rv
			}
			return 0, 0
		}
		if de.kind == DimMul {
			return 0, lv * rv
		}
	}
	var la u32 = ld
	if la == 0 {
		la = makeDimConst(lv)
	}
	var rb u32 = rd
	if rb == 0 {
		rb = makeDimConst(rv)
	}
	var res u32 = 0
	if de.kind == DimAdd {
		res = makeDimAdd(la, rb)
	} else if de.kind == DimSub {
		res = makeDimSub(la, rb)
	} else {
		res = makeDimMul(la, rb)
	}
	if dimExprs[res].kind == DimConst {
		return 0, dimExprs[res].val
	}
	return res, 0
}

func makeArrayType(elem u32, length u64) u32 {
	return newType(Type{kind: TKindArray, a: elem, lenVal: length})
}

func makeConstArgType(val u64) u32 {
	return newType(Type{kind: TKindConstArg, lenVal: val})
}

func makeSlotType(elem u32) u32 {
	var a [1]u32
	a[0] = elem
	ts, tc := pushTypeList(a[:])
	return newType(Type{kind: TKindNamed, flags: 1, a: 0, b: TYSlotOrigin, c: ts, d: tc, origin: TYSlotOrigin})
}

func makeAtomicType(elem u32) u32 {
	var a [1]u32
	a[0] = elem
	ts, tc := pushTypeList(a[:])
	return newType(Type{kind: TKindNamed, flags: 2, a: 0, b: TYAtomicOrigin, c: ts, d: tc, origin: TYAtomicOrigin})
}

func isAtomicType(ty u32) bool {
	return ty != 0 && types[ty].kind == TKindNamed && types[ty].flags == 2
}

func atomicElemType(ty u32) u32 {
	if isAtomicType(ty) && types[ty].d == 1 {
		return typeList[types[ty].c]
	}
	return TYInvalid
}

func isAtomicSupportedElem(ty u32) bool {
	u := under(ty)
	return u == TYU32 || u == TYU64 || u == TYI32 || u == TYI64 || u == TYUsize || u == TYInt || u == TYBool
}

func makeTupleType(items []u32) u32 {
	ts, tc := pushTypeList(items)
	return newType(Type{kind: TKindTuple, a: ts, b: tc})
}

func under(ty u32) u32 {
	t := ty
	for step := u32(0); step < 64; step++ {
		if t == 0 || t >= typeCount {
			return t
		}
		if types[t].kind == TKindNamed && types[t].flags == 0 && types[t].b != 0 {
			t = types[t].b
			continue
		}
		break
	}
	return t
}

func isIntType(ty u32) bool {
	u := under(ty)
	return u >= TYU8 && u <= TYInt
}

func isUnsignedInt(ty u32) bool {
	u := under(ty)
	return u >= TYU8 && u <= TYUsize
}

func isSignedInt(ty u32) bool {
	u := under(ty)
	return u >= TYI8 && u <= TYInt
}

func isFloatType(ty u32) bool {
	u := under(ty)
	return u == TYF32 || u == TYF64
}

// Shallow static generic constraints (FinCore v0.6 — zero vtables, 100% monomorphized).
// Stored in TKindTypeParam.flags >> 1 (bit 0 = isConst):
//   0 = any, 1 = Equal, 2 = Ordered, 3 = Numeric
const (
	ConstrAny     u16 = 0
	ConstrEqual   u16 = 1
	ConstrOrdered u16 = 2
	ConstrNumeric u16 = 3
)

func tpConstraint(ty u32) u16 {
	if ty == 0 || ty >= typeCount {
		return 0
	}
	if types[ty].kind == TKindTypeParam && (types[ty].flags&1) == 0 {
		return types[ty].flags >> 1
	}
	return 0
}

func constraintFlagsForStr(sid u32) u16 {
	s := strSlice(sid)
	if sliceEq(s, strBytes("Equal")) {
		return ConstrEqual << 1
	}
	if sliceEq(s, strBytes("Ordered")) {
		return ConstrOrdered << 1
	}
	if sliceEq(s, strBytes("Numeric")) {
		return ConstrNumeric << 1
	}
	return 0
}

driver func isEqualType(ty u32) bool {
	if ty == 0 {
		return true
	}
	if types[ty].kind == TKindTypeParam {
		if (types[ty].flags & 1) != 0 {
			return true
		}
		return tpConstraint(ty) >= ConstrEqual
	}
	u := under(ty)
	t := types[u]
	if t.kind == TKindBasic {
		return true
	}
	if t.kind == TKindPtr {
		return true
	}
	if t.kind == TKindArray {
		return isEqualType(t.a)
	}
	if t.kind == TKindStruct {
		for i := u32(0); i < t.b; i++ {
			if !isEqualType(fields[t.a+i].typeID) {
				return false
			}
		}
		return true
	}
	if t.kind == TKindEnum {
		for i := u32(0); i < t.b; i++ {
			v := variants[t.a+i]
			for j := u32(0); j < v.payCount; j++ {
				if !isEqualType(typeList[v.payStart+j]) {
					return false
				}
			}
		}
		return true
	}
	return false
}

func isOrderedType(ty u32) bool {
	if ty == 0 {
		return true
	}
	if types[ty].kind == TKindTypeParam {
		if (types[ty].flags & 1) != 0 {
			return true
		}
		return tpConstraint(ty) >= ConstrOrdered
	}
	return isIntType(ty) || isFloatType(ty) || isStringType(ty)
}

func isNumericConstraintType(ty u32) bool {
	if ty == 0 {
		return true
	}
	if types[ty].kind == TKindTypeParam {
		if (types[ty].flags & 1) != 0 {
			return true
		}
		return tpConstraint(ty) >= ConstrNumeric
	}
	return isIntType(ty) || isFloatType(ty)
}

driver func satisfiesConstraint(ty u32, constr u16) bool {
	if constr == ConstrAny || ty == 0 {
		return true
	}
	if constr == ConstrEqual {
		return isEqualType(ty)
	}
	if constr == ConstrOrdered {
		return isOrderedType(ty)
	}
	if constr == ConstrNumeric {
		return isNumericConstraintType(ty)
	}
	return false
}

func isUntyped(ty u32) bool {
	return (ty >= TYUntypedInt && ty <= TYUntypedNil) || ty == TYUntypedFloat
}

func isNumericOrUntyped(ty u32) bool {
	return isIntType(ty) || isFloatType(ty) || ty == TYUntypedInt || ty == TYUntypedFloat || tpConstraint(ty) == ConstrNumeric
}

func isBoolType(ty u32) bool {
	u := under(ty)
	return u == TYBool || u == TYUntypedBool
}

func isStringType(ty u32) bool {
	u := under(ty)
	return u == TYString || u == TYUntypedStr
}

func isErrorType(ty u32) bool {
	return under(ty) == TYError
}

func isByteSlice(ty u32) bool {
	u := under(ty)
	return types[u].kind == TKindSlice && under(types[u].a) == TYU8
}

func isSlotType(ty u32) bool {
	return ty != 0 && types[ty].kind == TKindNamed && types[ty].flags == 1
}

func slotElemType(ty u32) u32 {
	if isSlotType(ty) && types[ty].d == 1 {
		return typeList[types[ty].c]
	}
	return TYInvalid
}

func isCapabilityType(ty u32) bool {
	return ty == TYNet || ty == TYSignals || ty == TYClock ||
		ty == TYFS || ty == TYEnv || ty == TYStdio || ty == TYExec
}

func defaultType(ty u32) u32 {
	if ty == TYUntypedInt {
		return TYInt
	}
	if ty == TYUntypedFloat {
		return TYF64
	}
	if ty == TYUntypedBool {
		return TYBool
	}
	if ty == TYUntypedStr {
		return TYString
	}
	return ty
}

func typeOriginSym(ty u32) u32 {
	if ty == 0 || ty >= typeCount {
		return 0
	}
	if types[ty].kind == TKindNamed {
		if types[ty].origin != 0 && types[types[ty].origin].kind == TKindNamed {
			return types[types[ty].origin].a
		}
		return types[ty].a
	}
	return 0
}

// typeEqual checks strict FinCore type identity.
driver func typeEqual(a u32, b u32) bool {
	if a == b {
		return true
	}
	if a == 0 || b == 0 || a >= typeCount || b >= typeCount {
		return false
	}
	ta := types[a]
	tb := types[b]
	if ta.kind != tb.kind {
		return false
	}
	if ta.kind == TKindBasic || ta.kind == TKindBuiltin {
		return ta.a == tb.a
	}
	if ta.kind == TKindConstArg {
		return ta.lenVal == tb.lenVal
	}
	if ta.kind == TKindTypeParam {
		return ta.a == tb.a
	}
	if ta.kind == TKindCode {
		return ta.a == tb.a
	}
	if ta.kind == TKindSlice || ta.kind == TKindPtr {
		return ta.flags == tb.flags && typeEqual(ta.a, tb.a)
	}
	if ta.kind == TKindArray {
		return dimEqual(ta.b, ta.lenVal, tb.b, tb.lenVal) && typeEqual(ta.a, tb.a)
	}
	if ta.kind == TKindNamed {
		if ta.flags != tb.flags {
			return false
		}
		if ta.flags == 1 || ta.flags == 2 {
			// Slot[T] or Atomic[T]
			return ta.d == 1 && tb.d == 1 && typeEqual(typeList[ta.c], typeList[tb.c])
		}
		if typeOriginSym(a) != typeOriginSym(b) {
			return false
		}
		if ta.d != tb.d {
			return false
		}
		for i := u32(0); i < ta.d; i++ {
			if !typeEqual(typeList[ta.c+i], typeList[tb.c+i]) {
				return false
			}
		}
		return true
	}
	if ta.kind == TKindSig {
		if ta.op != tb.op || ta.flags != tb.flags || ta.b != tb.b || ta.d != tb.d {
			return false
		}
		for i := u32(0); i < ta.b; i++ {
			if !typeEqual(typeList[ta.a+i], typeList[tb.a+i]) {
				return false
			}
		}
		for i := u32(0); i < ta.d; i++ {
			if !typeEqual(typeList[ta.c+i], typeList[tb.c+i]) {
				return false
			}
		}
		return true
	}
	if ta.kind == TKindStruct {
		if ta.b != tb.b {
			return false
		}
		for i := u32(0); i < ta.b; i++ {
			fa := fields[ta.a+i]
			fb := fields[tb.a+i]
			if fa.nameStr != fb.nameStr || !typeEqual(fa.typeID, fb.typeID) {
				return false
			}
		}
		return true
	}
	if ta.kind == TKindEnum {
		return a == b
	}
	if ta.kind == TKindEffect {
		if ta.a != tb.a || ta.d != tb.d {
			return false
		}
		for i := u32(0); i < ta.d; i++ {
			if !typeEqual(typeList[ta.c+i], typeList[tb.c+i]) {
				return false
			}
		}
		return true
	}
	if ta.kind == TKindResume {
		return typeEqual(ta.a, tb.a) && typeEqual(ta.b, tb.b)
	}
	return false
}

// assignable reports whether a value of type src can be assigned to dst.
driver func assignable(src u32, dst u32) bool {
	if src == 0 || dst == 0 {
		return true // suppress cascade errors
	}
	if typeEqual(src, dst) {
		return true
	}
	if src == TYUntypedInt && (isIntType(dst) || isFloatType(dst)) {
		return true
	}
	if src == TYUntypedFloat && isFloatType(dst) {
		return true
	}
	if src == TYUntypedBool && isBoolType(dst) {
		return true
	}
	if src == TYUntypedStr && isStringType(dst) {
		return true
	}
	if src == TYUntypedNil {
		du := under(dst)
		if du == TYError || types[du].kind == TKindSlice || types[du].kind == TKindPtr {
			return true
		}
		return false
	}
	// Mutable []T -> const []T and mutable *T -> const *T widening (0 runtime cost; reverse forbidden!)
	su := under(src)
	du0 := under(dst)
	if (types[su].kind == TKindSlice && types[du0].kind == TKindSlice) || (types[su].kind == TKindPtr && types[du0].kind == TKindPtr) {
		if types[su].flags == 0 && types[du0].flags == 1 && typeEqual(types[su].a, types[du0].a) {
			return true
		}
	}
	// Implicit unnamed <-> named if one is unnamed and underlying types match (Go rule for composites & error interface)
	if types[src].kind != TKindNamed || types[dst].kind != TKindNamed {
		if typeEqual(under(src), under(dst)) {
			du := under(dst)
			if du == TYError || types[du].kind == TKindSlice || types[du].kind == TKindArray || types[du].kind == TKindPtr || types[du].kind == TKindSig {
				return true
			}
		}
	}
	return false
}

// classOf computes the resource class (Value=0, Scoped=1, Linear=2) of ty.
driver func classOf(ty u32) u8 {
	if ty == 0 || ty >= typeCount {
		return ClsValue
	}
	if isSlotType(ty) {
		return ClsLinear
	}
	if isAtomicType(ty) {
		return ClsValue
	}
	t := types[ty]
	if t.kind == TKindBuiltin {
		if ty == TYConn || ty == TYListener || ty == TYCancelFunc {
			return ClsLinear
		}
		if ty == TYFieldCode {
			return ClsValue
		}
		return ClsScoped
	}
	if t.kind == TKindPtr || t.kind == TKindSlice || t.kind == TKindSig || t.kind == TKindEffect {
		return ClsScoped
	}
	if t.kind == TKindResume {
		return ClsLinear
	}
	if t.kind == TKindNamed {
		return classOf(t.b)
	}
	if t.kind == TKindArray {
		return classOf(t.a)
	}
	if t.kind == TKindStruct {
		var mx u8 = ClsValue
		for i := u32(0); i < t.b; i++ {
			c := classOf(fields[t.a+i].typeID)
			if c > mx {
				mx = c
			}
		}
		return mx
	}
	if t.kind == TKindEnum {
		var mx u8 = ClsValue
		for i := u32(0); i < t.b; i++ {
			v := variants[t.a+i]
			for j := u32(0); j < v.payCount; j++ {
				c := classOf(typeList[v.payStart+j])
				if c > mx {
					mx = c
				}
			}
		}
		return mx
	}
	return ClsValue
}

func isScalarType(ty u32) bool {
	u := under(ty)
	if u == 0 {
		return false
	}
	t := types[u]
	if t.kind == TKindPtr || t.kind == TKindEffect {
		return true
	}
	if t.kind == TKindBasic {
		return u == TYBool || (u >= TYU8 && u <= TYInt) || u == TYF32 || u == TYF64 || u == TYError || u == TYUntypedInt || u == TYUntypedFloat || u == TYUntypedBool
	}
	if t.kind == TKindBuiltin {
		return u == TYConn || u == TYScope || u == TYArena
	}
	return false
}

// ---------------------------------------------------------------------------
// Type Substitution (for generic instantiation & full monomorphization)

driver func substType(ty u32, tpSyms []u32, targs []u32) u32 {
	if ty == 0 || len(tpSyms) == 0 {
		return ty
	}
	t := types[ty]
	if t.kind == TKindTypeParam {
		for i := usize(0); i < len(tpSyms); i++ {
			if t.a == tpSyms[i] {
				return targs[i]
			}
		}
		return ty
	}
	if t.kind == TKindConstArg {
		if t.a != 0 {
			nd, nv := substDim(t.a, tpSyms, targs)
			return newType(Type{kind: TKindConstArg, a: nd, lenVal: nv})
		}
		return ty
	}
	if t.kind == TKindBasic || t.kind == TKindBuiltin || t.kind == TKindCode {
		return ty
	}
	if t.kind == TKindPtr {
		ne := substType(t.a, tpSyms, targs)
		if ne == t.a {
			return ty
		}
		return newType(Type{kind: TKindPtr, flags: t.flags, a: ne})
	}
	if t.kind == TKindSlice {
		ne := substType(t.a, tpSyms, targs)
		if ne == t.a {
			return ty
		}
		return newType(Type{kind: TKindSlice, flags: t.flags, a: ne})
	}
	if t.kind == TKindArray {
		ne := substType(t.a, tpSyms, targs)
		nl := t.lenVal
		nb := t.b
		if t.b != 0 {
			nb, nl = substDim(t.b, tpSyms, targs)
		}
		if ne == t.a && nl == t.lenVal && nb == t.b {
			return ty
		}
		return newType(Type{kind: TKindArray, a: ne, b: nb, lenVal: nl})
	}
	if t.kind == TKindStruct {
		changed := false
		var nf [128]Field
		for i := u32(0); i < t.b; i++ {
			f := fields[t.a+i]
			nt := substType(f.typeID, tpSyms, targs)
			if nt != f.typeID {
				changed = true
			}
			nf[i] = Field{nameStr: f.nameStr, typeID: nt}
		}
		if !changed {
			return ty
		}
		fs := fieldCount
		for i := u32(0); i < t.b; i++ {
			if fieldCount < MaxFields {
				fields[fieldCount] = nf[i]
				fieldCount++
			}
		}
		return newType(Type{kind: TKindStruct, a: fs, b: t.b})
	}
	if t.kind == TKindEnum {
		changed := false
		var nv [64]Variant
		for i := u32(0); i < t.b; i++ {
			v := variants[t.a+i]
			var np [16]u32
			for j := u32(0); j < v.payCount; j++ {
				pt := typeList[v.payStart+j]
				npt := substType(pt, tpSyms, targs)
				if npt != pt {
					changed = true
				}
				np[j] = npt
			}
			ps, pc := pushTypeList(np[:usize(v.payCount)])
			nv[i] = Variant{nameStr: v.nameStr, payStart: ps, payCount: pc}
		}
		if !changed {
			return ty
		}
		vs := variantCount
		for i := u32(0); i < t.b; i++ {
			if variantCount < MaxVariants {
				variants[variantCount] = nv[i]
				variantCount++
			}
		}
		return newType(Type{kind: TKindEnum, a: vs, b: t.b})
	}
	if t.kind == TKindSig {
		changed := false
		var np [32]u32
		for i := u32(0); i < t.b; i++ {
			pt := typeList[t.a+i]
			npt := substType(pt, tpSyms, targs)
			if npt != pt {
				changed = true
			}
			np[i] = npt
		}
		var nr [16]u32
		for i := u32(0); i < t.d; i++ {
			rt := typeList[t.c+i]
			nrt := substType(rt, tpSyms, targs)
			if nrt != rt {
				changed = true
			}
			nr[i] = nrt
		}
		var ne [16]u32
		ec := sigTypeEffCount[ty]
		driver for i := u32(0); i < ec && i < 16; i++ {
			et := typeList[sigTypeEffStart[ty]+i]
			net := substType(et, tpSyms, targs)
			if net != et {
				changed = true
			}
			ne[i] = net
		}
		if !changed {
			return ty
		}
		ps, pc := pushTypeList(np[:usize(t.b)])
		rs, rc := pushTypeList(nr[:usize(t.d)])
		resSig := newType(Type{kind: TKindSig, op: t.op, flags: t.flags, a: ps, b: pc, c: rs, d: rc})
		if ec > 0 {
			es, ec2 := pushTypeList(ne[:usize(ec)])
			sigTypeEffStart[resSig] = es
			sigTypeEffCount[resSig] = ec2
		}
		return resSig
	}
	if t.kind == TKindEffect {
		if t.d == 0 {
			return ty
		}
		changed := false
		var na [16]u32
		for i := u32(0); i < t.d; i++ {
			at := typeList[t.c+i]
			nat := substType(at, tpSyms, targs)
			if nat != at {
				changed = true
			}
			na[i] = nat
		}
		if !changed {
			return ty
		}
		orig := t.origin
		if orig == 0 {
			orig = ty
		}
		return instantiateEffect(orig, na[:usize(t.d)])
	}
	if t.kind == TKindNamed {
		if t.flags == 1 {
			// Slot[T]
			el := substType(typeList[t.c], tpSyms, targs)
			if el == typeList[t.c] {
				return ty
			}
			return makeSlotType(el)
		}
		if t.flags == 2 {
			// Atomic[T]
			el := substType(typeList[t.c], tpSyms, targs)
			if el == typeList[t.c] {
				return ty
			}
			return makeAtomicType(el)
		}
		if t.d == 0 {
			return ty
		}
		changed := false
		var na [16]u32
		for i := u32(0); i < t.d; i++ {
			at := typeList[t.c+i]
			nat := substType(at, tpSyms, targs)
			if nat != at {
				changed = true
			}
			na[i] = nat
		}
		if !changed {
			return ty
		}
		orig := t.origin
		if orig == 0 {
			orig = ty
		}
		return instantiateNamed(orig, na[:usize(t.d)])
	}
	return ty
}

// instantiateNamed creates a concrete or partially-specialized instance of generic Named type orig.
driver func instantiateNamed(orig u32, args []u32) u32 {
	if orig == TYSlotOrigin && len(args) == 1 {
		return makeSlotType(args[0])
	}
	if orig == TYAtomicOrigin && len(args) == 1 {
		return makeAtomicType(args[0])
	}
	t := types[orig]
	if t.kind != TKindNamed {
		return orig
	}
	sym := syms[t.a]
	var tpSyms [16]u32
	ntp := usize(sym.extra2)
	for i := usize(0); i < ntp; i++ {
		tpSyms[i] = typeList[usize(sym.extra)+i]
	}
	underSub := substType(t.b, tpSyms[:ntp], args)
	ts, tc := pushTypeList(args)
	return newType(Type{
		kind:   TKindNamed,
		a:      t.a,
		b:      underSub,
		c:      ts,
		d:      tc,
		origin: orig,
	})
}

driver func instantiateEffect(orig u32, args []u32) u32 {
	t := types[orig]
	if t.kind != TKindEffect {
		return orig
	}
	ts, tc := pushTypeList(args)
	return newType(Type{
		kind:   TKindEffect,
		a:      t.a,
		c:      ts,
		d:      tc,
		origin: orig,
	})
}

// findEffectOp looks up an operation by name on an instantiated TKindEffect,
// returning (opIdx, substitutedOpSigType, ok).
driver func findEffectOp(effTy u32, opNameStr u32) (u32, u32, bool) {
	if effTy == 0 || types[effTy].kind != TKindEffect {
		return 0, 0, false
	}
	et := types[effTy]
	esym := et.a
	os := symEffOpStart[esym]
	oc := symEffOpCount[esym]
	for i := u32(0); i < oc; i++ {
		eo := effOps[os+i]
		if eo.nameStr == opNameStr {
			sig := eo.sigType
			if et.d > 0 && syms[esym].extra2 > 0 {
				var tpSyms [16]u32
				var targs [16]u32
				ntp := usize(syms[esym].extra2)
				for j := usize(0); j < ntp; j++ {
					tpSyms[j] = typeList[usize(syms[esym].extra)+j]
				}
				for j := u32(0); j < et.d; j++ {
					targs[j] = typeList[et.c+j]
				}
				sig = substType(sig, tpSyms[:ntp], targs[:usize(et.d)])
			}
			return eo.opIdx, sig, true
		}
	}
	return 0, 0, false
}

// ---------------------------------------------------------------------------
// x86_64 Memory Layout Calculator (matches bootstrap/internal/codegen/amd64/layout.go)

func alignUp64Safe(n u64, align u64) u64 {
	if align <= 1 {
		return n
	}
	rem := n % align
	if rem == 0 {
		return n
	}
	return n + (align - rem)
}

driver func layoutOf(ty u32) (u64, u64) {
	if ty == 0 || ty >= typeCount {
		return 0, 1
	}
	if isSlotType(ty) {
		return 16, 8
	}
	if isAtomicType(ty) {
		return layoutOf(atomicElemType(ty))
	}
	u := under(ty)
	t := types[u]
	if t.kind == TKindBasic {
		if u == TYBool || u == TYU8 || u == TYI8 || u == TYUntypedBool {
			return 1, 1
		}
		if u == TYU16 || u == TYI16 {
			return 2, 2
		}
		if u == TYU32 || u == TYI32 || u == TYF32 {
			return 4, 4
		}
		if u == TYU64 || u == TYI64 || u == TYInt || u == TYUsize || u == TYF64 || u == TYUntypedFloat || u == TYError || u == TYUntypedInt {
			return 8, 8
		}
		if u == TYString || u == TYUntypedStr {
			return 16, 8
		}
		return 0, 1
	}
	if t.kind == TKindBuiltin {
		if u == TYNet || u == TYSignals || u == TYClock || u == TYFS || u == TYEnv || u == TYStdio || u == TYExec || u == TYFieldCode {
			return 0, 1
		}
		if u == TYConn || u == TYScope || u == TYArena {
			return 8, 8
		}
		if u == TYListener || u == TYCancelFunc {
			return 16, 8
		}
		if u == TYContext {
			return 24, 8
		}
		return 0, 1
	}
	if t.kind == TKindPtr || t.kind == TKindEffect {
		return 8, 8
	}
	if t.kind == TKindSlice {
		return 24, 8
	}
	if t.kind == TKindSig || t.kind == TKindResume {
		return 16, 8
	}
	if t.kind == TKindArray {
		es, ea := layoutOf(t.a)
		stride := alignUp64Safe(es, ea)
		return stride * t.lenVal, ea
	}
	if t.kind == TKindStruct {
		var off u64 = 0
		var maxAl u64 = 1
		for i := u32(0); i < t.b; i++ {
			fs, fa := layoutOf(fields[t.a+i].typeID)
			if fa > maxAl {
				maxAl = fa
			}
			off = alignUp64Safe(off, fa)
			off += fs
		}
		return alignUp64Safe(off, maxAl), maxAl
	}
	if t.kind == TKindEnum {
		_, sz, al := enumLayout(u)
		return sz, al
	}
	return 0, 1
}

driver func structFieldOffset(structTy u32, idx u32) u64 {
	u := under(structTy)
	t := types[u]
	var off u64 = 0
	for i := u32(0); i < t.b; i++ {
		fs, fa := layoutOf(fields[t.a+i].typeID)
		off = alignUp64Safe(off, fa)
		if i == idx {
			return off
		}
		off += fs
	}
	return off
}

driver func enumLayout(enumTy u32) (u64, u64, u64) {
	u := under(enumTy)
	t := types[u]
	var tagSize u64 = 1
	if t.b > 65536 {
		tagSize = 4
	} else if t.b > 256 {
		tagSize = 2
	}
	maxAl := tagSize
	var maxPaySize u64 = 0
	for i := u32(0); i < t.b; i++ {
		v := variants[t.a+i]
		var po u64 = 0
		var va u64 = 1
		for j := u32(0); j < v.payCount; j++ {
			ps, pa := layoutOf(typeList[v.payStart+j])
			if pa > va {
				va = pa
			}
			po = alignUp64Safe(po, pa)
			po += ps
		}
		if va > maxAl {
			maxAl = va
		}
		if po > maxPaySize {
			maxPaySize = po
		}
	}
	payOff := alignUp64Safe(tagSize, maxAl)
	total := alignUp64Safe(payOff+maxPaySize, maxAl)
	if maxPaySize == 0 {
		total = tagSize
		maxAl = tagSize
	}
	return tagSize, total, maxAl
}

driver func enumPayloadOffset(enumTy u32, varIdx u32, payIdx u32) u64 {
	u := under(enumTy)
	t := types[u]
	tagSize, _, maxAl := enumLayout(u)
	payBase := alignUp64Safe(tagSize, maxAl)
	v := variants[t.a+varIdx]
	var po u64 = 0
	for j := u32(0); j < v.payCount; j++ {
		ps, pa := layoutOf(typeList[v.payStart+j])
		po = alignUp64Safe(po, pa)
		if j == payIdx {
			return payBase + po
		}
		po += ps
	}
	return payBase + po
}

func findStructField(structTy u32, nameStr u32) (u32, u32, bool) {
	u := under(structTy)
	t := types[u]
	if t.kind != TKindStruct {
		return 0, 0, false
	}
	for i := u32(0); i < t.b; i++ {
		if fields[t.a+i].nameStr == nameStr {
			return i, fields[t.a+i].typeID, true
		}
	}
	return 0, 0, false
}

func findEnumVariant(enumTy u32, nameStr u32) (u32, bool) {
	u := under(enumTy)
	t := types[u]
	if t.kind != TKindEnum {
		return 0, false
	}
	for i := u32(0); i < t.b; i++ {
		if variants[t.a+i].nameStr == nameStr {
			return i, true
		}
	}
	return 0, false
}

func findUserMethod(recvTypeSym u32, nameStr u32) (u32, bool) {
	for i := u32(0); i < methodCount; i++ {
		if methods[i].recvTypeSym == recvTypeSym && methods[i].nameStr == nameStr {
			return methods[i].funcSym, true
		}
	}
	return 0, false
}

func lookupBuiltinMethod(recvTy u32, nameStr u32) u16 {
	s := strSlice(nameStr)
	if recvTy == TYNet {
		if sliceEq(s, strBytes("ListenTCP")) {
			return BMNetListenTCP
		}
		if sliceEq(s, strBytes("DialTCP")) {
			return BMNetDialTCP
		}
		if sliceEq(s, strBytes("DialUDP")) {
			return BMNetDialUDP
		}
	} else if recvTy == TYListener {
		if sliceEq(s, strBytes("Addr")) {
			return BMListenerAddr
		}
		if sliceEq(s, strBytes("Accept")) {
			return BMListenerAccept
		}
		if sliceEq(s, strBytes("Close")) {
			return BMListenerClose
		}
	} else if recvTy == TYConn {
		if sliceEq(s, strBytes("Read")) {
			return BMConnRead
		}
		if sliceEq(s, strBytes("Write")) {
			return BMConnWrite
		}
		if sliceEq(s, strBytes("CloseWrite")) {
			return BMConnCloseWrite
		}
		if sliceEq(s, strBytes("Close")) {
			return BMConnClose
		}
	} else if recvTy == TYSignals {
		if sliceEq(s, strBytes("NotifyContext")) {
			return BMSignalsNotifyCtx
		}
	} else if recvTy == TYClock {
		if sliceEq(s, strBytes("Now")) {
			return BMClockNow
		}
		if sliceEq(s, strBytes("UnixNs")) {
			return BMClockUnixNs
		}
		if sliceEq(s, strBytes("Sleep")) {
			return BMClockSleep
		}
	} else if recvTy == TYContext {
		if sliceEq(s, strBytes("Done")) {
			return BMCtxDone
		}
		if sliceEq(s, strBytes("Err")) {
			return BMCtxErr
		}
		if sliceEq(s, strBytes("WithTimeout")) {
			return BMCtxWithTimeout
		}
	} else if recvTy == TYScope {
		if sliceEq(s, strBytes("AcquireSlot")) {
			return BMScopeAcquireSlot
		}
		if sliceEq(s, strBytes("ReleaseSlot")) {
			return BMScopeReleaseSlot
		}
		if sliceEq(s, strBytes("Go")) {
			return BMScopeGo
		}
		if sliceEq(s, strBytes("Spawn")) {
			return BMScopeSpawn
		}
		if sliceEq(s, strBytes("Ready")) {
			return BMScopeReady
		}
		if sliceEq(s, strBytes("Wait")) {
			return BMScopeWait
		}
		if sliceEq(s, strBytes("WaitTimeout")) {
			return BMScopeWaitTimeout
		}
	} else if recvTy == TYFS {
		if sliceEq(s, strBytes("ReadFileInto")) {
			return BMFSReadFileInto
		}
		if sliceEq(s, strBytes("WriteFile")) {
			return BMFSWriteFile
		}
		if sliceEq(s, strBytes("IsDir")) {
			return BMFSIsDir
		}
		if sliceEq(s, strBytes("ListSourceFiles")) {
			return BMFSListSourceFiles
		}
		if sliceEq(s, strBytes("MkdirTemp")) {
			return BMFSMkdirTemp
		}
		if sliceEq(s, strBytes("RemoveAll")) {
			return BMFSRemoveAll
		}
	} else if recvTy == TYEnv {
		if sliceEq(s, strBytes("ArgsCount")) {
			return BMEnvArgsCount
		}
		if sliceEq(s, strBytes("Arg")) {
			return BMEnvArg
		}
		if sliceEq(s, strBytes("GetEnv")) {
			return BMEnvGetenv
		}
	} else if recvTy == TYStdio {
		if sliceEq(s, strBytes("WriteStdout")) {
			return BMStdioWriteStdout
		}
		if sliceEq(s, strBytes("WriteStderr")) {
			return BMStdioWriteStderr
		}
		if sliceEq(s, strBytes("ReadStdin")) {
			return BMStdioReadStdin
		}
	} else if recvTy == TYExec {
		if sliceEq(s, strBytes("Run")) {
			return BMExecRun
		}
	} else if recvTy == TYArena {
		if sliceEq(s, strBytes("AllocBytes")) {
			return BMArenaAllocBytes
		}
		if sliceEq(s, strBytes("Used")) {
			return BMArenaUsed
		}
		if sliceEq(s, strBytes("Cap")) {
			return BMArenaCap
		}
		if sliceEq(s, strBytes("Reset")) {
			return BMArenaReset
		}
	} else if isAtomicType(recvTy) {
		if sliceEq(s, strBytes("Load")) {
			return BMAtomicLoad
		}
		if sliceEq(s, strBytes("Store")) {
			return BMAtomicStore
		}
		if sliceEq(s, strBytes("Add")) {
			return BMAtomicAdd
		}
		if sliceEq(s, strBytes("Swap")) {
			return BMAtomicSwap
		}
		if sliceEq(s, strBytes("CompareAndSwap")) {
			return BMAtomicCAS
		}
	}
	return BMNone
}
