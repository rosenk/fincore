const (
	SymNone      u8 = 0
	SymPkg       u8 = 1
	SymConst     u8 = 2
	SymVar       u8 = 3 // package-level global
	SymLocal     u8 = 4 // function-local variable
	SymParam     u8 = 5 // function parameter or receiver
	SymType      u8 = 6
	SymFunc      u8 = 7
	SymMethod    u8 = 8
	SymTypeParam u8 = 9
	SymBuiltin   u8 = 10
	SymEffect    u8 = 11
)

