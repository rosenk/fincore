// types.fc — the typed model (port of finc0's bootstrap/internal/types:
// type.go, universe.go, info.go and the instantiation half of typexpr.go).
//
// Types live in a TypeArena indexed by TypeID (u32, 0 = no type); a type is
// a TypeRec, one variant per type form. All structural types (arrays,
// slices, pointers, structs, enums, signatures, codes, const args, tuples)
// and generic instances are hash-consed, so type identity
// (types.Identical) is TypeID equality. Declared named types, type
// parameters and opaque resource types are unique records. Child lists
// (fields, variants, params, type args, ...) are runs of a vec.ListArena;
// they are interned as well, so equal lists are equal (start, len) pairs
// and hash-consing compares TypeRecs with ==. The mutable state of named
// types (underlying type, type parameters, method and class caches) lives
// in NamedRec records.
package main

import (
	"std/maps"
	"std/vec"
)

const (
	MaxTypes     = 131_072
	TypeBuckets  = 262_144
	MaxTypeLists = 1 << 20
	MaxListRecs  = 131_072
	ListBuckets  = 262_144
	MaxNamedRecs = 65_536
	MaxMethods   = 16_384
	MaxInsts     = 8192
	MaxPending   = 8192
	MaxFuncs     = 65_536
	MaxCalls     = 262_144
	MaxSels      = 262_144
)

// Basic kinds (types.BasicKind) and the TypeIDs of the basic types
// (TypeID = kind + 1; byte is u8).
const (
	BkInvalid       = 0
	BkBool          = 1
	BkU8            = 2
	BkU16           = 3
	BkU32           = 4
	BkU64           = 5
	BkI8            = 6
	BkI16           = 7
	BkI32           = 8
	BkI64           = 9
	BkInt           = 10
	BkUsize         = 11
	BkString        = 12
	BkError         = 13
	BkUntypedInt    = 14
	BkUntypedChar   = 15
	BkUntypedBool   = 16
	BkUntypedString = 17
	BkUntypedNil    = 18
	NumBasic        = 19

	TyInvalid       = 1
	TyBool          = 2
	TyU8            = 3
	TyU16           = 4
	TyU32           = 5
	TyU64           = 6
	TyI8            = 7
	TyI16           = 8
	TyI32           = 9
	TyI64           = 10
	TyInt           = 11
	TyUsize         = 12
	TyString        = 13
	TyError         = 14
	TyUntypedInt    = 15
	TyUntypedChar   = 16
	TyUntypedBool   = 17
	TyUntypedString = 18
	TyUntypedNil    = 19
)

// Effects (types.Effect): Comptime < Total < Driver.
const (
	EffComptime = 0
	EffTotal    = 1
	EffDriver   = 2
)

// Value classes (spec 4.1).
const (
	ClassValue  = 0
	ClassScoped = 1
	ClassLinear = 2
)

// TypeRec is a type form. Lists are (start, len) runs of TypeArena.lists.
// The variant order fixes the compact layout (u8, bool, 6 x u32, u64:
// 40 bytes).
type TypeRec enum {
	NoType                                      // TypeID 0
	Basic(u8)                                   // BasicKind
	Sig(u8, bool, u32, u32, u32, u32, u32, u32) // effect, variadic, params, results, type params (generic functions)
	Named(u32)                                  // NamedRec ID: declared named types and generic instances
	Array(u32, u32, u64)                        // elem, length type parameter (0 = constant length), length
	Slice(u32)                                  // elem
	Pointer(u32)                                // elem
	Struct(u32, u32)                            // (name, type) pairs
	Enum(u32, u32)                              // (name, payload start, payload len) triples
	Code(u32)                                   // level + 1 (0 = level-polymorphic `Code ?`)
	TypeParam(u32, u32, u32, u32)               // name, symbol, index, const type (0 = type parameter)
	ConstArg(u64)                               // value
	Tuple(u32, u32)                             // types
	Opaque(u32, u8)                             // name, builtin
}

// NamedRec holds a named type. Instances (origin != 0) are hash-consed by
// (origin, type args).
type NamedRec struct {
	name    u32 // NameID
	sym     u32 // declaring symbol
	pkg     u32
	under   u32 // underlying type (0 = not yet resolved)
	origin  u32 // generic type (instances)
	argS    u32 // type args (instances)
	argN    u32
	tpS     u32 // type params (generic declarations)
	tpN     u32
	methS   u32 // method IDs (ulists), valid when methOK
	methN   u32
	builtin u8
	cls     u8 // value class, valid when clsOK
	clsOK   bool
	methOK  bool
}

type TypeArena struct {
	items   [MaxTypes]TypeRec
	count   usize
	table   maps.Table[TypeBuckets]
	lists   vec.ListArena[MaxTypeLists, MaxTypeLists, u32]
	listTab maps.Table[ListBuckets]
	listS   [MaxListRecs]u32 // interned list i: run (listS[i], listN[i])
	listN   [MaxListRecs]u32
	nlrec   usize
	named   [MaxNamedRecs]NamedRec
	nnamed  usize
}

var typs TypeArena

func trec(t u32) TypeRec {
	return typs.items[usize(t)]
}

func tlist(s u32, i usize) u32 {
	la := &typs.lists
	return la.At(usize(s) + i)
}

// tlistSlice returns the run (s, n) as a slice.
func tlistSlice(s u32, n u32) []u32 {
	la := &typs.lists
	return la.Run(s, n)
}

func tpush(x u32) {
	la := &typs.lists
	la.Push(x)
	if la.Full() {
		setFull("type lists")
	}
}

func tmark() usize {
	la := &typs.lists
	return la.Depth()
}

// tslice returns the pending list stack[a:top].
func tslice(a usize) []u32 {
	la := &typs.lists
	return la.Pending(a)
}

// tdiscard pops the list stack back to mark.
func tdiscard(mark usize) {
	la := &typs.lists
	la.Discard(mark)
}

func tlistsUsed() usize {
	la := &typs.lists
	return la.Used()
}

func hashList(xs []u32) u64 {
	n := len(xs)
	h := maps.HashU64(u64(n))
	for i := usize(0); i < n; i++ {
		h = maps.Mix(h, u64(xs[i]))
	}
	return h
}

// tcommitStack interns stack[mark:top], pops it and returns its run: equal
// lists get the same run.
func tcommitStack(mark usize) (u32, u32) {
	la := &typs.lists
	xs := la.Pending(mark)
	if len(xs) == 0 {
		la.Discard(mark)
		return 0, 0
	}
	tp := &typs.listTab
	s := tp.Start(hashList(xs))
	lim := tp.Cap()
	for g := usize(0); g < lim; g++ {
		id := tp.At(s)
		if id == 0 {
			if typs.nlrec == 0 {
				typs.nlrec = 1
			}
			if typs.nlrec >= MaxListRecs {
				setFull("type lists")
				la.Discard(mark)
				return 0, 0
			}
			st, n := la.Commit(mark)
			if n == 0 {
				setFull("type lists")
				return 0, 0
			}
			r := typs.nlrec
			typs.nlrec++
			typs.listS[r] = st
			typs.listN[r] = n
			tp.Set(s, u32(r))
			return st, n
		}
		if u32sEqual(la.Run(typs.listS[usize(id)], typs.listN[usize(id)]), xs) {
			la.Discard(mark)
			return typs.listS[usize(id)], typs.listN[usize(id)]
		}
		s = tp.Next(s)
	}
	setFull("type lists")
	la.Discard(mark)
	return 0, 0
}

// tcommit interns xs (a slice that may alias the list arena or the stack).
func tcommit(xs []u32) (u32, u32) {
	m := tmark()
	n := len(xs)
	for i := usize(0); i < n; i++ {
		tpush(xs[i])
	}
	return tcommitStack(m)
}

func u32sEqual(a []u32, b []u32) bool {
	n := len(a)
	if n != len(b) {
		return false
	}
	for i := usize(0); i < n; i++ {
		if a[i] != b[i] {
			return false
		}
	}
	return true
}

func newTypeRec(r TypeRec) u32 {
	if typs.count == 0 {
		typs.count = 1
	}
	if typs.count >= MaxTypes {
		setFull("types")
		return TyInvalid
	}
	id := typs.count
	typs.count++
	typs.items[id] = r
	return u32(id)
}

func newNamedRec(r NamedRec) u32 {
	if typs.nnamed == 0 {
		typs.nnamed = 1
	}
	if typs.nnamed >= MaxNamedRecs {
		setFull("named types")
		return 0
	}
	id := typs.nnamed
	typs.nnamed++
	typs.named[id] = r
	return u32(id)
}

func mix3(h u64, a u64, b u64, c u64) u64 {
	return maps.Mix(maps.Mix(maps.Mix(h, a), b), c)
}

// typeHash hashes the identity of a hash-consed type: its fields (lists
// are interned) or, for an instance, its origin and type args.
func typeHash(r TypeRec) u64 {
	return match r {
		NoType -> 1
		Basic(k) -> maps.Mix(2, u64(k))
		Sig(eff, va, ps, pn, rs, rn, ts, tn) -> mix3(mix3(mix3(3, u64(eff), boolU64(va), u64(ps)), u64(pn), u64(rs), u64(rn)), u64(ts), u64(tn), 0)
		Named(id) -> mix3(4, u64(typs.named[usize(id)].origin), u64(typs.named[usize(id)].argS), u64(typs.named[usize(id)].argN))
		Array(e, p, n) -> mix3(5, u64(e), u64(p), n)
		Slice(e) -> maps.Mix(6, u64(e))
		Pointer(e) -> maps.Mix(7, u64(e))
		Struct(s, n) -> mix3(8, u64(s), u64(n), 0)
		Enum(s, n) -> mix3(9, u64(s), u64(n), 0)
		Code(l) -> maps.Mix(10, u64(l))
		TypeParam(nm, sym, i, ct) -> mix3(mix3(11, u64(nm), u64(sym), u64(i)), u64(ct), 0, 0)
		ConstArg(v) -> maps.Mix(12, v)
		Tuple(s, n) -> mix3(13, u64(s), u64(n), 0)
		Opaque(nm, b) -> mix3(14, u64(nm), u64(b), 0)
	}
}

func boolU64(b bool) u64 {
	if b {
		return 1
	}
	return 0
}

// sameType reports whether x and r are the same hash-consed type.
func sameType(x TypeRec, r TypeRec) bool {
	match r {
		Named(rn) -> {
			return match x {
				Named(xn) -> typs.named[usize(xn)].origin == typs.named[usize(rn)].origin && typs.named[usize(xn)].argS == typs.named[usize(rn)].argS && typs.named[usize(xn)].argN == typs.named[usize(rn)].argN
				_ -> false
			}
		}
		_ -> {
			return x == r
		}
	}
}

// internType returns the canonical TypeID of r (whose lists are interned)
// and whether it is new. An instance's NamedRec must be the last one
// allocated; it is released if the instance already exists.
func internType(r TypeRec) (u32, bool) {
	tp := &typs.table
	s := tp.Start(typeHash(r))
	lim := tp.Cap()
	for g := usize(0); g < lim; g++ {
		id := tp.At(s)
		if id == 0 {
			nid := newTypeRec(r)
			if nid != TyInvalid {
				tp.Set(s, nid)
			}
			return nid, true
		}
		if sameType(typs.items[usize(id)], r) {
			match r {
				Named(_) -> {
					typs.nnamed--
				}
				_ -> {}
			}
			return id, false
		}
		s = tp.Next(s)
	}
	setFull("type table")
	return TyInvalid, false
}

func intern1(r TypeRec) u32 {
	t, _ := internType(r)
	return t
}

func emptyU32() []u32 {
	return tslice(tmark())
}

// ---------------------------------------------------------------------------
// Constructors

func initBasicTypes() {
	typs.count = 1
	for k := u8(0); k < NumBasic; k++ {
		_ = newTypeRec(TypeRec.Basic(k))
	}
}

func mkArray(n u64, lenParam u32, elem u32) u32 {
	return intern1(TypeRec.Array(elem, lenParam, n))
}

func mkSlice(elem u32) u32 {
	return intern1(TypeRec.Slice(elem))
}

func mkPointer(elem u32) u32 {
	return intern1(TypeRec.Pointer(elem))
}

// mkCode returns `Code level` (level < 0: level-polymorphic).
func mkCode(level int) u32 {
	if level >= 0 {
		return intern1(TypeRec.Code(u32(level + 1)))
	}
	return intern1(TypeRec.Code(0))
}

func codeLevel(t u32) int {
	return match trec(t) { Code(l) -> int(l) - 1, _ -> -1 }
}

func mkConstArg(v u64) u32 {
	return intern1(TypeRec.ConstArg(v))
}

// mkStruct interns a struct from (name, type) pairs on the stack [mark:top].
func mkStruct(mark usize) u32 {
	s, n := tcommitStack(mark)
	return intern1(TypeRec.Struct(s, n))
}

// mkEnum interns an enum from (name, payS, payN) triples on the stack.
func mkEnum(mark usize) u32 {
	s, n := tcommitStack(mark)
	return intern1(TypeRec.Enum(s, n))
}

// mkSig interns a signature: params stack[m1:m2], results [m2:m3],
// type params [m3:top].
func mkSig(eff u8, variadic bool, m1 usize, m2 usize, m3 usize) u32 {
	ts, tn := tcommitStack(m3)
	rs, rn := tcommitStack(m2)
	ps, pn := tcommitStack(m1)
	return intern1(TypeRec.Sig(eff, variadic, ps, pn, rs, rn, ts, tn))
}

// mkSigLists interns a signature from lists.
func mkSigLists(eff u8, variadic bool, ps []u32, rs []u32, tps []u32) u32 {
	s1, n1 := tcommit(ps)
	s2, n2 := tcommit(rs)
	s3, n3 := tcommit(tps)
	return intern1(TypeRec.Sig(eff, variadic, s1, n1, s2, n2, s3, n3))
}

func mkTuple(xs []u32) u32 {
	s, n := tcommit(xs)
	return intern1(TypeRec.Tuple(s, n))
}

// mkTupleStack interns a tuple of the types on the stack [mark:top].
func mkTupleStack(mark usize) u32 {
	s, n := tcommitStack(mark)
	return intern1(TypeRec.Tuple(s, n))
}

func newNamed(name u32, sym u32, pkg u32, builtin u8) u32 {
	var r NamedRec
	r.name = name
	r.sym = sym
	r.pkg = pkg
	r.builtin = builtin
	id := newNamedRec(r)
	if id == 0 {
		return TyInvalid
	}
	return newTypeRec(TypeRec.Named(id))
}

func newTypeParam(name u32, sym u32, index u32, constT u32) u32 {
	return newTypeRec(TypeRec.TypeParam(name, sym, index, constT))
}

func newOpaque(name u32, builtin u8) u32 {
	return newTypeRec(TypeRec.Opaque(name, builtin))
}

// ---------------------------------------------------------------------------
// Type forms

func isBasicT(t u32) bool {
	return match trec(t) { Basic(_) -> true, _ -> false }
}

func isNamedT(t u32) bool {
	return match trec(t) { Named(_) -> true, _ -> false }
}

func isArrayT(t u32) bool {
	return match trec(t) { Array(_, _, _) -> true, _ -> false }
}

func isSliceT(t u32) bool {
	return match trec(t) { Slice(_) -> true, _ -> false }
}

func isPointerT(t u32) bool {
	return match trec(t) { Pointer(_) -> true, _ -> false }
}

func isStructT(t u32) bool {
	return match trec(t) { Struct(_, _) -> true, _ -> false }
}

func isEnumT(t u32) bool {
	return match trec(t) { Enum(_, _) -> true, _ -> false }
}

func isSigT(t u32) bool {
	return match trec(t) { Sig(_, _, _, _, _, _, _, _) -> true, _ -> false }
}

func isCodeT(t u32) bool {
	return match trec(t) { Code(_) -> true, _ -> false }
}

func isTypeParamT(t u32) bool {
	return match trec(t) { TypeParam(_, _, _, _) -> true, _ -> false }
}

func isConstArgT(t u32) bool {
	return match trec(t) { ConstArg(_) -> true, _ -> false }
}

func isTupleT(t u32) bool {
	return match trec(t) { Tuple(_, _) -> true, _ -> false }
}

func isOpaqueT(t u32) bool {
	return match trec(t) { Opaque(_, _) -> true, _ -> false }
}

// ---------------------------------------------------------------------------
// Accessors and predicates

// namedID returns the NamedRec of a named type (0 for other types).
func namedID(t u32) u32 {
	return match trec(t) { Named(id) -> id, _ -> 0 }
}

func underlying(t u32) u32 {
	match trec(t) {
		Named(id) -> {
			u := typs.named[usize(id)].under
			if u == 0 {
				return TyInvalid
			}
			return u
		}
		_ -> {
			return t
		}
	}
}

// namedUnder returns the underlying type of a named type as recorded (0 =
// not yet resolved or not a named type).
func namedUnder(t u32) u32 {
	return nrec(t).under
}

func setNamedUnder(t u32, u u32) {
	id := namedID(t)
	if id != 0 {
		typs.named[usize(id)].under = u
	}
}

// setNamedClass caches the value class of a named type.
func setNamedClass(t u32, c u8) {
	id := namedID(t)
	if id != 0 {
		typs.named[usize(id)].cls = c
		typs.named[usize(id)].clsOK = true
	}
}

// namedClass returns the cached class of a named type (ok == false if none).
func namedClass(t u32) (u8, bool) {
	r := nrec(t)
	return r.cls, r.clsOK
}

func isInvalid(t u32) bool {
	return t == 0 || t == TyInvalid
}

func basicKind(t u32) u8 {
	return match trec(underlying(t)) { Basic(k) -> k, _ -> BkInvalid }
}

func isInteger(t u32) bool {
	k := basicKind(t)
	return (k >= BkU8 && k <= BkUsize) || k == BkUntypedInt || k == BkUntypedChar
}

func isUnsigned(t u32) bool {
	k := basicKind(t)
	return k >= BkU8 && k <= BkU64 || k == BkUsize
}

func isUntyped(t u32) bool {
	k := basicKind(t)
	return k >= BkUntypedInt && k <= BkUntypedNil
}

func isBoolean(t u32) bool {
	k := basicKind(t)
	return k == BkBool || k == BkUntypedBool
}

func isString(t u32) bool {
	k := basicKind(t)
	return k == BkString || k == BkUntypedString
}

// intInfo returns bit width and signedness of an integer type.
func intInfo(t u32) (u32, bool, bool) {
	k := basicKind(t)
	if k == BkU8 {
		return 8, false, true
	}
	if k == BkU16 {
		return 16, false, true
	}
	if k == BkU32 {
		return 32, false, true
	}
	if k == BkU64 || k == BkUsize {
		return 64, false, true
	}
	if k == BkI8 {
		return 8, true, true
	}
	if k == BkI16 {
		return 16, true, true
	}
	if k == BkI32 {
		return 32, true, true
	}
	if k == BkI64 || k == BkInt {
		return 64, true, true
	}
	return 0, false, false
}

func isPolyCode(t u32) bool {
	return trec(t) == TypeRec.Code(0)
}

// defaultOf returns the default type of an untyped type (types.Default).
func defaultOf(t u32) u32 {
	k := basicKind(t)
	if k == BkUntypedInt {
		return TyInt
	}
	if k == BkUntypedChar {
		return TyU8
	}
	if k == BkUntypedBool {
		return TyBool
	}
	if k == BkUntypedString {
		return TyString
	}
	if isPolyCode(t) {
		return mkCode(0)
	}
	return t
}

// derefType returns the element of a pointer type (and true), else t.
func derefType(t u32) (u32, bool) {
	match trec(t) {
		Pointer(e) -> {
			return e, true
		}
		_ -> {
			return t, false
		}
	}
}

// elemOf returns the element type of an array, slice or pointer type.
func elemOf(t u32) u32 {
	return match trec(t) {
		Array(e, _, _) -> e
		Slice(e) -> e
		Pointer(e) -> e
		_ -> 0
	}
}

// arrayLenOf returns the constant length and the length type parameter of
// an array type.
func arrayLenOf(t u32) (u64, u32) {
	match trec(t) {
		Array(_, p, n) -> {
			return n, p
		}
		_ -> {
			return 0, 0
		}
	}
}

func constArgVal(t u32) u64 {
	return match trec(t) { ConstArg(v) -> v, _ -> 0 }
}

// typeName returns the name of a named type, type parameter or opaque type.
func typeName(t u32) u32 {
	return match trec(t) {
		Named(id) -> typs.named[usize(id)].name
		TypeParam(nm, _, _, _) -> nm
		Opaque(nm, _) -> nm
		_ -> 0
	}
}

// Type parameters.
func tpSym(t u32) u32 {
	return match trec(t) { TypeParam(_, sym, _, _) -> sym, _ -> 0 }
}

// tpConstType returns the type of a const type parameter (0 for a type
// parameter).
func tpConstType(t u32) u32 {
	return match trec(t) { TypeParam(_, _, _, ct) -> ct, _ -> 0 }
}

func tpIsConst(t u32) bool {
	return tpConstType(t) != 0
}

// Struct fields: pairs (name, type).
func nfields(st u32) usize {
	return match trec(st) { Struct(_, n) -> usize(n) / 2, _ -> 0 }
}

func fieldName(st u32, i usize) u32 {
	return match trec(st) { Struct(s, _) -> tlist(s, 2*i), _ -> 0 }
}

func fieldType(st u32, i usize) u32 {
	return match trec(st) { Struct(s, _) -> tlist(s, 2*i+1), _ -> 0 }
}

func fieldByName(st u32, name u32) (usize, bool) {
	n := nfields(st)
	for i := usize(0); i < n; i++ {
		if fieldName(st, i) == name {
			return i, true
		}
	}
	return 0, false
}

// Enum variants: triples (name, payload start, payload len).
func nvariants(en u32) usize {
	return match trec(en) { Enum(_, n) -> usize(n) / 3, _ -> 0 }
}

func variantName(en u32, i usize) u32 {
	return match trec(en) { Enum(s, _) -> tlist(s, 3*i), _ -> 0 }
}

func variantPayS(en u32, i usize) u32 {
	return match trec(en) { Enum(s, _) -> tlist(s, 3*i+1), _ -> 0 }
}

func variantPayN(en u32, i usize) usize {
	return match trec(en) { Enum(s, _) -> usize(tlist(s, 3*i+2)), _ -> 0 }
}

func variantPay(en u32, i usize, j usize) u32 {
	return tlist(variantPayS(en, i), j)
}

func variantByName(en u32, name u32) (usize, bool) {
	n := nvariants(en)
	for i := usize(0); i < n; i++ {
		if variantName(en, i) == name {
			return i, true
		}
	}
	return 0, false
}

// Tuples.
func tupleN(t u32) usize {
	return match trec(t) { Tuple(_, n) -> usize(n), _ -> 0 }
}

func tupleAt(t u32, i usize) u32 {
	return match trec(t) { Tuple(s, _) -> tlist(s, i), _ -> 0 }
}

// Signatures.
func sigEffect(s u32) u8 {
	return match trec(s) { Sig(eff, _, _, _, _, _, _, _) -> eff, _ -> EffComptime }
}

func sigVariadic(s u32) bool {
	return match trec(s) { Sig(_, va, _, _, _, _, _, _) -> va, _ -> false }
}

func sigNParams(s u32) usize {
	return match trec(s) { Sig(_, _, _, pn, _, _, _, _) -> usize(pn), _ -> 0 }
}

func sigParam(s u32, i usize) u32 {
	return match trec(s) { Sig(_, _, ps, _, _, _, _, _) -> tlist(ps, i), _ -> 0 }
}

func sigParamsSlice(s u32) []u32 {
	return match trec(s) { Sig(_, _, ps, pn, _, _, _, _) -> tlistSlice(ps, pn), _ -> emptyU32() }
}

func sigNResults(s u32) usize {
	return match trec(s) { Sig(_, _, _, _, _, rn, _, _) -> usize(rn), _ -> 0 }
}

func sigResult(s u32, i usize) u32 {
	return match trec(s) { Sig(_, _, _, _, rs, _, _, _) -> tlist(rs, i), _ -> 0 }
}

func sigResultsSlice(s u32) []u32 {
	return match trec(s) { Sig(_, _, _, _, rs, rn, _, _) -> tlistSlice(rs, rn), _ -> emptyU32() }
}

// sigTParamList returns the type parameter list of a generic signature.
func sigTParamList(s u32) (u32, u32) {
	match trec(s) {
		Sig(_, _, _, _, _, _, ts, tn) -> {
			return ts, tn
		}
		_ -> {
			return 0, 0
		}
	}
}

func sigNTParams(s u32) usize {
	return match trec(s) { Sig(_, _, _, _, _, _, _, tn) -> usize(tn), _ -> 0 }
}

func sigTParam(s u32, i usize) u32 {
	return match trec(s) { Sig(_, _, _, _, _, _, ts, _) -> tlist(ts, i), _ -> 0 }
}

// sigResultType: 0 for no results, the result, or a Tuple.
func sigResultType(s u32) u32 {
	n := sigNResults(s)
	if n == 0 {
		return 0
	}
	if n == 1 {
		return sigResult(s, 0)
	}
	return mkTuple(sigResultsSlice(s))
}

// Named types. nrec returns the NamedRec of t (the zero record for other
// types).
func nrec(t u32) NamedRec {
	return typs.named[usize(namedID(t))]
}

func namedBuiltin(t u32) u8 {
	return nrec(t).builtin
}

func namedOrigin(t u32) u32 {
	return nrec(t).origin
}

func namedSym(t u32) u32 {
	return nrec(t).sym
}

// Type args of an instance.
func namedArgList(t u32) (u32, u32) {
	r := nrec(t)
	return r.argS, r.argN
}

func namedNArgs(t u32) usize {
	return usize(nrec(t).argN)
}

func namedArg(t u32, i usize) u32 {
	return tlist(nrec(t).argS, i)
}

func namedArgs(t u32) []u32 {
	r := nrec(t)
	return tlistSlice(r.argS, r.argN)
}

// Type params of a generic declaration.
func namedTParamList(t u32) (u32, u32) {
	r := nrec(t)
	return r.tpS, r.tpN
}

func namedNTParams(t u32) usize {
	return usize(nrec(t).tpN)
}

func namedTParam(t u32, i usize) u32 {
	return tlist(nrec(t).tpS, i)
}

func setNamedTParams(t u32, s u32, n u32) {
	id := namedID(t)
	if id != 0 {
		typs.named[usize(id)].tpS = s
		typs.named[usize(id)].tpN = n
	}
}

// Method cache (ulists of method IDs).
func namedMethodCache(t u32) (u32, u32, bool) {
	r := nrec(t)
	return r.methS, r.methN, r.methOK
}

func setNamedMethods(t u32, s u32, n u32) {
	id := namedID(t)
	if id != 0 {
		typs.named[usize(id)].methS = s
		typs.named[usize(id)].methN = n
		typs.named[usize(id)].methOK = true
	}
}

func isGenericNamed(t u32) bool {
	return isNamedT(t) && namedNTParams(t) > 0
}

// builtinOf returns the predeclared identity of a named type (origin for
// instances), 0 if none.
func builtinOf(t u32) u8 {
	if t == 0 || !isNamedT(t) {
		return 0
	}
	n := t
	if namedOrigin(n) != 0 {
		n = namedOrigin(n)
	}
	return namedBuiltin(n)
}

func isResource(t u32) bool {
	b := builtinOf(t)
	return b >= BTNet && b <= BTExec
}

func isCapability(t u32) bool {
	b := builtinOf(t)
	return b == BTNet || b == BTSignals || b == BTClock || b == BTFS || b == BTEnv || b == BTStdio || b == BTExec
}

// maxClassOf returns the largest class of the n types in the run at s.
func maxClassOf(s u32, n u32, depth usize) u8 decreases(depth) {
	c := u8(ClassValue)
	if depth == 0 {
		return c
	}
	for i := u32(0); i < n; i++ {
		x := classOf(tlist(s, usize(i)), depth-1)
		if x > c {
			c = x
		}
	}
	return c
}

// classOf computes the value class of t (types.ClassOf).
func classOf(t u32, depth usize) u8 decreases(depth) {
	if depth == 0 || t == 0 {
		return ClassValue
	}
	match trec(t) {
		Named(id) -> {
			if typs.named[usize(id)].clsOK {
				return typs.named[usize(id)].cls
			}
			u := typs.named[usize(id)].under
			if u == 0 {
				return ClassValue
			}
			setNamedClass(t, ClassValue)
			c := classOf(u, depth-1)
			typs.named[usize(id)].cls = c
			return c
		}
		Pointer(_) | Sig(_, _, _, _, _, _, _, _) -> {
			return ClassScoped
		}
		Array(e, _, _) -> {
			return classOf(e, depth-1)
		}
		Slice(e) -> {
			return classOf(e, depth-1)
		}
		Struct(_, _) -> {
			c := u8(ClassValue)
			nf := nfields(t)
			for i := usize(0); i < nf; i++ {
				x := classOf(fieldType(t, i), depth-1)
				if x > c {
					c = x
				}
			}
			return c
		}
		Enum(_, _) -> {
			c := u8(ClassValue)
			nv := nvariants(t)
			for i := usize(0); i < nv; i++ {
				x := maxClassOf(variantPayS(t, i), u32(variantPayN(t, i)), depth-1)
				if x > c {
					c = x
				}
			}
			return c
		}
		Tuple(s, n) -> {
			return maxClassOf(s, n, depth-1)
		}
		NoType | Basic(_) | Code(_) | TypeParam(_, _, _, _) | ConstArg(_) | Opaque(_, _) -> {
			return ClassValue
		}
	}
}

func classOfT(t u32) u8 {
	return classOf(t, SemaDepth)
}

func isScoped(t u32) bool {
	return classOfT(t) >= ClassScoped
}

func isLinear(t u32) bool {
	return classOfT(t) == ClassLinear
}

func comparable(t u32, depth usize) bool decreases(depth) {
	if depth == 0 || t == 0 {
		return false
	}
	u := underlying(t)
	match trec(u) {
		Basic(b) -> {
			return b != BkUntypedNil && b != BkInvalid
		}
		Pointer(_) | Code(_) -> {
			return true
		}
		Array(e, _, _) -> {
			return comparable(e, depth-1)
		}
		Struct(_, _) -> {
			n := nfields(u)
			for i := usize(0); i < n; i++ {
				if !comparable(fieldType(u, i), depth-1) {
					return false
				}
			}
			return true
		}
		Enum(_, _) -> {
			n := nvariants(u)
			for i := usize(0); i < n; i++ {
				m := variantPayN(u, i)
				for j := usize(0); j < m; j++ {
					if !comparable(variantPay(u, i, j), depth-1) {
						return false
					}
				}
			}
			return true
		}
		NoType | Sig(_, _, _, _, _, _, _, _) | Named(_) | Slice(_) | TypeParam(_, _, _, _) | ConstArg(_) | Tuple(_, _) | Opaque(_, _) -> {
			return false
		}
	}
}

// listHasTypeParam reports whether one of the n types in the run at s
// mentions a type parameter.
func listHasTypeParam(s u32, n u32, depth usize) bool decreases(depth) {
	if depth == 0 {
		return false
	}
	for i := u32(0); i < n; i++ {
		if hasTypeParam(tlist(s, usize(i)), depth-1) {
			return true
		}
	}
	return false
}

func hasTypeParam(t u32, depth usize) bool decreases(depth) {
	if depth == 0 || t == 0 {
		return false
	}
	match trec(t) {
		TypeParam(_, _, _, _) -> {
			return true
		}
		Named(id) -> {
			return listHasTypeParam(typs.named[usize(id)].argS, typs.named[usize(id)].argN, depth-1)
		}
		Tuple(s, n) -> {
			return listHasTypeParam(s, n, depth-1)
		}
		Array(e, p, _) -> {
			return p != 0 || hasTypeParam(e, depth-1)
		}
		Slice(e) -> {
			return hasTypeParam(e, depth-1)
		}
		Pointer(e) -> {
			return hasTypeParam(e, depth-1)
		}
		Struct(_, _) -> {
			n := nfields(t)
			for i := usize(0); i < n; i++ {
				if hasTypeParam(fieldType(t, i), depth-1) {
					return true
				}
			}
			return false
		}
		Enum(_, _) -> {
			n := nvariants(t)
			for i := usize(0); i < n; i++ {
				if listHasTypeParam(variantPayS(t, i), u32(variantPayN(t, i)), depth-1) {
					return true
				}
			}
			return false
		}
		Sig(_, _, ps, pn, rs, rn, _, _) -> {
			return listHasTypeParam(ps, pn, depth-1) || listHasTypeParam(rs, rn, depth-1)
		}
		NoType | Basic(_) | Code(_) | ConstArg(_) | Opaque(_, _) -> {
			return false
		}
	}
}

func anyTypeParam(xs []u32) bool {
	n := len(xs)
	for i := usize(0); i < n; i++ {
		if hasTypeParam(xs[i], SemaDepth) {
			return true
		}
	}
	return false
}

// ---------------------------------------------------------------------------
// Type strings (types.Type.String)

func basicName(k u8) string {
	if k == BkInvalid {
		return "invalid type"
	}
	if k == BkUntypedInt {
		return "untyped int"
	}
	if k == BkUntypedChar {
		return "untyped char"
	}
	if k == BkUntypedBool {
		return "untyped bool"
	}
	if k == BkUntypedString {
		return "untyped string"
	}
	if k == BkUntypedNil {
		return "untyped nil"
	}
	if k == BkError {
		return "error"
	}
	if k == BkString {
		return "string"
	}
	return builtinTypeName(k)
}

func putTypeList(o *OutBuf, xs []u32, depth usize) decreases(depth) {
	if depth == 0 {
		return
	}
	n := len(xs)
	for i := usize(0); i < n; i++ {
		if i > 0 {
			o.putStr(", ")
		}
		putType(o, xs[i], depth-1)
	}
}

func putType(o *OutBuf, t u32, depth usize) decreases(depth) {
	if depth == 0 {
		return
	}
	if t == 0 {
		o.putStr("<nil>")
		return
	}
	match trec(t) {
		NoType -> {}
		Basic(k) -> o.putStr(basicName(k))
		Named(id) -> {
			r := typs.named[usize(id)]
			if r.pkg != 0 && len(strBytes(pkgs.items[usize(r.pkg)].path)) > 0 {
				o.putBytes(nameBytes(pkgs.items[usize(r.pkg)].name))
				o.putByte('.')
			}
			o.putBytes(nameBytes(r.name))
			if r.argN > 0 {
				o.putByte('[')
				putTypeList(o, tlistSlice(r.argS, r.argN), depth-1)
				o.putByte(']')
			}
		}
		Array(e, p, n) -> {
			o.putByte('[')
			if p != 0 {
				o.putBytes(nameBytes(typeName(p)))
			} else {
				o.putUint(n)
			}
			o.putByte(']')
			putType(o, e, depth-1)
		}
		Slice(e) -> {
			o.putStr("[]")
			putType(o, e, depth-1)
		}
		Pointer(e) -> {
			o.putByte('*')
			putType(o, e, depth-1)
		}
		Struct(_, _) -> {
			o.putStr("struct{")
			n := nfields(t)
			for i := usize(0); i < n; i++ {
				if i > 0 {
					o.putStr("; ")
				}
				o.putBytes(nameBytes(fieldName(t, i)))
				o.putByte(' ')
				putType(o, fieldType(t, i), depth-1)
			}
			o.putByte('}')
		}
		Enum(_, _) -> {
			o.putStr("enum{")
			n := nvariants(t)
			for i := usize(0); i < n; i++ {
				if i > 0 {
					o.putStr("; ")
				}
				o.putBytes(nameBytes(variantName(t, i)))
				m := variantPayN(t, i)
				if m > 0 {
					o.putByte('(')
					putTypeList(o, tlistSlice(variantPayS(t, i), u32(m)), depth-1)
					o.putByte(')')
				}
			}
			o.putByte('}')
		}
		Sig(eff, va, ps, pn, rs, rn, _, _) -> {
			if eff == EffDriver {
				o.putStr("driver ")
			} else if eff == EffComptime {
				o.putStr("comptime ")
			}
			o.putStr("func(")
			n := usize(pn)
			for i := usize(0); i < n; i++ {
				if i > 0 {
					o.putStr(", ")
				}
				if va && i == n-1 {
					o.putStr("...")
				}
				putType(o, tlist(ps, i), depth-1)
			}
			o.putByte(')')
			if rn == 1 {
				o.putByte(' ')
				putType(o, tlist(rs, 0), depth-1)
			} else if rn > 1 {
				o.putStr(" (")
				putTypeList(o, tlistSlice(rs, rn), depth-1)
				o.putByte(')')
			}
		}
		Code(l) -> {
			if l == 0 {
				o.putStr("Code ?")
			} else {
				o.putStr("Code ")
				o.putUint(u64(l - 1))
			}
		}
		TypeParam(nm, _, _, _) -> o.putBytes(nameBytes(nm))
		Opaque(nm, _) -> o.putBytes(nameBytes(nm))
		ConstArg(v) -> o.putUint(v)
		Tuple(s, n) -> {
			o.putByte('(')
			putTypeList(o, tlistSlice(s, n), depth-1)
			o.putByte(')')
		}
	}
}

// mtype writes a type into the diagnostic message.
func mtype(t u32) {
	o := &msgBuf
	putType(o, t, SemaDepth)
}

// ---------------------------------------------------------------------------
// Methods (types.Method) and builtin method IDs

const (
	BMNone               = 0
	BMContextDone        = 1
	BMContextErr         = 2
	BMContextWithTimeout = 3
	BMSignalsNotifyCtx   = 4
	BMNetListenTCP       = 5
	BMListenerAccept     = 6
	BMListenerAddr       = 7
	BMListenerClose      = 8
	BMConnRead           = 9
	BMConnWrite          = 10
	BMConnCloseWrite     = 11
	BMConnClose          = 12
	BMScopeAcquireSlot   = 13
	BMScopeReleaseSlot   = 14
	BMScopeGo            = 15
	BMScopeWaitTimeout   = 16
	BMScopeWait          = 17
	BMFSReadFileInto     = 18
	BMFSWriteFile        = 19
	BMFSIsDir            = 20
	BMFSListSourceFiles  = 21
	BMFSMkdirTemp        = 22
	BMFSRemoveAll        = 23
	BMEnvArgsCount       = 24
	BMEnvArg             = 25
	BMEnvGetEnv          = 26
	BMStdioWriteStdout   = 27
	BMStdioWriteStderr   = 28
	BMExecRun            = 29
)

type Method struct {
	name    u32
	recv    u32 // origin receiver type (Named)
	ptrRecv bool
	builtin u8
	rtpS    u32 // RecvTypeParams (type lists)
	rtpN    u32
	sig     u32 // signature without receiver (0 for the generic Scope methods)
	sym     u32 // user methods
	decl    u32
}

type MethodTable struct {
	items [MaxMethods]Method
	count usize
}

var meths MethodTable

func newMethod(m Method) u32 {
	if meths.count == 0 {
		meths.count = 1
	}
	if meths.count >= MaxMethods {
		setFull("methods")
		return 0
	}
	id := meths.count
	meths.count++
	meths.items[id] = m
	return u32(id)
}

func methodEffect(m u32) u8 {
	s := meths.items[usize(m)].sig
	if s != 0 {
		return sigEffect(s)
	}
	return EffTotal
}

// ---------------------------------------------------------------------------
// Predeclared named types and their methods (types/universe.go)

var univNamed [NumBuiltins]u32
var slotT u32

func mkUnivNamed(b u8, under u32, class u8) u32 {
	t := newNamed(internStr(builtinName(b)), builtinSym[usize(b)], 0, b)
	setNamedUnder(t, under)
	setNamedClass(t, class)
	univNamed[usize(b)] = t
	return t
}

// addUnivMethod pushes one builtin method onto ustack (params/results are
// on the type stack [m1:m2] / [m2:top]).
func addUnivMethod(recv u8, name string, id u8, variadic bool, eff u8, m1 usize, m2 usize) {
	sig := u32(0)
	if id != BMScopeAcquireSlot && id != BMScopeReleaseSlot && id != BMScopeGo {
		sig = mkSig(eff, variadic, m1, m2, tmark())
	} else {
		tdiscard(m1)
	}
	var m Method
	m.name = internStr(name)
	m.recv = univNamed[usize(recv)]
	m.builtin = id
	m.sig = sig
	upush(newMethod(m))
}

func setUnivMethods(recv u8, mark usize) {
	s, n := ucommit(mark)
	setNamedMethods(univNamed[usize(recv)], s, n)
}

func initUnivTypes() {
	duration := mkUnivNamed(BTDuration, TyU64, ClassValue)
	signal := mkUnivNamed(BTSignal, TyU8, ClassValue)
	sm := tmark()
	tpush(internStr("Code"))
	tpush(TyInt)
	_ = mkUnivNamed(BTExitStatus, mkStruct(sm), ClassValue)
	for b := u8(BTNet); b <= BTExec; b++ {
		if b == BTNet || b == BTSignals || b == BTClock || b == BTContext || b == BTScope || b == BTFS || b == BTEnv || b == BTStdio || b == BTExec {
			_ = mkUnivNamed(b, newOpaque(internStr(builtinName(b)), b), ClassScoped)
		}
	}
	_ = mkUnivNamed(BTListener, newOpaque(internStr("Listener"), BTListener), ClassLinear)
	_ = mkUnivNamed(BTConn, newOpaque(internStr("Conn"), BTConn), ClassLinear)
	m0 := tmark()
	_ = mkUnivNamed(BTCancelFunc, mkSig(EffTotal, false, m0, m0, m0), ClassLinear)
	slot := mkUnivNamed(BTSlot, newOpaque(internStr("Slot"), BTSlot), ClassLinear)
	slotT = newTypeParam(internStr("T"), 0, 0, 0)
	sp := tmark()
	tpush(slotT)
	s2, n2 := tcommitStack(sp)
	setNamedTParams(slot, s2, n2)
	_ = mkUnivNamed(BTFieldCode, newOpaque(internStr("FieldCode"), BTFieldCode), ClassValue)

	ctx := univNamed[BTContext]
	bytesT := mkSlice(TyU8)
	strs := mkSlice(TyString)
	// Context
	um := ustack.count
	m := tmark()
	tpush(TyBool)
	addUnivMethod(BTContext, "Done", BMContextDone, false, EffTotal, m, m)
	m = tmark()
	tpush(TyError)
	addUnivMethod(BTContext, "Err", BMContextErr, false, EffTotal, m, m)
	m = tmark()
	tpush(duration)
	tpush(ctx)
	addUnivMethod(BTContext, "WithTimeout", BMContextWithTimeout, false, EffTotal, m, m+1)
	setUnivMethods(BTContext, um)
	// Signals
	um = ustack.count
	m = tmark()
	tpush(signal)
	tpush(ctx)
	tpush(univNamed[BTCancelFunc])
	addUnivMethod(BTSignals, "NotifyContext", BMSignalsNotifyCtx, true, EffTotal, m, m+1)
	setUnivMethods(BTSignals, um)
	// Net
	um = ustack.count
	m = tmark()
	tpush(TyString)
	tpush(univNamed[BTListener])
	tpush(TyError)
	addUnivMethod(BTNet, "ListenTCP", BMNetListenTCP, false, EffTotal, m, m+1)
	setUnivMethods(BTNet, um)
	// Listener
	um = ustack.count
	m = tmark()
	tpush(ctx)
	tpush(univNamed[BTConn])
	tpush(TyError)
	addUnivMethod(BTListener, "Accept", BMListenerAccept, false, EffTotal, m, m+1)
	m = tmark()
	tpush(TyString)
	addUnivMethod(BTListener, "Addr", BMListenerAddr, false, EffTotal, m, m)
	m = tmark()
	tpush(TyError)
	addUnivMethod(BTListener, "Close", BMListenerClose, false, EffTotal, m, m)
	setUnivMethods(BTListener, um)
	// Conn
	um = ustack.count
	m = tmark()
	tpush(ctx)
	tpush(bytesT)
	tpush(TyUsize)
	tpush(TyError)
	addUnivMethod(BTConn, "Read", BMConnRead, false, EffTotal, m, m+2)
	m = tmark()
	tpush(ctx)
	tpush(bytesT)
	tpush(TyUsize)
	tpush(TyError)
	addUnivMethod(BTConn, "Write", BMConnWrite, false, EffTotal, m, m+2)
	m = tmark()
	tpush(TyError)
	addUnivMethod(BTConn, "CloseWrite", BMConnCloseWrite, false, EffTotal, m, m)
	m = tmark()
	tpush(TyError)
	addUnivMethod(BTConn, "Close", BMConnClose, false, EffTotal, m, m)
	setUnivMethods(BTConn, um)
	// Scope
	um = ustack.count
	m = tmark()
	addUnivMethod(BTScope, "AcquireSlot", BMScopeAcquireSlot, false, EffTotal, m, m)
	addUnivMethod(BTScope, "ReleaseSlot", BMScopeReleaseSlot, false, EffTotal, m, m)
	addUnivMethod(BTScope, "Go", BMScopeGo, false, EffTotal, m, m)
	m = tmark()
	tpush(duration)
	tpush(TyBool)
	addUnivMethod(BTScope, "WaitTimeout", BMScopeWaitTimeout, false, EffTotal, m, m+1)
	m = tmark()
	addUnivMethod(BTScope, "Wait", BMScopeWait, false, EffTotal, m, m)
	setUnivMethods(BTScope, um)
	// FS
	um = ustack.count
	m = tmark()
	tpush(TyString)
	tpush(bytesT)
	tpush(TyUsize)
	tpush(TyError)
	addUnivMethod(BTFS, "ReadFileInto", BMFSReadFileInto, false, EffTotal, m, m+2)
	m = tmark()
	tpush(TyString)
	tpush(bytesT)
	tpush(TyError)
	addUnivMethod(BTFS, "WriteFile", BMFSWriteFile, false, EffTotal, m, m+2)
	m = tmark()
	tpush(TyString)
	tpush(TyBool)
	addUnivMethod(BTFS, "IsDir", BMFSIsDir, false, EffTotal, m, m+1)
	m = tmark()
	tpush(TyString)
	tpush(strs)
	tpush(TyUsize)
	tpush(TyError)
	addUnivMethod(BTFS, "ListSourceFiles", BMFSListSourceFiles, false, EffTotal, m, m+2)
	m = tmark()
	tpush(TyString)
	tpush(TyString)
	tpush(TyError)
	addUnivMethod(BTFS, "MkdirTemp", BMFSMkdirTemp, false, EffTotal, m, m+1)
	m = tmark()
	tpush(TyString)
	tpush(TyError)
	addUnivMethod(BTFS, "RemoveAll", BMFSRemoveAll, false, EffTotal, m, m+1)
	setUnivMethods(BTFS, um)
	// Env
	um = ustack.count
	m = tmark()
	tpush(TyUsize)
	addUnivMethod(BTEnv, "ArgsCount", BMEnvArgsCount, false, EffTotal, m, m)
	m = tmark()
	tpush(TyUsize)
	tpush(TyString)
	addUnivMethod(BTEnv, "Arg", BMEnvArg, false, EffTotal, m, m+1)
	m = tmark()
	tpush(TyString)
	tpush(TyString)
	tpush(TyBool)
	addUnivMethod(BTEnv, "GetEnv", BMEnvGetEnv, false, EffTotal, m, m+1)
	setUnivMethods(BTEnv, um)
	// Stdio
	um = ustack.count
	m = tmark()
	tpush(bytesT)
	tpush(TyError)
	addUnivMethod(BTStdio, "WriteStdout", BMStdioWriteStdout, false, EffTotal, m, m+1)
	m = tmark()
	tpush(bytesT)
	tpush(TyError)
	addUnivMethod(BTStdio, "WriteStderr", BMStdioWriteStderr, false, EffTotal, m, m+1)
	setUnivMethods(BTStdio, um)
	// Exec
	um = ustack.count
	m = tmark()
	tpush(ctx)
	tpush(TyString)
	tpush(strs)
	tpush(strs)
	tpush(TyString)
	tpush(bytesT)
	tpush(univNamed[BTExitStatus])
	tpush(TyUsize)
	tpush(TyError)
	addUnivMethod(BTExec, "Run", BMExecRun, false, EffDriver, m, m+6)
	setUnivMethods(BTExec, um)
}

// predeclaredType returns the type of a predeclared type symbol (0 for
// Code, El and anything that is not a type).
func predeclaredType(b u8) u32 {
	if b == BTByte {
		return TyU8
	}
	if b >= BTBool && b <= BTUsize {
		return u32(b) + 1 // BTBool..BTUsize line up with BkBool..BkUsize
	}
	if b == BTString {
		return TyString
	}
	if b == BTError {
		return TyError
	}
	if b == BTCode || b == BTEl {
		return 0
	}
	return univNamed[usize(b)]
}

// ---------------------------------------------------------------------------
// Typed model records (types.Info)

// Expression kinds (types.ExprKind).
const (
	KNone        = 0
	KValue       = 1
	KVar         = 2
	KConst       = 3
	KType        = 4
	KNoValue     = 5
	KBuiltin     = 6
	KFunc        = 7
	KPackage     = 8
	KVariantCtor = 9
)

// Call kinds (types.CallKind).
const (
	CallInvalid     = 0
	CallFunc        = 1
	CallMethod      = 2
	CallBuiltinMeth = 3
	CallBuiltin     = 4
	CallConversion  = 5
	CallVariant     = 6
	CallValue       = 7
)

// Selection kinds (types.SelKind).
const (
	SelField   = 0
	SelMethod  = 1
	SelVariant = 2
)

// FuncInfo describes a function declaration, method or function literal.
type FuncInfo struct {
	sym       u32 // 0 for literals
	decl      u32 // FuncDecl node (0 for literals)
	lit       u32 // FuncLit node (0 for declarations)
	outer     u32 // enclosing FuncInfo of a literal
	effect    u8
	sig       u32
	method    u32
	recvSym   u32
	parS      u32 // parameter Ident nodes in order (ulists); symbol = defs[ident] (0 for `_`)
	parN      u32
	tpS       u32 // TypeParams (type lists)
	tpN       u32
	measure u32 // measure expression node (0 = none)
	body      u32 // BlockStmt node
	callH     u32 // calls in the body, source order (cells of CallExpr nodes)
	callT     u32
	litH      u32 // directly nested literals (cells of FuncInfo IDs)
	litT      u32
}

type FuncTable struct {
	items  [MaxFuncs]FuncInfo
	count  usize
	orderS u32 // Info.Funcs order (ulists), set by finish
	orderN u32
	main   u32
}

var funcs FuncTable

func newFuncInfo(fi FuncInfo) u32 {
	if funcs.count == 0 {
		funcs.count = 1
	}
	if funcs.count >= MaxFuncs {
		setFull("functions")
		return 0
	}
	id := funcs.count
	funcs.count++
	funcs.items[id] = fi
	return u32(id)
}

// Call describes a CallExpr (types.Call).
type Call struct {
	kind         u8
	builtin      u8
	effect       u8
	folded       bool
	resourceCtor bool
	consumesRecv bool
	consumesArg0 bool // ConsumesArgs == [0]
	callee       u32  // function/method symbol, or the builtin's universe symbol
	method       u32
	recv         u32 // receiver expression node
	recvType     u32
	taS          u32 // TypeArgs (type lists)
	taN          u32
	sig          u32
	conv         u32
	variantType  u32 // enum type (as written) of CallVariant
	variantEnum  u32 // its underlying Enum TypeID
	variant      u32 // variant index
	fmtOK        bool // formatTo (v0.2) checked without errors: Call.Format != nil
	fmtS         u32  // its per-argument (op, method) pairs (ulists)
	fmtN         u32  // 2 * number of formatted arguments
}

type CallTable struct {
	items [MaxCalls]Call
	count usize
}

var callTab CallTable

// Selection describes a SelectorExpr x.f (types.Selection).
type Selection struct {
	kind     u8
	indirect bool
	recv     u32 // type of x (SelVariant: the enum type)
	ctype    u32 // SelField: struct TypeID; SelVariant: underlying Enum TypeID
	index    u32 // field or variant index
	method   u32 // SelMethod
}

type SelTable struct {
	items [MaxSels]Selection
	count usize
}

var selTab SelTable

// Instance is an instantiation of a generic function or type.
type Inst struct {
	sym     u32 // generic function/type symbol
	named   u32 // instance type (0 for functions)
	argS    u32 // type args (type lists)
	argN    u32
	sig     u32 // instantiated signature (functions)
	generic bool
}

type InstTable struct {
	items [MaxInsts]Inst
	count usize
}

var insts InstTable

// Per-node tables of the typed model.
var ntype [MaxNodes]u32    // TypeOf
var nmode [MaxNodes]u8     // KindOf (ExprKind)
var nval [MaxNodes]u32     // ValueOf: value slot (0 = none)
var ncall [MaxNodes]u32    // CallOf
var nsel [MaxNodes]u32     // SelectionOf
var ninst [MaxNodes]u32    // InstanceOf
var nvarEnum [MaxNodes]u32 // VariantOf (CtorPattern): underlying Enum TypeID
var nvarIdx [MaxNodes]u32  //   and variant index
var nfunc [MaxNodes]u32    // FuncDecl/FuncLit -> FuncInfo

// funcOfSym returns the FuncInfo of a function or method symbol.
func funcOfSym(s u32) u32 {
	if s == 0 || symKind(s) != SymFunc {
		return 0
	}
	d := syms.items[usize(s)].decl
	if d == 0 || nkind(d) != NkFuncDecl {
		return 0
	}
	return nfunc[usize(d)]
}

// mfuncName writes FuncInfo.Name(): "f", "T.m" or "func literal".
func mfuncName(fi u32) {
	s := funcs.items[usize(fi)].sym
	if s == 0 {
		ms("func literal")
		return
	}
	if syms.items[usize(s)].recvType != 0 {
		mname(syms.items[usize(s)].recvType)
		mbyte('.')
	}
	mname(syms.items[usize(s)].name)
}

// ---------------------------------------------------------------------------
// Instantiation (typexpr.go: instantiate, completeInstance, subst)

var pendOrigin [MaxPending]u32
var pendInst [MaxPending]u32
var npend usize

// findInstRec finds the Info.InstanceList record of sym[args].
func findInstRec(sym u32, args []u32) u32 {
	n := insts.count
	for i := usize(1); i < n; i++ {
		if insts.items[i].sym == sym && u32sEqual(tlistSlice(insts.items[i].argS, insts.items[i].argN), args) {
			return u32(i)
		}
	}
	return 0
}

func newInstRec(r Inst) u32 {
	if insts.count == 0 {
		insts.count = 1
	}
	if insts.count >= MaxInsts {
		setFull("instances")
		return 0
	}
	id := insts.count
	insts.count++
	insts.items[id] = r
	return u32(id)
}

// instantiate returns the canonical instance origin[args]; node (if not 0)
// records the instantiation in ninst.
func instantiate(origin u32, args []u32, node u32, depth usize) u32 decreases(depth) {
	if depth == 0 {
		setFull("recursion depth")
		return TyInvalid
	}
	o := typs.named[usize(namedID(origin))]
	var r NamedRec
	r.origin = origin
	r.name = o.name
	r.sym = o.sym
	r.pkg = o.pkg
	r.builtin = o.builtin
	if o.clsOK && o.builtin != 0 {
		r.clsOK = true
		r.cls = o.cls
	}
	r.argS, r.argN = tcommit(args)
	nid := newNamedRec(r)
	if nid == 0 {
		return TyInvalid
	}
	inst, isNew := internType(TypeRec.Named(nid))
	if inst == TyInvalid {
		return TyInvalid
	}
	if isNew {
		if o.under == 0 {
			if npend >= MaxPending {
				setFull("pending instances")
			} else {
				pendOrigin[npend] = origin
				pendInst[npend] = inst
				npend++
			}
		} else {
			completeInstance(inst, depth-1)
		}
	}
	ia := namedArgs(inst)
	rec := findInstRec(o.sym, ia)
	if rec == 0 {
		var ir Inst
		ir.sym = o.sym
		ir.named = inst
		ir.argS, ir.argN = namedArgList(inst)
		ir.generic = anyTypeParam(ia)
		rec = newInstRec(ir)
	}
	if node != 0 {
		ninst[usize(node)] = rec
	}
	return inst
}

func completeInstance(inst u32, depth usize) decreases(depth) {
	if depth == 0 {
		return
	}
	o := namedOrigin(inst)
	u := namedUnder(o)
	if u != 0 && isOpaqueT(u) {
		setNamedUnder(inst, u)
		return
	}
	tpS, tpN := namedTParamList(o)
	argS, argN := namedArgList(inst)
	setNamedUnder(inst, subst(u, tpS, tpN, argS, argN, depth-1))
}

// completePending completes the instances of origin created before its
// underlying type was known.
func completePending(origin u32) {
	n := npend
	for i := usize(0); i < n; i++ {
		if pendOrigin[i] == origin {
			pendOrigin[i] = 0
			completeInstance(pendInst[i], SemaDepth)
		}
	}
}

// substLookup returns the binding of type parameter t (0 if unbound).
func substLookup(t u32, tpS u32, tpN u32, argS u32, argN u32) u32 {
	n := usize(tpN)
	if usize(argN) < n {
		n = usize(argN)
	}
	for i := usize(0); i < n; i++ {
		if tlist(tpS, i) == t {
			return tlist(argS, i)
		}
	}
	return 0
}

// subst replaces the type parameters tps[i] by args[i] in t.
func subst(t u32, tpS u32, tpN u32, argS u32, argN u32, depth usize) u32 decreases(depth) {
	if depth == 0 {
		setFull("recursion depth")
		return t
	}
	if t == 0 || tpN == 0 || argN == 0 {
		return t
	}
	match trec(t) {
		TypeParam(_, _, _, _) -> {
			b := substLookup(t, tpS, tpN, argS, argN)
			if b != 0 {
				return b
			}
			return t
		}
		Named(id) -> {
			r := typs.named[usize(id)]
			if r.origin == 0 {
				return t
			}
			m := tmark()
			changed := false
			for i := usize(0); i < usize(r.argN); i++ {
				a := tlist(r.argS, i)
				x := subst(a, tpS, tpN, argS, argN, depth-1)
				if x != a {
					changed = true
				}
				tpush(x)
			}
			if !changed {
				tdiscard(m)
				return t
			}
			s, cnt := tcommitStack(m)
			return instantiate(r.origin, tlistSlice(s, cnt), 0, depth-1)
		}
		Array(e, p, n) -> {
			elem := subst(e, tpS, tpN, argS, argN, depth-1)
			if p != 0 {
				b := substLookup(p, tpS, tpN, argS, argN)
				if b != 0 && isConstArgT(b) {
					return mkArray(constArgVal(b), 0, elem)
				}
				if b != 0 && isTypeParamT(b) {
					return mkArray(0, b, elem)
				}
			}
			return mkArray(n, p, elem)
		}
		Slice(e) -> {
			return mkSlice(subst(e, tpS, tpN, argS, argN, depth-1))
		}
		Pointer(e) -> {
			return mkPointer(subst(e, tpS, tpN, argS, argN, depth-1))
		}
		Struct(_, _) -> {
			m := tmark()
			n := nfields(t)
			for i := usize(0); i < n; i++ {
				nm := fieldName(t, i)
				ft := subst(fieldType(t, i), tpS, tpN, argS, argN, depth-1)
				tpush(nm)
				tpush(ft)
			}
			return mkStruct(m)
		}
		Enum(_, _) -> {
			m := tmark()
			n := nvariants(t)
			for i := usize(0); i < n; i++ {
				pm := tmark()
				pn := variantPayN(t, i)
				for j := usize(0); j < pn; j++ {
					tpush(subst(variantPay(t, i, j), tpS, tpN, argS, argN, depth-1))
				}
				ps, pc := tcommitStack(pm)
				tpush(variantName(t, i))
				tpush(ps)
				tpush(pc)
			}
			return mkEnum(m)
		}
		Sig(eff, va, ps, pn, rs, rn, _, _) -> {
			m1 := tmark()
			for i := usize(0); i < usize(pn); i++ {
				tpush(subst(tlist(ps, i), tpS, tpN, argS, argN, depth-1))
			}
			m2 := tmark()
			for i := usize(0); i < usize(rn); i++ {
				tpush(subst(tlist(rs, i), tpS, tpN, argS, argN, depth-1))
			}
			m3 := tmark()
			return mkSig(eff, va, m1, m2, m3)
		}
		Tuple(s, n) -> {
			m := tmark()
			for i := usize(0); i < usize(n); i++ {
				tpush(subst(tlist(s, i), tpS, tpN, argS, argN, depth-1))
			}
			return mkTupleStack(m)
		}
		NoType | Basic(_) | Code(_) | ConstArg(_) | Opaque(_, _) -> {
			return t
		}
	}
}
