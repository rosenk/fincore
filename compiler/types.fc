// Error sentinel IDs (must match runtime/linux_amd64/sys.s .L_err_table).
const (
	ErrIDNil       u32 = 0
	ErrIDEOF       u32 = 1
	ErrIDTimeout   u32 = 2
	ErrIDCancelled u32 = 3
	ErrIDZeroWrite u32 = 4
	ErrIDClosed    u32 = 5
	ErrIDIO        u32 = 6
	ErrIDNotFound  u32 = 7
	ErrIDMaxDepth  u32 = 8
	ErrIDArenaFull u32 = 9
	ErrIDExec      u32 = 10
	ErrIDParse     u32 = 11
