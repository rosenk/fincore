// scope.fc — the Layer-3 scope/depth escape checker (port of finc0's
// bootstrap/internal/scope: doc.go and scope.go; the linearity analysis is
// in linear.fc). It runs on a well-typed program (after checkProgram
// reported nothing) and reports E3002 (SCOPE_ESCAPE), E3003
// (USE_AFTER_MOVE), E3004 (DISCARDED_LINEAR) and E3005
// (LINEAR_RESOURCE_LEAK). See finc0's scope/doc.go for the rules.
//
// Mapping onto the arenas:
//
//   - An origin (depth, region) is packed into a u64: depth << 32 | region
//     SymID (0 = no region).
//   - The per-declaration maps of finc0's fnState (depth, content, addr,
//     fixed) are per-symbol arrays stamped with an epoch (one epoch per
//     checked declaration); a stale stamp reads as "absent".
//   - The value flows (sym, rhs) of a declaration are a flat array reset
//     per declaration; the content fixpoint is bounded by the height of
//     the origin lattice (every content can only grow).
//   - The "reported" map of finc0 (one diagnostic per code and position)
//     is a scan of the diagnostics recorded so far (the pass only runs
//     when there are none from earlier phases).
package main

// Internal depth levels: 0 = package level, 1 = the caller of a declared
// function, 2 = the body of a declared function.
const (
	ScLevelGlobal = 0
	ScLevelCaller = 1
	ScLevelFunc   = 2

	MaxScDefs = 262_144 // value flows of one declaration (with its literals)
)

// Per-declaration tables (finc0's fnState), valid when scStamp[s] == scEpoch.
var scEpoch u32
var scStamp [MaxSyms]u32
var scDep [MaxSyms]u32
var scHasDep [MaxSyms]bool
var scCont [MaxSyms]u64
var scHasCont [MaxSyms]bool
var scAddr [MaxSyms]bool
var scFixed [MaxSyms]bool

var scDefSym [MaxScDefs]u32
var scDefRhs [MaxScDefs]u32
var scNDefs usize
var scMaxDepth u32

// Whole-pass tables.
var scLeaked [MaxSyms]bool    // E3005 is reported once per variable
var scSliceMemo [MaxTypes]u8  // hasSlice memo: 0 unknown, 1 false (or in progress), 2 true
var scLitDone [MaxFuncs]bool  // literals whose linearity was analysed

// Walker state (phase 1 collects, phase 2 checks).
var wDepth u32
var wFnDepth u32
var wCollect bool

// scopeCheck runs the scope and linearity checks (S2-S5) on every function
// declaration with a body, in Info.Funcs order (literals are checked with
// their enclosing declaration).
func scopeCheck() {
	n := usize(funcs.orderN)
	st := funcs.orderS
	for i := usize(0); i < n; i++ {
		fi := uat(st, i)
		if funcs.items[usize(fi)].decl == 0 || funcs.items[usize(fi)].body == 0 {
			continue
		}
		scCheckDecl(fi)
		if semaFull {
			return
		}
	}
}

// scReport records the diagnostic mbuf[:k] at node n unless one with the
// same code was already reported at the same position.
func scReport(code u32, n u32, k usize) {
	if n == 0 {
		return
	}
	f := u32(nfile(n))
	line := nodes.items[usize(n)].sLine
	col := nodes.items[usize(n)].sCol
	cnt := diags.count
	for i := usize(0); i < cnt; i++ {
		if diags.code[i] == code && diags.file[i] == f && diags.line[i] == line && diags.col[i] == col {
			return
		}
	}
	errAt(code, n, k)
}

// ---------------------------------------------------------------------------
// Origins: depth << 32 | region symbol

func scOrig(d u32, r u32) u64 {
	return u64(d)<<32 | u64(r)
}

func scOD(o u64) u32 {
	return u32(o >> 32)
}

func scOR(o u64) u32 {
	return u32(o & 0xFFFF_FFFF)
}

// Origin renders origin.String().
type Origin u64

func (o Origin) Format(dst []byte) usize {
	d := scOD(u64(o))
	r := scOR(u64(o))
	if d == ScLevelGlobal {
		return formatTo(dst, "package-level storage")
	}
	if r != 0 {
		return formatTo(dst, "the storage of parameter %v (depth %d)", NameRef(symName(r)), d-1)
	}
	if d == ScLevelCaller {
		return formatTo(dst, "the caller's storage")
	}
	return formatTo(dst, "storage at depth %d", d-1)
}

func scJoin(a u64, b u64) u64 {
	ad := scOD(a)
	bd := scOD(b)
	if ad > bd {
		return a
	}
	if bd > ad {
		return b
	}
	if scOR(a) == scOR(b) {
		return a
	}
	return scOrig(ad, 0)
}

// scFits reports whether a value of origin o may be stored in storage s.
func scFits(o u64, s u64) bool {
	od := scOD(o)
	sd := scOD(s)
	return od < sd || od == sd && (scOR(s) == 0 || scOR(s) == scOR(o))
}

// ---------------------------------------------------------------------------
// Per-declaration symbol tables

func scTouch(s u32) {
	if scStamp[usize(s)] == scEpoch {
		return
	}
	scStamp[usize(s)] = scEpoch
	scDep[usize(s)] = 0
	scHasDep[usize(s)] = false
	scCont[usize(s)] = 0
	scHasCont[usize(s)] = false
	scAddr[usize(s)] = false
	scFixed[usize(s)] = false
}

func scSetDepth(s u32, d u32) {
	scTouch(s)
	scDep[usize(s)] = d
	scHasDep[usize(s)] = true
}

func scSetCont(s u32, o u64) {
	scTouch(s)
	scCont[usize(s)] = o
	scHasCont[usize(s)] = true
}

func scAddDef(s u32, rhs u32) {
	if scNDefs >= MaxScDefs {
		setFull("scope checker value flows")
		return
	}
	scDefSym[scNDefs] = s
	scDefRhs[scNDefs] = rhs
	scNDefs++
}

func scParamSym(fi u32, i usize) u32 {
	return defs[usize(uat(funcs.items[usize(fi)].parS, i))]
}

func scCheckDecl(fi u32) {
	scEpoch++
	scNDefs = 0
	scMaxDepth = ScLevelFunc
	rs := funcs.items[usize(fi)].recvSym
	if rs != 0 {
		scSetDepth(rs, ScLevelFunc)
		scSetCont(rs, scOrig(ScLevelCaller, rs))
	}
	np := usize(funcs.items[usize(fi)].parN)
	for i := usize(0); i < np; i++ {
		p := scParamSym(fi, i)
		if p != 0 {
			scSetDepth(p, ScLevelFunc)
			scSetCont(p, scOrig(ScLevelCaller, p))
		}
	}
	body := funcs.items[usize(fi)].body
	// Phase 1: depths, address-taken variables, value flows.
	wDepth = ScLevelFunc
	wFnDepth = ScLevelFunc
	wCollect = true
	wBlock(body, SemaDepth)
	scFixpoint()
	// Phase 2: S2-S4 and E3004.
	wDepth = ScLevelFunc
	wFnDepth = ScLevelFunc
	wCollect = false
	wBlock(body, SemaDepth)
	// S5 / E3003.
	lnLinearity(fi)
}

// scFixpoint computes the content origin of every local variable. Every
// update only raises a content in the origin lattice (at most two values
// per depth), so the number of rounds is bounded.
func scFixpoint() {
	nd := scNDefs
	lim := nd*(2*usize(scMaxDepth)+6) + 2
	for it := usize(0); it < lim; it++ {
		changed := false
		for j := usize(0); j < nd; j++ {
			s := scDefSym[j]
			scTouch(s)
			if scFixed[usize(s)] {
				continue
			}
			o := scOrigin(scDefRhs[j], SemaDepth)
			had := scHasCont[usize(s)]
			old := scCont[usize(s)]
			n := o
			if had {
				n = scJoin(old, o)
			}
			if scHasDep[usize(s)] && !scFits(n, scOrig(scDep[usize(s)], 0)) {
				n = scOrig(scDep[usize(s)], 0) // an S2 violation, reported in phase 2
			}
			if !had || n != old {
				scSetCont(s, n)
				changed = true
			}
		}
		if !changed {
			break
		}
	}
}

// ---------------------------------------------------------------------------
// Types

// scTracked reports whether values of type t may refer to stack storage:
// Scoped types and Value types that contain slices.
func scTracked(t u32) bool {
	if t == 0 {
		return false
	}
	return isScoped(t) || scHasSlice(t, SemaDepth)
}

func scHasSlice(t u32, dp usize) bool decreases(dp) {
	if dp == 0 {
		tooDeep()
		return false
	}
	if t == 0 {
		return false
	}
	m := scSliceMemo[usize(t)]
	if m != 0 {
		return m == 2
	}
	scSliceMemo[usize(t)] = 1 // cycles
	r := false
	match trec(t) {
		Named(_) -> {
			u := namedUnder(t)
			if u != 0 {
				r = scHasSlice(u, dp-1)
			}
		}
		Slice(_) -> r = true
		Array(e, ..) -> r = scHasSlice(e, dp-1)
		Struct(..) -> {
			n := nfields(t)
			for i := usize(0); i < n; i++ {
				if !r {
					r = scHasSlice(fieldType(t, i), dp-1)
				}
			}
		}
		Enum(..) -> {
			n := nvariants(t)
			for i := usize(0); i < n; i++ {
				m2 := variantPayN(t, i)
				for j := usize(0); j < m2; j++ {
					if !r {
						r = scHasSlice(variantPay(t, i, j), dp-1)
					}
				}
			}
		}
		Tuple(..) -> {
			n := tupleN(t)
			for i := usize(0); i < n; i++ {
				if !r {
					r = scHasSlice(tupleAt(t, i), dp-1)
				}
			}
		}
		NoType | Basic(_) | Sig(..) | Pointer(_) | Code(_) | TypeParam(..) | ConstArg(_) | Opaque(..) -> {}
	}
	if r {
		scSliceMemo[usize(t)] = 2
	} else {
		scSliceMemo[usize(t)] = 1
	}
	return r
}

func scIsArray(t u32) bool {
	return isArrayT(underlying(t))
}

// ---------------------------------------------------------------------------
// Origins of expressions

// scVarSym returns the variable symbol an identifier refers to (0 for
// blank, functions, constants, packages ...).
func scVarSym(id u32) u32 {
	if id == 0 {
		return 0
	}
	s := symbolOf(id)
	if s == 0 || symKind(s) != SymVar {
		return 0
	}
	return s
}

// scLoad is the origin of the value held by variable s.
func scLoad(s u32) u64 {
	if symIsGlobal(s) {
		return scOrig(ScLevelGlobal, 0)
	}
	scTouch(s)
	if scAddr[usize(s)] {
		return scStorageOf(s)
	}
	return scCont[usize(s)]
}

// scStorageOf is the storage origin of variable s itself.
func scStorageOf(s u32) u64 {
	if symIsGlobal(s) {
		return scOrig(ScLevelGlobal, 0)
	}
	scTouch(s)
	return scOrig(scDep[usize(s)], 0)
}

// scRootVar returns the variable whose own storage contains the
// addressable expression e (x, x.f, x[i] on arrays), or 0 if e is reached
// through a pointer or slice.
func scRootVar(e0 u32, dp usize) u32 decreases(dp) {
	if dp == 0 {
		tooDeep()
		return 0
	}
	e := unparen(e0)
	if e == 0 {
		return 0
	}
	k := nkind(e)
	if k == NkIdent {
		return scVarSym(e)
	}
	if k == NkSelectorExpr {
		sel := nsel[usize(e)]
		if sel == 0 {
			return scVarSym(nb(e)) // pkg.Var
		}
		if selTab.items[usize(sel)].kind != SelField || selTab.items[usize(sel)].indirect {
			return 0
		}
		return scRootVar(na(e), dp-1)
	}
	if k == NkIndexExpr {
		if scIsArray(ntype[usize(na(e))]) {
			return scRootVar(na(e), dp-1)
		}
	}
	return 0
}

// scStorage is the origin of the storage denoted by the addressable
// expression e.
func scStorage(e0 u32, dp usize) u64 decreases(dp) {
	if dp == 0 {
		tooDeep()
		return 0
	}
	e := unparen(e0)
	if e == 0 {
		return 0
	}
	k := nkind(e)
	if k == NkIdent {
		s := scVarSym(e)
		if s != 0 {
			return scStorageOf(s)
		}
	} else if k == NkSelectorExpr {
		sel := nsel[usize(e)]
		if sel == 0 {
			return scOrig(ScLevelGlobal, 0) // pkg.Var
		}
		if selTab.items[usize(sel)].indirect {
			return scOrigin(na(e), dp-1)
		}
		return scStorage(na(e), dp-1)
	} else if k == NkIndexExpr {
		if scIsArray(ntype[usize(na(e))]) {
			return scStorage(na(e), dp-1)
		}
		return scOrigin(na(e), dp-1) // slice or pointer to array
	} else if k == NkUnaryExpr {
		if nop(e) == OpDeref {
			return scOrigin(na(e), dp-1)
		}
	}
	return scOrigin(e, dp-1)
}

// scOrigin computes the origin of the value of e.
func scOrigin(e0 u32, dp usize) u64 decreases(dp) {
	if dp == 0 {
		tooDeep()
		return 0
	}
	e := unparen(e0)
	if e == 0 {
		return 0
	}
	k := nkind(e)
	if k == NkIdent {
		s := scVarSym(e)
		if s != 0 {
			return scLoad(s)
		}
	} else if k == NkUnaryExpr {
		if nop(e) == OpAddr {
			return scStorage(na(e), dp-1)
		}
		if nop(e) == OpDeref {
			return scOrigin(na(e), dp-1)
		}
	} else if k == NkSelectorExpr {
		sel := nsel[usize(e)]
		if sel == 0 {
			return scOrig(ScLevelGlobal, 0)
		}
		if selTab.items[usize(sel)].kind == SelField {
			return scOrigin(na(e), dp-1)
		}
	} else if k == NkIndexExpr {
		if ninst[usize(e)] != 0 {
			return 0
		}
		return scOrigin(na(e), dp-1)
	} else if k == NkSliceExpr {
		if scIsArray(ntype[usize(na(e))]) {
			return scStorage(na(e), dp-1)
		}
		return scOrigin(na(e), dp-1)
	} else if k == NkCallExpr {
		return scCallOrigin(e, dp-1)
	} else if k == NkStructLit {
		o := u64(0)
		n := l1len(e)
		for i := usize(0); i < n; i++ {
			v := nb(l1at(e, i))
			if scTracked(ntype[usize(v)]) {
				o = scJoin(o, scOrigin(v, dp-1))
			}
		}
		return o
	} else if k == NkMatchExpr {
		// v0.2: the join of the arm values (bindings carry the
		// scrutinee's origin, see wExpr).
		o := u64(0)
		n := l1len(e)
		for i := usize(0); i < n; i++ {
			o = scJoin(o, scOrigin(nb(l1at(e, i)), dp-1))
		}
		return o
	} else if k == NkFuncLit {
		o := u64(0)
		if nfunc[usize(e)] == 0 {
			return o
		}
		c := litCapHead[usize(e)]
		for g := usize(0); g < MaxCells; g++ {
			if c == 0 {
				break
			}
			s := cellVal(c)
			if scTracked(syms.items[usize(s)].typ) {
				o = scJoin(o, scLoad(s))
			}
			c = cellNext(c)
		}
		return o
	}
	return 0
}

func scCallOrigin(e u32, dp usize) u64 decreases(dp) {
	if dp == 0 {
		tooDeep()
		return 0
	}
	ci := ncall[usize(e)]
	o := u64(0)
	if ci == 0 {
		return o
	}
	nargs := l1len(e)
	match callTab.items[usize(ci)].kind {
		Conversion(_) -> {
			if nargs == 1 {
				return scOrigin(l1at(e, 0), dp-1)
			}
			return o
		}
		Method(_, _, r, true) | BuiltinMeth(_, r, true) -> o = scStorage(r, dp-1) // x.M() means (&x).M() (v0.2)
		Method(_, _, r, false) | BuiltinMeth(_, r, false) -> {
			if r != 0 && scTracked(ntype[usize(r)]) {
				o = scOrigin(r, dp-1)
			}
		}
		Value -> o = scOrigin(na(e), dp-1)
		Builtin(b, ..) if b is BFStrBytes | BFBytesToStr | BFNewContext | BFNewScope | BFFormatTo -> return o // views of immutable strings / fresh runtime resources
		Invalid | Func(..) | Builtin(..) | Variant(..) -> {}
	}
	for i := usize(0); i < nargs; i++ {
		a := l1at(e, i)
		if scTracked(ntype[usize(a)]) {
			o = scJoin(o, scOrigin(a, dp-1))
		}
	}
	return o
}

// ---------------------------------------------------------------------------
// Walker: phase 1 (collect) and phase 2 (check S2-S4, E3004)

func wBlock(b u32, dp usize) decreases(dp) {
	if dp == 0 {
		tooDeep()
		return
	}
	if b == 0 {
		return
	}
	n := l1len(b)
	for i := usize(0); i < n; i++ {
		wStmt(l1at(b, i), dp-1)
	}
}

// wDefine records the depth of the variable defined by id.
func wDefine(id u32) u32 {
	s := scVarSym(id)
	if s != 0 && wCollect && defs[usize(id)] == s {
		scSetDepth(s, wDepth)
	}
	return s
}

func wFlow(s u32, rhs u32) {
	if wCollect && s != 0 && scTracked(syms.items[usize(s)].typ) {
		scAddDef(s, rhs)
	}
}

// scPair returns the right-hand side for target i of an n-target
// assignment whose values are the l2 list of node, and the tuple index
// (-1 for a 1:1 assignment).
func scPair(node u32, n usize, i usize) (u32, int) {
	nv := l2len(node)
	if nv == n {
		return l2at(node, i), -1
	}
	if nv == 1 {
		return l2at(node, 0), int(i)
	}
	return 0, -1
}

// wDiscard reports E3004 if the value (or tuple element idx) is Linear.
func wDiscard(rhs u32, idx int, at u32) {
	if wCollect {
		return
	}
	t := ntype[usize(rhs)]
	if isTupleT(t) && idx >= 0 && usize(idx) < tupleN(t) {
		t = tupleAt(t, usize(idx))
	}
	if t != 0 && isLinear(t) {
		scReport(E3004, at, formatTo(mbuf[:], "Linear value of type %v cannot be discarded with _", TypeRef(t)))
	}
}

func wStmt(s u32, dp usize) decreases(dp) {
	if dp == 0 {
		tooDeep()
		return
	}
	if s == 0 {
		return
	}
	k := nkind(s)
	if k == NkBlockStmt {
		wBlock(s, dp-1)
	} else if k == NkDeclStmt {
		d := na(s)
		if nkind(d) == NkVarDecl {
			v := nc(d)
			if v != 0 {
				wExpr(v, dp-1)
			}
			sym := wDefine(na(d))
			if v != 0 {
				wFlow(sym, v)
				if isBlank(na(d)) {
					wDiscard(v, -1, d)
				}
			}
		}
	} else if k == NkShortVarDecl {
		nv := l2len(s)
		for i := usize(0); i < nv; i++ {
			wExpr(l2at(s, i), dp-1)
		}
		n := l1len(s)
		for i := usize(0); i < n; i++ {
			id := l1at(s, i)
			rhs, idx := scPair(s, n, i)
			if isBlank(id) {
				if rhs != 0 {
					wDiscard(rhs, idx, id)
				}
				continue
			}
			sym := wDefine(id)
			if rhs != 0 {
				wFlow(sym, rhs)
			}
		}
	} else if k == NkAssignStmt {
		wAssign(s, dp-1)
	} else if k == NkIncDecStmt {
		wExpr(na(s), dp-1)
	} else if k == NkExprStmt {
		wExpr(na(s), dp-1)
		call := unparen(na(s))
		if call != 0 && nkind(call) == NkCallExpr && !wCollect {
			t := ntype[usize(call)]
			if t != 0 && isLinear(t) {
				scReport(E3004, s, formatTo(mbuf[:], "result of type %v (Linear) is discarded", TypeRef(t)))
			}
		}
	} else if k == NkIfStmt {
		wStmt(na(s), dp-1)
		wExpr(nb(s), dp-1)
		wBlock(nc(s), dp-1)
		wStmt(nd(s), dp-1)
	} else if k == NkMatchStmt {
		wMatch(s, dp-1)
	} else if k == NkForStmt {
		wStmt(na(s), dp-1)
		if nb(s) != 0 {
			wExpr(nb(s), dp-1)
		}
		wStmt(nc(s), dp-1)
		wBlock(ne(s), dp-1)
	} else if k == NkScopeStmt {
		wExpr(nb(s), dp-1)
		wDepth++
		if wDepth > scMaxDepth {
			scMaxDepth = wDepth
		}
		sym := scVarSym(na(s))
		if sym != 0 && wCollect {
			scSetDepth(sym, wDepth)
			scSetCont(sym, scOrig(wDepth, 0))
			scFixed[usize(sym)] = true
		}
		wBlock(nc(s), dp-1)
		wDepth--
	} else if k == NkDeferStmt {
		wExpr(na(s), dp-1)
	} else if k == NkReturnStmt {
		n := l1len(s)
		for i := usize(0); i < n; i++ {
			wExpr(l1at(s, i), dp-1)
		}
		if wCollect {
			return
		}
		for i := usize(0); i < n; i++ {
			r := l1at(s, i)
			if !scTracked(ntype[usize(r)]) {
				continue
			}
			o := scOrigin(r, SemaDepth)
			if scOD(o) >= wFnDepth {
				scReport(E3002, r, formatTo(mbuf[:], "scope escape: the returned value refers to %v, which does not outlive the function", Origin(o)))
			}
		}
	}
}

func wAssign(s u32, dp usize) decreases(dp) {
	if dp == 0 {
		tooDeep()
		return
	}
	n := l1len(s)
	for i := usize(0); i < n; i++ {
		l := l1at(s, i)
		if nkind(l) != NkIdent {
			wExpr(l, dp-1) // x.f = ..., a[i] = ...: walk the target's sub-expressions
		}
	}
	nr := l2len(s)
	for i := usize(0); i < nr; i++ {
		wExpr(l2at(s, i), dp-1)
	}
	if nop(s) != AsgAssign {
		return
	}
	for i := usize(0); i < n; i++ {
		l := l1at(s, i)
		rhs, idx := scPair(s, n, i)
		if rhs == 0 {
			continue
		}
		if nkind(l) == NkIdent && isBlank(l) {
			wDiscard(rhs, idx, s)
			continue
		}
		if !scTracked(ntype[usize(l)]) {
			continue
		}
		if wCollect {
			root := scRootVar(l, SemaDepth)
			if root != 0 && !symIsGlobal(root) {
				wFlow(root, rhs)
			}
			continue
		}
		o := scOrigin(rhs, SemaDepth)
		st := scStorage(l, SemaDepth)
		if !scFits(o, st) {
			scReport(E3002, s, formatTo(mbuf[:], "scope escape: a value referring to %v cannot be stored in %v, which outlives it", Origin(o), Origin(st)))
		}
	}
}

func wMatch(s u32, dp usize) decreases(dp) {
	if dp == 0 {
		tooDeep()
		return
	}
	x := na(s)
	wExpr(x, dp-1)
	n := l1len(s)
	for i := usize(0); i < n; i++ {
		arm := l1at(s, i)
		wPatternBindings(na(arm), x, SemaDepth)
		wExpr(nd(arm), dp-1)
		ae := nb(arm)
		if ae != 0 {
			wExpr(ae, dp-1)
			t := ntype[usize(ae)]
			if !wCollect && t != 0 && isLinear(t) {
				scReport(E3004, ae, formatTo(mbuf[:], "result of type %v (Linear) is discarded", TypeRef(t)))
			}
		}
		wBlock(nc(arm), dp-1)
	}
}

// wAddrOf marks the root variable of an addressed expression.
func wAddrOf(x u32) {
	r := scRootVar(x, SemaDepth)
	if r != 0 {
		scTouch(r)
		scAddr[usize(r)] = true
	}
}

func wExpr(e u32, dp usize) decreases(dp) {
	if dp == 0 {
		tooDeep()
		return
	}
	if e == 0 {
		return
	}
	k := nkind(e)
	if k == NkParenExpr {
		wExpr(na(e), dp-1)
	} else if k == NkUnaryExpr {
		if nop(e) == OpAddr && wCollect {
			wAddrOf(na(e))
		}
		wExpr(na(e), dp-1)
	} else if k == NkBinaryExpr {
		wExpr(na(e), dp-1)
		wExpr(nb(e), dp-1)
	} else if k == NkSelectorExpr {
		wExpr(na(e), dp-1)
	} else if k == NkIndexExpr {
		wExpr(na(e), dp-1)
		n := l1len(e)
		for i := usize(0); i < n; i++ {
			wExpr(l1at(e, i), dp-1)
		}
	} else if k == NkSliceExpr {
		if wCollect && scIsArray(ntype[usize(na(e))]) {
			wAddrOf(na(e))
		}
		wExpr(na(e), dp-1)
		wExpr(nb(e), dp-1)
		wExpr(nc(e), dp-1)
	} else if k == NkStructLit {
		n := l1len(e)
		for i := usize(0); i < n; i++ {
			wExpr(nb(l1at(e, i)), dp-1)
		}
	} else if k == NkCallExpr {
		if wCollect {
			if callTab.items[usize(ncall[usize(e)])].kind is Method(_, _, r, true) | BuiltinMeth(_, r, true) {
				wAddrOf(r) // implicit & of the receiver (v0.2)
			}
		}
		wExpr(na(e), dp-1)
		n := l1len(e)
		for i := usize(0); i < n; i++ {
			wExpr(l1at(e, i), dp-1)
		}
		if !wCollect {
			wCheckGo(e)
		}
	} else if k == NkFuncLit {
		wFuncLit(e, dp-1)
	} else if k == NkMatchExpr {
		x := na(e)
		wExpr(x, dp-1)
		n := l1len(e)
		for i := usize(0); i < n; i++ {
			arm := l1at(e, i)
			wPatternBindings(na(arm), x, SemaDepth)
			wExpr(nd(arm), dp-1)
			wExpr(nb(arm), dp-1)
		}
	} else if k == NkTupleExpr {
		n := l1len(e)
		for i := usize(0); i < n; i++ {
			wExpr(l1at(e, i), dp-1)
		}
	} else if k == NkIsExpr {
		wExpr(na(e), dp-1)
		wPatternBindings(nb(e), na(e), SemaDepth)
	}
}

// wPatternBindings defines the payload bindings of a pattern (match arm
// or `is` expression); their values flow from the scrutinee x (v0.2: from
// the matching element of a tuple scrutinee).
func wPatternBindings(p u32, x u32, depth usize) decreases(depth) {
	if depth == 0 || p == 0 {
		return
	}
	k := nkind(p)
	if k == NkIdent {
		if !isBlank(p) {
			wFlow(wDefine(p), x)
		}
	} else if k == NkCtorPattern || k == NkOrPattern {
		if k == NkCtorPattern && na(p) == 0 && !nflag(p) {
			// v0.2: a bare name at the top level or in a tuple element
			// (a binding, or a variant or constant without a definition).
			wFlow(wDefine(nb(p)), x)
		}
		n := l1len(p)
		for i := usize(0); i < n; i++ {
			wPatternBindings(l1at(p, i), x, depth-1)
		}
	} else if k == NkTuplePattern {
		n := l1len(p)
		for i := usize(0); i < n; i++ {
			if nkind(x) == NkTupleExpr && i < l1len(x) {
				wPatternBindings(l1at(p, i), l1at(x, i), depth-1)
			}
		}
	}
}

func wFuncLit(lit u32, dp usize) decreases(dp) {
	if dp == 0 {
		tooDeep()
		return
	}
	saveD := wDepth
	saveF := wFnDepth
	wDepth++
	if wDepth > scMaxDepth {
		scMaxDepth = wDepth
	}
	wFnDepth = wDepth
	fi := nfunc[usize(lit)]
	if fi != 0 && wCollect {
		np := usize(funcs.items[usize(fi)].parN)
		for i := usize(0); i < np; i++ {
			p := scParamSym(fi, i)
			if p != 0 {
				scSetDepth(p, wDepth)
				scSetCont(p, scOrig(wDepth-1, p))
			}
		}
	}
	wBlock(nb(lit), dp-1)
	wDepth = saveD
	wFnDepth = saveF
}

// wCheckGo applies S4 to s.Go(slot, fn).
func wCheckGo(e u32) {
	r := scopeGoRecv(e)
	if r == 0 || l1len(e) < 2 {
		return
	}
	so := scOrigin(r, SemaDepth)
	fn := unparen(l1at(e, 1))
	if nkind(fn) != NkFuncLit {
		o := scOrigin(fn, SemaDepth)
		if !scFits(o, so) {
			scReport(E3002, fn, formatTo(mbuf[:], "scope escape: task function refers to %v, which does not outlive the scope", Origin(o)))
		}
		return
	}
	if nfunc[usize(fn)] == 0 {
		return
	}
	c := litCapHead[usize(fn)]
	for g := usize(0); g < MaxCells; g++ {
		if c == 0 {
			break
		}
		s := cellVal(c)
		c = cellNext(c)
		t := syms.items[usize(s)].typ
		if isLinear(t) || !scTracked(t) {
			continue // Linear: moved into the task (S5); Value: copied
		}
		o := scLoad(s)
		if !scFits(o, so) {
			at := fn
			id := scFirstRef(nb(fn), s, SemaDepth)
			if id != 0 {
				at = id
			}
			scReport(E3002, at, formatTo(mbuf[:], "scope escape: task captures %v, which refers to %v and does not outlive the scope", NameRef(symName(s)), Origin(o)))
		}
	}
}

// scFirstRef returns the first identifier (pre-order) in the subtree of n
// referring to s, or 0.
func scFirstRef(n u32, s u32, dp usize) u32 decreases(dp) {
	if dp == 0 || n == 0 {
		return 0
	}
	nd := nodes.items[usize(n)]
	if nd.kind == NkIdent && symbolOf(n) == s {
		return n
	}
	for i := usize(0); i < MaxSlots; i++ {
		slot, _ := layout(nd.kind, i)
		if slot == SlotNone {
			break
		}
		if slot >= SlotL1 {
			start, cnt := slotList(nd, slot)
			m := usize(cnt)
			for j := usize(0); j < m; j++ {
				r := scFirstRef(listAt(start, j), s, dp-1)
				if r != 0 {
					return r
				}
			}
		} else {
			r := scFirstRef(slotChild(nd, slot), s, dp-1)
			if r != 0 {
				return r
			}
		}
	}
	return 0
}
