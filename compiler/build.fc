package main

// Native static ELF64 build & run driver for FinCore Stage-1 compiler (finc1).
// Assembles generated x86_64 GAS assembly + runtime/linux_amd64/{sys,fmt,net,scope}.s
// using /usr/bin/as and links statically using /usr/bin/ld (zero libc, zero GC).

const MaxFinalAsm = 16 * 1024 * 1024

var finalAsmBuf [MaxFinalAsm]byte
var finalAsmLen usize

func assembleFinalAsm() {
	pos := usize(0)
	pos = bufAppendStr(finalAsmBuf[:], pos, "# Generated by finc (FinCore v0.2 Self-Hosted Native x86_64 — zero libc, zero GC)\n.text\n\n")
	pos = bufAppend(finalAsmBuf[:], pos, textBuf[:textLen])
	if rodataLen > 0 || strAsmLen > 0 {
		pos = bufAppendStr(finalAsmBuf[:], pos, "\n.section .rodata\n")
		pos = bufAppend(finalAsmBuf[:], pos, rodataBuf[:rodataLen])
		pos = bufAppend(finalAsmBuf[:], pos, strAsmBuf[:strAsmLen])
	}
	if dataLen > 0 {
		pos = bufAppendStr(finalAsmBuf[:], pos, "\n.section .data\n")
		pos = bufAppend(finalAsmBuf[:], pos, dataBuf[:dataLen])
	}
	if bssLen > 0 {
		pos = bufAppendStr(finalAsmBuf[:], pos, "\n.section .bss\n")
		pos = bufAppend(finalAsmBuf[:], pos, bssBuf[:bssLen])
	}
	pos = bufAppendStr(finalAsmBuf[:], pos, "\n.section .note.GNU-stack,\"\",@progbits\n")
	finalAsmLen = pos
}

func pathJoin2(dst []byte, a []byte, b string) usize {
	pos := bufAppend(dst, 0, a)
	if pos > 0 && dst[pos-1] != '/' {
		pos = bufAppendByte(dst, pos, '/')
	}
	return bufAppendStr(dst, pos, b)
}

func defaultOutName(dst []byte, target []byte) usize {
	// Take basename, strip .fc suffix
	start := usize(0)
	end := len(target)
	for step := usize(0); step < len(target); step++ {
		if end > 1 && target[end-1] == '/' {
			end--
		} else {
			break
		}
	}
	for i := usize(0); i < end; i++ {
		if target[i] == '/' {
			start = i + 1
		}
	}
	base := target[start:end]
	if len(base) > 3 && base[len(base)-3] == '.' && base[len(base)-2] == 'f' && base[len(base)-1] == 'c' {
		base = base[:len(base)-3]
	}
	return copy(dst, base)
}

driver func findRuntimeDir(env Env, fs FS, dst []byte) usize {
	if fr, ok := env.GetEnv("FINCORE_ROOT"); ok && len(fr) > 0 {
		p := bufAppendStr(dst, 0, fr)
		if p > 0 && dst[p-1] != '/' {
			p = bufAppendByte(dst, p, '/')
		}
		p = bufAppendStr(dst, p, "runtime/linux_amd64")
		if fs.IsDir(bytesToStr(dst[:p])) {
			return p
		}
	}
	if fs.IsDir("runtime/linux_amd64") {
		return bufAppendStr(dst, 0, "runtime/linux_amd64")
	}
	return bufAppendStr(dst, 0, "runtime/linux_amd64")
}

driver func buildNativeBinary(io Stdio, env Env, fs FS, ex Exec, target []byte, outPath []byte, emitAsmPath []byte) error {
	poolInit()
	lexerInit()
	astInit()
	typesInit()
	valsInit()
	resolveInit(env)

	if err := loadProgram(fs, target); err != nil {
		return err
	}
	if diagCount == 0 {
		checkProgram()
	}
	if diagCount > 0 {
		_ = printDiags(io)
		return ErrIO
	}
	if !generateProgramAsm() {
		_ = io.WriteStderr(strBytes("finc build: root package has no main function\n"))
		return ErrIO
	}
	assembleFinalAsm()

	if len(emitAsmPath) > 0 {
		if err := fs.WriteFile(bytesToStr(emitAsmPath), finalAsmBuf[:finalAsmLen]); err != nil {
			return err
		}
	}

	tmpDir, err := fs.MkdirTemp("finc1-build-")
	if err != nil {
		return err
	}
	tmpB := strBytes(tmpDir)

	var progS [512]byte
	progSLen := pathJoin2(progS[:], tmpB, "prog.s")
	if err := fs.WriteFile(bytesToStr(progS[:progSLen]), finalAsmBuf[:finalAsmLen]); err != nil {
		return err
	}

	var progO [512]byte
	progOLen := pathJoin2(progO[:], tmpB, "prog.o")

	ctx, cancel := NewContext()
	defer cancel()
	var emptyEnv [0]string
	var errBuf [4096]byte

	// Assemble prog.s
	var asArgs [4]string
	asArgs[0] = "--64"
	asArgs[1] = "-o"
	asArgs[2] = bytesToStr(progO[:progOLen])
	asArgs[3] = bytesToStr(progS[:progSLen])
	code, en, rerr := ex.Run(ctx, "/usr/bin/as", asArgs[:], emptyEnv[:], "", errBuf[:])
	if rerr != nil || code.Code != 0 {
		if en > 0 {
			_ = io.WriteStderr(errBuf[:en])
		}
		cleanupTempBuild(fs, tmpB)
		return ErrExec
	}

	// Assemble runtime/linux_amd64/{sys,fmt,net,scope,effect,fiber}.s
	var rtDir [512]byte
	rtDirLen := findRuntimeDir(env, fs, rtDir[:])
	rtNames := [6]string{"sys.s", "fmt.s", "net.s", "scope.s", "effect.s", "fiber.s"}
	rtObjNames := [6]string{"rt_sys.o", "rt_fmt.o", "rt_net.o", "rt_scope.o", "rt_effect.o", "rt_fiber.o"}
	var rtObjStrs [6]string

	for i := usize(0); i < 6; i++ {
		var srcP [512]byte
		srcPLen := pathJoin2(srcP[:], rtDir[:rtDirLen], rtNames[i])
		var objP [512]byte
		objPLen := pathJoin2(objP[:], tmpB, rtObjNames[i])
		rtObjStrs[i] = bytesToStr(objP[:objPLen])
		asArgs[2] = rtObjStrs[i]
		asArgs[3] = bytesToStr(srcP[:srcPLen])
		c2, en2, e2 := ex.Run(ctx, "/usr/bin/as", asArgs[:], emptyEnv[:], "", errBuf[:])
		if e2 != nil || c2.Code != 0 {
			if en2 > 0 {
				_ = io.WriteStderr(errBuf[:en2])
			}
			cleanupTempBuild(fs, tmpB)
			return ErrExec
		}
	}

	// Link statically with /usr/bin/ld (zero libc, zero dynamic linker!)
	var ldArgs [13]string
	ldArgs[0] = "-static"
	ldArgs[1] = "-z"
	ldArgs[2] = "noexecstack"
	ldArgs[3] = "--build-id=none"
	ldArgs[4] = "-o"
	ldArgs[5] = bytesToStr(outPath)
	ldArgs[6] = rtObjStrs[0]
	ldArgs[7] = rtObjStrs[1]
	ldArgs[8] = rtObjStrs[2]
	ldArgs[9] = rtObjStrs[3]
	ldArgs[10] = rtObjStrs[4]
	ldArgs[11] = rtObjStrs[5]
	ldArgs[12] = bytesToStr(progO[:progOLen])

	lc, len2, lerr := ex.Run(ctx, "/usr/bin/ld", ldArgs[:], emptyEnv[:], "", errBuf[:])
	cleanupTempBuild(fs, tmpB)
	if lerr != nil || lc.Code != 0 {
		if len2 > 0 {
			_ = io.WriteStderr(errBuf[:len2])
		}
		return ErrExec
	}
	return nil
}

driver func cleanupTempBuild(fs FS, tmpB []byte) {
	names := [8]string{"prog.s", "prog.o", "rt_sys.o", "rt_fmt.o", "rt_net.o", "rt_scope.o", "rt_effect.o", "rt_fiber.o"}
	var p [512]byte
	for i := usize(0); i < 8; i++ {
		n := pathJoin2(p[:], tmpB, names[i])
		_ = fs.RemoveAll(bytesToStr(p[:n]))
	}
	_ = fs.RemoveAll(bytesToStr(tmpB))
}

driver func cmdBuild(io Stdio, env Env, fs FS, ex Exec) error {
	argc := env.ArgsCount()
	var outBuf [512]byte
	var outLen usize = 0
	var emitBuf [512]byte
	var emitLen usize = 0
	var targetBuf [512]byte
	var targetLen usize = 0
	comptimeFuelBudget = 1_000_000

	i := usize(2)
	driver for i < argc {
		arg := strBytes(env.Arg(i))
		if sliceEq(arg, strBytes("-o")) && i+1 < argc {
			i++
			outLen = copy(outBuf[:], strBytes(env.Arg(i)))
		} else if len(arg) > 11 && sliceEq(arg[:11], strBytes("--emit-asm=")) {
			emitLen = copy(emitBuf[:], arg[11:])
		} else if len(arg) > 16 && sliceEq(arg[:16], strBytes("--comptime-fuel=")) {
			v, ok := parseIntLit(arg[16:])
			if ok && v > 0 {
				comptimeFuelBudget = v
			}
		} else {
			targetLen = copy(targetBuf[:], arg)
		}
		i++
	}
	if targetLen == 0 {
		_ = io.WriteStderr(strBytes("usage: finc build [-o out_bin] [--emit-asm=out.s] [--comptime-fuel=N] <file.fc | dir>\n"))
		return ErrIO
	}
	if outLen == 0 {
		outLen = defaultOutName(outBuf[:], targetBuf[:targetLen])
	}
	return buildNativeBinary(io, env, fs, ex, targetBuf[:targetLen], outBuf[:outLen], emitBuf[:emitLen])
}

driver func cmdRun(io Stdio, env Env, fs FS, ex Exec) error {
	argc := env.ArgsCount()
	var targetBuf [512]byte
	var targetLen usize = 0
	var progArgs [32]string
	var nProgArgs usize = 0
	comptimeFuelBudget = 1_000_000
	afterDash := false

	i := usize(2)
	driver for i < argc {
		arg := strBytes(env.Arg(i))
		if afterDash {
			if nProgArgs < 32 {
				progArgs[nProgArgs] = env.Arg(i)
				nProgArgs++
			}
		} else if sliceEq(arg, strBytes("--")) {
			afterDash = true
		} else if len(arg) > 16 && sliceEq(arg[:16], strBytes("--comptime-fuel=")) {
			v, ok := parseIntLit(arg[16:])
			if ok && v > 0 {
				comptimeFuelBudget = v
			}
		} else {
			targetLen = copy(targetBuf[:], arg)
		}
		i++
	}
	if targetLen == 0 {
		_ = io.WriteStderr(strBytes("usage: finc run <file.fc | dir> [-- args...]\n"))
		return ErrIO
	}
	tmpDir, err := fs.MkdirTemp("finc1-run-")
	if err != nil {
		return err
	}
	tmpB := strBytes(tmpDir)
	var binP [512]byte
	binPLen := pathJoin2(binP[:], tmpB, "prog")
	var noEmit [0]byte
	if berr := buildNativeBinary(io, env, fs, ex, targetBuf[:targetLen], binP[:binPLen], noEmit[:]); berr != nil {
		_ = fs.RemoveAll(tmpDir)
		return berr
	}
	ctx, cancel := NewContext()
	defer cancel()
	var emptyEnv [0]string
	var errBuf [4096]byte
	code, en, rerr := ex.Run(ctx, bytesToStr(binP[:binPLen]), progArgs[:nProgArgs], emptyEnv[:], "", errBuf[:])
	_ = fs.RemoveAll(bytesToStr(binP[:binPLen]))
	_ = fs.RemoveAll(tmpDir)
	if en > 0 {
		_ = io.WriteStderr(errBuf[:en])
	}
	if rerr != nil || code.Code != 0 {
		return ErrExec
	}
	return nil
}

// ---------------------------------------------------------------------------
// `finc test [-v] <dir>` — corpus test runner with `// SINCE: vX.Y` import-closure skip

driver func parseSinceVersion(src []byte) (u32, u32, bool) {
	var maxMaj u32 = 0
	var maxMin u32 = 0
	found := false
	i := usize(0)
	n := len(src)
	driver for i < n {
		// Find end of line
		ls := i
		driver for i < n && src[i] != '\n' {
			i++
		}
		le := i
		if i < n {
			i++
		}
		// Trim leading spaces/tabs
		p := ls
		driver for p < le && (src[p] == ' ' || src[p] == '\t') {
			p++
		}
		// Match "// SINCE: v<maj>.<min>"
		if p+11 < le && src[p] == '/' && src[p+1] == '/' {
			p += 2
			driver for p < le && (src[p] == ' ' || src[p] == '\t') {
				p++
			}
			if p+7 < le && sliceEq(src[p:p+6], strBytes("SINCE:")) {
				p += 6
				driver for p < le && (src[p] == ' ' || src[p] == '\t') {
					p++
				}
				if p < le && src[p] == 'v' {
					p++
					var maj u32 = 0
					hasMaj := false
					driver for p < le && isDigit(src[p]) {
						maj = maj*10 + u32(src[p]-'0')
						hasMaj = true
						p++
					}
					if hasMaj && p < le && src[p] == '.' {
						p++
						var min u32 = 0
						hasMin := false
						driver for p < le && isDigit(src[p]) {
							min = min*10 + u32(src[p]-'0')
							hasMin = true
							p++
						}
						if hasMin {
							if !found || maj > maxMaj || (maj == maxMaj && min > maxMin) {
								maxMaj = maj
								maxMin = min
								found = true
							}
						}
					}
				}
			}
		}
	}
	return maxMaj, maxMin, found
}

// scanFileSinceAndImports reads a .fc file, updates max (maj,min), and recursively checks local imports.
driver func scanSinceRecursive(fs FS, rootDir []byte, path []byte, maxMaj *u32, maxMin *u32, depth u32) {
	if depth > 12 {
		return
	}
	if fs.IsDir(bytesToStr(path)) {
		var names [64]string
		n, err := fs.ListSourceFiles(bytesToStr(path), names[:])
		if err != nil {
			return
		}
		var fp [512]byte
		for i := usize(0); i < n; i++ {
			pl := pathJoin2(fp[:], path, names[i])
			scanSinceRecursive(fs, rootDir, fp[:pl], maxMaj, maxMin, depth+1)
		}
		return
	}
	var fbuf [32768]byte
	n, err := fs.ReadFileInto(bytesToStr(path), fbuf[:])
	if err != nil {
		return
	}
	src := fbuf[:n]
	maj, min, ok := parseSinceVersion(src)
	if ok && (maj > *maxMaj || (maj == *maxMaj && min > *maxMin)) {
		*maxMaj = maj
		*maxMin = min
	}
	// Scan quoted import paths on lines after `import`
	inImportBlock := false
	i := usize(0)
	driver for i < n {
		ls := i
		driver for i < n && src[i] != '\n' {
			i++
		}
		le := i
		if i < n {
			i++
		}
		p := ls
		driver for p < le && (src[p] == ' ' || src[p] == '\t') {
			p++
		}
		if p < le && src[p] == ')' {
			inImportBlock = false
			continue
		}
		isImpLine := false
		if p+6 <= le && sliceEq(src[p:p+6], strBytes("import")) && (p+6 == le || src[p+6] == ' ' || src[p+6] == '\t' || src[p+6] == '(') {
			isImpLine = true
			for k := p + 6; k < le; k++ {
				if src[k] == '(' {
					inImportBlock = true
				}
			}
		}
		if isImpLine || inImportBlock {
			// Find quoted string "..."
			q1 := p
			driver for q1 < le && src[q1] != '"' {
				q1++
			}
			if q1 < le {
				q2 := q1 + 1
				driver for q2 < le && src[q2] != '"' {
					q2++
				}
				if q2 < le && q2 > q1+1 {
					imp := src[q1+1 : q2]
					if !isStdImport(imp) {
						var impPath [512]byte
						il := pathJoin2(impPath[:], rootDir, bytesToStr(imp))
						if fs.IsDir(bytesToStr(impPath[:il])) {
							scanSinceRecursive(fs, rootDir, impPath[:il], maxMaj, maxMin, depth+1)
						}
					}
				}
			}
		}
	}
}

driver func listDirEntries(ex Exec, dir []byte, outBuf []byte) usize {
	ctx, cancel := NewContext()
	defer cancel()
	var cmdBuf [600]byte
	p := bufAppendStr(cmdBuf[:], 0, "ls -1 \"")
	p = bufAppend(cmdBuf[:], p, dir)
	p = bufAppendStr(cmdBuf[:], p, "\" >&2")
	var args [2]string
	args[0] = "-c"
	args[1] = bytesToStr(cmdBuf[:p])
	var emptyEnv [0]string
	_, en, _ := ex.Run(ctx, "/bin/sh", args[:], emptyEnv[:], "", outBuf)
	return en
}

driver func cmdTest(io Stdio, env Env, fs FS, ex Exec) error {
	argc := env.ArgsCount()
	verbose := false
	var dirBuf [512]byte
	var dirLen usize = 0
	for i := usize(2); i < argc; i++ {
		arg := strBytes(env.Arg(i))
		if sliceEq(arg, strBytes("-v")) {
			verbose = true
		} else {
			dirLen = copy(dirBuf[:], arg)
		}
	}
	if dirLen == 0 {
		dirBuf[0] = '.'
		dirLen = 1
	}
	rootDir := dirBuf[:dirLen]

	var total u32 = 0
	var passed u32 = 0
	var failed u32 = 0
	var skipped u32 = 0
	var skipMaxMaj u32 = 0
	var skipMaxMin u32 = 0

	var subNames [2]string
	subNames[0] = "pass"
	subNames[1] = "fail"
	for si := usize(0); si < 2; si++ {
		isPass := si == 0
		var subDir [512]byte
		subLen := pathJoin2(subDir[:], rootDir, subNames[si])
		if !fs.IsDir(bytesToStr(subDir[:subLen])) {
			continue
		}
		var listBuf [8192]byte
		ln := listDirEntries(ex, subDir[:subLen], listBuf[:])
		pos := usize(0)
		driver for pos < ln {
			ls := pos
			driver for pos < ln && listBuf[pos] != '\n' {
				pos++
			}
			entry := listBuf[ls:pos]
			if pos < ln {
				pos++
			}
			if len(entry) == 0 {
				continue
			}
			var fullPath [512]byte
			fpLen := pathJoin2(fullPath[:], subDir[:subLen], bytesToStr(entry))
			isDir := fs.IsDir(bytesToStr(fullPath[:fpLen]))
			isFc := len(entry) > 3 && entry[len(entry)-3] == '.' && entry[len(entry)-2] == 'f' && entry[len(entry)-1] == 'c'
			if !isDir && !isFc {
				continue
			}
			total++
			var needMaj u32 = 0
			var needMin u32 = 0
			scanSinceRecursive(fs, rootDir, fullPath[:fpLen], &needMaj, &needMin, 0)
			if needMaj > 0 || (needMaj == 0 && needMin > 7) {
				skipped++
				if needMaj > skipMaxMaj || (needMaj == skipMaxMaj && needMin > skipMaxMin) {
					skipMaxMaj = needMaj
					skipMaxMin = needMin
				}
				if verbose {
					var mb [256]byte
					mn := formatTo(mb[:], "SKIP %s (needs v%d.%d)\n", entry, needMaj, needMin)
					_ = io.WriteStdout(mb[:mn])
				}
				continue
			}
			// Execute pass or fail check
			poolInit()
			lexerInit()
			astInit()
			typesInit()
			valsInit()
			resolveInit(env)
			comptimeFuelBudget = 1_000_000
			lerr := loadProgram(fs, fullPath[:fpLen])
			if lerr == nil && diagCount == 0 {
				checkProgram()
			}
			if isPass {
				if lerr == nil && diagCount == 0 {
					passed++
					if verbose {
						var mb [256]byte
						mn := formatTo(mb[:], "PASS %s\n", entry)
						_ = io.WriteStdout(mb[:mn])
					}
				} else {
					failed++
					if verbose {
						var mb [256]byte
						mn := formatTo(mb[:], "FAIL %s\n", entry)
						_ = io.WriteStdout(mb[:mn])
					}
				}
			} else {
				if diagCount > 0 {
					passed++
					if verbose {
						var mb [256]byte
						mn := formatTo(mb[:], "PASS %s\n", entry)
						_ = io.WriteStdout(mb[:mn])
					}
				} else {
					failed++
					if verbose {
						var mb [256]byte
						mn := formatTo(mb[:], "FAIL %s\n", entry)
						_ = io.WriteStdout(mb[:mn])
					}
				}
			}
		}
	}

	var sum [256]byte
	var sn usize = 0
	if skipped > 0 {
		sn = formatTo(sum[:], "%d tests, %d passed, %d failed, %d skipped (needs v%d.%d)\n",
			total, passed, failed, skipped, skipMaxMaj, skipMaxMin)
	} else {
		sn = formatTo(sum[:], "%d tests, %d passed, %d failed, 0 skipped\n", total, passed, failed)
	}
	_ = io.WriteStdout(sum[:sn])
	if failed > 0 {
		return ErrIO
	}
	return nil
}
