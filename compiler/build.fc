package main

// Native static ELF64 build & run driver for FinCore Stage-1 compiler (finc1).
// Assembles generated x86_64 GAS assembly + runtime/linux_amd64/{sys,fmt,net,scope}.s
// using /usr/bin/as and links statically using /usr/bin/ld (zero libc, zero GC).

const MaxFinalAsm = 16 * 1024 * 1024

var finalAsmBuf [MaxFinalAsm]byte
var finalAsmLen usize
var emitDebugInfo bool

func assembleFinalAsm() {
	pos := usize(0)
	pos = bufAppendStr(finalAsmBuf[:], pos, "# Generated by finc (FinCore v0.7 Self-Hosted Native x86_64 — zero libc, zero GC)\n")
	if emitDebugInfo {
		fc := fileCount
		for fid := u32(0); fid < fc; fid++ {
			var fb [600]byte
			fn := formatTo(fb[:], ".file %d \"%s\"\n", fid+1, strSlice(files[fid].pathID))
			pos = bufAppend(finalAsmBuf[:], pos, fb[:fn])
		}
	}
	pos = bufAppendStr(finalAsmBuf[:], pos, ".text\n\n")
	pos = bufAppend(finalAsmBuf[:], pos, textBuf[:textLen])
	if rodataLen > 0 || strAsmLen > 0 {
		pos = bufAppendStr(finalAsmBuf[:], pos, "\n.section .rodata\n")
		pos = bufAppend(finalAsmBuf[:], pos, rodataBuf[:rodataLen])
		pos = bufAppend(finalAsmBuf[:], pos, strAsmBuf[:strAsmLen])
	}
	if dataLen > 0 {
		pos = bufAppendStr(finalAsmBuf[:], pos, "\n.section .data\n")
		pos = bufAppend(finalAsmBuf[:], pos, dataBuf[:dataLen])
	}
	if bssLen > 0 {
		pos = bufAppendStr(finalAsmBuf[:], pos, "\n.section .bss\n")
		pos = bufAppend(finalAsmBuf[:], pos, bssBuf[:bssLen])
	}
	pos = bufAppendStr(finalAsmBuf[:], pos, "\n.section .note.GNU-stack,\"\",@progbits\n")
	finalAsmLen = pos
}

func pathJoin2(dst []byte, a []byte, b string) usize {
	pos := bufAppend(dst, 0, a)
	if pos > 0 && dst[pos-1] != '/' {
		pos = bufAppendByte(dst, pos, '/')
	}
	return bufAppendStr(dst, pos, b)
}

func defaultOutName(dst []byte, target []byte) usize {
	// Take basename, strip .fc suffix
	start := usize(0)
	end := len(target)
	for step := usize(0); step < len(target); step++ {
		if end > 1 && target[end-1] == '/' {
			end--
		} else {
			break
		}
	}
	for i := usize(0); i < end; i++ {
		if target[i] == '/' {
			start = i + 1
		}
	}
	base := target[start:end]
	if len(base) > 3 && base[len(base)-3] == '.' && base[len(base)-2] == 'f' && base[len(base)-1] == 'c' {
		base = base[:len(base)-3]
	}
	return copy(dst, base)
}

driver func findRuntimeDir(env Env, fs FS, dst []byte) usize {
	if fr, ok := env.GetEnv("FINCORE_ROOT"); ok && len(fr) > 0 {
		p := bufAppendStr(dst, 0, fr)
		if p > 0 && dst[p-1] != '/' {
			p = bufAppendByte(dst, p, '/')
		}
		p = bufAppendStr(dst, p, "runtime/linux_amd64")
		if fs.IsDir(bytesToStr(dst[:p])) {
			return p
		}
	}
	if fs.IsDir("runtime/linux_amd64") {
		return bufAppendStr(dst, 0, "runtime/linux_amd64")
	}
	return bufAppendStr(dst, 0, "runtime/linux_amd64")
}

driver func buildNativeBinary(io Stdio, env Env, fs FS, ex Exec, target []byte, outPath []byte, emitAsmPath []byte) error {
	poolInit()
	lexerInit()
	astInit()
	typesInit()
	valsInit()
	resolveInit(env)

	loadProgram(fs, target)?
	if diagCount == 0 {
		checkProgram()
	}
	if diagCount > 0 {
		_ = printDiags(io)
		return ErrIO
	}
	if !generateProgramAsm() {
		_ = io.WriteStderr(strBytes("finc build: root package has no main function\n"))
		return ErrIO
	}
	assembleFinalAsm()

	if len(emitAsmPath) > 0 {
		fs.WriteFile(bytesToStr(emitAsmPath), finalAsmBuf[:finalAsmLen])?
	}

	tmpDir := fs.MkdirTemp("finc1-build-")?
	tmpB := strBytes(tmpDir)

	var progS [512]byte
	progSLen := pathJoin2(progS[:], tmpB, "prog.s")
	fs.WriteFile(bytesToStr(progS[:progSLen]), finalAsmBuf[:finalAsmLen])?

	var progO [512]byte
	progOLen := pathJoin2(progO[:], tmpB, "prog.o")

	ctx, cancel := NewContext()
	defer cancel()
	var emptyEnv [0]string
	var errBuf [4096]byte

	// Assemble prog.s
	var asArgs [4]string
	asArgs[0] = "--64"
	asArgs[1] = "-o"
	asArgs[2] = bytesToStr(progO[:progOLen])
	asArgs[3] = bytesToStr(progS[:progSLen])
	code, en, rerr := ex.Run(ctx, "/usr/bin/as", asArgs[:], emptyEnv[:], "", errBuf[:])
	if rerr != nil || code.Code != 0 {
		if en > 0 {
			_ = io.WriteStderr(errBuf[:en])
		}
		cleanupTempBuild(fs, tmpB)
		return ErrExec
	}

	// Assemble runtime/linux_amd64/{sys,fmt,net,scope,effect,fiber}.s
	var rtDir [512]byte
	rtDirLen := findRuntimeDir(env, fs, rtDir[:])
	rtNames := [6]string{"sys.s", "fmt.s", "net.s", "scope.s", "effect.s", "fiber.s"}
	rtObjNames := [6]string{"rt_sys.o", "rt_fmt.o", "rt_net.o", "rt_scope.o", "rt_effect.o", "rt_fiber.o"}
	var rtObjStrs [6]string

	for i := usize(0); i < 6; i++ {
		var srcP [512]byte
		srcPLen := pathJoin2(srcP[:], rtDir[:rtDirLen], rtNames[i])
		var objP [512]byte
		objPLen := pathJoin2(objP[:], tmpB, rtObjNames[i])
		rtObjStrs[i] = bytesToStr(objP[:objPLen])
		asArgs[2] = rtObjStrs[i]
		asArgs[3] = bytesToStr(srcP[:srcPLen])
		c2, en2, e2 := ex.Run(ctx, "/usr/bin/as", asArgs[:], emptyEnv[:], "", errBuf[:])
		if e2 != nil || c2.Code != 0 {
			if en2 > 0 {
				_ = io.WriteStderr(errBuf[:en2])
			}
			cleanupTempBuild(fs, tmpB)
			return ErrExec
		}
	}

	// Check if program uses dynamic C FFI linking (via finc.mod `link`, CLI `-l`, or `extern` funcs)
	hasExtern := false
	poc := pkgOrderCount
	for pi := u32(0); pi < poc; pi++ {
		p := pkgs[pkgOrder[pi]]
		for fi := u32(0); fi < p.fileCount; fi++ {
			fid := pkgFiles[p.fileStart+fi]
			fnode := nodes[files[fid].astNode]
			for di := u32(0); di < fnode.e; di++ {
				dn := listPool[fnode.d+di]
				if nodes[dn].kind == NKFuncDecl && (nodes[dn].flags&1) != 0 {
					hasExtern = true
				}
			}
		}
	}
	useDynLink := hasExtern || modLinkCount > 0 || cliLinkCount > 0

	var lc ExitStatus
	var len2 usize = 0
	var lerr error = nil

	if !useDynLink {
		// Link statically with /usr/bin/ld (zero libc, zero dynamic linker!)
		var ldArgs [13]string
		ldArgs[0] = "-static"
		ldArgs[1] = "-z"
		ldArgs[2] = "noexecstack"
		ldArgs[3] = "--build-id=none"
		ldArgs[4] = "-o"
		ldArgs[5] = bytesToStr(outPath)
		ldArgs[6] = rtObjStrs[0]
		ldArgs[7] = rtObjStrs[1]
		ldArgs[8] = rtObjStrs[2]
		ldArgs[9] = rtObjStrs[3]
		ldArgs[10] = rtObjStrs[4]
		ldArgs[11] = rtObjStrs[5]
		ldArgs[12] = bytesToStr(progO[:progOLen])
		lc, len2, lerr = ex.Run(ctx, "/usr/bin/ld", ldArgs[:], emptyEnv[:], "", errBuf[:])
	} else {
		// Assemble entry_dyn.s and dynamically link with /usr/bin/gcc -no-pie + requested -l libs
		var dynSrc [512]byte
		dynSrcLen := pathJoin2(dynSrc[:], rtDir[:rtDirLen], "entry_dyn.s")
		var dynObj [512]byte
		dynObjLen := pathJoin2(dynObj[:], tmpB, "rt_entry_dyn.o")
		asArgs[2] = bytesToStr(dynObj[:dynObjLen])
		asArgs[3] = bytesToStr(dynSrc[:dynSrcLen])
		c3, en3, e3 := ex.Run(ctx, "/usr/bin/as", asArgs[:], emptyEnv[:], "", errBuf[:])
		if e3 != nil || c3.Code != 0 {
			if en3 > 0 {
				_ = io.WriteStderr(errBuf[:en3])
			}
			cleanupTempBuild(fs, tmpB)
			return ErrExec
		}

		var gccArgs [64]string
		ga := usize(0)
		gccArgs[ga] = "-no-pie"
		ga++
		gccArgs[ga] = "-Wl,-z,noexecstack"
		ga++
		gccArgs[ga] = "-o"
		ga++
		gccArgs[ga] = bytesToStr(outPath)
		ga++
		gccArgs[ga] = bytesToStr(dynObj[:dynObjLen])
		ga++
		for ri := usize(0); ri < 6; ri++ {
			gccArgs[ga] = rtObjStrs[ri]
			ga++
		}
		gccArgs[ga] = bytesToStr(progO[:progOLen])
		ga++
		var lflagBuf [1024]byte
		lpos := usize(0)
		mlc := modLinkCount
		for li := u32(0); li < mlc; li++ {
			if ga >= 60 {
				break
			}
			lb := strSlice(modLinks[li])
			if lpos+2+len(lb) <= len(lflagBuf) {
				start := lpos
				lflagBuf[lpos] = '-'
				lflagBuf[lpos+1] = 'l'
				lpos += 2
				lpos += copy(lflagBuf[lpos:], lb)
				gccArgs[ga] = bytesToStr(lflagBuf[start:lpos])
				ga++
			}
		}
		clc := cliLinkCount
		for li := u32(0); li < clc; li++ {
			if ga >= 62 {
				break
			}
			lb := strSlice(cliLinks[li])
			if lpos+2+len(lb) <= len(lflagBuf) {
				start := lpos
				lflagBuf[lpos] = '-'
				lflagBuf[lpos+1] = 'l'
				lpos += 2
				lpos += copy(lflagBuf[lpos:], lb)
				gccArgs[ga] = bytesToStr(lflagBuf[start:lpos])
				ga++
			}
		}
		lc, len2, lerr = ex.Run(ctx, "/usr/bin/gcc", gccArgs[:ga], emptyEnv[:], "", errBuf[:])
	}

	cleanupTempBuild(fs, tmpB)
	if lerr != nil || lc.Code != 0 {
		if len2 > 0 {
			_ = io.WriteStderr(errBuf[:len2])
		}
		return ErrExec
	}
	return nil
}

driver func cleanupTempBuild(fs FS, tmpB []byte) {
	names := [9]string{"prog.s", "prog.o", "rt_sys.o", "rt_fmt.o", "rt_net.o", "rt_scope.o", "rt_effect.o", "rt_fiber.o", "rt_entry_dyn.o"}
	var p [512]byte
	for i := usize(0); i < 9; i++ {
		n := pathJoin2(p[:], tmpB, names[i])
		_ = fs.RemoveAll(bytesToStr(p[:n]))
	}
	_ = fs.RemoveAll(bytesToStr(tmpB))
}

driver func cmdBuild(io Stdio, env Env, fs FS, ex Exec) error {
	argc := env.ArgsCount()
	var outBuf [512]byte
	var outLen usize = 0
	var emitBuf [512]byte
	var emitLen usize = 0
	var targetBuf [512]byte
	var targetLen usize = 0
	comptimeFuelBudget = 1_000_000
	cliLinkCount = 0
	emitDebugInfo = false

	i := usize(2)
	driver for i < argc {
		arg := strBytes(env.Arg(i))
		if sliceEq(arg, strBytes("-o")) && i+1 < argc {
			i++
			outLen = copy(outBuf[:], strBytes(env.Arg(i)))
		} else if sliceEq(arg, strBytes("-g")) {
			emitDebugInfo = true
		} else if len(arg) > 2 && arg[0] == '-' && arg[1] == 'l' {
			if cliLinkCount < MaxModLinks {
				cliLinks[cliLinkCount] = internBytes(arg[2:])
				cliLinkCount++
			}
		} else if len(arg) > 11 && sliceEq(arg[:11], strBytes("--emit-asm=")) {
			emitLen = copy(emitBuf[:], arg[11:])
		} else if len(arg) > 16 && sliceEq(arg[:16], strBytes("--comptime-fuel=")) {
			v, ok := parseIntLit(arg[16:])
			if ok && v > 0 {
				comptimeFuelBudget = v
			}
		} else {
			targetLen = copy(targetBuf[:], arg)
		}
		i++
	}
	if targetLen == 0 {
		_ = io.WriteStderr(strBytes("usage: finc build [-o out_bin] [--emit-asm=out.s] [--comptime-fuel=N] <file.fc | dir>\n"))
		return ErrIO
	}
	if outLen == 0 {
		outLen = defaultOutName(outBuf[:], targetBuf[:targetLen])
	}
	return buildNativeBinary(io, env, fs, ex, targetBuf[:targetLen], outBuf[:outLen], emitBuf[:emitLen])
}

driver func cmdRun(io Stdio, env Env, fs FS, ex Exec) error {
	argc := env.ArgsCount()
	var targetBuf [512]byte
	var targetLen usize = 0
	var progArgs [32]string
	var nProgArgs usize = 0
	comptimeFuelBudget = 1_000_000
	afterDash := false

	i := usize(2)
	driver for i < argc {
		arg := strBytes(env.Arg(i))
		if afterDash {
			if nProgArgs < 32 {
				progArgs[nProgArgs] = env.Arg(i)
				nProgArgs++
			}
		} else if sliceEq(arg, strBytes("--")) {
			afterDash = true
		} else if len(arg) > 16 && sliceEq(arg[:16], strBytes("--comptime-fuel=")) {
			v, ok := parseIntLit(arg[16:])
			if ok && v > 0 {
				comptimeFuelBudget = v
			}
		} else {
			targetLen = copy(targetBuf[:], arg)
		}
		i++
	}
	if targetLen == 0 {
		_ = io.WriteStderr(strBytes("usage: finc run <file.fc | dir> [-- args...]\n"))
		return ErrIO
	}
	tmpDir, err := fs.MkdirTemp("finc1-run-")
	if err != nil {
		return err
	}
	tmpB := strBytes(tmpDir)
	var binP [512]byte
	binPLen := pathJoin2(binP[:], tmpB, "prog")
	var noEmit [0]byte
	if berr := buildNativeBinary(io, env, fs, ex, targetBuf[:targetLen], binP[:binPLen], noEmit[:]); berr != nil {
		_ = fs.RemoveAll(tmpDir)
		return berr
	}
	ctx, cancel := NewContext()
	defer cancel()
	var emptyEnv [0]string
	var errBuf [4096]byte
	code, en, rerr := ex.Run(ctx, bytesToStr(binP[:binPLen]), progArgs[:nProgArgs], emptyEnv[:], "", errBuf[:])
	_ = fs.RemoveAll(bytesToStr(binP[:binPLen]))
	_ = fs.RemoveAll(tmpDir)
	if en > 0 {
		_ = io.WriteStderr(errBuf[:en])
	}
	if rerr != nil || code.Code != 0 {
		return ErrExec
	}
	return nil
}

// ---------------------------------------------------------------------------
// `finc test [-v] <dir>` — corpus test runner with `// SINCE: vX.Y` import-closure skip

driver func parseSinceVersion(src []byte) (u32, u32, bool) {
	var maxMaj u32 = 0
	var maxMin u32 = 0
	found := false
	i := usize(0)
	n := len(src)
	driver for i < n {
		// Find end of line
		ls := i
		driver for i < n && src[i] != '\n' {
			i++
		}
		le := i
		if i < n {
			i++
		}
		// Trim leading spaces/tabs
		p := ls
		driver for p < le && (src[p] == ' ' || src[p] == '\t') {
			p++
		}
		// Match "// SINCE: v<maj>.<min>"
		if p+11 < le && src[p] == '/' && src[p+1] == '/' {
			p += 2
			driver for p < le && (src[p] == ' ' || src[p] == '\t') {
				p++
			}
			if p+7 < le && sliceEq(src[p:p+6], strBytes("SINCE:")) {
				p += 6
				driver for p < le && (src[p] == ' ' || src[p] == '\t') {
					p++
				}
				if p < le && src[p] == 'v' {
					p++
					var maj u32 = 0
					hasMaj := false
					driver for p < le && isDigit(src[p]) {
						maj = maj*10 + u32(src[p]-'0')
						hasMaj = true
						p++
					}
					if hasMaj && p < le && src[p] == '.' {
						p++
						var min u32 = 0
						hasMin := false
						driver for p < le && isDigit(src[p]) {
							min = min*10 + u32(src[p]-'0')
							hasMin = true
							p++
						}
						if hasMin {
							if !found || maj > maxMaj || (maj == maxMaj && min > maxMin) {
								maxMaj = maj
								maxMin = min
								found = true
							}
						}
					}
				}
			}
		}
	}
	return maxMaj, maxMin, found
}

// scanFileSinceAndImports reads a .fc file, updates max (maj,min), and recursively checks local imports.
driver func scanSinceRecursive(fs FS, rootDir []byte, path []byte, maxMaj *u32, maxMin *u32, depth u32) {
	if depth > 12 {
		return
	}
	if fs.IsDir(bytesToStr(path)) {
		var names [64]string
		n, err := fs.ListSourceFiles(bytesToStr(path), names[:])
		if err != nil {
			return
		}
		var fp [512]byte
		for i := usize(0); i < n; i++ {
			pl := pathJoin2(fp[:], path, names[i])
			scanSinceRecursive(fs, rootDir, fp[:pl], maxMaj, maxMin, depth+1)
		}
		return
	}
	var fbuf [32768]byte
	n, err := fs.ReadFileInto(bytesToStr(path), fbuf[:])
	if err != nil {
		return
	}
	src := fbuf[:n]
	maj, min, ok := parseSinceVersion(src)
	if ok && (maj > *maxMaj || (maj == *maxMaj && min > *maxMin)) {
		*maxMaj = maj
		*maxMin = min
	}
	// Scan quoted import paths on lines after `import`
	inImportBlock := false
	i := usize(0)
	driver for i < n {
		ls := i
		driver for i < n && src[i] != '\n' {
			i++
		}
		le := i
		if i < n {
			i++
		}
		p := ls
		driver for p < le && (src[p] == ' ' || src[p] == '\t') {
			p++
		}
		if p < le && src[p] == ')' {
			inImportBlock = false
			continue
		}
		isImpLine := false
		if p+6 <= le && sliceEq(src[p:p+6], strBytes("import")) && (p+6 == le || src[p+6] == ' ' || src[p+6] == '\t' || src[p+6] == '(') {
			isImpLine = true
			for k := p + 6; k < le; k++ {
				if src[k] == '(' {
					inImportBlock = true
				}
			}
		}
		if isImpLine || inImportBlock {
			// Find quoted string "..."
			q1 := p
			driver for q1 < le && src[q1] != '"' {
				q1++
			}
			if q1 < le {
				q2 := q1 + 1
				driver for q2 < le && src[q2] != '"' {
					q2++
				}
				if q2 < le && q2 > q1+1 {
					imp := src[q1+1 : q2]
					if !isStdImport(imp) {
						var impPath [512]byte
						il := pathJoin2(impPath[:], rootDir, bytesToStr(imp))
						if fs.IsDir(bytesToStr(impPath[:il])) {
							scanSinceRecursive(fs, rootDir, impPath[:il], maxMaj, maxMin, depth+1)
						}
					}
				}
			}
		}
	}
}

driver func listDirEntries(ex Exec, dir []byte, outBuf []byte) usize {
	ctx, cancel := NewContext()
	defer cancel()
	var cmdBuf [600]byte
	p := bufAppendStr(cmdBuf[:], 0, "ls -1 \"")
	p = bufAppend(cmdBuf[:], p, dir)
	p = bufAppendStr(cmdBuf[:], p, "\" >&2")
	var args [2]string
	args[0] = "-c"
	args[1] = bytesToStr(cmdBuf[:p])
	var emptyEnv [0]string
	_, en, _ := ex.Run(ctx, "/bin/sh", args[:], emptyEnv[:], "", outBuf)
	return en
}

func bytesContains(hay []byte, needle []byte) bool {
	if len(needle) == 0 {
		return true
	}
	if len(hay) < len(needle) {
		return false
	}
	lim := len(hay) - len(needle) + 1
	for i := usize(0); i < lim; i++ {
		ok := true
		for j := usize(0); j < len(needle); j++ {
			if hay[i+j] != needle[j] {
				ok = false
				break
			}
		}
		if ok {
			return true
		}
	}
	return false
}

driver func runUnitTests(io Stdio, env Env, fs FS, ex Exec, rootDir []byte, verbose bool, filter []byte) error {
	poolInit()
	lexerInit()
	astInit()
	typesInit()
	valsInit()
	resolveInit(env)
	comptimeFuelBudget = 1_000_000

	testMode = true
	testHarnessLen = 0
	if err := loadProgram(fs, rootDir); err != nil {
		testMode = false
		return err
	}
	if diagCount > 0 {
		testMode = false
		_ = printDiags(io)
		return ErrIO
	}

	// Copy package name & discover Test* functions before buildNativeBinary resets pool
	var pkgNameBuf [128]byte
	pkgNameLen := copy(pkgNameBuf[:], strSlice(pkgs[rootPkgID].nameStr))

	var testNameBuf [16384]byte
	var testNameOff [256]usize
	var testNameLen [256]usize
	var testParamCnt [256]u8
	var testParams [256][8]u8 // 0=&t, 1=io, 2=env, 3=fs, 4=clock, 5=net, 6=ex
	var testNamePos usize = 0
	var nTests usize = 0

	rp := pkgs[rootPkgID]
	for fi := u32(0); fi < rp.fileCount; fi++ {
		fid := pkgFiles[rp.fileStart+fi]
		fn := nodes[files[fid].astNode]
		for di := u32(0); di < fn.e; di++ {
			dn := listPool[fn.d+di]
			d := nodes[dn]
			if d.kind != NKFuncDecl || d.b != 0 {
				continue
			}
			nm := strSlice(d.a)
			if len(nm) < 4 || nm[0] != 'T' || nm[1] != 'e' || nm[2] != 's' || nm[3] != 't' {
				continue
			}
			if len(filter) > 0 && !bytesContains(nm, filter) {
				continue
			}
			if nTests >= 256 || testNamePos+len(nm) > len(testNameBuf) {
				break
			}
			testNameOff[nTests] = testNamePos
			testNameLen[nTests] = len(nm)
			testNamePos += copy(testNameBuf[testNamePos:], nm)

			sn := nodes[d.c]
			var pc u8 = 0
			for pi := u32(0); pi < sn.d && pi < 8; pi++ {
				pn := listPool[sn.c+pi]
				ptn := nodes[nodes[pn].b]
				var kind u8 = 0
				if ptn.kind == NKTypePtr {
					kind = 0
				} else if ptn.kind == NKTypeName {
					tn := strSlice(ptn.b)
					if sliceEq(tn, strBytes("Stdio")) {
						kind = 1
					} else if sliceEq(tn, strBytes("Env")) {
						kind = 2
					} else if sliceEq(tn, strBytes("FS")) {
						kind = 3
					} else if sliceEq(tn, strBytes("Clock")) {
						kind = 4
					} else if sliceEq(tn, strBytes("Net")) {
						kind = 5
					} else if sliceEq(tn, strBytes("Exec")) {
						kind = 6
					}
				}
				testParams[nTests][usize(pc)] = kind
				pc++
			}
			testParamCnt[nTests] = pc
			nTests++
		}
	}

	if nTests == 0 {
		testMode = false
		_ = io.WriteStdout(strBytes("finc test: no Test* functions found\n"))
		return nil
	}

	// Synthesize in-memory test runner harness
	pos := usize(0)
	pos = bufAppendStr(testHarnessBuf[:], pos, "package ")
	pos = bufAppend(testHarnessBuf[:], pos, pkgNameBuf[:pkgNameLen])
	pos = bufAppendStr(testHarnessBuf[:], pos, "\n\nimport __finc_t \"std/testing\"\n\n")
	pos = bufAppendStr(testHarnessBuf[:], pos, "driver func __finc_test_main(io Stdio, env Env, fs FS, clock Clock, net Net, ex Exec) error {\n")
	pos = bufAppendStr(testHarnessBuf[:], pos, "\t_ = env\n\t_ = fs\n\t_ = net\n\t_ = ex\n")
	pos = bufAppendStr(testHarnessBuf[:], pos, "\tvar passed u32 = 0\n\tvar failed u32 = 0\n\tvar out [512]byte\n")

	for ti := usize(0); ti < nTests; ti++ {
		tname := testNameBuf[testNameOff[ti] : testNameOff[ti]+testNameLen[ti]]
		pos = bufAppendStr(testHarnessBuf[:], pos, "\t{\n")
		if verbose {
			pos = bufAppendStr(testHarnessBuf[:], pos, "\t\tn := formatTo(out[:], \"=== RUN   ")
			pos = bufAppend(testHarnessBuf[:], pos, tname)
			pos = bufAppendStr(testHarnessBuf[:], pos, "\\n\")\n\t\t_ = io.WriteStdout(out[:n])\n")
		}
		pos = bufAppendStr(testHarnessBuf[:], pos, "\t\tt0 := clock.Now()\n\t\tvar t __finc_t.T\n\t\t")
		pos = bufAppend(testHarnessBuf[:], pos, tname)
		pos = bufAppendByte(testHarnessBuf[:], pos, '(')
		pc := usize(testParamCnt[ti])
		for pi := usize(0); pi < pc; pi++ {
			if pi > 0 {
				pos = bufAppendStr(testHarnessBuf[:], pos, ", ")
			}
			k := testParams[ti][pi]
			if k == 0 {
				pos = bufAppendStr(testHarnessBuf[:], pos, "&t")
			} else if k == 1 {
				pos = bufAppendStr(testHarnessBuf[:], pos, "io")
			} else if k == 2 {
				pos = bufAppendStr(testHarnessBuf[:], pos, "env")
			} else if k == 3 {
				pos = bufAppendStr(testHarnessBuf[:], pos, "fs")
			} else if k == 4 {
				pos = bufAppendStr(testHarnessBuf[:], pos, "clock")
			} else if k == 5 {
				pos = bufAppendStr(testHarnessBuf[:], pos, "net")
			} else if k == 6 {
				pos = bufAppendStr(testHarnessBuf[:], pos, "ex")
			}
		}
		pos = bufAppendStr(testHarnessBuf[:], pos, ")\n\t\tdt := (clock.Now() - t0) / 1000\n")
		pos = bufAppendStr(testHarnessBuf[:], pos, "\t\tif t.Failed {\n\t\t\tfailed++\n\t\t\tif t.FailLen > 0 {\n\t\t\t\tn := formatTo(out[:], \"--- FAIL: ")
		pos = bufAppend(testHarnessBuf[:], pos, tname)
		pos = bufAppendStr(testHarnessBuf[:], pos, " (%dus): %s\\n\", dt, t.FailMsg[:t.FailLen])\n\t\t\t\t_ = io.WriteStdout(out[:n])\n\t\t\t} else {\n\t\t\t\tn := formatTo(out[:], \"--- FAIL: ")
		pos = bufAppend(testHarnessBuf[:], pos, tname)
		pos = bufAppendStr(testHarnessBuf[:], pos, " (%dus)\\n\", dt)\n\t\t\t\t_ = io.WriteStdout(out[:n])\n\t\t\t}\n\t\t} else {\n\t\t\tpassed++\n")
		if verbose {
			pos = bufAppendStr(testHarnessBuf[:], pos, "\t\t\tn := formatTo(out[:], \"--- PASS: ")
			pos = bufAppend(testHarnessBuf[:], pos, tname)
			pos = bufAppendStr(testHarnessBuf[:], pos, " (%dus)\\n\", dt)\n\t\t\t_ = io.WriteStdout(out[:n])\n")
		}
		pos = bufAppendStr(testHarnessBuf[:], pos, "\t\t}\n\t}\n")
	}

	pos = bufAppendStr(testHarnessBuf[:], pos, "\tif failed > 0 {\n\t\tn := formatTo(out[:], \"FAIL (%d passed, %d failed)\\n\", passed, failed)\n\t\t_ = io.WriteStdout(out[:n])\n\t\treturn ErrIO\n\t}\n")
	pos = bufAppendStr(testHarnessBuf[:], pos, "\tn := formatTo(out[:], \"PASS (%d passed, 0 failed)\\n\", passed)\n\t_ = io.WriteStdout(out[:n])\n\treturn nil\n}\n")
	testHarnessLen = pos

	tmpDir, err := fs.MkdirTemp("finc1-test-")
	if err != nil {
		testMode = false
		testHarnessLen = 0
		return err
	}
	tmpB := strBytes(tmpDir)
	var binP [512]byte
	binPLen := pathJoin2(binP[:], tmpB, "testbin")
	var noEmit [0]byte
	berr := buildNativeBinary(io, env, fs, ex, rootDir, binP[:binPLen], noEmit[:])
	testMode = false
	testHarnessLen = 0
	if berr != nil {
		_ = fs.RemoveAll(tmpDir)
		return berr
	}

	ctx, cancel := NewContext()
	defer cancel()
	var emptyArgs [0]string
	var emptyEnv [0]string
	var errBuf [4096]byte
	code, en, rerr := ex.Run(ctx, bytesToStr(binP[:binPLen]), emptyArgs[:], emptyEnv[:], "", errBuf[:])
	_ = fs.RemoveAll(bytesToStr(binP[:binPLen]))
	_ = fs.RemoveAll(tmpDir)
	if en > 0 {
		_ = io.WriteStderr(errBuf[:en])
	}
	if rerr != nil || code.Code != 0 {
		return ErrExec
	}
	return nil
}

driver func cmdTest(io Stdio, env Env, fs FS, ex Exec) error {
	argc := env.ArgsCount()
	verbose := false
	var dirBuf [512]byte
	var dirLen usize = 0
	var filterBuf [128]byte
	var filterLen usize = 0
	for i := usize(2); i < argc; i++ {
		arg := strBytes(env.Arg(i))
		if sliceEq(arg, strBytes("-v")) {
			verbose = true
		} else if len(arg) > 5 && sliceEq(arg[:5], strBytes("-run=")) {
			filterLen = copy(filterBuf[:], arg[5:])
		} else {
			dirLen = copy(dirBuf[:], arg)
		}
	}
	if dirLen == 0 {
		dirBuf[0] = '.'
		dirLen = 1
	}
	rootDir := dirBuf[:dirLen]

	// Auto-detect corpus mode (`pass/` or `fail/` subdirs) vs package unit-test mode (`*_test.fc`)
	var probePass [512]byte
	ppLen := pathJoin2(probePass[:], rootDir, "pass")
	var probeFail [512]byte
	pfLen := pathJoin2(probeFail[:], rootDir, "fail")
	if !fs.IsDir(bytesToStr(probePass[:ppLen])) && !fs.IsDir(bytesToStr(probeFail[:pfLen])) {
		return runUnitTests(io, env, fs, ex, rootDir, verbose, filterBuf[:filterLen])
	}

	var total u32 = 0
	var passed u32 = 0
	var failed u32 = 0
	var skipped u32 = 0
	var skipMaxMaj u32 = 0
	var skipMaxMin u32 = 0

	var subNames [2]string
	subNames[0] = "pass"
	subNames[1] = "fail"
	for si := usize(0); si < 2; si++ {
		isPass := si == 0
		var subDir [512]byte
		subLen := pathJoin2(subDir[:], rootDir, subNames[si])
		if !fs.IsDir(bytesToStr(subDir[:subLen])) {
			continue
		}
		var listBuf [8192]byte
		ln := listDirEntries(ex, subDir[:subLen], listBuf[:])
		pos := usize(0)
		driver for pos < ln {
			ls := pos
			driver for pos < ln && listBuf[pos] != '\n' {
				pos++
			}
			entry := listBuf[ls:pos]
			if pos < ln {
				pos++
			}
			if len(entry) == 0 {
				continue
			}
			var fullPath [512]byte
			fpLen := pathJoin2(fullPath[:], subDir[:subLen], bytesToStr(entry))
			isDir := fs.IsDir(bytesToStr(fullPath[:fpLen]))
			isFc := len(entry) > 3 && entry[len(entry)-3] == '.' && entry[len(entry)-2] == 'f' && entry[len(entry)-1] == 'c'
			if !isDir && !isFc {
				continue
			}
			total++
			var needMaj u32 = 0
			var needMin u32 = 0
			scanSinceRecursive(fs, rootDir, fullPath[:fpLen], &needMaj, &needMin, 0)
			if needMaj > 0 || (needMaj == 0 && needMin > 7) {
				skipped++
				if needMaj > skipMaxMaj || (needMaj == skipMaxMaj && needMin > skipMaxMin) {
					skipMaxMaj = needMaj
					skipMaxMin = needMin
				}
				if verbose {
					var mb [256]byte
					mn := formatTo(mb[:], "SKIP %s (needs v%d.%d)\n", entry, needMaj, needMin)
					_ = io.WriteStdout(mb[:mn])
				}
				continue
			}
			// Execute pass or fail check
			poolInit()
			lexerInit()
			astInit()
			typesInit()
			valsInit()
			resolveInit(env)
			comptimeFuelBudget = 1_000_000
			lerr := loadProgram(fs, fullPath[:fpLen])
			if lerr == nil && diagCount == 0 {
				checkProgram()
			}
			if isPass {
				if lerr == nil && diagCount == 0 {
					passed++
					if verbose {
						var mb [256]byte
						mn := formatTo(mb[:], "PASS %s\n", entry)
						_ = io.WriteStdout(mb[:mn])
					}
				} else {
					failed++
					if verbose {
						var mb [256]byte
						mn := formatTo(mb[:], "FAIL %s\n", entry)
						_ = io.WriteStdout(mb[:mn])
					}
				}
			} else {
				if diagCount > 0 {
					passed++
					if verbose {
						var mb [256]byte
						mn := formatTo(mb[:], "PASS %s\n", entry)
						_ = io.WriteStdout(mb[:mn])
					}
				} else {
					failed++
					if verbose {
						var mb [256]byte
						mn := formatTo(mb[:], "FAIL %s\n", entry)
						_ = io.WriteStdout(mb[:mn])
					}
				}
			}
		}
	}

	var sum [256]byte
	var sn usize = 0
	if skipped > 0 {
		sn = formatTo(sum[:], "%d tests, %d passed, %d failed, %d skipped (needs v%d.%d)\n",
			total, passed, failed, skipped, skipMaxMaj, skipMaxMin)
	} else {
		sn = formatTo(sum[:], "%d tests, %d passed, %d failed, 0 skipped\n", total, passed, failed)
	}
	_ = io.WriteStdout(sum[:sn])
	if failed > 0 {
		return ErrIO
	}
	return nil
}
