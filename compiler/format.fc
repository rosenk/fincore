// format.fc — the v0.2 builtin formatTo(dst []byte, format string,
// args...) usize (port of finc0's types/format.go, the formatTo parts of
// codegen/golang/expr.go and comptime.go, and runtime/fincrt/fmt.go for the
// comptime evaluator). See docs/semantics_decisions.md, "v0.2 additions".
//
// The format is a constant string. It is parsed lazily, one piece at a time
// (fmtNext), by the checker, the code generator and the comptime evaluator;
// finc0 parses it once into a piece list (types.ParseFormat) with the same
// result. The checker records, per formatted argument, the write operation
// and the Format method ((op, method) pairs in ulists, in the call's
// CallKind.Builtin).
package main

import "std/strconv"

// Write operations (types.FormatOp), aligned with finc0.
const (
	FmtNone       = 0
	FmtInt        = 1
	FmtUint       = 2
	FmtHexInt     = 3
	FmtHexUint    = 4
	FmtStr        = 5
	FmtBytes      = 6
	FmtQuoteStr   = 7
	FmtQuoteBytes = 8
	FmtByte       = 9
	FmtBool       = 10
	FmtFormat     = 11

	MaxFormatWidth = 64
)

// Piece kinds and format errors.
const (
	FdEnd  = 0
	FdLit  = 1 // literal text [start, end), `%%` still escaped
	FdVerb = 2 // directive [start, end)
	FdErr  = 3 // malformed directive [start, end)

	FeIncomplete = 1
	FeUnknown    = 2
	FePercent    = 3
	FeWidth      = 4
	FeZero       = 5
)

// Shared message texts.
const (
	BadFormat = "invalid format for formatTo: "
	BadArg    = "cannot use %v (type %v) as argument for %%"
	NoFmtInfo = "formatTo without format information"
	NoFmtOp   = "formatTo argument without a format operation"
)

type FmtDir struct {
	kind  u8
	err   u8
	verb  byte
	left  bool
	zero  bool
	width u32
	start usize
	end   usize
}

// fmtNext parses the piece of s that starts at i. A literal piece is the
// longest run of text and `%%` escapes (finc0 merges them into one piece).
func fmtNext(s []byte, i usize) FmtDir {
	var d FmtDir
	n := len(s)
	d.start = i
	d.end = i
	if i >= n {
		return d
	}
	j := i
	if s[i] != '%' || (i+1 < n && s[i+1] == '%') {
		for g := usize(0); g < n; g++ {
			if j >= n {
				break
			}
			if s[j] != '%' {
				j++
				continue
			}
			if j+1 < n && s[j+1] == '%' {
				j += 2
				continue
			}
			break
		}
		d.kind = FdLit
		d.end = j
		return d
	}
	j = i + 1
	for g := usize(0); g < n; g++ {
		if j >= n || (s[j] != '-' && s[j] != '0') {
			break
		}
		if s[j] == '-' {
			d.left = true
		} else {
			d.zero = true
		}
		j++
	}
	hasWidth := false
	for g := usize(0); g < n; g++ {
		if j >= n || s[j] < '0' || s[j] > '9' {
			break
		}
		hasWidth = true
		if d.width <= MaxFormatWidth {
			d.width = d.width*10 + u32(s[j]-'0')
		}
		j++
	}
	d.kind = FdErr
	if j >= n {
		d.err = FeIncomplete
		d.end = n
		return d
	}
	v := s[j]
	d.end = j + 1
	if v == '%' {
		d.err = FePercent
		return d
	}
	if !(v is 'd' | 'x' | 's' | 'c' | 'q' | 'v') {
		d.err = FeUnknown
		return d
	}
	if hasWidth && d.width > MaxFormatWidth {
		d.err = FeWidth
		return d
	}
	if d.zero && !(v is 'd' | 'x') {
		d.err = FeZero
		return d
	}
	d.kind = FdVerb
	d.verb = v
	return d
}

// fmtErrMsg formats the message of a malformed directive into mbuf and
// returns its length.
func fmtErrMsg(s []byte, d FmtDir) usize {
	dir := Quoted(s[d.start:d.end])
	return match d.err {
		FeIncomplete -> formatTo(mbuf[:], BadFormat+"incomplete directive %v at the end of the format", dir)
		FeUnknown -> formatTo(mbuf[:], BadFormat+"unknown verb in directive %v", dir)
		FePercent -> formatTo(mbuf[:], BadFormat+"directive %v cannot have flags or a width", dir)
		FeWidth -> formatTo(mbuf[:], BadFormat+"width in directive %v exceeds 64", dir)
		_ -> formatTo(mbuf[:], BadFormat+"flag 0 in directive %v is only valid with %%d and %%x", dir)
	}
}

// fmtCount validates s and returns its number of directives; on a
// malformed directive it reports E2002 at node `at` and returns false.
func fmtCount(s []byte, at u32) (usize, bool) {
	n := len(s)
	i := usize(0)
	cnt := usize(0)
	for g := usize(0); g < n+1; g++ {
		d := fmtNext(s, i)
		if d.kind == FdEnd {
			break
		}
		if d.kind == FdErr {
			errAt(E2002, at, fmtErrMsg(s, d))
			return 0, false
		}
		if d.kind == FdVerb {
			cnt++
		}
		i = d.end
	}
	return cnt, true
}

// fmtFormatString returns the constant format of a checked formatTo call.
func fmtFormatString(e u32) []byte {
	s := nval[usize(l1at(e, 1))]
	if slotGet(s) is Str(off, n) {
		return strSpan(off, n)
	}
	return emptyBytes()
}

// fmtInfo returns the (op, method) pairs of call c if it is a formatTo
// call with n arguments that was checked without errors.
func fmtInfo(c u32, n usize) (u32, bool) {
	if callTab.items[usize(c)].kind is Builtin(_, true, fs, fn) && n >= 2 && usize(fn) == 2*(n-2) {
		return fs, true
	}
	return 0, false
}

// fmtArgOp / fmtArgMethod: the pair of formatted argument k in the run fs.
func fmtArgOp(fs u32, k usize) u8 {
	return u8(uat(fs, 2*k))
}

func fmtArgMethod(fs u32, k usize) u32 {
	return uat(fs, 2*k+1)
}

// ---------------------------------------------------------------------------
// Type checking (types/format.go)

func fmtIntOp(t u32, hex bool) u8 {
	if hex && isUnsigned(t) {
		return FmtHexUint
	}
	if hex {
		return FmtHexInt
	}
	if isUnsigned(t) {
		return FmtUint
	}
	return FmtInt
}

// isByteSliceT: t's underlying type is []u8.
func isByteSliceT(t u32) bool {
	return trec(underlying(t)) is Slice(TyU8)
}

// formatMethodOK: m is a value-receiver, total `Format(dst []byte) usize`.
func formatMethodOK(m u32) bool {
	r := meths.items[usize(m)]
	if r.ptrRecv || r.builtin != 0 || r.sig == 0 {
		return false
	}
	s := r.sig
	return sigEffect(s) == EffTotal && !sigVariadic(s) && sigNParams(s) == 1 && sigNResults(s) == 1 &&
		sigParam(s, 0) == mkSlice(TyU8) && sigResult(s, 0) == TyUsize
}

// formatCall checks a formatTo call (Checker.formatCall).
func formatCall(e u32, ci u32, dp usize) Operand decreases(dp) {
	if dp == 0 {
		tooDeep()
		return invalidOp(e)
	}
	ctx := Ctx.ArgBuiltin(BFFormatTo)
	n := l1len(e)
	if n < 2 {
		errAt(E2003, e, formatTo(mbuf[:], "not enough arguments in call to formatTo: have %d, want at least 2", n))
		useArgs(e, 0, dp-1)
		return invalidOp(e)
	}
	ok := true
	d := exprValue(l1at(e, 0), dp-1)
	if isInvalidOp(&d) || !assignment(&d, mkSlice(TyU8), ctx) {
		ok = false
	}
	a1 := l1at(e, 1)
	fx := exprValue(a1, dp-1)
	fok := true
	if isInvalidOp(&fx) || !assignment(&fx, TyString, ctx) {
		ok = false
		fok = false
	} else if fx.mode != KConst || fx.val == Val.None {
		errAt(E2002, a1, formatTo(mbuf[:], "format argument %v to formatTo must be a constant string", Expr(a1)))
		ok = false
		fok = false
	}
	mark := opStack.top
	for i := usize(2); i < n; i++ {
		opPush(exprValue(l1at(e, i), dp-1))
	}
	nargs := n - 2
	s := emptyBytes()
	if fok {
		s = strOf(fx.val)
		cnt, good := fmtCount(s, a1)
		if !good {
			fok = false
		} else if cnt != nargs {
			errAt(E2003, a1, formatTo(mbuf[:], "wrong number of arguments for format %v in call to formatTo: have %d, want %d", Quoted(s), nargs, cnt))
			fok = false
		}
	}
	if !fok {
		for k := usize(0); k < nargs; k++ {
			x := opStack.items[mark+k]
			if !isInvalidOp(&x) {
				_ = defaultTypeOp(&x, ctx)
			}
			opStack.items[mark+k] = x
		}
		opStack.top = mark
		return opMode(KValue, TyUsize)
	}
	um := umark()
	ln := len(s)
	i := usize(0)
	k := usize(0)
	for g := usize(0); g < ln+1; g++ {
		p := fmtNext(s, i)
		if p.kind == FdEnd {
			break
		}
		i = p.end
		if p.kind != FdVerb {
			continue
		}
		x := opStack.items[mark+k]
		arg := l1at(e, 2+k)
		k++
		op := u8(FmtNone)
		m := u32(0)
		if !isInvalidOp(&x) {
			if isUntyped(x.typ) {
				if p.verb == 'c' {
					_ = convertUntyped(&x, TyU8)
				} else {
					_ = defaultTypeOp(&x, ctx)
				}
			}
			if !isUntyped(x.typ) && !isInvalid(x.typ) {
				op, m = formatArg(arg, x.typ, p.verb, dp-1)
			}
		}
		if op == FmtNone {
			ok = false
		}
		upush(u32(op))
		upush(m)
	}
	opStack.top = mark
	if !ok {
		ulists.Discard(um)
		return opMode(KValue, TyUsize)
	}
	fs, fn := ucommit(um)
	callTab.items[usize(ci)].kind = CallKind.Builtin(BFFormatTo, true, fs, fn)
	return opMode(KValue, TyUsize)
}

// formatArg matches an argument of type t against verb v; it returns the
// write operation (FmtNone after reporting an error) and the Format method.
func formatArg(a u32, t u32, v byte, dp usize) (u8, u32) decreases(dp) {
	if dp == 0 {
		tooDeep()
		return FmtNone, 0
	}
	if classOfT(t) != ClassValue {
		errAt(E2002, a, formatTo(mbuf[:], "cannot format %v (type %v): formatTo arguments must be Value types", Expr(a), TypeRef(t)))
		return FmtNone, 0
	}
	op := u8(FmtNone)
	if v is 'd' | 'x' {
		if isInteger(t) {
			op = fmtIntOp(t, v == 'x')
		}
	} else if v is 's' | 'q' {
		if isString(t) {
			op = FmtStr
		} else if isByteSliceT(t) {
			op = FmtBytes
		}
		if v == 'q' && op != FmtNone {
			op += FmtQuoteStr - FmtStr
		}
	} else if v == 'c' {
		if basicKind(t) == BkU8 {
			op = FmtByte
		}
	} else {
		if isNamedT(t) && builtinOf(t) == 0 {
			m := lookupMethod(t, internStr("Format"), dp-1)
			if m != 0 {
				if !formatMethodOK(m) {
					errAt(E2002, a, formatTo(mbuf[:], BadArg+"v in formatTo: method %v.Format must be a total value-receiver method func(dst []byte) usize", Expr(a), TypeRef(t), TypeRef(t)))
					return FmtNone, 0
				}
				return FmtFormat, m
			}
		}
		if isBoolean(t) {
			op = FmtBool
		} else if isInteger(t) {
			op = fmtIntOp(t, false)
		} else if isString(t) {
			op = FmtStr
		} else if isByteSliceT(t) {
			op = FmtBytes
		}
	}
	if op == FmtNone {
		errAt(E2002, a, formatTo(mbuf[:], BadArg+"%c in formatTo", Expr(a), TypeRef(t), v))
		return FmtNone, 0
	}
	return op, 0
}

// ---------------------------------------------------------------------------
// Code generation (codegen/golang expr.go: formatTo)

// cgFmtParamType is formatParamType: the Go parameter type (and
// conversion) of a non-Format argument.
func cgFmtParamType(op u8) string {
	return match op {
		FmtInt | FmtHexInt -> "int64"
		FmtUint | FmtHexUint -> "uint64"
		FmtStr | FmtQuoteStr -> "string"
		FmtBytes | FmtQuoteBytes -> "[]byte"
		FmtByte -> "byte"
		FmtBool -> "bool"
		_ -> "_"
	}
}

// cgWFmtLit writes strconv.Quote of a literal piece with `%%` unescaped.
func cgWFmtLit(raw []byte) {
	o := &cgBuf
	o.WriteByte('"')
	n := len(raw)
	st := usize(0)
	j := usize(0)
	for g := usize(0); g < n; g++ {
		if j >= n {
			break
		}
		if raw[j] == '%' {
			putQuotedBody(o, raw[st:j])
			o.WriteByte('%')
			j += 2
			st = j
			continue
		}
		j++
	}
	if st < n {
		putQuotedBody(o, raw[st:n])
	}
	o.WriteByte('"')
}

// cgWFmtWidth writes strconv.Itoa(FormatWidth()).
func cgWFmtWidth(p FmtDir) {
	if p.left && p.width > 0 {
		cgWc('-')
	}
	cgWu(u64(p.width))
}

func cgFormatTo(e u32, c u32, dp usize) decreases(dp) {
	if dp == 0 {
		return
	}
	n := l1len(e)
	fs, ok := fmtInfo(c, n)
	if !ok {
		cgFail(e, NoFmtInfo)
		return
	}
	nargs := n - 2
	cgW("func(_fc_d []byte")
	for k := usize(0); k < nargs; k++ {
		cgWf(formatTo(mbuf[:], ", _fc_a%d ", k))
		op := fmtArgOp(fs, k)
		if op == FmtFormat {
			a := l1at(e, 2+k)
			cgGoType(a, ntype[usize(a)], dp-1)
		} else {
			cgW(cgFmtParamType(op))
		}
	}
	cgW(") uint { _fc_w := ")
	cgRt("NewFmt")
	cgW("(_fc_d); ")
	s := fmtFormatString(e)
	ln := len(s)
	i := usize(0)
	k := usize(0)
	for g := usize(0); g < ln+1; g++ {
		p := fmtNext(s, i)
		if p.kind == FdEnd {
			break
		}
		i = p.end
		if p.kind == FdLit {
			cgW("_fc_w.Lit(")
			cgWFmtLit(s[p.start:p.end])
			cgW("); ")
			continue
		}
		if p.kind != FdVerb || k >= nargs {
			cgFail(e, NoFmtInfo)
			return
		}
		op := fmtArgOp(fs, k)
		cgW("_fc_w.")
		if op == FmtInt {
			cgW("Int(")
		} else if op == FmtUint {
			cgW("Uint(")
		} else if op == FmtHexInt {
			cgW("HexInt(")
		} else if op == FmtHexUint {
			cgW("Hex(")
		} else if op == FmtStr {
			cgW("Str(")
		} else if op == FmtBytes {
			cgW("Bytes(")
		} else if op == FmtQuoteStr {
			cgW("Quote(")
		} else if op == FmtQuoteBytes {
			cgW("QuoteBytes(")
		} else if op == FmtByte {
			cgW("Byte(")
		} else if op == FmtBool {
			cgW("Bool(")
		} else if op == FmtFormat {
			cgW("Advance(")
		} else {
			cgFail(e, NoFmtOp)
			return
		}
		cgW("_fc_a")
		cgWu(u64(k))
		if op == FmtFormat {
			cgWc('.')
			cgWSymName(meths.items[usize(fmtArgMethod(fs, k))].sym)
			cgW("(_fc_w.Dst(")
			cgWFmtWidth(p)
			cgW(")), ")
			cgWFmtWidth(p)
		} else {
			cgW(", ")
			cgWFmtWidth(p)
			if op is FmtInt | FmtUint | FmtHexInt | FmtHexUint {
				if p.zero {
					cgW(", true")
				} else {
					cgW(", false")
				}
			}
		}
		cgW("); ")
		k++
	}
	cgW("return _fc_w.N() }(")
	cgExpr(l1at(e, 0), dp-1)
	for k2 := usize(0); k2 < nargs; k2++ {
		a := l1at(e, 2+k2)
		op := fmtArgOp(fs, k2)
		cgW(", ")
		if op == FmtFormat {
			cgExpr(a, dp-1)
		} else {
			cgW(cgFmtParamType(op))
			cgWc('(')
			cgExpr(a, dp-1)
			cgWc(')')
		}
	}
	cgWc(')')
}

// ---------------------------------------------------------------------------
// Comptime evaluation (comptime.go: formatTo, fincrt.Fmt)
//
// Like finc0, the writer works on a copy of dst (a heap array cfRef of
// cfLen byte slots) that is copied back when the call ends; a %v Format
// method gets a slice of that copy (or of the 64-byte scratch array cfScr
// when right-justifying into less room than the width, fincrt.Fmt.Dst).

var cfRef u32
var cfLen usize
var cfN usize
var cfScr u32
var cfInScr bool

func cfPut(c byte) {
	if cfN < cfLen {
		slotSet(cfRef+u32(cfN), vIntU(u64(c)))
		cfN++
	}
}

func cfFill(c byte, k usize) {
	for i := usize(0); i < k; i++ {
		cfPut(c)
	}
}

func cfPadLeft(l usize, width int) {
	if width > 0 && usize(width) > l {
		cfFill(' ', usize(width)-l)
	}
}

func cfPadRight(l usize, width int) {
	if width < 0 && usize(-width) > l {
		cfFill(' ', usize(-width)-l)
	}
}

func cfBytes(b []byte, width int) {
	n := len(b)
	cfPadLeft(n, width)
	for i := usize(0); i < n; i++ {
		cfPut(b[i])
	}
	cfPadRight(n, width)
}

// cfQuote writes b as strconv.Quote does (FinCore %q escapes), padded.
func cfQuote(b []byte, width int) {
	l := strconv.QuotedLen(b)
	cfPadLeft(l, width)
	cfPut('"')
	n := len(b)
	var q [6]byte
	for i := usize(0); i < n; i++ {
		k := strconv.Quote(q[:], b[i:i+1]) // "c", "\n" or "\xHH" with quotes
		e := q[1 : k-1]
		for j := usize(0); j < len(e); j++ {
			cfPut(e[j])
		}
	}
	cfPut('"')
	cfPadRight(l, width)
}

func cfNumber(neg bool, mag u64, base u64, width int, zero bool) {
	var tmp [strconv.MaxUintLen]byte
	digits := tmp[:strconv.FormatUint(tmp[:], mag, u32(base))]
	l := len(digits)
	if neg {
		l++
	}
	if zero && width > 0 {
		if neg {
			cfPut('-')
		}
		if usize(width) > l {
			cfFill('0', usize(width)-l)
		}
	} else {
		cfPadLeft(l, width)
		if neg {
			cfPut('-')
		}
	}
	for j := usize(0); j < len(digits); j++ {
		cfPut(digits[j])
	}
	cfPadRight(l, width)
}

func cfSigned(v Val, base u64, width int, zero bool) {
	lo := intLo(v)
	if i64(lo) < 0 {
		cfNumber(true, AllOnes-lo+1, base, width, zero)
	} else {
		cfNumber(false, lo, base, width, zero)
	}
}

// cfDst is fincrt.Fmt.Dst: the slice a Format method writes into.
func cfDst(width int) Val {
	w := width
	if w > MaxFormatWidth {
		w = MaxFormatWidth
	}
	if w > 0 && usize(w) > cfLen-cfN {
		if cfScr == 0 {
			cfScr = valAlloc(MaxFormatWidth, true)
			for i := usize(0); i < MaxFormatWidth; i++ {
				slotSet(cfScr+u32(i), vIntU(0))
			}
		}
		cfInScr = true
		return Val.Slice(cfScr, 0, u32(w), u64(w))
	}
	cfInScr = false
	return Val.Slice(cfRef, u32(cfN), u32(cfLen), u64(cfLen))
}

// cfAdvance is fincrt.Fmt.Advance.
func cfAdvance(n0 u64, width int) {
	if cfInScr {
		cfInScr = false
		w := width
		if w > MaxFormatWidth {
			w = MaxFormatWidth
		}
		n := usize(0)
		if w > 0 {
			n = usize(w)
		}
		if n0 < u64(n) {
			n = usize(n0)
		}
		cfPadLeft(n, width)
		for i := usize(0); i < n; i++ {
			cfPut(byte(intLo(slotGet(cfScr + u32(i)))))
		}
		cfPadRight(n, width)
		return
	}
	l := cfLen - cfN
	if n0 < u64(l) {
		l = usize(n0)
	}
	if width > 0 && usize(width) > l {
		pad := usize(width) - l
		start := cfN
		for q := usize(0); q < l; q++ {
			i := l - 1 - q
			j := start + pad + i
			if j < cfLen {
				slotSet(cfRef+u32(j), slotGet(cfRef+u32(start+i)))
			}
		}
		cfFill(' ', pad)
		cfN = start + pad + l
		if cfN > cfLen {
			cfN = cfLen
		}
		return
	}
	cfN += l
	cfPadRight(l, width)
}

// iformatTo runs a formatTo call whose arguments are vstack[m:]: one unit
// of fuel per formatted argument; a Format method is interpreted like any
// other call.
func iformatTo(e u32, m usize, dp usize) Val decreases(dp) {
	var z Val
	if dp == 0 {
		tooDeep()
		failSilent()
		return z
	}
	n := vtop - m
	fs, ok := fmtInfo(ncall[usize(e)], n)
	if !ok {
		failS(E2002, NoFmtInfo)
		return z
	}
	d := vstack[m]
	dref, dn := sliceElems(d)
	dlen := usize(dn)
	saveRef := cfRef
	saveLen := cfLen
	saveN := cfN
	saveScr := cfScr
	saveIn := cfInScr
	cfRef = valAlloc(dlen, true)
	cfLen = dlen
	cfN = 0
	cfScr = 0
	cfInScr = false
	for i := usize(0); i < dlen; i++ {
		slotSet(cfRef+u32(i), slotGet(dref+u32(i)))
	}
	s := strOf(vstack[m+1])
	ln := len(s)
	i := usize(0)
	k := usize(0)
	for g := usize(0); g < ln+1; g++ {
		p := fmtNext(s, i)
		if p.kind == FdEnd {
			break
		}
		i = p.end
		if p.kind == FdLit {
			raw := s[p.start:p.end]
			rn := len(raw)
			j := usize(0)
			for h := usize(0); h < rn; h++ {
				if j >= rn {
					break
				}
				cfPut(raw[j])
				if raw[j] == '%' {
					j++
				}
				j++
			}
			continue
		}
		if p.kind != FdVerb || 2+k >= n {
			failS(E2002, NoFmtInfo)
			break
		}
		tick()
		if ifail {
			break
		}
		v := vstack[m+2+k]
		op := fmtArgOp(fs, k)
		meth := fmtArgMethod(fs, k)
		k++
		width := int(p.width)
		if p.left {
			width = -width
		}
		if op == FmtInt {
			cfSigned(v, 10, width, p.zero)
		} else if op == FmtHexInt {
			cfSigned(v, 16, width, p.zero)
		} else if op == FmtUint {
			cfNumber(false, intLo(v), 10, width, p.zero)
		} else if op == FmtHexUint {
			cfNumber(false, intLo(v), 16, width, p.zero)
		} else if op == FmtStr {
			cfBytes(strOf(v), width)
		} else if op == FmtQuoteStr {
			cfQuote(strOf(v), width)
		} else if op is FmtBytes | FmtQuoteBytes {
			if !bytesOfSlice(v) {
				break
			}
			if op == FmtBytes {
				cfBytes(tmpBuf.Bytes(), width)
			} else {
				cfQuote(tmpBuf.Bytes(), width)
			}
		} else if op == FmtByte {
			cfPadLeft(1, width)
			cfPut(byte(intLo(v)))
			cfPadRight(1, width)
		} else if op == FmtBool {
			if v is Bool(true) {
				cfBytes("true", width)
			} else {
				cfBytes("false", width)
			}
		} else if op == FmtFormat {
			am := vtop
			vpush(cfDst(width))
			r := icall(meths.items[usize(meth)].sym, v, true, am, vtop, e, dp-1)
			vtop = am
			if ifail {
				break
			}
			rn, _ := valUint64(r)
			cfAdvance(rn, width)
		} else {
			failS(E2002, NoFmtOp)
			break
		}
	}
	res := vIntU(u64(cfN))
	if !ifail {
		for j := usize(0); j < dlen; j++ {
			slotSet(dref+u32(j), slotGet(cfRef+u32(j)))
		}
	}
	cfRef = saveRef
	cfLen = saveLen
	cfN = saveN
	cfScr = saveScr
	cfInScr = saveIn
	if ifail {
		return z
	}
	return res
}
