	}
	if k == NkPointerType {
		return "PointerType"
	}
	if k == NkStructType {
		return "StructType"
	}
	if k == NkFieldDecl {
		return "FieldDecl"
	}
	if k == NkEnumType {
		return "EnumType"
	}
	if k == NkVariant {
		return "Variant"
	}
	if k == NkFuncType {
		return "FuncType"
	}
	if k == NkCodeType {
		return "CodeType"
	}
	if k == NkElType {
		return "ElType"
	}
	if k == NkAnyType {
		return "AnyType"
	}
	if k == NkBlockStmt {
		return "BlockStmt"
	}
	if k == NkDeclStmt {
		return "DeclStmt"
	}
	if k == NkShortVarDecl {
		return "ShortVarDecl"
	}
	if k == NkAssignStmt {
		return "AssignStmt"
	}
	if k == NkIncDecStmt {
		return "IncDecStmt"
	}
	if k == NkExprStmt {
		return "ExprStmt"
	}
	if k == NkIfStmt {
		return "IfStmt"
	}
	if k == NkMatchStmt {
		return "MatchStmt"
	}
	if k == NkMatchArm {
		return "MatchArm"
	}
	if k == NkWildcardPattern {
		return "WildcardPattern"
	}
