package main

// Compact flat AST arena for FinCore v0.1 Native.
// Every node is 32 bytes (5 u32 slots + kind/op/flags/fileID/off).
// Variable-length child lists live in listPool (start, count).

const (
	MaxNodes    = 262144
	MaxListPool = 524288
	MaxU64Pool  = 65536
)

// Node kinds.
const (
	NKNone u8 = 0

	// Top-level & declarations
	NKFile       u8 = 1  // a=pkgNameStr, b=impStart, c=impCount, d=declStart, e=declCount
	NKImport     u8 = 2  // a=aliasStr(0=none), b=pathStr
	NKConstDecl  u8 = 3  // a=nameStr, b=typeNode(0=none), c=valExpr, d=iotaVal
	NKVarDecl    u8 = 4  // a=nameStr, b=typeNode(0=none), c=valExpr(0=none)
	NKTypeDecl   u8 = 5  // flags: bit0=alias; a=nameStr, b=tparamStart, c=tparamCount, d=typeNode
	NKFuncDecl   u8 = 6  // op=effect(0=total,1=comptime,2=driver); a=nameStr, b=recvNode(0=none), c=sigNode, d=bodyBlock, e=decreasesExpr
	NKRecv       u8 = 7  // flags: bit0=ptr; a=nameStr, b=recvTypeNameStr, c=tparamStart, d=tparamCount
	NKFuncSig    u8 = 8  // a=tparamStart, b=tparamCount, c=paramStart, d=paramCount, e=retListNode(NKList)
	NKParam      u8 = 9  // flags: bit0=variadic; a=nameStr(0=unnamed), b=typeNode
	NKTypeParam  u8 = 10 // flags: bit0=isConst; a=nameStr, b=constTypeNode(0=any)
	NKList       u8 = 11 // a=start, b=count
	NKEffectDecl u8 = 12 // a=nameStr, b=tparamStart, c=tparamCount, d=opStart, e=opCount
	NKEffectOp   u8 = 13 // a=opNameStr, b=sigNode (NKFuncSig)

	// Types
	NKTypeName   u8 = 20 // a=pkgStr(0=none), b=nameStr, c=targStart, d=targCount
	NKTypeArray  u8 = 21 // a=lenExpr, b=elemType
	NKTypeSlice  u8 = 22 // a=elemType
	NKTypePtr    u8 = 23 // a=elemType
	NKTypeStruct u8 = 24 // a=fieldStart, b=fieldCount (each NKField)
	NKField      u8 = 25 // a=nameStr, b=typeNode
	NKTypeEnum   u8 = 26 // a=varStart, b=varCount (each NKVariant)
	NKVariant    u8 = 27 // a=nameStr, b=payloadStart, c=payloadCount
	NKTypeFunc   u8 = 28 // op=effect(0=total,2=driver); a=paramStart, b=paramCount, c=retStart, d=retCount
	NKTypeCode   u8 = 29 // a=levelU32
	NKTypeEl     u8 = 30 // a=codeExpr

	// Statements
	NKBlock       u8 = 40 // a=stmtStart, b=stmtCount
	NKExprStmt    u8 = 41 // a=expr
	NKAssign      u8 = 42 // op=assignTokKind; a=lhsStart, b=lhsCount, c=rhsStart, d=rhsCount
	NKShortDecl   u8 = 43 // a=lhsStart(NKIdent), b=lhsCount, c=rhsStart, d=rhsCount
	NKIncDec      u8 = 44 // op=TKInc/TKDec; a=expr
	NKIf          u8 = 45 // a=initStmt(0=none), b=condExpr, c=thenBlock, d=elseStmt(0=none)
	NKFor         u8 = 46 // flags: bit0=driver; a=initStmt, b=condExpr, c=postStmt, d=bodyBlock
	NKMatchStmt   u8 = 47 // a=scrutExpr, b=armStart, c=armCount
	NKMatchArm    u8 = 48 // a=patNode, b=bodyNode(NKBlock or expr)
	NKScope       u8 = 49 // a=nameStr, b=valExpr, c=bodyBlock
	NKDefer       u8 = 50 // a=callExpr
	NKReturn      u8 = 51 // a=resStart, b=resCount
	NKBreak       u8 = 52
	NKContinue    u8 = 53
	NKDeclStmt    u8 = 54 // a=declNode (NKVarDecl / NKConstDecl / NKTypeDecl)
	NKHandleStmt  u8 = 55 // flags: bit0=isBlockBody; a=bodyNode, b=armStart, c=armCount, d=effTypeNode(0=infer)
	NKHandleArm   u8 = 56 // a=opNameStr, b=paramStart, c=paramCount, d=bodyNode(NKBlock or expr)

	// Patterns
	NKPatWild    u8 = 60 // _
	NKPatLit     u8 = 61 // a=litExpr
	NKPatCtor    u8 = 62 // a=nameExpr(Ident or Selector), b=bindStart, c=bindCount (NKIdent/NKPatWild)
	NKPatOr      u8 = 63 // a=patStart, b=patCount

	// Expressions
	NKIdent      u8 = 70 // a=strID
	NKIntLit     u8 = 71 // a=strID, b=u64PoolIdx
	NKStrLit     u8 = 72 // a=strID (decoded)
	NKCharLit    u8 = 73 // a=byteVal
	NKBoolLit    u8 = 74 // a=0/1
	NKNilLit     u8 = 75
	NKUnary      u8 = 76 // op=tokKind; a=expr
	NKBinary     u8 = 77 // op=tokKind; a=lhs, b=rhs
	NKCall       u8 = 78 // a=funExpr, b=argStart, c=argCount
	NKIndex      u8 = 79 // a=xExpr, b=idxStart, c=idxCount
	NKSlice      u8 = 80 // flags: bit0=has3; a=xExpr, b=lo(0=none), c=hi(0=none), d=max(0=none)
	NKSelector   u8 = 81 // a=xExpr, b=selStrID
	NKStructLit  u8 = 82 // a=typeNode, b=fieldInitStart, c=fieldInitCount
	NKFieldInit  u8 = 83 // a=nameStr, b=valExpr
	NKArrayLit   u8 = 84 // a=typeNode(NKTypeArray), b=elemStart, c=elemCount
	NKMatchExpr  u8 = 85 // a=scrutExpr, b=armStart, c=armCount
	NKFuncLit    u8 = 86 // op=effect(0=total,2=driver); a=sigNode, b=bodyBlock
	NKTypeExpr   u8 = 87 // a=typeNode (when type syntax appears in expr pos, e.g. T(x) or []byte(x))
	NKHandleExpr u8 = 88 // flags: bit0=isBlockBody; a=bodyNode, b=armStart, c=armCount, d=effTypeNode(0=infer)
	NKFloatLit   u8 = 89 // a=strID, b=u64PoolIdx (IEEE-754 f64 bit pattern)
)

// Effect modes (stored in Node.op for NKFuncDecl/NKFuncLit/NKTypeFunc).
const (
	EffTotal    u8 = 0
	EffComptime u8 = 1
	EffDriver   u8 = 2
)

type Node struct {
	kind   u8
	op     u8
	flags  u16
	fileID u32
	off    u32
	a      u32
	b      u32
	c      u32
	d      u32
	e      u32
}

var nodes [MaxNodes]Node
var nodeCount u32
var sigEffStart [MaxNodes]u32 // listPool start of `with E1, E2` effect type nodes on NKFuncSig
var sigEffCount [MaxNodes]u32
var paramWhere [MaxNodes]u32 // optional `where <predExpr>` node on NKParam (v0.4)
var listPool [MaxListPool]u32
var listUsed u32
var u64Pool [MaxU64Pool]u64
var u64Used u32

func astInit() {
	nodeCount = 1 // 0 = NKNone
	nodes[0] = Node{}
	listUsed = 0
	u64Used = 0
}

func newNode(kind u8, fileID u32, off u32) u32 {
	if nodeCount >= MaxNodes {
		return 0
	}
	id := nodeCount
	nodeCount++
	nodes[id] = Node{kind: kind, fileID: fileID, off: off}
	sigEffStart[id] = 0
	sigEffCount[id] = 0
	paramWhere[id] = 0
	return id
}

func pushList(items []u32) (u32, u32) {
	n := len(items)
	if n == 0 {
		return 0, 0
	}
	if usize(listUsed)+n > MaxListPool {
		return 0, 0
	}
	start := listUsed
	for i := usize(0); i < n; i++ {
		listPool[usize(start)+i] = items[i]
	}
	listUsed += u32(n)
	return start, u32(n)
}

func newU64(v u64) u32 {
	if u64Used >= MaxU64Pool {
		return 0
	}
	idx := u64Used
	u64Used++
	u64Pool[idx] = v
	return idx
}

// parseIntLit parses decimal, 0x, 0b, 0o integer literals with underscores.
func parseIntLit(b []byte) (u64, bool) {
	if len(b) == 0 {
		return 0, false
	}
	var base u64 = 10
	i := usize(0)
	if len(b) >= 2 && b[0] == '0' {
		if b[1] == 'x' || b[1] == 'X' {
			base = 16
			i = 2
		} else if b[1] == 'b' || b[1] == 'B' {
			base = 2
			i = 2
		} else if b[1] == 'o' || b[1] == 'O' {
			base = 8
			i = 2
		}
	}
	var v u64 = 0
	digits := usize(0)
	for ; i < len(b); i++ {
		c := b[i]
		if c == '_' {
			continue
		}
		var d u64
		if c >= '0' && c <= '9' {
			d = u64(c - '0')
		} else if c >= 'a' && c <= 'f' {
			d = u64(c-'a') + 10
		} else if c >= 'A' && c <= 'F' {
			d = u64(c-'A') + 10
		} else {
			return 0, false
		}
		if d >= base {
			return 0, false
		}
		v = v*base + d
		digits++
	}
	return v, digits > 0
}
