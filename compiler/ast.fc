	if k == NkFile {
		return "File"
	}
	if k == NkImportDecl {
		return "ImportDecl"
	}
	if k == NkImportSpec {
		return "ImportSpec"
	}
	if k == NkConstDecl {
		return "ConstDecl"
	}
	if k == NkConstSpec {
		return "ConstSpec"
	}
	if k == NkTypeDecl {
		return "TypeDecl"
	}
	if k == NkVarDecl {
		return "VarDecl"
	}
	if k == NkFuncDecl {
		return "FuncDecl"
	}
	if k == NkReceiver {
		return "Receiver"
	}
