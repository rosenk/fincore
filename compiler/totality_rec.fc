// totality_rec.fc — the totality checker, part 3 (port of finc0's
// totality/recursion.go): T3 for recursion over the SCCs of the call
// graph of total functions.
//
// Nodes are the total functions, methods and function literals with a
// body, in Info.Funcs order. Edges: static calls (CallFunc, CallMethod) to
// total functions, and for every non-driver call through a function value
// an edge to every escaping total function (every literal and every
// declared function referenced other than as a callee). The value edges
// are routed through one extra hub node (caller -> hub -> each escaping
// function); this keeps the edge list linear and does not change the SCCs
// of the real nodes (a path through the hub is exactly one value edge).
// A single node has a self edge if it calls itself statically, or if it
// calls a function value and escapes itself.
//
// The SCCs are computed with an iterative Tarjan (explicit frame stack);
// the partition does not depend on the visiting order, and diagnostics
// are sorted afterwards.
package main

import (
	"std/bytes"
	"std/sort"
)

const (
	MaxGraphEdges = MaxCalls + 2*MaxFuncs
)

var gidx [MaxFuncs]u32      // FuncInfo -> graph node + 1 (0 = not a node)
var gfi [MaxFuncs + 1]u32   // graph node -> FuncInfo
var ng usize                // real nodes; node ng is the hub
var gEsc [MaxFuncs + 1]bool // node escapes as a function value
var gVal [MaxFuncs + 1]bool // node calls a (non-driver) function value
var eStart [MaxFuncs + 2]u32
var eTo [MaxGraphEdges]u32
var neTo usize
var calleeMark [MaxNodes]bool

var tjIdx [MaxFuncs + 1]u32 // Tarjan index + 1 (0 = unvisited)
var tjLow [MaxFuncs + 1]u32
var tjOn [MaxFuncs + 1]bool
var tjStk [MaxFuncs + 1]u32
var ntjStk usize
var tjFrV [MaxFuncs + 1]u32
var tjFrE [MaxFuncs + 1]u32
var ntjFr usize
var tjNext u32
var tjComp [MaxFuncs + 1]u32 // SCC id + 1
var sccMem [MaxFuncs + 1]u32
var nsccMem usize
var sccS [MaxFuncs + 2]u32
var nscc usize

// the SCC being checked: real members in node order, by span, measures
var rcMem [MaxFuncs + 1]u32
var rcSorted [MaxFuncs + 1]u32
var nrc usize
var rcMeas [MaxFuncs + 1]u32
var rcComp u32
var rcCode u32
var rcHasEsc bool
var rcD u32
var rcMine [MaxNodes]bool

func pushEdge(to u32) {
	if neTo >= MaxGraphEdges {
		setFull("call graph")
		return
	}
	eTo[neTo] = to
	neTo++
}

func buildGraph() {
	ng = 0
	n := usize(funcs.orderN)
	for i := usize(0); i < n; i++ {
		fi := uat(funcs.orderS, i)
		if funcs.items[usize(fi)].effect == EffTotal && funcs.items[usize(fi)].body != 0 {
			gidx[usize(fi)] = u32(ng) + 1
			gfi[ng] = fi
			ng++
		}
	}
	escapedFuncs()
	neTo = 0
	nn := ng
	for v := usize(0); v < nn; v++ {
		eStart[v] = u32(neTo)
		gVal[v] = false
		c := funcs.items[usize(gfi[v])].callH
		for g := usize(0); g < MaxCells; g++ {
			if c == 0 {
				break
			}
			call := cellVal(c)
			c = cellNext(c)
			ci := ncall[usize(call)]
			if ci == 0 {
				continue
			}
			k := callTab.items[usize(ci)].kind
			if k == CallFunc || k == CallMethod {
				j := gidx[usize(funcOfSym(callTab.items[usize(ci)].callee))]
				if j != 0 {
					pushEdge(j - 1)
				}
			} else if k == CallValue {
				if callTab.items[usize(ci)].effect != EffDriver {
					gVal[v] = true
				}
			} else if k == CallBuiltin && callTab.items[usize(ci)].fmtOK {
				// formatTo (v0.2): an edge to the Format method of every
				// %v argument that resolves to one
				nfa := usize(callTab.items[usize(ci)].fmtN) / 2
				for a := usize(0); a < nfa; a++ {
					if fmtArgOp(ci, a) != FmtFormat {
						continue
					}
					j := gidx[usize(funcOfSym(meths.items[usize(fmtArgMethod(ci, a))].sym))]
					if j != 0 {
						pushEdge(j - 1)
					}
				}
			}
		}
		if gVal[v] {
			pushEdge(u32(ng))
		}
	}
	eStart[ng] = u32(neTo)
	for j := usize(0); j < nn; j++ {
		if gEsc[j] {
			pushEdge(u32(j))
		}
	}
	eStart[ng+1] = u32(neTo)
}

// escapedFuncs marks the graph nodes that may be called through a
// function value.
func escapedFuncs() {
	n := ntord
	for p := usize(0); p < n; p++ {
		x := tord[p]
		k := nkind(x)
		if k == NkCallExpr {
			fun := unparen(na(x))
			if fun != 0 && nkind(fun) == NkIndexExpr {
				fun = unparen(na(fun))
			}
			if fun != 0 && nkind(fun) == NkIdent {
				calleeMark[usize(fun)] = true
			} else if fun != 0 && nkind(fun) == NkSelectorExpr {
				calleeMark[usize(nb(fun))] = true
			}
		} else if k == NkFuncDecl {
			calleeMark[usize(nb(x))] = true
		}
	}
	for p := usize(0); p < n; p++ {
		x := tord[p]
		k := nkind(x)
		if k == NkIdent {
			if calleeMark[usize(x)] {
				continue
			}
			s := symbolOf(x)
			if s != 0 && symKind(s) == SymFunc {
				j := gidx[usize(funcOfSym(s))]
				if j != 0 {
					gEsc[usize(j-1)] = true
				}
			}
		} else if k == NkFuncLit {
			j := gidx[usize(nfunc[usize(x)])]
			if j != 0 {
				gEsc[usize(j-1)] = true
			}
		}
	}
}

func tjVisit(v u32) {
	tjNext++
	tjIdx[usize(v)] = tjNext
	tjLow[usize(v)] = tjNext
	tjStk[ntjStk] = v
	ntjStk++
	tjOn[usize(v)] = true
	tjFrV[ntjFr] = v
	tjFrE[ntjFr] = eStart[usize(v)]
	ntjFr++
}

// tarjan computes the SCCs of the graph (hub included) iteratively.
func tarjan() {
	nn := ng + 1
	tjNext = 0
	ntjStk = 0
	ntjFr = 0
	nscc = 0
	nsccMem = 0
	sccS[0] = 0
	lim := neTo + 2*nn + 2
	for r := usize(0); r < nn; r++ {
		if tjIdx[r] != 0 {
			continue
		}
		tjVisit(u32(r))
		for g := usize(0); g < lim; g++ {
			if ntjFr == 0 {
				break
			}
			top := ntjFr - 1
			u := tjFrV[top]
			ep := tjFrE[top]
			if ep < eStart[usize(u)+1] {
				tjFrE[top] = ep + 1
				w := eTo[usize(ep)]
				if tjIdx[usize(w)] == 0 {
					tjVisit(w)
				} else if tjOn[usize(w)] && tjIdx[usize(w)] < tjLow[usize(u)] {
					tjLow[usize(u)] = tjIdx[usize(w)]
				}
				continue
			}
			ntjFr--
			if tjLow[usize(u)] == tjIdx[usize(u)] {
				sn := ntjStk
				for h := usize(0); h < sn; h++ {
					ntjStk--
					w := tjStk[ntjStk]
					tjOn[usize(w)] = false
					tjComp[usize(w)] = u32(nscc) + 1
					sccMem[nsccMem] = w
					nsccMem++
					if w == u {
						break
					}
				}
				nscc++
				sccS[nscc] = u32(nsccMem)
			}
			if ntjFr > 0 {
				p := tjFrV[ntjFr-1]
				if tjLow[usize(u)] < tjLow[usize(p)] {
					tjLow[usize(p)] = tjLow[usize(u)]
				}
			}
		}
	}
}

func checkRecursion() {
	buildGraph()
	tarjan()
	hub := u32(ng)
	sn := nscc
	for c := usize(0); c < sn; c++ {
		// real members, sorted by node index
		nrc = 0
		s0 := usize(sccS[c])
		s1 := usize(sccS[c+1])
		for i := s0; i < s1; i++ {
			v := sccMem[i]
			if v != hub {
				rcMem[nrc] = v
				nrc++
			}
		}
		sort.SortU32(rcMem[:nrc])
		if nrc == 0 {
			continue
		}
		if nrc == 1 {
			v := rcMem[0]
			self := gVal[usize(v)] && gEsc[usize(v)]
			e0 := usize(eStart[usize(v)])
			e1 := usize(eStart[usize(v)+1])
			for e := e0; e < e1; e++ {
				if eTo[e] == v {
					self = true
				}
			}
			if !self {
				continue
			}
		}
		checkSCC(u32(c) + 1)
	}
}

// RecMembers renders the first n members of the sorted SCC (rcSorted),
// comma-separated; with missing set only those without a decreases clause.
type RecMembers struct {
	n       usize
	missing bool
}

func (r RecMembers) Format(dst []byte) usize {
	k := usize(0)
	sep := false
	n := r.n
	for i := usize(0); i < n; i++ {
		fi := gfi[usize(rcSorted[i])]
		if r.missing && funcs.items[usize(fi)].measure != 0 {
			continue
		}
		if sep {
			k += formatTo(dst[k:], ", ")
		}
		sep = true
		k += formatTo(dst[k:], "%v", FuncName(fi))
	}
	return k
}

// MeasureWhy renders why a decreases measure is invalid (measureParam);
// sym is the measure parameter.
type MeasureWhy struct {
	why u32
	sym u32
}

func (w MeasureWhy) Format(dst []byte) usize {
	if w.why == 1 {
		return formatTo(dst, "the measure must be a parameter of the function")
	} else if w.why == 2 {
		return formatTo(dst, "the measure parameter must be unsigned")
	} else if w.why == 3 {
		return formatTo(dst, "the measure parameter must not be variadic")
	} else if w.why == 4 {
		return formatTo(dst, "the measure parameter %v must not be addressed or written by a function literal", NameRef(symName(w.sym)))
	}
	return formatTo(dst, "the measure parameter %v must not be assigned", NameRef(symName(w.sym)))
}

// spanBefore orders FuncInfo nodes by (file path, position).
func spanBefore(a u32, b u32) bool {
	na0 := fiNode(gfi[usize(a)])
	nb0 := fiNode(gfi[usize(b)])
	fa := nfile(na0)
	fb := nfile(nb0)
	if fa != fb {
		c := bytes.Compare(strBytes(sources.files[fa].path), strBytes(sources.files[fb].path))
		if c != 0 {
			return c < 0
		}
	}
	la := nodes.items[usize(na0)].sLine
	lb := nodes.items[usize(nb0)].sLine
	if la != lb {
		return la < lb
	}
	return nodes.items[usize(na0)].sCol < nodes.items[usize(nb0)].sCol
}

func checkSCC(comp u32) {
	code := u32(E4004)
	if nrc == 1 {
		code = E4002
	}
	n := nrc
	copy(rcSorted[:n], rcMem[:n])
	sort.Stable[u32](rcSorted[:n], spanBefore)
	// every member needs a decreases clause
	missing := false
	for i := usize(0); i < n; i++ {
		if funcs.items[usize(gfi[usize(rcSorted[i])])].measure == 0 {
			missing = true
		}
	}
	first := gfi[usize(rcSorted[0])]
	if missing {
		if n == 1 {
			errAt(code, fiNode(first), formatTo(mbuf[:], "recursive function %v has no decreases clause", FuncName(first)))
		} else {
			errAt(code, fiNode(first), formatTo(mbuf[:], "mutually recursive functions {%v} need a decreases clause each (missing in %v)", RecMembers{n: n, missing: false}, RecMembers{n: n, missing: true}))
		}
		return
	}
	// measures: an unsigned parameter that the function never writes
	for i := usize(0); i < n; i++ {
		v := rcMem[i]
		fi := gfi[usize(v)]
		idx, why, ws := measureParam(fi)
		if why != 0 {
			errAt(code, funcs.items[usize(fi)].measure, formatTo(mbuf[:], "decreases measure of recursive function %v: %v", FuncName(fi), MeasureWhy{why: why, sym: ws}))
			return
		}
		rcMeas[usize(v)] = u32(idx)
	}
	rcHasEsc = false
	for i := usize(0); i < n; i++ {
		if gEsc[usize(rcMem[i])] {
			rcHasEsc = true
		}
	}
	rcComp = comp
	rcCode = code
	// every call inside the SCC passes a strictly smaller measure
	for i := usize(0); i < n; i++ {
		v := rcMem[i]
		fi := gfi[usize(v)]
		f := funcs.items[usize(fi)]
		rcD = defs[usize(uat(f.parS, usize(rcMeas[usize(v)])))]
		markCalls(f.callH, true)
		totReset()
		wMode = WalkMode.Rec
		wTrack = false
		twDepth = 0
		_ = twStmt(f.body, newState(), SemaDepth)
		markCalls(f.callH, false)
	}
}

func markCalls(h u32, on bool) {
	c := h
	for g := usize(0); g < MaxCells; g++ {
		if c == 0 {
			break
		}
		rcMine[usize(cellVal(c))] = on
		c = cellNext(c)
	}
}

// measureParam checks that the decreases measure of fi is one of its
// (non-receiver) unsigned parameters, never assigned in fi. It returns the
// parameter index, or a reason (1..5) and the parameter symbol.
func measureParam(fi u32) (usize, u32, u32) {
	f := funcs.items[usize(fi)]
	s := varOf(stripConv(f.measure))
	idx := usize(0)
	found := false
	if s != 0 {
		pn := usize(f.parN)
		for i := usize(0); i < pn; i++ {
			if defs[usize(uat(f.parS, i))] == s {
				idx = i
				found = true
				break
			}
		}
	}
	if !found {
		return 0, 1, 0
	}
	if !isUnsigned(symTyp(s)) {
		return 0, 2, s
	}
	if f.sig != 0 && sigVariadic(f.sig) && idx == usize(f.parN)-1 {
		return 0, 3, s
	}
	if unstable(s) {
		return 0, 4, s
	}
	if writesRoot(s, f.body) {
		return 0, 5, s
	}
	return idx, 0, s
}

// recOnCall is the recursion walker's onCall.
func recOnCall(call u32, st u32) {
	if !rcMine[usize(call)] {
		return
	}
	ci := ncall[usize(call)]
	if ci == 0 {
		return
	}
	k := callTab.items[usize(ci)].kind
	if k == CallValue {
		if callTab.items[usize(ci)].effect == EffDriver || !rcHasEsc {
			return
		}
		errAt(rcCode, call, formatTo(mbuf[:], "call through a function value inside a recursive group cannot be proven to decrease a measure"))
		return
	}
	if k == CallBuiltin && callTab.items[usize(ci)].fmtOK {
		nfa := usize(callTab.items[usize(ci)].fmtN) / 2
		for a := usize(0); a < nfa; a++ {
			if fmtArgOp(ci, a) != FmtFormat {
				continue
			}
			j := gidx[usize(funcOfSym(meths.items[usize(fmtArgMethod(ci, a))].sym))]
			if j != 0 && tjComp[usize(j-1)] == rcComp {
				errAt(rcCode, call, formatTo(mbuf[:], "formatTo call of %v inside a recursive group cannot be proven to decrease a measure", FuncName(gfi[usize(j-1)])))
				return
			}
		}
		return
	}
	if k != CallFunc && k != CallMethod {
		return
	}
	j := gidx[usize(funcOfSym(callTab.items[usize(ci)].callee))]
	if j == 0 || tjComp[usize(j-1)] != rcComp {
		return
	}
	callee := gfi[usize(j-1)]
	jm := usize(rcMeas[usize(j-1)])
	if jm >= l1len(call) {
		errAt(rcCode, call, formatTo(mbuf[:], "cannot find the measure argument of the call to %v", FuncName(callee)))
		return
	}
	if !smaller(l1at(call, jm), rcD, st) {
		errAt(rcCode, call, formatTo(mbuf[:], "recursive call to %v must pass a measure strictly smaller than %v (e.g. %v - 1 after `if %v == 0 { return ... }`)", FuncName(callee), NameRef(symName(rcD)), NameRef(symName(rcD)), NameRef(symName(rcD))))
	}
}

// smaller reports whether arg < d is proven: d - c with d >= c (c >= 1),
// d / c (c >= 2) or d >> c (c >= 1) with d >= 1.
func smaller(arg u32, d u32, st u32) bool {
	b := stripConv(arg)
	if b == 0 || nkind(b) != NkBinaryExpr || varOf(stripConv(na(b))) != d {
		return false
	}
	k, ok := constUint(nb(b))
	if !ok {
		return false
	}
	lb := lbGet(st, d)
	op := nop(b)
	if op == OpSub {
		return k >= 1 && lb >= k
	}
	if op == OpDiv {
		return k >= 2 && lb >= 1
	}
	if op == OpShr {
		return k >= 1 && lb >= 1
	}
	return false
}
