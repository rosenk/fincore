// check_stmt.fc — the type checker, part 3: statements, patterns and
// terminating-statement analysis (port of finc0's types/stmt.go).
package main

// Marks a blank `_` left-hand side in assignStmt's operand list.
const KBlankLHS = 255

// stmtList checks the statements of a BlockStmt.
func stmtList(bl u32, dp usize) decreases(dp) {
	if dp == 0 {
		tooDeep()
		return
	}
	if bl == 0 {
		return
	}
	n := l1len(bl)
	for i := usize(0); i < n; i++ {
		s := l1at(bl, i)
		stmt(s, dp-1)
		if nkind(s) == NkIfStmt && nd(s) == 0 && !terminatingList(nc(s), true, dp-1) {
			// v0.2 let-else: the resolver declared the false-outcome
			// bindings after the if; they are bound there only if the
			// then block cannot complete normally.
			markUnbound(nb(s), false, dp-1)
		}
	}
}

// chkUnbound marks the let-else bindings (v0.2) of if statements whose
// then block can complete normally; using one is E2002.
var chkUnbound [MaxSyms]bool

// markUnbound marks the variables bound by the `is` tests of e that are
// definitely matched when e evaluates to want (finc0's Checker.outcome:
// `!` swaps the outcomes, `A && B` has the true bindings of both
// operands, `A || B` the false bindings of both, parentheses are
// transparent and every other expression has none).
func markUnbound(e u32, want bool, dp usize) decreases(dp) {
	if dp == 0 || e == 0 {
		return
	}
	k := nkind(e)
	if k == NkParenExpr {
		markUnbound(na(e), want, dp-1)
	} else if k == NkUnaryExpr && nop(e) == OpNot {
		markUnbound(na(e), !want, dp-1)
	} else if k == NkIsExpr {
		if want {
			markPatUnbound(nb(e), dp-1)
		}
	} else if k == NkBinaryExpr && (nop(e) == OpLAnd && want || nop(e) == OpLOr && !want) {
		markUnbound(na(e), want, dp-1)
		markUnbound(nb(e), want, dp-1)
	}
}

func markPatUnbound(p u32, dp usize) decreases(dp) {
	if dp == 0 || p == 0 {
		return
	}
	k := nkind(p)
	if k == NkIdent {
		if sym := defs[usize(p)]; sym != 0 {
			chkUnbound[usize(sym)] = true
		}
	} else if k == NkAtPattern {
		markPatUnbound(na(p), dp-1)
		markPatUnbound(nb(p), dp-1)
	} else if k is NkCtorPattern | NkOrPattern | NkTuplePattern {
		n := l1len(p)
		for i := usize(0); i < n; i++ {
			markPatUnbound(l1at(p, i), dp-1)
		}
	}
}

func stmt(s u32, dp usize) decreases(dp) {
	if dp == 0 {
		tooDeep()
		return
	}
	if s == 0 {
		return
	}
	k := nkind(s)
	if k == NkBlockStmt {
		stmtList(s, dp-1)
	} else if k == NkDeclStmt {
		declStmt(na(s), dp-1)
	} else if k == NkShortVarDecl {
		shortVarDecl(s, dp-1)
	} else if k == NkAssignStmt {
		assignStmt(s, dp-1)
	} else if k == NkIncDecStmt {
		x := exprValue(na(s), dp-1)
		if isInvalidOp(&x) {
			return
		}
		if x.mode != KVar {
			errAt(E2002, na(s), formatTo(mbuf[:], "cannot assign to %v", Expr(na(s))))
		} else if !isInteger(x.typ) {
			errAt(E2002, na(s), formatTo(mbuf[:], "invalid operation: %v (non-integer type %v)", Expr(na(s)), TypeRef(x.typ)))
		}
	} else if k == NkExprStmt {
		exprStmt(na(s), "statement", dp-1)
	} else if k == NkDeferStmt {
		exprStmt(na(s), "defer", dp-1)
	} else if k == NkReturnStmt {
		returnStmt(s, dp-1)
	} else if k == NkIfStmt {
		stmt(na(s), dp-1)
		condition(nb(s), "if", dp-1)
		stmtList(nc(s), dp-1)
		stmt(nd(s), dp-1)
	} else if k == NkForStmt {
		stmt(na(s), dp-1)
		if nb(s) != 0 {
			condition(nb(s), "for", dp-1)
		}
		stmt(nc(s), dp-1)
		if nd(s) != 0 {
			measure(na(nd(s)), dp-1)
		}
		chkLoops++
		stmtList(ne(s), dp-1)
		chkLoops--
	} else if k == NkMatchStmt {
		matchStmt(s, dp-1)
	} else if k == NkScopeStmt {
		v := nb(s)
		x := exprValue(v, dp-1)
		st := univNamed[BTScope]
		if !isInvalidOp(&x) && x.typ != st {
			errAt(E2002, v, formatTo(mbuf[:], "scope value %v must have type Scope (have %v)", Expr(v), TypeRef(x.typ)))
		}
		setSymType(defs[usize(na(s))], st)
		stmtList(nc(s), dp-1)
	} else if k == NkBreakStmt {
		if chkLoops == 0 {
			errAt(E2002, s, formatTo(mbuf[:], "break is not in a loop"))
		}
	} else if k == NkContinueStmt {
		if chkLoops == 0 {
			errAt(E2002, s, formatTo(mbuf[:], "continue is not in a loop"))
		}
	}
}

func declStmt(d u32, dp usize) decreases(dp) {
	if dp == 0 {
		tooDeep()
		return
	}
	if nkind(d) == NkConstDecl {
		n := l1len(d)
		for i := usize(0); i < n; i++ {
			sp := l1at(d, i)
			sym := defs[usize(na(sp))]
			if sym != 0 {
				syms.items[usize(sym)].objState = 1
				constSpec(sym, sp, dp-1)
				syms.items[usize(sym)].objState = 2
			} else {
				chkConstCtx++
				_ = exprValue(nc(sp), dp-1)
				chkConstCtx--
			}
		}
	} else if nkind(d) == NkVarDecl {
		sym := defs[usize(na(d))]
		if sym != 0 {
			syms.items[usize(sym)].objState = 1
		}
		varDecl(sym, d, na(d), dp-1)
		if sym != 0 {
			syms.items[usize(sym)].objState = 2
		}
	}
}

func condition(e u32, what string, dp usize) decreases(dp) {
	if dp == 0 {
		tooDeep()
		return
	}
	x := exprValue(e, dp-1)
	if isInvalidOp(&x) {
		return
	}
	if !isBoolean(x.typ) {
		errAt(E2002, e, formatTo(mbuf[:], "non-boolean condition in %s statement (type %v)", what, TypeRef(x.typ)))
		return
	}
	if isUntyped(x.typ) {
		_ = convertUntyped(&x, TyBool)
	}
}

// exprStmt checks an expression statement, defer operand or match-arm
// expression: it must be a call of a function, method, function value or
// panic/copy.
func exprStmt(e u32, what string, dp usize) decreases(dp) {
	if dp == 0 {
		tooDeep()
		return
	}
	call := unparen(e)
	if nkind(call) != NkCallExpr {
		x := rawExpr(e, dp-1)
		if !isInvalidOp(&x) {
			errAt(E2002, e, formatTo(mbuf[:], "%v is not used (%s requires a function call)", Expr(e), what))
		}
		return
	}
	x := rawExpr(e, dp-1)
	if isInvalidOp(&x) {
		return
	}
	bad := match callKind(call) {
		Builtin(BFPanic | BFCopy | BFFormatTo, ..) -> false
		Conversion(_) | Variant(..) | Builtin(..) -> true
		Invalid | Func(..) | Method(..) | BuiltinMeth(..) | Value -> false
	}
	if bad {
		errAt(E2002, e, formatTo(mbuf[:], "%v is not used", Expr(e)))
	}
}

// rhsValues pushes the operands of an assignment's right-hand side (list
// l2 of s) onto opStack, expanding a single multi-valued call.
func rhsValues(s u32, nl usize, dp usize) bool decreases(dp) {
	if dp == 0 {
		tooDeep()
		return false
	}
	nr := l2len(s)
	if nr == 0 {
		return false
	}
	r0 := l2at(s, 0)
	if nr == 1 && nl > 1 {
		x := rawExpr(r0, dp-1)
		if isInvalidOp(&x) {
			return false
		}
		if !(trec(x.typ) is Tuple(ts, tn)) || x.mode != KValue {
			singleValue(&x)
			if isInvalidOp(&x) {
				return false
			}
			errAt(E2003, r0, formatTo(mbuf[:], "assignment mismatch: %d variables but %v returns 1 value", nl, Expr(r0)))
			return false
		}
		nt := usize(tn)
		if nt != nl {
			errAt(E2003, r0, formatTo(mbuf[:], "assignment mismatch: %d variables but %v returns %d values", nl, Expr(r0), nt))
			return false
		}
		tv := u32(0)
		if slotGet(nval[usize(r0)]) is Tuple(ref, _) {
			tv = ref
		}
		for i := usize(0); i < nt; i++ {
			op := opMode(KValue, tlist(ts, i))
			op.expr = r0
			if tv != 0 {
				op.mode = KConst
				op.val = slotGet(tv + u32(i))
			}
			opPush(op)
		}
		return true
	}
	mark := opStack.top
	ok := true
	for i := usize(0); i < nr; i++ {
		x := exprValue(l2at(s, i), dp-1)
		if isInvalidOp(&x) {
			ok = false
		}
		opPush(x)
	}
	if nr != nl {
		errAt(E2003, r0, formatTo(mbuf[:], "assignment mismatch: %d variables but %d values", nl, nr))
		opStack.top = mark
		return false
	}
	return ok
}

func shortVarDecl(s u32, dp usize) decreases(dp) {
	if dp == 0 {
		tooDeep()
		return
	}
	nn := l1len(s)
	mark := opStack.top
	ok := rhsValues(s, nn, dp-1)
	cnt := opStack.top - mark
	for i := usize(0); i < nn; i++ {
		id := l1at(s, i)
		has := ok && i < cnt
		xi := mark + i
		def := defs[usize(id)]
		if def != 0 {
			t := u32(TyInvalid)
			if has && opStack.items[xi].mode != KNone {
				t = defaultTypeOp(&opStack.items[xi], Ctx.Assign)
			}
			setSymType(def, t)
			continue
		}
		use := uses[usize(id)]
		if use != 0 {
			if symKind(use) != SymVar {
				errAt(E2002, id, formatTo(mbuf[:], "cannot assign to %v (not a variable)", NameRef(idName(id))))
				continue
			}
			t := symType(use, dp-1)
			ntype[usize(id)] = t
			nmode[usize(id)] = KVar
			if has && opStack.items[xi].mode != KNone {
				assignValue(&opStack.items[xi], t)
			}
			continue
		}
		if has && opStack.items[xi].mode != KNone && isUntyped(opStack.items[xi].typ) {
			_ = defaultTypeOp(&opStack.items[xi], Ctx.Assign)
		}
	}
	opStack.top = mark
}

// assignValue assigns x to a variable of type t; for expanded tuple
// operands only assignability is checked.
func assignValue(x *Operand, t u32) {
	e := x.expr
	if nkind(e) == NkCallExpr {
		rt := ntype[usize(e)]
		if isTupleT(rt) {
			if !assignable(x.typ, t) && !isInvalid(t) {
				errAt(E2002, e, formatTo(mbuf[:], "cannot assign value of type %v to variable of type %v", TypeRef(x.typ), TypeRef(t)))
			}
			return
		}
	}
	_ = assignment(x, t, Ctx.Assign)
}

func assignStmt(s u32, dp usize) decreases(dp) {
	if dp == 0 {
		tooDeep()
		return
	}
	nl := l1len(s)
	nr := l2len(s)
	op := nop(s)
	if op != AsgAssign {
		if nl != 1 || nr != 1 {
			errAt(E2003, s, formatTo(mbuf[:], "compound assignment %s requires exactly one operand on each side", assignOpString(op)))
			return
		}
		l0 := l1at(s, 0)
		l := exprValue(l0, dp-1)
		r := exprValue(l2at(s, 0), dp-1)
		if isInvalidOp(&l) || isInvalidOp(&r) {
			return
		}
		if l.mode != KVar {
			errAt(E2002, l0, formatTo(mbuf[:], "cannot assign to %v", Expr(l0)))
			return
		}
		if !isInteger(l.typ) {
			errAt(E2002, s, formatTo(mbuf[:], "operator %s not defined on %v (type %v)", assignOpString(op), Expr(l0), TypeRef(l.typ)))
			return
		}
		_ = assignment(&r, l.typ, Ctx.Assign)
		return
	}
	lmark := opStack.top
	for i := usize(0); i < nl; i++ {
		l := l1at(s, i)
		if nkind(l) == NkIdent && isBlank(l) {
			x := invalidOp(l)
			x.mode = KBlankLHS
			opPush(x)
			continue
		}
		x := exprValue(l, dp-1)
		if !isInvalidOp(&x) && x.mode != KVar {
			errAt(E2002, l, formatTo(mbuf[:], "cannot assign to %v", Expr(l)))
			x.mode = KNone
		}
		opPush(x)
	}
	rmark := opStack.top
	ok := rhsValues(s, nl, dp-1)
	if !ok {
		opStack.top = lmark
		return
	}
	for i := usize(0); i < nl; i++ {
		xi := rmark + i
		if opStack.items[xi].mode == KNone {
			continue
		}
		lm := opStack.items[lmark+i].mode
		if lm == KBlankLHS {
			if isUntyped(opStack.items[xi].typ) {
				_ = defaultTypeOp(&opStack.items[xi], Ctx.Assign)
			}
			continue
		}
		if lm == KNone {
			continue
		}
		assignValue(&opStack.items[xi], opStack.items[lmark+i].typ)
	}
	opStack.top = lmark
}

func returnStmt(s u32, dp usize) decreases(dp) {
	if dp == 0 {
		tooDeep()
		return
	}
	if chkFn == 0 {
		return
	}
	sig := funcs.items[usize(chkFn)].sig
	want := sigNResults(sig)
	nr := l1len(s)
	if nr == 0 {
		if want > 0 {
			errAt(E2003, s, formatTo(mbuf[:], "not enough return values: have 0, want %d", want))
		}
		return
	}
	r0 := l1at(s, 0)
	if want == 0 {
		for i := usize(0); i < nr; i++ {
			_ = rawExpr(l1at(s, i), dp-1)
		}
		errAt(E2003, r0, formatTo(mbuf[:], "too many return values: have %d, want 0", nr))
		return
	}
	if nr == 1 && want > 1 {
		x := rawExpr(r0, dp-1)
		if isInvalidOp(&x) {
			return
		}
		if !(trec(x.typ) is Tuple(ts, tn)) {
			singleValue(&x)
			if !isInvalidOp(&x) {
				errAt(E2003, r0, formatTo(mbuf[:], "not enough return values: have 1, want %d", want))
			}
			return
		}
		nt := usize(tn)
		if nt != want {
			errAt(E2003, r0, formatTo(mbuf[:], "wrong number of return values: have %d, want %d", nt, want))
			return
		}
		for i := usize(0); i < nt; i++ {
			t := tlist(ts, i)
			w := sigResult(sig, i)
			if !assignable(t, w) && !isInvalid(w) {
				errAt(E2002, r0, formatTo(mbuf[:], "cannot use result %d of type %v as type %v in return statement", i + 1, TypeRef(t), TypeRef(w)))
			}
		}
		return
	}
	if nr != want {
		for i := usize(0); i < nr; i++ {
			_ = rawExpr(l1at(s, i), dp-1)
		}
		errAt(E2003, r0, formatTo(mbuf[:], "%s return values: have %d, want %d", tooMany(nr > want), nr, want))
		return
	}
	for i := usize(0); i < nr; i++ {
		_ = exprWith(l1at(s, i), sigResult(sig, i), Ctx.Return, dp-1)
	}
}

// ---------------------------------------------------------------------------
// Terminating statements (Go spec rules, adapted)

func isTerminatingList(bl u32, dp usize) bool {
	return terminatingList(bl, false, dp)
}

// terminatingList and terminating implement the terminating statements;
// with jumps, break and continue terminate too (v0.2: the then block of
// a let-else must not complete normally).
func terminatingList(bl u32, jumps bool, dp usize) bool decreases(dp) {
	if dp == 0 || bl == 0 {
		return false
	}
	n := l1len(bl)
	return n > 0 && terminating(l1at(bl, n-1), jumps, dp-1)
}

func terminating(s u32, jumps bool, dp usize) bool decreases(dp) {
	if dp == 0 || s == 0 {
		return false
	}
	k := nkind(s)
	match k {
		NkBreakStmt | NkContinueStmt -> return jumps
		NkReturnStmt -> return true
		NkExprStmt -> return isPanicCall(na(s))
		NkBlockStmt -> return terminatingList(s, jumps, dp-1)
		NkIfStmt -> return nd(s) != 0 && terminatingList(nc(s), jumps, dp-1) && terminating(nd(s), jumps, dp-1)
		NkForStmt -> return nb(s) == 0 && !hasBreak(ne(s), dp-1)
		NkScopeStmt -> return terminatingList(nc(s), jumps, dp-1)
		NkMatchStmt -> {
			// v0.2: a match is a terminating statement if it is exhaustive
			// (nexh) and all its arms terminate.
			n := l1len(s)
			for i := usize(0); i < n; i++ {
				arm := l1at(s, i)
				if nb(arm) != 0 && !isPanicCall(nb(arm)) {
					return false
				}
				if nc(arm) != 0 && !terminatingList(nc(arm), jumps, dp-1) {
					return false
				}
			}
			return n > 0 && nexh[usize(s)]
		}
		_ -> return false
	}
}

func isPanicCall(e u32) bool {
	call := unparen(e)
	if nkind(call) != NkCallExpr {
		return false
	}
	return callKind(call) is Builtin(BFPanic, ..)
}

// hasBreak reports whether a block contains a break that targets the
// enclosing loop.
func hasBreak(bl u32, dp usize) bool decreases(dp) {
	if dp == 0 || bl == 0 {
		return false
	}
	n := l1len(bl)
	for i := usize(0); i < n; i++ {
		if stmtHasBreak(l1at(bl, i), dp-1) {
			return true
		}
	}
	return false
}

func stmtHasBreak(s u32, dp usize) bool decreases(dp) {
	if dp == 0 || s == 0 {
		return false
	}
	k := nkind(s)
	match k {
		NkBreakStmt -> return true
		NkBlockStmt -> return hasBreak(s, dp-1)
		NkIfStmt -> return hasBreak(nc(s), dp-1) || (nd(s) != 0 && stmtHasBreak(nd(s), dp-1))
		NkMatchStmt -> {
			n := l1len(s)
			for i := usize(0); i < n; i++ {
				arm := l1at(s, i)
				if nc(arm) != 0 && hasBreak(nc(arm), dp-1) {
					return true
				}
			}
			return false
		}
		NkScopeStmt -> return hasBreak(nc(s), dp-1)
		_ -> return false
	}
}
