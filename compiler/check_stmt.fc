// check_stmt.fc — the type checker, part 3: statements, patterns and
// terminating-statement analysis (port of finc0's types/stmt.go).
package main

// Marks a blank `_` left-hand side in assignStmt's operand list.
const KBlankLHS = 255

// stmtList checks the statements of a BlockStmt.
func stmtList(bl u32, dp usize) decreases(dp) {
	if dp == 0 {
		tooDeep()
		return
	}
	if bl == 0 {
		return
	}
	n := l1len(bl)
	for i := usize(0); i < n; i++ {
		stmt(l1at(bl, i), dp-1)
	}
}

func stmt(s u32, dp usize) decreases(dp) {
	if dp == 0 {
		tooDeep()
		return
	}
	if s == 0 {
		return
	}
	k := nkind(s)
	if k == NkBlockStmt {
		stmtList(s, dp-1)
	} else if k == NkDeclStmt {
		declStmt(na(s), dp-1)
	} else if k == NkShortVarDecl {
		shortVarDecl(s, dp-1)
	} else if k == NkAssignStmt {
		assignStmt(s, dp-1)
	} else if k == NkIncDecStmt {
		x := exprValue(na(s), dp-1)
		if isInvalidOp(&x) {
			return
		}
		if x.mode != KVar {
			mreset()
			ms("cannot assign to ")
			mexpr(na(s))
			errAt(E2002, na(s))
		} else if !isInteger(x.typ) {
			mreset()
			ms("invalid operation: ")
			mexpr(na(s))
			ms(" (non-integer type ")
			mtype(x.typ)
			ms(")")
			errAt(E2002, na(s))
		}
	} else if k == NkExprStmt {
		exprStmt(na(s), "statement", dp-1)
	} else if k == NkDeferStmt {
		exprStmt(na(s), "defer", dp-1)
	} else if k == NkReturnStmt {
		returnStmt(s, dp-1)
	} else if k == NkIfStmt {
		stmt(na(s), dp-1)
		condition(nb(s), "if", dp-1)
		stmtList(nc(s), dp-1)
		stmt(nd(s), dp-1)
	} else if k == NkForStmt {
		stmt(na(s), dp-1)
		if nb(s) != 0 {
			condition(nb(s), "for", dp-1)
		}
		stmt(nc(s), dp-1)
		if nd(s) != 0 {
			measure(na(nd(s)), dp-1)
		}
		chkLoops++
		stmtList(ne(s), dp-1)
		chkLoops--
	} else if k == NkMatchStmt {
		matchStmt(s, dp-1)
	} else if k == NkScopeStmt {
		v := nb(s)
		x := exprValue(v, dp-1)
		st := univNamed[BTScope]
		if !isInvalidOp(&x) && x.typ != st {
			mreset()
			ms("scope value ")
			mexpr(v)
			ms(" must have type Scope (have ")
			mtype(x.typ)
			ms(")")
			errAt(E2002, v)
		}
		setSymType(defs[usize(na(s))], st)
		stmtList(nc(s), dp-1)
	} else if k == NkBreakStmt {
		if chkLoops == 0 {
			mreset()
			ms("break is not in a loop")
			errAt(E2002, s)
		}
	} else if k == NkContinueStmt {
		if chkLoops == 0 {
			mreset()
			ms("continue is not in a loop")
			errAt(E2002, s)
		}
	}
}

func declStmt(d u32, dp usize) decreases(dp) {
	if dp == 0 {
		tooDeep()
		return
	}
	if nkind(d) == NkConstDecl {
		n := l1len(d)
		for i := usize(0); i < n; i++ {
			sp := l1at(d, i)
			sym := defs[usize(na(sp))]
			if sym != 0 {
				syms.items[usize(sym)].objState = 1
				constSpec(sym, sp, dp-1)
				syms.items[usize(sym)].objState = 2
			} else {
				chkConstCtx++
				_ = exprValue(nc(sp), dp-1)
				chkConstCtx--
			}
		}
	} else if nkind(d) == NkVarDecl {
		sym := defs[usize(na(d))]
		if sym != 0 {
			syms.items[usize(sym)].objState = 1
		}
		varDecl(sym, d, na(d), dp-1)
		if sym != 0 {
			syms.items[usize(sym)].objState = 2
		}
	}
}

func condition(e u32, what string, dp usize) decreases(dp) {
	if dp == 0 {
		tooDeep()
		return
	}
	x := exprValue(e, dp-1)
	if isInvalidOp(&x) {
		return
	}
	if !isBoolean(x.typ) {
		mreset()
		ms("non-boolean condition in ")
		ms(what)
		ms(" statement (type ")
		mtype(x.typ)
		ms(")")
		errAt(E2002, e)
		return
	}
	if isUntyped(x.typ) {
		_ = convertUntyped(&x, TyBool)
	}
}

// exprStmt checks an expression statement, defer operand or match-arm
// expression: it must be a call of a function, method, function value or
// panic/copy.
func exprStmt(e u32, what string, dp usize) decreases(dp) {
	if dp == 0 {
		tooDeep()
		return
	}
	call := unparen(e)
	if nkind(call) != NkCallExpr {
		x := rawExpr(e, dp-1)
		if !isInvalidOp(&x) {
			mreset()
			mexpr(e)
			ms(" is not used (")
			ms(what)
			ms(" requires a function call)")
			errAt(E2002, e)
		}
		return
	}
	x := rawExpr(e, dp-1)
	if isInvalidOp(&x) {
		return
	}
	ci := ncall[usize(call)]
	k := callTab.items[usize(ci)].kind
	bad := k == CallConversion || k == CallVariant
	if k == CallBuiltin {
		b := callTab.items[usize(ci)].builtin
		bad = b != BFPanic && b != BFCopy
	}
	if bad {
		mreset()
		mexpr(e)
		ms(" is not used")
		errAt(E2002, e)
	}
}

// rhsValues pushes the operands of an assignment's right-hand side (list
// l2 of s) onto opStack, expanding a single multi-valued call.
func rhsValues(s u32, nl usize, dp usize) bool decreases(dp) {
	if dp == 0 {
		tooDeep()
		return false
	}
	nr := l2len(s)
	if nr == 0 {
		return false
	}
	r0 := l2at(s, 0)
	if nr == 1 && nl > 1 {
		x := rawExpr(r0, dp-1)
		if isInvalidOp(&x) {
			return false
		}
		if x.typ == 0 || tk(x.typ) != TCTuple || x.mode != KValue {
			singleValue(&x)
			if isInvalidOp(&x) {
				return false
			}
			mreset()
			ms("assignment mismatch: ")
			mu(u64(nl))
			ms(" variables but ")
			mexpr(r0)
			ms(" returns 1 value")
			errAt(E2003, r0)
			return false
		}
		nt := tl1n(x.typ)
		if nt != nl {
			mreset()
			ms("assignment mismatch: ")
			mu(u64(nl))
			ms(" variables but ")
			mexpr(r0)
			ms(" returns ")
			mu(u64(nt))
			ms(" values")
			errAt(E2003, r0)
			return false
		}
		tv := u32(0)
		vs := nval[usize(r0)]
		if vs != 0 && slotGet(vs).kind == VTuple {
			tv = slotGet(vs).ref
		}
		for i := usize(0); i < nt; i++ {
			op := opMode(KValue, tl1(x.typ, i))
			op.expr = r0
			if tv != 0 {
				op.mode = KConst
				op.val = slotGet(tv + u32(i))
			}
			opPush(op)
		}
		return true
	}
	mark := opStack.top
	ok := true
	for i := usize(0); i < nr; i++ {
		x := exprValue(l2at(s, i), dp-1)
		if isInvalidOp(&x) {
			ok = false
		}
		opPush(x)
	}
	if nr != nl {
		mreset()
		ms("assignment mismatch: ")
		mu(u64(nl))
		ms(" variables but ")
		mu(u64(nr))
		ms(" values")
		errAt(E2003, r0)
		opStack.top = mark
		return false
	}
	return ok
}

func shortVarDecl(s u32, dp usize) decreases(dp) {
	if dp == 0 {
		tooDeep()
		return
	}
	nn := l1len(s)
	mark := opStack.top
	ok := rhsValues(s, nn, dp-1)
	cnt := opStack.top - mark
	for i := usize(0); i < nn; i++ {
		id := l1at(s, i)
		has := ok && i < cnt
		xi := mark + i
		def := defs[usize(id)]
		if def != 0 {
			t := u32(TyInvalid)
			if has && opStack.items[xi].mode != KNone {
				t = defaultTypeOp(&opStack.items[xi], mkCtx(CtxAssign))
			}
			setSymType(def, t)
			continue
		}
		use := uses[usize(id)]
		if use != 0 {
			if symKind(use) != SymVar {
				mreset()
				ms("cannot assign to ")
				mname(idName(id))
				ms(" (not a variable)")
				errAt(E2002, id)
				continue
			}
			t := symType(use, dp-1)
			ntype[usize(id)] = t
			nmode[usize(id)] = KVar
			if has && opStack.items[xi].mode != KNone {
				assignValue(&opStack.items[xi], t)
			}
			continue
		}
		if has && opStack.items[xi].mode != KNone && isUntyped(opStack.items[xi].typ) {
			_ = defaultTypeOp(&opStack.items[xi], mkCtx(CtxAssign))
		}
	}
	opStack.top = mark
}

// assignValue assigns x to a variable of type t; for expanded tuple
// operands only assignability is checked.
func assignValue(x *Operand, t u32) {
	e := x.expr
	if nkind(e) == NkCallExpr {
		rt := ntype[usize(e)]
		if rt != 0 && tk(rt) == TCTuple {
			if !assignable(x.typ, t) && !isInvalid(t) {
				mreset()
				ms("cannot assign value of type ")
				mtype(x.typ)
				ms(" to variable of type ")
				mtype(t)
				errAt(E2002, e)
			}
			return
		}
	}
	_ = assignment(x, t, mkCtx(CtxAssign))
}

func assignStmt(s u32, dp usize) decreases(dp) {
	if dp == 0 {
		tooDeep()
		return
	}
	nl := l1len(s)
	nr := l2len(s)
	op := nop(s)
	if op != AsgAssign {
		if nl != 1 || nr != 1 {
			mreset()
			ms("compound assignment ")
			ms(assignOpString(op))
			ms(" requires exactly one operand on each side")
			errAt(E2003, s)
			return
		}
		l0 := l1at(s, 0)
		l := exprValue(l0, dp-1)
		r := exprValue(l2at(s, 0), dp-1)
		if isInvalidOp(&l) || isInvalidOp(&r) {
			return
		}
		if l.mode != KVar {
			mreset()
			ms("cannot assign to ")
			mexpr(l0)
			errAt(E2002, l0)
			return
		}
		if !isInteger(l.typ) {
			mreset()
			ms("operator ")
			ms(assignOpString(op))
			ms(" not defined on ")
			mexpr(l0)
			ms(" (type ")
			mtype(l.typ)
			ms(")")
			errAt(E2002, s)
			return
		}
		_ = assignment(&r, l.typ, mkCtx(CtxAssign))
		return
	}
	lmark := opStack.top
	for i := usize(0); i < nl; i++ {
		l := l1at(s, i)
		if nkind(l) == NkIdent && isBlank(l) {
			x := invalidOp(l)
			x.mode = KBlankLHS
			opPush(x)
			continue
		}
		x := exprValue(l, dp-1)
		if !isInvalidOp(&x) && x.mode != KVar {
			mreset()
			ms("cannot assign to ")
			mexpr(l)
			errAt(E2002, l)
			x.mode = KNone
		}
		opPush(x)
	}
	rmark := opStack.top
	ok := rhsValues(s, nl, dp-1)
	if !ok {
		opStack.top = lmark
		return
	}
	for i := usize(0); i < nl; i++ {
		xi := rmark + i
		if opStack.items[xi].mode == KNone {
			continue
		}
		lm := opStack.items[lmark+i].mode
		if lm == KBlankLHS {
			if isUntyped(opStack.items[xi].typ) {
				_ = defaultTypeOp(&opStack.items[xi], mkCtx(CtxAssign))
			}
			continue
		}
		if lm == KNone {
			continue
		}
		assignValue(&opStack.items[xi], opStack.items[lmark+i].typ)
	}
	opStack.top = lmark
}

func returnStmt(s u32, dp usize) decreases(dp) {
	if dp == 0 {
		tooDeep()
		return
	}
	if chkFn == 0 {
		return
	}
	sig := funcs.items[usize(chkFn)].sig
	want := sigNResults(sig)
	nr := l1len(s)
	if nr == 0 {
		if want > 0 {
			mreset()
			ms("not enough return values: have 0, want ")
			mu(u64(want))
			errAt(E2003, s)
		}
		return
	}
	r0 := l1at(s, 0)
	if want == 0 {
		for i := usize(0); i < nr; i++ {
			_ = rawExpr(l1at(s, i), dp-1)
		}
		mreset()
		ms("too many return values: have ")
		mu(u64(nr))
		ms(", want 0")
		errAt(E2003, r0)
		return
	}
	if nr == 1 && want > 1 {
		x := rawExpr(r0, dp-1)
		if isInvalidOp(&x) {
			return
		}
		if x.typ == 0 || tk(x.typ) != TCTuple {
			singleValue(&x)
			if !isInvalidOp(&x) {
				mreset()
				ms("not enough return values: have 1, want ")
				mu(u64(want))
				errAt(E2003, r0)
			}
			return
		}
		nt := tl1n(x.typ)
		if nt != want {
			mreset()
			ms("wrong number of return values: have ")
			mu(u64(nt))
			ms(", want ")
			mu(u64(want))
			errAt(E2003, r0)
			return
		}
		for i := usize(0); i < nt; i++ {
			t := tl1(x.typ, i)
			w := sigResult(sig, i)
			if !assignable(t, w) && !isInvalid(w) {
				mreset()
				ms("cannot use result ")
				mu(u64(i + 1))
				ms(" of type ")
				mtype(t)
				ms(" as type ")
				mtype(w)
				ms(" in return statement")
				errAt(E2002, r0)
			}
		}
		return
	}
	if nr != want {
		for i := usize(0); i < nr; i++ {
			_ = rawExpr(l1at(s, i), dp-1)
		}
		mreset()
		if nr > want {
			ms("too many")
		} else {
			ms("not enough")
		}
		ms(" return values: have ")
		mu(u64(nr))
		ms(", want ")
		mu(u64(want))
		errAt(E2003, r0)
		return
	}
	for i := usize(0); i < nr; i++ {
		_ = exprWith(l1at(s, i), sigResult(sig, i), mkCtx(CtxReturn), dp-1)
	}
}

func bindInvalid(p u32) {
	n := l1len(p)
	for i := usize(0); i < n; i++ {
		setSymType(defs[usize(l1at(p, i))], TyInvalid)
	}
}

// pattern checks a single (non-or) pattern against the scrutinee type t
// and reports whether it is valid.
func pattern(p u32, t u32, dp usize) bool decreases(dp) {
	if dp == 0 {
		tooDeep()
		return false
	}
	en := underlying(t)
	isEnum := tk(en) == TCEnum
	k := nkind(p)
	if k == NkLiteralPattern {
		x := exprValue(na(p), dp-1)
		if !isInvalidOp(&x) {
			if !assignment(&x, t, mkCtx(CtxPattern)) {
				return false
			}
			if !comparable(t, SemaDepth) {
				mreset()
				ms("cannot match values of type ")
				mtype(t)
				ms(" against literals")
				errAt(E2002, p)
				return false
			}
			return true
		}
		return false
	}
	if k != NkCtorPattern {
		return true
	}
	name := nb(p)
	sym := uses[usize(name)]
	// A constant pattern (pkg.Const or Const). An unqualified name that is
	// a variant of the scrutinee's enum is that variant (v0.2).
	isVariant := false
	if na(p) == 0 && isEnum {
		_, isVariant = variantByName(en, idName(name))
	}
	if sym != 0 && symKind(sym) == SymConst && !isVariant {
		if nflag(p) {
			mreset()
			ms("constant ")
			mname(symName(sym))
			ms(" cannot have bindings")
			errAt(E2002, p)
			bindInvalid(p)
			return false
		}
		if isEnum {
			mreset()
			ms("constant ")
			mname(symName(sym))
			ms(" cannot be a pattern for enum type ")
			mtype(t)
			errAt(E2002, p)
			return false
		}
		x := symOperand(sym, name, dp-1)
		x.expr = name
		record(&x)
		return !isInvalidOp(&x) && assignment(&x, t, mkCtx(CtxPattern))
	}
	nm := idName(name)
	venum := u32(0)
	vi := usize(0)
	q := na(p)
	if q != 0 {
		qs := uses[usize(q)]
		if qs == 0 {
			bindInvalid(p)
			return false
		}
		if symKind(qs) != SymType {
			mreset()
			mname(idName(q))
			ms(" is not an enum type")
			errAt(E2002, q)
			bindInvalid(p)
			return false
		}
		qt := typeSym(qs, q, dp-1)
		ntype[usize(q)] = qt
		nmode[usize(q)] = KType
		if isInvalid(qt) {
			bindInvalid(p)
			return false
		}
		qe := underlying(qt)
		if tk(qe) != TCEnum {
			mreset()
			mtype(qt)
			ms(" is not an enum type")
			errAt(E2002, q)
			bindInvalid(p)
			return false
		}
		// v0.2: a generic enum qualifies patterns on its instances
		// (Option.Some(x) on an Option[u32]); the variant comes from the
		// instance.
		if tk(t) == TCNamed && namedOrigin(t) != 0 && namedOrigin(t) == qt && isEnum {
			qe = en
		} else if qt != t {
			mreset()
			ms("pattern of type ")
			mtype(qt)
			ms(" does not match scrutinee of type ")
			mtype(t)
			errAt(E2002, p)
			bindInvalid(p)
			return false
		}
		v, found := variantByName(qe, nm)
		if !found {
			mreset()
			ms("enum ")
			mtype(qt)
			ms(" has no variant ")
			mname(nm)
			errAt(E2001, name)
			bindInvalid(p)
			return false
		}
		venum = qe
		vi = v
	} else if isEnum {
		v, found := variantByName(en, nm)
		if !found {
			mreset()
			ms("undefined: ")
			mname(nm)
			ms(" (no constant or variant of ")
			mtype(t)
			ms(")")
			errAt(E2001, name)
			bindInvalid(p)
			return false
		}
		venum = en
		vi = v
	} else {
		mreset()
		ms("undefined: ")
		mname(nm)
		errAt(E2001, name)
		bindInvalid(p)
		return false
	}
	nvarEnum[usize(p)] = venum
	nvarIdx[usize(p)] = u32(vi)
	ntype[usize(p)] = t
	nbind := l1len(p)
	npay := variantPayN(venum, vi)
	if nbind != npay || (nflag(p) && npay == 0) {
		mreset()
		ms("variant ")
		mname(nm)
		ms(" has ")
		mu(u64(npay))
		ms(" payload values, pattern binds ")
		mu(u64(nbind))
		errAt(E2003, p)
		bindInvalid(p)
		return false
	}
	for i := usize(0); i < nbind; i++ {
		b := l1at(p, i)
		bs := defs[usize(b)]
		if bs != 0 {
			setSymType(bs, variantPay(venum, vi, i))
		} else {
			ntype[usize(b)] = variantPay(venum, vi, i)
		}
	}
	return true
}

// ---------------------------------------------------------------------------
// Terminating statements (Go spec rules, adapted)

func isTerminatingList(bl u32, dp usize) bool decreases(dp) {
	if dp == 0 || bl == 0 {
		return false
	}
	n := l1len(bl)
	return n > 0 && isTerminating(l1at(bl, n-1), dp-1)
}

func isTerminating(s u32, dp usize) bool decreases(dp) {
	if dp == 0 || s == 0 {
		return false
	}
	k := nkind(s)
	if k == NkReturnStmt {
		return true
	}
	if k == NkExprStmt {
		return isPanicCall(na(s))
	}
	if k == NkBlockStmt {
		return isTerminatingList(s, dp-1)
	}
	if k == NkIfStmt {
		return nd(s) != 0 && isTerminatingList(nc(s), dp-1) && isTerminating(nd(s), dp-1)
	}
	if k == NkForStmt {
		return nb(s) == 0 && !hasBreak(ne(s), dp-1)
	}
	if k == NkScopeStmt {
		return isTerminatingList(nc(s), dp-1)
	}
	if k == NkMatchStmt {
		// v0.2: a match on an enum is exhaustive (E2012 otherwise), so it
		// terminates if all arms do; other matches need a '_' arm.
		exhaustive := false
		n := l1len(s)
		for i := usize(0); i < n; i++ {
			arm := l1at(s, i)
			pat := na(arm)
			if nkind(pat) == NkWildcardPattern {
				exhaustive = true
			}
			if nb(arm) != 0 && !isPanicCall(nb(arm)) {
				return false
			}
			if nc(arm) != 0 && !isTerminatingList(nc(arm), dp-1) {
				return false
			}
		}
		if !exhaustive && n > 0 {
			t := ntype[usize(na(s))]
			if t != 0 && tk(underlying(t)) == TCEnum {
				exhaustive = true
			}
		}
		return exhaustive
	}
	return false
}

func isPanicCall(e u32) bool {
	call := unparen(e)
	if nkind(call) != NkCallExpr {
		return false
	}
	ci := ncall[usize(call)]
	return ci != 0 && callTab.items[usize(ci)].kind == CallBuiltin && callTab.items[usize(ci)].builtin == BFPanic
}

// hasBreak reports whether a block contains a break that targets the
// enclosing loop.
func hasBreak(bl u32, dp usize) bool decreases(dp) {
	if dp == 0 || bl == 0 {
		return false
	}
	n := l1len(bl)
	for i := usize(0); i < n; i++ {
		if stmtHasBreak(l1at(bl, i), dp-1) {
			return true
		}
	}
	return false
}

func stmtHasBreak(s u32, dp usize) bool decreases(dp) {
	if dp == 0 || s == 0 {
		return false
	}
	k := nkind(s)
	if k == NkBreakStmt {
		return true
	}
	if k == NkBlockStmt {
		return hasBreak(s, dp-1)
	}
	if k == NkIfStmt {
		return hasBreak(nc(s), dp-1) || (nd(s) != 0 && stmtHasBreak(nd(s), dp-1))
	}
	if k == NkMatchStmt {
		n := l1len(s)
		for i := usize(0); i < n; i++ {
			arm := l1at(s, i)
			if nc(arm) != 0 && hasBreak(nc(arm), dp-1) {
				return true
			}
		}
		return false
	}
	if k == NkScopeStmt {
		return hasBreak(nc(s), dp-1)
	}
	return false
}
