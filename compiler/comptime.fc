package main

// Compile-time value representation and fuel-bounded `comptime` evaluator.
// Handles constant folding, Layer-1 `Code n` / `El(...)` types, and `comptime func`.

const (
	MaxVals     = 65536
	MaxValList  = 131072
	MaxCTEnv    = 256
	MaxCTDepth  = 64
)

const (
	VKNone   u8 = 0
	VKInt    u8 = 1 // u64Val (bit pattern); flags: bit0=isSigned
	VKBool   u8 = 2 // a=0/1
	VKStr    u8 = 3 // a=strID
	VKErr    u8 = 4 // a=errID (0..11)
	VKArray  u8 = 5 // a=valListStart, b=count, typeID=arrayType
	VKStruct u8 = 6 // a=valListStart, b=count, typeID=structType
	VKEnum   u8 = 7 // a=varIdx, b=valListStart, c=payCount, typeID=enumType
	VKSlice  u8 = 8 // a=baseValID(VKArray), b=lo, c=hi, typeID=sliceType
	VKCode   u8 = 9 // a=codeKind, b=level, c=extra1, d=extra2, u64Val=len
	VKField  u8 = 10 // a=nameStrID, b=codeValID (FieldCode)
	VKFloat  u8 = 11 // u64Val = IEEE-754 f64 bit pattern
)

// Code kinds (for VKCode).
const (
	CodeBool   u32 = 1
	CodeU8     u32 = 2
	CodeU16    u32 = 3
	CodeU32    u32 = 4
	CodeU64    u32 = 5
	CodeUsize  u32 = 6
	CodeI8     u32 = 7
	CodeI16    u32 = 8
	CodeI32    u32 = 9
	CodeI64    u32 = 10
	CodeInt    u32 = 11
	CodeString u32 = 12
	CodeArray  u32 = 13 // u64Val=len, c=elemCodeValID
	CodeStruct u32 = 14 // c=valListStart (VKField...), d=count
)

type Val struct {
	kind   u8
	flags  u8
	pad    u16
	typeID u32
	a      u32
	b      u32
	c      u32
	d      u32
	u64Val u64
}

var vals [MaxVals]Val
var valCount u32
var valList [MaxValList]u32
var valListUsed u32

var comptimeFuelBudget u64 = 1_000_000

func valsInit() {
	valCount = 1 // 0 = VKNone
	vals[0] = Val{}
	valListUsed = 0
}

func newVal(v Val) u32 {
	if valCount >= MaxVals {
		return 0
	}
	id := valCount
	valCount++
	vals[id] = v
	return id
}

func makeIntVal(bits u64, signed bool, ty u32) u32 {
	var fl u8 = 0
	if signed {
		fl = 1
	}
	return newVal(Val{kind: VKInt, flags: fl, typeID: ty, u64Val: bits})
}

func makeFloatVal(bits u64, ty u32) u32 {
	return newVal(Val{kind: VKFloat, typeID: ty, u64Val: bits})
}

func makeBoolVal(b bool) u32 {
	var a u32 = 0
	if b {
		a = 1
	}
	return newVal(Val{kind: VKBool, typeID: TYBool, a: a})
}

func makeStrVal(strID u32) u32 {
	return newVal(Val{kind: VKStr, typeID: TYString, a: strID})
}

func makeErrVal(errID u32) u32 {
	return newVal(Val{kind: VKErr, typeID: TYError, a: errID})
}

func pushValList(items []u32) (u32, u32) {
	n := len(items)
	if n == 0 {
		return 0, 0
	}
	if usize(valListUsed)+n > MaxValList {
		return 0, 0
	}
	start := valListUsed
	for i := usize(0); i < n; i++ {
		valList[usize(start)+i] = items[i]
	}
	valListUsed += u32(n)
	return start, u32(n)
}

func valMaskInt(bits u64, ty u32) u64 {
	u := under(ty)
	if u == TYU8 {
		return bits & 0xff
	}
	if u == TYI8 {
		return u64(i64(i8(bits)))
	}
	if u == TYU16 {
		return bits & 0xffff
	}
	if u == TYI16 {
		return u64(i64(i16(bits)))
	}
	if u == TYU32 {
		return bits & 0xffffffff
	}
	if u == TYI32 {
		return u64(i64(i32(bits)))
	}
	return bits
}

driver func valEqual(a u32, b u32) bool {
	if a == b {
		return true
	}
	if a == 0 || b == 0 {
		return false
	}
	va := vals[a]
	vb := vals[b]
	if va.kind != vb.kind {
		return false
	}
	if va.kind == VKInt {
		return va.u64Val == vb.u64Val
	}
	if va.kind == VKBool || va.kind == VKErr {
		return va.a == vb.a
	}
	if va.kind == VKStr {
		return va.a == vb.a
	}
	if va.kind == VKEnum {
		if va.a != vb.a || va.c != vb.c {
			return false
		}
		for i := u32(0); i < va.c; i++ {
			if !valEqual(valList[va.b+i], valList[vb.b+i]) {
				return false
			}
		}
		return true
	}
	if va.kind == VKArray || va.kind == VKStruct {
		if va.b != vb.b {
			return false
		}
		for i := u32(0); i < va.b; i++ {
			if !valEqual(valList[va.a+i], valList[vb.a+i]) {
				return false
			}
		}
		return true
	}
	return false
}

// decodeCodeType decodes a Layer-1 VKCode value into a concrete TypeID (`El(c)`).
driver func decodeCodeType(valID u32) u32 {
	if valID == 0 || vals[valID].kind != VKCode {
		return TYInvalid
	}
	v := vals[valID]
	if v.a == CodeBool {
		return TYBool
	}
	if v.a == CodeU8 {
		return TYU8
	}
	if v.a == CodeU16 {
		return TYU16
	}
	if v.a == CodeU32 {
		return TYU32
	}
	if v.a == CodeU64 {
		return TYU64
	}
	if v.a == CodeUsize {
		return TYUsize
	}
	if v.a == CodeI8 {
		return TYI8
	}
	if v.a == CodeI16 {
		return TYI16
	}
	if v.a == CodeI32 {
		return TYI32
	}
	if v.a == CodeI64 {
		return TYI64
	}
	if v.a == CodeInt {
		return TYInt
	}
	if v.a == CodeString {
		return TYString
	}
	if v.a == CodeArray {
		elem := decodeCodeType(v.c)
		return makeArrayType(elem, v.u64Val)
	}
	if v.a == CodeStruct {
		fs := fieldCount
		for i := u32(0); i < v.d; i++ {
			fv := vals[valList[v.c+i]]
			if fieldCount < MaxFields {
				fields[fieldCount] = Field{nameStr: fv.a, typeID: decodeCodeType(fv.b)}
				fieldCount++
			}
		}
		return newType(Type{kind: TKindStruct, a: fs, b: v.d})
	}
	return TYInvalid
}

// ---------------------------------------------------------------------------
// Fuel-bounded Comptime Evaluator (evaluates const exprs & comptime funcs)

type CTFrame struct {
	fuel     u64
	outOfFuel bool
	failed   bool
	fileID   u32
	callOff  u32
	depth    u32
	// Local variable bindings (nameStr -> valID)
	names    [MaxCTEnv]u32
	varVals  [MaxCTEnv]u32
	varTypes [MaxCTEnv]u32
	nVars    u32
	// Control flow
	didReturn bool
	didBreak  bool
	didCont   bool
	retVal    u32
	// Current iota value (for const specs)
	iotaVal   u32
	pkgID     u32
}

func (ct *CTFrame) tick() bool {
	if ct.fuel == 0 {
		if !ct.outOfFuel {
			ct.outOfFuel = true
			addDiagStr(E4001, ct.fileID, ct.callOff, "comptime evaluation exceeded fuel limit")
		}
		ct.failed = true
		return false
	}
	ct.fuel--
	return true
}

func (ct *CTFrame) lookupLocal(nameStr u32) (u32, bool) {
	if ct.nVars == 0 {
		return 0, false
	}
	i := ct.nVars
	for step := u32(0); step < MaxCTEnv; step++ {
		if i == 0 {
			break
		}
		i--
		if ct.names[i] == nameStr {
			return i, true
		}
	}
	return 0, false
}

func (ct *CTFrame) bindLocal(nameStr u32, valID u32, ty u32) {
	if ct.nVars < MaxCTEnv {
		ct.names[ct.nVars] = nameStr
		ct.varVals[ct.nVars] = valID
		ct.varTypes[ct.nVars] = ty
		ct.nVars++
	}
}

driver func ctZeroVal(ty u32) u32 {
	if ty == 0 {
		return 0
	}
	u := under(ty)
	t := types[u]
	if t.kind == TKindBasic {
		if u == TYBool {
			return makeBoolVal(false)
		}
		if u == TYString {
			return makeStrVal(0)
		}
		if u == TYError {
			return makeErrVal(0)
		}
		return makeIntVal(0, isSignedInt(u), ty)
	}
	if t.kind == TKindArray {
		if t.lenVal > 4096 {
			return 0
		}
		z := ctZeroVal(t.a)
		start := valListUsed
		for i := u64(0); i < t.lenVal; i++ {
			if valListUsed < MaxValList {
				valList[valListUsed] = z
				valListUsed++
			}
		}
		return newVal(Val{kind: VKArray, typeID: ty, a: start, b: u32(t.lenVal)})
	}
	if t.kind == TKindStruct {
		var fs [64]u32
		for i := u32(0); i < t.b; i++ {
			fs[i] = ctZeroVal(fields[t.a+i].typeID)
		}
		s, c := pushValList(fs[:usize(t.b)])
		return newVal(Val{kind: VKStruct, typeID: ty, a: s, b: c})
	}
	if t.kind == TKindEnum {
		return newVal(Val{kind: VKEnum, typeID: ty, a: 0, b: 0, c: 0})
	}
	return 0
}

driver func (ct *CTFrame) evalExpr(n u32) u32 {
	if n == 0 || ct.failed || !ct.tick() {
		return 0
	}
	nd := nodes[n]
	if nd.kind == NKIntLit {
		return makeIntVal(u64Pool[nd.b], false, TYUntypedInt)
	}
	if nd.kind == NKFloatLit {
		return makeFloatVal(u64Pool[nd.b], TYUntypedFloat)
	}
	if nd.kind == NKCharLit {
		return makeIntVal(u64(nd.a), false, TYUntypedInt)
	}
	if nd.kind == NKBoolLit {
		return makeBoolVal(nd.a != 0)
	}
	if nd.kind == NKStrLit {
		return makeStrVal(nd.a)
	}
	if nd.kind == NKNilLit {
		return makeErrVal(0)
	}
	if nd.kind == NKIdent {
		if nd.a == kwIota {
			return makeIntVal(u64(ct.iotaVal), false, TYUntypedInt)
		}
		if idx, ok := ct.lookupLocal(nd.a); ok {
			return ct.varVals[idx]
		}
		sym := nodeSym[n]
		if sym == 0 {
			sym = lookupPkgOrUniverse(ct.pkgID, nd.a)
		}
		if sym != 0 && syms[sym].kind == SymConst {
			if syms[sym].valID == 0 {
				evalConstSym(sym)
			}
			return syms[sym].valID
		}
		ct.failed = true
		return 0
	}
	if nd.kind == NKSelector {
		// Package-qualified const `pkg.C`
		sym := nodeSym[n]
		if sym == 0 && nodes[nd.a].kind == NKIdent {
			if targetPkg, ok := lookupFileImport(nd.fileID, nodes[nd.a].a); ok {
				sym = lookupPkgSym(targetPkg, nd.b)
			}
		}
		if sym != 0 && syms[sym].kind == SymConst {
			if syms[sym].valID == 0 {
				evalConstSym(sym)
			}
			return syms[sym].valID
		}
		// Enum variant without payload `Color.Red`
		if (nodeFlags[n] & NFVariantSel) != 0 {
			et := nodeType[n]
			return newVal(Val{kind: VKEnum, typeID: et, a: nodeSelIdx[n], b: 0, c: 0})
		}
		if et := resolveExprAsType(ct.pkgID, nd.a); et != 0 && types[under(et)].kind == TKindEnum {
			if vidx, ok := findEnumVariant(et, nd.b); ok {
				return newVal(Val{kind: VKEnum, typeID: et, a: vidx, b: 0, c: 0})
			}
		}
		// Struct field access `x.f`
		xv := ct.evalExpr(nd.a)
		if xv != 0 && vals[xv].kind == VKStruct {
			fi, _, ok := findStructField(vals[xv].typeID, nd.b)
			if ok && fi < vals[xv].b {
				return valList[vals[xv].a+fi]
			}
		}
		ct.failed = true
		return 0
	}
	if nd.kind == NKUnary {
		xv := ct.evalExpr(nd.a)
		if xv == 0 {
			ct.failed = true
			return 0
		}
		v := vals[xv]
		if nd.op == TKAdd && v.kind == VKInt {
			return xv
		}
		if nd.op == TKSub && v.kind == VKInt {
			return makeIntVal(0-v.u64Val, true, v.typeID)
		}
		if nd.op == TKXor && v.kind == VKInt {
			return makeIntVal(valMaskInt(^v.u64Val, v.typeID), v.flags != 0, v.typeID)
		}
		if nd.op == TKNot && v.kind == VKBool {
			return makeBoolVal(v.a == 0)
		}
		ct.failed = true
		return 0
	}
	if nd.kind == NKBinary {
		// Short-circuit && and ||
		if nd.op == TKLAnd {
			lv := ct.evalExpr(nd.a)
			if lv == 0 || vals[lv].kind != VKBool {
				ct.failed = true
				return 0
			}
			if vals[lv].a == 0 {
				return makeBoolVal(false)
			}
			return ct.evalExpr(nd.b)
		}
		if nd.op == TKLOr {
			lv := ct.evalExpr(nd.a)
			if lv == 0 || vals[lv].kind != VKBool {
				ct.failed = true
				return 0
			}
			if vals[lv].a != 0 {
				return makeBoolVal(true)
			}
			return ct.evalExpr(nd.b)
		}
		lv := ct.evalExpr(nd.a)
		rv := ct.evalExpr(nd.b)
		if lv == 0 || rv == 0 {
			ct.failed = true
			return 0
		}
		vl := vals[lv]
		vr := vals[rv]
		if nd.op == TKEql {
			return makeBoolVal(valEqual(lv, rv))
		}
		if nd.op == TKNeq {
			return makeBoolVal(!valEqual(lv, rv))
		}
		// Constant string concatenation
		if nd.op == TKAdd && vl.kind == VKStr && vr.kind == VKStr {
			sb1 := strSlice(vl.a)
			sb2 := strSlice(vr.a)
			var buf [4096]byte
			p := copy(buf[:], sb1)
			p += copy(buf[p:], sb2)
			return makeStrVal(internBytes(buf[:p]))
		}
		if vl.kind == VKInt && vr.kind == VKInt {
			resTy := nodeType[n]
			if resTy == 0 {
				resTy = vl.typeID
			}
			signed := isSignedInt(resTy) || (resTy == TYUntypedInt && (vl.flags != 0 || vr.flags != 0))
			a := vl.u64Val
			b := vr.u64Val
			if nd.op == TKAdd {
				return makeIntVal(valMaskInt(a+b, resTy), signed, resTy)
			}
			if nd.op == TKSub {
				return makeIntVal(valMaskInt(a-b, resTy), signed, resTy)
			}
			if nd.op == TKMul {
				return makeIntVal(valMaskInt(a*b, resTy), signed, resTy)
			}
			if nd.op == TKQuo {
				if b == 0 {
					ct.failed = true
					return 0
				}
				if signed {
					return makeIntVal(valMaskInt(u64(i64(a)/i64(b)), resTy), true, resTy)
				}
				return makeIntVal(valMaskInt(a/b, resTy), false, resTy)
			}
			if nd.op == TKRem {
				if b == 0 {
					ct.failed = true
					return 0
				}
				if signed {
					return makeIntVal(valMaskInt(u64(i64(a)%i64(b)), resTy), true, resTy)
				}
				return makeIntVal(valMaskInt(a%b, resTy), false, resTy)
			}
			if nd.op == TKAnd {
				return makeIntVal(valMaskInt(a&b, resTy), signed, resTy)
			}
			if nd.op == TKOr {
				return makeIntVal(valMaskInt(a|b, resTy), signed, resTy)
			}
			if nd.op == TKXor {
				return makeIntVal(valMaskInt(a^b, resTy), signed, resTy)
			}
			if nd.op == TKShl {
				if b >= 64 {
					return makeIntVal(0, signed, resTy)
				}
				return makeIntVal(valMaskInt(a<<b, resTy), signed, resTy)
			}
			if nd.op == TKShr {
				if b >= 64 {
					if signed && i64(a) < 0 {
						return makeIntVal(valMaskInt(^u64(0), resTy), true, resTy)
					}
					return makeIntVal(0, signed, resTy)
				}
				if signed {
					return makeIntVal(valMaskInt(u64(i64(a)>>b), resTy), true, resTy)
				}
				return makeIntVal(valMaskInt(a>>b, resTy), false, resTy)
			}
			if nd.op == TKLss {
				if signed {
					return makeBoolVal(i64(a) < i64(b))
				}
				return makeBoolVal(a < b)
			}
			if nd.op == TKLeq {
				if signed {
					return makeBoolVal(i64(a) <= i64(b))
				}
				return makeBoolVal(a <= b)
			}
			if nd.op == TKGtr {
				if signed {
					return makeBoolVal(i64(a) > i64(b))
				}
				return makeBoolVal(a > b)
			}
			if nd.op == TKGeq {
				if signed {
					return makeBoolVal(i64(a) >= i64(b))
				}
				return makeBoolVal(a >= b)
			}
		}
		ct.failed = true
		return 0
	}
	if nd.kind == NKSlice {
		xv := ct.evalExpr(nd.a)
		if xv == 0 {
			ct.failed = true
			return 0
		}
		if vals[xv].kind == VKArray || vals[xv].kind == VKSlice {
			var base u32 = xv
			var baseLo u32 = 0
			var baseLen u32 = vals[xv].b
			if vals[xv].kind == VKSlice {
				base = vals[xv].a
				baseLo = vals[xv].b
				baseLen = vals[xv].c - vals[xv].b
			}
			var lo u32 = 0
			var hi u32 = baseLen
			if nd.b != 0 {
				lv := ct.evalExpr(nd.b)
				if lv == 0 || vals[lv].kind != VKInt {
					ct.failed = true
					return 0
				}
				lo = u32(vals[lv].u64Val)
			}
			if nd.c != 0 {
				hv := ct.evalExpr(nd.c)
				if hv == 0 || vals[hv].kind != VKInt {
					ct.failed = true
					return 0
				}
				hi = u32(vals[hv].u64Val)
			}
			if lo > hi || hi > baseLen {
				addDiagStr(E4003, nd.fileID, nd.off, "comptime slice out of bounds")
				ct.failed = true
				return 0
			}
			return newVal(Val{kind: VKSlice, typeID: nodeType[n], a: base, b: baseLo + lo, c: baseLo + hi})
		}
		return xv
	}
	if nd.kind == NKIndex {
		xv := ct.evalExpr(nd.a)
		iv := ct.evalExpr(listPool[nd.b])
		if xv == 0 || iv == 0 || vals[iv].kind != VKInt {
			ct.failed = true
			return 0
		}
		idx := vals[iv].u64Val
		if vals[xv].kind == VKArray {
			if idx >= u64(vals[xv].b) {
				addDiagStr(E4003, nd.fileID, nd.off, "comptime array index out of bounds")
				ct.failed = true
				return 0
			}
			return valList[vals[xv].a+u32(idx)]
		}
		if vals[xv].kind == VKStr {
			sb := strSlice(vals[xv].a)
			if idx >= u64(len(sb)) {
				ct.failed = true
				return 0
			}
			return makeIntVal(u64(sb[usize(idx)]), false, TYU8)
		}
		ct.failed = true
		return 0
	}
	if nd.kind == NKStructLit {
		stTy := nodeType[n]
		if stTy == 0 {
			stTy = resolveExprAsType(ct.pkgID, nd.a)
		}
		if stTy == 0 {
			ct.failed = true
			return 0
		}
		u := under(stTy)
		if types[u].kind != TKindStruct {
			ct.failed = true
			return 0
		}
		var fvs [64]u32
		fc := types[u].b
		for i := u32(0); i < fc; i++ {
			fvs[i] = ctZeroVal(fields[types[u].a+i].typeID)
		}
		for i := u32(0); i < nd.c; i++ {
			fi := nodes[listPool[nd.b+i]]
			idx, _, ok := findStructField(u, fi.a)
			if ok && idx < fc {
				fvs[idx] = ct.evalExpr(fi.b)
			}
		}
		if ct.failed {
			return 0
		}
		s, c := pushValList(fvs[:usize(fc)])
		return newVal(Val{kind: VKStruct, typeID: stTy, a: s, b: c})
	}
	if nd.kind == NKArrayLit {
		arrTy := nodeType[n]
		if arrTy == 0 {
			arrTy = resolveTypeNode(ct.pkgID, nd.a)
		}
		u := under(arrTy)
		if types[u].kind != TKindArray || types[u].lenVal > 4096 {
			ct.failed = true
			return 0
		}
		z := ctZeroVal(types[u].a)
		start := valListUsed
		arrLen := types[u].lenVal
		for i := u64(0); i < arrLen; i++ {
			v := z
			if i < u64(nd.c) {
				v = ct.evalExpr(listPool[nd.b+u32(i)])
			}
			if valListUsed < MaxValList {
				valList[valListUsed] = v
				valListUsed++
			}
		}
		if ct.failed {
			return 0
		}
		return newVal(Val{kind: VKArray, typeID: arrTy, a: start, b: u32(types[u].lenVal)})
	}
	if nd.kind == NKMatchExpr {
		sv := ct.evalExpr(nd.a)
		if sv == 0 {
			ct.failed = true
			return 0
		}
		for i := u32(0); i < nd.c; i++ {
			arm := nodes[listPool[nd.b+i]]
			savedVars := ct.nVars
			if ct.matchPat(arm.a, sv) {
				res := ct.evalExpr(arm.b)
				ct.nVars = savedVars
				return res
			}
			ct.nVars = savedVars
		}
		ct.failed = true
		return 0
	}
	if nd.kind == NKCall {
		return ct.evalCall(n)
	}
	ct.failed = true
	return 0
}

driver func (ct *CTFrame) matchPat(patNode u32, sv u32) bool {
	pn := nodes[patNode]
	if pn.kind == NKPatWild {
		return true
	}
	if pn.kind == NKPatOr {
		for i := u32(0); i < pn.b; i++ {
			if ct.matchPat(listPool[pn.a+i], sv) {
				return true
			}
		}
		return false
	}
	if pn.kind == NKPatLit {
		lv := ct.evalExpr(pn.a)
		return valEqual(sv, lv)
	}
	if pn.kind == NKPatCtor {
		if vals[sv].kind == VKEnum {
			et := under(vals[sv].typeID)
			vname := nodes[pn.a].a
			if nodes[pn.a].kind == NKSelector {
				vname = nodes[pn.a].b
			}
			vidx, ok := findEnumVariant(et, vname)
			if !ok || vals[sv].a != vidx {
				return false
			}
			for i := u32(0); i < pn.c; i++ {
				bn := nodes[listPool[pn.b+i]]
				if bn.kind == NKIdent && bn.a != kwBlank && i < vals[sv].c {
					ct.bindLocal(bn.a, valList[vals[sv].b+i], 0)
				}
			}
			return true
		}
		// Constant pattern
		cv := ct.evalExpr(pn.a)
		return valEqual(sv, cv)
	}
	return false
}

driver func (ct *CTFrame) evalCall(n u32) u32 {
	nd := nodes[n]
	// Check classified call if available, otherwise resolve callee by name
	var ci CallInfo
	if nodeCall[n] != 0 {
		ci = calls[nodeCall[n]]
	} else {
		// Early const-eval before full typecheck: resolve simple ident callee
		if nodes[nd.a].kind == NKIdent {
			sym := lookupPkgOrUniverse(ct.pkgID, nodes[nd.a].a)
			if sym != 0 {
				if syms[sym].kind == SymType {
					ci.kind = CKConv
					ci.convType = syms[sym].typeID
				} else if syms[sym].kind == SymBuiltin {
					ci.kind = CKBuiltin
					ci.builtinID = syms[sym].builtin
				} else if syms[sym].kind == SymFunc {
					ci.kind = CKFunc
					ci.calleeSym = sym
				}
			}
		} else if nodes[nd.a].kind == NKSelector {
			if (nodeFlags[nd.a] & NFVariantSel) != 0 {
				ci.kind = CKVariant
				ci.varType = nodeType[n]
				ci.varIdx = nodeSelIdx[nd.a]
			} else if et := resolveExprAsType(ct.pkgID, nodes[nd.a].a); et != 0 && types[under(et)].kind == TKindEnum {
				if vidx, ok := findEnumVariant(et, nodes[nd.a].b); ok {
					ci.kind = CKVariant
					ci.varType = et
					ci.varIdx = vidx
				}
			}
		}
	}

	if ci.kind == CKConv {
		if nd.c != 1 {
			ct.failed = true
			return 0
		}
		xv := ct.evalExpr(listPool[nd.b])
		if xv == 0 {
			ct.failed = true
			return 0
		}
		if vals[xv].kind == VKInt && isIntType(ci.convType) {
			return makeIntVal(valMaskInt(vals[xv].u64Val, ci.convType), isSignedInt(ci.convType), ci.convType)
		}
		if vals[xv].kind == VKBool && isBoolType(ci.convType) {
			return xv
		}
		if vals[xv].kind == VKStr && isStringType(ci.convType) {
			return xv
		}
		return xv
	}
	if ci.kind == CKVariant {
		var pays [16]u32
		for i := u32(0); i < nd.c; i++ {
			pays[i] = ct.evalExpr(listPool[nd.b+i])
		}
		if ct.failed {
			return 0
		}
		ps, pc := pushValList(pays[:usize(nd.c)])
		return newVal(Val{kind: VKEnum, typeID: ci.varType, a: ci.varIdx, b: ps, c: pc})
	}
	if ci.kind == CKBuiltin {
		return ct.evalBuiltin(ci.builtinID, nd.b, nd.c, nd.fileID, nd.off)
	}
	if ci.kind == CKFunc && ci.calleeSym != 0 {
		fnDecl := syms[ci.calleeSym].declNode
		if fnDecl == 0 || (nodes[fnDecl].op != EffComptime && (ct.depth == 0 || nodes[fnDecl].op != EffTotal)) {
			ct.failed = true
			return 0
		}
		if ct.depth >= MaxCTDepth {
			addDiagStr(E4001, ct.fileID, ct.callOff, "comptime recursion depth exceeded")
			ct.failed = true
			return 0
		}
		// Evaluate arguments
		var argVals [16]u32
		for i := u32(0); i < nd.c; i++ {
			argVals[i] = ct.evalExpr(listPool[nd.b+i])
		}
		if ct.failed {
			return 0
		}
		// Create child frame sharing remaining fuel!
		var child CTFrame
		child.fuel = ct.fuel
		child.fileID = ct.fileID
		child.callOff = ct.callOff
		child.depth = ct.depth + 1
		child.pkgID = syms[ci.calleeSym].pkgID
		sig := nodes[nodes[fnDecl].c]
		lim := sig.d
		if nd.c < lim {
			lim = nd.c
		}
		for i := u32(0); i < lim; i++ {
			pnode := nodes[listPool[sig.c+i]]
			child.bindLocal(pnode.a, argVals[i], nodeType[pnode.b])
		}
		child.execBlock(nodes[fnDecl].d)
		ct.fuel = child.fuel
		if child.outOfFuel {
			ct.outOfFuel = true
		}
		if child.failed {
			ct.failed = true
			return 0
		}
		return child.retVal
	}
	ct.failed = true
	return 0
}

func ctExtractBytes(v u32, dst []byte) usize {
	if v == 0 {
		return 0
	}
	var base u32 = 0
	var lo u32 = 0
	var n u32 = 0
	if vals[v].kind == VKSlice {
		base = vals[v].a
		lo = vals[v].b
		n = vals[v].c - vals[v].b
	} else if vals[v].kind == VKArray {
		base = v
		lo = 0
		n = vals[v].b
	} else {
		return 0
	}
	if usize(n) > len(dst) {
		n = u32(len(dst))
	}
	for i := u32(0); i < n; i++ {
		if lo+i < vals[base].b {
			ev := valList[vals[base].a+lo+i]
			dst[usize(i)] = byte(vals[ev].u64Val)
		}
	}
	return usize(n)
}

driver func (ct *CTFrame) evalBuiltin(bid u16, argStart u32, argCount u32, fileID u32, off u32) u32 {
	if bid == BFLen && argCount == 1 {
		v := ct.evalExpr(listPool[argStart])
		if v == 0 {
			ct.failed = true
			return 0
		}
		if vals[v].kind == VKArray {
			return makeIntVal(u64(vals[v].b), false, TYUsize)
		}
		if vals[v].kind == VKStr {
			return makeIntVal(u64(len(strSlice(vals[v].a))), false, TYUsize)
		}
	}
	if bid == BFFormatTo && argCount >= 2 {
		dstv := ct.evalExpr(listPool[argStart])
		fmtv := ct.evalExpr(listPool[argStart+1])
		if fmtv == 0 || vals[fmtv].kind != VKStr {
			ct.failed = true
			return 0
		}
		var dstBase u32 = 0
		var dstLo u32 = 0
		var dstCap usize = 1024
		if dstv != 0 && vals[dstv].kind == VKSlice {
			dstBase = vals[dstv].a
			dstLo = vals[dstv].b
			dstCap = usize(vals[dstv].c - vals[dstv].b)
		} else if dstv != 0 && vals[dstv].kind == VKArray {
			dstBase = dstv
			dstLo = 0
			dstCap = usize(vals[dstv].b)
		}
		if dstCap > 1024 {
			dstCap = 1024
		}
		fb := strSlice(vals[fmtv].a)
		var outBuf [1024]byte
		pos := usize(0)
		aidx := u32(2)
		i := usize(0)
		for step := usize(0); step < len(fb)+1; step++ {
			if i >= len(fb) {
				break
			}
			if fb[i] != '%' {
				if pos < dstCap {
					outBuf[pos] = fb[i]
					pos++
				}
				i++
				continue
			}
			i++
			if i >= len(fb) {
				break
			}
			if fb[i] == '%' {
				if pos < dstCap {
					outBuf[pos] = '%'
					pos++
				}
				i++
				continue
			}
			leftAlign := false
			if fb[i] == '-' {
				leftAlign = true
				i++
			}
			zeroPad := false
			if i < len(fb) && fb[i] == '0' {
				zeroPad = true
				i++
			}
			width := usize(0)
			for sk := usize(0); sk < 8; sk++ {
				if i >= len(fb) || !isDigit(fb[i]) {
					break
				}
				width = width*10 + usize(fb[i]-'0')
				i++
			}
			if i >= len(fb) || aidx >= argCount {
				break
			}
			verb := fb[i]
			i++
			av := ct.evalExpr(listPool[argStart+aidx])
			aidx++
			if av == 0 {
				ct.failed = true
				return 0
			}
			var ftmp [256]byte
			flen := usize(0)
			isNum := false
			if verb == 'd' && vals[av].kind == VKInt {
				isNum = true
				if vals[av].flags != 0 {
					flen = formatTo(ftmp[:], "%d", i64(vals[av].u64Val))
				} else {
					flen = formatTo(ftmp[:], "%d", vals[av].u64Val)
				}
			} else if verb == 'x' && vals[av].kind == VKInt {
				isNum = true
				if vals[av].flags != 0 {
					flen = formatTo(ftmp[:], "%x", i64(vals[av].u64Val))
				} else {
					flen = formatTo(ftmp[:], "%x", vals[av].u64Val)
				}
			} else if verb == 's' {
				if vals[av].kind == VKStr {
					flen = copy(ftmp[:], strSlice(vals[av].a))
				} else if vals[av].kind == VKSlice || vals[av].kind == VKArray {
					flen = ctExtractBytes(av, ftmp[:])
				}
			} else if verb == 'q' {
				if vals[av].kind == VKStr {
					flen = formatTo(ftmp[:], "%q", bytesToStr(strSlice(vals[av].a)))
				} else if vals[av].kind == VKSlice || vals[av].kind == VKArray {
					var rawB [256]byte
					rn := ctExtractBytes(av, rawB[:])
					flen = formatTo(ftmp[:], "%q", rawB[:rn])
				}
			} else if verb == 'c' && vals[av].kind == VKInt {
				ftmp[0] = byte(vals[av].u64Val)
				flen = 1
			} else if verb == 'v' {
				if vals[av].kind == VKBool {
					flen = formatTo(ftmp[:], "%v", vals[av].a != 0)
				} else if vals[av].kind == VKInt {
					isNum = true
					if vals[av].flags != 0 {
						flen = formatTo(ftmp[:], "%d", i64(vals[av].u64Val))
					} else {
						flen = formatTo(ftmp[:], "%d", vals[av].u64Val)
					}
				} else if vals[av].kind == VKStr {
					flen = copy(ftmp[:], strSlice(vals[av].a))
				} else if vals[av].kind == VKSlice || vals[av].kind == VKArray {
					flen = ctExtractBytes(av, ftmp[:])
				} else if vals[av].kind == VKStruct || vals[av].kind == VKEnum {
					origSym := typeOriginSym(vals[av].typeID)
					if origSym != 0 {
						if mSym, ok := findUserMethod(origSym, strFormat); ok {
							fnDecl := syms[mSym].declNode
							// Scratch array for Format([]byte) output
							scArr := ctZeroVal(makeArrayType(TYU8, 64))
							scSlice := newVal(Val{kind: VKSlice, typeID: makeSliceType(TYU8), a: scArr, b: 0, c: 64})
							var child CTFrame
							child.fuel = ct.fuel
							child.fileID = ct.fileID
							child.callOff = ct.callOff
							child.depth = ct.depth + 1
							child.pkgID = syms[mSym].pkgID
							if nodes[fnDecl].b != 0 {
								child.bindLocal(nodes[nodes[fnDecl].b].a, av, vals[av].typeID)
							}
							sig := nodes[nodes[fnDecl].c]
							if sig.d >= 1 {
								pnode := nodes[listPool[sig.c]]
								child.bindLocal(pnode.a, scSlice, makeSliceType(TYU8))
							}
							child.execBlock(nodes[fnDecl].d)
							ct.fuel = child.fuel
							if !child.failed && child.retVal != 0 && vals[child.retVal].kind == VKInt {
								rn := usize(vals[child.retVal].u64Val)
								if rn > 64 {
									rn = 64
								}
								for j := usize(0); j < rn; j++ {
									ev := valList[vals[scArr].a+u32(j)]
									ftmp[j] = byte(vals[ev].u64Val)
								}
								flen = rn
							}
						}
					}
				}
			}
			// Apply width & padding, truncating to dstCap
			var padN usize = 0
			if width > flen {
				padN = width - flen
			}
			var padCh byte = ' '
			if zeroPad && isNum && !leftAlign {
				padCh = '0'
			}
			if !leftAlign && padN > 0 {
				start := usize(0)
				if padCh == '0' && flen > 0 && ftmp[0] == '-' {
					if pos < dstCap {
						outBuf[pos] = '-'
						pos++
					}
					start = 1
				}
				for p := usize(0); p < padN; p++ {
					if pos < dstCap {
						outBuf[pos] = padCh
						pos++
					}
				}
				for j := start; j < flen; j++ {
					if pos < dstCap {
						outBuf[pos] = ftmp[j]
						pos++
					}
				}
			} else {
				for j := usize(0); j < flen; j++ {
					if pos < dstCap {
						outBuf[pos] = ftmp[j]
						pos++
					}
				}
				if leftAlign {
					for p := usize(0); p < padN; p++ {
						if pos < dstCap {
							outBuf[pos] = ' '
							pos++
						}
					}
				}
			}
		}
		if dstBase != 0 && vals[dstBase].kind == VKArray {
			for j := usize(0); j < pos; j++ {
				idx := dstLo + u32(j)
				if idx < vals[dstBase].b {
					valList[vals[dstBase].a+idx] = makeIntVal(u64(outBuf[j]), false, TYU8)
				}
			}
		}
		return makeIntVal(u64(pos), false, TYUsize)
	}
	if bid >= BFCodeBool && bid <= BFCodeString {
		ck := u32(bid-BFCodeBool) + CodeBool
		return newVal(Val{kind: VKCode, a: ck, b: 0})
	}
	if bid == BFCodeArray && argCount == 2 {
		lv := ct.evalExpr(listPool[argStart])
		ev := ct.evalExpr(listPool[argStart+1])
		if lv == 0 || ev == 0 || vals[lv].kind != VKInt || vals[ev].kind != VKCode {
			ct.failed = true
			return 0
		}
		return newVal(Val{kind: VKCode, a: CodeArray, b: vals[ev].b, c: ev, u64Val: vals[lv].u64Val})
	}
	if bid == BFCodeField && argCount == 2 {
		nv := ct.evalExpr(listPool[argStart])
		tv := ct.evalExpr(listPool[argStart+1])
		if nv == 0 || tv == 0 || vals[nv].kind != VKStr || vals[tv].kind != VKCode {
			ct.failed = true
			return 0
		}
		return newVal(Val{kind: VKField, a: vals[nv].a, b: tv})
	}
	if bid == BFCodeStruct {
		var fvs [64]u32
		var maxLvl u32 = 0
		for i := u32(0); i < argCount; i++ {
			fv := ct.evalExpr(listPool[argStart+i])
			if fv == 0 || vals[fv].kind != VKField {
				ct.failed = true
				return 0
			}
			fvs[i] = fv
			if vals[vals[fv].b].b > maxLvl {
				maxLvl = vals[vals[fv].b].b
			}
		}
		s, c := pushValList(fvs[:usize(argCount)])
		return newVal(Val{kind: VKCode, a: CodeStruct, b: maxLvl, c: s, d: c})
	}
	if bid == BFCodeUniv && argCount == 1 {
		lv := ct.evalExpr(listPool[argStart])
		if lv == 0 || vals[lv].kind != VKInt {
			ct.failed = true
			return 0
		}
		return newVal(Val{kind: VKCode, a: CodeBool, b: u32(vals[lv].u64Val) + 1})
	}
	_ = fileID
	_ = off
	ct.failed = true
	return 0
}

driver func (ct *CTFrame) execBlock(blkNode u32) {
	if blkNode == 0 || ct.failed {
		return
	}
	saved := ct.nVars
	b := nodes[blkNode]
	for i := u32(0); i < b.b; i++ {
		ct.execStmt(listPool[b.a+i])
		if ct.failed || ct.didReturn || ct.didBreak || ct.didCont {
			break
		}
	}
	ct.nVars = saved
}

driver func (ct *CTFrame) execStmt(n u32) {
	if n == 0 || ct.failed || !ct.tick() {
		return
	}
	nd := nodes[n]
	if nd.kind == NKBlock {
		ct.execBlock(n)
		return
	}
	if nd.kind == NKReturn {
		if nd.b > 0 {
			ct.retVal = ct.evalExpr(listPool[nd.a])
		}
		ct.didReturn = true
		return
	}
	if nd.kind == NKBreak {
		ct.didBreak = true
		return
	}
	if nd.kind == NKContinue {
		ct.didCont = true
		return
	}
	if nd.kind == NKDeclStmt {
		d := nodes[nd.a]
		if d.kind == NKVarDecl {
			ty := nodeType[nd.a]
			if ty == 0 && d.b != 0 {
				ty = resolveTypeNode(ct.pkgID, d.b)
			}
			var v u32 = 0
			if d.c != 0 {
				v = ct.evalExpr(d.c)
			} else {
				v = ctZeroVal(ty)
			}
			ct.bindLocal(d.a, v, ty)
		}
		return
	}
	if nd.kind == NKShortDecl {
		lim := nd.b
		if nd.d < lim {
			lim = nd.d
		}
		for i := u32(0); i < lim; i++ {
			lhs := nodes[listPool[nd.a+i]]
			v := ct.evalExpr(listPool[nd.c+i])
			if lhs.a != kwBlank {
				if idx, ok := ct.lookupLocal(lhs.a); ok {
					ct.varVals[idx] = v
				} else {
					ct.bindLocal(lhs.a, v, vals[v].typeID)
				}
			}
		}
		return
	}
	if nd.kind == NKAssign {
		lim := nd.b
		if nd.d < lim {
			lim = nd.d
		}
		for i := u32(0); i < lim; i++ {
			lhs := listPool[nd.a+i]
			rv := ct.evalExpr(listPool[nd.c+i])
			if ct.failed {
				return
			}
			if nd.op != TKAssign {
				lv := ct.evalExpr(lhs)
				if lv != 0 && rv != 0 && vals[lv].kind == VKInt && vals[rv].kind == VKInt {
					a := vals[lv].u64Val
					b := vals[rv].u64Val
					var res u64 = a
					if nd.op == TKAddAssign {
						res = a + b
					} else if nd.op == TKSubAssign {
						res = a - b
					} else if nd.op == TKMulAssign {
						res = a * b
					} else if nd.op == TKQuoAssign && b != 0 {
						res = a / b
					} else if nd.op == TKRemAssign && b != 0 {
						res = a % b
					} else if nd.op == TKAndAssign {
						res = a & b
					} else if nd.op == TKOrAssign {
						res = a | b
					} else if nd.op == TKXorAssign {
						res = a ^ b
					} else if nd.op == TKShlAssign {
						res = a << b
					} else if nd.op == TKShrAssign {
						res = a >> b
					}
					rv = makeIntVal(valMaskInt(res, vals[lv].typeID), vals[lv].flags != 0, vals[lv].typeID)
				}
			}
			ct.assignLValue(lhs, rv)
		}
		return
	}
	if nd.kind == NKIncDec {
		lv := ct.evalExpr(nd.a)
		if lv != 0 && vals[lv].kind == VKInt {
			v := vals[lv].u64Val
			if nd.op == TKInc {
				v++
			} else {
				v--
			}
			ct.assignLValue(nd.a, makeIntVal(valMaskInt(v, vals[lv].typeID), vals[lv].flags != 0, vals[lv].typeID))
		}
		return
	}
	if nd.kind == NKIf {
		saved := ct.nVars
		if nd.a != 0 {
			ct.execStmt(nd.a)
		}
		cv := ct.evalExpr(nd.b)
		if !ct.failed && cv != 0 && vals[cv].kind == VKBool {
			if vals[cv].a != 0 {
				ct.execBlock(nd.c)
			} else if nd.d != 0 {
				ct.execStmt(nd.d)
			}
		}
		ct.nVars = saved
		return
	}
	if nd.kind == NKFor {
		saved := ct.nVars
		if nd.a != 0 {
			ct.execStmt(nd.a)
		}
		driver for {
			if ct.failed || !ct.tick() {
				break
			}
			if nd.b != 0 {
				cv := ct.evalExpr(nd.b)
				if ct.failed || cv == 0 || vals[cv].kind != VKBool || vals[cv].a == 0 {
					break
				}
			}
			ct.execBlock(nd.d)
			if ct.didReturn {
				break
			}
			if ct.didBreak {
				ct.didBreak = false
				break
			}
			if ct.didCont {
				ct.didCont = false
			}
			if nd.c != 0 {
				ct.execStmt(nd.c)
			}
		}
		ct.nVars = saved
		return
	}
	if nd.kind == NKMatchStmt {
		sv := ct.evalExpr(nd.a)
		if sv == 0 {
			ct.failed = true
			return
		}
		for i := u32(0); i < nd.c; i++ {
			arm := nodes[listPool[nd.b+i]]
			saved := ct.nVars
			if ct.matchPat(arm.a, sv) {
				if nodes[arm.b].kind == NKBlock {
					ct.execBlock(arm.b)
				} else {
					ct.execStmt(arm.b)
				}
				ct.nVars = saved
				return
			}
			ct.nVars = saved
		}
		return
	}
	if nd.kind == NKExprStmt {
		_ = ct.evalExpr(nd.a)
		return
	}
}

driver func (ct *CTFrame) assignLValue(lhs u32, rv u32) {
	nd := nodes[lhs]
	if nd.kind == NKIdent {
		if nd.a == kwBlank {
			return
		}
		if idx, ok := ct.lookupLocal(nd.a); ok {
			ct.varVals[idx] = rv
		}
		return
	}
	if nd.kind == NKIndex {
		// Copy-on-write update of array element `arr[i] = rv`
		if nodes[nd.a].kind == NKIdent {
			if idx, ok := ct.lookupLocal(nodes[nd.a].a); ok {
				iv := ct.evalExpr(listPool[nd.b])
				av := ct.varVals[idx]
				if iv != 0 && av != 0 && vals[av].kind == VKArray && vals[iv].kind == VKInt {
					pos := vals[iv].u64Val
					if pos < u64(vals[av].b) {
						valList[vals[av].a+u32(pos)] = rv
					} else {
						addDiagStr(E4003, nd.fileID, nd.off, "comptime array index out of bounds")
						ct.failed = true
					}
				}
			}
		}
		return
	}
	if nd.kind == NKSelector {
		if nodes[nd.a].kind == NKIdent {
			if idx, ok := ct.lookupLocal(nodes[nd.a].a); ok {
				sv := ct.varVals[idx]
				if sv != 0 && vals[sv].kind == VKStruct {
					fi, _, found := findStructField(vals[sv].typeID, nd.b)
					if found && fi < vals[sv].b {
						valList[vals[sv].a+fi] = rv
					}
				}
			}
		}
	}
}

// evalConstExpr evaluates a standalone constant expression with full fuel budget.
driver func evalConstExpr(pkgID u32, exprNode u32, iotaVal u32) (u32, bool) {
	var ct CTFrame
	ct.fuel = comptimeFuelBudget
	ct.fileID = nodes[exprNode].fileID
	ct.callOff = nodes[exprNode].off
	ct.iotaVal = iotaVal
	ct.pkgID = pkgID
	v := ct.evalExpr(exprNode)
	if ct.failed || v == 0 {
		return 0, false
	}
	return v, true
}
