// comptime.fc — the fuel-bounded compile-time interpreter (port of finc0's
// bootstrap/internal/comptime, spec 5.3).
//
// callComptime is the types.Evaluator: it evaluates fn(args...) with a fresh
// fuel budget (an evaluation root) by interpreting the type-checked bodies
// through the typed model. Every loop iteration, call and index operation
// costs one unit; exhaustion is E4001 with a call stack. Recursion is also
// bounded by CtMaxDepth frames. finc0 unwinds failures with panic; here the
// first failure sets `ifail` (code + message) and every interpreter step
// returns as soon as it sees the flag, so the same first error is reported.
//
// Frames and variables live in global stacks. Each frame's variables are a
// range [vbase, nfv) of (symbol, cell slot) pairs; cells are heap value
// slots. Nested evaluation roots (a comptime call folded while the checker
// checks a body on behalf of the interpreter) save and restore the
// interpreter state, as finc0 creates a fresh interpreter per root.
package main

import "std/strconv"

const (
	DefaultFuel   = 1_000_000
	CtMaxDepth    = 10_000
	MaxFrames     = CtMaxDepth + 2
	MaxFrameVars  = 262_144
	CtlNone       = 0
	CtlBreak      = 1
	CtlContinue   = 2
	CtlReturn     = 3
	CtEval        = "comptime evaluation " // prefix of comptime diagnostics
	NotStruct     = "field access on non-struct value"
)

type Frame struct {
	fn     u32 // FuncInfo
	site   u32 // CallExpr in the caller (0 for the root)
	vbase  usize
	ret    Val
	hasRet bool
}

var frames [MaxFrames]Frame
var nframes usize
var fvSym [MaxFrameVars]u32
var fvSlot [MaxFrameVars]u32
var fvAddr [MaxFrameVars]bool
var nfv usize

// Reference stack for multi-assignments.
var rstack [MaxOpStack]u32
var rtop usize

// Interpreter state of the current evaluation root.
var evalFuel u64 = DefaultFuel // --comptime-fuel
var inFuel u64
var inBudget u64
var inBase usize // first frame of the current root

// Failure state.
var ifail bool
var ifailCode u32
var ifailMsg OutBuf

// failf fails with "comptime evaluation failed: " + mbuf[:k]; callers
// format the detail with formatTo(mbuf[:], ...).
func failf(code u32, k usize) {
	ifail = true
	ifailCode = code
	ifailMsg.Reset()
	ifailMsg.Extend(formatTo(ifailMsg.Spare(), CtEval+"failed: %s", mbuf[:k]))
}

func failS(code u32, s string) {
	failf(code, formatTo(mbuf[:], "%s", s))
}

// failErr reports the value error in errTxt.
func failErr(code u32) {
	failf(code, formatTo(mbuf[:], "%s", errTxt.Bytes()))
}

// failSilent is a failure that was already reported (EvalError{}).
func failSilent() {
	ifail = true
	ifailCode = 0
	ifailMsg.Reset()
}

// CallStack renders the call stack above frame `base`, innermost first,
// collapsing runs of identical frames.
type CallStack usize

func (base CallStack) Format(dst []byte) usize {
	k := formatTo(dst, "call stack (innermost first): ")
	b := usize(base)
	if nframes <= b {
		return k
	}
	i := nframes - 1
	first := true
	for g := usize(0); g < MaxFrames; g++ {
		f := frames[i]
		if !first {
			k += formatTo(dst[k:], " <- ")
		}
		first = false
		k += formatTo(dst[k:], "%v", FuncName(f.fn))
		if f.site != 0 {
			k += formatTo(dst[k:], " called at %v", PosRef(f.site))
		}
		j := i
		for h := usize(0); h < MaxFrames; h++ {
			if j == b || frames[j-1].fn != f.fn || frames[j-1].site != f.site {
				break
			}
			j--
		}
		cnt := i - j + 1
		if cnt > 1 {
			k += formatTo(dst[k:], " (x%d)", cnt)
		}
		if j == b {
			break
		}
		i = j - 1
	}
	return k
}

func tick() {
	if ifail {
		return
	}
	if inFuel == 0 {
		ifail = true
		ifailCode = E4001
		ifailMsg.Reset()
		ifailMsg.Extend(formatTo(ifailMsg.Spare(), CtEval+"ran out of fuel (budget %d steps); %v", inBudget, CallStack(inBase)))
		return
	}
	inFuel--
}

// callComptime evaluates fn(vstack[argMark:vtop]) as a new evaluation root.
// On failure it returns false; ifailCode (0 = already reported) and
// ifailMsg describe the error.
func callComptime(fn u32, argMark usize, dp usize) (Val, bool) decreases(dp) {
	var z Val
	if dp == 0 {
		tooDeep()
		return z, false
	}
	saveFuel := inFuel
	saveBudget := inBudget
	saveBase := inBase
	inFuel = evalFuel
	inBudget = evalFuel
	inBase = nframes
	ifail = false
	ifailCode = 0
	hmark := vals.htop
	r := icall(fn, z, false, argMark, vtop, 0, dp-1)
	ok := !ifail
	if ok {
		r = persistVal(r, SemaDepth)
	}
	nframes = inBase
	vals.htop = hmark
	inFuel = saveFuel
	inBudget = saveBudget
	inBase = saveBase
	ifail = false
	return r, ok
}

// topBase returns the variable base of the current frame.
func topBase() usize {
	if nframes == 0 {
		return 0
	}
	return frames[nframes-1].vbase
}

// defineIn binds sym to a fresh cell holding a copy of v in the frame whose
// variables start at base.
func defineIn(base usize, sym u32, v Val) {
	if sym == 0 || symName(sym) == nameBlank {
		return
	}
	cv := copyV(v)
	top := nfv
	for k := usize(0); k < top-base; k++ {
		i := top - 1 - k
		if fvSym[i] == sym {
			if !fvAddr[i] {
				slotSet(fvSlot[i], cv)
				return
			}
			break
		}
	}
	if nfv >= MaxFrameVars {
		setFull("comptime variables")
		failSilent()
		return
	}
	s := valAlloc(1, true)
	if s == 0 {
		failSilent()
		return
	}
	slotSet(s, cv)
	fvSym[nfv] = sym
	fvSlot[nfv] = s
	fvAddr[nfv] = false
	nfv++
}

func define(sym u32, v Val) {
	defineIn(topBase(), sym, v)
}

// lookupVar returns the index of sym in the current frame (or -1 via ok).
func lookupVar(sym u32) (usize, bool) {
	base := topBase()
	top := nfv
	for k := usize(0); k < top-base; k++ {
		i := top - 1 - k
		if fvSym[i] == sym {
			return i, true
		}
	}
	return 0, false
}

// lookupCell returns the cell slot of a variable (0 after a failure).
func lookupCell(sym u32, id u32) u32 {
	i, ok := lookupVar(sym)
	if ok {
		return fvSlot[i]
	}
	if symIsGlobal(sym) && symKind(sym) == SymVar {
		failf(E2002, formatTo(mbuf[:], "cannot read package variable %v at compile time", NameRef(symName(sym))))
		return 0
	}
	failf(E2002, formatTo(mbuf[:], "%s is not available at compile time", ntext(id)))
	return 0
}

// icall runs fn with an optional receiver and the arguments
// vstack[as:ae].
func icall(fn u32, recv Val, hasRecv bool, as usize, ae usize, site u32, dp usize) Val decreases(dp) {
	var z Val
	if dp == 0 {
		tooDeep()
		failSilent()
		return z
	}
	if !hostEnsureBody(fn, dp-1) {
		failSilent()
		return z
	}
	fi := funcOfSym(fn)
	if fi == 0 || funcs.items[usize(fi)].body == 0 {
		failf(E2002, formatTo(mbuf[:], "%v has no body", NameRef(symName(fn))))
		return z
	}
	if funcs.items[usize(fi)].effect == EffDriver {
		failf(E5001, formatTo(mbuf[:], "cannot call driver function %v at compile time", FuncName(fi)))
		return z
	}
	tick()
	if ifail {
		return z
	}
	if nframes-inBase >= CtMaxDepth || nframes >= MaxFrames {
		ifail = true
		ifailCode = E4001
		ifailMsg.Reset()
		ifailMsg.Extend(formatTo(ifailMsg.Spare(), CtEval+"exceeded the maximum call depth (%d); %v", CtMaxDepth, CallStack(inBase)))
		return z
	}
	vbase := nfv
	rs := funcs.items[usize(fi)].recvSym
	if rs != 0 && hasRecv {
		defineIn(vbase, rs, recv)
	}
	sig := funcs.items[usize(fi)].sig
	ps := funcs.items[usize(fi)].parS
	np := usize(funcs.items[usize(fi)].parN)
	nargs := ae - as
	if sigVariadic(sig) && np > 0 && nargs+1 >= np {
		nrest := nargs - (np - 1)
		st := valAlloc(nrest, true)
		for i := usize(0); i < nrest; i++ {
			slotSet(st+u32(i), copyV(vstack[as+np-1+i]))
		}
		for i := usize(0); i < np-1; i++ {
			defineIn(vbase, defs[usize(uat(ps, i))], vstack[as+i])
		}
		defineIn(vbase, defs[usize(uat(ps, np-1))], sliceOver(st, nrest))
	} else {
		for i := usize(0); i < np; i++ {
			if i < nargs {
				defineIn(vbase, defs[usize(uat(ps, i))], vstack[as+i])
			}
		}
	}
	if ifail {
		nfv = vbase
		return z
	}
	var f Frame
	f.fn = fi
	f.site = site
	f.vbase = vbase
	frames[nframes] = f
	nframes++
	_ = iblock(funcs.items[usize(fi)].body, dp-1)
	nframes--
	ret := frames[nframes].ret
	hasRet := frames[nframes].hasRet
	nfv = vbase
	if ifail {
		return z
	}
	if sigNResults(sig) > 0 && !hasRet {
		failf(E2002, formatTo(mbuf[:], "%v finished without returning a value", FuncName(fi)))
		return z
	}
	return ret
}

// ---------------------------------------------------------------------------
// Statements

func iblock(bl u32, dp usize) u8 decreases(dp) {
	if dp == 0 {
		tooDeep()
		failSilent()
		return CtlReturn
	}
	if bl == 0 {
		return CtlNone
	}
	n := l1len(bl)
	for i := usize(0); i < n; i++ {
		c := istmt(l1at(bl, i), dp-1)
		if ifail {
			return CtlReturn
		}
		if c != CtlNone {
			return c
		}
	}
	return CtlNone
}

// evalList pushes n values of the expression list l2 of s onto vstack.
func evalList(s u32, n usize, dp usize) decreases(dp) {
	if dp == 0 {
		tooDeep()
		failSilent()
		return
	}
	ne2 := l2len(s)
	if ne2 == 1 && n > 1 {
		v := ieval(l2at(s, 0), dp-1)
		if ifail {
			return
		}
		if v is Tuple(ref, nt) && usize(nt) == n {
			for i := usize(0); i < n; i++ {
				vpush(slotGet(ref + u32(i)))
			}
			return
		}
		failf(E2002, formatTo(mbuf[:], "expected %d values", n))
		return
	}
	for i := usize(0); i < ne2; i++ {
		v := ieval(l2at(s, i), dp-1)
		if ifail {
			return
		}
		vpush(v)
	}
}

func asgBinOp(op u8) u8 {
	return match op { AsgSub -> OpSub, AsgMul -> OpMul, AsgQuo -> OpDiv, _ -> OpAdd }
}

func istmt(s u32, dp usize) u8 decreases(dp) {
	if dp == 0 {
		tooDeep()
		failSilent()
		return CtlReturn
	}
	if s == 0 {
		return CtlNone
	}
	k := nkind(s)
	if k == NkBlockStmt {
		return iblock(s, dp-1)
	}
	if k == NkDeclStmt {
		d := na(s)
		if nkind(d) == NkConstDecl {
			n := l1len(d)
			for i := usize(0); i < n; i++ {
				sym := defs[usize(na(l1at(d, i)))]
				if sym != 0 {
					var v Val
					if syms.items[usize(sym)].val != 0 {
						v = slotGet(syms.items[usize(sym)].val)
					}
					define(sym, v)
				}
			}
		} else if nkind(d) == NkVarDecl {
			sym := defs[usize(na(d))]
			var v Val
			if nc(d) != 0 {
				v = ieval(nc(d), dp-1)
			} else {
				t := u32(0)
				if sym != 0 {
					t = syms.items[usize(sym)].typ
				}
				v = izero(t)
			}
			if ifail {
				return CtlReturn
			}
			define(sym, v)
		}
		return CtlNone
	}
	if k == NkShortVarDecl {
		nn := l1len(s)
		m := vtop
		evalList(s, nn, dp-1)
		if ifail {
			vtop = m
			return CtlReturn
		}
		for i := usize(0); i < nn; i++ {
			id := l1at(s, i)
			if isBlank(id) {
				continue
			}
			v := vstack[m+i]
			if defs[usize(id)] != 0 {
				define(defs[usize(id)], v)
			} else if uses[usize(id)] != 0 {
				c := lookupCell(uses[usize(id)], id)
				if ifail {
					vtop = m
					return CtlReturn
				}
				slotSet(c, copyV(v))
			}
		}
		vtop = m
		return CtlNone
	}
	if k == NkAssignStmt {
		if nop(s) != AsgAssign {
			l0 := l1at(s, 0)
			r := ilvalue(l0, dp-1)
			if ifail {
				return CtlReturn
			}
			y := ieval(l2at(s, 0), dp-1)
			if ifail {
				return CtlReturn
			}
			v := iarith(asgBinOp(nop(s)), slotGet(r), y, ntype[usize(l0)])
			if ifail {
				return CtlReturn
			}
			slotSet(r, v)
			return CtlNone
		}
		nl := l1len(s)
		rm := rtop
		for i := usize(0); i < nl; i++ {
			l := l1at(s, i)
			ref := u32(0)
			if !(nkind(l) == NkIdent && isBlank(l)) {
				ref = ilvalue(l, dp-1)
				if ifail {
					rtop = rm
					return CtlReturn
				}
			}
			if rtop < MaxOpStack {
				rstack[rtop] = ref
				rtop++
			}
		}
		m := vtop
		evalList(s, nl, dp-1)
		if ifail {
			vtop = m
			rtop = rm
			return CtlReturn
		}
		for i := usize(0); i < nl; i++ {
			ref := rstack[rm+i]
			if ref != 0 {
				slotSet(ref, copyV(vstack[m+i]))
			}
		}
		vtop = m
		rtop = rm
		return CtlNone
	}
	if k == NkIncDecStmt {
		x := na(s)
		r := ilvalue(x, dp-1)
		if ifail {
			return CtlReturn
		}
		op := u8(OpAdd)
		if !nflag(s) {
			op = OpSub
		}
		v := iarith(op, slotGet(r), vIntU(1), ntype[usize(x)])
		if ifail {
			return CtlReturn
		}
		slotSet(r, v)
		return CtlNone
	}
	if k == NkExprStmt {
		_ = ieval(na(s), dp-1)
		return CtlNone
	}
	if k == NkReturnStmt {
		fr := nframes - 1
		nr := l1len(s)
		fi := frames[fr].fn
		if nr == 0 {
			return CtlReturn
		}
		if nr == 1 && sigNResults(funcs.items[usize(fi)].sig) > 1 {
			v := ieval(l1at(s, 0), dp-1)
			if ifail {
				return CtlReturn
			}
			frames[fr].ret = v
			frames[fr].hasRet = true
			return CtlReturn
		}
		if nr == 1 {
			v := ieval(l1at(s, 0), dp-1)
			if ifail {
				return CtlReturn
			}
			frames[fr].ret = copyV(v)
			frames[fr].hasRet = true
			return CtlReturn
		}
		m := vtop
		for i := usize(0); i < nr; i++ {
			v := ieval(l1at(s, i), dp-1)
			if ifail {
				vtop = m
				return CtlReturn
			}
			vpush(copyV(v))
		}
		st := valAlloc(nr, true)
		for i := usize(0); i < nr; i++ {
			slotSet(st+u32(i), vstack[m+i])
		}
		vtop = m
		frames[fr].ret = Val.Tuple(st, u32(nr))
		frames[fr].hasRet = true
		return CtlReturn
	}
	if k == NkIfStmt {
		c := istmt(na(s), dp-1)
		if ifail {
			return CtlReturn
		}
		if c != CtlNone {
			return c
		}
		b := icond(nb(s), dp-1)
		if ifail {
			return CtlReturn
		}
		if b {
			return iblock(nc(s), dp-1)
		}
		return istmt(nd(s), dp-1)
	}
	if k == NkForStmt {
		c := istmt(na(s), dp-1)
		if ifail {
			return CtlReturn
		}
		if c != CtlNone {
			return c
		}
		lim := inBudget + 2
		for g := u64(0); g < lim; g++ {
			if nb(s) != 0 {
				b := icond(nb(s), dp-1)
				if ifail {
					return CtlReturn
				}
				if !b {
					return CtlNone
				}
			}
			tick()
			if ifail {
				return CtlReturn
			}
			bc := iblock(ne(s), dp-1)
			if ifail {
				return CtlReturn
			}
			if bc == CtlBreak {
				return CtlNone
			}
			if bc == CtlReturn {
				return CtlReturn
			}
			_ = istmt(nc(s), dp-1)
			if ifail {
				return CtlReturn
			}
		}
		return CtlNone
	}
	if k == NkMatchStmt {
		return imatch(s, dp-1)
	}
	if k == NkBreakStmt {
		return CtlBreak
	}
	if k == NkContinueStmt {
		return CtlContinue
	}
	if k == NkDeferStmt {
		failS(E2002, "defer is not supported at compile time")
		return CtlReturn
	}
	if k == NkScopeStmt {
		failS(E2002, "scope is not supported at compile time")
		return CtlReturn
	}
	return CtlNone
}

func icond(e u32, dp usize) bool decreases(dp) {
	if dp == 0 {
		tooDeep()
		failSilent()
		return false
	}
	v := ieval(e, dp-1)
	if ifail {
		return false
	}
	if v is Bool(b) {
		return b
	}
	failS(E2002, "non-boolean condition")
	return false
}

func imatch(s u32, dp usize) u8 decreases(dp) {
	if dp == 0 {
		tooDeep()
		failSilent()
		return CtlReturn
	}
	x := iscrutinee(na(s), dp-1)
	if ifail {
		return CtlReturn
	}
	i := iselectArm(x, s, dp-1)
	if ifail {
		return CtlReturn
	}
	if i >= l1len(s) {
		return CtlNone
	}
	arm := l1at(s, i)
	if nb(arm) != 0 {
		_ = ieval(nb(arm), dp-1)
		return CtlNone
	}
	return iblock(nc(arm), dp-1)
}

// imatchExpr evaluates a match expression (v0.2).
func imatchExpr(e u32, dp usize) Val decreases(dp) {
	var z Val
	if dp == 0 {
		tooDeep()
		failSilent()
		return z
	}
	x := iscrutinee(na(e), dp-1)
	if ifail {
		return z
	}
	i := iselectArm(x, e, dp-1)
	if ifail {
		return z
	}
	if i >= l1len(e) {
		failS(E2002, "no match arm for the value")
		return z
	}
	a := nb(l1at(e, i))
	if nkind(a) == NkTupleExpr {
		// v0.3: a multi-value arm gives a Tuple of copies of its values
		return ivalueList(a, dp-1)
	}
	return ieval(a, dp-1)
}

// ivalueList evaluates the values of a multi-value match arm (v0.3) left
// to right into a Tuple value.
func ivalueList(e u32, dp usize) Val decreases(dp) {
	var z Val
	if dp == 0 {
		tooDeep()
		failSilent()
		return z
	}
	n := l1len(e)
	m := vtop
	for i := usize(0); i < n; i++ {
		v := ieval(l1at(e, i), dp-1)
		if ifail {
			vtop = m
			return z
		}
		vpush(copyV(v))
	}
	st := valAlloc(n, true)
	for i := usize(0); i < n; i++ {
		slotSet(st+u32(i), vstack[m+i])
	}
	vtop = m
	return Val.Tuple(st, u32(n))
}

// iscrutinee evaluates the scrutinee of a match (a tuple scrutinee to a
// Tuple value, v0.2).
func iscrutinee(e u32, dp usize) Val decreases(dp) {
	var z Val
	if dp == 0 {
		tooDeep()
		failSilent()
		return z
	}
	if nkind(e) != NkTupleExpr {
		return ieval(e, dp-1)
	}
	n := l1len(e)
	m := vtop
	for i := usize(0); i < n; i++ {
		v := ieval(l1at(e, i), dp-1)
		if ifail {
			vtop = m
			return z
		}
		vpush(v)
	}
	st := valAlloc(n, true)
	for i := usize(0); i < n; i++ {
		slotSet(st+u32(i), vstack[m+i])
	}
	vtop = m
	return Val.Tuple(st, u32(n))
}

// iselectArm returns the index of the first arm of match m whose pattern
// matches x and whose guard (evaluated after the bindings are defined)
// holds; the arm count if none.
func iselectArm(x Val, m u32, dp usize) usize decreases(dp) {
	n := l1len(m)
	if dp == 0 {
		tooDeep()
		failSilent()
		return n
	}
	for i := usize(0); i < n; i++ {
		arm := l1at(m, i)
		if !imatchPat(na(arm), x, SemaDepth) {
			continue
		}
		g := nd(arm)
		if g == 0 {
			return i
		}
		b := icond(g, dp-1)
		if ifail {
			return n
		}
		if b {
			return i
		}
	}
	return n
}

// imatchPat reports whether x matches the checked pattern p, defining the
// bindings of the matching pattern (finc0's types.MatchValue).
func imatchPat(p u32, x Val, depth usize) bool decreases(depth) {
	if depth == 0 || p == 0 {
		return false
	}
	k := nkind(p)
	if k is NkWildcardPattern | NkRestPattern {
		return true
	}
	if k == NkIdent {
		if nvarEnum[usize(p)] != 0 {
			return x is Enum(vi, ..) && vi == nvarIdx[usize(p)]
		}
		cs := patConst(p)
		if cs != 0 {
			return valsEqual(x, slotGet(cs))
		}
		if !isBlank(p) && defs[usize(p)] != 0 {
			define(defs[usize(p)], x)
		}
		return true
	}
	if k == NkCtorPattern {
		bsym := patBindSym(p)
		if nvarEnum[usize(p)] == 0 {
			cs := patConst(p)
			if cs != 0 {
				return valsEqual(x, slotGet(cs))
			}
			if bsym != 0 {
				define(bsym, x) // v0.2: a top-level or tuple-element binding
			}
			return true
		}
		if !(x is Enum(vi, ps, _)) || vi != nvarIdx[usize(p)] {
			return false
		}
		if bsym != 0 {
			define(bsym, x)
		}
		np := variantPayN(nvarEnum[usize(p)], usize(nvarIdx[usize(p)]))
		c := l1len(p)
		for i := usize(0); i < c; i++ {
			a := l1at(p, i)
			if nkind(a) == NkRestPattern {
				continue
			}
			if !imatchPat(a, slotGet(ps+u32(payloadIndex(p, i, np))), depth-1) {
				return false
			}
		}
		return true
	}
	if k == NkLiteralPattern {
		s := nval[usize(na(p))]
		return s != 0 && valsEqual(x, slotGet(s))
	}
	if k == NkAtPattern {
		if !imatchPat(nb(p), x, depth-1) {
			return false
		}
		if defs[usize(na(p))] != 0 {
			define(defs[usize(na(p))], x) // v0.2: `x @ P`
		}
		return true
	}
	if k == NkOrPattern {
		c := l1len(p)
		for i := usize(0); i < c; i++ {
			if imatchPat(l1at(p, i), x, depth-1) {
				return true
			}
		}
		return false
	}
	if k != NkTuplePattern || !(x is Tuple(ref, tn)) || usize(tn) != l1len(p) {
		return false
	}
	for i := u32(0); i < tn; i++ {
		if !imatchPat(l1at(p, usize(i)), slotGet(ref+i), depth-1) {
			return false
		}
	}
	return true
}

func izero(t u32) Val {
	var z Val
	if t == 0 {
		failS(E2002, "unknown type")
		return z
	}
	if isPointerT(underlying(t)) {
		return Val.Ptr(0)
	}
	v, ok := zeroVal(t, true)
	if !ok {
		failErr(E2002)
		return z
	}
	return v
}

// ---------------------------------------------------------------------------
// Expressions

func iderefSlot(v Val) u32 {
	if v is Ptr(r) && r != 0 {
		return r
	}
	failS(E2002, "nil pointer dereference")
	return 0
}

func iarith(op u8, x Val, y Val, t u32) Val {
	v, ok := binaryOpVal(op, x, y)
	if !ok {
		failErr(E2002)
		return v
	}
	return wrapVal(v, t)
}

// intArg evaluates an index (0..1<<40).
func intArg(e u32, dp usize) usize decreases(dp) {
	if dp == 0 {
		tooDeep()
		failSilent()
		return 0
	}
	v := ieval(e, dp-1)
	if ifail {
		return 0
	}
	if !(v is Int(hi, lo)) || !((hi == 0 && lo < SignBit) || (hi == AllOnes && lo >= SignBit)) {
		failS(E4003, "invalid index")
		return 0
	}
	if hi != 0 || lo > 1<<40 {
		failf(E4003, formatTo(mbuf[:], "index %v out of range", ValRef(v)))
		return 0
	}
	return usize(lo)
}

func failIndexRange(i usize, n usize) {
	failf(E4003, formatTo(mbuf[:], "index %d out of range [0:%d]", i, n))
}

// indexRef returns the slot of element i of an array or slice value.
func indexRef(x Val, i usize) u32 {
	match x {
		Array(ref, n) -> return elemRef(ref, usize(n), i)
		Slice(ref, lo, hi, _) -> return elemRef(ref+lo, usize(hi-lo), i)
		NilSlice -> return elemRef(0, 0, i)
		_ -> {}
	}
	failf(E2002, formatTo(mbuf[:], "cannot index value %v", ValRef(x)))
	return 0
}

// elemRef returns the slot of element i of the n elements at ref.
func elemRef(ref u32, n usize, i usize) u32 {
	if i >= n {
		failIndexRange(i, n)
		return 0
	}
	return ref + u32(i)
}

func ieval(e u32, dp usize) Val decreases(dp) {
	var z Val
	if dp == 0 {
		tooDeep()
		failSilent()
		return z
	}
	if nbytes[usize(e)] {
		// a constant string used as []byte: a fresh copy (v0.2)
		return byteSliceVal(strOf(slotGet(nval[usize(e)])))
	}
	if nval[usize(e)] != 0 {
		return slotGet(nval[usize(e)])
	}
	k := nkind(e)
	if k == NkParenExpr {
		return ieval(na(e), dp-1)
	}
	if k == NkIdent {
		sym := symbolOf(e)
		if sym == 0 {
			failf(E2002, formatTo(mbuf[:], "unresolved identifier %s", ntext(e)))
			return z
		}
		sk := symKind(sym)
		if sk == SymConst {
			vs := hostConstValue(sym, dp-1)
			if vs != 0 {
				return slotGet(vs)
			}
			failSilent()
			return z
		}
		if sk == SymVar {
			c := lookupCell(sym, e)
			if ifail {
				return z
			}
			return slotGet(c)
		}
		failf(E2002, formatTo(mbuf[:], "%s cannot be used as a value at compile time", ntext(e)))
		return z
	}
	if k == NkBinaryExpr {
		op := nop(e)
		if op is OpLAnd | OpLOr {
			a := icond(na(e), dp-1)
			if ifail {
				return z
			}
			if op == OpLAnd && !a {
				return vBool(false)
			}
			if op == OpLOr && a {
				return vBool(true)
			}
			b := icond(nb(e), dp-1)
			return vBool(b)
		}
		x := ieval(na(e), dp-1)
		if ifail {
			return z
		}
		y := ieval(nb(e), dp-1)
		if ifail {
			return z
		}
		if isCompareOp(op) {
			v, ok := binaryOpVal(op, x, y)
			if !ok {
				failErr(E2002)
				return z
			}
			return v
		}
		return iarith(op, x, y, ntype[usize(e)])
	}
	if k == NkUnaryExpr {
		op := nop(e)
		if op == OpAddr {
			r := ilvalue(na(e), dp-1)
			if ifail {
				return z
			}
			markAddr(na(e), r)
			return Val.Ptr(r)
		}
		if op == OpDeref {
			v := ieval(na(e), dp-1)
			if ifail {
				return z
			}
			r := iderefSlot(v)
			if ifail {
				return z
			}
			return slotGet(r)
		}
		x := ieval(na(e), dp-1)
		if ifail {
			return z
		}
		v, ok := unaryOpVal(op, x)
		if !ok {
			failErr(E2002)
			return z
		}
		return wrapVal(v, ntype[usize(e)])
	}
	if k == NkCallExpr {
		return icallExpr(e, dp-1)
	}
	if k == NkIndexExpr {
		x := ieval(na(e), dp-1)
		if ifail {
			return z
		}
		i := intArg(l1at(e, 0), dp-1)
		if ifail {
			return z
		}
		tick()
		if ifail {
			return z
		}
		if x is Ptr(_) {
			r := iderefSlot(x)
			if ifail {
				return z
			}
			s := indexRef(slotGet(r), i)
			if ifail {
				return z
			}
			return slotGet(s)
		}
		if x is Str(off, n) {
			if i >= usize(n) {
				failIndexRange(i, usize(n))
				return z
			}
			return vIntU(u64(strSpan(off, n)[i]))
		}
		s := indexRef(x, i)
		if ifail {
			return z
		}
		return slotGet(s)
	}
	if k == NkSliceExpr {
		return islice(e, dp-1)
	}
	if k == NkSelectorExpr {
		sel := nsel[usize(e)]
		if sel == 0 || selTab.items[usize(sel)].kind != SelField {
			if uses[usize(nb(e))] != 0 {
				return ieval(nb(e), dp-1)
			}
			failf(E2002, formatTo(mbuf[:], "unsupported selector %s at compile time", ntext(nb(e))))
			return z
		}
		x := ieval(na(e), dp-1)
		if ifail {
			return z
		}
		if x is Ptr(_) {
			r := iderefSlot(x)
			if ifail {
				return z
			}
			x = slotGet(r)
		}
		if x is Struct(ref, _) {
			return slotGet(ref + selTab.items[usize(sel)].index)
		}
		failS(E2002, NotStruct)
		return z
	}
	if k == NkStructLit {
		t := ntype[usize(e)]
		sv := izero(t)
		if ifail {
			return z
		}
		if !(sv is Struct(ref, _)) {
			failS(E2002, "invalid struct literal")
			return z
		}
		st := underlying(t)
		n := l1len(e)
		for i := usize(0); i < n; i++ {
			fi := l1at(e, i)
			idx, found := fieldByName(st, idName(na(fi)))
			if found {
				v := ieval(nb(fi), dp-1)
				if ifail {
					return z
				}
				slotSet(ref+u32(idx), copyV(v))
			}
		}
		return sv
	}
	if k == NkFuncLit {
		failS(E2002, "function literals are not supported at compile time")
		return z
	}
	if k == NkMatchExpr {
		return imatchExpr(e, dp-1)
	}
	if k == NkIsExpr {
		x := ieval(na(e), dp-1)
		if ifail {
			return z
		}
		return Val.Bool(imatchPat(nb(e), x, SemaDepth))
	}
	failS(E2002, "unsupported expression at compile time")
	return z
}

// markAddr records that the cell of a local variable has its address taken
// (so a redefinition allocates a new cell, as finc0 does).
func markAddr(x u32, r u32) {
	u := unparen(x)
	if nkind(u) != NkIdent {
		return
	}
	sym := symbolOf(u)
	i, ok := lookupVar(sym)
	if ok && fvSlot[i] == r {
		fvAddr[i] = true
	}
}

func ilvalue(e u32, dp usize) u32 decreases(dp) {
	if dp == 0 {
		tooDeep()
		failSilent()
		return 0
	}
	k := nkind(e)
	if k == NkParenExpr {
		return ilvalue(na(e), dp-1)
	}
	if k == NkIdent {
		sym := symbolOf(e)
		if sym == 0 || symKind(sym) != SymVar {
			failf(E2002, formatTo(mbuf[:], "cannot assign to %s", ntext(e)))
			return 0
		}
		return lookupCell(sym, e)
	}
	if k == NkIndexExpr {
		x := na(e)
		var base Val
		v := ieval(x, dp-1)
		if ifail {
			return 0
		}
		if v is Ptr(_) {
			r := iderefSlot(v)
			if ifail {
				return 0
			}
			base = slotGet(r)
		} else if isSliceT(underlying(ntype[usize(x)])) {
			base = ieval(x, dp-1)
		} else {
			r := ilvalue(x, dp-1)
			if ifail {
				return 0
			}
			base = slotGet(r)
		}
		if ifail {
			return 0
		}
		i := intArg(l1at(e, 0), dp-1)
		if ifail {
			return 0
		}
		tick()
		if ifail {
			return 0
		}
		return indexRef(base, i)
	}
	if k == NkSelectorExpr {
		sel := nsel[usize(e)]
		if sel == 0 || selTab.items[usize(sel)].kind != SelField {
			failf(E2002, formatTo(mbuf[:], "cannot assign to %s", ntext(nb(e))))
			return 0
		}
		var base Val
		if selTab.items[usize(sel)].indirect {
			v := ieval(na(e), dp-1)
			if ifail {
				return 0
			}
			r := iderefSlot(v)
			if ifail {
				return 0
			}
			base = slotGet(r)
		} else {
			r := ilvalue(na(e), dp-1)
			if ifail {
				return 0
			}
			base = slotGet(r)
		}
		if base is Struct(ref, _) {
			return ref + selTab.items[usize(sel)].index
		}
		failS(E2002, NotStruct)
		return 0
	}
	if k == NkUnaryExpr && nop(e) == OpDeref {
		v := ieval(na(e), dp-1)
		if ifail {
			return 0
		}
		return iderefSlot(v)
	}
	failS(E2002, "expression is not addressable at compile time")
	return 0
}

func failSliceBounds(lo usize, hi usize, n usize) {
	failf(E4003, formatTo(mbuf[:], "slice bounds [%d:%d] out of range [0:%d]", lo, hi, n))
}

func islice(e u32, dp usize) Val decreases(dp) {
	var z Val
	if dp == 0 {
		tooDeep()
		failSilent()
		return z
	}
	xe := na(e)
	var x Val
	if isArrayT(underlying(ntype[usize(xe)])) {
		r := ilvalue(xe, dp-1)
		if ifail {
			return z
		}
		x = slotGet(r)
	} else {
		x = ieval(xe, dp-1)
	}
	if ifail {
		return z
	}
	if x is Ptr(_) {
		r := iderefSlot(x)
		if ifail {
			return z
		}
		x = slotGet(r)
	}
	lo := usize(0)
	hi := usize(0)
	hasHi := false
	if nb(e) != 0 {
		lo = intArg(nb(e), dp-1)
		if ifail {
			return z
		}
	}
	if nc(e) != 0 {
		hi = intArg(nc(e), dp-1)
		if ifail {
			return z
		}
		hasHi = true
	}
	match x {
		Str(off, sn) -> {
			n := usize(sn)
			if !hasHi {
				hi = n
			}
			if lo > hi || hi > n {
				failSliceBounds(lo, hi, n)
				return z
			}
			return Val.Str(off+u32(lo), u32(hi-lo))
		}
		Array(ref, an) -> {
			n := usize(an)
			if !hasHi {
				hi = n
			}
			if lo > hi || hi > n {
				failSliceBounds(lo, hi, n)
				return z
			}
			return Val.Slice(ref, u32(lo), u32(hi), u64(n))
		}
		Slice(ref, slo, shi, alen) -> {
			capn := usize(alen) - usize(slo)
			if !hasHi {
				hi = usize(shi - slo)
			}
			if lo > hi || hi > capn {
				failSliceBounds(lo, hi, capn)
				return z
			}
			return Val.Slice(ref, slo+u32(lo), slo+u32(hi), alen)
		}
		NilSlice -> {
			if lo > hi || hi > 0 {
				failSliceBounds(lo, hi, 0)
				return z
			}
			return x
		}
		_ -> {}
	}
	failS(E2002, "cannot slice value")
	return z
}

// ---------------------------------------------------------------------------
// Calls

// iargs pushes the argument values of a call onto vstack.
func iargs(e u32, dp usize) decreases(dp) {
	if dp == 0 {
		tooDeep()
		failSilent()
		return
	}
	n := l1len(e)
	if n == 1 {
		a0 := l1at(e, 0)
		t := ntype[usize(a0)]
		if isTupleT(t) {
			v := ieval(a0, dp-1)
			if ifail {
				return
			}
			if v is Tuple(ref, m) {
				for i := u32(0); i < m; i++ {
					vpush(slotGet(ref + i))
				}
			}
			return
		}
	}
	for i := usize(0); i < n; i++ {
		v := ieval(l1at(e, i), dp-1)
		if ifail {
			return
		}
		vpush(v)
	}
}

func icallExpr(e u32, dp usize) Val decreases(dp) {
	var z Val
	if dp == 0 {
		tooDeep()
		failSilent()
		return z
	}
	ci := ncall[usize(e)]
	if ci == 0 {
		failS(E2002, "unchecked call")
		return z
	}
	match callTab.items[usize(ci)].kind {
		Func(sym, ..) -> {
			m := vtop
			iargs(e, dp-1)
			if ifail {
				vtop = m
				return z
			}
			r := icall(sym, z, false, m, vtop, e, dp-1)
			vtop = m
			return r
		}
		Method(sym, mi, rx, autoAddr) -> {
			var recv Val
			if autoAddr {
				// x.M() means (&x).M() (v0.2)
				r := ilvalue(rx, dp-1)
				if ifail {
					return z
				}
				markAddr(rx, r)
				recv = Val.Ptr(r)
			} else {
				recv = ieval(rx, dp-1)
			}
			if ifail {
				return z
			}
			// the receiver type (*T for x.M() with autoAddr) is a pointer
			ptr := meths.items[usize(mi)].ptrRecv && (autoAddr || isPointerT(ntype[usize(rx)]))
			if !ptr && recv is Ptr(_) {
				r := iderefSlot(recv)
				if ifail {
					return z
				}
				recv = slotGet(r)
			}
			m := vtop
			iargs(e, dp-1)
			if ifail {
				vtop = m
				return z
			}
			r := icall(sym, recv, true, m, vtop, e, dp-1)
			vtop = m
			return r
		}
		Conversion(t) -> {
			v := ieval(l1at(e, 0), dp-1)
			if ifail {
				return z
			}
			return wrapVal(v, t)
		}
		Variant(_, vi) -> {
			m := vtop
			iargs(e, dp-1)
			if ifail {
				vtop = m
				return z
			}
			n := vtop - m
			st := valAlloc(n, true)
			for i := usize(0); i < n; i++ {
				slotSet(st+u32(i), copyV(vstack[m+i]))
			}
			vtop = m
			return Val.Enum(vi, st, u32(n))
		}
		Builtin(b, ..) -> return ibuiltin(e, b, dp-1)
		BuiltinMeth(..) -> failS(E2002, "builtin-method calls are not supported at compile time")
		Value -> failS(E2002, "value calls are not supported at compile time")
		Invalid -> failS(E2002, "invalid calls are not supported at compile time")
	}
	return z
}

// bytesOfSlice copies the bytes of a []byte value into tmpBuf.
func bytesOfSlice(v Val) bool {
	if !isSliceVal(v) {
		failS(E2002, "expected a byte slice")
		return false
	}
	tmpBuf.Reset()
	ref, n := sliceElems(v)
	for i := u32(0); i < n; i++ {
		tmpBuf.WriteByte(byte(intLo(slotGet(ref + i))))
	}
	return true
}

func byteSliceVal(b []byte) Val {
	n := len(b)
	st := valAlloc(n, true)
	for i := usize(0); i < n; i++ {
		slotSet(st+u32(i), vIntU(u64(b[i])))
	}
	return sliceOver(st, n)
}

func tuple2(a Val, b Val) Val {
	st := valAlloc(2, true)
	slotSet(st, a)
	slotSet(st+1, b)
	return Val.Tuple(st, 2)
}

func icode(v Val) bool {
	if !isCodeVal(v) {
		failS(E2002, "expected a Code value")
		return false
	}
	return true
}

func ibuiltin(e u32, b u8, dp usize) Val decreases(dp) {
	var z Val
	if dp == 0 {
		tooDeep()
		failSilent()
		return z
	}
	m := vtop
	iargs(e, dp-1)
	if ifail {
		vtop = m
		return z
	}
	if b == BFFormatTo {
		rf := iformatTo(e, m, dp-1)
		vtop = m
		return rf
	}
	r := ibuiltin0(b, m)
	vtop = m
	return r
}

func ibuiltin0(b u8, m usize) Val {
	var z Val
	if b is BFLen | BFCap {
		x := vstack[m]
		if x is Ptr(_) {
			r := iderefSlot(x)
			if ifail {
				return z
			}
			x = slotGet(r)
		}
		match (b, x) {
			(_, Str(_, n) | Array(_, n)) -> return vIntU(u64(n))
			(BFCap, Slice(_, lo, _, alen)) -> return vIntU(alen - u64(lo))
			(_, Slice(_, lo, hi, _)) -> return vIntU(u64(hi - lo))
			(_, NilSlice) -> return vIntU(0)
			_ -> {}
		}
	} else if b is BFMin | BFMax {
		// v0.3: the first least (greatest) operand.
		r := vstack[m]
		n := vtop - m
		op := u8(OpLt)
		if b == BFMax {
			op = OpGt
		}
		for i := usize(1); i < n; i++ {
			c, ok := compareVals(op, vstack[m+i], r)
			if !ok {
				failS(E2002, "cannot compare the operands of min/max")
				return z
			}
			if c is Bool(true) {
				r = vstack[m+i]
			}
		}
		return r
	} else if b == BFCopy {
		d := vstack[m]
		s := vstack[m+1]
		if isSliceVal(d) && isSliceVal(s) {
			dref, dn := sliceElems(d)
			sref, sn := sliceElems(s)
			n := usize(dn)
			if usize(sn) < n {
				n = usize(sn)
			}
			tmp := valAlloc(n, true)
			for i := usize(0); i < n; i++ {
				slotSet(tmp+u32(i), copyV(slotGet(sref+u32(i))))
			}
			for i := usize(0); i < n; i++ {
				slotSet(dref+u32(i), slotGet(tmp+u32(i)))
			}
			return vIntU(u64(n))
		}
	} else if b == BFBytesEqual {
		x := vstack[m]
		y := vstack[m+1]
		if !isSliceVal(x) || !isSliceVal(y) {
			failS(E2002, "expected a byte slice")
			return z
		}
		xr, nx := sliceElems(x)
		yr, ny := sliceElems(y)
		if nx != ny {
			return vBool(false)
		}
		for i := u32(0); i < nx; i++ {
			if byte(intLo(slotGet(xr+i))) != byte(intLo(slotGet(yr+i))) {
				return vBool(false)
			}
		}
		return vBool(true)
	} else if b == BFStrBytes {
		return byteSliceVal(strOf(vstack[m]))
	} else if b == BFBytesToStr {
		if !bytesOfSlice(vstack[m]) {
			return z
		}
		return vStr(tmpBuf.Bytes())
	} else if b == BFFormatUint {
		u := intLo(vstack[m]) // a u64
		var db [24]byte
		nd, _ := formatUint(u, db[:])
		d := vstack[m+1]
		dref, room := sliceElems(d)
		if nd > usize(room) {
			return tuple2(vIntU(0), vErr(BCErrArenaFull))
		}
		for i := usize(0); i < nd; i++ {
			slotSet(dref+u32(i), vIntU(u64(db[i])))
		}
		return tuple2(vIntU(u64(nd)), vErr(0))
	} else if b == BFParseUint {
		if !bytesOfSlice(vstack[m]) {
			return z
		}
		v, okp := strconv.ParseUint(tmpBuf.Bytes(), 10)
		if !okp {
			return tuple2(vIntU(0), vErr(BCErrParse))
		}
		return tuple2(vIntU(v), vErr(0))
	} else if b == BFPanic {
		failf(E5001, formatTo(mbuf[:], "panic at compile time: %v", ValRef(vstack[m])))
		return z
	} else if b == BFCodeArray {
		n, _ := valUint64(vstack[m])
		if !icode(vstack[m+1]) {
			return z
		}
		el := valAlloc(1, true)
		slotSet(el, vstack[m+1])
		return Val.CodeArray(n, el)
	} else if b == BFCodeSlice {
		if !icode(vstack[m]) {
			return z
		}
		el := valAlloc(1, true)
		slotSet(el, vstack[m])
		return Val.CodeSlice(el)
	} else if b == BFCodeField {
		s := vstack[m]
		if !icode(vstack[m+1]) {
			return z
		}
		c := valAlloc(1, true)
		slotSet(c, vstack[m+1])
		return fieldCodeOf(s, c)
	} else if b == BFCodeStruct {
		sref, n := sliceElems(vstack[m])
		st := valAlloc(usize(n), true)
		for i := u32(0); i < n; i++ {
			f := slotGet(sref + i)
			if !(f is FieldCode(..)) {
				failS(E2002, "CodeStruct: zero FieldCode element")
				return z
			}
			slotSet(st+i, f)
		}
		return Val.CodeStruct(st, n)
	} else if b == BFCodeUniv {
		n, _ := valUint64(vstack[m])
		return Val.CodeUniv(n)
	} else if b >= BFCodeEmpty && b <= BFCodeI64 {
		return Val.CodeBasic(b - BFCodeEmpty)
	}
	failf(E2002, formatTo(mbuf[:], "builtin %s is not available at compile time", builtinName(b)))
	return z
}
