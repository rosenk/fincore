// values.fc — compile-time values (port of finc0's types/value.go).
//
// A Val is a small by-value record. Integers are exact 128-bit two's
// complement numbers (finc0 uses math/big; values outside ±2^127 are
// IntOvf, see README "Known gaps"). Aggregates (arrays, structs, enum
// payloads, tuples, code trees) live in the value-slot arena: a Val refers
// to its first element slot. The arena has two regions: the persistent
// region (values recorded in the typed model) and the comptime heap, which
// is reset after every evaluation root once the result has been copied
// into the persistent region (persistVal). Pointers at compile time are
// slot indices. String bytes live in strPool.
package main

const (
	VtabCap          = 1 << 20
	HeapCap          = 1 << 21
	MaxValSlots      = VtabCap + HeapCap
	MaxStrBytes      = 1 << 22
	MaxComptimeElems = 1 << 20
	MaxShift         = 1024
	SignBit          = 0x8000000000000000
	AllOnes          = 0xFFFFFFFFFFFFFFFF
)

// Code kinds of CodeBasic values (types.CodeKind up to CodeI64).
const (
	CKEmpty = 0
	CKUnit  = 1
	CKBool  = 2
	CKU8    = 3
	CKU16   = 4
	CKU32   = 5
	CKU64   = 6
	CKI8    = 7
	CKI16   = 8
	CKI32   = 9
	CKI64   = 10
)

// Val is a compile-time value. Aggregates refer to value slots: a run of
// consecutive slots starting at the first one. The variant order fixes the
// compact layout (bool, u8, 3 x u32, 2 x u64: 32 bytes), see docs/v0_2.md.
type Val enum {
	None                      // no value (the zero Val)
	Bool(bool)                //
	Err(u8)                   // sentinel error: builtin (0 = nil error)
	Nil                       // untyped nil
	Str(u32, u32)             // strPool offset, length
	Int(u64, u64)             // hi, lo: exact 128-bit two's complement
	IntOvf                    // an integer outside ±2^127
	Array(u32, u32)           // first element slot, length
	Slice(u32, u32, u32, u64) // backing array's first slot, lo, hi, array length
	NilSlice                  // a slice without backing array (nil)
	Struct(u32, u32)          // first field slot, field count
	Enum(u32, u32, u32)       // variant index, first payload slot, payload count
	Tuple(u32, u32)           // first element slot, count
	Ptr(u32)                  // target slot (0 = nil pointer)
	CodeBasic(u8)             // CKEmpty..CKI64
	CodeArray(u64, u32)       // length, slot of the element code
	CodeSlice(u32)            // slot of the element code
	CodeStruct(u32, u32)      // first FieldCode slot, field count
	CodeUniv(u64)             // universe level
	FieldCode(u32, u32, u32)  // name (strPool offset, length), slot of the code
}

type ValArena struct {
	items [MaxValSlots]Val
	ptop  usize // persistent region [1, VtabCap)
	htop  usize // heap region [VtabCap, MaxValSlots)
}

var vals ValArena

var strPool [MaxStrBytes]byte
var nstr usize

// errTxt receives the text of value-operation errors (Go's error values).
var errTxt OutBuf

func etReset() {
	errTxt.len = 0
	errTxt.full = false
}

func et(s string) {
	o := &errTxt
	o.putStr(s)
}

// valAlloc reserves n zeroed slots in the heap or persistent region and
// returns the first (0 if the region is full or n == 0).
func valAlloc(n usize, heap bool) u32 {
	if n == 0 {
		return 0
	}
	st := usize(0)
	if heap {
		if vals.htop < VtabCap {
			vals.htop = VtabCap
		}
		if vals.htop+n > MaxValSlots {
			setFull("comptime heap")
			return 0
		}
		st = vals.htop
		vals.htop = st + n
	} else {
		if vals.ptop == 0 {
			vals.ptop = 1
		}
		if vals.ptop+n > VtabCap {
			setFull("constant values")
			return 0
		}
		st = vals.ptop
		vals.ptop = st + n
	}
	var z Val
	for i := usize(0); i < n; i++ {
		vals.items[st+i] = z
	}
	return u32(st)
}

// valStore stores v in a fresh persistent slot.
func valStore(v Val) u32 {
	s := valAlloc(1, false)
	if s != 0 {
		vals.items[usize(s)] = v
	}
	return s
}

func slotGet(s u32) Val {
	return vals.items[usize(s)]
}

func slotSet(s u32, v Val) {
	if s != 0 {
		vals.items[usize(s)] = v
	}
}

func strAlloc(b []byte) u32 {
	n := len(b)
	if nstr == 0 {
		nstr = 1
	}
	if nstr+n > MaxStrBytes {
		setFull("string pool")
		return 0
	}
	st := nstr
	k := copy(strPool[st:st+n], b)
	nstr = st + k
	return u32(st)
}

func strSpan(off u32, n u32) []byte {
	return strPool[usize(off) : usize(off)+usize(n)]
}

// strOf returns the bytes of a string value (empty for other values).
func strOf(v Val) []byte {
	return match v { Str(off, n) -> strSpan(off, n), _ -> strPool[0:0] }
}

// ---------------------------------------------------------------------------
// Constructors

func vIntU(u u64) Val {
	return Val.Int(0, u)
}

func vInt(hi u64, lo u64) Val {
	return Val.Int(hi, lo)
}

func vBool(b bool) Val {
	return Val.Bool(b)
}

func vErr(b u8) Val {
	return Val.Err(b)
}

func vStr(b []byte) Val {
	return Val.Str(strAlloc(b), u32(len(b)))
}

// sliceOver is a slice of all n slots of the array at st.
func sliceOver(st u32, n usize) Val {
	return Val.Slice(st, 0, u32(n), u64(n))
}

// ---------------------------------------------------------------------------
// 128-bit two's complement integers

func isNeg128(hi u64) bool {
	return hi&SignBit != 0
}

func neg128(hi u64, lo u64) (u64, u64) {
	l := (lo ^ AllOnes) + 1
	h := hi ^ AllOnes
	if l == 0 {
		h++
	}
	return h, l
}

func abs128(hi u64, lo u64) (u64, u64) {
	if isNeg128(hi) {
		return neg128(hi, lo)
	}
	return hi, lo
}

func add128(ah u64, al u64, bh u64, bl u64) (u64, u64, bool) {
	lo := al + bl
	c := u64(0)
	if lo < al {
		c = 1
	}
	hi := ah + bh + c
	ovf := isNeg128(ah) == isNeg128(bh) && isNeg128(hi) != isNeg128(ah)
	return hi, lo, ovf
}

func sub128(ah u64, al u64, bh u64, bl u64) (u64, u64, bool) {
	lo := al - bl
	c := u64(0)
	if al < bl {
		c = 1
	}
	hi := ah - bh - c
	ovf := isNeg128(ah) != isNeg128(bh) && isNeg128(hi) != isNeg128(ah)
	return hi, lo, ovf
}

// mul64 returns the 128-bit product of a and b.
func mul64(a u64, b u64) (u64, u64) {
	a0 := a & 0xFFFFFFFF
	a1 := a >> 32
	b0 := b & 0xFFFFFFFF
	b1 := b >> 32
	p00 := a0 * b0
	p01 := a0 * b1
	p10 := a1 * b0
	p11 := a1 * b1
	mid := (p00 >> 32) + (p01 & 0xFFFFFFFF) + (p10 & 0xFFFFFFFF)
	lo := (p00 & 0xFFFFFFFF) | (mid << 32)
	hi := p11 + (p01 >> 32) + (p10 >> 32) + (mid >> 32)
	return hi, lo
}

func mulU128(ah u64, al u64, bh u64, bl u64) (u64, u64, bool) {
	if ah != 0 && bh != 0 {
		return 0, 0, true
	}
	h0, l0 := mul64(al, bl)
	h1, l1 := mul64(ah, bl)
	h2, l2 := mul64(al, bh)
	if h1 != 0 || h2 != 0 {
		return 0, 0, true
	}
	hi := h0 + l1
	if hi < h0 {
		return 0, 0, true
	}
	hi2 := hi + l2
	if hi2 < hi {
		return 0, 0, true
	}
	return hi2, l0, false
}

func mul128(ah u64, al u64, bh u64, bl u64) (u64, u64, bool) {
	neg := isNeg128(ah) != isNeg128(bh)
	xh, xl := abs128(ah, al)
	yh, yl := abs128(bh, bl)
	h, l, ovf := mulU128(xh, xl, yh, yl)
	if ovf {
		return 0, 0, true
	}
	if neg {
		if h > SignBit || (h == SignBit && l != 0) {
			return 0, 0, true
		}
		rh, rl := neg128(h, l)
		return rh, rl, false
	}
	if h >= SignBit {
		return 0, 0, true
	}
	return h, l, false
}

func geU128(ah u64, al u64, bh u64, bl u64) bool {
	if ah != bh {
		return ah > bh
	}
	return al >= bl
}

// divModU128 divides unsigned 128-bit numbers (d != 0).
func divModU128(nh u64, nl u64, dh u64, dl u64) (u64, u64, u64, u64) {
	if nh == 0 && dh == 0 {
		return 0, nl / dl, 0, nl % dl
	}
	qh := u64(0)
	ql := u64(0)
	rh := u64(0)
	rl := u64(0)
	for i := u64(0); i < 128; i++ {
		b := 127 - i
		bit := u64(0)
		if b >= 64 {
			bit = (nh >> (b - 64)) & 1
		} else {
			bit = (nl >> b) & 1
		}
		rh = (rh << 1) | (rl >> 63)
		rl = (rl << 1) | bit
		if geU128(rh, rl, dh, dl) {
			if rl < dl {
				rh--
			}
			rl = rl - dl
			rh = rh - dh
			if b >= 64 {
				qh = qh | (u64(1) << (b - 64))
			} else {
				ql = ql | (u64(1) << b)
			}
		}
	}
	return qh, ql, rh, rl
}

// quoRem128: truncated division (big.Int Quo/Rem). ovf for MIN / -1.
func quoRem128(ah u64, al u64, bh u64, bl u64) (u64, u64, u64, u64, bool) {
	xh, xl := abs128(ah, al)
	yh, yl := abs128(bh, bl)
	qh, ql, rh, rl := divModU128(xh, xl, yh, yl)
	if isNeg128(ah) != isNeg128(bh) {
		qh, ql = neg128(qh, ql)
	} else if qh >= SignBit {
		return 0, 0, 0, 0, true
	}
	if isNeg128(ah) {
		rh, rl = neg128(rh, rl)
	}
	return qh, ql, rh, rl, false
}

func shl128(hi u64, lo u64, n u64) (u64, u64) {
	if n == 0 {
		return hi, lo
	}
	if n >= 128 {
		return 0, 0
	}
	if n >= 64 {
		return lo << (n - 64), 0
	}
	return (hi << n) | (lo >> (64 - n)), lo << n
}

// sar128 is an arithmetic right shift.
func sar128(hi u64, lo u64, n u64) (u64, u64) {
	fill := u64(0)
	if isNeg128(hi) {
		fill = AllOnes
	}
	if n == 0 {
		return hi, lo
	}
	if n >= 128 {
		return fill, fill
	}
	if n >= 64 {
		l := hi >> (n - 64)
		if n > 64 {
			l = l | (fill << (128 - n))
		}
		return fill, l
	}
	l := (lo >> n) | (hi << (64 - n))
	h := (hi >> n) | (fill << (64 - n))
	return h, l
}

// cmp128 compares signed 128-bit numbers.
func cmp128(ah u64, al u64, bh u64, bl u64) int {
	xa := ah ^ SignBit
	xb := bh ^ SignBit
	if xa != xb {
		if xa < xb {
			return -1
		}
		return 1
	}
	if al != bl {
		if al < bl {
			return -1
		}
		return 1
	}
	return 0
}

// intParts returns the digits of an exact integer value (ok == false and
// 0, 0 for IntOvf and non-integers).
func intParts(v Val) (u64, u64, bool) {
	match v {
		Int(hi, lo) -> {
			return hi, lo, true
		}
		_ -> {
			return 0, 0, false
		}
	}
}

func isIntVal(v Val) bool {
	return match v { Int(_, _) | IntOvf -> true, _ -> false }
}

func isBoolVal(v Val) bool {
	return match v { Bool(_) -> true, _ -> false }
}

// intLo returns the low 64 bits of an exact integer value (0 for other
// values).
func intLo(v Val) u64 {
	_, lo, _ := intParts(v)
	return lo
}

// sliceElems returns the first element slot and the length of a slice
// value ((0, 0) for nil slices and other values).
func sliceElems(v Val) (u32, u32) {
	match v {
		Slice(ref, lo, hi, _) -> {
			return ref + lo, hi - lo
		}
		_ -> {
			return 0, 0
		}
	}
}

func isSliceVal(v Val) bool {
	return match v { Slice(_, _, _, _) | NilSlice -> true, _ -> false }
}

func isPtrVal(v Val) bool {
	return match v { Ptr(_) -> true, _ -> false }
}

func isStructVal(v Val) bool {
	return match v { Struct(_, _) -> true, _ -> false }
}

func isStrVal(v Val) bool {
	return match v { Str(_, _) -> true, _ -> false }
}

func intSign(v Val) int {
	hi, lo, _ := intParts(v)
	if isNeg128(hi) {
		return -1
	}
	if hi == 0 && lo == 0 {
		return 0
	}
	return 1
}

// putInt128 writes the decimal form of an integer value.
func putInt128(o *OutBuf, v Val) {
	if v == Val.IntOvf {
		o.putStr("<overflow>")
		return
	}
	h, l, _ := intParts(v)
	if isNeg128(h) {
		o.putByte('-')
		h, l = neg128(h, l)
	}
	if h == 0 {
		o.putUint(l)
		return
	}
	var digits [48]byte
	n := usize(0)
	for g := usize(0); g < 48; g++ {
		if h == 0 && l == 0 {
			break
		}
		qh, ql, r := divSmall128(h, l, 10)
		digits[n] = byte('0' + r)
		n++
		h = qh
		l = ql
	}
	for i := usize(0); i < n; i++ {
		o.putByte(digits[n-1-i])
	}
}

func divSmall128(h u64, l u64, d u64) (u64, u64, u64) {
	qh := h / d
	r := h % d
	x := (r << 32) | (l >> 32)
	q1 := x / d
	r = x % d
	y := (r << 32) | (l & 0xFFFFFFFF)
	q0 := y / d
	r = y % d
	return qh, (q1 << 32) | q0, r
}

// inRange reports whether integer v fits a bits-wide integer type.
func inRange(v Val, bits u32, signed bool) bool {
	hi, lo, ok := intParts(v)
	if !ok {
		return false
	}
	if signed {
		lim := u64(1) << u64(bits-1)
		if isNeg128(hi) {
			// v >= -lim
			if hi != AllOnes {
				return false
			}
			if bits == 64 {
				return lo >= SignBit
			}
			return lo >= AllOnes-lim+1
		}
		return hi == 0 && lo < lim
	}
	if hi != 0 {
		return false
	}
	if bits == 64 {
		return true
	}
	return lo < (u64(1) << u64(bits))
}

// representable reports whether constant v fits type t.
func representable(v Val, t u32) bool {
	return match v {
		Int(_, _) | IntOvf -> intRepresentable(v, t)
		Bool(_) -> isBoolean(t)
		Str(_, _) -> isString(t)
		_ -> true
	}
}

func intRepresentable(v Val, t u32) bool {
	bits, signed, ok := intInfo(t)
	if ok {
		return inRange(v, bits, signed)
	}
	return isUntyped(t) && isInteger(t)
}

// wrapVal truncates an integer to the range of t (two's complement).
func wrapVal(v Val, t u32) Val {
	if !isIntVal(v) {
		return v
	}
	bits, signed, ok := intInfo(t)
	if !ok || inRange(v, bits, signed) {
		return v
	}
	_, lo, _ := intParts(v)
	if bits < 64 {
		lo = lo & ((u64(1) << u64(bits)) - 1)
	}
	hi := u64(0)
	if signed && (lo>>u64(bits-1))&1 == 1 {
		if bits < 64 {
			lo = lo | (u64(AllOnes) << u64(bits))
		}
		hi = AllOnes
	}
	return Val.Int(hi, lo)
}

// valUint64 returns v as a u64 if it is a non-negative integer that fits.
func valUint64(v Val) (u64, bool) {
	hi, lo, ok := intParts(v)
	if !ok || hi != 0 {
		return 0, false
	}
	return lo, true
}

// ---------------------------------------------------------------------------
// Value strings (Value.String)

func putVal(o *OutBuf, v Val, depth usize) decreases(depth) {
	if depth == 0 {
		return
	}
	match v {
		None -> {}
		Int(_, _) | IntOvf -> putInt128(o, v)
		Bool(b) -> {
			if b {
				o.putStr("true")
			} else {
				o.putStr("false")
			}
		}
		Str(off, n) -> putQuoted(o, strSpan(off, n))
		Err(b) -> {
			if b == 0 {
				o.putStr("nil")
			} else {
				o.putStr(builtinName(b))
			}
		}
		Nil -> o.putStr("nil")
		Array(ref, n) -> putElems(o, ref, usize(n), depth-1)
		Slice(ref, lo, hi, _) -> putElems(o, ref+lo, usize(hi-lo), depth-1)
		NilSlice -> o.putStr("[]")
		Struct(ref, n) -> {
			o.putByte('{')
			putValList(o, ref, usize(n), depth-1)
			o.putByte('}')
		}
		Enum(vi, ref, n) -> {
			o.putStr("variant#")
			o.putUint(u64(vi))
			if n > 0 {
				o.putByte('(')
				putValList(o, ref, usize(n), depth-1)
				o.putByte(')')
			}
		}
		Tuple(ref, n) -> {
			o.putByte('(')
			putValList(o, ref, usize(n), depth-1)
			o.putByte(')')
		}
		CodeBasic(k) -> {
			o.putStr(codeKindName(k))
			o.putStr("()")
		}
		CodeArray(n, el) -> {
			o.putStr("CodeArray(")
			o.putUint(n)
			o.putStr(", ")
			putVal(o, slotGet(el), depth-1)
			o.putByte(')')
		}
		CodeSlice(el) -> {
			o.putStr("CodeSlice(")
			putVal(o, slotGet(el), depth-1)
			o.putByte(')')
		}
		CodeStruct(ref, n) -> {
			o.putStr("CodeStruct(")
			putValList(o, ref, usize(n), depth-1)
			o.putByte(')')
		}
		CodeUniv(l) -> {
			o.putStr("CodeUniv(")
			o.putUint(l)
			o.putByte(')')
		}
		FieldCode(off, n, c) -> {
			o.putStr("CodeField(")
			putQuoted(o, strSpan(off, n))
			o.putStr(", ")
			putVal(o, slotGet(c), depth-1)
			o.putByte(')')
		}
		Ptr(r) -> {
			o.putByte('&')
			if r != 0 {
				putVal(o, slotGet(r), depth-1)
			} else {
				o.putStr("<nil>")
			}
		}
	}
}

func putValList(o *OutBuf, ref u32, n usize, depth usize) decreases(depth) {
	if depth == 0 {
		return
	}
	for i := usize(0); i < n; i++ {
		if i > 0 {
			o.putStr(", ")
		}
		putVal(o, slotGet(ref+u32(i)), depth-1)
	}
}

func putElems(o *OutBuf, ref u32, n usize, depth usize) decreases(depth) {
	if depth == 0 {
		return
	}
	o.putByte('[')
	for i := usize(0); i < n; i++ {
		if i > 0 {
			o.putStr(", ")
		}
		if i == 8 {
			o.putStr("...")
			break
		}
		putVal(o, slotGet(ref+u32(i)), depth-1)
	}
	o.putByte(']')
}

func codeKindName(k u8) string {
	return match k {
		CKEmpty -> "CodeEmpty"
		CKUnit -> "CodeUnit"
		CKBool -> "CodeBool"
		CKU8 -> "CodeU8"
		CKU16 -> "CodeU16"
		CKU32 -> "CodeU32"
		CKU64 -> "CodeU64"
		CKI8 -> "CodeI8"
		CKI16 -> "CodeI16"
		CKI32 -> "CodeI32"
		CKI64 -> "CodeI64"
		_ -> "CodeUniv"
	}
}

// mval writes a value into the diagnostic message; etval into errTxt.
func mval(v Val) {
	o := &msgBuf
	putVal(o, v, SemaDepth)
}

func etval(v Val) {
	o := &errTxt
	putVal(o, v, SemaDepth)
}

// ---------------------------------------------------------------------------
// Copying

// copyVal deep-copies arrays, structs and enums into the comptime heap
// (types.CopyValue); other values are returned as is.
func copyVal(v Val, depth usize) Val decreases(depth) {
	if depth == 0 {
		return v
	}
	return match v {
		Array(ref, n) -> Val.Array(copyRun(ref, n, true, depth-1), n)
		Struct(ref, n) -> Val.Struct(copyRun(ref, n, true, depth-1), n)
		Enum(vi, ref, n) -> Val.Enum(vi, copyRun(ref, n, true, depth-1), n)
		_ -> v
	}
}

// copyRun copies the n slots at ref (deep copies with copyVal into the heap,
// or persistent copies with persistVal) and returns the copy's first slot
// (ref itself if n == 0 or the region is full).
func copyRun(ref u32, n u32, heap bool, depth usize) u32 decreases(depth) {
	if depth == 0 || n == 0 {
		return ref
	}
	st := valAlloc(usize(n), heap)
	if st == 0 {
		return ref
	}
	for i := u32(0); i < n; i++ {
		if heap {
			vals.items[usize(st+i)] = copyVal(slotGet(ref+i), depth-1)
		} else {
			vals.items[usize(st+i)] = persistVal(slotGet(ref+i), depth-1)
		}
	}
	return st
}

func copyV(v Val) Val {
	return copyVal(v, SemaDepth)
}

// persistVal copies v and everything it refers to into the persistent
// region (comptime results outlive the heap of their evaluation).
func persistVal(v Val, depth usize) Val decreases(depth) {
	if depth == 0 {
		return v
	}
	return match v {
		None | Bool(_) | Err(_) | Nil | Str(_, _) | Int(_, _) | IntOvf | NilSlice | CodeBasic(_) | CodeUniv(_) -> v
		Array(ref, n) -> Val.Array(copyRun(ref, n, false, depth-1), n)
		Struct(ref, n) -> Val.Struct(copyRun(ref, n, false, depth-1), n)
		Enum(vi, ref, n) -> Val.Enum(vi, copyRun(ref, n, false, depth-1), n)
		Tuple(ref, n) -> Val.Tuple(copyRun(ref, n, false, depth-1), n)
		CodeStruct(ref, n) -> Val.CodeStruct(copyRun(ref, n, false, depth-1), n)
		Slice(ref, lo, hi, alen) -> Val.Slice(copyRun(ref, u32(alen), false, depth-1), lo, hi, alen)
		CodeArray(n, el) -> Val.CodeArray(n, persistSlot(el, depth-1))
		CodeSlice(el) -> Val.CodeSlice(persistSlot(el, depth-1))
		FieldCode(off, n, c) -> Val.FieldCode(off, n, persistSlot(c, depth-1))
		Ptr(r) -> Val.Ptr(persistSlot(r, depth-1))
	}
}

// persistSlot copies the value in slot s (0 = none) into a fresh
// persistent slot.
func persistSlot(s u32, depth usize) u32 decreases(depth) {
	if depth == 0 || s == 0 {
		return s
	}
	st := valAlloc(1, false)
	if st == 0 {
		return s
	}
	vals.items[usize(st)] = persistVal(slotGet(s), depth-1)
	return st
}

// ---------------------------------------------------------------------------
// Zero values (types.Zero). Errors leave their text in errTxt.

var zeroBudget usize

func zeroVal(t u32, heap bool) (Val, bool) {
	zeroBudget = MaxComptimeElems
	return zeroRec(t, heap, SemaDepth)
}

func zeroRec(t u32, heap bool, depth usize) (Val, bool) decreases(depth) {
	var z Val
	if depth == 0 {
		etReset()
		et("type too deep")
		return z, false
	}
	u := underlying(t)
	match trec(u) {
		Basic(_) -> {
			if isInteger(u) {
				return vIntU(0), true
			}
			if isBoolean(u) {
				return vBool(false), true
			}
			if isString(u) {
				return vStr(emptyBytes()), true
			}
			if basicKind(u) == BkError {
				return vErr(0), true
			}
		}
		Code(_) -> {
			return Val.CodeBasic(CKEmpty), true
		}
		Array(elem, lenParam, alen) -> {
			if lenParam != 0 {
				etReset()
				et("array with generic length")
				return z, false
			}
			if alen > u64(zeroBudget) {
				etReset()
				et("array too large for compile-time evaluation")
				return z, false
			}
			zeroBudget -= usize(alen)
			n := usize(alen)
			st := valAlloc(n, heap)
			for i := usize(0); i < n; i++ {
				e, ok := zeroRec(elem, heap, depth-1)
				if !ok {
					return z, false
				}
				slotSet(st+u32(i), e)
			}
			return Val.Array(st, u32(n)), true
		}
		Slice(_) -> {
			return Val.NilSlice, true
		}
		Struct(_, _) -> {
			n := nfields(u)
			st := valAlloc(n, heap)
			for i := usize(0); i < n; i++ {
				e, ok := zeroRec(fieldType(u, i), heap, depth-1)
				if !ok {
					return z, false
				}
				slotSet(st+u32(i), e)
			}
			return Val.Struct(st, u32(n)), true
		}
		Enum(_, _) -> {
			if nvariants(u) == 0 {
				return Val.Enum(0, 0, 0), true
			}
			n := variantPayN(u, 0)
			st := valAlloc(n, heap)
			for i := usize(0); i < n; i++ {
				e, ok := zeroRec(variantPay(u, 0, i), heap, depth-1)
				if !ok {
					return z, false
				}
				slotSet(st+u32(i), e)
			}
			return Val.Enum(0, st, u32(n)), true
		}
		NoType | Sig(_, _, _, _, _, _, _, _) | Named(_) | Pointer(_) | TypeParam(_, _, _, _) | ConstArg(_) | Tuple(_, _) | Opaque(_, _) -> {}
	}
	if builtinOf(t) == BTFieldCode {
		c := valAlloc(1, heap)
		slotSet(c, Val.CodeBasic(CKEmpty))
		return Val.FieldCode(0, 0, c), true
	}
	etReset()
	o := &errTxt
	putType(o, t, SemaDepth)
	if t != 0 && isNamedT(t) && namedBuiltin(t) != 0 {
		et(" has no compile-time value")
	} else {
		et(" has no zero value")
	}
	return z, false
}

func emptyBytes() []byte {
	return strPool[0:0]
}

// ---------------------------------------------------------------------------
// Constant arithmetic (types.BinaryOp, Equal, UnaryOp). On error they return
// false with the error text in errTxt.

func opNotDefined(op u8, x Val, y Val, two bool) {
	etReset()
	et("operator ")
	et(binOpString(op))
	et(" not defined on ")
	etval(x)
	if two {
		et(", ")
		etval(y)
	}
}

func isCompareOp(op u8) bool {
	return op >= OpEq && op <= OpGe
}

// boolOf returns the truth value of a Bool (ok == false for other values).
func boolOf(v Val) (bool, bool) {
	match v {
		Bool(b) -> {
			return b, true
		}
		_ -> {
			return false, false
		}
	}
}

func binaryOpVal(op u8, x Val, y Val) (Val, bool) {
	var z Val
	if isCompareOp(op) {
		return compareVals(op, x, y)
	}
	if op == OpLAnd || op == OpLOr {
		a, aok := boolOf(x)
		b, bok := boolOf(y)
		if !aok || !bok {
			etReset()
			et("non-boolean operands")
			return z, false
		}
		if op == OpLAnd {
			return vBool(a && b), true
		}
		return vBool(a || b), true
	}
	if !isIntVal(x) || !isIntVal(y) {
		opNotDefined(op, x, y, true)
		return z, false
	}
	xh, xl, xok := intParts(x)
	yh, yl, yok := intParts(y)
	if !xok || !yok {
		return Val.IntOvf, true
	}
	if op == OpAdd {
		h, l, ovf := add128(xh, xl, yh, yl)
		return intResult(h, l, ovf), true
	}
	if op == OpSub {
		h, l, ovf := sub128(xh, xl, yh, yl)
		return intResult(h, l, ovf), true
	}
	if op == OpMul {
		h, l, ovf := mul128(xh, xl, yh, yl)
		return intResult(h, l, ovf), true
	}
	if op == OpDiv || op == OpRem {
		if yh == 0 && yl == 0 {
			etReset()
			et("division by zero")
			return z, false
		}
		qh, ql, rh, rl, ovf := quoRem128(xh, xl, yh, yl)
		if op == OpDiv {
			return intResult(qh, ql, ovf), true
		}
		return intResult(rh, rl, ovf), true
	}
	if op == OpAnd {
		return vInt(xh&yh, xl&yl), true
	}
	if op == OpOr {
		return vInt(xh|yh, xl|yl), true
	}
	if op == OpXor {
		return vInt(xh^yh, xl^yl), true
	}
	if op == OpShl || op == OpShr {
		if isNeg128(yh) {
			etReset()
			et("negative shift count")
			return z, false
		}
		if yh != 0 || yl > MaxShift {
			if op == OpShr {
				if isNeg128(xh) {
					return vInt(AllOnes, AllOnes), true
				}
				return vIntU(0), true
			}
			etReset()
			et("shift count too large")
			return z, false
		}
		if op == OpShl {
			if xh == 0 && xl == 0 {
				return vIntU(0), true
			}
			if yl >= 128 {
				return Val.IntOvf, true
			}
			h, l := shl128(xh, xl, yl)
			bh, bl := sar128(h, l, yl)
			if bh != xh || bl != xl {
				return Val.IntOvf, true
			}
			return vInt(h, l), true
		}
		h, l := sar128(xh, xl, yl)
		return vInt(h, l), true
	}
	etReset()
	et("unsupported operator ")
	et(binOpString(op))
	return z, false
}

func intResult(h u64, l u64, ovf bool) Val {
	if ovf {
		return Val.IntOvf
	}
	return vInt(h, l)
}

func compareVals(op u8, x Val, y Val) (Val, bool) {
	var z Val
	if op == OpEq || op == OpNe {
		eq, ok := equalVals(x, y, SemaDepth)
		if !ok {
			return z, false
		}
		return vBool(eq == (op == OpEq)), true
	}
	c := 0
	if isIntVal(x) {
		if !isIntVal(y) {
			etReset()
			et("mismatched operands")
			return z, false
		}
		xh, xl, _ := intParts(x)
		yh, yl, _ := intParts(y)
		c = cmp128(xh, xl, yh, yl)
	} else if isStrVal(x) {
		if !isStrVal(y) {
			etReset()
			et("mismatched operands")
			return z, false
		}
		c = bytesCompare(strOf(x), strOf(y))
	} else {
		opNotDefined(op, x, y, false)
		return z, false
	}
	if op == OpLt {
		return vBool(c < 0), true
	}
	if op == OpLe {
		return vBool(c <= 0), true
	}
	if op == OpGt {
		return vBool(c > 0), true
	}
	return vBool(c >= 0), true
}

func cannotCompare(x Val, y Val) {
	etReset()
	et("cannot compare ")
	etval(x)
	et(" and ")
	etval(y)
}

// isNilSlice reports whether v is a slice that compares equal to nil.
func isNilSlice(v Val) bool {
	return match v {
		NilSlice -> true
		Slice(_, lo, hi, _) -> lo == hi
		_ -> false
	}
}

// equalVals compares two values for == (types.Equal).
func equalVals(x Val, y Val, depth usize) (bool, bool) decreases(depth) {
	if depth == 0 {
		return false, true
	}
	match x {
		Int(_, _) | IntOvf | Bool(_) -> {
			return x == y, true
		}
		Str(_, _) -> {
			return isStrVal(y) && bytesEqual(strOf(x), strOf(y)), true
		}
		Err(a) -> {
			return match y {
				Err(b) -> a == b
				Nil -> a == 0
				_ -> false
			}, true
		}
		Nil -> {
			match y {
				Err(b) -> {
					return b == 0, true
				}
				Slice(_, _, _, _) | NilSlice -> {
					return isNilSlice(y), true
				}
				Nil -> {
					return true, true
				}
				_ -> {}
			}
		}
		Slice(_, _, _, _) | NilSlice -> {
			if y == Val.Nil {
				return isNilSlice(x), true
			}
		}
		CodeBasic(_) | CodeArray(_, _) | CodeSlice(_) | CodeStruct(_, _) | CodeUniv(_) -> {
			return codeEqual(x, y, depth-1), true
		}
		Array(xr, xn) -> {
			match y {
				Array(yr, yn) -> {
					if xn != yn {
						return false, true
					}
					return equalList(xr, yr, usize(xn), depth-1)
				}
				_ -> {
					return false, true
				}
			}
		}
		Struct(xr, xn) -> {
			match y {
				Struct(yr, yn) -> {
					if xn != yn {
						return false, true
					}
					return equalList(xr, yr, usize(xn), depth-1)
				}
				_ -> {
					return false, true
				}
			}
		}
		Enum(xv, xr, xn) -> {
			match y {
				Enum(yv, yr, yn) -> {
					if xv != yv || xn != yn {
						return false, true
					}
					return equalList(xr, yr, usize(xn), depth-1)
				}
				_ -> {
					return false, true
				}
			}
		}
		None | Tuple(_, _) | Ptr(_) | FieldCode(_, _, _) -> {}
	}
	cannotCompare(x, y)
	return false, false
}

func equalList(a u32, b u32, n usize, depth usize) (bool, bool) decreases(depth) {
	if depth == 0 {
		return false, true
	}
	for i := usize(0); i < n; i++ {
		eq, ok := equalVals(slotGet(a+u32(i)), slotGet(b+u32(i)), depth-1)
		if !ok || !eq {
			return eq, ok
		}
	}
	return true, true
}

// codeEqual compares code values structurally (finc0 compares their
// String forms, which is equivalent).
func codeEqual(x Val, y Val, depth usize) bool decreases(depth) {
	if depth == 0 {
		return false
	}
	return match x {
		CodeArray(xn, xe) -> match y {
			CodeArray(yn, ye) -> xn == yn && codeEqual(slotGet(xe), slotGet(ye), depth-1)
			_ -> false
		}
		CodeSlice(xe) -> match y {
			CodeSlice(ye) -> codeEqual(slotGet(xe), slotGet(ye), depth-1)
			_ -> false
		}
		CodeStruct(xr, xn) -> match y {
			CodeStruct(yr, yn) -> xn == yn && codeListEqual(xr, yr, xn, depth-1)
			_ -> false
		}
		FieldCode(xo, xl, xc) -> match y {
			FieldCode(yo, yl, yc) -> bytesEqual(strSpan(xo, xl), strSpan(yo, yl)) && codeEqual(slotGet(xc), slotGet(yc), depth-1)
			_ -> false
		}
		_ -> x == y
	}
}

func codeListEqual(a u32, b u32, n u32, depth usize) bool decreases(depth) {
	if depth == 0 {
		return false
	}
	for i := u32(0); i < n; i++ {
		if !codeEqual(slotGet(a+i), slotGet(b+i), depth-1) {
			return false
		}
	}
	return true
}

// unaryOpVal evaluates !x or -x.
func unaryOpVal(op u8, x Val) (Val, bool) {
	var z Val
	match x {
		Bool(b) -> {
			if op == OpNot {
				return vBool(!b), true
			}
		}
		Int(hi, lo) -> {
			if op == OpNeg {
				if hi == SignBit && lo == 0 {
					return Val.IntOvf, true
				}
				h, l := neg128(hi, lo)
				return vInt(h, l), true
			}
		}
		IntOvf -> {
			if op == OpNeg {
				return x, true
			}
		}
		_ -> {}
	}
	etReset()
	et("operator ")
	et(unaryOpString(op))
	et(" not defined on ")
	etval(x)
	return z, false
}

// isVariant reports whether v is an enum value of variant vi.
func isVariant(v Val, vi u32) bool {
	return match v { Enum(x, _, _) -> x == vi, _ -> false }
}

// tupleOf returns the first element slot and the length of a tuple
// ((0, 0) for other values).
func tupleOf(v Val) (u32, u32) {
	match v {
		Tuple(ref, n) -> {
			return ref, n
		}
		_ -> {
			return 0, 0
		}
	}
}

func isTupleVal(v Val) bool {
	return match v { Tuple(_, _) -> true, _ -> false }
}

func isCodeVal(v Val) bool {
	return match v {
		CodeBasic(_) | CodeArray(_, _) | CodeSlice(_) | CodeStruct(_, _) | CodeUniv(_) -> true
		_ -> false
	}
}

// fieldSlot returns the slot of field i of a struct value (0 if v is not a
// struct).
func fieldSlot(v Val, i u32) u32 {
	return match v { Struct(ref, _) -> ref + i, _ -> 0 }
}

// ---------------------------------------------------------------------------
// Code values

// fieldCodeOf is the FieldCode value with the name of string value name and
// the code in slot c.
func fieldCodeOf(name Val, c u32) Val {
	return match name { Str(off, n) -> Val.FieldCode(off, n, c), _ -> Val.FieldCode(0, 0, c) }
}

// fieldCodeSlot returns the slot of the code of a FieldCode value.
func fieldCodeSlot(f Val) u32 {
	return match f { FieldCode(_, _, c) -> c, _ -> 0 }
}

// codeLevelOf returns the universe level of a code (CodeVal.Level).
func codeLevelOf(v Val, depth usize) int decreases(depth) {
	if depth == 0 {
		return -1
	}
	match v {
		CodeUniv(l) -> {
			return int(l) + 1
		}
		CodeArray(_, el) -> {
			return codeLevelOf(slotGet(el), depth-1)
		}
		CodeSlice(el) -> {
			return codeLevelOf(slotGet(el), depth-1)
		}
		CodeStruct(ref, n) -> {
			l := -1
			for i := u32(0); i < n; i++ {
				x := codeLevelOf(slotGet(fieldCodeSlot(slotGet(ref+i))), depth-1)
				if x > l {
					l = x
				}
			}
			return l
		}
		_ -> {
			return -1
		}
	}
}

// basicCodeType is the type a CodeBasic value denotes.
func basicCodeType(k u8) u32 {
	return match k {
		CKEmpty -> mkEnum(tmark())
		CKUnit -> mkStruct(tmark())
		CKBool -> TyBool
		CKU8 -> TyU8
		CKU16 -> TyU16
		CKU32 -> TyU32
		CKU64 -> TyU64
		CKI8 -> TyI8
		CKI16 -> TyI16
		CKI32 -> TyI32
		CKI64 -> TyI64
		_ -> TyInvalid
	}
}

// foldCode converts a code value into the type it denotes (types.FoldCode).
func foldCode(v Val, depth usize) u32 decreases(depth) {
	if depth == 0 {
		return TyInvalid
	}
	match v {
		CodeBasic(k) -> {
			return basicCodeType(k)
		}
		CodeArray(n, el) -> {
			return mkArray(n, 0, foldCode(slotGet(el), depth-1))
		}
		CodeSlice(el) -> {
			return mkSlice(foldCode(slotGet(el), depth-1))
		}
		CodeStruct(ref, n) -> {
			m := tmark()
			for i := u32(0); i < n; i++ {
				match slotGet(ref + i) {
					FieldCode(off, ln, c) -> {
						nm := intern(strSpan(off, ln))
						ft := foldCode(slotGet(c), depth-1)
						tpush(nm)
						tpush(ft)
					}
					_ -> {}
				}
			}
			return mkStruct(m)
		}
		CodeUniv(l) -> {
			return mkCode(int(l))
		}
		_ -> {
			return TyInvalid
		}
	}
}
