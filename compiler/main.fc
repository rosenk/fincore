package main

// FinCore Stage-1 Native Self-Hosting Compiler (v0.2).
// Written 100% in FinCore — compiles directly to static Linux x86_64 ELF64
// with zero libc and zero GC.

const CompilerVersion = "finc language v0.7\n"

driver func main(io Stdio, env Env, fs FS, ex Exec) error {
	_ = ex
	argc := env.ArgsCount()
	if argc < 2 {
		_ = io.WriteStderr(strBytes("usage: finc <init|get|parse|check|build|run|test|fmt|lsp|version> [args...]\n"))
		return ErrIO
	}
	cmd := strBytes(env.Arg(1))
	if sliceEq(cmd, strBytes("version")) || sliceEq(cmd, strBytes("--version")) {
		return io.WriteStdout(strBytes(CompilerVersion))
	}
	if sliceEq(cmd, strBytes("init")) {
		return cmdInit(io, env, fs)
	}
	if sliceEq(cmd, strBytes("get")) {
		return cmdGet(io, env, fs, ex)
	}
	if sliceEq(cmd, strBytes("lsp")) {
		return cmdLsp(io, env, fs)
	}
	if sliceEq(cmd, strBytes("parse")) {
		return cmdParse(io, env, fs)
	}
	if sliceEq(cmd, strBytes("check")) {
		return cmdCheck(io, env, fs)
	}
	if sliceEq(cmd, strBytes("build")) {
		return cmdBuild(io, env, fs, ex)
	}
	if sliceEq(cmd, strBytes("run")) {
		return cmdRun(io, env, fs, ex)
	}
	if sliceEq(cmd, strBytes("test")) {
		return cmdTest(io, env, fs, ex)
	}
	if sliceEq(cmd, strBytes("fmt")) {
		return cmdFmt(io, env, fs)
	}
	_ = io.WriteStderr(strBytes("usage: finc <init|get|parse|check|build|run|test|fmt|lsp|version> [args...]\n"))
	return ErrIO
}

driver func cmdCheck(io Stdio, env Env, fs FS) error {
	poolInit()
	lexerInit()
	astInit()
	typesInit()
	valsInit()
	resolveInit(env)
	prettyDiags = false
	argc := env.ArgsCount()
	if argc < 3 {
		_ = io.WriteStderr(strBytes("usage: finc check [--pretty] [--comptime-fuel=N] <file.fc | dir>\n"))
		return ErrIO
	}
	var targetIdx usize = 2
	comptimeFuelBudget = 1_000_000
	for i := usize(2); i < argc; i++ {
		arg := strBytes(env.Arg(i))
		if sliceEq(arg, strBytes("--pretty")) {
			prettyDiags = true
			targetIdx = i + 1
		} else if len(arg) > 16 && sliceEq(arg[:16], strBytes("--comptime-fuel=")) {
			v, ok := parseIntLit(arg[16:])
			if ok && v > 0 {
				comptimeFuelBudget = v
			}
			targetIdx = i + 1
		} else {
			targetIdx = i
			break
		}
	}
	if targetIdx >= argc {
		_ = io.WriteStderr(strBytes("usage: finc check <file.fc | dir>\n"))
		return ErrIO
	}
	target := strBytes(env.Arg(targetIdx))
	loadProgram(fs, target)?
	if diagCount == 0 {
		checkProgram()
	}
	if diagCount > 0 {
		_ = printDiags(io)
		return ErrIO
	}
	return nil
}

driver func loadTargetFiles(fs FS, target []byte) error {
	if fs.IsDir(bytesToStr(target)) {
		var names [64]string
		n := fs.ListSourceFiles(bytesToStr(target), names[:])?
		var pathBuf [512]byte
		for i := usize(0); i < n; i++ {
			pos := usize(0)
			pos = bufAppend(pathBuf[:], pos, target)
			if pos > 0 && pathBuf[pos-1] != '/' {
				pos = bufAppendByte(pathBuf[:], pos, '/')
			}
			pos = bufAppendStr(pathBuf[:], pos, names[i])
			loadOneFile(fs, pathBuf[:pos])?
		}
		return nil
	}
	return loadOneFile(fs, target)
}

driver func loadOneFile(fs FS, path []byte) error {
	off := srcUsed
	if usize(off) >= MaxSrcBytes {
		return ErrArenaFull
	}
	n := fs.ReadFileInto(bytesToStr(path), srcBuf[usize(off):])?
	srcUsed += u32(n)
	fid := addSourceFile(path, off, u32(n))
	lexFile(fid)
	_ = parseFile(fid)
	return nil
}

driver func cmdParse(io Stdio, env Env, fs FS) error {
	poolInit()
	lexerInit()
	astInit()
	argc := env.ArgsCount()
	if argc < 3 {
		_ = io.WriteStderr(strBytes("usage: finc parse <file.fc | dir>\n"))
		return ErrIO
	}
	var targetIdx usize = 2
	summary := false
	if sliceEq(strBytes(env.Arg(2)), strBytes("--stats")) {
		summary = true
		targetIdx = 3
		if argc < 4 {
			_ = io.WriteStderr(strBytes("usage: finc parse [--stats] <file.fc | dir>\n"))
			return ErrIO
		}
	}
	target := strBytes(env.Arg(targetIdx))
	if err := loadTargetFiles(fs, target); err != nil {
		return err
	}
	if diagCount > 0 {
		_ = printDiags(io)
		return ErrIO
	}
	if summary {
		var buf [128]byte
		n := formatTo(buf[:], "parsed %d files, %d tokens, %d AST nodes, %d interned strings\n",
			fileCount, tokCount, nodeCount, strCount)
		return io.WriteStdout(buf[:n])
	}
	return nil
}
