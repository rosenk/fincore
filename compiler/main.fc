// main.fc — the finc command-line driver (spec 9.6).
//
//	finc parse [--dump-ast] <file.fc | dir>
//	finc check | build | run | test   (build/run/test: build.fc)
//
// `parse` mirrors `finc0 parse`: all `.fc` files of a directory (sorted by
// name) are parsed as one package; syntax errors are printed to stderr in
// the spec 11 format, one per failing file, in file order; with
// --dump-ast the AST is printed to stdout in finc0's dump format.
//
// The driver layer is the only place that touches capabilities (FS, Env,
// Stdio). The arenas are package-level Value variables; the driver takes
// their addresses and passes them to the total phases (lexer, parser,
// dump) through Scoped helper structs that live in its own frame.
package main

import (
	"std/path"
	"std/strconv"
)

const (
	MaxPathBytes = 4096
)

// Package-level arenas (Value types only, rule S1).
var sources SourceArena
var tokens TokenArena
var nodes NodeArena
var outBuf OutBuf
var errBuf OutBuf
var tmpBuf OutBuf
var fileNames [MaxFiles]string

// fincRoot is $FINCROOT (read once by main): the directory std/... imports
// resolve against; "" means the module root.
var fincRoot string

func strEq(a string, b string) bool {
	return bytesEqual(strBytes(a), strBytes(b))
}

// ---------------------------------------------------------------------------
// output helpers (driver layer)

driver func flushErr(io Stdio) error {
	eb := &errBuf
	if eb.Len() == 0 {
		return nil
	}
	err := io.WriteStderr(eb.Bytes())
	eb.Reset()
	return err
}

driver func say(io Stdio, toStderr bool, s string) error {
	if toStderr {
		return io.WriteStderr(strBytes(s))
	}
	return io.WriteStdout(strBytes(s))
}

driver func usage(io Stdio, toStderr bool) error {
	if err := say(io, toStderr, "usage: finc1 <command> [arguments]\n\n"); err != nil {
		return err
	}
	if err := say(io, toStderr, "  finc1 parse [--dump-ast] <file.fc | dir>\n      parse sources and optionally dump the AST\n"); err != nil {
		return err
	}
	if err := say(io, toStderr, "  finc1 check [--comptime-fuel=N] <file.fc | dir>\n      type, scope and totality check\n"); err != nil {
		return err
	}
	if err := say(io, toStderr, "  finc1 build [-o out_bin] [--emit-go=out.go] [--race] [--trimpath] [--comptime-fuel=N] <file.fc | dir>\n      compile to a Go program and binary\n"); err != nil {
		return err
	}
	if err := say(io, toStderr, "  finc1 run [--race] [--comptime-fuel=N] <file.fc | dir> [-- args...]\n      build and run\n"); err != nil {
		return err
	}
	return say(io, toStderr, "  finc1 test <dir>\n      run conformance tests in a directory\n")
}

// ioFail reports "finc1: <what> <path>: <reason>" for an I/O error.
driver func ioFail(io Stdio, what string, path string, err error) error {
	eb := &errBuf
	eb.Reset()
	eb.WriteString("finc1: ")
	eb.WriteString(what)
	eb.WriteString(path)
	eb.WriteString(": ")
	if err == ErrNotFound {
		eb.WriteString("no such file or directory")
	} else if err == ErrArenaFull {
		eb.WriteString("compiler capacity exceeded")
	} else {
		eb.WriteString("I/O error")
	}
	eb.WriteByte('\n')
	if e := flushErr(io); e != nil {
		return e
	}
	return err
}

// capacityFail reports an exhausted compiler arena.
driver func capacityFail(io Stdio, path string, what string) error {
	eb := &errBuf
	eb.Reset()
	eb.WriteString("finc1: ")
	eb.WriteString(path)
	eb.WriteString(": compiler capacity exceeded (")
	eb.WriteString(what)
	eb.WriteString(")\n")
	if e := flushErr(io); e != nil {
		return e
	}
	return ErrArenaFull
}

// ---------------------------------------------------------------------------
// main

driver func main(fs FS, env Env, io Stdio, exec Exec) error {
	eb := &errBuf
	if r, ok := env.GetEnv("FINCROOT"); ok {
		fincRoot = r
	}
	argc := env.ArgsCount()
	if argc < 2 {
		if err := usage(io, true); err != nil {
			return err
		}
		return ErrParse
	}
	cmd := env.Arg(1)
	if strEq(cmd, "-h") || strEq(cmd, "--help") || strEq(cmd, "help") {
		return usage(io, false)
	}
	if strEq(cmd, "parse") {
		return runParse(fs, env, io)
	}
	if strEq(cmd, "check") {
		return runCheck(fs, env, io)
	}
	if strEq(cmd, "build") {
		return runBuild(fs, env, io, exec)
	}
	if strEq(cmd, "run") {
		return runRun(fs, env, io, exec)
	}
	if strEq(cmd, "test") {
		return runTest(fs, env, io, exec)
	}
	eb.Reset()
	eb.WriteString("finc1: unknown command ")
	putQuoted(eb, strBytes(cmd))
	eb.WriteByte('\n')
	if err := flushErr(io); err != nil {
		return err
	}
	if err := usage(io, true); err != nil {
		return err
	}
	return ErrParse
}

driver func parseUsage(io Stdio) error {
	if err := say(io, true, "usage: finc1 parse [--dump-ast] <file.fc | dir>\n  -dump-ast\n    \tprint the AST\n"); err != nil {
		return err
	}
	return ErrParse
}

// runParse implements `parse [--dump-ast] <file.fc | dir>` (Go flag
// syntax: -dump-ast / --dump-ast[=true|false] before the operand).
driver func runParse(fs FS, env Env, io Stdio) error {
	eb := &errBuf
	argc := env.ArgsCount()
	dump := false
	operand := ""
	nops := usize(0)
	flagsDone := false
	for i := usize(2); i < argc; i++ {
		a := env.Arg(i)
		ab := strBytes(a)
		isFlag := !flagsDone && nops == 0 && len(ab) > 1 && ab[0] == '-'
		if isFlag && strEq(a, "--") {
			flagsDone = true
		} else if isFlag {
			if strEq(a, "-dump-ast") || strEq(a, "--dump-ast") || strEq(a, "-dump-ast=true") || strEq(a, "--dump-ast=true") {
				dump = true
			} else if strEq(a, "-dump-ast=false") || strEq(a, "--dump-ast=false") {
				dump = false
			} else {
				eb.Reset()
				eb.WriteString("flag provided but not defined: ")
				eb.WriteString(a)
				eb.WriteByte('\n')
				if err := flushErr(io); err != nil {
					return err
				}
				return parseUsage(io)
			}
		} else {
			operand = a
			nops++
		}
	}
	if nops != 1 {
		return parseUsage(io)
	}
	return parsePackage(fs, io, operand, dump)
}

// parsePackage parses a file or all `.fc` files of a directory as one
// package, then prints the diagnostics or (optionally) the AST dump.
driver func parsePackage(fs FS, io Stdio, path string, dump bool) error {
	ob := &outBuf
	np := &nodes
	sources.used = 0
	sources.nfiles = 0
	(&errBuf).Truncate(0)
	f0, f1, ndiag, err := parseSources(fs, io, path, false)
	if err != nil {
		return err
	}
	if ndiag > 0 {
		if err := flushErr(io); err != nil {
			return err
		}
		return ErrParse
	}
	if !dump {
		return nil
	}
	nincluded := usize(0)
	pkgName := ""
	for i := f0; i < f1; i++ {
		if sources.files[i].ok {
			if nincluded == 0 {
				pk := nodes.items[usize(nodes.items[usize(sources.files[i].root)].a)]
				pkgName = bytesToStr(sources.bytes[usize(pk.tOff) : usize(pk.tOff)+usize(pk.tLen)])
			}
			nincluded++
		}
	}
	ob.Reset()
	ob.WriteString("Package ")
	ob.WriteString(pkgName)
	ob.WriteString(" (")
	ob.WriteUint(u64(nincluded))
	ob.WriteString(" files)\n")
	if err := io.WriteStdout(ob.Bytes()); err != nil {
		return err
	}
	d := Dumper{na: np, sa: &sources, src: sources.bytes[:], out: ob, tmp: &tmpBuf}
	dp := &d
	for i := f0; i < f1; i++ {
		if !sources.files[i].ok {
			continue
		}
		ob.Reset()
		dp.dumpNode(sources.files[i].root, 0, WalkDepth)
		if ob.Truncated() {
			return capacityFail(io, sources.files[i].path, "output buffer")
		}
		if err := io.WriteStdout(ob.Bytes()); err != nil {
			return err
		}
	}
	return nil
}

// parseSources parses a file or all `.fc` files of a directory as one
// package, appending the files to sources.files. It returns the range of
// the new files and the number of files with diagnostics. In parse mode
// (check == false) the diagnostics accumulate in errBuf in file order; in
// check mode they are added to the sorted diagnostic list. err is set for
// I/O and capacity failures (already reported on stderr).
driver func parseSources(fs FS, io Stdio, path string, check bool) (usize, usize, usize, error) {
	eb := &errBuf
	f0 := sources.nfiles
	nfiles := usize(0)
	single := !fs.IsDir(path)
	if !single {
		n, err := fs.ListSourceFiles(path, fileNames[:])
		if err != nil {
			return f0, f0, 0, ioFail(io, "open ", path, err)
		}
		if n == 0 {
			eb.Reset()
			eb.WriteString("finc1: ")
			eb.WriteString(path)
			eb.WriteString(": no .fc files in directory\n")
			if e := flushErr(io); e != nil {
				return f0, f0, 0, e
			}
			return f0, f0, 0, ErrNotFound
		}
		if f0+n > MaxFiles {
			return f0, f0, 0, capacityFail(io, path, "files")
		}
		for i := usize(0); i < n; i++ {
			fp := joinPath(path, fileNames[i])
			if len(strBytes(fp)) == 0 {
				return f0, f0, 0, capacityFail(io, path, "path too long")
			}
			sources.files[f0+i].path = fp
		}
		nfiles = n
	} else {
		if f0+1 > MaxFiles {
			return f0, f0, 0, capacityFail(io, path, "files")
		}
		sources.files[f0].path = path
		nfiles = 1
	}
	f1 := f0 + nfiles
	sources.nfiles = f1

	ndiag := usize(0)
	nincluded := usize(0)
	firstIncluded := usize(0)
	pkgName := ""
	tp := &tokens
	np := &nodes
	for i := f0; i < f1; i++ {
		fpath := sources.files[i].path
		sources.files[i].root = 0
		sources.files[i].ok = false
		st := sources.used
		n, err := fs.ReadFileInto(fpath, sources.bytes[st:])
		if err != nil {
			if single && err == ErrNotFound {
				return f0, f1, ndiag, ioFail(io, "stat ", fpath, err)
			}
			return f0, f1, ndiag, ioFail(io, "open ", fpath, err)
		}
		sources.files[i].start = st
		sources.files[i].size = n
		sources.used = st + n

		lx := newLexer(sources.bytes[st : st+n])
		lp := &lx
		if !tokenize(lp, tp) {
			return f0, f1, ndiag, capacityFail(io, fpath, "tokens")
		}

		lsp := &nodes.lists
		nodeMark := nodes.count
		listMark := lsp.Used()
		diagMark := eb.Len()
		p := Parser{
			toks: tp.Slice(),
			na:   np,
			ls:   lsp,
			diag: eb,
			src:  sources.bytes[:],
			fsrc: sources.bytes[st : st+n],
			base: u32(st),
			file: u16(i),
			path: fpath,
			ntok: tp.Len(),
		}
		pp := &p
		root := pp.run()
		if nodes.full || lsp.Full() || eb.Truncated() {
			eb.Truncate(diagMark)
			return f0, f1, ndiag, capacityFail(io, fpath, "AST nodes")
		}
		if root == 0 {
			nodes.count = nodeMark
			lsp.Truncate(listMark)
			lsp.Discard(0)
			ndiag++
			if check {
				addParseDiag(i, eb.Bytes()[diagMark:])
				eb.Truncate(diagMark)
			}
			continue
		}
		np.assignIDs(root, WalkDepth)

		// All files of a package must share its package clause.
		pkgID := nodes.items[usize(root)].a
		pk := nodes.items[usize(pkgID)]
		pkgText := sources.bytes[usize(pk.tOff) : usize(pk.tOff)+usize(pk.tLen)]
		if nincluded == 0 {
			pkgName = bytesToStr(pkgText)
			firstIncluded = i
		} else if !bytesEqual(pkgText, strBytes(pkgName)) {
			diagHeader(eb, fpath, pk.sLine, pk.sCol, E1001)
			eb.WriteString("package ")
			eb.WriteBytes(pkgText)
			eb.WriteString("; expected package ")
			eb.WriteString(pkgName)
			eb.WriteString(" (from ")
			eb.WriteString(sources.files[firstIncluded].path)
			eb.WriteString(")")
			diagEnd(eb)
			ndiag++
			if check {
				addParseDiag(i, eb.Bytes()[diagMark:])
				eb.Truncate(diagMark)
			}
			continue
		}
		sources.files[i].root = root
		sources.files[i].ok = true
		nincluded++
	}
	return f0, f1, ndiag, nil
}

// ---------------------------------------------------------------------------
// check

driver func checkUsage(io Stdio) error {
	if err := say(io, true, "usage: finc1 check [--comptime-fuel=N] <file.fc | dir>\n  -comptime-fuel uint\n    \tcomptime fuel budget per evaluation (default 1000000)\n"); err != nil {
		return err
	}
	return ErrParse
}

// runCheck implements `check [--comptime-fuel=N] <file.fc | dir>`.
driver func runCheck(fs FS, env Env, io Stdio) error {
	eb := &errBuf
	argc := env.ArgsCount()
	fuel := u64(DefaultFuel)
	operand := ""
	nops := usize(0)
	flagsDone := false
	skipNext := false
	for i := usize(2); i < argc; i++ {
		if skipNext {
			skipNext = false
			continue
		}
		a := env.Arg(i)
		ab := strBytes(a)
		isFlag := !flagsDone && nops == 0 && len(ab) > 1 && ab[0] == '-'
		if isFlag && strEq(a, "--") {
			flagsDone = true
			continue
		}
		if !isFlag {
			operand = a
			nops++
			continue
		}
		st := usize(1)
		if ab[1] == '-' {
			st = 2
		}
		eq := len(ab)
		for k := st; k < len(ab); k++ {
			if ab[k] == '=' {
				eq = k
				break
			}
		}
		name := ab[st:eq]
		if bytesEqual(name, strBytes("stats")) && eq == len(ab) {
			semaStats = true
			continue
		}
		if bytesEqual(name, strBytes("passes")) && eq < len(ab) {
			if !parsePasses(ab[eq+1:]) {
				eb.Reset()
				eb.WriteString("finc1 check: invalid --passes value ")
				putQuoted(eb, ab[eq+1:])
				eb.WriteString(" (want types, all or a list of passes)\n")
				if err := flushErr(io); err != nil {
					return err
				}
				return ErrParse
			}
			continue
		}
		if !bytesEqual(name, strBytes("comptime-fuel")) {
			eb.Reset()
			eb.WriteString("flag provided but not defined: -")
			eb.WriteBytes(name)
			eb.WriteByte('\n')
			if err := flushErr(io); err != nil {
				return err
			}
			return checkUsage(io)
		}
		val := ""
		if eq < len(ab) {
			val = bytesToStr(ab[eq+1:])
		} else if i+1 < argc {
			val = env.Arg(i + 1)
			skipNext = true
		} else {
			eb.Reset()
			eb.WriteString("flag needs an argument: -comptime-fuel\n")
			if err := flushErr(io); err != nil {
				return err
			}
			return checkUsage(io)
		}
		v, ok := strconv.ParseUint(strBytes(val), 10)
		if !ok {
			eb.Reset()
			eb.WriteString("invalid value ")
			putQuoted(eb, strBytes(val))
			eb.WriteString(" for flag -comptime-fuel: parse error\n")
			if err := flushErr(io); err != nil {
				return err
			}
			return checkUsage(io)
		}
		fuel = v
	}
	if nops != 1 {
		return checkUsage(io)
	}
	if fuel == 0 {
		if err := say(io, true, "finc1 check: --comptime-fuel must be positive\n"); err != nil {
			return err
		}
		return ErrParse
	}
	evalFuel = fuel
	return checkPath(fs, io, operand)
}

// printDiags writes the sorted diagnostics to stderr.
driver func printDiags(io Stdio) error {
	eb := &errBuf
	n := sortDiags()
	eb.Reset()
	for i := usize(0); i < n; i++ {
		eb.WriteBytes(diagLine(usize(diags.order[i])))
		eb.WriteByte('\n')
		if eb.Len() > MaxOutputBytes/2 {
			if err := flushErr(io); err != nil {
				return err
			}
		}
	}
	return flushErr(io)
}

// checkPath loads, resolves and type-checks the program rooted at path
// (module root = current directory), like finc0's check.Run restricted to
// the type-level passes.
driver func checkPath(fs FS, io Stdio, path string) error {
	sources.used = 0
	sources.nfiles = 0
	(&errBuf).Truncate(0)
	nameBlank = internStr("_")
	nameMain = internStr("main")
	f0, f1, _, err := parseSources(fs, io, path, true)
	if err != nil {
		return err
	}
	root, lerr := visitPackage(fs, io, f0, f1, "", cleanStr(path))
	if lerr != nil {
		return lerr
	}
	pkgs.root = root
	if semaFull || nodes.full {
		return capacityFail(io, path, semaFullWhat)
	}
	if diags.count > 0 {
		if err := printDiags(io); err != nil {
			return err
		}
		return ErrParse
	}
	resolveProgram()
	if semaFull || nodes.full {
		return capacityFail(io, path, semaFullWhat)
	}
	if diags.count > 0 {
		if err := printDiags(io); err != nil {
			return err
		}
		return ErrParse
	}
	checkProgram()
	if semaFull || nodes.full {
		return capacityFail(io, path, semaFullWhat)
	}
	runPasses()
	if semaFull || nodes.full {
		return capacityFail(io, path, semaFullWhat)
	}
	if semaStats {
		if err := printStats(io); err != nil {
			return err
		}
	}
	if diags.count > 0 {
		if err := printDiags(io); err != nil {
			return err
		}
		return ErrParse
	}
	return nil
}

var semaStats bool

func statLine(o *OutBuf, what string, used usize, capacity usize) {
	o.WriteString(what)
	o.WriteString(": ")
	o.WriteUint(u64(used))
	o.WriteString(" / ")
	o.WriteUint(u64(capacity))
	o.WriteByte('\n')
}

// printStats writes the arena usage (hidden flag --stats; capacity
// planning for compiler/ itself).
driver func printStats(io Stdio) error {
	o := &outBuf
	o.Reset()
	statLine(o, "files", sources.nfiles, MaxFiles)
	statLine(o, "source bytes", sources.used, MaxSourceBytes)
	statLine(o, "nodes", nodes.count, MaxNodes)
	statLine(o, "node list items", (&nodes.lists).Used(), MaxListItems)
	statLine(o, "names", (&names).Len(), MaxNames)
	statLine(o, "name bytes", (&names).Used(), MaxNameBytes)
	statLine(o, "symbols", syms.count, MaxSyms)
	statLine(o, "scopes", (&scopes).Len(), MaxScopes)
	statLine(o, "u32 lists", (&ulists).Used(), MaxULists)
	statLine(o, "cells", (&cells).Len(), MaxCells)
	statLine(o, "types", typs.count, MaxTypes)
	statLine(o, "type list items", typs.nlists, MaxTypeLists)
	statLine(o, "methods", meths.count, MaxMethods)
	statLine(o, "instances", insts.count, MaxInsts)
	statLine(o, "funcs", funcs.count, MaxFuncs)
	statLine(o, "calls", callTab.count, MaxCalls)
	statLine(o, "selections", selTab.count, MaxSels)
	statLine(o, "named types", nNamed, MaxNamed)
	statLine(o, "constant value slots", vals.ptop, VtabCap)
	statLine(o, "string pool bytes", nstr, MaxStrBytes)
	statLine(o, "diagnostics", diags.count, MaxDiags)
	return io.WriteStdout(o.Bytes())
}

// visitPackage registers the package made of sources.files[f0:f1] (state
// "visiting"), loads its imports depth-first and appends it to the
// dependency order (resolve/load.go: visit).
driver func visitPackage(fs FS, io Stdio, f0 usize, f1 usize, importPath string, key string) (u32, error) {
	if pkgs.count == 0 {
		pkgs.count = 1
	}
	if pkgs.count >= MaxPkgs {
		return 0, capacityFail(io, key, "packages")
	}
	pid := u32(pkgs.count)
	pkgs.count++
	name := u32(0)
	for i := f0; i < f1; i++ {
		if sources.files[i].ok {
			name = idName(nodes.items[usize(sources.files[i].root)].a)
			break
		}
	}
	if name == 0 {
		name = internStr("")
	}
	var pk Pkg
	pk.name = name
	pk.path = importPath
	pk.key = key
	pk.state = 1
	pk.f0 = f0
	pk.f1 = f1
	pkgs.items[usize(pid)] = pk
	var imps [MaxPkgs]u32
	nimps := usize(0)
	for i := f0; i < f1; i++ {
		if !sources.files[i].ok {
			continue
		}
		root := sources.files[i].root
		ni := l1len(root)
		for j := usize(0); j < ni; j++ {
			imp := l1at(root, j)
			nsp := l1len(imp)
			for k := usize(0); k < nsp; k++ {
				dep, err := loadImport(fs, io, l1at(imp, k))
				if err != nil {
					return 0, err
				}
				if dep == 0 {
					continue
				}
				seen := false
				for q := usize(0); q < nimps; q++ {
					if imps[q] == dep {
						seen = true
						break
					}
				}
				if !seen && nimps < MaxPkgs {
					imps[nimps] = dep
					nimps++
				}
			}
		}
	}
	mark := umark()
	for q := usize(0); q < nimps; q++ {
		upush(imps[q])
	}
	is, in := ucommit(mark)
	pkgs.items[usize(pid)].impS = is
	pkgs.items[usize(pid)].impN = in
	pkgs.items[usize(pid)].state = 2
	pkgs.order[pkgs.norder] = pid
	pkgs.norder++
	return pid, nil
}

// validImportPath: non-empty, relative, clean, slash-separated, not
// escaping the module root (decision 41).
func validImportPath(ip []byte) bool {
	n := len(ip)
	if n == 0 || ip[0] == '/' {
		return false
	}
	for i := usize(0); i < n; i++ {
		if ip[i] == '\\' {
			return false
		}
	}
	if n >= 2 && ip[0] == '.' && ip[1] == '.' {
		return false
	}
	var cb [MaxPathBytes]byte
	k := path.Clean(cb[:], ip)
	return bytesEqual(cb[:k], ip)
}

// isStdImport reports whether ip is "std" or starts with "std/".
func isStdImport(ip []byte) bool {
	return cgBytesIs(ip, "std") || cgBytesHasPrefix(ip, "std/")
}

// loadImport resolves one import spec (resolve/load.go: importSpec);
// problems are E2001/E2006 diagnostics.
driver func loadImport(fs FS, io Stdio, spec u32) (u32, error) {
	pathLit := nodes.items[usize(spec)].b
	ipb := importPathOf(spec)
	ip := bytesToStr(ipb)
	if !validImportPath(strBytes(ip)) {
		mreset()
		ms("invalid import path ")
		mquote(strBytes(ip))
		errAt(E2001, pathLit)
		return 0, nil
	}
	// std/... resolves against $FINCROOT when it is set (finc0:
	// resolve.StdDir); dir is then the cleaned $FINCROOT/<ip> and names
	// the package's files in diagnostics.
	dir := ip
	if len(strBytes(fincRoot)) > 0 && isStdImport(strBytes(ip)) {
		dir = joinPath(fincRoot, ip)
		if len(strBytes(dir)) == 0 {
			return 0, capacityFail(io, ip, "path too long")
		}
	}
	n := pkgs.count
	for p := usize(1); p < n; p++ {
		if strEq(pkgs.items[p].key, dir) {
			if pkgs.items[p].state == 1 {
				mreset()
				ms("import cycle not allowed: ")
				mquote(strBytes(ip))
				ms(" imports itself (directly or indirectly)")
				errAt(E2006, pathLit)
				return 0, nil
			}
			return u32(p), nil
		}
	}
	if !fs.IsDir(dir) {
		mreset()
		ms("cannot find package ")
		mquote(strBytes(ip))
		ms(" (no directory ")
		ms(dir)
		ms(")")
		errAt(E2001, pathLit)
		return 0, nil
	}
	cnt, lerr := fs.ListSourceFiles(dir, fileNames[:])
	if lerr != nil || cnt == 0 {
		mreset()
		ms("cannot find package ")
		mquote(strBytes(ip))
		ms(" (no .fc files in ")
		ms(dir)
		ms(")")
		errAt(E2001, pathLit)
		return 0, nil
	}
	f0, f1, _, err := parseSources(fs, io, dir, true)
	if err != nil {
		return 0, err
	}
	anyOK := false
	for i := f0; i < f1; i++ {
		if sources.files[i].ok {
			anyOK = true
		}
	}
	if !anyOK {
		return 0, nil
	}
	return visitPackage(fs, io, f0, f1, ip, dir)
}
