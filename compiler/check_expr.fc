// check_expr.fc — the type checker, part 2: expressions and calls (port of
// finc0's types/expr.go and types/call.go). All functions taking `dp` are
// members of the checker SCC (see checker.fc).
package main

// rawExpr checks e and records its type; the result may be untyped, a
// type, a builtin, a tuple, ...
func rawExpr(e u32, dp usize) Operand decreases(dp) {
	if dp == 0 {
		tooDeep()
		return invalidOp(e)
	}
	x := expr0(e, dp-1)
	x.expr = e
	m := x.mode
	if m == KValue || m == KVar || m == KConst || m == KType {
		if x.typ == 0 || isInvalid(x.typ) {
			x.mode = KNone
		}
	}
	if x.mode == KNone {
		x.typ = TyInvalid
	}
	record(&x)
	return x
}

// exprValue checks that e denotes a single value.
func exprValue(e u32, dp usize) Operand decreases(dp) {
	if dp == 0 {
		tooDeep()
		return invalidOp(e)
	}
	x := rawExpr(e, dp-1)
	singleValue(&x)
	return x
}

// exprWith checks e and assigns it to type t.
func exprWith(e u32, t u32, c Ctx, dp usize) Operand decreases(dp) {
	if dp == 0 {
		tooDeep()
		return invalidOp(e)
	}
	x := exprValue(e, dp-1)
	if !isInvalidOp(&x) {
		_ = assignment(&x, t, c)
	}
	return x
}

// stringLitVal decodes a STRING BasicLit into a string value.
func stringLitVal(e u32) Val {
	t := &tmpBuf
	t.reset()
	decodeStringLit(t, ntext(e))
	return vStr(tmpBuf.data[:tmpBuf.len])
}

func expr0(e u32, dp usize) Operand decreases(dp) {
	if dp == 0 {
		tooDeep()
		return invalidOp(e)
	}
	k := nkind(e)
	if k == NkIdent {
		sym := uses[usize(e)]
		if sym == 0 {
			return invalidOp(e)
		}
		return symOperand(sym, e, dp-1)
	}
	if k == NkBasicLit {
		lk := nop(e)
		if lk == LitInt {
			return opConst(TyUntypedInt, vIntU(nival(e)))
		}
		if lk == LitChar {
			return opConst(TyUntypedChar, vIntU(nival(e)))
		}
		return opConst(TyUntypedString, stringLitVal(e))
	}
	if k == NkBoolLit {
		return opConst(TyUntypedBool, vBool(nflag(e)))
	}
	if k == NkNilLit {
		return opConst(TyUntypedNil, vNilV())
	}
	if k == NkParenExpr {
		x := rawExpr(na(e), dp-1)
		x.expr = e
		return x
	}
	if k == NkBinaryExpr {
		return binaryExpr(e, dp-1)
	}
	if k == NkUnaryExpr {
		return unaryExpr(e, dp-1)
	}
	if k == NkCallExpr {
		return callExpr(e, dp-1)
	}
	if k == NkIndexExpr {
		return indexExpr(e, dp-1)
	}
	if k == NkSliceExpr {
		return sliceExpr(e, dp-1)
	}
	if k == NkSelectorExpr {
		return selectorExpr(e, dp-1)
	}
	if k == NkFuncLit {
		return funcLit(e, dp-1)
	}
	if k == NkStructLit {
		return structLit(e, dp-1)
	}
	if k == NkTypeExpr {
		t := typExpr(na(e), dp-1)
		if isInvalid(t) {
			return invalidOp(e)
		}
		return opMode(KType, t)
	}
	return invalidOp(e)
}

func symOperand(sym u32, id u32, dp usize) Operand decreases(dp) {
	if dp == 0 {
		tooDeep()
		return invalidOp(id)
	}
	k := symKind(sym)
	if k == SymConst {
		t := symType(sym, dp-1)
		v := syms.items[usize(sym)].val
		if isInvalid(t) || v == 0 {
			return invalidOp(id)
		}
		return opConst(t, slotGet(v))
	}
	if k == SymVar {
		t := symType(sym, dp-1)
		if isInvalid(t) {
			return invalidOp(id)
		}
		return opMode(KVar, t)
	}
	if k == SymType {
		t := typeSym(sym, id, dp-1)
		if isInvalid(t) {
			return invalidOp(id)
		}
		return opMode(KType, t)
	}
	if k == SymTypeParam {
		tp := symType(sym, dp-1)
		if tp == 0 || tk(tp) != TCTypeParam {
			return invalidOp(id)
		}
		if tpIsConst(tp) {
			return opMode(KValue, typs.items[usize(tp)].a)
		}
		return opMode(KType, tp)
	}
	if k == SymFunc {
		t := symType(sym, dp-1)
		if isInvalid(t) {
			return invalidOp(id)
		}
		x := opMode(KFunc, t)
		x.sym = sym
		return x
	}
	if k == SymBuiltin || k == SymPackage {
		x := opMode(KBuiltin, TyInvalid)
		if k == SymPackage {
			x.mode = KPackage
		}
		x.sym = sym
		return x
	}
	return invalidOp(id)
}

// ---------------------------------------------------------------------------
// Operators

func binaryExpr(e u32, dp usize) Operand decreases(dp) {
	if dp == 0 {
		tooDeep()
		return invalidOp(e)
	}
	x := exprValue(na(e), dp-1)
	y := exprValue(nb(e), dp-1)
	if isInvalidOp(&x) || isInvalidOp(&y) {
		return invalidOp(e)
	}
	op := nop(e)
	if isTypeParamT(x.typ) || isTypeParamT(y.typ) {
		mreset()
		ms("operator ")
		ms(binOpString(op))
		ms(" inspects a value of type parameter type (")
		mtype(x.typ)
		ms(", ")
		mtype(y.typ)
		ms(")")
		errAtOp(E2011, e)
		return invalidOp(e)
	}
	if op == OpShl || op == OpShr {
		return shiftExpr(e, &x, &y)
	}
	if isCompareOp(op) {
		return comparisonExpr(e, &x, &y)
	}
	if !matchTypes(e, &x, &y) {
		return invalidOp(e)
	}
	t := x.typ
	if op == OpLAnd || op == OpLOr {
		if !isBoolean(t) {
			mreset()
			ms("operator ")
			ms(binOpString(op))
			ms(" not defined on ")
			mexpr(na(e))
			ms(" (type ")
			mtype(t)
			ms(")")
			errAtOp(E2002, e)
			return invalidOp(e)
		}
	} else if !isInteger(t) {
		mreset()
		ms("operator ")
		ms(binOpString(op))
		ms(" not defined on ")
		mexpr(na(e))
		ms(" (type ")
		mtype(t)
		ms(")")
		errAtOp(E2002, e)
		return invalidOp(e)
	}
	if (op == OpDiv || op == OpRem) && y.mode == KConst {
		if y.val.kind == VInt && y.val.hi == 0 && y.val.lo == 0 && y.val.flag&1 == 0 {
			mreset()
			ms("division by zero")
			errAt(E2002, nb(e))
			return invalidOp(e)
		}
	}
	if x.mode == KConst && y.mode == KConst {
		v, ok := binaryOpVal(op, x.val, y.val)
		if !ok {
			mreset()
			ms("constant evaluation: ")
			mbytes(errTxt.data[:errTxt.len])
			errAtOp(E2002, e)
			return invalidOp(e)
		}
		if !isUntyped(t) && !representable(v, t) {
			mreset()
			ms("constant ")
			mval(v)
			ms(" overflows ")
			mtype(t)
			errAt(E2002, e)
			return invalidOp(e)
		}
		return opConst(t, v)
	}
	return opMode(KValue, t)
}

// matchTypes converts untyped operands to the other operand's type and
// requires identical types.
func matchTypes(e u32, x *Operand, y *Operand) bool {
	xu := isUntyped(x.typ)
	yu := isUntyped(y.typ)
	op := nop(e)
	if xu && !yu {
		if !convertUntyped(x, y.typ) {
			return false
		}
	} else if yu && !xu {
		if !convertUntyped(y, x.typ) {
			return false
		}
	} else if xu && yu {
		kx := basicKind(x.typ)
		ky := basicKind(y.typ)
		if kx != ky {
			if (kx == BkUntypedInt || kx == BkUntypedChar) && (ky == BkUntypedInt || ky == BkUntypedChar) {
				x.typ = TyUntypedChar
				y.typ = TyUntypedChar
				return true
			}
			mreset()
			if kx == BkUntypedNil || ky == BkUntypedNil {
				ms("invalid operation: operator ")
				ms(binOpString(op))
				ms(" on untyped nil")
				errAtOp(E2004, e)
				return false
			}
			ms("mismatched types ")
			mtype(x.typ)
			ms(" and ")
			mtype(y.typ)
			errAtOp(E2002, e)
			return false
		}
		return true
	}
	if x.typ != y.typ {
		mreset()
		ms("mismatched types ")
		mtype(x.typ)
		ms(" and ")
		mtype(y.typ)
		ms(" for operator ")
		ms(binOpString(op))
		errAtOp(E2002, e)
		return false
	}
	return true
}

func shiftExpr(e u32, x *Operand, y *Operand) Operand {
	op := nop(e)
	if !isInteger(y.typ) {
		mreset()
		ms("shift count ")
		mexpr(nb(e))
		ms(" must be an integer")
		errAt(E2002, nb(e))
		return invalidOp(e)
	}
	if isUntyped(y.typ) {
		if y.val.kind == VInt && intSign(y.val) < 0 {
			mreset()
			ms("negative shift count ")
			mval(y.val)
			errAt(E2002, nb(e))
			return invalidOp(e)
		}
		_ = convertUntyped(y, TyUsize)
	}
	if !isInteger(x.typ) {
		mreset()
		ms("shifted operand ")
		mexpr(na(e))
		ms(" must be an integer")
		errAt(E2002, na(e))
		return invalidOp(e)
	}
	if x.mode == KConst && y.mode == KConst {
		v, ok := binaryOpVal(op, x.val, y.val)
		if !ok {
			mreset()
			ms("constant evaluation: ")
			mbytes(errTxt.data[:errTxt.len])
			errAtOp(E2002, e)
			return invalidOp(e)
		}
		if !isUntyped(x.typ) && !representable(v, x.typ) {
			mreset()
			ms("constant ")
			mval(v)
			ms(" overflows ")
			mtype(x.typ)
			errAt(E2002, e)
			return invalidOp(e)
		}
		return opConst(x.typ, v)
	}
	if isUntyped(x.typ) {
		_ = convertUntyped(x, defaultOf(x.typ))
	}
	return opMode(KValue, x.typ)
}

func comparisonExpr(e u32, x *Operand, y *Operand) Operand {
	op := nop(e)
	xn := basicKind(x.typ) == BkUntypedNil
	yn := basicKind(y.typ) == BkUntypedNil
	if xn && yn {
		mreset()
		ms("invalid operation: nil ")
		ms(binOpString(op))
		ms(" nil")
		errAtOp(E2002, e)
		return invalidOp(e)
	}
	if xn || yn {
		ok := false
		if yn {
			ok = convertUntyped(y, x.typ)
		} else {
			ok = convertUntyped(x, y.typ)
		}
		if !ok {
			return invalidOp(e)
		}
		if op != OpEq && op != OpNe {
			mreset()
			ms("operator ")
			ms(binOpString(op))
			ms(" not defined on nil")
			errAtOp(E2002, e)
			return invalidOp(e)
		}
		return opMode(KValue, TyBool)
	}
	if !matchTypes(e, x, y) {
		return invalidOp(e)
	}
	t := x.typ
	if op == OpEq || op == OpNe {
		if !comparable(t, SemaDepth) {
			mreset()
			ms("operator ")
			ms(binOpString(op))
			ms(" not defined on ")
			mexpr(na(e))
			ms(" (type ")
			mtype(t)
			ms(" is not comparable)")
			errAtOp(E2002, e)
			return invalidOp(e)
		}
	} else if !isInteger(t) && !isString(t) {
		mreset()
		ms("operator ")
		ms(binOpString(op))
		ms(" not defined on ")
		mexpr(na(e))
		ms(" (type ")
		mtype(t)
		ms(" is not ordered)")
		errAtOp(E2002, e)
		return invalidOp(e)
	}
	if x.mode == KConst && y.mode == KConst {
		v, ok := binaryOpVal(op, x.val, y.val)
		if !ok {
			mreset()
			ms("constant evaluation: ")
			mbytes(errTxt.data[:errTxt.len])
			errAtOp(E2002, e)
			return invalidOp(e)
		}
		return opConst(TyUntypedBool, v)
	}
	if isUntyped(x.typ) {
		_ = convertUntyped(x, defaultOf(x.typ))
		_ = convertUntyped(y, defaultOf(y.typ))
	}
	return opMode(KValue, TyBool)
}

func unaryExpr(e u32, dp usize) Operand decreases(dp) {
	if dp == 0 {
		tooDeep()
		return invalidOp(e)
	}
	op := nop(e)
	if op == OpAddr {
		x := exprValue(na(e), dp-1)
		if isInvalidOp(&x) {
			return invalidOp(e)
		}
		if x.mode != KVar {
			mreset()
			ms("cannot take the address of ")
			mexpr(na(e))
			errAt(E2002, e)
			return invalidOp(e)
		}
		return opMode(KValue, mkPointer(x.typ))
	}
	if op == OpDeref {
		x := rawExpr(na(e), dp-1)
		if x.mode == KType {
			return opMode(KType, mkPointer(x.typ))
		}
		singleValue(&x)
		if isInvalidOp(&x) {
			return invalidOp(e)
		}
		u := underlying(x.typ)
		if tk(u) != TCPointer {
			mreset()
			ms("cannot dereference ")
			mexpr(na(e))
			ms(" (type ")
			mtype(x.typ)
			ms(" is not a pointer)")
			errAt(E2002, e)
			return invalidOp(e)
		}
		return opMode(KVar, elemOf(u))
	}
	x := exprValue(na(e), dp-1)
	if isInvalidOp(&x) {
		return invalidOp(e)
	}
	if isTypeParamT(x.typ) {
		mreset()
		ms("operator ")
		ms(unaryOpString(op))
		ms(" inspects a value of type parameter type ")
		mtype(x.typ)
		errAt(E2011, e)
		return invalidOp(e)
	}
	if op == OpNot && !isBoolean(x.typ) {
		mreset()
		ms("operator ! not defined on ")
		mexpr(na(e))
		ms(" (type ")
		mtype(x.typ)
		ms(")")
		errAt(E2002, e)
		return invalidOp(e)
	}
	if op == OpNeg && !isInteger(x.typ) {
		mreset()
		ms("operator - not defined on ")
		mexpr(na(e))
		ms(" (type ")
		mtype(x.typ)
		ms(")")
		errAt(E2002, e)
		return invalidOp(e)
	}
	if x.mode == KConst {
		v, ok := unaryOpVal(op, x.val)
		if !ok {
			mreset()
			ms("constant evaluation: ")
			mbytes(errTxt.data[:errTxt.len])
			errAt(E2002, e)
			return invalidOp(e)
		}
		if !isUntyped(x.typ) && !representable(v, x.typ) {
			mreset()
			ms("constant ")
			mval(v)
			ms(" overflows ")
			mtype(x.typ)
			errAt(E2002, e)
			return invalidOp(e)
		}
		return opConst(x.typ, v)
	}
	return opMode(KValue, x.typ)
}

// ---------------------------------------------------------------------------
// Index and slice expressions

// indexArg checks an index expression; it returns (value, hasValue, ok).
func indexArg(e u32, dp usize) (Val, bool, bool) decreases(dp) {
	var z Val
	if dp == 0 {
		tooDeep()
		return z, false, false
	}
	x := exprValue(e, dp-1)
	if isInvalidOp(&x) {
		return z, false, false
	}
	if !isInteger(x.typ) {
		mreset()
		ms("index ")
		mexpr(e)
		ms(" must be an integer (have ")
		mtype(x.typ)
		ms(")")
		errAt(E2002, e)
		return z, false, false
	}
	if x.mode == KConst && x.val.kind == VInt && intSign(x.val) < 0 {
		mreset()
		ms("index ")
		mval(x.val)
		ms(" must not be negative")
		errAt(E4003, e)
		return z, false, false
	}
	if isUntyped(x.typ) && !convertUntyped(&x, TyUsize) {
		return z, false, false
	}
	if x.mode == KConst {
		return x.val, true, true
	}
	return z, false, true
}

func indexExpr(e u32, dp usize) Operand decreases(dp) {
	if dp == 0 {
		tooDeep()
		return invalidOp(e)
	}
	x := rawExpr(na(e), dp-1)
	if x.mode == KNone {
		n := l1len(e)
		for i := usize(0); i < n; i++ {
			_ = rawExpr(l1at(e, i), dp-1)
		}
		return invalidOp(e)
	}
	if x.mode == KFunc && x.method == 0 {
		return funcInstance(e, &x, dp-1)
	}
	if x.mode == KType {
		if tk(x.typ) != TCNamed || tl2n(x.typ) == 0 {
			mreset()
			mtype(x.typ)
			ms(" is not a generic type")
			errAt(E2002, e)
			return invalidOp(e)
		}
		t := instantiateArgs(x.typ, e, e, e, dp-1)
		if isInvalid(t) {
			return invalidOp(e)
		}
		return opMode(KType, t)
	}
	singleValue(&x)
	if isInvalidOp(&x) {
		return invalidOp(e)
	}
	if l1len(e) != 1 {
		mreset()
		mexpr(na(e))
		ms(" cannot be indexed with ")
		mu(u64(l1len(e)))
		ms(" indices")
		errAt(E2003, e)
		return invalidOp(e)
	}
	i0 := l1at(e, 0)
	idx, has, ok := indexArg(i0, dp-1)
	if !ok {
		return invalidOp(e)
	}
	t := x.typ
	mode := x.mode
	u := underlying(t)
	if tk(u) == TCPointer && tk(underlying(elemOf(u))) == TCArray {
		t = elemOf(u)
		mode = KVar
	}
	u = underlying(t)
	k := tk(u)
	if k == TCArray {
		r := typs.items[usize(u)]
		if has && r.b == 0 {
			n, _ := valUint64(idx)
			if n >= r.n {
				mreset()
				ms("index ")
				mval(idx)
				ms(" out of bounds for array of length ")
				mu(r.n)
				errAt(E4003, i0)
				return invalidOp(e)
			}
		}
		if mode != KVar {
			mode = KValue
		}
		return opMode(mode, r.a)
	}
	if k == TCSlice {
		return opMode(KVar, elemOf(u))
	}
	if k == TCBasic && isString(u) {
		if x.mode == KConst && has {
			sb := strOf(x.val)
			n, _ := valUint64(idx)
			if n >= u64(len(sb)) {
				mreset()
				ms("index ")
				mval(idx)
				ms(" out of bounds for string of length ")
				mu(u64(len(sb)))
				errAt(E4003, i0)
				return invalidOp(e)
			}
			return opConst(TyU8, vIntU(u64(sb[usize(n)])))
		}
		return opMode(KValue, TyU8)
	}
	mreset()
	ms("cannot index ")
	mexpr(na(e))
	ms(" (type ")
	mtype(x.typ)
	ms(")")
	errAt(E2002, e)
	return invalidOp(e)
}

func sliceExpr(e u32, dp usize) Operand decreases(dp) {
	if dp == 0 {
		tooDeep()
		return invalidOp(e)
	}
	x := exprValue(na(e), dp-1)
	var lo Val
	var hi Val
	hasLo := false
	hasHi := false
	okAll := !isInvalidOp(&x)
	if nb(e) != 0 {
		v, has, ok := indexArg(nb(e), dp-1)
		lo = v
		hasLo = has
		okAll = okAll && ok
	}
	if nc(e) != 0 {
		v, has, ok := indexArg(nc(e), dp-1)
		hi = v
		hasHi = has
		okAll = okAll && ok
	}
	if !okAll {
		return invalidOp(e)
	}
	if hasLo && hasHi {
		l, _ := valUint64(lo)
		h, _ := valUint64(hi)
		if l > h {
			mreset()
			ms("invalid slice indices: ")
			mu(l)
			ms(" > ")
			mu(h)
			errAt(E4003, e)
			return invalidOp(e)
		}
	}
	t := x.typ
	addressable := x.mode == KVar
	u := underlying(t)
	if tk(u) == TCPointer && tk(underlying(elemOf(u))) == TCArray {
		t = elemOf(u)
		addressable = true
	}
	u = underlying(t)
	k := tk(u)
	if k == TCArray {
		if !addressable {
			mreset()
			ms("cannot slice ")
			mexpr(na(e))
			ms(" (value not addressable)")
			errAt(E2002, e)
			return invalidOp(e)
		}
		r := typs.items[usize(u)]
		if r.b == 0 {
			for q := usize(0); q < 2; q++ {
				b := lo
				hb := hasLo
				if q == 1 {
					b = hi
					hb = hasHi
				}
				if !hb {
					continue
				}
				n, ok := valUint64(b)
				if ok && n > r.n {
					mreset()
					ms("slice bound ")
					mu(n)
					ms(" out of range for array of length ")
					mu(r.n)
					errAt(E4003, e)
					return invalidOp(e)
				}
			}
		}
		return opMode(KValue, mkSlice(r.a))
	}
	if k == TCSlice {
		return opMode(KValue, t)
	}
	if k == TCBasic && isString(u) {
		if isUntyped(x.typ) {
			_ = convertUntyped(&x, TyString)
			t = TyString
		}
		return opMode(KValue, t)
	}
	mreset()
	ms("cannot slice ")
	mexpr(na(e))
	ms(" (type ")
	mtype(x.typ)
	ms(")")
	errAt(E2002, e)
	return invalidOp(e)
}

func newSel(s Selection) u32 {
	if selTab.count == 0 {
		selTab.count = 1
	}
	if selTab.count >= MaxSels {
		setFull("selections")
		return 0
	}
	id := selTab.count
	selTab.count++
	selTab.items[id] = s
	return u32(id)
}

func selectorExpr(e u32, dp usize) Operand decreases(dp) {
	if dp == 0 {
		tooDeep()
		return invalidOp(e)
	}
	sel := nb(e)
	psym := uses[usize(sel)]
	if psym != 0 {
		if nkind(na(e)) == NkIdent {
			nmode[usize(na(e))] = KPackage
		}
		x := symOperand(psym, sel, dp-1)
		x.expr = sel
		record(&x)
		return x
	}
	x := rawExpr(na(e), dp-1)
	if x.mode == KNone || x.mode == KPackage {
		return invalidOp(e)
	}
	name := idName(sel)
	if x.mode == KType {
		en := underlying(x.typ)
		if tk(en) != TCEnum {
			mreset()
			mexpr(na(e))
			mbyte('.')
			mname(name)
			ms(" undefined (type ")
			mtype(x.typ)
			ms(" is not an enum; method expressions are not supported)")
			errAt(E2001, sel)
			return invalidOp(e)
		}
		vi, found := variantByName(en, name)
		if !found {
			mreset()
			mexpr(na(e))
			mbyte('.')
			mname(name)
			ms(" undefined (enum ")
			mtype(x.typ)
			ms(" has no variant ")
			mname(name)
			ms(")")
			errAt(E2001, sel)
			return invalidOp(e)
		}
		var s Selection
		s.kind = SelVariant
		s.recv = x.typ
		s.ctype = en
		s.index = u32(vi)
		nsel[usize(e)] = newSel(s)
		if variantPayN(en, vi) == 0 {
			var ev Val
			ev.kind = VEnum
			ev.lo = u64(vi)
			return opConst(x.typ, ev)
		}
		r := opMode(KVariantCtor, x.typ)
		r.vEnum = en
		r.vIndex = u32(vi)
		return r
	}
	singleValue(&x)
	if isInvalidOp(&x) {
		return invalidOp(e)
	}
	t := x.typ
	indirect := false
	if tk(underlying(t)) == TCPointer {
		t = elemOf(underlying(t))
		indirect = true
	}
	st := underlying(t)
	if tk(st) == TCStruct {
		fi, found := fieldByName(st, name)
		if found {
			var s Selection
			s.kind = SelField
			s.recv = x.typ
			s.indirect = indirect
			s.ctype = st
			s.index = u32(fi)
			nsel[usize(e)] = newSel(s)
			ft := fieldType(st, fi)
			ntype[usize(sel)] = ft
			mode := u8(KValue)
			if x.mode == KVar || indirect {
				mode = KVar
			}
			return opMode(mode, ft)
		}
	}
	if tk(t) == TCNamed {
		m := lookupMethod(t, name, dp-1)
		if m != 0 {
			var s Selection
			s.kind = SelMethod
			s.recv = x.typ
			s.indirect = indirect && !meths.items[usize(m)].ptrRecv
			s.method = m
			nsel[usize(e)] = newSel(s)
			r := opMode(KFunc, TyInvalid)
			r.method = m
			r.recv = na(e)
			r.recvType = x.typ
			r.indirect = indirect
			return r
		}
	}
	mreset()
	mexpr(na(e))
	mbyte('.')
	mname(name)
	ms(" undefined (type ")
	mtype(x.typ)
	ms(" has no field or method ")
	mname(name)
	ms(")")
	errAt(E2001, sel)
	return invalidOp(e)
}

func structLit(e u32, dp usize) Operand decreases(dp) {
	if dp == 0 {
		tooDeep()
		return invalidOp(e)
	}
	t := typExpr(na(e), dp-1)
	nfi := l1len(e)
	if isInvalid(t) {
		for i := usize(0); i < nfi; i++ {
			_ = rawExpr(nb(l1at(e, i)), dp-1)
		}
		return invalidOp(e)
	}
	st := underlying(t)
	if tk(st) != TCStruct {
		mreset()
		ms("invalid composite literal type ")
		mtype(t)
		ms(" (not a struct)")
		errAt(E2002, na(e))
		return invalidOp(e)
	}
	allConst := true
	for i := usize(0); i < nfi; i++ {
		fi := l1at(e, i)
		fname := idName(na(fi))
		idx, found := fieldByName(st, fname)
		if !found {
			mreset()
			ms("unknown field ")
			mname(fname)
			ms(" in struct literal of type ")
			mtype(t)
			errAt(E2001, na(fi))
			_ = rawExpr(nb(fi), dp-1)
			allConst = false
			continue
		}
		for j := usize(0); j < i; j++ {
			if idName(na(l1at(e, j))) == fname {
				mreset()
				ms("duplicate field ")
				mname(fname)
				ms(" in struct literal")
				errAt(E2002, na(fi))
				break
			}
		}
		ft := fieldType(st, idx)
		ntype[usize(na(fi))] = ft
		x := exprWith(nb(fi), ft, mkCtx(CtxStructLit), dp-1)
		if x.mode != KConst {
			allConst = false
		}
	}
	nf := nfields(st)
	for i := usize(0); i < nf; i++ {
		fname := fieldName(st, i)
		set := false
		for j := usize(0); j < nfi; j++ {
			if idName(na(l1at(e, j))) == fname {
				set = true
				break
			}
		}
		if !set && isScoped(fieldType(st, i)) {
			mreset()
			ms("missing initializer for field ")
			mname(fname)
			ms(" of Scoped type ")
			mtype(fieldType(st, i))
			errAt(E2005, e)
		}
	}
	if allConst && classOfT(t) == ClassValue {
		v, ok := structValue(e, st)
		if ok {
			return opConst(t, v)
		}
	}
	return opMode(KValue, t)
}

// structValue builds the constant value of a struct literal whose fields
// are all constant.
func structValue(e u32, st u32) (Val, bool) {
	z, ok := zeroVal(st, false)
	if !ok {
		return z, false
	}
	n := l1len(e)
	for i := usize(0); i < n; i++ {
		fi := l1at(e, i)
		idx, found := fieldByName(st, idName(na(fi)))
		if found {
			vs := nval[usize(nb(fi))]
			if vs == 0 {
				return z, false
			}
			slotSet(z.ref+u32(idx), slotGet(vs))
		}
	}
	return z, true
}

func funcLit(e u32, dp usize) Operand decreases(dp) {
	if dp == 0 {
		tooDeep()
		return invalidOp(e)
	}
	eff := u8(EffTotal)
	if nflag(e) {
		eff = EffDriver
	}
	sig := signature(na(e), eff, 0, 0, dp-1)
	var fi FuncInfo
	fi.lit = e
	fi.outer = chkFn
	fi.effect = eff
	fi.sig = sig
	fi.body = nb(e)
	fid := newFuncInfo(fi)
	if fid == 0 {
		return invalidOp(e)
	}
	nfunc[usize(e)] = fid
	ps, pn := paramSyms(na(e), sig)
	funcs.items[usize(fid)].parS = ps
	funcs.items[usize(fid)].parN = pn
	if chkFn != 0 {
		h, t := cellAppend(funcs.items[usize(chkFn)].litH, funcs.items[usize(chkFn)].litT, fid)
		funcs.items[usize(chkFn)].litH = h
		funcs.items[usize(chkFn)].litT = t
	} else {
		mreset()
		ms("function literal outside a function")
		errAt(E2002, e)
	}
	c := enterFn(fid)
	funcBody(fid, dp-1)
	restoreFn(c)
	return opMode(KValue, sig)
}

// ---------------------------------------------------------------------------
// Calls (call.go)

func newCall() u32 {
	if callTab.count == 0 {
		callTab.count = 1
	}
	if callTab.count >= MaxCalls {
		setFull("calls")
		return 0
	}
	id := callTab.count
	callTab.count++
	var c Call
	c.effect = EffTotal
	callTab.items[id] = c
	return u32(id)
}

func callExpr(e u32, dp usize) Operand decreases(dp) {
	if dp == 0 {
		tooDeep()
		return invalidOp(e)
	}
	x := call0(e, dp-1)
	ci := ncall[usize(e)]
	if ci != 0 && callTab.items[usize(ci)].method != 0 && callTab.items[usize(ci)].sig != 0 {
		ntype[usize(na(e))] = callTab.items[usize(ci)].sig
	}
	return x
}

// useArgs checks the arguments [from:] of an erroneous call.
func useArgs(e u32, from usize, dp usize) decreases(dp) {
	if dp == 0 {
		tooDeep()
		return
	}
	n := l1len(e)
	for i := from; i < n; i++ {
		_ = rawExpr(l1at(e, i), dp-1)
	}
}

func callResultType(sig u32) Operand {
	r := sigResultType(sig)
	if r == 0 {
		return opMode(KNoValue, 0)
	}
	return opMode(KValue, r)
}

// shouldFold: comptime calls are evaluated at compile time except inside
// comptime bodies outside constant contexts.
func shouldFold() bool {
	return !(chkFn != 0 && funcs.items[usize(chkFn)].effect == EffComptime && chkConstCtx == 0)
}

func call0(e u32, dp usize) Operand decreases(dp) {
	if dp == 0 {
		tooDeep()
		return invalidOp(e)
	}
	fun := rawExpr(na(e), dp-1)
	ci := newCall()
	if ci == 0 {
		return invalidOp(e)
	}
	ncall[usize(e)] = ci
	if chkFn != 0 {
		h, t := cellAppend(funcs.items[usize(chkFn)].callH, funcs.items[usize(chkFn)].callT, e)
		funcs.items[usize(chkFn)].callH = h
		funcs.items[usize(chkFn)].callT = t
	}
	m := fun.mode
	if m == KType {
		return conversion(e, fun.typ, ci, dp-1)
	}
	if m == KBuiltin {
		return builtinCall(e, fun.sym, ci, dp-1)
	}
	if m == KVariantCtor {
		return variantCall(e, &fun, ci, dp-1)
	}
	if m == KFunc {
		if fun.method != 0 {
			return methodCall(e, &fun, ci, dp-1)
		}
		sig := fun.typ
		if sig == 0 || tk(sig) != TCSig {
			useArgs(e, 0, dp-1)
			return invalidOp(e)
		}
		if sigNTParams(sig) > 0 {
			mreset()
			ms("cannot call generic function ")
			mexpr(na(e))
			ms(" without instantiation (type arguments must be explicit, e.g. ")
			mexpr(na(e))
			ms("[T](...))")
			errAt(E2002, na(e))
			useArgs(e, 0, dp-1)
			return invalidOp(e)
		}
		callTab.items[usize(ci)].kind = CallFunc
		callTab.items[usize(ci)].callee = fun.sym
		callTab.items[usize(ci)].sig = sig
		callTab.items[usize(ci)].effect = sigEffect(sig)
		inst := ninst[usize(unparen(na(e)))]
		if inst != 0 {
			callTab.items[usize(ci)].taS = insts.items[usize(inst)].argS
			callTab.items[usize(ci)].taN = insts.items[usize(inst)].argN
		}
		mark := opStack.top
		ok := arguments(e, sigParamsSlice(sig), sigVariadic(sig), Ctx{kind: CtxArgExpr, a: na(e), b: 0}, dp-1)
		if !ok {
			opStack.top = mark
			return invalidOp(e)
		}
		if sigEffect(sig) == EffComptime && shouldFold() {
			r := foldComptime(e, fun.sym, sig, mark, ci, dp-1)
			opStack.top = mark
			return r
		}
		opStack.top = mark
		return callResultType(sig)
	}
	if m == KValue || m == KVar {
		sig := underlying(fun.typ)
		if tk(sig) != TCSig {
			mreset()
			ms("cannot call non-function ")
			mexpr(na(e))
			ms(" (type ")
			mtype(fun.typ)
			ms(")")
			errAt(E2002, na(e))
			useArgs(e, 0, dp-1)
			return invalidOp(e)
		}
		callTab.items[usize(ci)].kind = CallValue
		callTab.items[usize(ci)].sig = sig
		callTab.items[usize(ci)].effect = sigEffect(sig)
		if builtinOf(fun.typ) == BTCancelFunc {
			callTab.items[usize(ci)].consumesRecv = true
		}
		mark := opStack.top
		_ = arguments(e, sigParamsSlice(sig), sigVariadic(sig), Ctx{kind: CtxArgExpr, a: na(e), b: 0}, dp-1)
		opStack.top = mark
		return callResultType(sig)
	}
	if m == KPackage {
		mreset()
		ms("cannot call package ")
		mexpr(na(e))
		errAt(E2002, na(e))
	}
	useArgs(e, 0, dp-1)
	return invalidOp(e)
}

// arguments checks call arguments against parameter types; the argument
// operands are left on opStack (from the mark at entry) for the caller.
func arguments(e u32, params []u32, variadic bool, c Ctx, dp usize) bool decreases(dp) {
	if dp == 0 {
		tooDeep()
		return false
	}
	mark := opStack.top
	nargs := l1len(e)
	for i := usize(0); i < nargs; i++ {
		x := rawExpr(l1at(e, i), dp-1)
		opPush(x)
	}
	if nargs == 1 && opStack.items[mark].mode == KValue {
		t0 := opStack.items[mark].typ
		if t0 != 0 && tk(t0) == TCTuple {
			first := opStack.items[mark]
			opStack.top = mark
			nt := tl1n(t0)
			for i := usize(0); i < nt; i++ {
				x := opMode(KValue, tl1(t0, i))
				x.expr = first.expr
				opPush(x)
			}
		}
	}
	ok := true
	top := opStack.top
	for i := mark; i < top; i++ {
		t := opStack.items[i].typ
		if t != 0 && tk(t) == TCTuple && nargs == 1 {
			continue
		}
		singleValue(&opStack.items[i])
		if opStack.items[i].mode == KNone {
			ok = false
		}
	}
	n := top - mark
	np := len(params)
	if (variadic && n+1 < np) || (!variadic && n != np) {
		mreset()
		if n > np {
			ms("too many")
		} else {
			ms("not enough")
		}
		ms(" arguments in call to ")
		mcallName(c)
		ms(": have ")
		mu(u64(n))
		ms(", want ")
		mu(u64(np))
		errAt(E2003, e)
		return false
	}
	for i := usize(0); i < n; i++ {
		if opStack.items[mark+i].mode == KNone {
			continue
		}
		pi := i
		if pi > np-1 {
			pi = np - 1
		}
		if !assignment(&opStack.items[mark+i], params[pi], c) {
			ok = false
		}
	}
	return ok
}

func foldComptime(e u32, fn u32, sig u32, mark usize, ci u32, dp usize) Operand decreases(dp) {
	if dp == 0 {
		tooDeep()
		return invalidOp(e)
	}
	top := opStack.top
	vmark := vtop
	for i := mark; i < top; i++ {
		a := opStack.items[i]
		if a.mode != KConst || a.val.kind == VNone {
			mreset()
			ms("argument ")
			mexpr(a.expr)
			ms(" to comptime function ")
			mname(symName(fn))
			ms(" must be a compile-time constant")
			errAt(E2002, a.expr)
			vtop = vmark
			return invalidOp(e)
		}
		vpush(a.val)
	}
	v, ok := callComptime(fn, vmark, dp-1)
	vtop = vmark
	if !ok {
		if ifailCode != 0 {
			mreset()
			mbytes(ifailMsg.data[:ifailMsg.len])
			errAt(ifailCode, e)
		}
		return invalidOp(e)
	}
	callTab.items[usize(ci)].folded = true
	r := sigResultType(sig)
	if r == 0 {
		return opMode(KNoValue, 0)
	}
	if tk(r) == TCTuple {
		nval[usize(e)] = valStore(v)
		return opMode(KValue, r)
	}
	return opConst(r, v)
}

func methodCall(e u32, fun *Operand, ci u32, dp usize) Operand decreases(dp) {
	if dp == 0 {
		tooDeep()
		return invalidOp(e)
	}
	m := fun.method
	mr := meths.items[usize(m)]
	if mr.ptrRecv && !fun.indirect {
		mreset()
		ms("cannot call pointer method ")
		mname(mr.name)
		ms(" on ")
		mexpr(fun.recv)
		ms(" (type ")
		mtype(fun.recvType)
		ms("): no automatic &, use a pointer (p := &x; p.")
		mname(mr.name)
		ms("(...))")
		errAt(E2002, na(e))
		useArgs(e, 0, dp-1)
		return invalidOp(e)
	}
	callTab.items[usize(ci)].method = m
	callTab.items[usize(ci)].recv = fun.recv
	callTab.items[usize(ci)].recvType = fun.recvType
	if mr.builtin != BMNone {
		return builtinMethodCall(e, m, ci, dp-1)
	}
	callTab.items[usize(ci)].kind = CallMethod
	callTab.items[usize(ci)].callee = mr.sym
	sig := mr.sig
	if sig == 0 {
		useArgs(e, 0, dp-1)
		return invalidOp(e)
	}
	base, _ := derefType(fun.recvType)
	if tk(base) == TCNamed && namedOrigin(base) != 0 && mr.rtpN > 0 {
		br := typs.items[usize(base)]
		sig = subst(sig, mr.rtpS, mr.rtpN, br.l1s, br.l1n, SemaDepth)
		callTab.items[usize(ci)].taS = br.l1s
		callTab.items[usize(ci)].taN = br.l1n
	}
	callTab.items[usize(ci)].sig = sig
	callTab.items[usize(ci)].effect = sigEffect(sig)
	mark := opStack.top
	_ = arguments(e, sigParamsSlice(sig), sigVariadic(sig), Ctx{kind: CtxArgMethod, a: m, b: 0}, dp-1)
	opStack.top = mark
	return callResultType(sig)
}

func mWrongArgs(e u32, m u32, have usize, want usize) {
	mreset()
	ms("wrong number of arguments in call to ")
	mcallName(Ctx{kind: CtxArgMethod, a: m, b: 0})
	ms(": have ")
	mu(u64(have))
	ms(", want ")
	mu(u64(want))
	errAt(E2003, e)
}

func builtinMethodCall(e u32, m u32, ci u32, dp usize) Operand decreases(dp) {
	if dp == 0 {
		tooDeep()
		return invalidOp(e)
	}
	b := meths.items[usize(m)].builtin
	callTab.items[usize(ci)].kind = CallBuiltinMeth
	callTab.items[usize(ci)].effect = methodEffect(m)
	if b == BMNetListenTCP || b == BMListenerAccept || b == BMContextWithTimeout || b == BMSignalsNotifyCtx {
		callTab.items[usize(ci)].resourceCtor = true
	}
	if b == BMConnClose || b == BMListenerClose {
		callTab.items[usize(ci)].consumesRecv = true
	}
	ctxT := univNamed[BTContext]
	c := Ctx{kind: CtxArgMethod, a: m, b: 0}
	nargs := l1len(e)
	if b == BMScopeAcquireSlot {
		callTab.items[usize(ci)].resourceCtor = true
		if nargs != 2 {
			mWrongArgs(e, m, nargs, 2)
			useArgs(e, 0, dp-1)
			return invalidOp(e)
		}
		_ = exprWith(l1at(e, 0), ctxT, c, dp-1)
		a1 := l1at(e, 1)
		pool := exprValue(a1, dp-1)
		if isInvalidOp(&pool) {
			return invalidOp(e)
		}
		arr := u32(0)
		pu := underlying(pool.typ)
		if tk(pu) == TCPointer {
			au := underlying(elemOf(pu))
			if tk(au) == TCArray {
				arr = au
			}
		}
		if arr == 0 || typs.items[usize(arr)].b != 0 {
			mreset()
			ms("cannot use ")
			mexpr(a1)
			ms(" (type ")
			mtype(pool.typ)
			ms(") as pool argument to ")
			mcallName(c)
			ms(": want *[N]T")
			errAt(E2002, a1)
			return invalidOp(e)
		}
		elem := elemOf(arr)
		am := tmark()
		tpush(elem)
		as, an := tcommitStack(am)
		slot := instantiate(univNamed[BTSlot], typs.lists[usize(as):usize(as)+usize(an)], 0, SemaDepth)
		tm := tmark()
		tpush(mkConstArg(typs.items[usize(arr)].n))
		tpush(elem)
		ts, tn := tcommitStack(tm)
		callTab.items[usize(ci)].taS = ts
		callTab.items[usize(ci)].taN = tn
		m1 := tmark()
		tpush(ctxT)
		tpush(pool.typ)
		m2 := tmark()
		tpush(slot)
		tpush(TyError)
		sig := mkSig(EffTotal, false, m1, m2, tmark())
		callTab.items[usize(ci)].sig = sig
		return opMode(KValue, sigResultType(sig))
	}
	if b == BMScopeReleaseSlot || b == BMScopeGo {
		want := usize(1)
		if b == BMScopeGo {
			want = 2
		}
		if nargs != want {
			mWrongArgs(e, m, nargs, want)
			useArgs(e, 0, dp-1)
			return invalidOp(e)
		}
		callTab.items[usize(ci)].consumesArg0 = true
		a0 := l1at(e, 0)
		s := exprValue(a0, dp-1)
		if isInvalidOp(&s) {
			useArgs(e, 1, dp-1)
			return invalidOp(e)
		}
		sn := s.typ
		if tk(sn) != TCNamed || namedOrigin(sn) == 0 || namedBuiltin(namedOrigin(sn)) != BTSlot {
			mreset()
			ms("cannot use ")
			mexpr(a0)
			ms(" (type ")
			mtype(s.typ)
			ms(") as Slot argument to ")
			mcallName(c)
			errAt(E2002, a0)
			useArgs(e, 1, dp-1)
			return invalidOp(e)
		}
		elem := tl1(sn, 0)
		tm := tmark()
		tpush(elem)
		ts, tn := tcommitStack(tm)
		callTab.items[usize(ci)].taS = ts
		callTab.items[usize(ci)].taN = tn
		if b == BMScopeGo {
			f1 := tmark()
			tpush(mkPointer(elem))
			f2 := tmark()
			fnT := mkSig(EffDriver, false, f1, f2, f2)
			s1 := tmark()
			tpush(sn)
			tpush(fnT)
			s2 := tmark()
			callTab.items[usize(ci)].sig = mkSig(EffTotal, false, s1, s2, s2)
			_ = exprWith(l1at(e, 1), fnT, c, dp-1)
		} else {
			s1 := tmark()
			tpush(sn)
			s2 := tmark()
			callTab.items[usize(ci)].sig = mkSig(EffTotal, false, s1, s2, s2)
		}
		return opMode(KNoValue, 0)
	}
	sig := meths.items[usize(m)].sig
	callTab.items[usize(ci)].sig = sig
	mark := opStack.top
	_ = arguments(e, sigParamsSlice(sig), sigVariadic(sig), c, dp-1)
	opStack.top = mark
	return callResultType(sig)
}

// containsCall reports whether the subtree of e contains a CallExpr.
func containsCall(e u32, dp usize) bool decreases(dp) {
	if dp == 0 || e == 0 {
		return false
	}
	n := nodes.items[usize(e)]
	if n.kind == NkCallExpr {
		return true
	}
	for i := usize(0); i < MaxSlots; i++ {
		slot, _ := layout(n.kind, i)
		if slot == SlotNone {
			break
		}
		if slot >= SlotL1 {
			start, cnt := slotList(n, slot)
			m := usize(cnt)
			for j := usize(0); j < m; j++ {
				if containsCall(nodes.lists[usize(start)+j], dp-1) {
					return true
				}
			}
		} else if containsCall(slotChild(n, slot), dp-1) {
			return true
		}
	}
	return false
}

func builtinNargs(e u32, b u8, want usize, dp usize) bool decreases(dp) {
	if dp == 0 {
		tooDeep()
		return false
	}
	n := l1len(e)
	if n != want {
		mreset()
		if n > want {
			ms("too many")
		} else {
			ms("not enough")
		}
		ms(" arguments in call to ")
		ms(builtinName(b))
		ms(": have ")
		mu(u64(n))
		ms(", want ")
		mu(u64(want))
		errAt(E2003, e)
		useArgs(e, 0, dp-1)
		return false
	}
	return true
}

// builtinFixed checks a builtin with a fixed signature (params stack
// [m1:m2], results [m2:top]).
func builtinFixed(e u32, b u8, ci u32, m1 usize, m2 usize, dp usize) Operand decreases(dp) {
	if dp == 0 {
		tooDeep()
		return invalidOp(e)
	}
	sig := mkSig(EffTotal, false, m1, m2, tmark())
	callTab.items[usize(ci)].sig = sig
	mark := opStack.top
	_ = arguments(e, sigParamsSlice(sig), false, Ctx{kind: CtxArgBuiltin, a: u32(b), b: 0}, dp-1)
	opStack.top = mark
	return callResultType(sig)
}

func builtinCall(e u32, sym u32, ci u32, dp usize) Operand decreases(dp) {
	if dp == 0 {
		tooDeep()
		return invalidOp(e)
	}
	b := syms.items[usize(sym)].builtin
	callTab.items[usize(ci)].kind = CallBuiltin
	callTab.items[usize(ci)].builtin = b
	callTab.items[usize(ci)].callee = sym
	if builtinIsCodeCtor(b) {
		return codeCtor(e, b, ci, dp-1)
	}
	bytesT := mkSlice(TyU8)
	if b == BFLen || b == BFCap {
		if !builtinNargs(e, b, 1, dp-1) {
			return invalidOp(e)
		}
		a0 := l1at(e, 0)
		x := exprValue(a0, dp-1)
		if isInvalidOp(&x) {
			return invalidOp(e)
		}
		t := x.typ
		viaPtr := false
		u := underlying(t)
		if tk(u) == TCPointer && tk(underlying(elemOf(u))) == TCArray {
			t = elemOf(u)
			viaPtr = true
		}
		u = underlying(t)
		k := tk(u)
		if k == TCArray {
			r := typs.items[usize(u)]
			if r.b == 0 && !viaPtr && !containsCall(a0, SemaDepth) {
				return opConst(TyUsize, vIntU(r.n))
			}
			return opMode(KValue, TyUsize)
		}
		if k == TCSlice {
			return opMode(KValue, TyUsize)
		}
		if k == TCBasic && isString(u) && b == BFLen {
			if isUntyped(x.typ) {
				_ = convertUntyped(&x, TyString)
			}
			if x.mode == KConst {
				return opConst(TyUsize, vIntU(u64(x.val.aux)))
			}
			return opMode(KValue, TyUsize)
		}
		mreset()
		ms("invalid argument ")
		mexpr(a0)
		ms(" (type ")
		mtype(x.typ)
		ms(") for ")
		ms(builtinName(b))
		errAt(E2002, a0)
		return invalidOp(e)
	}
	if b == BFCopy {
		if !builtinNargs(e, b, 2, dp-1) {
			return invalidOp(e)
		}
		d := exprValue(l1at(e, 0), dp-1)
		s := exprValue(l1at(e, 1), dp-1)
		if isInvalidOp(&d) || isInvalidOp(&s) {
			return invalidOp(e)
		}
		du := underlying(d.typ)
		su := underlying(s.typ)
		if tk(du) != TCSlice || tk(su) != TCSlice || elemOf(du) != elemOf(su) {
			mreset()
			ms("arguments to copy must be slices with identical element types (have ")
			mtype(d.typ)
			ms(" and ")
			mtype(s.typ)
			ms(")")
			errAt(E2002, e)
			return invalidOp(e)
		}
		tm := tmark()
		tpush(elemOf(du))
		ts, tn := tcommitStack(tm)
		callTab.items[usize(ci)].taS = ts
		callTab.items[usize(ci)].taN = tn
		m1 := tmark()
		tpush(d.typ)
		tpush(s.typ)
		m2 := tmark()
		tpush(TyUsize)
		callTab.items[usize(ci)].sig = mkSig(EffTotal, false, m1, m2, tmark())
		return opMode(KValue, TyUsize)
	}
	if b == BFPanic {
		callTab.items[usize(ci)].effect = EffDriver
		if !builtinNargs(e, b, 1, dp-1) {
			return invalidOp(e)
		}
		x := exprValue(l1at(e, 0), dp-1)
		if !isInvalidOp(&x) {
			_ = defaultTypeOp(&x, Ctx{kind: CtxArgBuiltin, a: u32(b), b: 0})
		}
		return opMode(KNoValue, 0)
	}
	m1 := tmark()
	if b == BFBytesEqual {
		tpush(bytesT)
		tpush(bytesT)
		m2 := tmark()
		tpush(TyBool)
		return builtinFixed(e, b, ci, m1, m2, dp-1)
	}
	if b == BFStrBytes {
		tpush(TyString)
		m2 := tmark()
		tpush(bytesT)
		return builtinFixed(e, b, ci, m1, m2, dp-1)
	}
	if b == BFBytesToStr {
		tpush(bytesT)
		m2 := tmark()
		tpush(TyString)
		return builtinFixed(e, b, ci, m1, m2, dp-1)
	}
	if b == BFFormatUint {
		tpush(TyU64)
		tpush(bytesT)
		m2 := tmark()
		tpush(TyUsize)
		tpush(TyError)
		return builtinFixed(e, b, ci, m1, m2, dp-1)
	}
	if b == BFParseUint {
		tpush(bytesT)
		m2 := tmark()
		tpush(TyU64)
		tpush(TyError)
		return builtinFixed(e, b, ci, m1, m2, dp-1)
	}
	if b == BFNewContext {
		callTab.items[usize(ci)].resourceCtor = true
		m2 := tmark()
		tpush(univNamed[BTContext])
		tpush(univNamed[BTCancelFunc])
		return builtinFixed(e, b, ci, m1, m2, dp-1)
	}
	if b == BFNewScope {
		callTab.items[usize(ci)].resourceCtor = true
		tpush(TyUsize)
		m2 := tmark()
		tpush(univNamed[BTScope])
		return builtinFixed(e, b, ci, m1, m2, dp-1)
	}
	mreset()
	ms("unsupported builtin ")
	ms(builtinName(b))
	errAt(E2002, e)
	return invalidOp(e)
}

// codeArg checks a Code argument of a Code constructor.
func codeArg(a u32, b u8, dp usize) (Operand, bool) decreases(dp) {
	if dp == 0 {
		tooDeep()
		return invalidOp(a), false
	}
	x := exprValue(a, dp-1)
	if isInvalidOp(&x) {
		return x, false
	}
	if tk(x.typ) != TCCode {
		mreset()
		ms("cannot use ")
		mexpr(a)
		ms(" (type ")
		mtype(x.typ)
		ms(") as Code argument to ")
		ms(builtinName(b))
		errAt(E2002, a)
		return x, false
	}
	return x, true
}

// codeCtor types the Code constructors (spec 5.1).
func codeCtor(e u32, b u8, ci u32, dp usize) Operand decreases(dp) {
	if dp == 0 {
		tooDeep()
		return invalidOp(e)
	}
	callTab.items[usize(ci)].effect = EffComptime
	want := usize(0)
	if b == BFCodeArray || b == BFCodeField {
		want = 2
	} else if b == BFCodeSlice || b == BFCodeStruct || b == BFCodeUniv {
		want = 1
	}
	nargs := l1len(e)
	c := Ctx{kind: CtxArgBuiltin, a: u32(b), b: 0}
	if nargs != want {
		mreset()
		ms("wrong number of arguments in call to ")
		ms(builtinName(b))
		ms(": have ")
		mu(u64(nargs))
		ms(", want ")
		mu(u64(want))
		errAt(E2003, e)
		useArgs(e, 0, dp-1)
		return invalidOp(e)
	}
	if b == BFCodeArray {
		n := exprWith(l1at(e, 0), TyUsize, c, dp-1)
		el, ok := codeArg(l1at(e, 1), b, dp-1)
		if isInvalidOp(&n) || !ok {
			return invalidOp(e)
		}
		lvl := codeLevel(el.typ)
		if n.mode == KConst && el.mode == KConst {
			ln, _ := valUint64(n.val)
			v := vCode(CKArray)
			v.hi = ln
			v.ref = valStore(el.val)
			return opConst(mkCode(lvl), v)
		}
		return opMode(KValue, mkCode(lvl))
	}
	if b == BFCodeSlice {
		el, ok := codeArg(l1at(e, 0), b, dp-1)
		if !ok {
			return invalidOp(e)
		}
		lvl := codeLevel(el.typ)
		if el.mode == KConst {
			v := vCode(CKSlice)
			v.ref = valStore(el.val)
			return opConst(mkCode(lvl), v)
		}
		return opMode(KValue, mkCode(lvl))
	}
	if b == BFCodeStruct {
		fc := univNamed[BTFieldCode]
		x := exprWith(l1at(e, 0), mkSlice(fc), c, dp-1)
		if isInvalidOp(&x) {
			return invalidOp(e)
		}
		return opMode(KValue, mkCode(-1))
	}
	if b == BFCodeField {
		n := exprWith(l1at(e, 0), TyString, c, dp-1)
		el, ok := codeArg(l1at(e, 1), b, dp-1)
		if isInvalidOp(&n) || !ok {
			return invalidOp(e)
		}
		fc := univNamed[BTFieldCode]
		if n.mode == KConst && el.mode == KConst {
			var f Val
			f.kind = VFieldCode
			f.lo = u64(n.val.ref)
			f.hi = u64(n.val.aux)
			f.ref = valStore(el.val)
			return opConst(fc, f)
		}
		return opMode(KValue, fc)
	}
	if b == BFCodeUniv {
		a0 := l1at(e, 0)
		n := exprWith(a0, TyUsize, c, dp-1)
		if isInvalidOp(&n) {
			return invalidOp(e)
		}
		if n.mode != KConst {
			mreset()
			ms("CodeUniv level ")
			mexpr(a0)
			ms(" must be a compile-time constant (its type Code (n+1) depends on it)")
			errAt(E2010, a0)
			return invalidOp(e)
		}
		lv, ok := valUint64(n.val)
		if !ok || lv >= 1<<20 {
			mreset()
			ms("invalid universe level ")
			mval(n.val)
			errAt(E2010, a0)
			return invalidOp(e)
		}
		v := vCode(CKUniv)
		v.hi = lv
		return opConst(mkCode(int(lv)+1), v)
	}
	return opConst(mkCode(-1), vCode(b-BFCodeEmpty))
}

func conversion(e u32, t u32, ci u32, dp usize) Operand decreases(dp) {
	if dp == 0 {
		tooDeep()
		return invalidOp(e)
	}
	callTab.items[usize(ci)].kind = CallConversion
	callTab.items[usize(ci)].conv = t
	nargs := l1len(e)
	if nargs != 1 {
		mreset()
		ms("conversion to ")
		mtype(t)
		ms(" needs exactly one argument, have ")
		mu(u64(nargs))
		errAt(E2003, e)
		useArgs(e, 0, dp-1)
		return invalidOp(e)
	}
	a0 := l1at(e, 0)
	x := exprValue(a0, dp-1)
	if isInvalidOp(&x) {
		return invalidOp(e)
	}
	if (isTypeParamT(t) || isTypeParamT(x.typ)) && t != x.typ {
		mreset()
		ms("conversion ")
		mexpr(e)
		ms(" inspects a type parameter (from ")
		mtype(x.typ)
		ms(" to ")
		mtype(t)
		ms(")")
		errAt(E2011, e)
		return invalidOp(e)
	}
	if isUntyped(x.typ) {
		if isInteger(x.typ) && isInteger(t) || isBoolean(x.typ) && isBoolean(t) || isString(x.typ) && isString(t) {
			if x.val.kind != VNone && !representable(x.val, t) {
				mreset()
				ms("cannot convert ")
				mexpr(a0)
				ms(" (constant ")
				mval(x.val)
				ms(") to ")
				mtype(t)
				ms(": overflows")
				errAt(E2002, a0)
				return invalidOp(e)
			}
			updateType(a0, t, SemaDepth)
			return opConst(t, x.val)
		}
		if !convertUntyped(&x, t) {
			return invalidOp(e)
		}
		return opMode(KValue, t)
	}
	if !convertible(x.typ, t) {
		mreset()
		ms("cannot convert ")
		mexpr(a0)
		ms(" (type ")
		mtype(x.typ)
		ms(") to ")
		mtype(t)
		errAt(E2002, e)
		return invalidOp(e)
	}
	if x.mode == KConst && x.val.kind != VNone {
		if isInteger(t) && !representable(x.val, t) {
			mreset()
			ms("cannot convert constant ")
			mval(x.val)
			ms(" to ")
			mtype(t)
			ms(": overflows")
			errAt(E2002, a0)
			return invalidOp(e)
		}
		return opConst(t, x.val)
	}
	return opMode(KValue, t)
}

func convertible(v u32, t u32) bool {
	if assignable(v, t) {
		return true
	}
	vu := underlying(v)
	tu := underlying(t)
	if vu == tu {
		return true
	}
	if isInteger(vu) && isInteger(tu) {
		return true
	}
	if tk(vu) == TCPointer && tk(tu) == TCPointer {
		return underlying(elemOf(vu)) == underlying(elemOf(tu))
	}
	return false
}

func variantCall(e u32, fun *Operand, ci u32, dp usize) Operand decreases(dp) {
	if dp == 0 {
		tooDeep()
		return invalidOp(e)
	}
	en := fun.vEnum
	vi := usize(fun.vIndex)
	callTab.items[usize(ci)].kind = CallVariant
	callTab.items[usize(ci)].variantEnum = en
	callTab.items[usize(ci)].variant = fun.vIndex
	callTab.items[usize(ci)].variantType = fun.typ
	ps := usize(variantPayS(en, vi))
	pn := variantPayN(en, vi)
	mark := opStack.top
	ok := arguments(e, typs.lists[ps:ps+pn], false, Ctx{kind: CtxArgVariant, a: fun.typ, b: variantName(en, vi)}, dp-1)
	if !ok {
		opStack.top = mark
		return opMode(KValue, fun.typ)
	}
	top := opStack.top
	for i := mark; i < top; i++ {
		if opStack.items[i].mode != KConst {
			opStack.top = mark
			return opMode(KValue, fun.typ)
		}
	}
	n := top - mark
	st := valAlloc(n, false)
	for i := usize(0); i < n; i++ {
		slotSet(st+u32(i), opStack.items[mark+i].val)
	}
	opStack.top = mark
	ev := vAgg(VEnum, st, n)
	ev.lo = u64(vi)
	return opConst(fun.typ, ev)
}

// funcInstance handles f[T1, ...] for a generic function f.
func funcInstance(e u32, x *Operand, dp usize) Operand decreases(dp) {
	if dp == 0 {
		tooDeep()
		return invalidOp(e)
	}
	sig := x.typ
	if sig == 0 || tk(sig) != TCSig || sigNTParams(sig) == 0 {
		mreset()
		mexpr(na(e))
		ms(" is not a generic function")
		errAt(E2002, e)
		return invalidOp(e)
	}
	ni := l1len(e)
	ntp := sigNTParams(sig)
	if ni != ntp {
		mreset()
		ms("wrong number of type arguments for ")
		mexpr(na(e))
		ms(": have ")
		mu(u64(ni))
		ms(", want ")
		mu(u64(ntp))
		errAt(E2003, e)
		return invalidOp(e)
	}
	mark := tmark()
	for i := usize(0); i < ni; i++ {
		ta := typeArg(l1at(e, i), tl3(sig, i), dp-1)
		if isInvalid(ta) {
			typs.top = mark
			return invalidOp(e)
		}
		tpush(ta)
	}
	as, an := tcommitStack(mark)
	args := typs.lists[usize(as) : usize(as)+usize(an)]
	sr := typs.items[usize(sig)]
	generic := mkSigLists(sr.sub, sr.flag&1 != 0, sigParamsSlice(sig), sigResultsSlice(sig), emptyU32())
	inst := subst(generic, sr.l3s, sr.l3n, as, an, SemaDepth)
	rec := findInstRec(x.sym, args)
	if rec == 0 {
		var ir Inst
		ir.sym = x.sym
		ir.argS = as
		ir.argN = an
		ir.sig = inst
		ir.generic = anyTypeParam(args)
		rec = newInstRec(ir)
	}
	ninst[usize(e)] = rec
	r := opMode(KFunc, inst)
	r.sym = x.sym
	return r
}
