// check_expr.fc — the type checker, part 2: expressions and calls (port of
// finc0's types/expr.go and types/call.go). All functions taking `dp` are
// members of the checker SCC (see checker.fc).
package main

// rawExpr checks e and records its type; the result may be untyped, a
// type, a builtin, a tuple, ...
func rawExpr(e u32, dp usize) Operand decreases(dp) {
	if dp == 0 {
		tooDeep()
		return invalidOp(e)
	}
	x := expr0(e, dp-1)
	x.expr = e
	m := x.mode
	if m == KValue || m == KVar || m == KConst || m == KType {
		if x.typ == 0 || isInvalid(x.typ) {
			x.mode = KNone
		}
	}
	if x.mode == KNone {
		x.typ = TyInvalid
	}
	record(&x)
	return x
}

// exprValue checks that e denotes a single value.
func exprValue(e u32, dp usize) Operand decreases(dp) {
	if dp == 0 {
		tooDeep()
		return invalidOp(e)
	}
	x := rawExpr(e, dp-1)
	singleValue(&x)
	return x
}

// exprWith checks e and assigns it to type t.
func exprWith(e u32, t u32, c Ctx, dp usize) Operand decreases(dp) {
	if dp == 0 {
		tooDeep()
		return invalidOp(e)
	}
	x := exprValue(e, dp-1)
	if !isInvalidOp(&x) {
		_ = assignment(&x, t, c)
	}
	return x
}

// stringLitVal decodes a STRING BasicLit into a string value.
func stringLitVal(e u32) Val {
	t := &tmpBuf
	t.Reset()
	decodeStringLit(t, ntext(e))
	return vStr(t.Bytes())
}

func expr0(e u32, dp usize) Operand decreases(dp) {
	if dp == 0 {
		tooDeep()
		return invalidOp(e)
	}
	k := nkind(e)
	if k == NkIdent {
		sym := uses[usize(e)]
		if sym == 0 {
			return invalidOp(e)
		}
		return symOperand(sym, e, dp-1)
	}
	if k == NkBasicLit {
		lk := nop(e)
		if lk == LitInt {
			return opConst(TyUntypedInt, vIntU(nival(e)))
		}
		if lk == LitChar {
			return opConst(TyUntypedChar, vIntU(nival(e)))
		}
		return opConst(TyUntypedString, stringLitVal(e))
	}
	if k == NkBoolLit {
		return opConst(TyUntypedBool, vBool(nflag(e)))
	}
	if k == NkNilLit {
		return opConst(TyUntypedNil, Val.Nil)
	}
	if k == NkParenExpr {
		x := rawExpr(na(e), dp-1)
		x.expr = e
		return x
	}
	if k == NkBinaryExpr {
		return binaryExpr(e, dp-1)
	}
	if k == NkUnaryExpr {
		return unaryExpr(e, dp-1)
	}
	if k == NkCallExpr {
		return callExpr(e, dp-1)
	}
	if k == NkIndexExpr {
		return indexExpr(e, dp-1)
	}
	if k == NkSliceExpr {
		return sliceExpr(e, dp-1)
	}
	if k == NkSelectorExpr {
		return selectorExpr(e, dp-1)
	}
	if k == NkFuncLit {
		return funcLit(e, dp-1)
	}
	if k == NkStructLit {
		return structLit(e, dp-1)
	}
	if k == NkTypeExpr {
		t := typExpr(na(e), dp-1)
		if isInvalid(t) {
			return invalidOp(e)
		}
		return opMode(KType, t)
	}
	if k == NkMatchExpr {
		return matchExpr(e, dp-1)
	}
	if k == NkIsExpr {
		return isExpr(e, dp-1)
	}
	if k == NkTupleExpr {
		errAt(E2002, e, formatTo(mbuf[:], "tuple %v can only be the scrutinee of a match", Expr(e)))
		return invalidOp(e)
	}
	return invalidOp(e)
}

func symOperand(sym u32, id u32, dp usize) Operand decreases(dp) {
	if dp == 0 {
		tooDeep()
		return invalidOp(id)
	}
	k := symKind(sym)
	if k == SymConst {
		t := symType(sym, dp-1)
		v := syms.items[usize(sym)].val
		if isInvalid(t) || v == 0 {
			return invalidOp(id)
		}
		return opConst(t, slotGet(v))
	}
	if k == SymVar {
		t := symType(sym, dp-1)
		if isInvalid(t) {
			return invalidOp(id)
		}
		return opMode(KVar, t)
	}
	if k == SymType {
		t := typeSym(sym, id, dp-1)
		if isInvalid(t) {
			return invalidOp(id)
		}
		return opMode(KType, t)
	}
	if k == SymTypeParam {
		tp := symType(sym, dp-1)
		if tp == 0 || !isTypeParamT(tp) {
			return invalidOp(id)
		}
		if tpIsConst(tp) {
			return opMode(KValue, tpConstType(tp))
		}
		return opMode(KType, tp)
	}
	if k == SymFunc {
		t := symType(sym, dp-1)
		if isInvalid(t) {
			return invalidOp(id)
		}
		x := opMode(KFunc, t)
		x.sym = sym
		return x
	}
	if k == SymBuiltin || k == SymPackage {
		x := opMode(KBuiltin, TyInvalid)
		if k == SymPackage {
			x.mode = KPackage
		}
		x.sym = sym
		return x
	}
	return invalidOp(id)
}

// ---------------------------------------------------------------------------
// Operators

func binaryExpr(e u32, dp usize) Operand decreases(dp) {
	if dp == 0 {
		tooDeep()
		return invalidOp(e)
	}
	x := exprValue(na(e), dp-1)
	y := exprValue(nb(e), dp-1)
	if isInvalidOp(&x) || isInvalidOp(&y) {
		return invalidOp(e)
	}
	op := nop(e)
	if isTypeParamT(x.typ) || isTypeParamT(y.typ) {
		errAtOp(E2011, e, formatTo(mbuf[:], "operator %s inspects a value of type parameter type (%v, %v)", binOpString(op), TypeRef(x.typ), TypeRef(y.typ)))
		return invalidOp(e)
	}
	if op == OpShl || op == OpShr {
		return shiftExpr(e, &x, &y)
	}
	if isCompareOp(op) {
		return comparisonExpr(e, &x, &y)
	}
	if !matchTypes(e, &x, &y) {
		return invalidOp(e)
	}
	t := x.typ
	if op == OpAdd && isString(t) {
		return concatExpr(e, &x, &y)
	}
	if op == OpLAnd || op == OpLOr {
		if !isBoolean(t) {
			errAtOp(E2002, e, formatTo(mbuf[:], "operator %s not defined on %v (type %v)", binOpString(op), Expr(na(e)), TypeRef(t)))
			return invalidOp(e)
		}
	} else if !isInteger(t) {
		errAtOp(E2002, e, formatTo(mbuf[:], "operator %s not defined on %v (type %v)", binOpString(op), Expr(na(e)), TypeRef(t)))
		return invalidOp(e)
	}
	if (op == OpDiv || op == OpRem) && y.mode == KConst {
		if y.val == vIntU(0) {
			errAt(E2002, nb(e), formatTo(mbuf[:], "division by zero"))
			return invalidOp(e)
		}
	}
	if x.mode == KConst && y.mode == KConst {
		v, ok := binaryOpVal(op, x.val, y.val)
		if !ok {
			errAtOp(E2002, e, formatTo(mbuf[:], "constant evaluation: %s", (&errTxt).Bytes()))
			return invalidOp(e)
		}
		if !isUntyped(t) && !representable(v, t) {
			errAt(E2002, e, formatTo(mbuf[:], "constant %v overflows %v", ValRef(v), TypeRef(t)))
			return invalidOp(e)
		}
		return opConst(t, v)
	}
	return opMode(KValue, t)
}

// concatExpr checks `x + y` on strings (v0.2 ergonomics): both operands
// must be constants and the result is a constant; there is no run-time
// string building.
func concatExpr(e u32, x *Operand, y *Operand) Operand {
	nc := u32(0)
	if x.mode != KConst {
		nc = x.expr
	} else if y.mode != KConst {
		nc = y.expr
	}
	if nc != 0 || x.mode != KConst || y.mode != KConst {
		errAtOp(E2002, e, formatTo(mbuf[:], "invalid operation: %v is not a constant (string concatenation is only allowed for constants)", Expr(nc)))
		return invalidOp(e)
	}
	v, ok := binaryOpVal(OpAdd, x.val, y.val)
	if !ok {
		errAtOp(E2002, e, formatTo(mbuf[:], "constant evaluation: %s", (&errTxt).Bytes()))
		return invalidOp(e)
	}
	return opConst(x.typ, v)
}

// matchTypes converts untyped operands to the other operand's type and
// requires identical types.
func matchTypes(e u32, x *Operand, y *Operand) bool {
	xu := isUntyped(x.typ)
	yu := isUntyped(y.typ)
	op := nop(e)
	if xu && !yu {
		if !convertUntyped(x, y.typ) {
			return false
		}
	} else if yu && !xu {
		if !convertUntyped(y, x.typ) {
			return false
		}
	} else if xu && yu {
		kx := basicKind(x.typ)
		ky := basicKind(y.typ)
		if kx != ky {
			if (kx == BkUntypedInt || kx == BkUntypedChar) && (ky == BkUntypedInt || ky == BkUntypedChar) {
				x.typ = TyUntypedChar
				y.typ = TyUntypedChar
				return true
			}
			if kx == BkUntypedNil || ky == BkUntypedNil {
				errAtOp(E2004, e, formatTo(mbuf[:], "invalid operation: operator %s on untyped nil", binOpString(op)))
				return false
			}
			errAtOp(E2002, e, formatTo(mbuf[:], "mismatched types %v and %v", TypeRef(x.typ), TypeRef(y.typ)))
			return false
		}
		return true
	}
	if x.typ != y.typ {
		errAtOp(E2002, e, formatTo(mbuf[:], "mismatched types %v and %v for operator %s", TypeRef(x.typ), TypeRef(y.typ), binOpString(op)))
		return false
	}
	return true
}

func shiftExpr(e u32, x *Operand, y *Operand) Operand {
	op := nop(e)
	if !isInteger(y.typ) {
		errAt(E2002, nb(e), formatTo(mbuf[:], "shift count %v must be an integer", Expr(nb(e))))
		return invalidOp(e)
	}
	if isUntyped(y.typ) {
		if intSign(y.val) < 0 {
			errAt(E2002, nb(e), formatTo(mbuf[:], "negative shift count %v", ValRef(y.val)))
			return invalidOp(e)
		}
		_ = convertUntyped(y, TyUsize)
	}
	if !isInteger(x.typ) {
		errAt(E2002, na(e), formatTo(mbuf[:], "shifted operand %v must be an integer", Expr(na(e))))
		return invalidOp(e)
	}
	if x.mode == KConst && y.mode == KConst {
		v, ok := binaryOpVal(op, x.val, y.val)
		if !ok {
			errAtOp(E2002, e, formatTo(mbuf[:], "constant evaluation: %s", (&errTxt).Bytes()))
			return invalidOp(e)
		}
		if !isUntyped(x.typ) && !representable(v, x.typ) {
			errAt(E2002, e, formatTo(mbuf[:], "constant %v overflows %v", ValRef(v), TypeRef(x.typ)))
			return invalidOp(e)
		}
		return opConst(x.typ, v)
	}
	if isUntyped(x.typ) {
		_ = convertUntyped(x, defaultOf(x.typ))
	}
	return opMode(KValue, x.typ)
}

func comparisonExpr(e u32, x *Operand, y *Operand) Operand {
	op := nop(e)
	xn := basicKind(x.typ) == BkUntypedNil
	yn := basicKind(y.typ) == BkUntypedNil
	if xn && yn {
		errAtOp(E2002, e, formatTo(mbuf[:], "invalid operation: nil %s nil", binOpString(op)))
		return invalidOp(e)
	}
	if xn || yn {
		ok := false
		if yn {
			ok = convertUntyped(y, x.typ)
		} else {
			ok = convertUntyped(x, y.typ)
		}
		if !ok {
			return invalidOp(e)
		}
		if op != OpEq && op != OpNe {
			errAtOp(E2002, e, formatTo(mbuf[:], "operator %s not defined on nil", binOpString(op)))
			return invalidOp(e)
		}
		return opMode(KValue, TyBool)
	}
	if !matchTypes(e, x, y) {
		return invalidOp(e)
	}
	t := x.typ
	if op == OpEq || op == OpNe {
		if !comparable(t, SemaDepth) {
			errAtOp(E2002, e, formatTo(mbuf[:], "operator %s not defined on %v (type %v is not comparable)", binOpString(op), Expr(na(e)), TypeRef(t)))
			return invalidOp(e)
		}
	} else if !isInteger(t) && !isString(t) {
		errAtOp(E2002, e, formatTo(mbuf[:], "operator %s not defined on %v (type %v is not ordered)", binOpString(op), Expr(na(e)), TypeRef(t)))
		return invalidOp(e)
	}
	if x.mode == KConst && y.mode == KConst {
		v, ok := binaryOpVal(op, x.val, y.val)
		if !ok {
			errAtOp(E2002, e, formatTo(mbuf[:], "constant evaluation: %s", (&errTxt).Bytes()))
			return invalidOp(e)
		}
		return opConst(TyUntypedBool, v)
	}
	if isUntyped(x.typ) {
		_ = convertUntyped(x, defaultOf(x.typ))
		_ = convertUntyped(y, defaultOf(y.typ))
	}
	return opMode(KValue, TyBool)
}

func unaryExpr(e u32, dp usize) Operand decreases(dp) {
	if dp == 0 {
		tooDeep()
		return invalidOp(e)
	}
	op := nop(e)
	if op == OpAddr {
		x := exprValue(na(e), dp-1)
		if isInvalidOp(&x) {
			return invalidOp(e)
		}
		if x.mode != KVar {
			errAt(E2002, e, formatTo(mbuf[:], "cannot take the address of %v", Expr(na(e))))
			return invalidOp(e)
		}
		return opMode(KValue, mkPointer(x.typ))
	}
	if op == OpDeref {
		x := rawExpr(na(e), dp-1)
		if x.mode == KType {
			return opMode(KType, mkPointer(x.typ))
		}
		singleValue(&x)
		if isInvalidOp(&x) {
			return invalidOp(e)
		}
		u := underlying(x.typ)
		if !isPointerT(u) {
			errAt(E2002, e, formatTo(mbuf[:], "cannot dereference %v (type %v is not a pointer)", Expr(na(e)), TypeRef(x.typ)))
			return invalidOp(e)
		}
		return opMode(KVar, elemOf(u))
	}
	x := exprValue(na(e), dp-1)
	if isInvalidOp(&x) {
		return invalidOp(e)
	}
	if isTypeParamT(x.typ) {
		errAt(E2011, e, formatTo(mbuf[:], "operator %s inspects a value of type parameter type %v", unaryOpString(op), TypeRef(x.typ)))
		return invalidOp(e)
	}
	if op == OpNot && !isBoolean(x.typ) {
		errAt(E2002, e, formatTo(mbuf[:], "operator ! not defined on %v (type %v)", Expr(na(e)), TypeRef(x.typ)))
		return invalidOp(e)
	}
	if op == OpNeg && !isInteger(x.typ) {
		errAt(E2002, e, formatTo(mbuf[:], "operator - not defined on %v (type %v)", Expr(na(e)), TypeRef(x.typ)))
		return invalidOp(e)
	}
	if x.mode == KConst {
		v, ok := unaryOpVal(op, x.val)
		if !ok {
			errAt(E2002, e, formatTo(mbuf[:], "constant evaluation: %s", (&errTxt).Bytes()))
			return invalidOp(e)
		}
		if !isUntyped(x.typ) && !representable(v, x.typ) {
			errAt(E2002, e, formatTo(mbuf[:], "constant %v overflows %v", ValRef(v), TypeRef(x.typ)))
			return invalidOp(e)
		}
		return opConst(x.typ, v)
	}
	return opMode(KValue, x.typ)
}

// ---------------------------------------------------------------------------
// Index and slice expressions

// indexArg checks an index expression; it returns (value, hasValue, ok).
func indexArg(e u32, dp usize) (Val, bool, bool) decreases(dp) {
	var z Val
	if dp == 0 {
		tooDeep()
		return z, false, false
	}
	x := exprValue(e, dp-1)
	if isInvalidOp(&x) {
		return z, false, false
	}
	if !isInteger(x.typ) {
		errAt(E2002, e, formatTo(mbuf[:], "index %v must be an integer (have %v)", Expr(e), TypeRef(x.typ)))
		return z, false, false
	}
	if x.mode == KConst && intSign(x.val) < 0 {
		errAt(E4003, e, formatTo(mbuf[:], "index %v must not be negative", ValRef(x.val)))
		return z, false, false
	}
	if isUntyped(x.typ) && !convertUntyped(&x, TyUsize) {
		return z, false, false
	}
	if x.mode == KConst {
		return x.val, true, true
	}
	return z, false, true
}

func indexExpr(e u32, dp usize) Operand decreases(dp) {
	if dp == 0 {
		tooDeep()
		return invalidOp(e)
	}
	x := rawExpr(na(e), dp-1)
	if x.mode == KNone {
		n := l1len(e)
		for i := usize(0); i < n; i++ {
			_ = rawExpr(l1at(e, i), dp-1)
		}
		return invalidOp(e)
	}
	if x.mode == KFunc && x.method == 0 {
		return funcInstance(e, &x, dp-1)
	}
	if x.mode == KType {
		if !isNamedT(x.typ) || namedNTParams(x.typ) == 0 {
			errAt(E2002, e, formatTo(mbuf[:], "%v is not a generic type", TypeRef(x.typ)))
			return invalidOp(e)
		}
		t := instantiateArgs(x.typ, e, e, e, dp-1)
		if isInvalid(t) {
			return invalidOp(e)
		}
		return opMode(KType, t)
	}
	singleValue(&x)
	if isInvalidOp(&x) {
		return invalidOp(e)
	}
	if l1len(e) != 1 {
		errAt(E2003, e, formatTo(mbuf[:], "%v cannot be indexed with %d indices", Expr(na(e)), l1len(e)))
		return invalidOp(e)
	}
	i0 := l1at(e, 0)
	idx, has, ok := indexArg(i0, dp-1)
	if !ok {
		return invalidOp(e)
	}
	t := x.typ
	mode := x.mode
	u := underlying(t)
	if isPointerT(u) && isArrayT(underlying(elemOf(u))) {
		t = elemOf(u)
		mode = KVar
	}
	u = underlying(t)
	if isArrayT(u) {
		alen, lenParam := arrayLenOf(u)
		if has && lenParam == 0 {
			n, _ := valUint64(idx)
			if n >= alen {
				errAt(E4003, i0, formatTo(mbuf[:], "index %v out of bounds for array of length %d", ValRef(idx), alen))
				return invalidOp(e)
			}
		}
		if mode != KVar {
			mode = KValue
		}
		return opMode(mode, elemOf(u))
	}
	if isSliceT(u) {
		return opMode(KVar, elemOf(u))
	}
	if isBasicT(u) && isString(u) {
		if x.mode == KConst && has {
			sb := strOf(x.val)
			n, _ := valUint64(idx)
			if n >= u64(len(sb)) {
				errAt(E4003, i0, formatTo(mbuf[:], "index %v out of bounds for string of length %d", ValRef(idx), len(sb)))
				return invalidOp(e)
			}
			return opConst(TyU8, vIntU(u64(sb[usize(n)])))
		}
		return opMode(KValue, TyU8)
	}
	errAt(E2002, e, formatTo(mbuf[:], "cannot index %v (type %v)", Expr(na(e)), TypeRef(x.typ)))
	return invalidOp(e)
}

func sliceExpr(e u32, dp usize) Operand decreases(dp) {
	if dp == 0 {
		tooDeep()
		return invalidOp(e)
	}
	x := exprValue(na(e), dp-1)
	var lo Val
	var hi Val
	hasLo := false
	hasHi := false
	okAll := !isInvalidOp(&x)
	if nb(e) != 0 {
		v, has, ok := indexArg(nb(e), dp-1)
		lo = v
		hasLo = has
		okAll = okAll && ok
	}
	if nc(e) != 0 {
		v, has, ok := indexArg(nc(e), dp-1)
		hi = v
		hasHi = has
		okAll = okAll && ok
	}
	if !okAll {
		return invalidOp(e)
	}
	if hasLo && hasHi {
		l, _ := valUint64(lo)
		h, _ := valUint64(hi)
		if l > h {
			errAt(E4003, e, formatTo(mbuf[:], "invalid slice indices: %d > %d", l, h))
			return invalidOp(e)
		}
	}
	t := x.typ
	addressable := x.mode == KVar
	u := underlying(t)
	if isPointerT(u) && isArrayT(underlying(elemOf(u))) {
		t = elemOf(u)
		addressable = true
	}
	u = underlying(t)
	if isArrayT(u) {
		if !addressable {
			errAt(E2002, e, formatTo(mbuf[:], "cannot slice %v (value not addressable)", Expr(na(e))))
			return invalidOp(e)
		}
		alen, lenParam := arrayLenOf(u)
		if lenParam == 0 {
			for q := usize(0); q < 2; q++ {
				b := lo
				hb := hasLo
				if q == 1 {
					b = hi
					hb = hasHi
				}
				if !hb {
					continue
				}
				n, ok := valUint64(b)
				if ok && n > alen {
					errAt(E4003, e, formatTo(mbuf[:], "slice bound %d out of range for array of length %d", n, alen))
					return invalidOp(e)
				}
			}
		}
		return opMode(KValue, mkSlice(elemOf(u)))
	}
	if isSliceT(u) {
		return opMode(KValue, t)
	}
	if isBasicT(u) && isString(u) {
		if isUntyped(x.typ) {
			_ = convertUntyped(&x, TyString)
			t = TyString
		}
		return opMode(KValue, t)
	}
	errAt(E2002, e, formatTo(mbuf[:], "cannot slice %v (type %v)", Expr(na(e)), TypeRef(x.typ)))
	return invalidOp(e)
}

func newSel(s Selection) u32 {
	if selTab.count == 0 {
		selTab.count = 1
	}
	if selTab.count >= MaxSels {
		setFull("selections")
		return 0
	}
	id := selTab.count
	selTab.count++
	selTab.items[id] = s
	return u32(id)
}

func selectorExpr(e u32, dp usize) Operand decreases(dp) {
	if dp == 0 {
		tooDeep()
		return invalidOp(e)
	}
	sel := nb(e)
	psym := uses[usize(sel)]
	if psym != 0 {
		if nkind(na(e)) == NkIdent {
			nmode[usize(na(e))] = KPackage
		}
		x := symOperand(psym, sel, dp-1)
		x.expr = sel
		record(&x)
		return x
	}
	x := rawExpr(na(e), dp-1)
	if x.mode == KNone || x.mode == KPackage {
		return invalidOp(e)
	}
	name := idName(sel)
	if x.mode == KType {
		en := underlying(x.typ)
		if !isEnumT(en) {
			errAt(E2001, sel, formatTo(mbuf[:], "%v.%v undefined (type %v is not an enum; method expressions are not supported)", Expr(na(e)), NameRef(name), TypeRef(x.typ)))
			return invalidOp(e)
		}
		vi, found := variantByName(en, name)
		if !found {
			errAt(E2001, sel, formatTo(mbuf[:], "%v.%v undefined (enum %v has no variant %v)", Expr(na(e)), NameRef(name), TypeRef(x.typ), NameRef(name)))
			return invalidOp(e)
		}
		var s Selection
		s.kind = SelVariant
		s.recv = x.typ
		s.ctype = en
		s.index = u32(vi)
		nsel[usize(e)] = newSel(s)
		if variantPayN(en, vi) == 0 {
			return opConst(x.typ, Val.Enum(u32(vi), 0, 0))
		}
		r := opMode(KVariantCtor, x.typ)
		r.vEnum = en
		r.vIndex = u32(vi)
		return r
	}
	singleValue(&x)
	if isInvalidOp(&x) {
		return invalidOp(e)
	}
	t := x.typ
	indirect := false
	if isPointerT(underlying(t)) {
		t = elemOf(underlying(t))
		indirect = true
	}
	st := underlying(t)
	if isStructT(st) {
		fi, found := fieldByName(st, name)
		if found {
			var s Selection
			s.kind = SelField
			s.recv = x.typ
			s.indirect = indirect
			s.ctype = st
			s.index = u32(fi)
			nsel[usize(e)] = newSel(s)
			ft := fieldType(st, fi)
			ntype[usize(sel)] = ft
			mode := u8(KValue)
			if x.mode == KVar || indirect {
				mode = KVar
			}
			return opMode(mode, ft)
		}
	}
	if isNamedT(t) {
		m := lookupMethod(t, name, dp-1)
		if m != 0 {
			var s Selection
			s.kind = SelMethod
			s.recv = x.typ
			s.indirect = indirect && !meths.items[usize(m)].ptrRecv
			s.method = m
			nsel[usize(e)] = newSel(s)
			r := opMode(KFunc, TyInvalid)
			r.method = m
			r.recv = na(e)
			r.recvType = x.typ
			r.indirect = indirect
			r.addressable = x.mode == KVar
			return r
		}
	}
	errAt(E2001, sel, formatTo(mbuf[:], "%v.%v undefined (type %v has no field or method %v)", Expr(na(e)), NameRef(name), TypeRef(x.typ), NameRef(name)))
	return invalidOp(e)
}

func structLit(e u32, dp usize) Operand decreases(dp) {
	if dp == 0 {
		tooDeep()
		return invalidOp(e)
	}
	t := typExpr(na(e), dp-1)
	nfi := l1len(e)
	if isInvalid(t) {
		for i := usize(0); i < nfi; i++ {
			_ = rawExpr(nb(l1at(e, i)), dp-1)
		}
		return invalidOp(e)
	}
	st := underlying(t)
	if !isStructT(st) {
		errAt(E2002, na(e), formatTo(mbuf[:], "invalid composite literal type %v (not a struct)", TypeRef(t)))
		return invalidOp(e)
	}
	allConst := true
	for i := usize(0); i < nfi; i++ {
		fi := l1at(e, i)
		fname := idName(na(fi))
		idx, found := fieldByName(st, fname)
		if !found {
			errAt(E2001, na(fi), formatTo(mbuf[:], "unknown field %v in struct literal of type %v", NameRef(fname), TypeRef(t)))
			_ = rawExpr(nb(fi), dp-1)
			allConst = false
			continue
		}
		for j := usize(0); j < i; j++ {
			if idName(na(l1at(e, j))) == fname {
				errAt(E2002, na(fi), formatTo(mbuf[:], "duplicate field %v in struct literal", NameRef(fname)))
				break
			}
		}
		ft := fieldType(st, idx)
		ntype[usize(na(fi))] = ft
		x := exprWith(nb(fi), ft, mkCtx(CtxStructLit), dp-1)
		if x.mode != KConst {
			allConst = false
		}
	}
	nf := nfields(st)
	for i := usize(0); i < nf; i++ {
		fname := fieldName(st, i)
		set := false
		for j := usize(0); j < nfi; j++ {
			if idName(na(l1at(e, j))) == fname {
				set = true
				break
			}
		}
		if !set && isScoped(fieldType(st, i)) {
			errAt(E2005, e, formatTo(mbuf[:], "missing initializer for field %v of Scoped type %v", NameRef(fname), TypeRef(fieldType(st, i))))
		}
	}
	if allConst && classOfT(t) == ClassValue {
		v, ok := structValue(e, st)
		if ok {
			return opConst(t, v)
		}
	}
	return opMode(KValue, t)
}

// structValue builds the constant value of a struct literal whose fields
// are all constant.
func structValue(e u32, st u32) (Val, bool) {
	z, ok := zeroVal(st, false)
	if !ok {
		return z, false
	}
	n := l1len(e)
	for i := usize(0); i < n; i++ {
		fi := l1at(e, i)
		idx, found := fieldByName(st, idName(na(fi)))
		if found {
			vs := nval[usize(nb(fi))]
			if vs == 0 {
				return z, false
			}
			slotSet(fieldSlot(z, u32(idx)), slotGet(vs))
		}
	}
	return z, true
}

func funcLit(e u32, dp usize) Operand decreases(dp) {
	if dp == 0 {
		tooDeep()
		return invalidOp(e)
	}
	eff := u8(EffTotal)
	if nflag(e) {
		eff = EffDriver
	}
	sig := signature(na(e), eff, 0, 0, dp-1)
	var fi FuncInfo
	fi.lit = e
	fi.outer = chkFn
	fi.effect = eff
	fi.sig = sig
	fi.body = nb(e)
	fid := newFuncInfo(fi)
	if fid == 0 {
		return invalidOp(e)
	}
	nfunc[usize(e)] = fid
	ps, pn := paramSyms(na(e), sig)
	funcs.items[usize(fid)].parS = ps
	funcs.items[usize(fid)].parN = pn
	if chkFn != 0 {
		h, t := cellAppend(funcs.items[usize(chkFn)].litH, funcs.items[usize(chkFn)].litT, fid)
		funcs.items[usize(chkFn)].litH = h
		funcs.items[usize(chkFn)].litT = t
	} else {
		errAt(E2002, e, formatTo(mbuf[:], "function literal outside a function"))
	}
	c := enterFn(fid)
	funcBody(fid, dp-1)
	restoreFn(c)
	return opMode(KValue, sig)
}

// ---------------------------------------------------------------------------
// Calls (call.go)

func newCall() u32 {
	if callTab.count == 0 {
		callTab.count = 1
	}
	if callTab.count >= MaxCalls {
		setFull("calls")
		return 0
	}
	id := callTab.count
	callTab.count++
	var c Call
	c.effect = EffTotal
	callTab.items[id] = c
	return u32(id)
}

func callExpr(e u32, dp usize) Operand decreases(dp) {
	if dp == 0 {
		tooDeep()
		return invalidOp(e)
	}
	x := call0(e, dp-1)
	ci := ncall[usize(e)]
	if ci != 0 && callTab.items[usize(ci)].method != 0 && callTab.items[usize(ci)].sig != 0 {
		ntype[usize(na(e))] = callTab.items[usize(ci)].sig
	}
	return x
}

// useArgs checks the arguments [from:] of an erroneous call.
func useArgs(e u32, from usize, dp usize) decreases(dp) {
	if dp == 0 {
		tooDeep()
		return
	}
	n := l1len(e)
	for i := from; i < n; i++ {
		_ = rawExpr(l1at(e, i), dp-1)
	}
}

func callResultType(sig u32) Operand {
	r := sigResultType(sig)
	if r == 0 {
		return opMode(KNoValue, 0)
	}
	return opMode(KValue, r)
}

// shouldFold: comptime calls are evaluated at compile time except inside
// comptime bodies outside constant contexts.
func shouldFold() bool {
	return !(chkFn != 0 && funcs.items[usize(chkFn)].effect == EffComptime && chkConstCtx == 0)
}

func call0(e u32, dp usize) Operand decreases(dp) {
	if dp == 0 {
		tooDeep()
		return invalidOp(e)
	}
	fun := rawExpr(na(e), dp-1)
	ci := newCall()
	if ci == 0 {
		return invalidOp(e)
	}
	ncall[usize(e)] = ci
	if chkFn != 0 {
		h, t := cellAppend(funcs.items[usize(chkFn)].callH, funcs.items[usize(chkFn)].callT, e)
		funcs.items[usize(chkFn)].callH = h
		funcs.items[usize(chkFn)].callT = t
	}
	m := fun.mode
	if m == KType {
		return conversion(e, fun.typ, ci, dp-1)
	}
	if m == KBuiltin {
		return builtinCall(e, fun.sym, ci, dp-1)
	}
	if m == KVariantCtor {
		return variantCall(e, &fun, ci, dp-1)
	}
	if m == KFunc {
		if fun.method != 0 {
			return methodCall(e, &fun, ci, dp-1)
		}
		sig := fun.typ
		if sig == 0 || !isSigT(sig) {
			useArgs(e, 0, dp-1)
			return invalidOp(e)
		}
		if sigNTParams(sig) > 0 {
			errAt(E2002, na(e), formatTo(mbuf[:], "cannot call generic function %v without instantiation (type arguments must be explicit, e.g. %v[T](...))", Expr(na(e)), Expr(na(e))))
			useArgs(e, 0, dp-1)
			return invalidOp(e)
		}
		callTab.items[usize(ci)].kind = CallFunc
		callTab.items[usize(ci)].callee = fun.sym
		callTab.items[usize(ci)].sig = sig
		callTab.items[usize(ci)].effect = sigEffect(sig)
		inst := ninst[usize(unparen(na(e)))]
		if inst != 0 {
			callTab.items[usize(ci)].taS = insts.items[usize(inst)].argS
			callTab.items[usize(ci)].taN = insts.items[usize(inst)].argN
		}
		mark := opStack.top
		ok := arguments(e, sigParamsSlice(sig), sigVariadic(sig), Ctx{kind: CtxArgExpr, a: na(e), b: 0}, dp-1)
		if !ok {
			opStack.top = mark
			return invalidOp(e)
		}
		if sigEffect(sig) == EffComptime && shouldFold() {
			r := foldComptime(e, fun.sym, sig, mark, ci, dp-1)
			opStack.top = mark
			return r
		}
		opStack.top = mark
		return callResultType(sig)
	}
	if m == KValue || m == KVar {
		sig := underlying(fun.typ)
		if !isSigT(sig) {
			errAt(E2002, na(e), formatTo(mbuf[:], "cannot call non-function %v (type %v)", Expr(na(e)), TypeRef(fun.typ)))
			useArgs(e, 0, dp-1)
			return invalidOp(e)
		}
		callTab.items[usize(ci)].kind = CallValue
		callTab.items[usize(ci)].sig = sig
		callTab.items[usize(ci)].effect = sigEffect(sig)
		if builtinOf(fun.typ) == BTCancelFunc {
			callTab.items[usize(ci)].consumesRecv = true
		}
		mark := opStack.top
		_ = arguments(e, sigParamsSlice(sig), sigVariadic(sig), Ctx{kind: CtxArgExpr, a: na(e), b: 0}, dp-1)
		opStack.top = mark
		return callResultType(sig)
	}
	if m == KPackage {
		errAt(E2002, na(e), formatTo(mbuf[:], "cannot call package %v", Expr(na(e))))
	}
	useArgs(e, 0, dp-1)
	return invalidOp(e)
}

// arguments checks call arguments against parameter types; the argument
// operands are left on opStack (from the mark at entry) for the caller.
func arguments(e u32, params []u32, variadic bool, c Ctx, dp usize) bool decreases(dp) {
	if dp == 0 {
		tooDeep()
		return false
	}
	mark := opStack.top
	nargs := l1len(e)
	for i := usize(0); i < nargs; i++ {
		x := rawExpr(l1at(e, i), dp-1)
		opPush(x)
	}
	if nargs == 1 && opStack.items[mark].mode == KValue {
		t0 := opStack.items[mark].typ
		if t0 != 0 && isTupleT(t0) {
			first := opStack.items[mark]
			opStack.top = mark
			nt := tupleN(t0)
			for i := usize(0); i < nt; i++ {
				x := opMode(KValue, tupleAt(t0, i))
				x.expr = first.expr
				opPush(x)
			}
		}
	}
	ok := true
	top := opStack.top
	for i := mark; i < top; i++ {
		t := opStack.items[i].typ
		if t != 0 && isTupleT(t) && nargs == 1 {
			continue
		}
		singleValue(&opStack.items[i])
		if opStack.items[i].mode == KNone {
			ok = false
		}
	}
	n := top - mark
	np := len(params)
	if (variadic && n+1 < np) || (!variadic && n != np) {
		errAt(E2003, e, formatTo(mbuf[:], "%s arguments in call to %v: have %d, want %d", tooMany(n > np), CallName(c), n, np))
		return false
	}
	for i := usize(0); i < n; i++ {
		if opStack.items[mark+i].mode == KNone {
			continue
		}
		pi := i
		if pi > np-1 {
			pi = np - 1
		}
		if !assignment(&opStack.items[mark+i], params[pi], c) {
			ok = false
		}
	}
	return ok
}

func foldComptime(e u32, fn u32, sig u32, mark usize, ci u32, dp usize) Operand decreases(dp) {
	if dp == 0 {
		tooDeep()
		return invalidOp(e)
	}
	top := opStack.top
	vmark := vtop
	for i := mark; i < top; i++ {
		a := opStack.items[i]
		if a.mode != KConst || a.val == Val.None {
			errAt(E2002, a.expr, formatTo(mbuf[:], "argument %v to comptime function %v must be a compile-time constant", Expr(a.expr), NameRef(symName(fn))))
			vtop = vmark
			return invalidOp(e)
		}
		vpush(a.val)
	}
	v, ok := callComptime(fn, vmark, dp-1)
	vtop = vmark
	if !ok {
		if ifailCode != 0 {
			errAt(ifailCode, e, formatTo(mbuf[:], "%s", (&ifailMsg).Bytes()))
		}
		return invalidOp(e)
	}
	callTab.items[usize(ci)].folded = true
	r := sigResultType(sig)
	if r == 0 {
		return opMode(KNoValue, 0)
	}
	if isTupleT(r) {
		nval[usize(e)] = valStore(v)
		return opMode(KValue, r)
	}
	return opConst(r, v)
}

func methodCall(e u32, fun *Operand, ci u32, dp usize) Operand decreases(dp) {
	if dp == 0 {
		tooDeep()
		return invalidOp(e)
	}
	m := fun.method
	mr := meths.items[usize(m)]
	recvType := fun.recvType
	if mr.ptrRecv && !fun.indirect {
		// v0.2 ergonomics: x.M() means (&x).M() for an addressable x.
		if !fun.addressable {
			errAt(E2002, na(e), formatTo(mbuf[:], "cannot call pointer method %v on %v (type %v): value is not addressable", NameRef(mr.name), Expr(fun.recv), TypeRef(fun.recvType)))
			useArgs(e, 0, dp-1)
			return invalidOp(e)
		}
		callTab.items[usize(ci)].autoAddr = true
		recvType = mkPointer(fun.recvType)
	}
	callTab.items[usize(ci)].method = m
	callTab.items[usize(ci)].recv = fun.recv
	callTab.items[usize(ci)].recvType = recvType
	if mr.builtin != BMNone {
		return builtinMethodCall(e, m, ci, dp-1)
	}
	callTab.items[usize(ci)].kind = CallMethod
	callTab.items[usize(ci)].callee = mr.sym
	sig := mr.sig
	if sig == 0 {
		useArgs(e, 0, dp-1)
		return invalidOp(e)
	}
	base, _ := derefType(recvType)
	if isNamedT(base) && namedOrigin(base) != 0 && mr.rtpN > 0 {
		bs, bn := namedArgList(base)
		sig = subst(sig, mr.rtpS, mr.rtpN, bs, bn, SemaDepth)
		callTab.items[usize(ci)].taS = bs
		callTab.items[usize(ci)].taN = bn
	}
	callTab.items[usize(ci)].sig = sig
	callTab.items[usize(ci)].effect = sigEffect(sig)
	mark := opStack.top
	_ = arguments(e, sigParamsSlice(sig), sigVariadic(sig), Ctx{kind: CtxArgMethod, a: m, b: 0}, dp-1)
	opStack.top = mark
	return callResultType(sig)
}

func mWrongArgs(e u32, m u32, have usize, want usize) {
	errAt(E2003, e, formatTo(mbuf[:], "wrong number of arguments in call to %v: have %d, want %d", CallName(Ctx{kind: CtxArgMethod, a: m, b: 0}), have, want))
}

func builtinMethodCall(e u32, m u32, ci u32, dp usize) Operand decreases(dp) {
	if dp == 0 {
		tooDeep()
		return invalidOp(e)
	}
	b := meths.items[usize(m)].builtin
	callTab.items[usize(ci)].kind = CallBuiltinMeth
	callTab.items[usize(ci)].effect = methodEffect(m)
	if b == BMNetListenTCP || b == BMListenerAccept || b == BMContextWithTimeout || b == BMSignalsNotifyCtx {
		callTab.items[usize(ci)].resourceCtor = true
	}
	if b == BMConnClose || b == BMListenerClose {
		callTab.items[usize(ci)].consumesRecv = true
	}
	ctxT := univNamed[BTContext]
	c := Ctx{kind: CtxArgMethod, a: m, b: 0}
	nargs := l1len(e)
	if b == BMScopeAcquireSlot {
		callTab.items[usize(ci)].resourceCtor = true
		if nargs != 2 {
			mWrongArgs(e, m, nargs, 2)
			useArgs(e, 0, dp-1)
			return invalidOp(e)
		}
		_ = exprWith(l1at(e, 0), ctxT, c, dp-1)
		a1 := l1at(e, 1)
		pool := exprValue(a1, dp-1)
		if isInvalidOp(&pool) {
			return invalidOp(e)
		}
		arr := u32(0)
		pu := underlying(pool.typ)
		if isPointerT(pu) {
			au := underlying(elemOf(pu))
			if isArrayT(au) {
				arr = au
			}
		}
		alen, lenParam := arrayLenOf(arr)
		if arr == 0 || lenParam != 0 {
			errAt(E2002, a1, formatTo(mbuf[:], "cannot use %v (type %v) as pool argument to %v: want *[N]T", Expr(a1), TypeRef(pool.typ), CallName(c)))
			return invalidOp(e)
		}
		elem := elemOf(arr)
		am := tmark()
		tpush(elem)
		as, an := tcommitStack(am)
		slot := instantiate(univNamed[BTSlot], tlistSlice(as, an), 0, SemaDepth)
		tm := tmark()
		tpush(mkConstArg(alen))
		tpush(elem)
		ts, tn := tcommitStack(tm)
		callTab.items[usize(ci)].taS = ts
		callTab.items[usize(ci)].taN = tn
		m1 := tmark()
		tpush(ctxT)
		tpush(pool.typ)
		m2 := tmark()
		tpush(slot)
		tpush(TyError)
		sig := mkSig(EffTotal, false, m1, m2, tmark())
		callTab.items[usize(ci)].sig = sig
		return opMode(KValue, sigResultType(sig))
	}
	if b == BMScopeReleaseSlot || b == BMScopeGo {
		want := usize(1)
		if b == BMScopeGo {
			want = 2
		}
		if nargs != want {
			mWrongArgs(e, m, nargs, want)
			useArgs(e, 0, dp-1)
			return invalidOp(e)
		}
		callTab.items[usize(ci)].consumesArg0 = true
		a0 := l1at(e, 0)
		s := exprValue(a0, dp-1)
		if isInvalidOp(&s) {
			useArgs(e, 1, dp-1)
			return invalidOp(e)
		}
		sn := s.typ
		if !isNamedT(sn) || namedOrigin(sn) == 0 || namedBuiltin(namedOrigin(sn)) != BTSlot {
			errAt(E2002, a0, formatTo(mbuf[:], "cannot use %v (type %v) as Slot argument to %v", Expr(a0), TypeRef(s.typ), CallName(c)))
			useArgs(e, 1, dp-1)
			return invalidOp(e)
		}
		elem := namedArg(sn, 0)
		tm := tmark()
		tpush(elem)
		ts, tn := tcommitStack(tm)
		callTab.items[usize(ci)].taS = ts
		callTab.items[usize(ci)].taN = tn
		if b == BMScopeGo {
			f1 := tmark()
			tpush(mkPointer(elem))
			f2 := tmark()
			fnT := mkSig(EffDriver, false, f1, f2, f2)
			s1 := tmark()
			tpush(sn)
			tpush(fnT)
			s2 := tmark()
			callTab.items[usize(ci)].sig = mkSig(EffTotal, false, s1, s2, s2)
			_ = exprWith(l1at(e, 1), fnT, c, dp-1)
		} else {
			s1 := tmark()
			tpush(sn)
			s2 := tmark()
			callTab.items[usize(ci)].sig = mkSig(EffTotal, false, s1, s2, s2)
		}
		return opMode(KNoValue, 0)
	}
	sig := meths.items[usize(m)].sig
	callTab.items[usize(ci)].sig = sig
	mark := opStack.top
	_ = arguments(e, sigParamsSlice(sig), sigVariadic(sig), c, dp-1)
	opStack.top = mark
	return callResultType(sig)
}

// containsCall reports whether the subtree of e contains a CallExpr.
func containsCall(e u32, dp usize) bool decreases(dp) {
	if dp == 0 || e == 0 {
		return false
	}
	n := nodes.items[usize(e)]
	if n.kind == NkCallExpr {
		return true
	}
	for i := usize(0); i < MaxSlots; i++ {
		slot, _ := layout(n.kind, i)
		if slot == SlotNone {
			break
		}
		if slot >= SlotL1 {
			start, cnt := slotList(n, slot)
			m := usize(cnt)
			for j := usize(0); j < m; j++ {
				if containsCall(listAt(start, j), dp-1) {
					return true
				}
			}
		} else if containsCall(slotChild(n, slot), dp-1) {
			return true
		}
	}
	return false
}

func builtinNargs(e u32, b u8, want usize, dp usize) bool decreases(dp) {
	if dp == 0 {
		tooDeep()
		return false
	}
	n := l1len(e)
	if n != want {
		errAt(E2003, e, formatTo(mbuf[:], "%s arguments in call to %s: have %d, want %d", tooMany(n > want), builtinName(b), n, want))
		useArgs(e, 0, dp-1)
		return false
	}
	return true
}

// builtinFixed checks a builtin with a fixed signature (params stack
// [m1:m2], results [m2:top]).
func builtinFixed(e u32, b u8, ci u32, m1 usize, m2 usize, dp usize) Operand decreases(dp) {
	if dp == 0 {
		tooDeep()
		return invalidOp(e)
	}
	sig := mkSig(EffTotal, false, m1, m2, tmark())
	callTab.items[usize(ci)].sig = sig
	mark := opStack.top
	_ = arguments(e, sigParamsSlice(sig), false, Ctx{kind: CtxArgBuiltin, a: u32(b), b: 0}, dp-1)
	opStack.top = mark
	return callResultType(sig)
}

func builtinCall(e u32, sym u32, ci u32, dp usize) Operand decreases(dp) {
	if dp == 0 {
		tooDeep()
		return invalidOp(e)
	}
	b := syms.items[usize(sym)].builtin
	callTab.items[usize(ci)].kind = CallBuiltin
	callTab.items[usize(ci)].builtin = b
	callTab.items[usize(ci)].callee = sym
	if builtinIsCodeCtor(b) {
		return codeCtor(e, b, ci, dp-1)
	}
	bytesT := mkSlice(TyU8)
	if b == BFLen || b == BFCap {
		if !builtinNargs(e, b, 1, dp-1) {
			return invalidOp(e)
		}
		a0 := l1at(e, 0)
		x := exprValue(a0, dp-1)
		if isInvalidOp(&x) {
			return invalidOp(e)
		}
		t := x.typ
		viaPtr := false
		u := underlying(t)
		if isPointerT(u) && isArrayT(underlying(elemOf(u))) {
			t = elemOf(u)
			viaPtr = true
		}
		u = underlying(t)
		if isArrayT(u) {
			alen, lenParam := arrayLenOf(u)
			if lenParam == 0 && !viaPtr && !containsCall(a0, SemaDepth) {
				return opConst(TyUsize, vIntU(alen))
			}
			return opMode(KValue, TyUsize)
		}
		if isSliceT(u) {
			return opMode(KValue, TyUsize)
		}
		if isBasicT(u) && isString(u) && b == BFLen {
			if isUntyped(x.typ) {
				_ = convertUntyped(&x, TyString)
			}
			if x.mode == KConst {
				return opConst(TyUsize, vIntU(u64(len(strOf(x.val)))))
			}
			return opMode(KValue, TyUsize)
		}
		errAt(E2002, a0, formatTo(mbuf[:], "invalid argument %v (type %v) for %s", Expr(a0), TypeRef(x.typ), builtinName(b)))
		return invalidOp(e)
	}
	if b == BFCopy {
		if !builtinNargs(e, b, 2, dp-1) {
			return invalidOp(e)
		}
		d := exprValue(l1at(e, 0), dp-1)
		s := exprValue(l1at(e, 1), dp-1)
		if isInvalidOp(&d) || isInvalidOp(&s) {
			return invalidOp(e)
		}
		if basicKind(s.typ) == BkUntypedString && isByteSliceT(d.typ) {
			// v0.2: copy(dst, "...") copies from an implicit strBytes
			if !convertUntyped(&s, mkSlice(TyU8)) {
				return invalidOp(e)
			}
		}
		du := underlying(d.typ)
		su := underlying(s.typ)
		if !isSliceT(du) || !isSliceT(su) || elemOf(du) != elemOf(su) {
			errAt(E2002, e, formatTo(mbuf[:], "arguments to copy must be slices with identical element types (have %v and %v)", TypeRef(d.typ), TypeRef(s.typ)))
			return invalidOp(e)
		}
		tm := tmark()
		tpush(elemOf(du))
		ts, tn := tcommitStack(tm)
		callTab.items[usize(ci)].taS = ts
		callTab.items[usize(ci)].taN = tn
		m1 := tmark()
		tpush(d.typ)
		tpush(s.typ)
		m2 := tmark()
		tpush(TyUsize)
		callTab.items[usize(ci)].sig = mkSig(EffTotal, false, m1, m2, tmark())
		return opMode(KValue, TyUsize)
	}
	if b == BFPanic {
		callTab.items[usize(ci)].effect = EffDriver
		if !builtinNargs(e, b, 1, dp-1) {
			return invalidOp(e)
		}
		x := exprValue(l1at(e, 0), dp-1)
		if !isInvalidOp(&x) {
			_ = defaultTypeOp(&x, Ctx{kind: CtxArgBuiltin, a: u32(b), b: 0})
		}
		return opMode(KNoValue, 0)
	}
	m1 := tmark()
	if b == BFBytesEqual {
		tpush(bytesT)
		tpush(bytesT)
		m2 := tmark()
		tpush(TyBool)
		return builtinFixed(e, b, ci, m1, m2, dp-1)
	}
	if b == BFStrBytes {
		tpush(TyString)
		m2 := tmark()
		tpush(bytesT)
		return builtinFixed(e, b, ci, m1, m2, dp-1)
	}
	if b == BFBytesToStr {
		tpush(bytesT)
		m2 := tmark()
		tpush(TyString)
		return builtinFixed(e, b, ci, m1, m2, dp-1)
	}
	if b == BFFormatUint {
		tpush(TyU64)
		tpush(bytesT)
		m2 := tmark()
		tpush(TyUsize)
		tpush(TyError)
		return builtinFixed(e, b, ci, m1, m2, dp-1)
	}
	if b == BFParseUint {
		tpush(bytesT)
		m2 := tmark()
		tpush(TyU64)
		tpush(TyError)
		return builtinFixed(e, b, ci, m1, m2, dp-1)
	}
	if b == BFNewContext {
		callTab.items[usize(ci)].resourceCtor = true
		m2 := tmark()
		tpush(univNamed[BTContext])
		tpush(univNamed[BTCancelFunc])
		return builtinFixed(e, b, ci, m1, m2, dp-1)
	}
	if b == BFNewScope {
		callTab.items[usize(ci)].resourceCtor = true
		tpush(TyUsize)
		m2 := tmark()
		tpush(univNamed[BTScope])
		return builtinFixed(e, b, ci, m1, m2, dp-1)
	}
	if b == BFFormatTo {
		return formatCall(e, ci, dp-1)
	}
	errAt(E2002, e, formatTo(mbuf[:], "unsupported builtin %s", builtinName(b)))
	return invalidOp(e)
}

// codeArg checks a Code argument of a Code constructor.
func codeArg(a u32, b u8, dp usize) (Operand, bool) decreases(dp) {
	if dp == 0 {
		tooDeep()
		return invalidOp(a), false
	}
	x := exprValue(a, dp-1)
	if isInvalidOp(&x) {
		return x, false
	}
	if !isCodeT(x.typ) {
		errAt(E2002, a, formatTo(mbuf[:], "cannot use %v (type %v) as Code argument to %s", Expr(a), TypeRef(x.typ), builtinName(b)))
		return x, false
	}
	return x, true
}

// codeCtor types the Code constructors (spec 5.1).
func codeCtor(e u32, b u8, ci u32, dp usize) Operand decreases(dp) {
	if dp == 0 {
		tooDeep()
		return invalidOp(e)
	}
	callTab.items[usize(ci)].effect = EffComptime
	want := usize(0)
	if b == BFCodeArray || b == BFCodeField {
		want = 2
	} else if b == BFCodeSlice || b == BFCodeStruct || b == BFCodeUniv {
		want = 1
	}
	nargs := l1len(e)
	c := Ctx{kind: CtxArgBuiltin, a: u32(b), b: 0}
	if nargs != want {
		errAt(E2003, e, formatTo(mbuf[:], "wrong number of arguments in call to %s: have %d, want %d", builtinName(b), nargs, want))
		useArgs(e, 0, dp-1)
		return invalidOp(e)
	}
	if b == BFCodeArray {
		n := exprWith(l1at(e, 0), TyUsize, c, dp-1)
		el, ok := codeArg(l1at(e, 1), b, dp-1)
		if isInvalidOp(&n) || !ok {
			return invalidOp(e)
		}
		lvl := codeLevel(el.typ)
		if n.mode == KConst && el.mode == KConst {
			ln, _ := valUint64(n.val)
			return opConst(mkCode(lvl), Val.CodeArray(ln, valStore(el.val)))
		}
		return opMode(KValue, mkCode(lvl))
	}
	if b == BFCodeSlice {
		el, ok := codeArg(l1at(e, 0), b, dp-1)
		if !ok {
			return invalidOp(e)
		}
		lvl := codeLevel(el.typ)
		if el.mode == KConst {
			return opConst(mkCode(lvl), Val.CodeSlice(valStore(el.val)))
		}
		return opMode(KValue, mkCode(lvl))
	}
	if b == BFCodeStruct {
		fc := univNamed[BTFieldCode]
		x := exprWith(l1at(e, 0), mkSlice(fc), c, dp-1)
		if isInvalidOp(&x) {
			return invalidOp(e)
		}
		return opMode(KValue, mkCode(-1))
	}
	if b == BFCodeField {
		n := exprWith(l1at(e, 0), TyString, c, dp-1)
		el, ok := codeArg(l1at(e, 1), b, dp-1)
		if isInvalidOp(&n) || !ok {
			return invalidOp(e)
		}
		fc := univNamed[BTFieldCode]
		if n.mode == KConst && el.mode == KConst {
			return opConst(fc, fieldCodeOf(n.val, valStore(el.val)))
		}
		return opMode(KValue, fc)
	}
	if b == BFCodeUniv {
		a0 := l1at(e, 0)
		n := exprWith(a0, TyUsize, c, dp-1)
		if isInvalidOp(&n) {
			return invalidOp(e)
		}
		if n.mode != KConst {
			errAt(E2010, a0, formatTo(mbuf[:], "CodeUniv level %v must be a compile-time constant (its type Code (n+1) depends on it)", Expr(a0)))
			return invalidOp(e)
		}
		lv, ok := valUint64(n.val)
		if !ok || lv >= 1<<20 {
			errAt(E2010, a0, formatTo(mbuf[:], "invalid universe level %v", ValRef(n.val)))
			return invalidOp(e)
		}
		return opConst(mkCode(int(lv)+1), Val.CodeUniv(lv))
	}
	return opConst(mkCode(-1), Val.CodeBasic(b-BFCodeEmpty))
}

func conversion(e u32, t u32, ci u32, dp usize) Operand decreases(dp) {
	if dp == 0 {
		tooDeep()
		return invalidOp(e)
	}
	callTab.items[usize(ci)].kind = CallConversion
	callTab.items[usize(ci)].conv = t
	nargs := l1len(e)
	if nargs != 1 {
		errAt(E2003, e, formatTo(mbuf[:], "conversion to %v needs exactly one argument, have %d", TypeRef(t), nargs))
		useArgs(e, 0, dp-1)
		return invalidOp(e)
	}
	a0 := l1at(e, 0)
	x := exprValue(a0, dp-1)
	if isInvalidOp(&x) {
		return invalidOp(e)
	}
	if (isTypeParamT(t) || isTypeParamT(x.typ)) && t != x.typ {
		errAt(E2011, e, formatTo(mbuf[:], "conversion %v inspects a type parameter (from %v to %v)", Expr(e), TypeRef(x.typ), TypeRef(t)))
		return invalidOp(e)
	}
	if isUntyped(x.typ) {
		if isInteger(x.typ) && isInteger(t) || isBoolean(x.typ) && isBoolean(t) || isString(x.typ) && isString(t) {
			if x.val != Val.None && !representable(x.val, t) {
				errAt(E2002, a0, formatTo(mbuf[:], "cannot convert %v (constant %v) to %v: overflows", Expr(a0), ValRef(x.val), TypeRef(t)))
				return invalidOp(e)
			}
			updateType(a0, t, SemaDepth)
			return opConst(t, x.val)
		}
		if !convertUntyped(&x, t) {
			return invalidOp(e)
		}
		return opMode(KValue, t)
	}
	if !convertible(x.typ, t) {
		errAt(E2002, e, formatTo(mbuf[:], "cannot convert %v (type %v) to %v", Expr(a0), TypeRef(x.typ), TypeRef(t)))
		return invalidOp(e)
	}
	if x.mode == KConst && x.val != Val.None {
		if isInteger(t) && !representable(x.val, t) {
			errAt(E2002, a0, formatTo(mbuf[:], "cannot convert constant %v to %v: overflows", ValRef(x.val), TypeRef(t)))
			return invalidOp(e)
		}
		return opConst(t, x.val)
	}
	return opMode(KValue, t)
}

func convertible(v u32, t u32) bool {
	if assignable(v, t) {
		return true
	}
	vu := underlying(v)
	tu := underlying(t)
	if vu == tu {
		return true
	}
	if isInteger(vu) && isInteger(tu) {
		return true
	}
	if isPointerT(vu) && isPointerT(tu) {
		return underlying(elemOf(vu)) == underlying(elemOf(tu))
	}
	return false
}

func variantCall(e u32, fun *Operand, ci u32, dp usize) Operand decreases(dp) {
	if dp == 0 {
		tooDeep()
		return invalidOp(e)
	}
	en := fun.vEnum
	vi := usize(fun.vIndex)
	callTab.items[usize(ci)].kind = CallVariant
	callTab.items[usize(ci)].variantEnum = en
	callTab.items[usize(ci)].variant = fun.vIndex
	callTab.items[usize(ci)].variantType = fun.typ
	ps := usize(variantPayS(en, vi))
	pn := variantPayN(en, vi)
	mark := opStack.top
	ok := arguments(e, tlistSlice(u32(ps), u32(pn)), false, Ctx{kind: CtxArgVariant, a: fun.typ, b: variantName(en, vi)}, dp-1)
	if !ok {
		opStack.top = mark
		return opMode(KValue, fun.typ)
	}
	top := opStack.top
	for i := mark; i < top; i++ {
		if opStack.items[i].mode != KConst {
			opStack.top = mark
			return opMode(KValue, fun.typ)
		}
	}
	n := top - mark
	st := valAlloc(n, false)
	for i := usize(0); i < n; i++ {
		slotSet(st+u32(i), opStack.items[mark+i].val)
	}
	opStack.top = mark
	return opConst(fun.typ, Val.Enum(u32(vi), st, u32(n)))
}

// funcInstance handles f[T1, ...] for a generic function f.
func funcInstance(e u32, x *Operand, dp usize) Operand decreases(dp) {
	if dp == 0 {
		tooDeep()
		return invalidOp(e)
	}
	sig := x.typ
	if sig == 0 || !isSigT(sig) || sigNTParams(sig) == 0 {
		errAt(E2002, e, formatTo(mbuf[:], "%v is not a generic function", Expr(na(e))))
		return invalidOp(e)
	}
	ni := l1len(e)
	ntp := sigNTParams(sig)
	if ni != ntp {
		errAt(E2003, e, formatTo(mbuf[:], "wrong number of type arguments for %v: have %d, want %d", Expr(na(e)), ni, ntp))
		return invalidOp(e)
	}
	mark := tmark()
	for i := usize(0); i < ni; i++ {
		ta := typeArg(l1at(e, i), sigTParam(sig, i), dp-1)
		if isInvalid(ta) {
			tdiscard(mark)
			return invalidOp(e)
		}
		tpush(ta)
	}
	as, an := tcommitStack(mark)
	args := tlistSlice(as, an)
	generic := mkSigLists(sigEffect(sig), sigVariadic(sig), sigParamsSlice(sig), sigResultsSlice(sig), emptyU32())
	tpS, tpN := sigTParamList(sig)
	inst := subst(generic, tpS, tpN, as, an, SemaDepth)
	rec := findInstRec(x.sym, args)
	if rec == 0 {
		var ir Inst
		ir.sym = x.sym
		ir.argS = as
		ir.argN = an
		ir.sig = inst
		ir.generic = anyTypeParam(args)
		rec = newInstRec(ir)
	}
	ninst[usize(e)] = rec
	r := opMode(KFunc, inst)
	r.sym = x.sym
	return r
}
