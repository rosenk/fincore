// codegen_expr.fc — the Go code generator, part 2: expressions and calls
// (port of finc0's codegen/golang expr.go). Every function appends to gw
// (see codegen.fc); the recursive ones belong to the codegen SCC and carry
// decreases(dp).
package main

// constValueSlot returns the value slot of e if e is a constant expression
// or a folded comptime call (fnCtx.constValue), else 0.
func cgConstValueSlot(e u32) u32 {
	if e == 0 {
		return 0
	}
	v := nval[usize(e)]
	if v == 0 {
		return 0
	}
	if nmode[usize(e)] == KConst {
		return v
	}
	if nkind(e) == NkCallExpr {
		c := ncall[usize(e)]
		if c != 0 && callTab.items[usize(c)].folded {
			return v
		}
	}
	return 0
}

// composite wraps a composite literal written since mark in parentheses
// inside statement headers (Go's `if x == T{} {` ambiguity).
func cgComposite(mark usize) {
	if cgHeader > 0 && cgWendsWith(mark, '}') {
		cgWwrap(mark)
	}
}

// constExpr writes the constant expression e with value v.
func cgConstExpr(e u32, v Val, typed bool, dp usize) decreases(dp) {
	if dp == 0 {
		cgFail(e, "expression too deep")
		return
	}
	k := nkind(e)
	if v is Tuple(..) {
		cgFail(e, "multi-value constant in single-value context")
		return
	}
	if k == NkBasicLit {
		cgBasicLit(e, v, typed, dp-1)
		return
	}
	cs := cgConstRefSym(e)
	if cs != 0 {
		cgWConstRef(e, cs, typed, dp-1)
		return
	}
	if k == NkCallExpr && l1len(e) == 1 {
		a0 := cgUnparenNode(l1at(e, 0))
		rs := cgConstRefSym(a0)
		if callKind(e) is Conversion(t) && rs != 0 {
			cgConvType(e, t, dp-1)
			cgWc('(')
			cgWConstRef(a0, rs, false, dp-1)
			cgWc(')')
			return
		}
	}
	if k == NkParenExpr {
		inner := cgUnparenNode(e)
		if nkind(inner) == NkBasicLit && !typed {
			cgBasicLit(inner, v, false, dp-1)
			return
		}
	}
	p := cgWmark()
	cgValue(e, v, ntype[usize(e)], dp-1)
	cgComposite(p)
}

// expr writes an expression.
func cgExpr(e u32, dp usize) decreases(dp) {
	if dp == 0 {
		cgFail(e, "expression too deep")
		return
	}
	typed := cgTyped
	cgTyped = false
	k := nkind(e)
	vs := cgConstValueSlot(e)
	if vs != 0 {
		v := slotGet(vs)
		if nbytes[usize(e)] {
			// a constant string used as []byte (v0.2): a fresh copy
			cgW("[]byte(")
			cgConstExpr(e, v, false, dp-1)
			cgWc(')')
			return
		}
		cgConstExpr(e, v, typed, dp-1)
		return
	}
	if k == NkIdent {
		cgIdent(e, dp-1)
	} else if k == NkParenExpr {
		cgWc('(')
		cgExpr(na(e), dp-1)
		cgWc(')')
	} else if k == NkBinaryExpr {
		cgBinary(e, dp-1)
	} else if k == NkUnaryExpr {
		cgUnary(e, dp-1)
	} else if k == NkCallExpr {
		cgCall(e, dp-1)
	} else if k == NkIndexExpr {
		ii := ninst[usize(e)]
		if ii != 0 && insts.items[usize(ii)].named == 0 {
			cgFuncRef(e, cgCalleeSym(na(e)), insts.items[usize(ii)].argS, usize(insts.items[usize(ii)].argN), dp-1)
			return
		}
		if l1len(e) != 1 {
			cgFail(e, "unsupported index expression")
			return
		}
		cgPrimary(na(e), dp-1)
		cgWc('[')
		cgExpr(l1at(e, 0), dp-1)
		cgWc(']')
	} else if k == NkSliceExpr {
		cgPrimary(na(e), dp-1)
		cgWc('[')
		if nb(e) != 0 {
			cgExpr(nb(e), dp-1)
		}
		cgWc(':')
		if nc(e) != 0 {
			cgExpr(nc(e), dp-1)
		}
		cgWc(']')
	} else if k == NkSelectorExpr {
		cgSelector(e, dp-1)
	} else if k == NkFuncLit {
		cgFuncLit(e, dp-1)
	} else if k == NkStructLit {
		cgStructLit(e, dp-1)
	} else if k == NkMatchExpr {
		cgMatchExpr(e, dp-1)
	} else if k == NkIsExpr {
		cgIsExpr(e, dp-1)
	} else if k is NkBasicLit | NkBoolLit | NkNilLit {
		cgFail(e, "literal without a recorded value")
	} else {
		cgFail(e, "unsupported expression")
	}
}

// basicLit writes a literal, keeping the source spelling where Go accepts
// it (fnCtx.basicLit).
func cgBasicLit(lit u32, v Val, typed bool, dp usize) decreases(dp) {
	if dp == 0 {
		return
	}
	t := ntype[usize(lit)]
	op := nop(lit)
	if op == LitString {
		named := isNamedT(t)
		if named {
			cgGoType(lit, t, dp-1)
			cgWc('(')
		}
		cgWQuoted(strOf(v))
		if named {
			cgWc(')')
		}
		return
	}
	raw := ntext(lit)
	if op == LitChar {
		if t == 0 || isUntyped(t) {
			t = TyU8
		}
		if typed {
			cgGoType(lit, t, dp-1)
			cgWc('(')
		}
		plain := len(raw) == 3
		nr := len(raw)
		for i := usize(0); i < nr; i++ {
			if raw[i] == '\\' {
				plain = false
			}
		}
		if plain {
			cgWb(raw)
		} else {
			cgWInt(v)
		}
		if typed {
			cgWc(')')
		}
		return
	}
	if t == 0 || cgIsUntypedOrInt(t) || !typed {
		cgWb(raw)
		return
	}
	cgGoType(lit, t, dp-1)
	cgWf(formatTo(mbuf[:], "(%s)", raw))
}

// convType writes the type of a conversion T(x).
func cgConvType(n u32, t u32, dp usize) decreases(dp) {
	if dp == 0 {
		return
	}
	p := cgWmark()
	cgGoType(n, t, dp-1)
	if cgWhasPrefix(p, "*") || cgWhasPrefix(p, "func") {
		cgWwrap(p)
	}
}

// constRefSym returns the constant symbol referenced by e if e names a
// constant declared as a Go constant (fnCtx.constRef != ""), else 0.
func cgConstRefSym(e u32) u32 {
	s := u32(0)
	k := nkind(e)
	if k == NkIdent {
		s = uses[usize(e)]
	} else if k == NkSelectorExpr {
		s = uses[usize(nb(e))]
	}
	if s == 0 || symKind(s) != SymConst {
		return 0
	}
	if !cgConstNameOK(s) {
		return 0
	}
	return s
}

// wConstRef writes the reference to constant s; untyped constants get an
// explicit type where typed asks for it.
func cgWConstRef(e u32, s u32, typed bool, dp usize) decreases(dp) {
	if dp == 0 {
		return
	}
	t := ntype[usize(e)]
	if typed && syms.items[usize(s)].untyped && t != 0 && !cgIsUntypedOrInt(t) && !isUntyped(t) {
		cgGoType(e, t, dp-1)
		cgWc('(')
		cgWConstName(s)
		cgWc(')')
		return
	}
	cgWConstName(s)
}

// typedConst writes a constant operand with an explicit Go type.
func cgTypedConst(e u32, v Val, dp usize) decreases(dp) {
	if dp == 0 {
		return
	}
	t := ntype[usize(e)]
	if t == 0 || isUntyped(t) {
		t = defaultOf(t)
	}
	if isIntVal(v) {
		rs := cgConstRefSym(cgUnparenNode(e))
		cgGoType(e, t, dp-1)
		cgWc('(')
		if rs != 0 {
			cgWConstName(rs)
		} else {
			cgWInt(v)
		}
		cgWc(')')
		return
	}
	cgValue(e, v, t, dp-1)
}

// primary writes e so that it can be followed by a selector, index or
// call suffix.
func cgPrimary(e u32, dp usize) decreases(dp) {
	if dp == 0 {
		return
	}
	p := cgWmark()
	cgExpr(e, dp-1)
	uk := nkind(cgUnparenNode(e))
	if uk is NkUnaryExpr | NkBinaryExpr && nkind(e) != NkParenExpr {
		cgWwrap(p)
		return
	}
	if cgConstValueSlot(e) != 0 && cgWhasPrefix(p, "-") {
		cgWwrap(p)
	}
}

func cgIdent(e u32, dp usize) decreases(dp) {
	if dp == 0 {
		return
	}
	s := uses[usize(e)]
	if s == 0 {
		s = defs[usize(e)]
	}
	if s == 0 {
		if isBlank(e) {
			cgW("_")
			return
		}
		cgFail(e, "unresolved identifier")
		return
	}
	k := symKind(s)
	if k is SymVar | SymFunc {
		cgWSymName(s)
		return
	}
	if k == SymTypeParam {
		v, ok := cgEnvLookupSym(s)
		if ok {
			cgTypedConst(e, vIntU(v), dp-1)
			return
		}
		cgFail(e, "unbound const parameter")
		return
	}
	if k == SymConst {
		cgFail(e, "constant without a recorded value")
		return
	}
	cgFail(e, "identifier cannot be used as a value")
}

// goPrec is Go's binary operator precedence (5 binds tightest).
func cgGoPrec(op u8) u8 {
	if op == OpLOr {
		return 1
	}
	if op == OpLAnd {
		return 2
	}
	if op >= OpEq && op <= OpGe {
		return 3
	}
	if op is OpAdd | OpSub | OpOr | OpXor {
		return 4
	}
	return 5
}

func cgOperand(e u32, parent u8, right bool, dp usize) decreases(dp) {
	if dp == 0 {
		return
	}
	p := cgWmark()
	cgExpr(e, dp-1)
	if nkind(e) == NkBinaryExpr && cgConstValueSlot(e) == 0 {
		cp := cgGoPrec(nop(e))
		pp := cgGoPrec(parent)
		if cp < pp || (right && cp == pp) {
			cgWwrap(p)
		}
	}
}

func cgBinary(e u32, dp usize) decreases(dp) {
	if dp == 0 {
		return
	}
	op := nop(e)
	x := na(e)
	xv := cgConstValueSlot(x)
	if op is OpShl | OpShr && xv != 0 {
		cgTypedConst(x, slotGet(xv), dp-1)
	} else {
		cgOperand(x, op, false, dp-1)
	}
	cgWc(' ')
	cgW(binOpString(op))
	cgWc(' ')
	cgOperand(nb(e), op, true, dp-1)
}

func cgUnary(e u32, dp usize) decreases(dp) {
	if dp == 0 {
		return
	}
	cgW(unaryOpString(nop(e)))
	x := na(e)
	p := cgWmark()
	cgExpr(x, dp-1)
	uk := nkind(cgUnparenNode(x))
	if uk is NkUnaryExpr | NkBinaryExpr && nkind(x) != NkParenExpr {
		cgWwrap(p)
	}
	if cgWhasPrefix(p, "-") || cgWhasPrefix(p, "&") || cgWhasPrefix(p, "*") {
		cgWwrap(p)
	}
}

func cgSelector(e u32, dp usize) decreases(dp) {
	if dp == 0 {
		return
	}
	sel := nb(e)
	if uses[usize(sel)] != 0 {
		// package-qualified name
		cs := cgConstValueSlot(sel)
		if cs != 0 {
			p := cgWmark()
			cgValue(e, slotGet(cs), ntype[usize(sel)], dp-1)
			cgComposite(p)
			return
		}
		cgIdent(sel, dp-1)
		return
	}
	si := nsel[usize(e)]
	if si == 0 {
		cgFail(e, "unresolved selector")
		return
	}
	r := selTab.items[usize(si)]
	if r.kind == SelField {
		cgPrimary(na(e), dp-1)
		cgWc('.')
		cgWFieldIdent(nameBytes(fieldName(r.ctype, usize(r.index))))
		return
	}
	if r.kind == SelVariant {
		cgFail(e, "enum variant with payload must be called")
		return
	}
	cgFail(e, "method value is not supported")
}

func cgStructLit(e u32, dp usize) decreases(dp) {
	if dp == 0 {
		return
	}
	t := ntype[usize(e)]
	st := underlying(t)
	if t == 0 || !isStructT(st) {
		cgFail(e, "struct literal of non-struct type")
		return
	}
	p := cgWmark()
	cgWc('{')
	n := l1len(e)
	for i := usize(0); i < n; i++ {
		fi := l1at(e, i)
		idx, ok := fieldByName(st, idName(na(fi)))
		if !ok {
			cgFail(fi, "unknown field")
			return
		}
		if i > 0 {
			cgW(", ")
		}
		cgWFieldIdent(nameBytes(fieldName(st, idx)))
		cgW(": ")
		cgExpr(nb(fi), dp-1)
	}
	cgWc('}')
	q := cgWmark()
	cgGoType(e, t, dp-1)
	cgWrotate(p, q)
	cgComposite(p)
}

// funcLit writes a function literal with its own function context; the
// temporary and label counters are shared with the enclosing function.
func cgFuncLit(e u32, dp usize) decreases(dp) {
	if dp == 0 {
		return
	}
	fi := nfunc[usize(e)]
	if fi == 0 {
		cgFail(e, "function literal without FuncInfo")
		return
	}
	sFn := cgFn
	sHeader := cgHeader
	sTyped := cgTyped
	sFrameBase := cgFrameBase
	sPendBase := cgPendBase
	cgFn = fi
	cgHeader = 0
	cgTyped = false
	cgFrameBase = cgFrameTop
	cgPendBase = cgPendTop
	cgW("func")
	cgSignature(fi, dp-1)
	cgWc(' ')
	cgBody(funcs.items[usize(fi)].body, dp-1)
	cgFrameTop = cgFrameBase
	cgPendTop = cgPendBase
	cgFn = sFn
	cgHeader = sHeader
	cgTyped = sTyped
	cgFrameBase = sFrameBase
	cgPendBase = sPendBase
}

// signature writes `(p1 T1, p2 T2) (R1, R2)` for a function.
func cgSignature(fi u32, dp usize) decreases(dp) {
	if dp == 0 {
		return
	}
	f := funcs.items[usize(fi)]
	n := f.decl
	if n == 0 {
		n = f.lit
	}
	s := f.sig
	cgWc('(')
	np := sigNParams(s)
	for i := usize(0); i < np; i++ {
		if i > 0 {
			cgW(", ")
		}
		if i < usize(f.parN) {
			cgWSymName(defs[usize(uat(f.parS, i))])
		} else {
			cgW("_")
		}
		cgWc(' ')
		if sigVariadic(s) && i == np-1 {
			cgW("...")
		}
		cgGoType(n, sigParam(s, i), dp-1)
	}
	cgWc(')')
	cgResults(n, s, dp-1)
}

// ---------------------------------------------------------------------------
// Calls

func cgCalleeSym(e u32) u32 {
	x := e
	for g := usize(0); g < MaxNodes; g++ {
		x = cgUnparenNode(x)
		k := nkind(x)
		if k == NkIdent {
			return uses[usize(x)]
		}
		if k == NkSelectorExpr {
			return uses[usize(nb(x))]
		}
		if k != NkIndexExpr {
			return 0
		}
		x = na(x)
	}
	return 0
}

// funcRef writes a reference to a (possibly generic) declared function;
// the type arguments are rendered before the (instance) name, as finc0
// does.
func cgFuncRef(n u32, sym u32, taS u32, taN usize, dp usize) decreases(dp) {
	if dp == 0 {
		return
	}
	if sym == 0 {
		cgFail(n, "unresolved function")
		return
	}
	fi := funcOfSym(sym)
	if fi == 0 || funcs.items[usize(fi)].tpN == 0 {
		cgWSymName(sym)
		return
	}
	tpS := funcs.items[usize(fi)].tpS
	tpN := usize(funcs.items[usize(fi)].tpN)
	if taN != tpN {
		cgFail(n, "generic function needs type arguments")
		return
	}
	p := cgWmark()
	vmark := cgValTop
	ntargs := usize(0)
	nconst := usize(0)
	for i := usize(0); i < tpN; i++ {
		arg := tlist(taS, i)
		if tpIsConst(tlist(tpS, i)) {
			cgValPush(cgConstArg(n, arg))
			nconst++
		} else {
			if ntargs == 0 {
				cgWc('[')
			} else {
				cgW(", ")
			}
			cgGoType(n, arg, dp-1)
			ntargs++
		}
	}
	if ntargs > 0 {
		cgWc(']')
	}
	q := cgWmark()
	if nconst > 0 {
		mi, ok := cgMonoLookup(2, sym, vmark)
		if ok {
			cgWMonoName(mi)
		}
	} else {
		cgValTop = vmark
		cgWSymName(sym)
	}
	cgWrotate(p, q)
}

// args writes the arguments of a call, expanding a folded multi-value
// comptime call f(g()).
func cgArgs(c u32, dp usize) decreases(dp) {
	if dp == 0 {
		return
	}
	n := l1len(c)
	if n == 1 {
		a0 := l1at(c, 0)
		cs := cgConstValueSlot(a0)
		if cs != 0 && slotGet(cs) is Tuple(..) {
			cgTupleValues(a0, slotGet(cs), dp-1)
			return
		}
	}
	for i := usize(0); i < n; i++ {
		if i > 0 {
			cgW(", ")
		}
		cgExpr(l1at(c, i), dp-1)
	}
}

// tupleValues writes the elements of a multi-value constant.
func cgTupleValues(e u32, v Val, dp usize) decreases(dp) {
	if dp == 0 {
		return
	}
	if v is Tuple(ref, nv) && trec(ntype[usize(e)]) is Tuple(ts, tn) && tn == nv {
		for i := usize(0); i < usize(nv); i++ {
			if i > 0 {
				cgW(", ")
			}
			cgValue(e, slotGet(ref+u32(i)), tlist(ts, i), dp-1)
		}
		return
	}
	cgFail(e, "malformed multi-value constant")
}

func cgCall(e u32, dp usize) decreases(dp) {
	if dp == 0 {
		return
	}
	c := ncall[usize(e)]
	if c == 0 {
		cgFail(e, "call without type information")
		return
	}
	match callTab.items[usize(c)].kind {
		Func(sym, taS, taN) -> {
			cgFuncRef(e, sym, taS, usize(taN), dp-1)
			cgCallArgs(e, dp-1)
		}
		Method(sym, _, recv, _) -> {
			cgPrimary(recv, dp-1)
			cgWc('.')
			cgWSymName(sym)
			cgCallArgs(e, dp-1)
		}
		BuiltinMeth(m, recv, _) -> cgBuiltinMethod(e, meths.items[usize(m)].builtin, m, recv, dp-1)
		Builtin(b, ..) -> cgBuiltinCall(e, c, b, dp-1)
		Conversion(t) -> {
			cgConvType(e, t, dp-1)
			cgWc('(')
			cgExpr(l1at(e, 0), dp-1)
			cgWc(')')
		}
		Variant(t, v) -> cgVariantCall(e, t, usize(v), dp-1)
		Value -> {
			cgPrimary(na(e), dp-1)
			cgCallArgs(e, dp-1)
		}
		Invalid -> cgFail(e, "unsupported call")
	}
}

// cgCallArgs writes the parenthesized arguments of a call.
func cgCallArgs(e u32, dp usize) decreases(dp) {
	if dp == 0 {
		return
	}
	cgWc('(')
	cgArgs(e, dp-1)
	cgWc(')')
}

// cgVariantCall writes the construction of variant vi of enum type t.
func cgVariantCall(e u32, t u32, vi usize, dp usize) decreases(dp) {
	if dp == 0 {
		return
	}
	n := l1len(e)
	if n == 1 && trec(ntype[usize(l1at(e, 0))]) is Tuple(..) {
		cgVariantSpread(e, t, vi, dp-1)
		return
	}
	lay := cgLayout(e, t, dp-1)
	p := cgWmark()
	cgWc('{')
	if vi != 0 {
		cgW("_tag: ")
		cgWu(u64(vi))
	}
	for i := usize(0); i < n; i++ {
		if vi != 0 || i > 0 {
			cgW(", ")
		}
		cgWSlot(lay, vi, i)
		cgW(": ")
		cgExpr(l1at(e, i), dp-1)
	}
	cgWc('}')
	q := cgWmark()
	cgGoType(e, t, dp-1)
	cgWrotate(p, q)
	cgComposite(p)
	cgLayRelease(lay)
}

// cgVariantSpread writes a variant construction whose only argument
// supplies all payload values at once: a multi-result call or a v0.3
// multi-value match, `T.V(g())` (decision 149). Like a call `f(g())` it
// becomes a Go call that spreads the values over parameters,
//
//	func(_fc_v0 T0, _fc_v1 T1) T { return T{_tag: vi, slot0: _fc_v0, slot1: _fc_v1} }(g())
//
// and a folded comptime call `T.V(c())` writes its constant values into
// the slots directly.
func cgVariantSpread(e u32, t u32, vi usize, dp usize) decreases(dp) {
	if dp == 0 {
		return
	}
	a0 := l1at(e, 0)
	ts := u32(0)
	tn := usize(0)
	if trec(ntype[usize(a0)]) is Tuple(s, k) {
		ts = s
		tn = usize(k)
	}
	cs := cgConstValueSlot(a0)
	folded := cs != 0 && slotGet(cs) is Tuple(..)
	ref := u32(0)
	if folded && slotGet(cs) is Tuple(r, nv) {
		ref = r
		if usize(nv) != tn {
			cgFail(e, "malformed multi-value constant")
			return
		}
	}
	saveHeader := cgHeader
	if !folded {
		cgHeader = 0
		cgW("func(")
		for i := usize(0); i < tn; i++ {
			if i > 0 {
				cgW(", ")
			}
			cgWf(formatTo(mbuf[:], "_fc_v%d ", i))
			cgGoType(e, tlist(ts, i), dp-1)
		}
		cgW(") ")
		cgGoType(e, t, dp-1)
		cgW(" { return ")
	}
	lay := cgLayout(e, t, dp-1)
	p := cgWmark()
	cgWc('{')
	if vi != 0 {
		cgW("_tag: ")
		cgWu(u64(vi))
	}
	for i := usize(0); i < tn; i++ {
		if vi != 0 || i > 0 {
			cgW(", ")
		}
		cgWSlot(lay, vi, i)
		cgW(": ")
		if folded {
			cgValue(a0, slotGet(ref+u32(i)), tlist(ts, i), dp-1)
		} else {
			cgWf(formatTo(mbuf[:], "_fc_v%d", i))
		}
	}
	cgWc('}')
	q := cgWmark()
	cgGoType(e, t, dp-1)
	cgWrotate(p, q)
	cgLayRelease(lay)
	if folded {
		cgComposite(p)
		return
	}
	cgW(" }(")
	cgExpr(a0, dp-1)
	cgWc(')')
	cgHeader = saveHeader
}

func cgBuiltinMethod(e u32, b u8, m u32, recv u32, dp usize) decreases(dp) {
	if dp == 0 {
		return
	}
	if b == BMScopeAcquireSlot {
		cgRt("AcquireSlot")
		cgWc('(')
		cgPrimary(recv, dp-1)
		// finc0 renders the pool before the context argument.
		q := cgWmark()
		a1 := l1at(e, 1)
		u := cgUnparenNode(a1)
		if nkind(u) == NkUnaryExpr && nop(u) == OpAddr {
			cgPrimary(na(u), dp-1)
		} else {
			cgPrimary(a1, dp-1)
		}
		cgW("[:]")
		r := cgWmark()
		cgW(", ")
		cgExpr(l1at(e, 0), dp-1)
		cgW(", ")
		cgWrotate(q, r)
		cgWc(')')
		return
	}
	if b == BMScopeReleaseSlot {
		cgRt("ReleaseSlot")
		cgWc('(')
		cgPrimary(recv, dp-1)
		cgW(", ")
		cgExpr(l1at(e, 0), dp-1)
		cgWc(')')
		return
	}
	if b == BMScopeGo {
		cgRt("Go")
		cgWc('(')
		cgPrimary(recv, dp-1)
		cgW(", ")
		cgExpr(l1at(e, 0), dp-1)
		cgW(", ")
		cgExpr(l1at(e, 1), dp-1)
		cgWc(')')
		return
	}
	cgPrimary(recv, dp-1)
	cgWf(formatTo(mbuf[:], ".%s(", nameBytes(meths.items[usize(m)].name)))
	cgArgs(e, dp-1)
	cgWc(')')
}

func cgBuiltinCall(e u32, c u32, b u8, dp usize) decreases(dp) {
	if dp == 0 {
		return
	}
	match b {
		BFLen | BFCap -> {
			cgW(match b { BFLen -> "uint(len(", _ -> "uint(cap(" })
			cgExpr(l1at(e, 0), dp-1)
			cgW("))")
		}
		BFPanic -> {
			cgW("panic(")
			cgArgs(e, dp-1)
			cgWc(')')
		}
		BFFormatTo -> cgFormatTo(e, c, dp-1)
		BFMin | BFMax -> {
			// v0.3: Go's min/max builtins (user names min/max are
			// renamed _fc_u_min/_fc_u_max, so these always resolve).
			cgW(match b { BFMin -> "min(", _ -> "max(" })
			cgArgs(e, dp-1)
			cgWc(')')
		}
		BFCopy | BFBytesEqual | BFStrBytes | BFBytesToStr | BFFormatUint | BFParseUint | BFNewContext | BFNewScope -> {
			cgRt(cgBuiltinGoName(b))
			cgWc('(')
			cgArgs(e, dp-1)
			cgWc(')')
		}
		_ -> cgFail(e, "builtin cannot be called at run time")
	}
}

// builtinGoName is resolve.Builtin.GoName for builtin functions.
func cgBuiltinGoName(b u8) string {
	return match b {
		BFCopy -> "Copy"
		BFBytesEqual -> "BytesEqual"
		BFStrBytes -> "StrBytes"
		BFBytesToStr -> "BytesToStr"
		BFFormatUint -> "FormatUint"
		BFParseUint -> "ParseUint"
		BFNewContext -> "NewContext"
		_ -> "NewScope"
	}
}
